/// Row `where-record` — RFC-0003. A record base has a CROSS-FIELD predicate,
/// so what violated it is not one value and the wording says so.

type Range = { start: Int64, end: Int64 } where start < end

fn span(r: Range) -> Int64 {
    return r.end - r.start
}

fn raw(n: Int64) -> Int64 {
    return n
}

fn main() -> Int64 {
    print(span(Range { start: raw(9), end: 2 }))
    return 0
}
