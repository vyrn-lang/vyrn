import { both, race, each, Both, Race } from "std/task"

fn twice<T>(x: T, f: fn(T) -> Int64) -> Int64 {
    return await f(x) + await f(x)
}

fn pair(f: fn(Int64) -> Int64) -> Int64 {
    let r = await both(f(1), f(2))
    return r.first + r.second
}

fn label(f: fn(Int64) -> String) -> String {
    return match await race(f(1), f(2)) {
        First(s) => s,
        Second(s) => s,
    }
}

fn main() -> Int64 {
    print(await twice(4, x -> x + 1))
    print(await pair(x -> x * 10))
    print(await label(x -> x.toString()))
    let r = await each([1, 2], x -> x + 1)
    print(r[0] + r[1])
    return 0
}
