// A lambda that waits runs where a `fn` parameter's specialization calls it,
// each call resuming at its own frame: `twice` waits on it twice.
import { sleep } from "std/task"

fn twice(f: fn(Int64) -> Int64, x: Int64) -> Int64 {
    return await f(await f(x))
}

fn main() -> Int64 {
    let r = await twice(x -> {
        await sleep(x)
        return x + 1
    }, 1)
    print("\{r}")
    return 0
}
