// A task cancelled under a plain await releases the handle it holds, and the
// held task runs on.
import { sleep, cancel } from "std/task"

fn later(ms: Int64, s: consume String) -> String {
    await sleep(ms)
    print(s)
    return s
}

fn holder() -> Int64 {
    let p = fork later(10, "the held task runs on")
    await sleep(20)
    print("never printed")
    return 0
}

fn main() -> Int64 {
    let h = fork holder()
    await sleep(1)
    cancel(h)
    await sleep(30)
    print("main ends")
    return 0
}
