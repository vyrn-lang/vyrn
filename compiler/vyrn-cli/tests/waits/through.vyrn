// A waiting function and one that does not wait, stored as values of one type:
// each call through the value is awaited.
import { sleep } from "std/task"

fn slow(x: Int64) -> Int64 {
    await sleep(x)
    return x + 1
}

fn quick(x: Int64) -> Int64 {
    return x * 2
}

fn main() -> Int64 {
    let fs: Array<fn(Int64) -> Int64> = [slow, quick]
    for f in fs {
        print("\{await f(3)}")
    }
    return 0
}
