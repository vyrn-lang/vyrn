// A trap releases every handle its task held, as scope end would: a held task
// that runs goes on without an owner and frees its result at its end, one that
// ended is freed at the trap, and a handle a fork argument moved into a worker
// stays the worker's.
import { join, sleep } from "std/task"

let mut freed: Int64 = 0

let mut got: Int64 = 0

type Note = { n: Int64 }

impl Owned for Note {
    fn release(consume self) {
        freed = freed + self.n
    }
}

fn note(ms: Int64) -> Note {
    await sleep(ms)
    return Note { n: 1 }
}

fn holdThenTrap(ms: Int64) -> Int64 {
    let p = fork note(ms)
    await sleep(5)
    panic("the holder trapped")
    return 0
}

fn worker(p: consume Task<Note>) -> Int64 {
    let v = await join(p)
    got = v.n
    return 0
}

fn forkThenTrap() -> Int64 {
    let p = fork note(10)
    let w = fork worker(p)
    await sleep(5)
    panic("the forker trapped")
    return 0
}

test "a held task that runs on frees its result at its end" {
    freed = 0
    let h = fork holdThenTrap(10)
    await sleep(30)
    assertEq(freed, 1)
}

test "a held task that ended is freed at its holder's trap" {
    freed = 0
    let h = fork holdThenTrap(1)
    await sleep(30)
    assertEq(freed, 1)
}

test "a handle a fork argument moved survives its forker's trap" {
    freed = 0
    let h = fork forkThenTrap()
    await sleep(30)
    assertEq(got, 1)
    assertEq(freed, 1)
}

test "repeated traps leave no handle held" {
    freed = 0
    let mut i: Int64 = 0
    while i < 50 {
        let h = fork holdThenTrap(1 + i % 2 * 10)
        await sleep(20)
        i = i + 1
    }
    assertEq(freed, 50)
}
