import { sleep, join, cancel } from "std/task"

fn later(ms: Int64, s: consume String) -> String {
    await sleep(ms)
    print(s)
    return s
}

fn main() -> Int64 {
    let t = fork later(5, "never printed")
    let u = fork later(1, "u")
    cancel(t)
    print("joined \{await join(u)}")
    return 0
}
