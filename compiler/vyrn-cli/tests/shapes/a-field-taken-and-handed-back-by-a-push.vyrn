// a field taken and handed back by a push
// `b.xs.push(v)` takes `b.xs` and stores the result back. The take is the
// place a rebuild hands back, not a part of a literal (the m7-slotsfield
// record).
type Bag = { xs: Array<Int64>, n: Int64 }          fn addP(b: modify Bag, v: Int64) { b.xs.push(v) b.n = b.n + 1 }          fn vyrnTestMain() -> Int64 { let mut b = Bag { xs: [], n: 0 } addP(b, 4) addP(b, 5) b.xs.push(6) return b.xs.length * 100 + b.n * 10 + b.xs[2] }
