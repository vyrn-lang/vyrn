// a lambda whose captures are read in another order than they were bound
// pin: 0 break, 0 continue
// The row lists a closure's captures in scope order and the lifted signature
// takes them in the order the body reads them; the walk reads each part off
// the row by name, a String capture among them (RFC-0125 M7, `m7-lambda`).
fn vyrnTestMain() -> Int64 { let a = 1 let b = 20 let s = "abc" let f: fn(Int64) -> Int64 = x -> b + a * x + s.byteLength return f(300) * 10 + a }
