// a sum name handed on beside a statement the arm emits
// pin: 0 break, 0 continue
// An `Option` parameter handed to a call is a name the screen used to refuse
// by its type (the m7-names2 record). The store into module state keeps the
// body off the whole-body walk, so the `return` is the interleave's.
let mut seen: Map<String, Int64> = [:]          fn get(o: Option<Int64>) -> Int64 { return match o { Some(v) => v, None => 0 } }          fn two(a: Option<Int64>, b: Option<Int64>) -> Int64 { seen["o"] = 1 return get(a) + get(b) }          fn vyrnTestMain() -> Int64 { return two(Some(5), None) + seen.length }
