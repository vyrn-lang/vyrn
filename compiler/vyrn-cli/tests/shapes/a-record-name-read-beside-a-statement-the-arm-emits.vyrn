// a record name read beside a statement the arm emits
// A name of any type has a place on both walks, so the screen does not ask
// its type (the m7-names2 record). The store into module state keeps the
// body off the whole-body walk, so the `let` is the interleave's.
let mut seen: Map<String, Int64> = [:]          type P = { x: Int64, y: Int64 }          fn sum(p: P) -> Int64 { seen["p"] = p.x let s = p.x + p.y return s }          fn vyrnTestMain() -> Int64 { return sum(P { x: 3, y: 4 }) + seen.length }
