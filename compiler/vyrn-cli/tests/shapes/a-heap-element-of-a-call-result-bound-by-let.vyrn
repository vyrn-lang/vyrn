// a heap element of a call result bound by let
// pin: 0 break, 0 continue
// `let a = pieces()[0]` copies the element out of the temporary, and the
// temporary is released whole when the statement ends, as `.copy()` spelled
// it (site/app/hl.vyrn). A scalar element is read out with no copy.
type Piece = { id: String, lines: Array<String> }          fn pieces() -> Array<Piece> { return [Piece { id: "h" + 1.toString(), lines: ["a" + 2.toString(), "b"] }, Piece { id: "x" + 3.toString(), lines: ["c" + 4.toString()] }] }          fn sizes() -> Array<Int64> { return [7, 8] }          fn vyrnTestMain() -> Int64 { let a = pieces()[0] let b = pieces()[1] let n = sizes()[1]          let mut c = pieces()[1] c.id = "y" return a.id.byteLength * 100000 + a.lines.length * 10000 + b.lines[0].byteLength * 1000 + c.lines.length * 100 + n }
