// a store into a validated element and a validated map value
// pin: 0 break, 0 continue
// A crossing into a validated element or map value is its constructor, as
// a store to a name's is, whether or not the checker proved it (the
// m7-elemcheck record): 4322.
type Age = Int64 where value >= 18          type T = { xs: Array<Age> }          fn vyrnTestMain() -> Int64 { let mut t = T { xs: [] } let mut i = 0 while i < 3 { t.xs.push(i + 18) i = i + 1 } let mut k = 0 while k < 3 { t.xs[k] = k + 20 k = k + 1 } let mut m: Map<String, Age> = [:] m["a"] = k + 40 return t.xs[2] + (m["a"] ?? 0) * 100 }
