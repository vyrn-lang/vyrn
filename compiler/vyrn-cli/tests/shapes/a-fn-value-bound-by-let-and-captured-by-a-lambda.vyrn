// a `fn` value bound by `let` and captured by a lambda
// pin: 0 break, 0 continue
// A `let` of a function's name binds a closure enum's value, and the screen
// used to refuse the name by its type (the m7-names2 record). The lambda
// keeps the body off the whole-body walk.
fn dbl(x: Int64) -> Int64 { return x * 2 }          fn wrap(n: Int64) -> fn(Int64) -> Int64 { let g: fn(Int64) -> Int64 = dbl return m -> g(m + n) }          fn vyrnTestMain() -> Int64 { let h = wrap(1) return h(5) }
