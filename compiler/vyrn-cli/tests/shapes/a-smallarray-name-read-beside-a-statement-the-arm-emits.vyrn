// a `SmallArray` name read beside a statement the arm emits
// pin: 0 break, 0 continue
// A `SmallArray` holds its elements in its header, and its name has a place
// on both walks like any other (the m7-names2 record). The store into
// module state keeps the body off the whole-body walk.
let mut seen: Map<String, Int64> = [:]          fn total(v: SmallArray<Int64, 4>) -> Int64 { seen["v"] = 1 let s = v[0] + v[1] return s }          fn vyrnTestMain() -> Int64 { let mut v: SmallArray<Int64, 4> = [] v.push(1) v.push(2) return total(v) + seen.length }
