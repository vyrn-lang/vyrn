// a SmallArray literal of owned elements the core makes
// The two Strings are written into the inline buffer, and the release of
// `s` frees them where it runs. Both walks print 22 with no leak line
// (RFC-0125 M7, `m7-smallarray`).
fn vyrnTestMain() -> Int64 { let s: SmallArray<String, 2> = ["a", "bc"] return s.length * 10 + s[1].byteLength }
