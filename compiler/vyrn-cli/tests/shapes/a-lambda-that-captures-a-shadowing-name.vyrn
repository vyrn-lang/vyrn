// a lambda that captures a name shadowing an outer one
// pin: 0 break, 0 continue
// The core captures both `x`s, so two of the row's captures share a source
// name and `Fn_::core_lambda` gives the body to the arm rather than guess
// which one the lifted signature reads. Both walks print 3221 with no leak
// line (RFC-0125 M7, `m7-lambda`).
fn vyrnTestMain() -> Int64 { let x = 1 let s = "ab" let mut r = 0 if x > 0 { let x = 20 let f: fn(Int64) -> Int64 = y -> x + y + s.byteLength r = f(300) } return r * 10 + x }
