// a borrowed element copied into an if-join an arm owns
// The `if` form of the same join: one arm yields a fresh String and the other
// copies an element of a `read` parameter (#518). Both walks release the join
// on both paths: 2 * 10 + 3 = 23, with no free-audit line (RFC-0125 M7,
// `m7-small`).
fn f(xs: Array<String>, c: Bool, k: Int64) -> String { let m = if c { xs[0].copy() } else { k.toString() } return "a" + m }
fn vyrnTestMain() -> Int64 { let xs: Array<String> = ["q" + "r"] let a = f(xs, false, 3) let b = f(xs, true, 3) return a.byteLength * 10 + b.byteLength }
