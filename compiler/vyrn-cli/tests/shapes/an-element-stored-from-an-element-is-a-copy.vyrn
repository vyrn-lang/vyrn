// an element stored from an element is a copy of its own
// An index names no one place, so `xs[0] = xs[1]` is refused at every depth,
// for `i == j` too; the fix `.copy()` stores a value the slot owns. A field
// stored from itself (`r.p = r.p`) and a rebuild (`zs[1] = zs[1].push(4)`)
// put the same value back and stay accepted.
type P = { name: String }
type A = { ss: Array<String> }
type R = { ss: Array<String>, a: A, p: P, q: P }
fn ss() -> Array<String> {
    return ["x" + "y", "z" + "wv", "u" + "vwx"]
}
fn bang(s: String) -> String {
    return s + "!"
}
fn eat(s: consume String) -> String {
    return s + "?"
}
fn vyrnTestMain() -> Int64 {
    let mut xs = ss()
    let ys = ss()
    let mut r = R { ss: ss(), a: A { ss: ss() }, p: P { name: "p" + "1" }, q: P { name: "q" + "12" } }
    let mut ns = [ss(), ss()]
    let mut ps = [P { name: "a" + "b" }, P { name: "c" + "def" }]
    let mut zs: Array<Array<Int64>> = [[1], [2, 3]]
    let mut m: Map<String, String> = [:]
    m["a"] = "k" + "l"
    m["b"] = "m" + "nop"
    let i = 2
    let j = 2
    xs[0] = xs[1].copy()
    xs[i] = xs[j].copy()
    xs[1] = bang(xs[2])
    xs[2] = eat(xs[0].copy())
    xs[0] = ys[2].copy()
    r.ss[0] = r.ss[2].copy()
    r.a.ss[1] = r.a.ss[0].copy()
    r.p = r.p
    r.q.name = r.q.name
    ns[0][0] = ns[1][2].copy()
    ps[0].name = ps[1].name.copy()
    zs[1] = zs[1].push(4)
    if let Some(v) = m["b"] {
        m["a"] = v.copy()
    }
    let mut got = 0
    if let Some(a) = m["a"] {
        got = a.byteLength
    }
    let one = xs[0].byteLength * 100 + xs[1].byteLength * 10 + xs[2].byteLength
    let two = r.ss[0].byteLength * 100 + r.ss[1].byteLength * 10 + r.ss[2].byteLength
    let three = r.a.ss[0].byteLength * 100 + r.a.ss[1].byteLength * 10 + r.a.ss[2].byteLength
    let rest = r.p.name.byteLength + r.q.name.byteLength + ns[0][0].byteLength + ps[0].name.byteLength
    return one + two + three + rest + zs[1].length + got
}
