// a validated record literal checked where it is made
// A record literal of a validated type the checker did not prove is checked
// whole by its constructor row after the make; a proven one states no row.
type Range = { start: Int64, end: Int64 } where start < end          fn mk(n: Int64) -> Range { return Range { start: n, end: 10 } }          fn span(r: Range) -> Int64 { return r.end - r.start }          fn vyrnTestMain() -> Int64 { let a = Range { start: 1, end: 3 } return span(a) + span(mk(4)) }
