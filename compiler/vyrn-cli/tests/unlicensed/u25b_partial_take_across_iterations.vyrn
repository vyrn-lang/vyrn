// Row 25 of the refusals census, over a take of a PROJECTION.
//
// The two passes said different things about it: the checker named the
// loop and the kernel named the back edge. The kernel names the PATH the
// take emptied, in the checker's own sentence, so the checker states no
// rule for it.
type Entry = { node: String, rest: Int64 }

fn main() -> Int64 {
    let er = Entry { node: "n", rest: 0 }
    for i in [1, 2] {
        consume er.node
    }
    return 0
}
