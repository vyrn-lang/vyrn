type R = { xs: Array<Int64>, m: Map<String, Int64> }
fn main() -> Int64 {
    let mut r = R { xs: [1, 2, 3], m: ["a": 1, "b": 2] }
    let mut n = 0
    if let Some(v) = r.xs.pop() {
        r.xs.push(v + 6)
    }
    n = n + (r.xs.pop() ?? 0)
    print(r.xs.pop() ?? 0)
    let mut rs: Array<R> = [r]
    let gone = rs[0].m.remove("a")
    if rs[0].m.remove("b") && gone {
        n = n + 100
    }
    rs[0].xs = [1, 2]
    while let Some(v) = rs[0].xs.pop() {
        n = n + v
    }
    return rs[0].xs.length + n
}
