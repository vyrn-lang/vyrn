// A `modify` argument may not overlap a `read` argument.
type Cell = { n: Int64, xs: Array<Int64> }

type Pair = { a: Cell, b: Cell }

fn look(x: modify Cell, y: Cell) {
    x.n = y.n
}

fn main() -> Int64 {
    let mut p = Pair { a: Cell { n: 1, xs: [1] }, b: Cell { n: 2, xs: [] } }
    look(p.a, p.a)
    return 0
}
