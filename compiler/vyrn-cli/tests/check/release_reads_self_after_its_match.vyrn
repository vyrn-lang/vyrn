// Accepted: the read named a value the match had taken apart.
type Box = { s: String, n: Int64, m: Int64 }
type E = enum { Leaf(Box), Empty }
impl Owned for E {
    fn release(consume self) {
        match consume self {
            Leaf(b) => {}
            Empty => {}
        }
        match self {
            Leaf(b) => {}
            Empty => {}
        }
    }
}

fn main() -> Int64 {
    let e = Leaf(Box { s: "a" + "b", n: 1, m: 2 })
    return 0
}
