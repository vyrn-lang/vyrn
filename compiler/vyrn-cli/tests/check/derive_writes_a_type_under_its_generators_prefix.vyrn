export gen fn boxed(t: TypeArg) -> Code {
    let mut out = vyrn"type Box = { v: Int64 }\n"
    for r in t.roots {
        let r = t.nodes[r]
        out = out + vyrn"fn \{name(r.shape.name)}(v: \{r.code}) -> String {\n    let b = Box { v: v }\n    return b.w\n}\n"
    }
    return out
}

fn main() -> Int64 {
    print(derive(boxed, 1))
    return 0
}
