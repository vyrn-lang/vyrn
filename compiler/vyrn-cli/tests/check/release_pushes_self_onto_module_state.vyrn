// Accepted, the free audit reported a double free: the audited teardown released the element.
type Box = { s: String, n: Int64, m: Int64 }
type E = enum { Leaf(Box), Empty }
let mut g: Array<E> = []
impl Owned for E {
    fn release(consume self) {
        g.push(consume self)
    }
}

fn main() -> Int64 {
    let e = Leaf(Box { s: "a" + "b", n: 1, m: 2 })
    return 0
}
