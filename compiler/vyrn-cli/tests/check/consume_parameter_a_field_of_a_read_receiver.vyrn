type Bag = { xs: Array<Int64> } let g: Array<Int64> = [1] let gb: Bag = Bag { xs: [1] } fn take(xs: consume Array<Int64>) -> Int64 { let n = xs.length drop xs return n } fn takeBag(b: consume Bag) -> Int64 { return b.xs.length } protocol Giving { fn give(read self) -> Int64 } impl Giving for Bag { fn give(read self) -> Int64 { return take(self.xs) } } fn main() -> Int64 { return 0 }
