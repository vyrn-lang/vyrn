// A refusal quotes a function and a type as the reader wrote them, though
// the loader renamed both apart from the import's.
import { run } from "./a_module_with_a_function_and_a_type_a_root_also_names.vyrn"
type Cfg = { n: Int64 }
fn helper(n: Int64) -> Int64 { return n }
fn grow(xs: modify Array<Int64>) { xs.push(1) }
let c: Cfg = 5
fn a() -> Int64 { return helper("x") }
fn b() -> Cfg { return 3 }
fn d() -> Int64 { return helper(1, 2) }
fn e() -> Int64 {
    let xs: Array<Cfg> = [1]
    return 0
}
fn f() -> Int64 {
    let h: fn(String) -> Int64 = helper
    return 0
}
fn g(x: Cfg) -> Int64 { return x.m }
fn k() -> Int64 {
    let xs: Array<Int64> = []
    grow(xs)
    return xs.length
}
fn tag(parts: Array<String>, values: Array<Value>) -> String { return parts[0] }
fn m(c: Cfg) -> String { return tag"a \{c}" }
fn n(c: { n: Int64 }) -> String { return tag"a \{c}" }
fn p(c: Cfg) -> Int64 {
    print(c)
    return 0
}
fn main() -> Int64 { return run() }
