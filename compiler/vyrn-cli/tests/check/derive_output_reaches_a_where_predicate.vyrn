type Age = Int64 where value >= 0

export gen fn holds(t: TypeArg) -> Code {
    let mut out = vyrn""
    for r in t.roots {
        let n = t.nodes[r].shape
        out = out + vyrn"fn \{name(n.name)}(v: \{t.nodes[r].code}) -> String {\n    return \{name("VyrnWp_" + n.spelling)}(v)\n}\n"
    }
    return out
}

fn main() -> Int64 {
    let a: Age = 3
    print(derive(holds, a))
    return 0
}
