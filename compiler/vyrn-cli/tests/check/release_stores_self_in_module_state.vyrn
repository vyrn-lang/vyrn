// Accepted, the call stack was exhausted.
type Box = { s: String, n: Int64, m: Int64 }
type E = enum { Leaf(Box), Empty }
let mut g: Option<E> = None
impl Owned for E {
    fn release(consume self) {
        g = Some(consume self)
    }
}

fn main() -> Int64 {
    let e = Leaf(Box { s: "a" + "b", n: 1, m: 2 })
    return 0
}
