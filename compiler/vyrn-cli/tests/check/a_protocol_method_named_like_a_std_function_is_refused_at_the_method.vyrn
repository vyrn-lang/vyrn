import { substring } from "std/strings"

protocol Cut {
    fn slice(read self, a: Int64, b: Int64) -> Option<String>
}

impl Cut for String {
    fn slice(read self, a: Int64, b: Int64) -> Option<String> {
        return None
    }
}

fn main() -> Int64 {
    print(substring("abc", 0, 1))
    return 0
}
