// A compatible record flows into a predicated record type, and the boundary
// runs the invariant. A violating constant literal is refused, a constant plain
// record at the boundary is proven there too, and a dynamic one compiles, with
// a run-time check.
type Range = { start: Int64, end: Int64 } where start < end fn span(r: Range) -> Int64 { return r.end - r.start } fn main() -> Int64 { return span(Range { start: 10, end: 3 }) }
