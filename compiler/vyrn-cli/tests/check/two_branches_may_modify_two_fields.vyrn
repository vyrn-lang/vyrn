import { both, sleep } from "std/task"

type P = { a: Array<Int64>, b: Array<Int64> }

fn fill(xs: modify Array<Int64>, ms: Int64) -> Int64 {
    await sleep(ms)
    xs.push(ms)
    return ms
}

fn main() -> Int64 {
    let mut p = P { a: [], b: [] }
    let r = await both(fill(p.a, 2), fill(p.b, 1))
    print("\{p.a.length} \{p.b.length} \{r.first} \{r.second}")
    return 0
}
