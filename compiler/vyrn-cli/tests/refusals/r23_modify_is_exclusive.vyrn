// All mutation is exclusive, so a `modify` borrow may not overlap a
// read of the same place in the same call.
fn bump(xs: modify Array<Int64>, ys: Array<Int64>) -> Int64 {
    xs.push(ys.length)
    return xs.length
}

fn main() -> Int64 {
    let mut a: Array<Int64> = [1, 2]
    let n = bump(a, a)
    print(n)
    return 0
}
