// A second owner of `self` would release it again, inside its own release.
type Box = { s: String, n: Int64, m: Int64 }
type Tree = enum { Leaf(Box), Empty }

impl Owned for Tree {
    fn release(consume self) {
        let t = consume self
        match t {
            Leaf(b) => {}
            Empty => {}
        }
    }
}

fn main() -> Int64 {
    let t = Leaf(Box { s: "a" + "b", n: 1, m: 2 })
    return 0
}
