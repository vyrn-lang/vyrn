// A declared `release` takes the value whole, so it cannot run around a hole.
type Kid = { name: String }

impl Owned for Kid {
    fn release(consume self) {
        let s = consume self.name
        drop s
    }
}

fn unkid(k: consume Kid) -> String {
    return consume k.name
}

fn main() -> Int64 {
    print(unkid(Kid { name: "a" + "b" }))
    return 0
}
