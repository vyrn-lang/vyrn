; vyrn lowered v2 -- examples/projection.vyrn

fn build(n)
  {
    let out! = make array()
    let i = lit 0
    loop
      let @t1 = prim lt(i, n)
      if @t1
      else
        break
      {
        let @t2 = prim mul(i, lit 10)
        let @t3! = builtin @push(consume out!, consume @t2)
        out! = @t3!  (Transferred)
        let @t4 = prim add(i, lit 1)
        i = @t4  (Transferred)
      }
    return out!
  }

fn main()
  {
    let @t1! = fn build(read lit 6)
    let w! = make Window {data, start}(@t1!, lit 2)
    let @t2 = read w!.start
    let @t3 = prim add(@t2, lit 0)
    proved array-index w!.data[@t3]  (line 42 #0)
    let @borrow = read w!.data[@t3]
    let @t4! = builtin @str(read @borrow)
    let @t5 = read w!.start
    let @t6 = prim add(@t5, lit 1)
    proved array-index w!.data[@t6]  (line 42 #1)
    let @borrow = read w!.data[@t6]
    let @t7! = builtin @str(read @borrow)
    let @t8 = read w!.start
    let @t9 = prim add(@t8, lit 3)
    proved array-index w!.data[@t9]  (line 42 #2)
    let @borrow = read w!.data[@t9]
    let @t10! = builtin @str(read @borrow)
    let @t11! = builtin @concat(read lit "window: ", read @t4!, read lit " ", read @t7!, read lit " ", read @t10!)
    drop @t4!
    drop @t7!
    drop @t10!
    do builtin print(read @t11!)
    drop @t11!
    let @t12! = fn build(read lit 9)
    let s! = make Strided {data, stride}(@t12!, lit 3)
    let @t13 = read s!.stride
    let @b32_22.k = prim mul(lit 0, @t13)
    proved array-index s!.data[@b32_22.k]  (line 45 #0)
    let @borrow = read s!.data[@b32_22.k]
    let @t14! = builtin @str(read @borrow)
    let @t15 = read s!.stride
    let @b32_31.k = prim mul(lit 1, @t15)
    proved array-index s!.data[@b32_31.k]  (line 45 #1)
    let @borrow = read s!.data[@b32_31.k]
    let @t16! = builtin @str(read @borrow)
    let @t17 = read s!.stride
    let @b32_40.k = prim mul(lit 2, @t17)
    proved array-index s!.data[@b32_40.k]  (line 45 #2)
    let @borrow = read s!.data[@b32_40.k]
    let @t18! = builtin @str(read @borrow)
    let @t19! = builtin @concat(read lit "strided: ", read @t14!, read lit " ", read @t16!, read lit " ", read @t18!)
    drop @t14!
    drop @t16!
    drop @t18!
    do builtin print(read @t19!)
    drop @t19!
    let @t20! = fn build(read lit 3)
    let c! = make Clamped {data}(@t20!)
    let @p32_49.i = lit 0
    let @b32_49.n = read c!.data.length
    let @t22 = prim lt(@p32_49.i, @b32_49.n)
    if @t22
      @t21 = @p32_49.i  (Nothing)
    else
      let @t23 = prim sub(@b32_49.n, lit 1)
      @t21 = @t23  (Nothing)
    let @b32_49.j = @t21
    proved array-index c!.data[@b32_49.j]  (line 48 #0)
    let @borrow = read c!.data[@b32_49.j]
    let @t24! = builtin @str(read @borrow)
    let @p32_68.i = lit 2
    let @b32_68.n = read c!.data.length
    let @t26 = prim lt(@p32_68.i, @b32_68.n)
    if @t26
      @t25 = @p32_68.i  (Nothing)
    else
      let @t27 = prim sub(@b32_68.n, lit 1)
      @t25 = @t27  (Nothing)
    let @b32_68.j = @t25
    proved array-index c!.data[@b32_68.j]  (line 48 #1)
    let @borrow = read c!.data[@b32_68.j]
    let @t28! = builtin @str(read @borrow)
    let @p32_87.i = lit 9
    let @b32_87.n = read c!.data.length
    let @t30 = prim lt(@p32_87.i, @b32_87.n)
    if @t30
      @t29 = @p32_87.i  (Nothing)
    else
      let @t31 = prim sub(@b32_87.n, lit 1)
      @t29 = @t31  (Nothing)
    let @b32_87.j = @t29
    proved array-index c!.data[@b32_87.j]  (line 48 #2)
    let @borrow = read c!.data[@b32_87.j]
    let @t32! = builtin @str(read @borrow)
    let @t33! = builtin @concat(read lit "clamped: ", read @t24!, read lit " ", read @t28!, read lit " ", read @t32!)
    drop @t24!
    drop @t28!
    drop @t32!
    do builtin print(read @t33!)
    drop @t33!
    let a! = fn build(read lit 4)
    proved array-index a![lit 1]  (line 51 #0)
    a![lit 1] = lit 99  (Nothing)
    proved array-index a![lit 0]  (line 52 #0)
    let @borrow = read a![lit 0]
    let @t34! = builtin @str(read @borrow)
    proved array-index a![lit 1]  (line 52 #1)
    let @borrow = read a![lit 1]
    let @t35! = builtin @str(read @borrow)
    proved array-index a![lit 3]  (line 52 #2)
    let @borrow = read a![lit 3]
    let @t36! = builtin @str(read @borrow)
    let @t37! = builtin @concat(read lit "array: ", read @t34!, read lit " ", read @t35!, read lit " ", read @t36!)
    drop @t34!
    drop @t35!
    drop @t36!
    do builtin print(read @t37!)
    drop @t37!
    drop a! minus []
    drop c! minus []
    drop s! minus []
    drop w! minus []
    return lit 0
  }
