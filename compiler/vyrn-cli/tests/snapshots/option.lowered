fn agePlus(n: Int64, extra: Int64) -> Result<Int64, Int64>               @32
  let a : Age                                                            @33
    try : Age                                                            @33
      call parseAge : Result<Age, Int64>                                 @33
        var n : Int64                                                    @33
  return                                                                 @34
    call Ok : Result<Int64, Int64>                                       @34
      binary Add : Int64                                                 @34
        var a : Age                                                      @34
        var extra : Int64                                                @34

