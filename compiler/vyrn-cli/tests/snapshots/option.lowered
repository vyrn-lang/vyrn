fn parseAge(n: Int64) -> Result<Age, Int64>                              @24
  if                                                                     @25
    binary GtEq : Bool                                                   @25
      var n : Int64                                                      @25
      int 18 : Int64                                                     @25
    return                                                               @26
      call Ok : Result<Age, Int64>                                       @26
        call Age : Age                                                   @26
          var n : Int64                                                  @26
  return                                                                 @28
    call Err : Result<Age, Int64>                                        @28
      var n : Int64                                                      @28

fn safeDiv(a: Int64, b: Int64) -> Option<Int64>                          @8
  if                                                                     @9
    binary Eq : Bool                                                     @9
      var b : Int64                                                      @9
      int 0 : Int64                                                      @9
    return                                                               @10
      var None : Option<Int64>                                           @10
  return                                                                 @12
    call Some : Option<Int64>                                            @12
      binary Div : Int64                                                 @12
        var a : Int64                                                    @12
        var b : Int64                                                    @12

fn unwrapOr(o: Option<Int64>, fallback: Int64) -> Int64                  @16
  return                                                                 @17
    match : Int64                                                        @17
      var o : Option<Int64>                                              @17
