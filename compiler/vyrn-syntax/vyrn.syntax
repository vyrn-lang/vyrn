// The Vyrn grammar: shape only. Lower-case rules are lexical, upper-case
// rules syntactic. A refusal names its row in rules.rs; the sentence lives
// there.
syntax Vyrn

// The reserved words, in the lexer's table order: the keyword list.
keyword Fn 'fn'
keyword Let 'let'
keyword Mut 'mut'
keyword If 'if'
keyword Else 'else'
keyword While 'while'
keyword For 'for'
keyword In 'in'
keyword Drop 'drop'
keyword Protocol 'protocol'
keyword Import 'import'
keyword Export 'export'
keyword Impl 'impl'
keyword Vself 'self'
keyword Return 'return'
keyword True 'true'
keyword False 'false'
keyword Type 'type'
keyword Enum 'enum'
keyword Where 'where'
keyword Match 'match'
keyword Region 'region'
keyword Break 'break'
keyword Continue 'continue'

// Punctuation, two characters first. A literal yields to a longer spelling.
token Arrow '->'
token FatArrow '=>'
token TildeMatch '=~'
token EqEq '=='
token NotEq '!='
token LtEq '<='
token GtEq '>='
token AndAnd '&&'
token OrOr '||'
// Maximal munch, so two postfix `?` are written `(x?)?`.
token QuestionQuestion '??'
token Shl '<<'
// Lexes greedily; in type position the parser splits `>>` into two `>`, so
// `Array<Array<T>>` parses.
token Shr '>>'
token LParen '('
token RParen ')'
token LBrace '{'
token RBrace '}'
token LBracket '['
token RBracket ']'
token Comma ','
token Semi ';'
token Colon ':'
token Dot '.'
token Plus '+'
token Minus '-'
token Star '*'
token Slash '/'
token Percent '%'
token Eq '='
token Lt '<'
token Gt '>'
token Bang '!'
token Question '?'
token Pipe '|'
token Amp '&'
token Caret '^'
token Tilde '~'

nest 1024 ^NestingTooDeep(max='1024')

// A literal that fails after its rule committed.
expect ^Expected(pty=token, aty=found)

// The rows the tree builder raises as each declaration closes: a token's value,
// or a check that compares names or counts, which a grammar does not state.
row IntOutOfRange
row UnicodeEscapeDigits
row UnicodeEscapeScalar
row DuplicateLogging
row ContractOpenRuleTwice
row ContractMemberFormChange
row ContractMemberTwice
row ImplAssocTypeClash
row ProjectionReceiver
row InlineWhereBase
row AwaitNotCall
row LetPatternScrutinee
row LetEmptyVariant
row IndexAssignTarget
row FieldAssignTarget
row PushNoPlace
row SkeletonDetail
row SkeletonUnparsable

// ---------------------------------------------------------------- tokens

trivia = (ws / comment)*
comment = '//' !('/' !'/') (!'\n' .)*
doc = '//' '/' !'/' (!'\n' .)*
scan = trivia (token trivia)* (eof / ^UnexpectedChar(c=.:?))
token = string / byte / number / word / doc / punct / splice

word = (alpha / '_') (alnum / '_')*
// The hole of a code quote's text, and what is glued after it. The host refuses it
// in any other text, and joins it to a word just before it: an identifier. A syntactic
// rule reads a hole with nothing glued, which stands for items of its list, any number.
splice = '\0' (alnum / '_' / '\0')*
ident = !reserved word
int = digit+ !('.' digit)
number = digit+ ('.' digit+)?

string = q:'"""' (!'"""' strItem)* ('"""' / ^UnterminatedString@q)
       / q:'"' (!'"' strItem)* ('"' / ^UnterminatedString@q)
strItem = '\0' ^NulInString@q / '\\' esc / .
esc = eof ^UnterminatedEscape@q / '{' hole / 'u' uni / [ntr\\"] / ^UnknownEscape(other=.)@q
uni = ('{' / ^UnicodeEscapeBrace@q) (!'}' .)* ('}' / ^UnterminatedUnicodeEscape@q)
hole = ws* &'}' ^EmptyInterp@q
     / embed(holeText, Expr, wrap=^InInterpolation(detail=inner)@q, trailing=^InterpolationTrailing(src=extent)@q) ('}' / ^UnterminatedInterp@q)
nest holeText = (!'}' holeItem)*
holeItem = '"' (!'"' ('\\' . / .))* ('"' / ^UnterminatedInterpString@q)
         / '\'' (![\'\n] ('\\' . / .))* ('\'' / ^UnterminatedInterpChar@q)
         / '//' (!'\n' .)*
         / '{' holeText '}'?
         / .
// A string after its tag: a refusal in a hole points at the tag.
tagged = string
// A string with no hole: an import path, a test name, an `export to` path.
plainStr = &('"""' (!'"""' !('\\' '{') ('\\' . / .))* '"""' / '"' (!'"' !('\\' '{') ('\\' . / .))* '"') string

byte = q:'\'' byteBody ('\'' / eof ^UnterminatedByte@q / ^SingleQuotedString@q)
byteBody = eof ^UnterminatedByte@q
         / '\'' ^EmptyByte@q
         / '\\' (eof ^UnterminatedByteEscape@q / [ntr0\\'] / 'x' (hex hex / ^ByteHexDigits@q) / ^UnknownByteEscape(other=.)@q)
         / '\n' ^ByteNewline@q
         / [ -~]
         / ^ByteNotAscii@q

// ------------------------------------------------------------ declarations

// A `!` after a refusal: the refused token is past the cursor when recovery starts.
Ident = ident fail ^ExpectedIdent(found=found)!
Close = split '>'

Module = many Item until eof recover decl ItemStart
ItemStart = 'fn' / 'type' / 'protocol' / 'impl' / 'import' / 'export' / 'let' / 'logging'
          / 'mut' 'fn' / 'extern' 'fn' / 'gen' 'fn' / 'test' plainStr / 'bench' plainStr / ContractHead
ContractHead = 'contract' ident '{'
Item = doc* (&eof / Export / ?quote splice / Decl)

Export = 'export' ( &(ExportTo 'extern' 'fn') ExportTo ^ExportToExtern / ExportTo? +exported(ExportTarget) )
ExportTo = &('to' plainStr) 'to' plainStr (&(',' plainStr) ',' plainStr)*
ExportTarget = &('fn' / 'type' / 'protocol' / 'extern' 'fn' / 'gen' 'fn' / ContractHead / 'mut' 'fn') Decl
             / &'let' ^ModuleStateExport
             / ^ExportNeedsDecl

Decl = Import / TypeDecl / FnDecl / GenFn / MutFn / Protocol / Contract / Impl / Global
     / Extern / Test / Bench / Logging / ~^TopLevelExpected(found=found)

Import = i:'import' ( '*' ('as' / ^ImportStarAs(found=found)@(i,here)!) ns:Ident ('from' / ^ImportStarFrom(ns=ns, found=found)@(i,here)!) Source
                    / 'type'? '{' ('}' ^ImportEmpty@(i,here) / list ImportName sep ',' until '}' '}')
                      ('from' / ^ImportFrom(found=found)@(i,here)!) Source ) ';'?
// The host reads the names a module answers to as these close.
ImportName = Ident ('as' Ident)?
DeclName = Ident
Source = plainStr / &(ident '(') ident Args / ?quote splice / ^ImportPathExpected(found=found)@(i,here)

TypeDecl = 'type' DeclName ('<' list TName sep ',' until '>' Close)? '=' +collect(EnumType / Type) ('where' Expr)? ';'?
EnumType = 'enum' '{' list Variant sep ',' until '}' '}'
Variant = Ident ('(' list Type sep ',' until ')' ')')?

Global = 'let' 'mut'? n:DeclName (':' Type)? ('=' / ^GlobalNeedsInit(name=n)) Expr ';'?

FnDecl = 'fn' name:DeclName TypeBinder? Params Ret? ('where' +nostruct(Expr))? SkimBody
// The host skips these unread in a module it skims or imports.
SkimBody = Block
TestBody = Block
GenFn = &('gen' 'fn') 'gen' FnDecl
MutFn = &('mut' 'fn') 'mut' FnDecl
TypeBinder = '<' list TParam sep ',' until '>' Close
TParam = TName (':' Ident ('+' Ident)*)?
// A name a type then reads as bound: `TypeName` sets `scoped` for it.
TName = Ident
Params = '(' (Alone / list Param sep ',' until ')') ')'
Param = Ident ':' Cap? Type ('where' Expr)?
CapWord = 'read' / 'modify' / 'consume'
Cap = &(CapWord (ident / 'fn')) CapWord
Ret = '->' ( &('consume' (ident / '(' / 'fn')) ^ConsumeResult
           / &(('read' / 'modify') (ident / '(' / 'fn')) ^FreeFnCapability(name=name)!
           / Type )

Extern = &('extern' 'fn') 'extern' 'fn' DeclName Params ('->' Type)?
         ( ?exported (&'{' Block / ^ExportedExternBody) / &'{' ^ExternBody / ';'? )
Test = &('test' plainStr) 'test' plainStr TestBody
Bench = &('bench' plainStr) 'bench' plainStr TestBody

// The host refuses a second block as this closes.
LogHead = 'logging'
Logging = LogHead '{' (Alone / list LogField sep ',' until '}') '}'
LogField = k:'level' ':' LogLevel / k:'sink' ':' Sink / k:Ident ':' ^UnknownLoggingField(other=k)@k
LogLevel = 'trace' / 'debug' / 'info' / 'warn' / 'error' / n:Ident ^UnknownLogLevel(name=n)@k
Sink = 'stderr' / 'stdout' / s:'file' '(' (plainStr / ^FileSinkPath(found=found)@s!) ')' / n:Ident ^UnknownSink(other=n)@n

Protocol = 'protocol' pname:DeclName '{' (Alone / many PAssoc until (doc* !'type') many PItem until '}') '}'
PAssoc = doc* t:'type' n:TName (&'=' ^AssocTypeRhs(aname=n)@t / ';'?)
PItem = doc* ( &'}'
             / t:'type' n:Ident (&'=' ^AssocTypeRhs(aname=n)@t / ^AssocTypeAfterMethods(aname=n, name=pname)@t)
             / PMethod )
PMethod = 'fn' DeclName '(' Recv 'self' (',' Ident ':' Cap? Type)* ')' ('->' RCap? Type)? ';'?
Recv = SelfCap?
SelfCap = &(CapWord 'self') CapWord
RCap = &('consume' (ident / '(' / 'fn')) ^ConsumeResult / &(('read' / 'modify') (ident / '(' / 'fn')) ('read' / 'modify')

Contract = &ContractHead 'contract' cname:CName '{' (Alone / many CItem until ('}' / eof)) '}'
CName = Ident
CItem = doc* (&'}' / CLet / CFn / ^ContractMemberExpected(name=cname, found=found))
CLet = 'let' m:Ident (':' / ^ContractMemberNeedsType(name=m)) Type ('=' Expr)? ';'?
CFn = 'fn' ( '*' '(' (Alone / &('.' '.') '.' '.' / list CParam sep ',' until ')') ')' ('->' Type)? (&'=' ^ContractOpenRuleDefault)? ';'?
           / m:Ident '(' (Alone / &('.' '.') ^ContractMemberParams(name=m) / list CParam sep ',' until ')') ')' ('->' Type)? ('=' Expr)? ';'? )
CParam = Ident ':' Type

// The host sets `methods` as a method that is no projection closes.
Impl = 'impl' TypeBinder? proto:Ident 'for' ty:Type '{' -methods(Alone / many IItem until '}') '}'
IBind = IHead '=' Type
IHead = 'type' Ident
IItem = doc* ( &'}' / ?methods t:'type' n:Ident ^ImplAssocTypeOrder(aname=n, protocol=proto, ty=ty)@t / IBind ';'? / IMethod )
IMethod = 'fn' Ident '(' Recv 'self' (',' Ident ':' Cap? Type)* ')' ('->' RCap? Type)? Block

// ------------------------------------------------------------------ types

Type = Inter ('|' Inter)*
Inter = TypeAtom ('&' TypeAtom)*
nest TypeAtom = RecordType / FnType / int / DottedType / NamedType
FnType = 'fn' '(' list Type sep ',' until ')' ')' ('->' Type)?
DottedType = &(ident '.') ident ('.' Ident)+ ('<' list Type sep ',' until '>' Close)?
NamedType = Primitive
          / &('Stream' / 'Array' / 'SmallArray' / 'Map' / 'Option' / 'Result' / 'Omit' / 'Pick' / 'Merge' / 'Partial' / 'Readonly') Constructor
          / TypeName (?scoped / '<' list Type sep ',' until '>' Close)?
Primitive = 'Int64' / 'Int8' / 'Int16' / 'Int32' / 'UInt8' / 'UInt16' / 'UInt32' / 'UInt64'
          / 'Float64' / 'Float32' / 'F32x4' / 'I32x4' / 'Mask32x4' / 'F64x2' / 'Mask64x2'
          / 'Bool' / 'String' / 'Unit' / 'Logger'
Constructor = 'Stream' '<' Type Close
            / 'Array' '<' Type (',' (int / ^ArraySize))? Close
            / 'SmallArray' '<' Type (',' / ^SmallArrayNeedsCapacity) (int / ^SmallArrayCapacityType) Close
            / 'Map' '<' Type ',' Type Close
            / 'Option' '<' Type Close
            / 'Result' '<' Type ',' Type Close
            / n:('Omit' / 'Pick') '<' Type ((',' Ident)+ Close / Close ^NeedsField(name=n))
            / 'Merge' '<' Type ',' Type Close
            / 'Partial' '<' Type Close
            / 'Readonly' '<' Type Close
// The host sets `scoped` as this closes: a type parameter or an associated type
// in scope takes no type arguments.
TypeName = Ident
// Only the outermost record of a `type` declaration may refine a field.
RecordType = ?collect -collect(+named(RecordBody)) / -named(RecordBody)
RecordBody = '{' (Alone / list Field sep ',' until '}') '}'
Field = Ident ':' ( l:'lazy' (?named / ^LazyAnonymous@l) Type (w:'where' Expr (?named / ^WhereAnonymous@w) ^LazyWhere@w)?
                  / Type (w:'where' Expr (?named / ^WhereAnonymous@w))? )

// ------------------------------------------------------------- statements

nest Block = '{' many BItem until ('}' / eof) recover stmt '}'
// A bracket on the line after a hole reads as a call or an index of a name, or, where
// that reading fails, as a statement after the hole's.
BItem = doc / ';' / ?quote &(splice !nonl ('(' / '[')) (@Stmt / splice) / Stmt
Stmt = Let / Return / Break / Continue / If / While / For / Region / Drop / Assign / ExprStmt
Let = l:'let' ( &('mut' ident '(') 'mut' v:ident ^LetMutPattern(variant=v)@(l,v)
              / &(ident '(') RefLet
              / 'mut'? Ident (':' Type ('where' Expr)?)? '=' Expr ';'? )
RefLet = ident '(' list Ident sep ',' until ')' ')' '=' Expr ';'?
Return = 'return' (&(';' / '}' / eof) / Expr) ';'?
Break = 'break' ';'?
Continue = 'continue' ';'?
If = 'if' ('let' Pattern '=' +nostruct(Expr) Block Else? / +nostruct(Expr) Block Else?)
Else = 'else' ('if' ('let' Pattern '=' +nostruct(Expr) Block Else? / +nostruct(Expr) Block Else?) / Block)
While = 'while' ('let' Pattern '=' +nostruct(Expr) Block / +nostruct(Expr) Block)
For = 'for' Ident 'in' (&('consume' ident) 'consume')? +nostruct(Expr) Block
Region = 'region' Block
Drop = 'drop' Ident ';'?
Assign = &((ident / 'self') '=') (Ident / 'self') '=' Expr ';'?
ExprStmt = StmtExpr (?place '=' Expr ';'? / PlainStmt)
// The host checks a call's write-back as this closes.
PlainStmt = ';'?
// The host sets `place` as this closes, when a store could follow: whether the
// expression is a place.
StmtExpr = Expr

// ------------------------------------------------------------ expressions

Expr = climb Unary {
    left '||'
    left '&&'
    left '==' '!=' '=~'
    left '<' '<=' '>' '>='
    right '??'
    left '|'
    left '^'
    left '&'
    left '<<' '>>'
    left '+' '-'
    left '*' '/' '%'
    }
nest Unary = '-' Unary / '!' Unary / '~' Unary
           / &('consume' (ident / 'self')) 'consume' Postfix
           / &('await' (ident / 'self')) AwaitTail
           / Postfix
// The host refuses `await` over no call as this closes.
AwaitTail = 'await' Postfix
// Each link adds a node the later walks recurse into, so each counts toward `nest`.
Postfix = Primary many Link until !('?' / '.' / '[') recover nest
Link = '?' / '.' Ident Args? / '[' -nostruct(Expr) ']'
Args = '(' -nostruct(list Expr sep ',' until ')') ')'

Primary = &(ident '->') Lambda
        / !?nostruct &(ident '.' ident '{') NsStruct
        / &(ident nonl string) ( 'vyrn' tagged
                               / &(ident plainStr) t:ident ^TemplateNoHole(name=t)@t
                               / Tagged )
        / IdentExpr
        / number / byte / string / 'true' / 'false'
        / ArrayLit / Match / IfExpr
        / &'(' &LambdaHead Lambda
        / &'||' ^LambdaNotHere(form='||', fix='`() -> ...`')
        / &'|' ^LambdaNotHere(form='|x|', fix='`x -> ...`, or `(x, y) -> ...` for more than one')
        / !?nostruct &('self' '.' ident '{') NsStruct
        / 'self'
        / !?nostruct &'(' &(VarHead '.' ident '{') NsStruct
        / '(' -nostruct(Expr) ')'
        fail ^UnexpectedToken(found=found)!
NsStruct = VarHead '.' ident StructBody
VarHead = ident / 'self' / '(' VarHead ')'
Tagged = ident tagged
IdentExpr = ident (&('.' ident '?' '(') Folded)* (&('?' '(') Fallible)? (&'<' @(TypeArgs &'('))? (Args / !?nostruct StructBody / )
Folded = '.' ident
Fallible = '?'
TypeArgs = '<' Type (',' Type)* '>'
StructBody = '{' -nostruct(Alone / list SField sep ',' until '}') '}'
SField = Ident ':' Expr
LambdaHead = '(' ')' '->' / '(' ident (',' ident)* ')' '->'
Lambda = (ident / '(' list Ident sep ',' until ')' ')') '->' (Block / -nostruct(Expr))
ArrayLit = '[' -nostruct( ':' ']' / ']'
                        / Expr ( ':' Expr (',' (&']' / Expr ':' Expr))* ']' / (',' (&']' / Expr))* ']' ) )
Match = 'match' +nostruct(Expr) '{' (Alone / many Arm until ('}' / eof)) '}'
Arm = Pattern '=>' (Block ','? / Expr (',' / ?quote &eof / &'}'))
Pattern = Ident ('.' Ident)* ('(' list Ident sep ',' until ')' ')')?
IfExpr = i:'if' IfTail
IfTail = &'let' ^IfLetExpr@(i,here) / +nostruct(Expr) IfBranch ('else' (i:'if' IfTail / IfBranch))?
IfBranch = b:'{' ( &('let' / 'return' / 'while' / 'for' / 'region' / 'drop' / 'break' / 'continue') ^IfExprStatements
                 / -nostruct(Expr) (&'}' / ^IfExprStatements@(b,here)) ) '}'

// ------------------------------------------------------------- code quotes

// A code quote's text, its holes as NULs. A type, an expression and one item of a
// list come first, because a statement cannot read each of them. No other text
// reaches this rule, so no other parse sets `quote`.
Quote = +quote( @(Type eof) / @(Expr eof)
              / @(list SField sep ',' until eof eof) / @(list Param sep ',' until eof eof) / @(many Arm until eof)
              / many Lead until !LeadStart (&DeclStart Module / many BItem until eof recover stmt) )
// A list of declarations and a list of statements both hold these, so the first
// item past them says which list the text is.
Lead = doc / Let / splice
LeadStart = doc / 'let' / splice (doc / 'let' / splice / eof / DeclStart)
// `fn (` starts a type, and a `logging` that opens no block is a name.
DeclStart = !'let' !('fn' '(') !('logging' !'{') ItemStart
// A hole alone in its brackets stands for the whole list there, possibly empty.
Alone = ?quote &(splice (')' / '}')) splice
