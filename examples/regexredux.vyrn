// regex-redux, from the Computer Language Benchmarks Game.
import { compile, countMatches, replaceAll, Regex } from "std/regex"
import { joinWith } from "std/strings"

fn readAll() -> String {
    let mut parts: Array<String> = []
    while let Some(l) = readLine() {
        parts.push(l)
    }
    return joinWith(parts, "\n") + "\n"
}

fn variants() -> Array<String> {
    return [
        "agggtaaa|tttaccct",
        "[cgt]gggtaaa|tttaccc[acg]",
        "a[act]ggtaaa|tttacc[agt]t",
        "ag[act]gtaaa|tttac[agt]ct",
        "agg[act]taaa|ttta[agt]cct",
        "aggg[acg]aaa|ttt[cgt]ccct",
        "agggt[cgt]aa|tt[acg]accct",
        "agggta[cgt]a|t[acg]taccct",
        "agggtaa[cgt]|[acg]ttaccct",
    ]
}

fn substitutions() -> Array<Array<String>> {
    return [
        ["tHa[Nt]", "<4>"],
        ["aND|caN|Ha[DS]|WaS", "<3>"],
        ["a[NSt]|BY", "<2>"],
        ["<[^>]*>", "|"],
        ["\\|[^|][^|]*\\|", "-"],
    ]
}

fn compiled(pattern: String) -> Regex {
    return match compile(pattern) {
        Ok(re) => re,
        Err(why) => panic("`\{pattern}`: \{why}"),
    }
}

fn main() -> Int64 {
    let input = readAll()
    let inputLength = input.byteLength

    let sequence = replaceAll(compiled(">[^\n]*\n|\n"), input, "")
    let cleanLength = sequence.byteLength

    for pattern in variants() {
        print("\{pattern} \{countMatches(compiled(pattern), sequence)}")
    }

    let mut rewritten = sequence.copy()
    for pair in substitutions() {
        rewritten = replaceAll(compiled(pair[0]), rewritten, pair[1])
    }

    print("")
    print("\{inputLength}")
    print("\{cleanLength}")
    print("\{rewritten.byteLength}")
    return 0
}
