// `for x in consume xs`: moving elements out of a container.

fn spliced(a: consume Array<String>, b: consume Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    for x in consume a {
        out.push(x)
    }
    for x in consume b {
        out.push(x)
    }
    return out
}

fn make(prefix: String, n: Int64) -> Array<String> {
    let mut out: Array<String> = []
    let mut i = 0
    while i < n {
        out.push(prefix + i.toString())
        i = i + 1
    }
    return out
}

fn lengthsOf(names: Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    for n in names {
        out.push(n.copy())
    }
    return out
}

fn joinTemporary(prefix: String, n: Int64) -> String {
    let mut out = ""
    for s in make(prefix, n) {
        out = out + s + ";"
    }
    return out
}

fn firstShort(xs: consume Array<String>, limit: Int64) -> Int64 {
    let mut n = 0
    for x in consume xs {
        if Int64(x.byteLength) > limit {
            break
        }
        n = n + 1
    }
    return n
}

fn firstLong(xs: consume Array<String>, limit: Int64) -> Int64 {
    for x in consume xs {
        if Int64(x.byteLength) > limit {
            return Int64(x.byteLength)
        }
    }
    return 0
}

fn show(label: String, xs: Array<String>) {
    let mut line = label + ":"
    for x in xs {
        line = line + " " + x
    }
    print(line)
}

fn main() -> Int64 {
    let joined = spliced(make("a", 3), make("b", 2))
    show("joined", joined)
    print("count " + joined.length.toString())

    let parts = make("p", 4)
    let mut taken: Array<String> = []
    for p in consume parts {
        taken.push(p)
    }
    show("taken", taken)

    let echoed = lengthsOf(taken)
    show("echoed", echoed)
    show("taken again", taken)

    print(joinTemporary("t", 3))

    let empty: Array<String> = []
    let mut none: Array<String> = []
    for e in consume empty {
        none.push(e)
    }
    print("none " + none.length.toString())

    print("short " + firstShort(make("s", 12), 2).toString())
    print("long " + firstLong(make("l", 12), 2).toString())
    return 0
}
