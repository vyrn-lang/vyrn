// Refused on purpose: a protocol impl for a validated scalar.

type Age = Int64 where value >= 18

protocol Show {
    fn show(self) -> String
}

impl Show for Age {
    fn show(self) -> String { return "age " + self.toString() }
}

fn main() -> Int64 {
    let a: Age = 21
    print(a.show())
    return 0
}
