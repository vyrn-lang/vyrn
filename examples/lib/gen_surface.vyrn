/// A generator that uses the code-quote surface builtins, and imports nothing.
///
/// It exists to be imported by a program that declares its OWN `name` and
/// `render`. The surface builtins are unreserved on purpose, so both meanings
/// have to coexist in one program: this module means the builtins, because it
/// declares neither.
export gen fn surface(tag: String) -> Code {
    let fnName = name(render(vyrn"tagged"))
    return vyrn"export fn \{fnName}() -> String { return \{tag} }"
}
