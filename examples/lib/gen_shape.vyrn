/// A generator annotation: `@shapeOf` on a type declaration writes
/// `shapeOf<Name>(v)`, which describes the declaration's shape.

import { joinWith } from "std/strings"

/// The words for one node: its kind, with a record's fields and an array's
/// element spelled out one level deep.
gen fn describe(nodes: Array<TypeArgNode>, i: Int64) -> String {
    let n = nodes[i].shape
    if n.kind == "record" {
        let mut fields: Array<String> = []
        for m in n.members {
            fields.push(m.name + ": " + nodes[m.args[0]].shape.kind)
        }
        return "record { " + joinWith(fields, ", ") + " }"
    }
    if n.kind == "array" || n.kind == "option" {
        return n.kind + " of " + nodes[n.args[0]].shape.kind
    }
    if n.kind == "enum" {
        let mut arms: Array<String> = []
        for m in n.members {
            arms.push(m.name.copy())
        }
        return "enum " + joinWith(arms, " | ")
    }
    return n.kind.copy()
}

export gen fn shapeOf(t: TypeCode, iface: ModuleInterface) -> Code {
    let f = name("shapeOf" + t.info.name)
    let words = t.info.name + " is " + describe(t.nodes, 0)
    return vyrn"""
        fn \{f}(v: \{name(t.info.name)}) -> String {
            return \{words}
        }
        """
}
