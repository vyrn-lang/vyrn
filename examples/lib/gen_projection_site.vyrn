/// Its `probe` sits on the node and line of `projection_generator_site`'s.
fn d1() -> Int64 {
    print(1)
    return 0
}

type Q = { v: Array<Int64> }

impl Index for Q {
    fn at(read self, i: Int64) -> read Int64 {
        return self.v[i]
    }
    fn pick(read self, i: Int64) -> read Int64 {
        return self.v[0]
    }
}

fn probe(q: Q) -> Int64 {
    return q.pick(1)
}

export gen fn mk(a: String) -> String {
    return "export fn v() -> Int64 { return 7 }"
}
