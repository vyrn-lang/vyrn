fn sumFixed() -> Int64 {
    let squares: Array<Int64, 5> = [0, 1, 4, 9, 16]
    let mut total = 0
    for s in squares {
        total = total + s
    }
    return total // 0+1+4+9+16 = 30
}

fn countLongWords() -> Int64 {
    let mut words: Array<String> = []
    words.push("hi")
    words.push("there")
    words.push("friend")
    words.push("yo")

    let mut long = 0
    for w in words {
        print(w)
        if w.byteLength > 2 {
            long = long + 1
        }
    }
    return long // "there" and "friend" -> 2
}

fn main() -> Int64 {
    let a = sumFixed()
    print(a) // 30
    let b = countLongWords()
    print(b) // 2
    return a + b // 32
}
