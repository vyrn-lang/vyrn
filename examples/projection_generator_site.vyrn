// This `probe` and the one in lib/gen_projection_site.vyrn share a node and a line,
// and each expands its own program's `pick`, so this prints 37.
// Keep `fn probe` on line 18, its line in lib/gen_projection_site.vyrn.
import { mk } from "./lib/gen_projection_site"
import { v } from mk("x")

export type Q = { v: Array<Int64> }

impl Index for Q {
    fn at(read self, i: Int64) -> read Int64 {
        return self.v[i]
    }
    fn pick(read self, i: Int64) -> read Int64 {
        return self.v[2]
    }
}

fn probe(q: Q) -> Int64 {
    return q.pick(1)
}

fn main() -> Int64 {
    print(probe(Q { v: [10, 20, 30] }) + v())
    return 0
}
