// A `for` forks one waiting call per element, and `joinAll` returns the results
// in index order; `timeout` races a task against a timer. Both are `std/task`
// code over tasks, so the calls start in order and a timed-out task is
// cancelled where it waits, releasing what it holds.
import { joinAll, timeout, sleep } from "std/task"

fn fetch(ms: Int64) -> String {
    let url = "/item/\{ms}"
    print("start \{url}")
    await sleep(ms)
    print("end \{url}")
    return "\{url}: \{ms * 2}"
}

fn slow() -> String {
    let held = "a slow answer"
    await sleep(60)
    return held
}

fn quick() -> String {
    await sleep(3)
    return "a quick answer"
}

fn main() -> Int64 {
    let delays: Array<Int64> = [30, 10, 20]
    let mut started: Array<Task<String>> = []
    for ms in delays {
        started.push(fork fetch(ms))
    }
    let pages = await joinAll(started)
    for p in pages {
        print(p)
    }
    let none: Array<Int64> = []
    let mut idle: Array<Task<String>> = []
    for ms in none {
        idle.push(fork fetch(ms))
    }
    let empty = await joinAll(idle)
    print("\{empty.length} pages from none")
    print(await timeout(20, fork slow()) ?? "timed out")
    print(await timeout(20, fork quick()) ?? "timed out")
    return 0
}
