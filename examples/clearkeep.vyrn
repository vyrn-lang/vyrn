// `clear` keeps the buffer, so the next fill reuses it.

fn fill(xs: consume Array<UInt8>, from: Int64, n: Int64) -> Array<UInt8> {
    let mut out = xs
    let mut i = 0
    while i < n {
        out.push(UInt8(from + i))
        i = i + 1
    }
    return out
}

fn main() -> Int64 {
    let mut w: Array<UInt8> = []
    w = fill(w, 65, 3)
    print(w.length)
    print(w[2])
    w.clear()
    print(w.length)
    w = fill(w, 97, 5)
    print(w.length)
    print(w[0])
    print(w[4])
    w.clear()
    w.clear()
    print(w.length)
    return 0
}
