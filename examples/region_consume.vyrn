// Refused on purpose: a region value handed to a `consume` parameter.

type Box = { s: String }

let mut kept: Array<String> = []

let mut boxed: Array<Box> = []

fn keep(s: consume String) {
    kept.push(s)
}

fn wrap(s: consume String) -> Box {
    return Box { s: s }
}

fn stash(b: consume Box) {
    boxed.push(b)
}

fn main() -> Int64 {
    region {
        let mut i = 0
        while i < 3 {
            keep("regionvalue-" + i.toString())
            i = i + 1
        }
    }
    region {
        stash(wrap("boxed-" + "1"))
    }
    print(kept.length + boxed.length)
    return 0
}
