// Benchmarks of the common operations.

import { joinWith, split } from "std/strings"
import { Json, JsonField, emit } from "std/json"
import { parseJson } from "std/jsonread"

fn keyList(n: Int64, prefix: String) -> Array<String> {
    let mut out: Array<String> = []
    let mut i = 0
    while i < n {
        out.push(prefix + i.toString())
        i = i + 1
    }
    return out
}

fn mapBuild(ks: Array<String>) -> Map<String, Int64> {
    let mut m: Map<String, Int64> = [:]
    let mut i = 0
    while i < ks.length {
        m[ks[i].copy()] = i
        i = i + 1
    }
    return m
}

fn mapHits(m: Map<String, Int64>, ks: Array<String>) -> Int64 {
    let mut t = 0
    let mut i = 0
    while i < ks.length {
        t = t + match m[ks[i]] {
            Some(v) => v,
            None => 0,
        }
        i = i + 1
    }
    return t
}

fn mapMisses(m: Map<String, Int64>, ks: Array<String>) -> Int64 {
    let mut t = 0
    let mut i = 0
    while i < ks.length {
        t = t + match m[ks[i]] {
            Some(v) => v,
            None => 1,
        }
        i = i + 1
    }
    return t
}

fn interpolate(ks: Array<String>) -> Int64 {
    let mut t = 0
    let mut i = 0
    while i < ks.length {
        let row = "row \{i}: \{ks[i]}"
        t = t + Int64(row.byteLength)
        i = i + 1
    }
    return t
}

protocol Weigh {
    fn weigh(self) -> Int64
}

type Stone = { grams: Int64 }

impl Weigh for Stone {
    fn weigh(self) -> Int64 {
        return self.grams + 1
    }
}

fn weighN<T: Weigh>(x: T, n: Int64) -> Int64 {
    let mut t = 0
    let mut i = 0
    while i < n {
        t = (t * 31 + x.weigh() + i) % 1000000007
        i = i + 1
    }
    return t
}

type Bump = fn(Int64) -> Int64

fn callN(f: Bump, n: Int64) -> Int64 {
    let mut t = 0
    let mut i = 0
    while i < n {
        t = (t * 31 + f(i)) % 1000000007
        i = i + 1
    }
    return t
}

fn doc(n: Int64) -> Json {
    let mut fs: Array<JsonField> = []
    let mut i = 0
    while i < n {
        fs.push(JsonField { key: "field\{i}", value: JNum(i.toString()) })
        i = i + 1
    }
    return JObj(fs)
}

fn size(j: Json) -> Int64 {
    return match j {
        JNull => 0,
        JBool(b) => if b { 1 } else { 0 },
        JNum(s) => Int64(s.byteLength),
        JStr(s) => Int64(s.byteLength),
        JArr(xs) => xs.length,
        JObj(fs) => fs.length,
    }
}

fn parseSize(r: Result<Json, String>) -> Int64 {
    return match r {
        Ok(j) => size(j),
        Err(e) => 0 - Int64(e.byteLength),
    }
}

bench "map build, 1000 string keys" {
    blackBox(mapBuild(blackBox(keyList(blackBox(1000), blackBox("keykeykeykey")))).length)
}

bench "map lookup hit, 1000 keys" {
    let ks = keyList(blackBox(1000), blackBox("keykeykeykey"))
    let m = mapBuild(blackBox(ks))
    blackBox(mapHits(blackBox(m), blackBox(ks)))
}

bench "map lookup miss, 1000 keys" {
    let ks = keyList(blackBox(1000), blackBox("keykeykeykey"))
    let m = mapBuild(blackBox(ks))
    let absent = keyList(blackBox(1000), blackBox("nonenonenone"))
    blackBox(mapMisses(blackBox(m), blackBox(absent)))
}

bench "string interpolation, 1000 rows" {
    blackBox(interpolate(blackBox(keyList(blackBox(1000), blackBox("keykeykeykey")))))
}

bench "joinWith over 1000 parts" {
    let ks = keyList(blackBox(1000), blackBox("keykeykeykey"))
    blackBox(joinWith(blackBox(ks), blackBox(",")).byteLength)
}

bench "split of a 1000-field line" {
    let line = joinWith(keyList(blackBox(1000), blackBox("keykeykeykey")), ",")
    blackBox(split(blackBox(line), blackBox(",")).length)
}

bench "protocol dispatch, 10000 calls" {
    blackBox(weighN(blackBox(Stone { grams: 41 }), blackBox(10000)))
}

bench "fn-value dispatch, 10000 calls" {
    blackBox(callN(x -> x * 3 + 1, blackBox(10000)))
}

bench "json emit, 20 x 200-member object" {
    let j = doc(blackBox(200))
    let mut t = 0
    let mut i = 0
    while i < 20 {
        t = t + Int64(emit(blackBox(j)).byteLength)
        i = i + 1
    }
    blackBox(t)
}

bench "json parse, 20 x 200-member object" {
    let src = emit(doc(blackBox(200)))
    let mut t = 0
    let mut i = 0
    while i < 20 {
        t = t + parseSize(parseJson(blackBox(src)))
        i = i + 1
    }
    blackBox(t)
}

fn main() -> Int64 {
    let ks = keyList(4, "k")
    let m = mapBuild(ks)
    print(m.length)
    print(mapHits(m, ks))
    print(mapMisses(m, keyList(4, "absent")))
    print(interpolate(ks))
    print(joinWith(ks, ","))
    print(split(joinWith(ks, ","), ",").length)
    print(weighN(Stone { grams: 41 }, 4))
    print(callN(x -> x * 3 + 1, 4))
    print(size(doc(4)))
    print(parseSize(parseJson(emit(doc(4)))))
    return 0
}
