// `bench` blocks, `blackBox` and `vyrn bench`.

fn hashTo(n: Int64) -> Int64 {
    let mut h = 0
    let mut i = 0
    while i < n {
        h = (h * 31 + i) % 1000000007
        i = i + 1
    }
    return h
}

bench "hash to 1000" {
    blackBox(hashTo(blackBox(1000)))
}

bench "push 1000" {
    let mut xs: Array<Int64> = []
    let mut i = 0
    while i < 1000 {
        xs.push(i)
        i = i + 1
    }
    blackBox(xs.length)
}

fn main() -> Int64 {
    print(hashTo(1000))
    return 0
}
