// Refused on purpose: a stream passed through a combinator and never disposed.
import { map, filter, take } from "std/stream"

fn feed() -> Stream<Int64> {
    let xs: Array<Int64> = [1, 2, 3]
    return fromArray(xs)
}

fn double(n: Int64) -> Int64 {
    return n * 2
}

fn odd(n: Int64) -> Bool {
    return n % 2 == 1
}

fn main() -> Int64 {
    let mapped = map(feed(), double)
    print(0)

    let chained = take(filter(feed(), odd), 2)
    print(1)

    let twice = map(feed(), double)
    for v in twice {
        print(v)
    }
    close(twice)

    return 0
}
