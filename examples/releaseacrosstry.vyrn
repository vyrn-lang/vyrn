// A declared `release` across a `?` early return.

protocol Owned {
    fn release(consume self)
}

type Ring = {
    label: String
}

impl Owned for Ring {
    fn release(consume self) {
        print("release " + self.label)
        let label = consume self.label
        drop label
    }
}

fn ringOf(label: String) -> Ring {
    return Ring { label: label.copy() }
}

fn missing() -> Option<Int64> {
    return None
}

fn failing() -> Result<Int64, String> {
    return Err("no")
}

fn overOption() -> Option<Int64> {
    let r = ringOf("option")
    let v = missing()?
    return Some(v)
}

fn overResult() -> Result<Int64, String> {
    let r = ringOf("result")
    let v = failing()?
    return Ok(v)
}

fn nested() -> Option<Int64> {
    let outer = ringOf("outer")
    if true {
        let inner = ringOf("inner")
        let v = missing()?
        return Some(v)
    }
    return Some(0)
}

fn overReturn() -> Option<Int64> {
    let r = ringOf("return")
    return None
}

fn main() -> Int64 {
    let a = overOption()
    print("after option")
    let b = overResult()
    print("after result")
    let c = nested()
    print("after nested")
    let d = overReturn()
    print("after return")
    return 0
}
