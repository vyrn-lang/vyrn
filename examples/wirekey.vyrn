// `Map<Int64, V>` through JSON.
type Counts = Map<Int64, Int64>

fn main() -> Int64 {
    let mut m: Counts = [:]
    m[7] = 1
    m[0 - 3] = 2
    m.tally(7, 4)
    let s = toJson(m)
    print(s)
    match fromJson<Counts>(s) {
        Valid(back) => {
            print("\{back.length}")
            print(match back[7] {
                Some(v) => "\{v}",
                None => "?",
            })
            print(match back[0 - 3] {
                Some(v) => "\{v}",
                None => "?",
            })
            for k in back.keys() {
                print("\{k}")
            }
        }
        Invalid(iss) => print("invalid: \{iss.length}"),
    }
    match fromJson<Counts>("{\"007\": 1}") {
        Valid(v) => print("aliased"),
        Invalid(iss) => print("issues \{iss.length}"),
    }
    return 0
}
