// The exact bytes `toJson` produces.

type Esc = { s: String }

type Nums = {
    i: Int64,
    i8v: Int8,
    u8v: UInt8,
    i16v: Int16,
    u32v: UInt32,
    u64v: UInt64,
    f: Float64,
    f32v: Float32,
}

type Nest = { name: String, tags: Array<String>, opt: Option<Int64>, on: Bool }

fn ctl(b: UInt8) -> String {
    let mut out: Array<UInt8> = []
    out.push('a')
    out.push(b)
    out.push('z')
    return match stringFromBytes(out) {
        Ok(v) => v,
        Err(e) => "<rejected: " + e + ">",
    }
}

fn ctlJson(b: UInt8) -> String {
    return toJson(Esc { s: ctl(b) })
}

fn main() -> Int64 {
    let mut c = 0
    while c < 32 {
        print(ctlJson(UInt8(c)))
        c = c + 1
    }
    print(ctlJson(UInt8(127)))
    print(toJson(Esc { s: "quote\" back\\ slash/ plain" }))
    print(toJson(Esc { s: "utf8 ä € 𝄞 日本" }))
    print(toJson(Esc { s: "" }))

    let big: UInt64 = 18446744073709551615
    let edges = Nums {
        i: -9223372036854775807,
        i8v: Int8(-128),
        u8v: UInt8(255),
        i16v: Int16(-32768),
        u32v: UInt32(4294967295),
        u64v: big,
        f: 0.0,
        f32v: Float32(1.5),
    }
    let opposite = Nums {
        i: 0,
        i8v: Int8(127),
        u8v: UInt8(0),
        i16v: Int16(32767),
        u32v: UInt32(0),
        u64v: UInt64(0),
        f: -1.0 / 3.0,
        f32v: Float32(-0.25),
    }
    let wide = Nums {
        i: 1,
        i8v: Int8(0),
        u8v: UInt8(1),
        i16v: Int16(0),
        u32v: UInt32(1),
        u64v: UInt64(1),
        f: 1234567890.123456,
        f32v: Float32(0.0),
    }
    print(toJson(edges))
    print(toJson(opposite))
    print(toJson(wide))

    print(toJson(Nest { name: "n", tags: [], opt: None, on: false }))
    print(toJson(Nest { name: "n", tags: ["a", "b"], opt: Some(7), on: true }))
    return 0
}

test "escapes with a short form" {
    assertEq(ctlJson(UInt8(9)), "{\"s\":\"a\\tz\"}")
    assertEq(ctlJson(UInt8(10)), "{\"s\":\"a\\nz\"}")
    assertEq(ctlJson(UInt8(13)), "{\"s\":\"a\\rz\"}")
    assertEq(toJson(Esc { s: "q\"q" }), "{\"s\":\"q\\\"q\"}")
    assertEq(toJson(Esc { s: "b\\b" }), "{\"s\":\"b\\\\b\"}")
}

test "escapes as \\u00XX, lowercase hex" {
    assertEq(ctlJson(UInt8(1)), "{\"s\":\"a\\u0001z\"}")
    assertEq(ctlJson(UInt8(11)), "{\"s\":\"a\\u000bz\"}")
    assertEq(ctlJson(UInt8(27)), "{\"s\":\"a\\u001bz\"}")
    assertEq(ctlJson(UInt8(31)), "{\"s\":\"a\\u001fz\"}")
}

test "0x08 and 0x0c are the two writers' only disagreement" {
    assertEq(ctlJson(UInt8(8)), "{\"s\":\"a\\bz\"}")
    assertEq(ctlJson(UInt8(12)), "{\"s\":\"a\\fz\"}")
}

test "leaves alone what JSON does not require escaping" {
    assertEq(toJson(Esc { s: "a/b" }), "{\"s\":\"a/b\"}")
    assertEq(toJson(Esc { s: "ä€" }), "{\"s\":\"ä€\"}")
    assertEq(toJson(Esc { s: "" }), "{\"s\":\"\"}")
}

test "integers are exact and unsigned stays unsigned" {
    let big: UInt64 = 18446744073709551615
    let n = Nums {
        i: -9223372036854775807,
        i8v: Int8(-128),
        u8v: UInt8(255),
        i16v: Int16(-32768),
        u32v: UInt32(4294967295),
        u64v: big,
        f: 0.0,
        f32v: Float32(1.5),
    }
    assertEq(
        toJson(n),
        "{\"i\":-9223372036854775807,\"i8v\":-128,\"u8v\":255,\"i16v\":-32768,"
        + "\"u32v\":4294967295,\"u64v\":18446744073709551615,"
        + "\"f\":0.000000,\"f32v\":1.500000}",
    )
}

test "floats are fixed-point %f, six places, never an exponent" {
    let n = Nums {
        i: 0,
        i8v: Int8(0),
        u8v: UInt8(0),
        i16v: Int16(0),
        u32v: UInt32(0),
        u64v: UInt64(0),
        f: -1.0 / 3.0,
        f32v: Float32(-0.25),
    }
    assertEq(
        toJson(n),
        "{\"i\":0,\"i8v\":0,\"u8v\":0,\"i16v\":0,\"u32v\":0,\"u64v\":0,"
        + "\"f\":-0.333333,\"f32v\":-0.250000}",
    )
}

test "field order is declaration order, None omitted, no whitespace" {
    assertEq(
        toJson(Nest { name: "n", tags: [], opt: None, on: false }),
        "{\"name\":\"n\",\"tags\":[],\"on\":false}",
    )
    assertEq(
        toJson(Nest { name: "n", tags: ["a", "b"], opt: Some(7), on: true }),
        "{\"name\":\"n\",\"tags\":[\"a\",\"b\"],\"opt\":7,\"on\":true}",
    )
}
