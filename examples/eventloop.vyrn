// Module state and the host-driven event loop.

let mut hits: Int64 = 0
let mut total: Int64 = 0
let banner = "vyrn counter"

fn main() -> Int64 {
    print(banner)
    let mut i = 0
    while i < 3 {
        let n = onTick()
        print("tick -> \{n}")
        i = i + 1
    }
    print("total after 3 ticks: \{total}")
    reset()
    print("after reset -> \{hits}")
    let n = onTick()
    print("tick -> \{n}")
    return 0
}

export extern fn onTick() -> Int64 {
    hits = hits + 1
    total = total + hits
    return hits
}

export extern fn reset() {
    hits = 0
}
