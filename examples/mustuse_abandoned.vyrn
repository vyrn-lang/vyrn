// Refused on purpose: a declared obligation that is dropped.

protocol MustUse {}

protocol Owned {
    fn release(self)
}

type Txn = {
    label: String,
    ops: Array<String>
}

impl MustUse for Txn {}

impl Owned for Txn {
    fn release(self) {
        print("end " + self.label)
        let ops = self.ops
        drop ops
    }
}

fn begin(label: String) -> Txn {
    let mut ops: Array<String> = []
    ops.push(label.copy())
    return Txn { label: label.copy(), ops: ops }
}

fn finish(t: consume Txn) {
    drop t
}

fn main() -> Int64 {
    let a = begin("orders")
    print(0)

    let b = begin("ledger")
    finish(b)
    drop b

    let c = begin("audit")
    if true {
        finish(c)
    }

    let mut pool: Array<Txn> = []
    pool.push(begin("batch"))

    return 0
}
