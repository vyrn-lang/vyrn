// `?` on a user type through the `Fallible` protocol.

import { Fallible } from "std/fallible"

type Http =
    | Body(String)
    | Created(String)
    | NotFound
    | ServerError(String)

impl Fallible for Http {
    type Output = String

    fn isSuccess(self) -> Bool {
        return match self {
            Body(b) => true,
            Created(b) => true,
            NotFound => false,
            ServerError(m) => false,
        }
    }

    fn success(self) -> Output {
        return match self {
            Body(b) => b.copy(),
            Created(b) => b.copy(),
            NotFound => panic("Fallible.success on NotFound"),
            ServerError(m) => panic("Fallible.success on ServerError"),
        }
    }
}

fn fetch(code: Int64) -> Http {
    if code == 200 {
        return Body("hello")
    }
    if code == 201 {
        return Created("made")
    }
    if code == 404 {
        return NotFound
    }
    return ServerError("upstream timed out")
}

fn greet(code: Int64) -> Http {
    let body = fetch(code)?
    return Body("<<" + body + ">>")
}

fn describe(h: Http) -> String {
    return match h {
        Body(b) => "body " + b,
        Created(b) => "created " + b,
        NotFound => "not found",
        ServerError(m) => "server error: " + m,
    }
}

fn main() -> Int64 {
    print(describe(greet(200))) // body <<hello>>
    print(describe(greet(201))) // body <<made>>
    print(describe(greet(404))) // not found
    print(describe(greet(500))) // server error: upstream timed out
    return 0
}
