// A function spelled like the flattened method of `impl Size for P` is a
// declaration of its own: `p.size()` runs the impl and `Size__P__size(p)`
// runs the function.

type P = { x: Int64 }

protocol Size {
    fn size(self) -> Int64
}

fn Size__P__size(p: P) -> Int64 {
    return 99
}

impl Size for P {
    fn size(self) -> Int64 {
        return self.x
    }
}

fn main() -> Int64 {
    let p = P { x: 1 }
    print(p.size())
    print(Size__P__size(p))
    return 0
}
