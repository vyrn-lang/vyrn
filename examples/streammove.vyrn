// `fromArray` and `fromStep` take their argument.

fn named() -> Int64 {
    let xs: Array<Int64> = [1, 2, 3]
    let s = fromArray(xs)
    let mut sum = 0
    for v in s {
        sum = sum + v
    }
    return sum
}

fn strings() -> Unit {
    let names: Array<String> = ["ada", "grace", "alan"]
    for n in fromArray(names) {
        print(n)
    }
}

fn mk() -> Array<Int64> {
    let xs: Array<Int64> = [10, 20, 30]
    return xs
}

fn stepped() -> Int64 {
    let each = 7
    let mut left = 3
    let run: fn(Int64, Int64, Bool) -> Option<Int64> = (slot, gen, closing) -> {
        if closing {
            return None
        }
        return Some(each)
    }
    let s = fromStep(0, 0, run)
    let mut sum = 0
    for v in s {
        sum = sum + v
        left = left - 1
        if left <= 0 {
            break
        }
    }
    return sum
}

fn main() -> Int64 {
    print(named()) // 6
    strings() // ada grace alan
    for v in fromArray(mk()) {
        print(v) // 10 20 30
    }
    print(stepped()) // 21
    return 0
}
