// A hundred thousand values through one slot.

import { Slots, newSlots, insert, remove, capacity } from "std/slots"

fn main() -> Int64 {
    let mut cells: Slots<Int64> = newSlots()
    let mut i = 0
    let mut last = 0
    while i < 100000 {
        let v = i
        let h = insert(cells, v)
        cells[h] = cells[h] + 1
        last = cells[h]
        remove(cells, h) // the slot goes back; the next turn takes it
        i = i + 1
    }

    print(last) // 100000
    print(capacity(cells)) // 1 — a hundred thousand values, one slot
    return 0
}
