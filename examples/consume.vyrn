// Parameter capabilities: read, modify and consume.

type Token = { id: Int64 }

fn redeem(t: consume Token) -> Int64 { return t.id } // takes ownership
fn peek(t: read Token) -> Int64 { return t.id } // just observes (the default)

fn main() -> Int64 {
    let a = Token { id: 10 }
    let x = peek(a) + peek(a) // 20

    let b = Token { id: 5 }
    let y = redeem(b) // `b` is consumed here...
    return x + y // 25
}
