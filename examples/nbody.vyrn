// nbody, from the Computer Language Benchmarks Game (RFC-0104 M1).
//
// Five bodies, every pair, one symplectic step at a time. It measures ordinary
// `Float64` arithmetic and a record field written through an array index in the
// innermost loop of the whole benchmark set.
//
//   $ vyrn run examples/nbody.vyrn
//   $ vyrn bench examples/nbody.vyrn
//
// `main` runs the census N and prints `rfcs/bench-0104/nbody-1000.expected`.
//
// Two things this program carries because `std` does not have them — both are
// findings of RFC-0104's census, not workarounds:
//
//   * there is no scalar square root. `F64x2.sqrt(v).lane(0)` is one lane of
//     the SIMD one (RFC-0083), and a hand-written Newton iteration is not a
//     substitute — 40 rounds land one ULP low, which is a printed digit here.
//   * `print` on a `Float64` is fixed at six decimals and the game prints nine,
//     so the nine come from scaling into an `Int64`.

/// The census N — 1000 steps, the size the committed fixture was written at.
let steps = 1000

/// The bench N. Large enough that a sample is the integration and not the
/// setup, small enough to stay a corpus program rather than a benchmark suite.
let benchSteps = 50000

type Body = {
    x: Float64,
    y: Float64,
    z: Float64,
    vx: Float64,
    vy: Float64,
    vz: Float64,
    mass: Float64,
}

/// The square root of one `Float64`, which `std/math` does not export.
fn sqrtF(v: Float64) -> Float64 {
    return F64x2.sqrt(F64x2(v, v)).lane(0)
}

/// `v` at nine decimal places, the format the game prints. `print` gives six, so
/// the digits are scaled into an `Int64` and the fraction is padded.
fn fixed9(v: Float64) -> String {
    let mut a = v
    let mut sign = ""
    if a < 0.0 {
        sign = "-"
        a = 0.0 - a
    }
    let scaled = Int64(a * 1000000000.0 + 0.5)
    let whole = scaled / 1000000000
    let mut frac = "\{scaled % 1000000000}"
    while frac.byteLength < 9 {
        frac = "0\{frac}"
    }
    return "\{sign}\{whole}.\{frac}"
}

fn solarMass() -> Float64 {
    return 4.0 * 3.141592653589793 * 3.141592653589793
}

fn daysPerYear() -> Float64 {
    return 365.24
}

/// The sun and the four gas giants, at the positions and velocities the game
/// publishes.
fn system() -> Array<Body> {
    let sm = solarMass()
    let dy = daysPerYear()
    let mut b: Array<Body> = []
    b.push(Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: sm })
    b.push(Body {
            x: 4.84143144246472090,
            y: -1.16032004402742839,
            z: -0.103622044471123109,
            vx: 0.00166007664274403694 * dy,
            vy: 0.00769901118419740425 * dy,
            vz: -0.0000690460016972063023 * dy,
            mass: 0.000954791938424326609 * sm,
        })
    b.push(Body {
            x: 8.34336671824457987,
            y: 4.12479856412430479,
            z: -0.403523417114321381,
            vx: -0.00276742510726862411 * dy,
            vy: 0.00499852801234917238 * dy,
            vz: 0.0000230417297573763929 * dy,
            mass: 0.000285885980666130812 * sm,
        })
    b.push(Body {
            x: 12.8943695621391310,
            y: -15.1111514016986312,
            z: -0.223307578892655734,
            vx: 0.00296460137564761618 * dy,
            vy: 0.00237847173959480950 * dy,
            vz: -0.0000296589568540237556 * dy,
            mass: 0.0000436624404335156298 * sm,
        })
    b.push(Body {
            x: 15.3796971148509165,
            y: -25.9193146099879641,
            z: 0.179258772950371181,
            vx: 0.00268067772490389322 * dy,
            vy: 0.00162824170038242295 * dy,
            vz: -0.0000951592254519715870 * dy,
            mass: 0.0000515138902046611451 * sm,
        })
    return b
}

/// The sun's velocity, set so the whole system's momentum is zero.
///
/// It is `consume` in and owned out because a helper that mutates an array the
/// caller keeps using cannot borrow it: a `read` parameter may not be returned,
/// and a return is owned. A move each way, and no copy — see `advance` too.
fn offsetMomentum(bodies: consume Array<Body>) -> Array<Body> {
    let mut b = bodies
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    for body in b {
        px = px + body.vx * body.mass
        py = py + body.vy * body.mass
        pz = pz + body.vz * body.mass
    }
    b[0].vx = 0.0 - px / solarMass()
    b[0].vy = 0.0 - py / solarMass()
    b[0].vz = 0.0 - pz / solarMass()
    return b
}

/// Kinetic energy plus the pairwise potential — the number the game prints
/// before and after the integration.
fn energy(b: Array<Body>) -> Float64 {
    let mut e = 0.0
    let mut i = 0
    while i < b.length {
        e = e + 0.5 * b[i].mass * (b[i].vx * b[i].vx + b[i].vy * b[i].vy + b[i].vz * b[i].vz)
        let mut j = i + 1
        while j < b.length {
            let dx = b[i].x - b[j].x
            let dy = b[i].y - b[j].y
            let dz = b[i].z - b[j].z
            e = e - b[i].mass * b[j].mass / sqrtF(dx * dx + dy * dy + dz * dz)
            j = j + 1
        }
        i = i + 1
    }
    return e
}

/// One time step: every pair exchanges momentum, then every body moves. The
/// `consume`-and-return shape is `offsetMomentum`'s, for the same reason.
fn advance(bodies: consume Array<Body>, dt: Float64) -> Array<Body> {
    let mut b = bodies
    let mut i = 0
    while i < b.length {
        let mut j = i + 1
        while j < b.length {
            let dx = b[i].x - b[j].x
            let dy = b[i].y - b[j].y
            let dz = b[i].z - b[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrtF(d2))
            let mi = b[i].mass
            let mj = b[j].mass
            b[i].vx = b[i].vx - dx * mj * mag
            b[i].vy = b[i].vy - dy * mj * mag
            b[i].vz = b[i].vz - dz * mj * mag
            b[j].vx = b[j].vx + dx * mi * mag
            b[j].vy = b[j].vy + dy * mi * mag
            b[j].vz = b[j].vz + dz * mi * mag
            j = j + 1
        }
        i = i + 1
    }
    let mut k = 0
    while k < b.length {
        b[k].x = b[k].x + dt * b[k].vx
        b[k].y = b[k].y + dt * b[k].vy
        b[k].z = b[k].z + dt * b[k].vz
        k = k + 1
    }
    return b
}

/// `n` steps from the published initial conditions, and the energy afterwards.
/// The whole program apart from the two prints, so the bench block and `main`
/// run the same code.
fn integrate(n: Int64) -> Float64 {
    let mut b = offsetMomentum(system())
    let mut i = 0
    while i < n {
        b = advance(b, 0.01)
        i = i + 1
    }
    return energy(b)
}

bench "nbody, 50000 steps" {
    blackBox(fixed9(integrate(blackBox(benchSteps))).byteLength)
}

fn main() -> Int64 {
    print(fixed9(energy(offsetMomentum(system()))))
    print(fixed9(integrate(steps)))
    return 0
}
