// A slab reuses what it reclaims.

import { Slots, Handle, newSlots, insert, remove, capacity } from "std/slots"

type Node = { value: Int64, next: Option<Handle<Node>> }

fn sum(s: Slots<Node>, o: Option<Handle<Node>>) -> Int64 {
    return match o { Some(h) => s[h].value + sum(s, s[h].next), None => 0 }
}
fn freeList(s: modify Slots<Node>, o: Option<Handle<Node>>) -> Int64 {
    return match o { Some(h) => freeNode(s, h), None => 0 }
}
fn freeNode(s: modify Slots<Node>, h: Handle<Node>) -> Int64 {
    let tail = s[h].next.copy()
    remove(s, h)
    return freeList(s, tail)
}

fn main() -> Int64 {
    let mut nodes: Slots<Node> = newSlots()
    let mut i = 0
    let mut last = 0
    while i < 20000 {
        let mut head: Option<Handle<Node>> = None
        let mut j = 5
        while j > 0 {
            head = Some(insert(nodes, Node { value: j, next: head }))
            j = j - 1
        }
        last = sum(nodes, head)
        freeList(nodes, head) // every slot goes back; the next turn takes them
        i = i + 1
    }
    print(last) // 15
    print(capacity(nodes)) // 5 — 100,000 inserts, five slots
    return last
}
