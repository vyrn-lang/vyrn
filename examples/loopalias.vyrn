// Refused on purpose: an arm inside a loop hands out a name bound outside it.
fn main() -> Int64 {
    let names: Array<String> = ["a", "b"]
    let mut n = 0
    let mut i = 0
    while i < 3 {
        let picked = if i > 0 { names } else { ["z"] }
        n = n + picked.length
        i = i + 1
    }
    print("\{n}")
    return 0
}
