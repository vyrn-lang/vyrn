// Refused on purpose: an impl method whose signature differs from the protocol's.

type Sq = { side: Int64 }

protocol Shape {
    fn area(self) -> Int64
    fn scale(self, by: Int64) -> Sq
}

impl Shape for Sq {
    fn area(self) -> Bool { return true }

    fn scale(self, by: String) -> Sq { return Sq { side: 1 } }
}

fn total<T: Shape>(x: T) -> Int64 {
    return x.area() + 41
}

fn main() -> Int64 {
    let s = Sq { side: 3 }
    print(total(s).toString())
    return 0
}
