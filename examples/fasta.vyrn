// fasta, from the Computer Language Benchmarks Game.

let order = 1000

let benchOrder = 250000

let alu = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

let mut seed = 42

fn nextRandom(max: Float64) -> Float64 {
    seed = (seed * 3877 + 29573) % 139968
    return max * Float64(seed) / 139968.0
}

fn cumulative(ws: Array<Float64>) -> Array<Float64> {
    let mut out: Array<Float64> = []
    let mut p = 0.0
    for w in ws {
        p = p + w
        out.push(p)
    }
    return out
}

fn pick(syms: Array<UInt8>, cum: Array<Float64> where value.length <= syms.length) -> UInt8 {
    let r = nextRandom(1.0)
    let mut i = 0
    while i < cum.length {
        if cum[i] > r {
            return syms[i]
        }
        i = i + 1
    }
    return syms[syms.length - 1]
}

fn line(w: Array<UInt8>) -> String {
    return match stringFromBytes(w) {
        Ok(s) => s,
        Err(_) => "",
    }
}

fn lineWidth(todo: Int64) -> Int64 {
    if todo < 60 {
        return todo
    }
    return 60
}

fn repeatFasta(header: String, b: Array<UInt8> where value.length >= 1, count: Int64) {
    print(header)
    let mut k = 0
    let mut todo = count
    let mut w: Array<UInt8> = []
    while todo > 0 {
        let m = lineWidth(todo)
        w.clear()
        let mut i = 0
        while i < m {
            w.push(b[k])
            k = (k + 1) % b.length
            i = i + 1
        }
        print(line(w))
        todo = todo - m
    }
}

fn randomFasta(header: String, syms: Array<UInt8>, cum: Array<Float64> where value.length <= syms.length, count: Int64) {
    print(header)
    let mut todo = count
    let mut w: Array<UInt8> = []
    while todo > 0 {
        let m = lineWidth(todo)
        w.clear()
        let mut i = 0
        while i < m {
            w.push(pick(syms, cum))
            i = i + 1
        }
        print(line(w))
        todo = todo - m
    }
}

fn iubWeights() -> Array<Float64> {
    return [
        0.27, 0.12, 0.12, 0.27, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02,
    ]
}

fn humanWeights() -> Array<Float64> {
    return [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008]
}

fn run(n: Int64) {
    repeatFasta(">ONE Homo sapiens alu", bytes(alu), n * 2)
    randomFasta(">TWO IUB ambiguity codes", bytes("acgtBDHKMNRSVWY"), cumulative(iubWeights()), n * 3)
    randomFasta(">THREE Homo sapiens frequency", bytes("acgt"), cumulative(humanWeights()), n * 5)
}

fn generate(syms: Array<UInt8>, cum: Array<Float64> where value.length <= syms.length, count: Int64) -> Int64 {
    let mut written = 0
    let mut todo = count
    let mut w: Array<UInt8> = []
    while todo > 0 {
        let m = lineWidth(todo)
        w.clear()
        let mut i = 0
        while i < m {
            w.push(pick(syms, cum))
            i = i + 1
        }
        written = written + Int64(line(w).byteLength)
        todo = todo - m
    }
    return written
}

bench "fasta, 250000 random bases" {
    seed = 42
    blackBox(generate(bytes("acgt"), cumulative(humanWeights()), blackBox(benchOrder)))
}

fn main() -> Int64 {
    run(order)
    return 0
}
