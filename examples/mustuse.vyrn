// A user-declared linear obligation.

protocol MustUse {}

protocol Owned {
    fn release(consume self)
}

type Txn = {
    label: String,
    ops: Array<String>
}

impl MustUse for Txn {}

impl Owned for Txn {
    fn release(consume self) {
        print("end " + self.label + " (" + self.ops.length.toString() + ")")
        let ops = consume self.ops
        drop ops
        let label = consume self.label
        drop label
    }
}

fn begin(label: String) -> Txn {
    let mut ops: Array<String> = []
    ops.push(label.copy())
    return Txn { label: label.copy(), ops: ops }
}

fn finish(t: consume Txn) {
    drop t
}

fn carry(t: consume Txn) -> Txn {
    return t
}

fn pool() {
    let mut pool: Array<Txn> = []
    pool.push(begin("orders"))
    pool.push(begin("invoices"))
    drop pool
}

fn main() -> Int64 {
    pool()

    let a = begin("orders")
    drop a

    let b = begin("ledger")
    finish(b)

    let c = begin("audit")
    let d = carry(c)
    finish(d)

    let mut i = 0
    while i < 2 {
        let r = begin("retry" + i.toString())
        finish(r)
        i = i + 1
    }

    print("done")
    return 0
}
