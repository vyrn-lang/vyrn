// Typed RPC, in process.
import { clientInProcess } from "std/rpc"
import { usersById, usersCreate, usersDel, RpcReply } from clientInProcess("./fullstack/server/api")
import { GetUserReq, CreateUserReq, User, DeleteReq, DeleteResult } from "./fullstack/shared/wire"

let mut line: String = "(none)"

fn onGetUser(res: RpcReply<User>) {
    line = match res {
        Done(u) => "usersById -> \{u.name} (age \{u.age})",
        Rejected(issues) => "usersById failed",
        Failed(why) => "usersById failed",
    }
}

fn onCreateUser(res: RpcReply<User>) {
    line = match res {
        Done(u) => "usersCreate -> id \{u.id} \{u.name}",
        Rejected(issues) => "usersCreate failed",
        Failed(why) => "usersCreate failed",
    }
}

fn onDeleteUser(res: RpcReply<DeleteResult>) {
    line = match res {
        Done(r) => match r {
            Ok(done) => "usersDel -> ok",
            Err(why) => "usersDel -> refused: \{why}",
        },
        Rejected(issues) => "usersDel failed",
        Failed(why) => "usersDel failed",
    }
}

fn main() -> Int64 {
    usersById(GetUserReq { id: 7 }, onGetUser)
    print(line)
    usersCreate(CreateUserReq { name: "Ada", age: 36 }, onCreateUser)
    print(line)
    usersDel(DeleteReq { id: 5 }, onDeleteUser)
    print(line)
    usersDel(DeleteReq { id: 0 }, onDeleteUser)
    print(line)
    return 0
}

test "in-process usersById runs the real procedure" {
    usersById(GetUserReq { id: 42 }, onGetUser)
    assertEq(line, "usersById -> user42 (age 30)")
}

test "in-process usersCreate echoes its validated fields" {
    usersCreate(CreateUserReq { name: "Grace", age: 45 }, onCreateUser)
    assertEq(line, "usersCreate -> id 1000 Grace")
}

test "in-process usersDel carries a Result outcome" {
    usersDel(DeleteReq { id: 5 }, onDeleteUser)
    assertEq(line, "usersDel -> ok")
    usersDel(DeleteReq { id: 0 }, onDeleteUser)
    assertEq(line, "usersDel -> refused: cannot delete the root user")
}
