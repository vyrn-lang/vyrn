// Two record types with the same fields in different orders are interchangeable.

import { Hashable } from "std/hash"

type A = { x: Int64, y: Int64 }
type B = { y: Int64, x: Int64 }
type E = enum { Nothing, Has(B) }
type Pair = enum { Two(B, Int64), Empty }
type HA = { p: A }
type HB = { p: B }
type P = { b: Bool, n: Int64, s: String, k: Int8 }
type Q = { k: Int8, s: String, n: Int64, b: Bool }
type Box1<T> = { v: T, n: Int8 }
type Box2<T> = { n: Int8, v: T }

impl Hashable for A {
    fn hash(self) -> UInt64 {
        return UInt64(self.x) * 31 + UInt64(self.y)
    }
}

impl Hashable for B {
    fn hash(self) -> UInt64 {
        return UInt64(self.y)
    }
}

fn show(what: String, b: B) {
    print("\{what}: \{b.x} \{b.y}")
}

fn asB(a: A) -> B {
    return a
}

fn some(a: A) -> Option<B> {
    return Some(a)
}

fn has(a: A) -> E {
    return Has(a)
}

fn two(a: A) -> Pair {
    return Two(a, 7)
}

fn ok(a: A) -> Result<B, String> {
    return Ok(a)
}

fn nested(h: HA) -> HB {
    return h
}

fn options(o: consume Option<A>) -> Option<B> {
    return o
}

fn arrays(xs: consume Array<A>) -> Array<B> {
    return xs
}

fn first(bs: Array<B>) -> B {
    return bs[0]
}

fn lookup(m: Map<String, B>) -> B {
    if let Some(b) = m["k"] {
        return b
    }
    return B { y: 0, x: 0 }
}

fn firstKey(m: Map<B, Int64>) -> B {
    for k in m.keys() {
        return k
    }
    return B { y: 0, x: 0 }
}

fn make() -> A {
    return A { x: 1, y: 2 }
}

fn callMake(f: fn() -> B) -> B {
    return f()
}

fn callShow(f: fn(A) -> Int64) -> Int64 {
    return f(A { x: 1, y: 2 })
}

fn showInt(b: B) -> Int64 {
    show("fn argument", b)
    return 0
}

fn mixed(p: consume P) -> Q {
    return p
}

fn boxed(b: Box1<A>) -> Box2<B> {
    return b
}

fn main() -> Int64 {
    let a = A { x: 1, y: 2 }
    show("argument", a)
    show("return", asB(a))
    if let Some(b) = some(a) {
        show("Some", b)
    }
    match has(a) {
        Has(b) => show("variant", b),
        Nothing => print("none"),
    }
    match two(a) {
        Two(b, k) => print("payloads: \{b.x} \{b.y} \{k}"),
        Empty => print("none"),
    }
    if let Ok(b) = ok(a) {
        show("Ok", b)
    }
    let h = HB { p: a }
    show("record literal field", h.p)
    show("nested record", nested(HA { p: a }).p)
    let lit: Array<B> = [a]
    show("array literal", lit[0])
    let mut pushed: Array<B> = []
    pushed.push(a)
    show("push", pushed[0])
    if let Some(b) = options(Some(a)) {
        show("whole Option", b)
    }
    let whole = arrays([a])
    show("whole Array", whole[0])
    let held: Array<A> = [a]
    show("Array argument", first(held))
    let lits: Map<String, B> = ["k": a]
    show("Map literal value", lookup(lits))
    let mut m: Map<String, A> = [:]
    m["k"] = a
    show("whole Map", lookup(m))
    let mut ks: Map<A, Int64> = [:]
    ks[a] = 5
    show("Map key", firstKey(ks))
    show("fn result", callMake(make))
    print("\{callShow(showInt)}")
    let q = mixed(P { b: true, n: 7, s: "s", k: 3 })
    print("mixed widths: \{q.b} \{q.n} \{q.s} \{q.k}")
    let r = boxed(Box1 { v: a, n: 3 })
    print("generic record: \{r.v.x} \{r.v.y} \{r.n}")
    return 0
}
