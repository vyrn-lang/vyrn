// A `consume` parameter taken apart on one path out of a `for` loop: the exit
// edge and each `break` that did not take `g.x` release it, as an `if` arm would.

type Parts = { x: String, z: String }

fn eat(v: consume String) -> Int64 {
    return v.byteLength
}

fn use(g: consume Parts, ks: Array<Int64>) -> Int64 {
    let mut out = 0
    for k in ks {
        if g.z.byteLength == k {
            break
        }
        out = eat(consume g.x)
        break
    }
    return out + g.z.byteLength
}

fn main() -> Int64 {
    let a = use(Parts { x: "ab".copy(), z: "zz".copy() }, [0])
    let b = use(Parts { x: "ab".copy(), z: "zz".copy() }, [2])
    let c = use(Parts { x: "ab".copy(), z: "zz".copy() }, [])
    print("\{a} \{b} \{c}")
    return 0
}
