// `x.copy()`: a value that shares no heap with the receiver.

import { Slots, newSlots, insert } from "std/slots"
import { Json, JsonField, emit } from "std/json"

type Inner = { tag: String }

type Outer = { label: String, inner: Inner, n: Int64 }

type Note = enum { Blank, Text(String), Counted(String, Int64) }

fn built(s: String) -> String {
    return s + "!"
}

fn render(v: Note) -> String {
    return match v {
        Blank => "blank",
        Text(s) => s.copy(),
        Counted(s, k) => s + "/" + k.toString(),
    }
}

fn strings() {
    let mut a = built("first")
    let b = a.copy()
    a = a + " changed"
    print(a)
    print(b)
    let wide = built("héllo wörld")
    let copy = wide.copy()
    print(copy)
    print(copy.byteLength)
    print(copy.charCount())
    let empty = ("" + "").copy()
    print(empty.byteLength)
    let fromStatic = "static".copy()
    print(fromStatic)
    print(fromStatic.byteLength)
}

fn arrays() {
    let mut xs: Array<String> = []
    xs.push(built("one"))
    xs.push(built("two"))
    let ys = xs.copy()
    xs[0] = built("ONE")
    print(xs[0])
    print(ys[0])
    let mut grid: Array<Array<String>> = []
    grid.push(ys.copy())
    let other = grid.copy()
    grid[0][1] = built("TWO")
    print(grid[0][1])
    print(other[0][1])
    let none: Array<String> = []
    print(none.copy().length)
}

fn smallArrays() {
    let mut inline: SmallArray<String, 4> = []
    inline.push(built("a"))
    let inlineCopy = inline.copy()
    inline[0] = built("A")
    print(inline[0])
    print(inlineCopy[0])
    let mut spilled: SmallArray<String, 1> = []
    spilled.push(built("x"))
    spilled.push(built("y"))
    let spilledCopy = spilled.copy()
    spilled[1] = built("Y")
    print(spilled[1])
    print(spilledCopy[1])
}

fn maps() {
    let mut m: Map<String, String> = [:]
    m[built("k")] = built("v")
    let n = m.copy()
    m["k!"] = built("w")
    if let Some(x) = m["k!"] {
        print(x)
    }
    if let Some(x) = n["k!"] {
        print(x)
    }
    let empty: Map<String, String> = [:]
    print(empty.copy().length)
}

fn records() {
    let mut o = Outer { label: built("L"), inner: Inner { tag: built("T") }, n: 3 }
    let p = o.copy()
    o.label = built("L2")
    o.inner = Inner { tag: built("T2") }
    print(o.label)
    print(p.label)
    print(o.inner.tag)
    print(p.inner.tag)
}

fn sums() {
    let one = Text(built("held"))
    print(render(one.copy()))
    let two = Counted(built("pair"), 7)
    print(render(two.copy()))
    print(render(Blank.copy()))
    let some: Option<String> = Some(built("inside"))
    let alsoSome = some.copy()
    if let Some(s) = alsoSome {
        print(s)
    }
    let none: Option<String> = None
    let alsoNone = none.copy()
    if let Some(s) = alsoNone {
        print(s)
    }
    let ok: Result<String, String> = Ok(built("fine"))
    print(match ok.copy() {
        Ok(s) => s,
        Err(s) => s,
    })
}

fn handles() {
    let mut numbers: Slots<Int64> = newSlots()
    let h = insert(numbers, 41)
    let g = h.copy()
    numbers[g] = 42
    print(numbers[h])
}

fn declaredCopies() {
    let mut fs: Array<JsonField> = []
    fs.push(JsonField { key: built("k"), value: JStr(built("v")) })
    let doc: Json = JObj(fs)
    let clone = doc.copy()
    print(emit(doc))
    print(emit(clone))
}

fn twice<T>(x: T) -> Array<T> {
    let mut out: Array<T> = []
    out.push(x.copy())
    out.push(x.copy())
    return out
}

fn main() -> Int64 {
    strings()
    arrays()
    smallArrays()
    maps()
    records()
    sums()
    handles()
    declaredCopies()
    let numbers = twice(9)
    print(numbers[0] + numbers[1])
    let words = twice(built("word"))
    print(words[0] + "|" + words[1])
    return 0
}
