/// The shelf's on-disk tag snapshot: one comma-separated line the server keeps
/// beside the store, so a cold start can show the tag filter before the first
/// `books/browse` completes.
///
/// It sits under `shared/` because both sides want the tag line, and the
/// manifest calls `shared` universal. Nothing on this path is a lie — and the
/// file is still unreadable in a browser, which no label can change.

/// The snapshot line, or "" when there is no snapshot yet.
export fn snapshotTags(path: String) -> String {
    return match readFile(path) {
        Ok(text) => text,
        Err(why) => "",
    }
}
