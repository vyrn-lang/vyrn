/// The shelf server root: the RPC and Connect handlers, the OpenAPI and GraphQL
/// documents, the page router, and the theme stylesheet, all built from the api
/// directory. It is the one module that legitimately names both sides, which is
/// why the manifest key that NAMES it is what gives it its audience (RFC-0072 M1).
///
/// The pages live under `server/` because every one of them is server-rendered:
/// shelf's browser bundle is an island (the widgets), not a page bundle, so a
/// `.vyrn` page here never reaches a browser and may read the store through the
/// api module beside it.
import { rpc } from "std/rpc"
import { rpcHandle } from rpc("./server/api")
import { connectServer } from "std/connect"
import { connectHandle } from connectServer("./server/api/books")
import { openapi } from "std/openapi"
import { openapiJson } from openapi("./server/api/books")
import { sdl, graphqlServer } from "std/graphql"
import { sdlText } from sdl("./server/api/books")
import { graphqlHandle } from graphqlServer("./server/api/books")
import { pages } from "std/ui"
import { route } from pages("./server/routes")
import { tw } from "std/tw"
import * as theme from tw("./theme.json")

/// A middleware may answer a request outright (`Some`) or pass it along (`None`);
/// the chain runs in registration order in front of routing.
type Middleware = fn(Request) -> Option<Response>

/// The chain, installed at module-state init: request logging (never answers),
/// then a guard that answers the /admin prefix outright before any route runs.
let mut middleware: Array<Middleware> = [
    req -> {
        logger("http").info("\{req.method} \{req.path}")
        return None
    },
    req -> if req.path =~ "/admin.*" {
        Some(Response { status: 403, contentType: "text/plain", body: "forbidden", vary: "", headers: [:] })
    } else {
        None
    },
]

/// Run the chain: the first `Some` wins; middleware after a hit never runs.
fn runMiddleware(req: Request) -> Option<Response> {
    let mut hit: Option<Response> = None
    for m in middleware {
        hit = match hit { Some(r) => Some(r), None => m(req) }
    }
    return hit
}

fn handle(req: Request) -> Response {
    return match runMiddleware(req) {
        Some(r) => r,
        None => routed(req),
    }
}

fn routed(req: Request) -> Response {
    // Baked constants served with their conventional content types.
    if req.method == "GET" && req.path == "/theme.css" {
        return Response { status: 200, contentType: "text/css", body: theme.css(), vary: "", headers: [:] }
    }
    if req.method == "GET" && req.path == "/openapi.json" {
        return Response { status: 200, contentType: "application/json", body: openapiJson(), vary: "", headers: [:] }
    }
    if req.method == "GET" && req.path == "/schema.graphql" {
        return Response { status: 200, contentType: "application/graphql", body: sdlText(), vary: "", headers: [:] }
    }
    // rpcHandle (the derived /_/* surface), connectHandle (the Connect
    // /<service>.<Proc> surface) and graphqlHandle (POST /graphql) mount side by
    // side — one api directory, three protocols; anything else routes. The
    // schema served above is no longer a description of an API that does not
    // exist at any endpoint (RFC-0085 M1).
    return match rpcHandle(req) {
        Some(r) => r,
        None => match connectHandle(req) {
            Some(r) => r,
            None => match graphqlHandle(req) {
                Some(r) => r,
                None => route(req),
            },
        },
    }
}

fn main() -> Int64 {
    // A smoke over handle. Mutating calls persist for the process, so run order
    // matters.
    let list = handle(Request { method: "POST", path: "/_/books/browse", headers: [:], body: "" })
    print("books/browse -> \{list.status}")
    let tags = handle(Request { method: "POST", path: "/_/books/tags", headers: [:], body: "" })
    print("books/tags -> \{tags.status}: \{tags.body}")
    let bad = handle(Request { method: "POST", path: "/_/books/add", headers: [:], body: "{\"title\":\"\",\"url\":\"not-a-url\",\"tags\":[]}" })
    print("books/add(bad) -> \{bad.status}: \{bad.body}")
    let home = handle(Request { method: "GET", path: "/", headers: [:], body: "" })
    print("/ -> \{home.status}")
    // The guard answers /admin before any route runs.
    let blocked = handle(Request { method: "GET", path: "/admin/secrets", headers: [:], body: "" })
    print("/admin/secrets -> \{blocked.status}: \{blocked.body}")
    let conn = handle(Request { method: "POST", path: "/books.browse", headers: [:], body: "{}" })
    print("connect books/browse -> \{conn.status}")
    let badConn = handle(Request { method: "POST", path: "/books.add", headers: [:], body: "{\"title\":\"\",\"url\":\"nope\",\"tags\":[]}" })
    print("connect books/add(bad) -> \{badConn.status}: \{badConn.body}")
    let oa = handle(Request { method: "GET", path: "/openapi.json", headers: [:], body: "" })
    print("/openapi.json -> \{oa.status} (\{oa.body.byteLength} bytes)")
    let gql = handle(Request { method: "GET", path: "/schema.graphql", headers: [:], body: "" })
    print("/schema.graphql -> \{gql.status} (\{gql.body.byteLength} bytes)")
    // And the schema is answerable: titles, and nothing else on the wire.
    let q = handle(Request { method: "POST", path: "/graphql", headers: [:], body: "{ browse { books { title } } }" })
    print("POST /graphql -> \{q.status}: \{q.body}")
    return 0
}
