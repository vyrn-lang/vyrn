// Refused on purpose: a borrowed value passed to a `consume` parameter.

fn take(xs: consume Array<Int64>) -> Int64 {
    let n = xs.length
    drop xs
    return n
}

fn caller(ys: Array<Int64>) -> Int64 {
    return take(ys)
}

fn main() -> Int64 {
    let a: Array<Int64> = [1, 2, 3]
    let n = caller(a)
    print(n + a.length)
    return 0
}
