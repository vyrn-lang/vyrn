// The exact bytes every number conversion produces.

fn opaque(x: Float64) -> Float64 {
    return x
}

fn pow10(n: Int64) -> Float64 {
    let mut x: Float64 = 1.0
    let mut i: Int64 = 0
    while i < n {
        x = x * 10.0
        i = i + 1
    }
    return x
}

fn halved(n: Int64) -> Float64 {
    let mut x: Float64 = 1.0
    let mut i: Int64 = 0
    while i < n {
        x = x / 2.0
        i = i + 1
    }
    return x
}

fn p(s: String) -> String {
    return match parse(s) {
        Some(n) => n.toString(),
        None => "None",
    }
}

fn main() -> Int64 {
    print(p("0"))
    print(p("-0"))
    print(p("42"))
    print(p("-42"))
    print(p("007"))
    print(p("-007"))
    print(p("9223372036854775807"))
    print(p("-9223372036854775808"))
    print(p("9223372036854775808"))
    print(p("18446744073709551615"))
    print(p("99999999999999999999999999"))
    print(p(""))
    print(p("-"))
    print(p("+1"))
    print(p(" 1"))
    print(p("1 "))
    print(p("1.5"))
    print(p("1e3"))
    print(p("abc"))
    print(p("12a"))
    print(p("--1"))

    let i8lo: Int8 = Int8(0 - 128)
    let i8hi: Int8 = 127
    let u8hi: UInt8 = 255
    let i16lo: Int16 = Int16(0 - 32768)
    let u32hi: UInt32 = 4294967295
    let i64lo: Int64 = 0 - 9223372036854775807 - 1
    let u64hi: UInt64 = 18446744073709551615
    print(i8lo.toString())
    print(i8hi.toString())
    print(u8hi.toString())
    print(i16lo.toString())
    print(u32hi.toString())
    print(i64lo.toString())
    print(u64hi.toString())

    print(0.0078125.toString())
    print(0.0234375.toString())
    print(pow10(300).toString())
    print((0.0 - pow10(300)).toString())
    print(halved(1074).toString())
    print(halved(1075).toString())
    print((opaque(0.0) * (0.0 - 1.0)).toString())
    print((1.0 / opaque(0.0)).toString())
    print((0.0 - 1.0 / opaque(0.0)).toString())
    print((opaque(0.0) / opaque(0.0)).toString())
    print(9.9999995.toString())
    print(123456789.123456789.toString())
    let f: Float32 = 0.1
    print(f.toString())
    print((f * f).toString())

    print(Int64(0.0 - 2.9).toString())
    print(UInt8(300.7).toString())
    print(Int64(pow10(300)).toString())
    print(Int64(0.0 - pow10(300)).toString())
    print(UInt64(0.0 - 1.5).toString())
    print(Int64(opaque(0.0) / opaque(0.0)).toString())
    print(Float32(pow10(300)).toString())

    print(Float64(9223372036854775807).toString())
    print(Float32(16777217).toString())
    return 0
}

test "parse takes a minus and digits, and nothing else" {
    assertEq(p("0"), "0")
    assertEq(p("-0"), "0")
    assertEq(p("42"), "42")
    assertEq(p("-42"), "-42")
    assertEq(p("007"), "7")
    assertEq(p("-007"), "-7")
    assertEq(p(""), "None")
    assertEq(p("-"), "None")
    assertEq(p("+1"), "None")
    assertEq(p(" 1"), "None")
    assertEq(p("1 "), "None")
    assertEq(p("1.5"), "None")
    assertEq(p("1e3"), "None")
    assertEq(p("abc"), "None")
    assertEq(p("12a"), "None")
    assertEq(p("--1"), "None")
}

test "parse wraps on overflow rather than declining" {
    assertEq(p("9223372036854775807"), "9223372036854775807")
    assertEq(p("-9223372036854775808"), "-9223372036854775808")
    assertEq(p("9223372036854775808"), "-9223372036854775808")
    assertEq(p("18446744073709551615"), "-1")
    assertEq(p("99999999999999999999999999"), "-2537764290115403777")
}

test "six decimals are the exact ones, rounded half to even" {
    assertEq(0.0078125.toString(), "0.007812")
    assertEq(0.0234375.toString(), "0.023438")
    assertEq(9.9999995.toString(), "9.999999")
    assertEq(123456789.123456789.toString(), "123456789.123457")
}

test "the extremes keep every digit" {
    assertEq(
        pow10(300).toString(),
        "1000000000000000201206451102982726528510718396098215168041874281451248363566"
        + "0941273804370911208852185605358934485189371568149022546577356211033167392772"
        + "7776193144531116603838203491427854077548432800993666474448696900069727411136"
        + "1486849523430568151310289152823685865144042626214886587669241994282008576"
        + ".000000",
    )
    assertEq(halved(1074).toString(), "0.000000")
    assertEq(halved(1075).toString(), "0.000000")
}

test "the non-finite values and negative zero are spelled" {
    assertEq((opaque(0.0) * (0.0 - 1.0)).toString(), "-0.000000")
    assertEq((1.0 / opaque(0.0)).toString(), "inf")
    assertEq((0.0 - 1.0 / opaque(0.0)).toString(), "-inf")
    assertEq((opaque(0.0) / opaque(0.0)).toString(), "NaN")
}

test "float to integer saturates" {
    assertEq(Int64(0.0 - 2.9).toString(), "-2")
    assertEq(UInt8(300.7).toString(), "44")
    assertEq(Int64(pow10(300)).toString(), "9223372036854775807")
    assertEq(Int64(0.0 - pow10(300)).toString(), "-9223372036854775808")
    assertEq(UInt64(0.0 - 1.5).toString(), "0")
    assertEq(Int64(opaque(0.0) / opaque(0.0)).toString(), "0")
    assertEq(Float32(pow10(300)).toString(), "inf")
}

test "every integer width prints its bounds" {
    let i8lo: Int8 = Int8(0 - 128)
    let u8hi: UInt8 = 255
    let i16lo: Int16 = Int16(0 - 32768)
    let u32hi: UInt32 = 4294967295
    let i64lo: Int64 = 0 - 9223372036854775807 - 1
    let u64hi: UInt64 = 18446744073709551615
    assertEq(i8lo.toString(), "-128")
    assertEq(u8hi.toString(), "255")
    assertEq(i16lo.toString(), "-32768")
    assertEq(u32hi.toString(), "4294967295")
    assertEq(i64lo.toString(), "-9223372036854775808")
    assertEq(u64hi.toString(), "18446744073709551615")
}

test "a byte literal does not fix the width of the operation it is in" {
    let s = "A"
    let mut d = 0
    let mut ge = 0
    for c in s {
        d = c - 'a'
        if c >= 'a' {
            ge = 1
        }
    }
    assertEq(d, 0 - 32)
    assertEq(ge, 0)
}
