// SHA-1 against the RFC 3174 vectors.
import { sha1Hex } from "std/hash"

fn check(name: String, msg: String, want: String) {
    let got = sha1Hex(msg)
    print("\{name}: \{got}")
    if got != want {
        panic("sha1(\{name}) = \{got}, expected \{want}")
    }
}

fn repeat(unit: String, times: Int64) -> String {
    let mut out = ""
    let mut i = 0
    while i < times {
        out = out + unit
        i = i + 1
    }
    return out
}

fn main() -> Int64 {
    check("TEST1", "abc", "a9993e364706816aba3e25717850c26c9cd0d89d")
    check(
        "TEST2",
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
    )
    check(
        "TEST4",
        repeat("0123456701234567012345670123456701234567012345670123456701234567", 10),
        "dea356a2cddd90c7a7ecedc5ebb563934f460452",
    )

    check("EMPTY", "", "da39a3ee5e6b4b0d3255bfef95601890afd80709")

    check(
        "RFC6455",
        "dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11",
        "b37a4f2cc0624f1690f64606cf385945b2bec4ea",
    )
    return 0
}
