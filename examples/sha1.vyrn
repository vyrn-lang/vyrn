/// RFC-0074 M3b — SHA-1 as ordinary Vyrn, pinned against RFC 3174's own
/// vectors.
///
/// The WebSocket handshake needs SHA-1 and nothing else does, which made where
/// to write it the question. In the host it would be a fourth definition of an
/// integer loop (interpreter, textual backend, direct wasm backend), invisible
/// to parity and unreachable from a program. In `std/hash` beside `fnv1a` it is
/// one definition, three-way parity comes free, and this file is the pin: §7.3's
/// four test vectors, digest for digest.
///
/// It is a nonce transform here, not a security primitive — `std/hash`'s doc
/// comment says so at length, because a `sha1` sitting in a standard library
/// invites exactly the misuse that sentence prevents.
import { sha1Hex } from "std/hash"

/// One vector: the message, and the digest RFC 3174 says it has.
fn check(name: String, msg: String, want: String) {
    let got = sha1Hex(msg)
    print("\{name}: \{got}")
    if got != want {
        panic("sha1(\{name}) = \{got}, expected \{want}")
    }
}

/// §7.3's TEST4 is ten repetitions of a 64-byte block — the multi-block vector.
/// The million-`a` TEST3 beside it is NOT here: it is the same code path 15 625
/// blocks further along, and at roughly a minute per engine it would cost the
/// parity suite three minutes to re-prove what TEST4 proves in milliseconds.
fn repeat(unit: String, times: Int64) -> String {
    let mut out = ""
    let mut i = 0
    while i < times {
        out = out + unit
        i = i + 1
    }
    return out
}

fn main() -> Int64 {
    // RFC 3174 §7.3.
    check("TEST1", "abc", "a9993e364706816aba3e25717850c26c9cd0d89d")
    check(
        "TEST2",
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
    )
    check(
        "TEST4",
        repeat("0123456701234567012345670123456701234567012345670123456701234567", 10),
        "dea356a2cddd90c7a7ecedc5ebb563934f460452",
    )

    // The empty message, whose padding is the whole of what it exercises: one
    // `0x80`, 55 zeros, and a length of zero.
    check("EMPTY", "", "da39a3ee5e6b4b0d3255bfef95601890afd80709")

    // And the one this milestone actually needs: RFC 6455 §1.3's worked example.
    // The client sends `dGhlIHNhbXBsZSBub25jZQ==`, the server answers
    // `base64(sha1(key + GUID))` — the digest below is that base64's input.
    check(
        "RFC6455",
        "dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11",
        "b37a4f2cc0624f1690f64606cf385945b2bec4ea",
    )
    return 0
}
