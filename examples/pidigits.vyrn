// pidigits, from the Computer Language Benchmarks Game (RFC-0104 M1).
//
// The digits of pi, ten to a line with a running count. It measures the
// arithmetic a program has to carry itself, because no language has a fast
// enough pi in its standard library.
//
//   $ vyrn run examples/pidigits.vyrn
//   $ vyrn bench examples/pidigits.vyrn
//
// `main` runs the census N and prints `rfcs/bench-0104/pidigits-27.expected`.
//
// This is the bounded spigot of Rabinowitz and Wagon, and the reason it is here
// needs saying plainly. The game specifies pidigits as arbitrary-precision
// arithmetic, and `Int64` is the widest integer Vyrn has — it wraps rather than
// widening, and nothing in `std` exports a big one. A bounded spigot needs none:
// it holds one small integer per digit column, and at `n` digits its widest
// intermediate is about `(10n/3)^2`, which stays inside `Int64` past a billion
// digits. So the OUTPUT is reachable and this program prints it; a
// rules-conforming entry is a different program, and the big integer it would
// need is RFC-0104's named gap for this row.

/// The census N — 27 digits, the size the fixture was written at.
let order = 27

/// The bench N. The spigot is quadratic in it, so 1000 digits is about 1400
/// times the census run.
let benchOrder = 1000

/// Extra digits computed and thrown away. A bounded spigot's last few columns
/// are the ones that can be wrong, so the bound is set past the answer.
let guard = 10

/// The first `n` digits of pi, one per entry.
fn piDigits(n: Int64) -> Array<Int64> {
    let total = n + guard
    let len = 10 * total / 3 + 1
    let mut a: Array<Int64> = []
    let mut i = 0
    while i < len {
        a.push(2)
        i = i + 1
    }
    let mut out: Array<Int64> = []
    let mut nines = 0
    let mut predigit = 0
    let mut j = 0
    while j <= total {
        let mut q = 0
        let mut k = len
        while k > 0 {
            let x = 10 * a[k - 1] + q * k
            a[k - 1] = x % (2 * k - 1)
            q = x / (2 * k - 1)
            k = k - 1
        }
        a[0] = q % 10
        q = q / 10
        // A run of nines is held back: the carry out of the next column can turn
        // all of them into zeroes and bump the digit before them.
        if q == 9 {
            nines = nines + 1
        } else if q == 10 {
            out.push(predigit + 1)
            let mut z = 0
            while z < nines {
                out.push(0)
                z = z + 1
            }
            predigit = 0
            nines = 0
        } else {
            out.push(predigit)
            predigit = q
            let mut z = 0
            while z < nines {
                out.push(9)
                z = z + 1
            }
            nines = 0
        }
        j = j + 1
    }
    // Entry 0 is the zero that precedes the 3; the guard digits fall off the end.
    let mut digits: Array<Int64> = []
    let mut d = 1
    while d <= n {
        digits.push(out[d])
        d = d + 1
    }
    return digits
}

/// The digits, ten to a line, each line tagged with how many have been printed.
/// A short last line is padded to ten so the tags stay in one column.
fn run(n: Int64) {
    let digits = piDigits(n)
    let mut line = ""
    let mut i = 0
    while i < n {
        line = "\{line}\{digits[i]}"
        if (i + 1) % 10 == 0 {
            print("\{line}\t:\{i + 1}")
            line = ""
        }
        i = i + 1
    }
    if line.byteLength > 0 {
        while line.byteLength < 10 {
            line = "\{line} "
        }
        print("\{line}\t:\{n}")
    }
}

bench "pidigits, 1000 digits" {
    blackBox(piDigits(blackBox(benchOrder)).length)
}

fn main() -> Int64 {
    run(order)
    return 0
}
