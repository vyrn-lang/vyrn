// pidigits, from the Computer Language Benchmarks Game.

let order = 27

let benchOrder = 1000

let guard = 10

fn piDigits(n: Int64) -> Array<Int64> {
    let total = n + guard
    let len = 10 * total / 3 + 1
    let mut a: Array<Int64> = []
    let mut i = 0
    while i < len {
        a.push(2)
        i = i + 1
    }
    let mut out: Array<Int64> = []
    let mut nines = 0
    let mut predigit = 0
    let mut j = 0
    while j <= total {
        let mut q = 0
        let mut k = len
        while k > 0 {
            let x = 10 * a[k - 1] + q * k
            a[k - 1] = x % (2 * k - 1)
            q = x / (2 * k - 1)
            k = k - 1
        }
        a[0] = q % 10
        q = q / 10
        if q == 9 {
            nines = nines + 1
        } else if q == 10 {
            out.push(predigit + 1)
            let mut z = 0
            while z < nines {
                out.push(0)
                z = z + 1
            }
            predigit = 0
            nines = 0
        } else {
            out.push(predigit)
            predigit = q
            let mut z = 0
            while z < nines {
                out.push(9)
                z = z + 1
            }
            nines = 0
        }
        j = j + 1
    }
    let mut digits: Array<Int64> = []
    let mut d = 1
    while d <= n {
        digits.push(out[d])
        d = d + 1
    }
    return digits
}

fn run(n: Int64) {
    let digits = piDigits(n)
    let mut line = ""
    let mut i = 0
    while i < n {
        line = "\{line}\{digits[i]}"
        if (i + 1) % 10 == 0 {
            print("\{line}\t:\{i + 1}")
            line = ""
        }
        i = i + 1
    }
    if line.byteLength > 0 {
        while line.byteLength < 10 {
            line = "\{line} "
        }
        print("\{line}\t:\{n}")
    }
}

bench "pidigits, 1000 digits" {
    blackBox(piDigits(blackBox(benchOrder)).length)
}

fn main() -> Int64 {
    run(order)
    return 0
}
