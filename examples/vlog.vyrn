// A structured-log CLI.

import { fromMillis, hour, minute, second, format, Instant } from "std/time"
import { fnv1aStr } from "std/hash"
import {
    joinWith,
    trim,
    toLower,
    toUpper,
    substring,
    indexOf,
    lines,
    padStart,
    toHex,
} from "std/strings"
import { cli, cliOf, flag, opt, positionals, Args } from "std/args"
import { contains } from "std/strpred"

logging { level: warn, sink: stderr }

type Millis = Int64 where value >= 0

type LogLine = { ts: Millis, level: String, msg: String }

type Rec = { raw: String, line: LogLine }

type Level = | Trace | Debug | Info | Warn | Error

type Decoded = { ok: Bool, line: LogLine, err: String }

fn parseLevel(s: String) -> Option<Level> {
    let x = toLower(s)
    if x == "trace" {
        return Some(Trace)
    }
    if x == "debug" {
        return Some(Debug)
    }
    if x == "info" {
        return Some(Info)
    }
    if x == "warn" {
        return Some(Warn)
    }
    if x == "error" {
        return Some(Error)
    }
    return None
}

fn levelName(l: Level) -> String {
    return match l {
        Trace => "trace",
        Debug => "debug",
        Info => "info",
        Warn => "warn",
        Error => "error",
    }
}

fn hms(ts: Int64) -> String {
    let i: Instant = fromMillis(ts)
    let hh = padStart("\{hour(i)}", 2, "0")
    let mm = padStart("\{minute(i)}", 2, "0")
    let ss = padStart("\{second(i)}", 2, "0")
    return "\{hh}:\{mm}:\{ss}"
}

fn humanizeDuration(ms: Int64) -> String {
    if ms == 0 {
        return "0ms"
    }
    let msPart = ms % 1000
    let totalSec = ms / 1000
    let sec = totalSec % 60
    let totalMin = totalSec / 60
    let min = totalMin % 60
    let totalHour = totalMin / 60
    let hr = totalHour % 24
    let day = totalHour / 24
    let mut out = ""
    if day > 0 {
        out = out + "\{day}d "
    }
    if hr > 0 {
        out = out + "\{hr}h "
    }
    if min > 0 {
        out = out + "\{min}m "
    }
    if sec > 0 {
        out = out + "\{sec}s "
    }
    if msPart > 0 {
        out = out + "\{msPart}ms"
    }
    return trim(out)
}

fn decodeLine(raw: String) -> Decoded {
    match fromJson<LogLine>(raw) {
        Valid(l) => {
            return Decoded { ok: true, line: l, err: "" }
        }
        Invalid(issues) => {
            let mut msg = ""
            for i in consume issues {
                if msg == "" {
                    msg = i.message.copy()
                }
            }
            return Decoded { ok: false, line: LogLine { ts: 0, level: "", msg: "" }, err: msg }
        }
    }
    return Decoded { ok: false, line: LogLine { ts: 0, level: "", msg: "" }, err: "" }
}

fn readStdinLines() -> Array<String> {
    let mut lines: Array<String> = []
    let mut going = true
    while going {
        if let Some(s) = readLine() {
            lines.push(s)
        } else {
            going = false
        }
    }
    return lines
}

fn recordsFrom(lines: Array<String>) -> Array<Rec> {
    let log = logger("vlog")
    let mut recs: Array<Rec> = []
    let mut lineNo = 0
    for raw in lines {
        lineNo = lineNo + 1
        let t = trim(raw)
        if t.byteLength > 0 {
            let d = decodeLine(t)
            if d.ok {
                recs.push(Rec { raw: t, line: consume d.line })
            } else {
                log.warn("line \{lineNo}: \{d.err}")
            }
        }
    }
    return recs
}

fn tallyLevels(levels: Array<String>) -> Map<String, Int64> {
    let mut m: Map<String, Int64> = [:]
    for lv in levels {
        m[lv.copy()] = match m[lv] {
            Some(c) => c + 1,
            None => 1,
        }
    }
    return m
}

fn countOf(m: Map<String, Int64>, k: String) -> Int64 {
    return match m[k] {
        Some(v) => v,
        None => 0,
    }
}

fn levelsOf(recs: Array<Rec>) -> Array<String> {
    let mut out: Array<String> = []
    for r in recs {
        out.push(toLower(r.line.level))
    }
    return out
}

fn matchesLevel(r: Rec, wantLower: String) -> Bool {
    return toLower(r.line.level) == wantLower
}

fn cmdCount(recs: Array<Rec>) -> Int64 {
    let m = tallyLevels(levelsOf(recs))
    for k in m.keys() {
        print("\{k}: \{countOf(m, k)}")
    }
    return 0
}

fn cmdFmt(recs: Array<Rec>) -> Int64 {
    for r in recs {
        print("\{hms(r.line.ts)} \{toUpper(r.line.level)} \{r.line.msg}")
    }
    return 0
}

fn cmdTail(recs: Array<Rec>, n: Int64) -> Int64 {
    let start = if recs.length > n {
        recs.length - n
    } else {
        0
    }
    let mut i = start
    while i < recs.length {
        print(recs[i].raw)
        i = i + 1
    }
    return 0
}

fn cmdFilter(recs: Array<Rec>, a: Args) -> Int64 {
    let log = logger("vlog")

    let mut wantLower = ""
    if let Some(lvl) = opt(a, "--level") {
        wantLower = match parseLevel(lvl) {
            Some(l) => levelName(l),
            None => "?",
        }
        if wantLower == "?" {
            log.error("unknown level `\{lvl}` (want trace|debug|info|warn|error)")
            return 2
        }
    }

    let mut hasContains = false
    let mut containsSub = ""
    if let Some(sub) = opt(a, "--contains") {
        hasContains = true
        containsSub = sub
    }

    for r in recs {
        let levelOk = if wantLower == "" {
            true
        } else {
            matchesLevel(r, wantLower)
        }
        let containsOk = if hasContains {
            r.line.msg.contains(containsSub)
        } else {
            true
        }
        if levelOk && containsOk {
            print(r.raw)
        }
    }
    return 0
}

fn cmdStats(recs: Array<Rec>) -> Int64 {
    print("lines: \{recs.length}")
    if recs.length == 0 {
        return 0
    }
    let mut minTs = recs[0].line.ts
    let mut maxTs = recs[0].line.ts
    let mut raws: Array<String> = []
    for r in recs {
        if r.line.ts < minTs {
            minTs = r.line.ts
        }
        if r.line.ts > maxTs {
            maxTs = r.line.ts
        }
        raws.push(r.raw.copy())
    }
    print("first: \{format(fromMillis(minTs))}")
    print("last:  \{format(fromMillis(maxTs))}")
    print("span:  \{humanizeDuration(maxTs - minTs)}")
    let corpus = joinWith(raws, "\n")
    print("fingerprint: \{toHex(fnv1aStr(corpus))}")
    return 0
}

fn cmdOverview(recs: Array<Rec>) -> Int64 {
    print("== fmt ==")
    let f = cmdFmt(recs)
    print("== count ==")
    let c = cmdCount(recs)
    print("== stats ==")
    let s = cmdStats(recs)
    return 0
}

fn usage() -> Int64 {
    let log = logger("vlog")
    log.error("usage: vlog [count|filter|tail|fmt|stats] [--file <path>] < log.ndjson")
    log.error("  filter --level <lvl> [--contains <sub>] | tail -n <N>")
    return 2
}

type Source = { ok: Bool, lines: Array<String> }

fn loadLines(a: Args) -> Source {
    if let Some(path) = opt(a, "--file") {
        return match readFile(path) {
            Ok(content) => Source { ok: true, lines: lines(content) },
            Err(e) => Source { ok: false, lines: [] },
        }
    }
    return Source { ok: true, lines: readStdinLines() }
}

fn main() -> Int64 {
    let a = cli()
    let log = logger("vlog")

    let src = loadLines(a)
    if !src.ok {
        let path = match opt(a, "--file") {
            Some(p) => p,
            None => "",
        }
        log.error("cannot read `\{path}`")
        return 3
    }
    let recs = recordsFrom(src.lines)

    if flag(a, "--help") {
        return usage()
    }

    let pos = positionals(a)
    if pos.length == 0 {
        return cmdOverview(recs)
    }

    let cmd = pos[0]
    if cmd == "count" {
        return cmdCount(recs)
    }
    if cmd == "fmt" {
        return cmdFmt(recs)
    }
    if cmd == "stats" {
        return cmdStats(recs)
    }
    if cmd == "filter" {
        return cmdFilter(recs, a)
    }
    if cmd == "tail" {
        let n = match opt(a, "-n") {
            Some(s) => match parse(s) {
                Some(v) => v,
                None => 10,
            },
            None => 10,
        }
        return cmdTail(recs, n)
    }
    if cmd == "help" {
        return usage()
    }
    let log = logger("vlog")
    log.error("unknown subcommand `\{cmd}`")
    return usage()
}

test "substring takes a byte range" {
    assertEq(substring("hello world", 0, 5), "hello")
    assertEq(substring("hello world", 6, 11), "world")
    assertEq(substring("abc", 1, 1), "")
}

test "indexOf finds and misses (Option)" {
    assert(match indexOf("a=b", "=") { Some(i) => i == 1, None => false })
    assert(match indexOf("abc", "=") { Some(i) => false, None => true })
    assert(match indexOf("", "=") { Some(i) => false, None => true })
}

test "trim strips surrounding whitespace" {
    assertEq(trim("  hi \t"), "hi")
    assertEq(trim("nospace"), "nospace")
    assertEq(trim("   "), "")
}

test "case folds over ASCII only" {
    assertEq(toLower("ERROR"), "error")
    assertEq(toUpper("info"), "INFO")
    assertEq(toLower("Mixed123"), "mixed123")
}

test "toHex is 16 lowercase nibbles" {
    assertEq(toHex(255), "00000000000000ff")
    assertEq(toHex(0), "0000000000000000")
}

test "padStart zero-pads below width" {
    assertEq(padStart("3", 2, "0"), "03")
    assertEq(padStart("42", 2, "0"), "42")
}

test "hms slices the time of day" {
    assertEq(hms(3723000), "01:02:03")
}

test "parseLevel is case-insensitive and finite" {
    assert(match parseLevel("ERROR") { Some(l) => levelName(l) == "error", None => false })
    assert(match parseLevel("wizard") { Some(l) => false, None => true })
}

test "tallyLevels counts by key in insertion order" {
    let levels: Array<String> = ["info", "error", "info", "warn", "info"]
    let m = tallyLevels(levels)
    assertEq(countOf(m, "info"), 3)
    assertEq(countOf(m, "error"), 1)
    assertEq(countOf(m, "warn"), 1)
    assertEq(countOf(m, "missing"), 0)
    let keys = m.keys()
    assertEq(keys[0], "info")
    assertEq(keys[1], "error")
    assertEq(keys[2], "warn")
}

test "std/args opt reads the space and equals forms vlog uses" {
    let a = cliOf(["filter", "--level", "error", "--contains=boom"])
    assert(match opt(a, "--level") { Some(v) => v == "error", None => false })
    assert(match opt(a, "--contains") { Some(v) => v == "boom", None => false })
    assert(match opt(a, "-n") { Some(v) => false, None => true })
    let pos = positionals(a)
    assertEq(pos[0], "filter")
}

test "humanizeDuration renders spans" {
    assertEq(humanizeDuration(0), "0ms")
    assertEq(humanizeDuration(5000), "5s")
    assertEq(humanizeDuration(62000), "1m 2s")
    assertEq(humanizeDuration(500), "500ms")
}
