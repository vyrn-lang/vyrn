// The two ways a value reaches a `consume` parameter.

fn take(xs: consume Array<Int64>) -> Int64 {
    let n = xs.length
    drop xs
    return n
}

fn owner(ys: consume Array<Int64>) -> Int64 {
    return take(ys)
}

fn lender(ys: Array<Int64>) -> Int64 {
    return take(ys.copy())
}

fn main() -> Int64 {
    let a: Array<Int64> = [1, 2, 3]
    print(owner(a))
    let b: Array<Int64> = [4, 5]
    print(lender(b))
    print(b.length)
    return 0
}
