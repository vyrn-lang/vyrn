// Who owns a block while a `region` is open, once per escape route.

import { slice } from "std/strpred"
import { joinWith } from "std/strings"

type Tagged = { label: String, size: Int64 }

type Boxed = enum {
    Empty,
    Wrapped(String, Int64) }

let mut held: String = ""

fn detect(tag: String) -> Int64 {
    let mut ds: Array<String> = []
    ds.push("A1" + "3456789012")
    ds.push("B2" + "3456789012")
    ds.push("C3" + "3456789012")
    ds.push("D4" + "3456789012")
    let mut i = 0
    while i < 4 {
        print(tag + ds[i])
        i = i + 1
    }
    return ds.length
}

fn main() -> Int64 {
    let six = "abcdef"
    let sixb = "ghijkl"
    let mut n = 0

    region {
        let mut es: Array<String> = []
        es.push(six + sixb)
        n = es.length
    }
    n = n + detect("container ")

    region {
        let tag = Tagged { label: six + sixb, size: 1 }
        n = n + tag.label.byteLength
    }
    n = n + detect("field     ")

    region {
        let orig = six + sixb
        let cp = orig.copy()
        n = n + cp.byteLength
    }
    n = n + detect("copy      ")

    region {
        let mut sl: Array<String> = [six + sixb]
        sl[0] = six + "!!!!!!"
        n = n + sl[0].byteLength
    }
    n = n + detect("elemstore ")

    region {
        let mut mp: Map<String, String> = [:]
        mp[six + sixb] = six + sixb
        mp[six + sixb] = sixb + six
        n = n + mp.length
    }
    n = n + detect("mapstore  ")

    region {
        let s = six + sixb
        n = n + s.byteLength
        drop s
    }
    n = n + detect("dropped   ")

    region {
        held = six + sixb
        held = sixb + six
        n = n + held.byteLength
    }
    n = n + detect("global    ")

    region {
        let s = six + sixb
        n = n + match slice(s, 0, 4) {
            Ok(v) => v.byteLength,
            Err(e) => 0,
        }
        let mut parts: Array<String> = []
        parts.push(six + sixb)
        parts.push(sixb + six)
        n = n + joinWith(parts, "-").byteLength
    }
    n = n + detect("callee    ")

    region {
        let o: Option<String> = Some(six + sixb)
        n = n + match o {
            Some(v) => v.byteLength,
            None => 0,
        }
    }
    n = n + detect("payload   ")

    region {
        let w: Boxed = Wrapped(six + sixb, 7)
        n = n + match w {
            Wrapped(s, k) => s.byteLength + k,
            Empty => 0,
        }
    }
    n = n + detect("variant   ")

    print(n) // 162
    return 0
}
