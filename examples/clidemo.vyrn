// The command line as a record type.

import { cli, wantsHelp } from "std/cli"
import { parseServe, helpServe } from cli("./lib/serve")
import { Serve } from "./lib/serve"

fn report(s: Serve) -> Int64 {
    print("port=\{s.port}")
    print("root=\{s.root}")
    if let Some(h) = s.host {
        print("host=\{h}")
    } else {
        print("host=none")
    }
    print("verbose=\{s.verbose}")
    for f in s.files {
        print("file=\{f}")
    }
    return 0
}

fn main() -> Int64 {
    let argv = args()

    if wantsHelp(argv) {
        print(helpServe())
        return 0
    }

    print(helpServe())
    print("----")

    return match parseServe(argv) {
        Valid(s) => report(s),
        Invalid(issues) => 2,
    }
}
