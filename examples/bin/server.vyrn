/// The bin server root: RPC handler, page routers, OpenAPI document, and theme
/// stylesheet, composed from the api directory and the two route trees.
///
/// It is the one module that legitimately names both sides of the wire, and the
/// manifest key that NAMES it is what gives it its audience (RFC-0072 M1) — no
/// path segment could say it, and blessing the filename would be the hardcoding
/// the `audience` key exists to avoid.
///
/// Two page trees, because they have two audiences. `app/routes` is universal:
/// server-rendered here AND compiled into the browser bundle, so a soft nav
/// paints the next page itself. `server/routes` holds the raw endpoint, which
/// answers with `respond` and is never bundled — it is server-only, and saying so
/// in the tree is the whole point of the milestone.
import { rpc } from "std/rpc"
import { rpcHandle } from rpc("./server/api")
import { openapi } from "std/openapi"
import { openapiJson } from openapi("./server/api/pastes")
import { pagesThemed } from "std/ui"
import { route } from pagesThemed("./app/routes", "./theme.json")
import * as rawPages from pagesThemed("./server/routes", "./theme.json")
import { tw } from "std/tw"
import * as theme from tw("./theme.json")
import { mount, surface } from "std/http"
import * as pastesHttp from "./server/api/pastes.http"

/// A middleware may answer a request outright (`Some`) or pass it along (`None`);
/// the chain runs in registration order in front of routing.
type Middleware = fn(Request) -> Option<Response>

/// The chain, installed at module-state init. Request logging runs for every
/// request and never answers.
let mut middleware: Array<Middleware> = [
        |req| {
        logger("http").info("\{req.method} \{req.path}")
        return None
    },
]

/// Run the chain: the first `Some` wins; middleware after a hit never runs.
fn runMiddleware(req: Request) -> Option<Response> {
    let mut hit: Option<Response> = None
    for m in middleware {
        hit = match hit { Some(r) => Some(r), None => m(req) }
    }
    return hit
}

fn handle(req: Request) -> Response {
    return match runMiddleware(req) {
        Some(r) => r,
        None => routed(req),
    }
}

fn routed(req: Request) -> Response {
    // Baked constants served with their conventional content types.
    if req.method == "GET" && req.path == "/theme.css" {
        return Response { status: 200, contentType: "text/css", body: theme.css(), vary: "", headers: [:] }
    }
    if req.method == "GET" && req.path == "/openapi.json" {
        return Response { status: 200, contentType: "application/json", body: openapiJson(), vary: "", headers: [:] }
    }
    // The server-only route tree owns its prefix outright; a server root is
    // exactly where "which surface answers which prefix" belongs.
    if req.path.startsWith("/raw/") {
        return rawPages.route(req)
    }
    // The two wire surfaces, mounted in order, first match wins (RFC-0074): the
    // derived RPC surface (/_/*) that the pages call, then the public REST API
    // written over the same three procedures. `mount` traps at startup if either
    // could shadow the other, so "which one answers /pastes/x" is not a question
    // anyone has to hold in their head.
    //
    // Pages stay OUTSIDE the mount and last, because `route` always answers
    // (`-> Response`, with its own 404 page) — it is the fallback, not a group
    // that can decline.
    // The third list is the streams (RFC-0074 M3a). They are not routes and they
    // do not carry `Policy`; `mount` resolves them first, because a stream's path
    // is exact and `/pastes/{id}` is exactly the shape that would swallow one.
    return match mount(req, [[surface("/_", rpcHandle)], pastesHttp.routes()], pastesHttp.feeds()) {
        Some(r) => r,
        None => route(req),
    }
}

fn main() -> Int64 {
    // A read-only smoke over handle. `vyrn serve`/`vyrn dev` run main() once at
    // startup, so it must not mutate the live store.
    let list = handle(Request { method: "POST", path: "/_/pastes/recent", headers: [:], body: "" })
    print("pastes/recent -> \{list.status}: \{list.body}")
    let bad = handle(Request { method: "POST", path: "/_/pastes/create", headers: [:], body: "{\"title\":\"x\",\"body\":\"\",\"lang\":\"klingon\"}" })
    print("pastes/create(bad) -> \{bad.status}: \{bad.body}")
    let home = handle(Request { method: "GET", path: "/", headers: [:], body: "" })
    print("/ -> \{home.status}")
    let miss = handle(Request { method: "GET", path: "/p/deadbeef", headers: [:], body: "" })
    print("/p/deadbeef -> \{miss.status}")
    let rawMiss = handle(Request { method: "GET", path: "/raw/deadbeef", headers: [:], body: "" })
    print("/raw/deadbeef -> \{rawMiss.status}")
    let oa = handle(Request { method: "GET", path: "/openapi.json", headers: [:], body: "" })
    print("/openapi.json -> \{oa.status} (\{oa.body.byteLength} bytes)")
    return 0
}
