// Capacity reservation and bulk append.

type Point = {
    x: Int64,
    y: Int64,
}

fn line(n: Int64) -> Array<UInt8> {
    let mut out: Array<UInt8> = []
    out.reserve(n)
    let mut i = 0
    while i < n {
        out.push(UInt8(65 + i - (i / 26) * 26))
        i = i + 1
    }
    return out
}

fn main() -> Int64 {
    let one = line(60)
    let mut out: Array<UInt8> = []
    out.reserve(610)
    let mut j = 0
    while j < 10 {
        out.append(one)
        out.push(UInt8(10))
        j = j + 1
    }
    print("bytes \{out.length} first \{Int64(out[0])} nl \{Int64(out[60])}")

    let mut ps: Array<Point> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let more: Array<Point> = [Point { x: 5, y: 6 }]
    ps.append(more)
    print("points \{ps.length} last \{ps[2].x},\{ps[2].y}")

    let mut dup: Array<Int64> = [7, 8, 9]
    dup.append(dup)
    print("dup \{dup.length} tail \{dup[3]}\{dup[4]}\{dup[5]}")

    let mut r: Array<Int64> = [1]
    r.reserve(100)
    print("reserved len \{r.length}")

    let mut buf: Array<Int64> = [9, 9, 9, 9]
    let small: Array<Int64> = [1, 2]
    buf.copyFrom(small)
    print("cf \{buf.length} \{buf[0]}\{buf[1]}")
    let big: Array<Int64> = [5, 6, 7, 8, 9, 10]
    buf.copyFrom(big)
    print("cf \{buf.length} last \{buf[5]}")
    buf.copyFrom(buf)
    print("cf self \{buf.length} \{buf[0]}")
    return 0
}
