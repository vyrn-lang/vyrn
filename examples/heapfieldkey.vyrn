// Refused on purpose: a `Map` key with a heap field.
import { Hashable } from "std/hash"

type Tag = { name: String, n: Int64 }

impl Hashable for Tag {
    fn hash(self) -> UInt64 {
        return UInt64(self.n)
    }
}

fn main() -> Int64 {
    let mut m: Map<Tag, Int64> = [:]
    return m.length
}
