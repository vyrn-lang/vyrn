// The codec builtins of `std/codecs`.

import { base64Decode, base64Encode, hexDecode, hexEncode, urlDecode, urlEncode } from "std/codecs"

fn asciiSweep() -> String {
    let mut b: Array<UInt8> = []
    let mut i = 1
    while i < 128 {
        b.push(UInt8(i))
        i = i + 1
    }
    return match stringFromBytes(b) {
        Ok(s) => s,
        Err(e) => "unreachable",
    }
}

fn show(o: Option<String>) -> String {
    return match o {
        Some(s) => s.copy(),
        None => "None",
    }
}

fn main() -> Int64 {
    print(hexEncode("Hi")) // 4869
    print(hexEncode("")) //
    print(hexEncode("café ☕")) // the UTF-8 bytes, not the code points
    print(hexEncode(asciiSweep()).byteLength) // 254
    print(show(hexDecode("4869"))) // Hi
    print(show(hexDecode("C3a9"))) // é
    print(show(hexDecode("486"))) // None
    print(show(hexDecode("zz"))) // None
    print(show(hexDecode("80"))) // None  (a lone continuation byte)

    print(base64Encode("")) //
    print(base64Encode("A")) // QQ==
    print(base64Encode("AB")) // QUI=
    print(base64Encode("ABC")) // QUJD
    print(base64Encode("~~~")) // fn5+
    print(base64Encode("ÿÿ")) // w7/Dvw==
    print(base64Encode(asciiSweep()).byteLength) // 172
    print(show(base64Decode("SGVsbG8="))) // Hello
    print(show(base64Decode(base64Encode("café ☕")))) // café ☕
    print(show(base64Decode("QQ="))) // None
    print(show(base64Decode("QQ*="))) // None
    print(show(base64Decode("Q=QQ"))) // None
    print(show(base64Decode("QQ==QQ=="))) // None
    print(show(base64Decode("////"))) // None

    print(urlEncode("aZ09-_.~")) // aZ09-_.~   (the unreserved set, untouched)
    print(urlEncode("name=a b&x")) // name%3Da%20b%26x
    print(urlEncode("a+b")) // a%2Bb   (`+` is reserved, not a space)
    print(urlEncode("é")) // %C3%A9   (uppercase hex)
    print(show(urlDecode("%C3%A9"))) // é
    print(show(urlDecode("%c3%a9"))) // é   (either case decodes)
    print(show(urlDecode("a+b"))) // a+b  (no `+` special case in either direction)
    print(show(urlDecode("%"))) // None
    print(show(urlDecode("%4"))) // None
    print(show(urlDecode("%zz"))) // None
    print(show(urlDecode("%80"))) // None

    let s = "Hello, Vyrn! ☕ 100% — é"
    print(show(hexDecode(hexEncode(s))) == s) // true
    print(show(base64Decode(base64Encode(s))) == s) // true
    print(show(urlDecode(urlEncode(s))) == s) // true
    return 0
}

test "the routed codecs answer what the C and Rust ones answered" {
    assertEq(hexEncode("Hi"), "4869")
    assertEq(hexEncode(""), "")
    assertEq(hexEncode("café ☕"), "636166c3a920e29895")
    assertEq(hexEncode(asciiSweep()).byteLength, 254)
    assertEq(show(hexDecode("4869")), "Hi")
    assertEq(show(hexDecode("C3a9")), "é")
    assertEq(show(hexDecode("486")), "None")
    assertEq(show(hexDecode("zz")), "None")
    assertEq(show(hexDecode("80")), "None")
}

test "base64 pads at all three residues, and refuses misplaced padding" {
    assertEq(base64Encode(""), "")
    assertEq(base64Encode("A"), "QQ==")
    assertEq(base64Encode("AB"), "QUI=")
    assertEq(base64Encode("ABC"), "QUJD")
    assertEq(base64Encode("~~~"), "fn5+")
    assertEq(base64Encode("ÿÿ"), "w7/Dvw==")
    assertEq(show(base64Decode("SGVsbG8=")), "Hello")
    assertEq(show(base64Decode("QQ=")), "None")
    assertEq(show(base64Decode("QQ*=")), "None")
    assertEq(show(base64Decode("Q=QQ")), "None")
    assertEq(show(base64Decode("QQ==QQ==")), "None")
    assertEq(show(base64Decode("////")), "None")
}

test "percent-encoding keeps the unreserved set and nothing else" {
    assertEq(urlEncode("aZ09-_.~"), "aZ09-_.~")
    assertEq(urlEncode("name=a b&x"), "name%3Da%20b%26x")
    assertEq(urlEncode("a+b"), "a%2Bb")
    assertEq(urlEncode("é"), "%C3%A9")
    assertEq(show(urlDecode("%C3%A9")), "é")
    assertEq(show(urlDecode("%c3%a9")), "é")
    assertEq(show(urlDecode("a+b")), "a+b")
    assertEq(show(urlDecode("%")), "None")
    assertEq(show(urlDecode("%4")), "None")
    assertEq(show(urlDecode("%zz")), "None")
    assertEq(show(urlDecode("%80")), "None")
}
