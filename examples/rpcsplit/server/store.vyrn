/// The store for the split in-process RPC demo — it OWNS the item list as module
/// state and imports its wire types from `shared/wire.vyrn`. The procedure
/// module beside it under `server/api` calls straight in here.
import { Id, Item, GetReq, ItemResult } from "../shared/wire"

let mut items: Array<Item> = [
    Item { id: 1, label: "alpha" },
    Item { id: 2, label: "beta" },
]

/// Fetch one item by id; `Err` when absent.
export fn getItem(req: GetReq) -> ItemResult {
    for it in items {
        if it.id == req.id {
            return Ok(Item { id: it.id, label: it.label.copy() })
        }
    }
    return Err("no item \{req.id}")
}
