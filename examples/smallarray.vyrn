// A small-buffer collection.

type Histogram = { name: String, counts: SmallArray<Int64, 4> }

type Bucket = enum {
    Empty,
    Filled(SmallArray<Int64, 3>) }

type Point = { x: Int64, y: Int64 }
type Swapped = { y: Int64, x: Int64 }
type Named = { name: String, n: Int64 }
type Slot = enum {
    Free,
    Held(String) }

fn firstPoint(ps: SmallArray<Swapped, 3>) -> String {
    return "\{ps[0].x} \{ps[0].y}"
}

fn sumSmall(xs: SmallArray<Int64, 4>) -> Int64 {
    let mut total = 0
    for x in xs {
        total = total + x
    }
    return total
}

fn main() -> Int64 {
    let mut xs: SmallArray<Int64, 4> = []
    let mut i = 0
    while i < 4 {
        xs.push(i * 10) // stays inline: cap == 4, data null
        i = i + 1
    }
    print(xs.length) // 4 — full but still inline
    print(sumSmall(xs)) // 0 + 10 + 20 + 30 = 60

    xs.push(40) // len == cap == 4 → spill: allocate 8, copy the inline slots
    xs.push(50)
    print(xs.length) // 6 — now spilled
    print(sumSmall(xs)) // 150

    print(xs[3]) // 30
    xs[3] = 999 // in-place store into the (now heap) buffer
    print(xs[3]) // 999

    let popped = match xs.pop() { Some(v) => v, None => 0 - 1 }
    print(popped) // 50
    let removed = xs.swapRemove(0) // last (40) moves into slot 0
    print(removed) // 0
    print(xs.length) // 4 — below N again, but still on the heap
    print(xs[0]) // 40

    let out = xs.toArray()
    print(out.length) // 4
    print(out[0]) // 40
    drop out
    drop xs

    let mut small: SmallArray<Int64, 8> = [1, 2, 3]
    small.push(4)
    print(small.length) // 4 — inline, cap stays 8
    print(small[2]) // 3
    drop small

    let a: SmallArray<Int64, 2> = [1, 2]
    let b: SmallArray<Int64, 2> = [3, 4]
    let mut grid: SmallArray<SmallArray<Int64, 2>, 2> = []
    grid.push(a)
    grid.push(b)
    let row = grid[1]
    print(row[0]) // 3
    print(grid.length) // 2
    drop grid

    let h = Histogram { name: "h", counts: [7, 8] }
    print(h.counts[1]) // 8
    print(h.counts.length) // 2

    let bucket = Filled([5, 6, 7])
    let bsum = match bucket {
        Empty => 0,
        Filled(vals) => vals[0] + vals[2],
    }
    print(bsum) // 12

    let mut ps: SmallArray<Point, 3> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    ps[0].x = 5
    ps.push(Point { x: 6, y: 7 })
    print("\{ps[0].x} \{ps[1].y} \{ps[2].x} \{ps.length}") // 5 4 6 3
    print(firstPoint(ps)) // 5 2
    let ns: SmallArray<Named, 2> = [Named { name: "ab", n: 1 }]
    print("\{ns[0].name} \{ns[0].n}") // ab 1
    let slots: SmallArray<Slot, 2> = [Held("k"), Free]
    for slot in slots {
        print(match slot { Free => "free", Held(k) => k }) // k, then free
    }
    let rows: SmallArray<Array<Int64>, 2> = [[1, 2], [3]]
    print(rows[0][1] + rows[1][0]) // 5

    return 0
}

bench "smallarray push16 (inline, no alloc)" {
    let mut xs: SmallArray<Int64, 16> = []
    let mut i = 0
    while i < 16 {
        xs.push(i)
        i = i + 1
    }
    blackBox(xs.length)
}

bench "array push16 (heap, grows)" {
    let mut xs: Array<Int64> = []
    let mut i = 0
    while i < 16 {
        xs.push(i)
        i = i + 1
    }
    blackBox(xs.length)
}

bench "smallarray indexed sum (branch/access)" {
    let mut xs: SmallArray<Int64, 16> = []
    let mut i = 0
    while i < 16 {
        xs.push(i)
        i = i + 1
    }
    let mut total = 0
    let mut r = 0
    while r < 64 {
        let mut j = 0
        while j < 16 {
            total = total + xs[j]
            j = j + 1
        }
        r = r + 1
    }
    blackBox(total)
}

bench "array indexed sum (direct)" {
    let mut xs: Array<Int64> = []
    let mut i = 0
    while i < 16 {
        xs.push(i)
        i = i + 1
    }
    let mut total = 0
    let mut r = 0
    while r < 64 {
        let mut j = 0
        while j < 16 {
            total = total + xs[j]
            j = j + 1
        }
        r = r + 1
    }
    blackBox(total)
}
