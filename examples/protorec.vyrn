type Box = { n: Int64 }
type Crate = { n: Int64 }
type Pallet = { top: Box, id: Int64 }

protocol Bump {
    fn bump(self) -> Int64
    fn label(self) -> String
}

impl Bump for Box {
    fn bump(self) -> Int64 { return self.n + 1 }
    fn label(self) -> String { return "box(" + self.n.toString() + ")" }
}

impl Bump for Crate {
    fn bump(self) -> Int64 { return self.n * 10 }
    fn label(self) -> String { return "crate(" + self.n.toString() + ")" }
}

fn describe<T: Bump>(x: T) -> String {
    return x.label() + " -> " + x.bump().toString()
}

protocol Grow {
    fn grow(self) -> Box
}

impl Grow for Box {
    fn grow(self) -> Box { return Box { n: self.n * 2 } }
}

fn loud(b: Box) -> Box {
    print("loud")
    return b
}

fn main() -> Int64 {
    let b = Box { n: 4 }
    print(b.bump()) // 5
    print(b.label()) // box(4)
    print(describe(b)) // box(4) -> 5

    let c: Crate = b
    print(c.bump()) // 40
    print(describe(c)) // crate(4) -> 40

    let p = Pallet { top: Box { n: 9 }, id: 1 }
    let inner = p.top
    print(inner.bump()) // 10
    print(describe(inner)) // box(9) -> 10

    let boxes: Array<Box> = [Box { n: 0 }, Box { n: 7 }, Box { n: 41 }]
    let mut total = 0
    let mut i = 0
    while i < boxes.length {
        let item = boxes[i]
        total = total + item.bump()
        i = i + 1
    }
    print(total) // 51

    let crates: Array<Crate> = [Box { n: 1 }, Box { n: 2 }]
    let first = crates[0]
    print(first.bump()) // 10 — an element learns its name from the array's type

    print(Box { n: 3 }.bump()) // 4 — a literal receiver
    print(b.grow().grow().bump()) // 17 — every receiver but the first is a call
    print(loud(b).grow().bump()) // loud / 9
    return 0
}
