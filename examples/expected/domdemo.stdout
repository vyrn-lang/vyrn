{"El":["main",[],[{"El":["h1",[],[{"Text":"vyrn-dom demo"}]]},{"El":["section",[{"Id":"counter"}],[{"El":["h2",[],[{"Text":"Counter"}]]},{"El":["p",[{"Id":"count"}],[{"Text":"count = 0"}]]},{"El":["button",[{"Id":"inc"},{"On":["click","increment",""]}],[{"Text":"+1"}]]},{"El":["button",[{"Id":"dec"},{"On":["click","decrement",""]}],[{"Text":"-1"}]]},{"El":["button",[{"Id":"reset"},{"On":["click","resetCount",""]}],[{"Text":"reset"}]]}]]},{"El":["hr",[],[]]},{"El":["section",[{"Id":"inputbox"}],[{"El":["h2",[],[{"Text":"Text input"}]]},{"El":["input",[{"Id":"field"},{"A":["placeholder","type here…"]},{"On":["input","onType",""]}],[]]},{"El":["p",[{"Id":"echo"}],[{"Text":"you typed: "}]]}]]},{"El":["hr",[],[]]},{"El":["section",[{"Id":"list"}],[{"El":["h2",[],[{"Text":"Keyed list"}]]},{"El":["button",[{"Id":"rotate"},{"On":["click","rotate",""]}],[{"Text":"rotate (first → last)"}]]},{"El":["ul",[{"Id":"rows"}],[{"El":["li",[{"Cls":"row"},{"Key":"1"}],[{"El":["span",[{"Cls":"tag"}],[{"Text":"#1 Widget"}]]},{"El":["input",[{"A":["placeholder","note…"]}],[]]}]]},{"El":["li",[{"Cls":"row"},{"Key":"2"}],[{"El":["span",[{"Cls":"tag"}],[{"Text":"#2 Gadget"}]]},{"El":["input",[{"A":["placeholder","note…"]}],[]]}]]},{"El":["li",[{"Cls":"row"},{"Key":"3"}],[{"El":["span",[{"Cls":"tag"}],[{"Text":"#3 Sprocket"}]]},{"El":["input",[{"A":["placeholder","note…"]}],[]]}]]},{"El":["li",[{"Cls":"row"},{"Key":"4"}],[{"El":["span",[{"Cls":"tag"}],[{"Text":"#4 Cog"}]]},{"El":["input",[{"A":["placeholder","note…"]}],[]]}]]}]]}]]},{"El":["hr",[],[]]},{"El":["section",[{"Id":"subs"}],[{"El":["h2",[],[{"Text":"Subscription — Every 1s"}]]},{"El":["p",[{"Id":"ticks"}],[{"Text":"ticks = 0"}]]},{"El":["button",[{"Id":"toggle"},{"On":["click","toggleTimer",""]}],[{"Text":"stop timer"}]]}]]}]]}
--- after +2, type, rotate ---
<main><h1>vyrn-dom demo</h1><section id="counter"><h2>Counter</h2><p id="count">count = 2</p><button id="inc" data-on-click="increment" data-arg-click="">+1</button><button id="dec" data-on-click="decrement" data-arg-click="">-1</button><button id="reset" data-on-click="resetCount" data-arg-click="">reset</button></section><hr><section id="inputbox"><h2>Text input</h2><input id="field" placeholder="type here…" data-on-input="onType" data-arg-input=""><p id="echo">you typed: hello</p></section><hr><section id="list"><h2>Keyed list</h2><button id="rotate" data-on-click="rotate" data-arg-click="">rotate (first → last)</button><ul id="rows"><li class="row" data-key="2"><span class="tag">#2 Gadget</span><input placeholder="note…"></li><li class="row" data-key="3"><span class="tag">#3 Sprocket</span><input placeholder="note…"></li><li class="row" data-key="4"><span class="tag">#4 Cog</span><input placeholder="note…"></li><li class="row" data-key="1"><span class="tag">#1 Widget</span><input placeholder="note…"></li></ul></section><hr><section id="subs"><h2>Subscription — Every 1s</h2><p id="ticks">ticks = 0</p><button id="toggle" data-on-click="toggleTimer" data-arg-click="">stop timer</button></section></main>
subs on: [{"Every":[1000,"onTick"]}]
