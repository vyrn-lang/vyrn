// Block-bodied match arms in statement position.

type Shape = enum {
    Dot,
    Wide(String, String) }

fn toss(s: consume Shape) {
    match consume s {
        Dot => {}
        Wide(a, b) => {
            drop a
            drop b
        }
    }
}

fn maybe(i: Int64) -> Option<Int64> {
    if i % 2 == 0 {
        return Some(i)
    }
    return None
}

fn main() -> Int64 {
    let t = Wide("left", "right")
    match t {
        Dot => print("dot"),
        Wide(a, b) => {
            let joined = a + "+" + b
            print("wide \{joined}")
            print("\{joined.byteLength}")
        }
    }

    match maybe(4) {
        Some(n) => print("even \{n}"),
        None => {}
    }

    let mut i = 0
    let mut sum = 0
    while i < 10 {
        match maybe(i) {
            Some(n) => {
                if n > 4 {
                    break
                }
                sum = sum + n
            }
            None => {}
        }
        i = i + 1
    }
    print("sum \{sum}")

    toss(Wide("a", "b"))
    toss(Dot)
    print("tossed")
    return 0
}
