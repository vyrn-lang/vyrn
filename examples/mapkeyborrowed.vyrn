// Refused on purpose: a borrowed value stored as a `Map` key.

fn mapBuild(ks: Array<String>) -> Map<String, Int64> {
    let mut m: Map<String, Int64> = [:]
    let mut i = 0
    while i < ks.length {
        m[ks[i]] = i
        i = i + 1
    }
    return m
}

fn main() -> Int64 {
    let mut ks: Array<String> = []
    ks.push("key" + "0")
    let m = mapBuild(ks)
    print(m.length.toString())
    print(ks[0])
    drop m
    drop ks
    return 0
}
