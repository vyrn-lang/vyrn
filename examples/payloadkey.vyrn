// Refused on purpose: a payload-bearing enum as a `Map` key.
import { Hashable } from "std/hash"

type Shape =
    | Dot
    | Line(Int64)

impl Hashable for Shape {
    fn hash(self) -> UInt64 {
        return match self {
            Dot => UInt64(1),
            Line(n) => UInt64(n),
        }
    }
}

fn main() -> Int64 {
    let mut m: Map<Shape, Int64> = [:]
    return m.length
}
