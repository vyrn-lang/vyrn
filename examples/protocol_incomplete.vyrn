// Refused on purpose: an impl missing a protocol method.

type Sq = { side: Int64 }

protocol Shape {
    fn area(self) -> Int64
    fn name(self) -> String
}

impl Shape for Sq {
    fn area(self) -> Int64 { return self.side * self.side }
}

fn describe<T: Shape>(x: T) -> String {
    return x.name() + " of " + x.area().toString()
}

fn main() -> Int64 {
    print(describe(Sq { side: 3 }))
    return 0
}
