// A lambda that captures a `fn`-typed parameter.

import { map } from "std/arrays"

fn twice(n: Int64) -> Int64 {
    return n * 2
}

fn negate(n: Int64) -> Int64 {
    return 0 - n
}

fn applyAll(xs: Array<Int64>, f: fn(Int64) -> Int64) -> Array<Int64> {
    let g: fn(Int64) -> Int64 = n -> f(n) + 1
    let mut out: Array<Int64> = []
    let mut i = 0
    while i < xs.length {
        out.push(g(xs[i]))
        i = i + 1
    }
    return out
}

fn shiftAll(xs: Array<Int64>, f: fn(Int64) -> Int64, by: Int64) -> Array<Int64> {
    return map(xs, n -> f(n) + by)
}

fn zipApply(
    xs: Array<Int64>,
    f: fn(Int64) -> Int64,
    g: fn(Int64) -> Int64,
) -> Array<Int64> {
    return map(xs, n -> f(n) + g(n))
}

fn viaOnward(xs: Array<Int64>, f: fn(Int64) -> Int64) -> Array<Int64> {
    return applyAll(xs, n -> f(n) * 10)
}

fn main() -> Int64 {
    let nums: Array<Int64> = [1, 2, 3]

    let a = applyAll(nums, twice)
    print(a[0]) // 3
    print(a[2]) // 7

    let b = shiftAll(nums, twice, 100)
    print(b[0]) // 102
    print(b[2]) // 106

    let c = zipApply(nums, twice, negate)
    print(c[0]) // 1
    print(c[2]) // 3

    let d = viaOnward(nums, negate)
    print(d[0]) // -9
    print(d[2]) // -29

    return 0
}
