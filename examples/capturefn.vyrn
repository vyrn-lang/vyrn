/// A lambda that CAPTURES a `fn`-typed parameter (RFC-0023 × RFC-0037). The
/// captured name is not a symbol the lifter can call: it is a parameter holding a
/// defunctionalized function value, so the lifted body takes it as an ordinary
/// function value and dispatches through it — exactly what the enclosing
/// function's own `f(x)` already does. Building a closure over a `fn` parameter is
/// the ordinary way to write a combinator, so it is covered here in all four
/// shapes: stored, passed, alongside a value capture, and two at once.

import { map } from "std/arrays"

fn twice(n: Int64) -> Int64 {
    return n * 2
}

fn negate(n: Int64) -> Int64 {
    return 0 - n
}

/// Stored: the lambda becomes a value in a `fn`-typed slot (RFC-0037).
fn applyAll(xs: Array<Int64>, f: fn(Int64) -> Int64) -> Array<Int64> {
    let g: fn(Int64) -> Int64 = |n| f(n) + 1
    let mut out: Array<Int64> = []
    let mut i = 0
    while i < xs.length {
        out.push(g(xs[i]))
        i = i + 1
    }
    return out
}

/// Passed: the lambda goes straight into another higher-order call (RFC-0023's
/// zero-cost argument path), capturing a `fn` parameter and an ordinary local
/// side by side — the capture list is mixed, not uniform.
fn shiftAll(xs: Array<Int64>, f: fn(Int64) -> Int64, by: Int64) -> Array<Int64> {
    return map(xs, |n| f(n) + by)
}

/// Two DIFFERENT `fn` parameters captured by one lambda.
fn zipApply(
    xs: Array<Int64>,
    f: fn(Int64) -> Int64,
    g: fn(Int64) -> Int64,
) -> Array<Int64> {
    return map(xs, |n| f(n) + g(n))
}

/// Onward: a lambda over a captured `fn` parameter handed to ANOTHER function's
/// `fn` parameter rather than called here, so the capture threads through a
/// second specialization that never learns there was an outer one.
fn viaOnward(xs: Array<Int64>, f: fn(Int64) -> Int64) -> Array<Int64> {
    return applyAll(xs, |n| f(n) * 10)
}

fn main() -> Int64 {
    let nums: Array<Int64> = [1, 2, 3]

    let a = applyAll(nums, twice)
    print(a[0]) // 3
    print(a[2]) // 7

    let b = shiftAll(nums, twice, 100)
    print(b[0]) // 102
    print(b[2]) // 106

    let c = zipApply(nums, twice, negate)
    print(c[0]) // 1
    print(c[2]) // 3

    let d = viaOnward(nums, negate)
    print(d[0]) // -9
    print(d[2]) // -29

    return 0
}
