/// The website hero's luminance field, in Vyrn (design brief section 6).
///
/// Two rotating plane waves over the cell grid. `frame(t)` returns one glyph
/// index per cell, row by row, and the host paints each glyph with `fillText`.
/// Vyrn computes, JavaScript paints: one call across the boundary per frame, not
/// one per cell.
///
/// It is also the proof for `std/math`'s `sin`. The field is nothing but
/// `Float64` arithmetic, and RFC-0083 compiles with `-ffp-contract=off`, so the
/// interpreter, the native binary and wasm must agree to the last bit. `main`
/// prints the raw IEEE-754 bits of the sampled field, and the parity harness
/// compares the three columns byte for byte. A contracted multiply-add anywhere
/// on this path would change a bit and fail the run.
import { sin, cos, floorF } from "std/math"
import { substring } from "std/strings"

/// The glyph ramp, dark to light. The mid-tones spell the project's name, the
/// way the reference hero spells its own.
fn ramp() -> String {
    return ".:+=VYRN#$&"
}

/// The two-wave field at `(u, v)` and time `t`, in [-1, 1].
export fn field(u: Float64, v: Float64, t: Float64) -> Float64 {
    let a = sin(10.0 * (u * cos(0.7 * t) + v * sin(0.5 * t)) + t)
    let b = cos(10.0 * (u * sin(0.4 * t) - v * cos(0.6 * t)) - 0.5 * t)
    return 0.6 * a + 0.4 * b
}

/// The field as an 8-bit luminance.
export fn luminance(u: Float64, v: Float64, t: Float64) -> Int64 {
    let lum = floorF(255.0 * (0.5 + 0.5 * field(u, v, t)))
    if lum < 0.0 {
        return 0
    }
    if lum > 255.0 {
        return 255
    }
    return Int64(lum)
}

/// One frame as `rows` lines of `cols` glyphs.
///
/// The grid is normalised to [-1, 1] on the long axis. `charAr` is the measured
/// character aspect ratio the host passes in; without it the picture stretches
/// vertically, because a monospace cell is taller than it is wide.
export fn frame(cols: Int64, rows: Int64, t: Float64, charAr: Float64) -> String {
    let glyphs = ramp()
    let mut out = ""
    let mut row = 0
    while row < rows {
        let v = (2.0 * Float64(row) / Float64(rows) - 1.0) / charAr
        let mut col = 0
        while col < cols {
            let u = 2.0 * Float64(col) / Float64(cols) - 1.0
            let lum = luminance(u, v, t)
            // Zero draws nothing, so the background stays clean.
            if lum == 0 {
                out = out + " "
            } else {
                let at = (lum * glyphs.byteLength - 1) / 256
                out = out + substring(glyphs, at, at + 1)
            }
            col = col + 1
        }
        out = out + "\n"
        row = row + 1
    }
    return out
}

fn main() -> Int64 {
    // A small frame, printed as it paints.
    print(frame(48, 9, 0.35, 0.5))

    // The bits behind it. This is the parity claim: three backends, one number.
    let mut i = 0
    while i < 5 {
        let t = 0.25 * Float64(i)
        let x = field(0.31, 0.17, t)
        print("field(0.31, 0.17, \{t}) bits = \{floatBits(x)}")
        i = i + 1
    }
    print("sin(1) bits = \{floatBits(sin(1.0))}")
    print("luminance sweep = \{luminance(0.0, 0.0, 0.0)} \{luminance(0.5, 0.5, 1.0)} \{luminance(0.9, 0.1, 2.0)}")
    return 0
}

test "the frame has one glyph per cell and one newline per row" {
    let f = frame(12, 4, 0.0, 0.5)
    assertEq(f.byteLength, 12 * 4 + 4)
}

test "luminance stays inside the byte range" {
    let mut i = 0
    while i < 40 {
        let t = 0.13 * Float64(i)
        let lum = luminance(0.7, 0.0 - 0.3, t)
        assert(lum >= 0 && lum <= 255)
        i = i + 1
    }
}
