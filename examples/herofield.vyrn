/// The website hero's luminance field, in Vyrn (design brief section 6).
///
/// # What it draws, and why this one
///
/// Three concepts were drawn before this one was picked:
///
///   1. THE TYPED GATE — raw glyph noise drifts in from the left, crosses a
///      bright seam, and leaves as an ordered lattice on the right.
///   2. THREE LANES — one source stream fans into three lanes that render the
///      same pattern in lockstep.
///   3. THE MARK — drifting characters converge into the vortex logo.
///
/// (1) ships. It reads at a glance without a caption — the eye sees disorder,
/// a boundary, and order — and what it depicts is the language's first claim:
/// a type carries the rule that makes a value valid, so untrusted bytes go in
/// and values that satisfy the rule come out. (2) draws parity, which is a
/// quality proof rather than a reason to use the language. (3) draws a logo,
/// which says nothing at all.
///
/// # The division of labour
///
/// `frame(t)` returns one glyph per cell, row by row, and the host paints each
/// glyph with `fillText`. Vyrn computes, JavaScript paints: one call across the
/// boundary per frame, not one per cell.
///
/// # The proof
///
/// The field is nothing but `Float64` arithmetic, and RFC-0083 compiles with
/// `-ffp-contract=off`, so the interpreter, the native binary and wasm must
/// agree to the last bit. `main` prints the raw IEEE-754 bits of the sampled
/// field, and the parity harness compares the three columns byte for byte. A
/// contracted multiply-add anywhere on this path would change a bit and fail
/// the run.
import { sin, cos, floorF } from "std/math"
import { substring } from "std/strings"

/// The glyph ramp, dark to light. The mid-tones spell the project's name, the
/// way the reference hero spells its own.
fn ramp() -> String {
    return ".:+=VYRN#$&"
}

/// `x` held inside [0, 1].
fn unit(x: Float64) -> Float64 {
    if x < 0.0 {
        return 0.0
    }
    if x > 1.0 {
        return 1.0
    }
    return x
}

/// The disordered half: three waves at frequencies with no common measure,
/// multiplied. The product speckles at glyph resolution, which is what raw
/// bytes should look like.
export fn noise(u: Float64, v: Float64, t: Float64) -> Float64 {
    let a = sin(9.7 * u + 5.3 * v + 1.7 * t)
    let b = sin(6.1 * u - 8.3 * v - 1.1 * t)
    let c = sin(13.7 * (u + v) + 0.7 * t)
    return a * b * c
}

/// The ordered half: one regular lattice, drifting steadily to the right. Same
/// stream, now in rows a reader can count.
export fn lattice(u: Float64, v: Float64, t: Float64) -> Float64 {
    return sin(7.0 * v) * cos(3.0 * u - 1.6 * t)
}

/// How far past the gate `u` sits, from 0 (fully raw) to 1 (fully ordered).
/// The gate stands at `u = -0.05` and the crossing takes a quarter of the
/// width, so neither side is a hard edge.
export fn crossing(u: Float64) -> Float64 {
    return unit((u + 0.05) / 0.25)
}

/// The gate itself, as a soft vertical seam. A rational bump rather than a
/// Gaussian, because it needs no `exp` and reads the same at this size.
fn seam(u: Float64) -> Float64 {
    let d = u + 0.05
    return 1.0 / (1.0 + 900.0 * d * d)
}

/// The field at `(u, v)` and time `t`, in roughly [-1.3, 2.3]. `frame` levels
/// it; `main` prints its bits.
export fn field(u: Float64, v: Float64, t: Float64) -> Float64 {
    let w = crossing(u)
    let mixed = (1.0 - w) * 0.85 * noise(u, v, t) + w * lattice(u, v, t)
    return mixed + 1.3 * seam(u)
}

/// The field as an 8-bit luminance, levelled against the range the mix can
/// reach. Zero stays zero: a dark cell draws nothing, so the paper stays clean.
export fn luminance(u: Float64, v: Float64, t: Float64) -> Int64 {
    let lum = floorF(255.0 * unit((field(u, v, t) + 1.1) / 2.6))
    if lum < 0.0 {
        return 0
    }
    if lum > 255.0 {
        return 255
    }
    return Int64(lum)
}

/// One frame as `rows` lines of `cols` glyphs.
///
/// The grid is normalised to [-1, 1] on the long axis. `charAr` is the measured
/// character aspect ratio the host passes in; without it the picture stretches
/// vertically, because a monospace cell is taller than it is wide.
export fn frame(cols: Int64, rows: Int64, t: Float64, charAr: Float64) -> String {
    let glyphs = ramp()
    let mut out = ""
    let mut row = 0
    while row < rows {
        let v = (2.0 * Float64(row) / Float64(rows) - 1.0) / charAr
        let mut col = 0
        while col < cols {
            let u = 2.0 * Float64(col) / Float64(cols) - 1.0
            let lum = luminance(u, v, t)
            // Zero draws nothing, so the background stays clean.
            if lum == 0 {
                out = out + " "
            } else {
                let at = (lum * glyphs.byteLength - 1) / 256
                out = out + substring(glyphs, at, at + 1)
            }
            col = col + 1
        }
        out = out + "\n"
        row = row + 1
    }
    return out
}

/// The frame, exported to the host (RFC-0012 M2). The page calls this on the
/// live instance after `main` returns, once per painted frame, and paints the
/// glyphs it gets back. One boundary crossing per frame, not one per cell.
export extern fn heroFrame(cols: Int64, rows: Int64, t: Float64, charAr: Float64) -> String {
    return frame(cols, rows, t, charAr)
}

/// Everything `main` prints: a small frame, then the raw bits behind it.
///
/// This is the parity payload, and it is a VALUE rather than a sequence of
/// prints so that both sides of the website's parity widget can hash the same
/// bytes. The page runs this module as wasm and hashes what the module writes to
/// stdout; the site's export calls this function in the interpreter and hashes
/// what it returns. `main` is `print(parityReport())`, so the two are the same
/// text by construction and cannot drift.
export fn parityReport() -> String {
    // A small frame, as it paints: noise, gate, lattice. It already ends in a
    // newline, and the blank line after it is the one `print` used to add.
    let mut out = frame(60, 11, 0.35, 0.5) + "\n"

    // The bits behind it. This is the parity claim: three backends, one number.
    let mut i = 0
    while i < 5 {
        let t = 0.25 * Float64(i)
        let x = field(0.31, 0.17, t)
        out = out + "field(0.31, 0.17, \{t}) bits = \{floatBits(x)}\n"
        i = i + 1
    }
    out = out + "sin(1) bits = \{floatBits(sin(1.0))}\n"
    out = out + "noise bits = \{floatBits(noise(0.4, 0.0 - 0.2, 1.5))}\n"
    out = out + "lattice bits = \{floatBits(lattice(0.4, 0.0 - 0.2, 1.5))}\n"
    return out + "luminance sweep = \{luminance(0.0, 0.0, 0.0)} \{luminance(0.5, 0.5, 1.0)} \{luminance(0.9, 0.1, 2.0)}"
}

fn main() -> Int64 {
    print(parityReport())
    return 0
}

test "the frame has one glyph per cell and one newline per row" {
    let f = frame(12, 4, 0.0, 0.5)
    assertEq(f.byteLength, 12 * 4 + 4)
}

test "the gate separates the two halves" {
    // Far left is raw, far right is ordered, and the crossing runs between.
    assertEq(crossing(0.0 - 1.0), 0.0)
    assertEq(crossing(1.0), 1.0)
    assert(crossing(0.0) > 0.0 && crossing(0.0) < 1.0)
}

test "luminance stays inside the byte range" {
    let mut i = 0
    while i < 40 {
        let t = 0.13 * Float64(i)
        let lum = luminance(0.7, 0.0 - 0.3, t)
        assert(lum >= 0 && lum <= 255)
        i = i + 1
    }
}
