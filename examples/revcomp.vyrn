// reverse-complement, from the Computer Language Benchmarks Game.

let benchOrder = 2000000

fn complementTable() -> Array<UInt8> {
    let mut t: Array<UInt8> = []
    let mut i = 0
    while i < 256 {
        t.push(UInt8(i))
        i = i + 1
    }
    let from = bytes("ACBDGHKMNSRUTWVYacbdghkmnsrutwvy")
    let to = bytes("TGVHCDMKNSYAAWBRTGVHCDMKNSYAAWBR")
    let mut k = 0
    while k < from.length {
        t[Int64(from[k])] = to[k]
        k = k + 1
    }
    return t
}

fn reverseComplement(seq: Array<UInt8>, table: Array<UInt8> where value.length >= 256) -> Array<UInt8> {
    let mut out: Array<UInt8> = []
    let mut i = seq.length - 1
    while i >= 0 {
        out.push(table[Int64(seq[i])])
        i = i - 1
    }
    return out
}

fn writeReverseComplement(seq: Array<UInt8>, table: Array<UInt8> where value.length >= 256) {
    let mut out: Array<UInt8> = []
    out.reserve(seq.length + seq.length / 60 + 1)
    let mut i = seq.length - 1
    let mut col = 0
    while i >= 0 {
        out.push(table[Int64(seq[i])])
        col = col + 1
        if col == 60 {
            out.push('\n')
            col = 0
        }
        i = i - 1
    }
    if col > 0 {
        out.push('\n')
    }
    writeStdout(out)
}

fn run() {
    let table = complementTable()
    let mut header = ""
    let mut seq: Array<UInt8> = []
    while let Some(l) = readLine() {
        if l.byteLength > 0 && l[0] == '>' {
            if header.byteLength > 0 {
                print(header)
                writeReverseComplement(seq, table)
                seq.clear()
            }
            header = l
        } else {
            seq.append(bytes(l))
        }
    }
    if header.byteLength > 0 {
        print(header)
        writeReverseComplement(seq, table)
    }
}

fn syntheticSequence(n: Int64) -> Array<UInt8> {
    let alphabet = bytes("ACGT")
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < n {
        out.push(alphabet[i % 4])
        i = i + 1
    }
    return out
}

bench "reverse-complement, 2000000 bases" {
    let table = complementTable()
    let seq = syntheticSequence(blackBox(benchOrder))
    blackBox(reverseComplement(blackBox(seq), blackBox(table)).length)
}

fn main() -> Int64 {
    run()
    return 0
}
