// File-based routing on generator imports.
import { pages } from "std/ui"
import { route, hrefUsers, hrefItems, rootPath, itemsPath } from pages("./pages")
import { contains } from "std/strpred"

fn show(method: String, path: String) {
    let r = route(Request { method: method.copy(), path: path.copy(), headers: [:], body: "" })
    print("\{method} \{path} -> \{r.status}")
}

fn main() -> Int64 {
    show("GET", "/") // 200 — home
    show("GET", "/items") // 200 — nested static
    show("GET", "/items/5") // 200 — dynamic, no loader
    show("GET", "/items/abc") // 404 — non-integer segment never reaches user code
    show("GET", "/users/7") // 200 — loader Valid
    show("GET", "/users/0") // 422 — loader Invalid renders an error page
    show("GET", "/nope") // 404 — unknown path

    print(rootPath()) // /
    print(itemsPath()) // /items
    print(hrefItems(5)) // /items/5
    print(hrefUsers(7)) // /users/7
    return 0
}

test "route matches static and dynamic paths" {
    assertEq(route(Request { method: "GET", path: "/", headers: [:], body: "" }).status, 200)
    assertEq(route(Request { method: "GET", path: "/items", headers: [:], body: "" }).status, 200)
    assertEq(route(Request { method: "GET", path: "/items/42", headers: [:], body: "" }).status, 200)
    assertEq(route(Request { method: "GET", path: "/users/7", headers: [:], body: "" }).status, 200)
}

test "a non-integer dynamic segment 404s before user code" {
    assertEq(route(Request { method: "GET", path: "/items/abc", headers: [:], body: "" }).status, 404)
    assertEq(route(Request { method: "GET", path: "/users/x", headers: [:], body: "" }).status, 404)
}

test "an unknown path 404s" {
    assertEq(route(Request { method: "GET", path: "/nope", headers: [:], body: "" }).status, 404)
    assertEq(route(Request { method: "GET", path: "/items/5/extra", headers: [:], body: "" }).status, 404)
}

test "a loader Invalid renders a 422 error page" {
    let r = route(Request { method: "GET", path: "/users/0", headers: [:], body: "" })
    assertEq(r.status, 422)
    assert(r.body.contains("no user with id 0"))
}

test "a rendered page carries its content and typed-URL helpers hold" {
    let r = route(Request { method: "GET", path: "/users/7", headers: [:], body: "" })
    assertEq(r.status, 200)
    assert(r.body.contains("User 7"))
    assert(r.body.contains("user7, age 30"))
    assertEq(hrefUsers(7), "/users/7")
    assertEq(itemsPath(), "/items")
}
