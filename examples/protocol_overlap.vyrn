// Refused on purpose: overlapping impls.

protocol Show {
    fn show(self) -> String
}

impl<T> Show for Option<T> {
    fn show(self) -> String {
        return match self {
            Some(v) => "something",
            None => "nothing",
        }
    }
}

impl Show for Option<Int64> {
    fn show(self) -> String { return "an optional number" }
}

fn main() -> Int64 {
    let a: Option<Int64> = Some(7)
    print(a.show())
    return 0
}
