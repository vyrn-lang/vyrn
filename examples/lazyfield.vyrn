// A `lazy` record field.

let mut loads = 0

type Book = { title: String, body: lazy String }

fn loadBody(id: Int64) -> String {
    loads = loads + 1
    return "body of book \{id}"
}

fn shelf() -> Array<Book> {
    let mut out: Array<Book> = []
    out.push(Book { title: "Dune", body: () -> loadBody(1) })
    out.push(Book { title: "Solaris", body: () -> loadBody(2) })
    return out
}

fn neverRead() {
    loads = 0
    let books = shelf()
    let mut titles = ""
    for b in books {
        titles = "\{titles}\{b.title};"
    }
    print("titles: \{titles}")
    print("never read -> loads = \{loads}")
}

fn readOne() {
    loads = 0
    let books = shelf()
    let first = books[0]
    print("first body: \{first.body}")
    print("read one of two -> loads = \{loads}")
}

fn readTwice() {
    loads = 0
    let b = Book { title: "Ubik", body: () -> loadBody(3) }
    print("once: \{b.body}")
    print("twice: \{b.body}")
    print("read twice -> loads = \{loads}")
}

fn capturedAtConstruction() {
    loads = 0
    let mut id = 7
    let b = Book { title: "Roadside Picnic", body: () -> loadBody(id) }
    id = 99
    print("captured: \{b.body}")
}

fn encodingForces() {
    loads = 0
    let b = Book { title: "Stalker", body: () -> loadBody(4) }
    print("json: \{toJson(b)}")
    print("toJson -> loads = \{loads}")
}

fn main() -> Int64 {
    neverRead()
    readOne()
    readTwice()
    capturedAtConstruction()
    encodingForces()
    return 0
}

test "a field never read is never computed" {
    loads = 0
    let books = shelf()
    let mut n = 0
    for b in books {
        n = n + b.title.byteLength
    }
    assert(n > 0)
    assertEq(loads, 0)
}

test "a field read once is computed once" {
    loads = 0
    let b = Book { title: "Dune", body: () -> loadBody(1) }
    assertEq(b.body, "body of book 1")
    assertEq(loads, 1)
}

test "a field read twice is computed twice" {
    loads = 0
    let b = Book { title: "Dune", body: () -> loadBody(1) }
    assertEq(b.body, "body of book 1")
    assertEq(b.body, "body of book 1")
    assertEq(loads, 2)
}

test "toJson forces every deferred field" {
    loads = 0
    let b = Book { title: "Dune", body: () -> loadBody(1) }
    assertEq(toJson(b), "{\"title\":\"Dune\",\"body\":\"body of book 1\"}")
    assertEq(loads, 1)
}
