// Validation at a field store.

type Age = Int64 where value >= 18

type Roster = { ages: Array<Age> }

let mut shared = Roster { ages: [] }

fn rt(n: Int64) -> Int64 {
    return n * 1
}

fn enroll(r: modify Roster, n: Int64) {
    r.ages.push(rt(n))
}

fn main() -> Int64 {
    let mut local = Roster { ages: [] }
    local.ages.push(rt(21))
    enroll(local, 31)
    shared.ages.push(rt(41))
    print(local.ages[0])
    print(local.ages[1])
    print(shared.ages[0])

    local.ages.push(rt(17))
    print(local.ages[2])
    return 0
}
