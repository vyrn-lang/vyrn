// A user container reclaimed like a builtin one.

protocol Owned {
    fn release(consume self)
}

type Ring = {
    label: String,
    slots: Array<Int64>
}

impl Owned for Ring {
    fn release(consume self) {
        print("release " + self.label + " (" + self.slots.length.toString() + ")")
        let slots = consume self.slots
        drop slots // the buffer goes back, once, here and nowhere else
        let label = consume self.label
        drop label
    }
}

type Tally = {
    total: Int64
}

impl Owned for Tally {
    fn release(consume self) {
        print("tally " + self.total.toString())
    }
}

fn ringOf(label: String, n: Int64) -> Ring {
    let mut slots: Array<Int64> = [] // the literal the old list never released
    let mut i = 0
    while i < n {
        slots.push(i * i)
        i = i + 1
    }
    return Ring { label: label.copy(), slots: slots }
}

fn tallyOf(n: Int64) -> Tally {
    return Tally { total: n * 10 }
}

fn inner() {
    let t = tallyOf(4)
    print("inside")
}

fn main() -> Int64 {
    let mut i = 1
    while i <= 3 {
        let r = ringOf("ring" + i.toString(), i)
        i = i + 1
    }

    inner()
    print("after")

    let last = ringOf("last", 2)
    return 0 // released on the way out of `main`
}
