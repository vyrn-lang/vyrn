// Keying a map from an array element.

fn keyList(n: Int64, prefix: String) -> Array<String> {
    let mut out: Array<String> = []
    let mut i = 0
    while i < n {
        out.push(prefix + i.toString())
        i = i + 1
    }
    return out
}

fn indexBuild(ks: Array<String>) -> Map<String, Int64> {
    let mut m: Map<String, Int64> = [:]
    let mut i = 0
    while i < ks.length {
        m[ks[i].copy()] = i
        i = i + 1
    }
    return m
}

fn loopBuild(ks: Array<String>) -> Map<String, Int64> {
    let mut m: Map<String, Int64> = [:]
    let mut i = 0
    for k in ks {
        m[k.copy()] = i * 10
        i = i + 1
    }
    return m
}

fn tally(words: Array<String>) -> Map<String, Int64> {
    let mut m: Map<String, Int64> = [:]
    for w in words {
        m[w.copy()] = match m[w] {
            Some(c) => c + 1,
            None => 1,
        }
    }
    return m
}

fn lookup(m: Map<String, Int64>, k: String) -> Int64 {
    return match m[k] {
        Some(v) => v,
        None => 0 - 1,
    }
}

fn main() -> Int64 {
    let ks = keyList(4, "key")

    let byIndex = indexBuild(ks)
    print("byIndex \{byIndex.length} \{lookup(byIndex, "key0")} \{lookup(byIndex, "key3")}")

    let byLoop = loopBuild(ks)
    print("byLoop \{byLoop.length} \{lookup(byLoop, "key0")} \{lookup(byLoop, "key3")}")

    print("array \{ks.length} \{ks[0]} \{ks[3]}")

    let mut words: Array<String> = []
    words.push("ab" + "c")
    words.push("ab" + "c")
    words.push("x" + "y")
    words.push("ab" + "c")
    let counts = tally(words)
    print("tally \{counts.length} \{lookup(counts, "abc")} \{lookup(counts, "xy")}")
    print("words \{words.length} \{words[0]} \{words[2]}")

    drop counts
    drop words
    drop byLoop
    drop byIndex
    drop ks
    return 0
}
