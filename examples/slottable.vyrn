// A generation-checked slot table from `std/slots`.

import { Slots, Handle, newSlots, insert, remove, get, count, capacity } from "std/slots"

fn main() -> Int64 {
    let mut t: Slots<Int64> = newSlots()

    let fortyTwo = 42
    let a = insert(t, fortyTwo)
    let ninetyNine = 99
    let b = insert(t, ninetyNine)
    print(get(t, a) ?? 0 - 1) // 42 — live

    let freed = remove(t, a)
    print(freed) // true
    print(get(t, a) ?? 0 - 1) // -1 — released
    print(remove(t, a)) // false — removing a dead handle is a no-op

    let seven = 7
    let c = insert(t, seven)
    print(c.slot == a.slot) // true — reused, not appended
    print(capacity(t)) // 2 — the free list did its job
    print(get(t, c) ?? 0 - 1) // 7 — the new handle reads the new value
    print(get(t, a) ?? 0 - 1) // -1 — the OLD handle, while that slot is live

    print(get(t, b) ?? 0 - 1) // 99 — untouched by any of it
    let bogus: Handle<Int64> = Handle { slot: 7, gen: 1, owner: 0 }
    print(get(t, bogus) ?? 0 - 1) // -1

    return 0
}

test "a stale handle stays dead across a reuse" {
    let mut t: Slots<Int64> = newSlots()
    let one = 1
    let a = insert(t, one)
    assertEq(get(t, a) ?? 0 - 1, 1)
    assert(remove(t, a))
    let two = 2
    let b = insert(t, two)
    assertEq(b.slot, a.slot) // same slot
    assertEq(get(t, b) ?? 0 - 1, 2)
    assertEq(get(t, a) ?? 0 - 1, 0 - 1) // same slot, older generation
}

test "remove is idempotent and does not corrupt the free list" {
    let mut t: Slots<Int64> = newSlots()
    let one = 1
    let a = insert(t, one)
    assert(remove(t, a))
    assert(!remove(t, a))
    assertEq(count(t), 0)
    let two = 2
    let b = insert(t, two)
    assertEq(b.slot, a.slot) // one slot on the list, not two
    assertEq(capacity(t), 1)
}

test "a handle from another container is not plausible, it is dead" {
    let mut a: Slots<Int64> = newSlots()
    let mut b: Slots<Int64> = newSlots()
    let one = 1
    let two = 2
    let ha = insert(a, one)
    let hb = insert(b, two)
    assertEq(ha.slot, hb.slot) // same slot number
    assertEq(ha.gen, hb.gen) // same generation
    assertEq(get(a, hb) ?? 0 - 1, 0 - 1) // and still dead
    assertEq(get(b, ha) ?? 0 - 1, 0 - 1)
}

test "many writes through the field, and the values all land" {
    let mut t: Slots<Int64> = newSlots()
    let mut i = 0
    while i < 4096 {
        let v = i
        let h = insert(t, v)
        assertEq(get(t, h) ?? 0 - 1, i)
        assert(remove(t, h))
        i = i + 1
    }
    assertEq(capacity(t), 1) // one slot, recycled 4,096 times

    let mut wide: Slots<Int64> = newSlots()
    let mut hs: Array<Handle<Int64>> = []
    let mut j = 0
    while j < 512 {
        let v = j * 3
        hs.push(insert(wide, v))
        j = j + 1
    }
    let mut k = 0
    while k < 512 {
        assertEq(get(wide, hs[k]) ?? 0 - 1, k * 3)
        k = k + 1
    }
    assertEq(capacity(wide), 512)

    let mut total = 0
    for x in wide {
        total = total + x
    }
    assertEq(total, 512 * 511 / 2 * 3)
}
