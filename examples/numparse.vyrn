// `std/num`: text into numbers.

import { parseFloat32, parseFloat64, parseInt64, parseUInt64 } from "std/num"

fn bitsOf(s: String) -> String {
    return match parseFloat64(s) {
        Some(v) => float64Bits(v).toString(),
        None => "None",
    }
}

fn shown(s: String) -> String {
    return match parseFloat64(s) {
        Some(v) => v.toString(),
        None => "None",
    }
}

fn main() -> Int64 {
    print(shown("1.5")) // 1.500000
    print(shown("-0.25")) // -0.250000
    print(shown("1e3")) // 1000.000000
    print(shown("-2.5E-1")) // -0.250000

    print(bitsOf("0.1"))
    print(bitsOf("9007199254740993"))
    print(bitsOf("9007199254740995"))
    print(bitsOf("5e-324"))
    print(bitsOf("2.4703282292062327e-324"))
    print(bitsOf("1.7976931348623157e308"))
    print(bitsOf("1.8e308"))
    print(shown("1e400")) // inf
    print(shown("-1e400")) // -inf
    print(shown("1e-400")) // 0.000000

    print(bitsOf("")) // None
    print(bitsOf("1 ")) // None
    print(bitsOf("1e")) // None
    print(bitsOf("1.2.3")) // None

    print(match parseFloat32("0.1") { Some(v) => v.toString(), None => "None" }) // 0.100000
    print(match parseFloat32("1e40") { Some(v) => v.toString(), None => "None" }) // inf
    print(match parseFloat32("1e-50") { Some(v) => v.toString(), None => "None" }) // 0.000000

    print(match parseInt64("-9223372036854775808") { Some(v) => v.toString(), None => "None" })
    print(match parseInt64("9223372036854775808") { Some(v) => v.toString(), None => "None" })
    print(match parseUInt64("18446744073709551615") { Some(v) => v.toString(), None => "None" })
    print(match parseUInt64("18446744073709551616") { Some(v) => v.toString(), None => "None" })
    return 0
}
