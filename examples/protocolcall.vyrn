// Two protocols declare `area`, so `s.area()` on a `Square` is ambiguous.
// `s::P.area()` names the protocol whose method it calls, with that
// protocol's capabilities: `Solid` consumes its tag and `Named` reads it.
type Square = { side: Int64 }

protocol Flat {
    fn area(read self) -> Int64
}

protocol Solid {
    fn area(read self) -> Int64
    fn label(read self, tag: consume String) -> String
}

protocol Named {
    fn label(read self, tag: String) -> String
}

impl Flat for Square {
    fn area(read self) -> Int64 {
        return self.side * self.side
    }
}

impl Solid for Square {
    fn area(read self) -> Int64 {
        return 6 * self.side * self.side
    }
    fn label(read self, tag: consume String) -> String {
        return tag + " cube"
    }
}

impl Named for Square {
    fn label(read self, tag: String) -> String {
        return tag + " square"
    }
}

fn surplus<T: Flat + Solid>(x: T) -> Int64 {
    return x::Solid.area() - x::Flat.area()
}

fn main() -> Int64 {
    let s = Square { side: 3 }
    print(s::Flat.area())
    print(s::Solid.area())
    print(surplus(s))
    let tag = "side " + "\{s.side}"
    print(s::Named.label(tag))
    print(s::Solid.label(tag))
    return 0
}
