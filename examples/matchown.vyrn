/// Who owns a payload that leaves its arm, and who owns a scrutinee no arm
/// kept — the two halves of one rule, and the shapes no other example reaches.
///
/// Every `match` in the rest of this corpus is over a TEMPORARY whose payload
/// leaves the arm, which is the one arrangement that was right: a call result is
/// no other binding's, so the value the arm hands out has exactly one owner. The
/// two arrangements beside it were both wrong on both compiling backends —
/// letting a payload out of a NAMED scrutinee gave one buffer two owners, and
/// keeping nothing out of a temporary one gave it none.
///
/// An arm hands its payload out two ways, and the third arrangement — the arm
/// that hands it to a CALL that consumes it, rather than naming it — is the one
/// RFC-0125 §3 M5's seventh slice found still wrong. The scrutinee kept a deep
/// release of a value the callee already owned.
///
/// The interpreter reference-counts and was right about every line here, so
/// three-way parity is the whole gate: a double free aborts the native build
/// before its output flushes and corrupts the wasm free list.

type Node =
    | Leaf(Int64)
    | Bunch(Array<Int64>, String)

/// A DECLARED release, because the program that found the third arrangement had
/// one: `std/json`'s `Json`, whose scrutinee row is a `Release` rather than a
/// structural walk.
type Wrap =
    | Empty
    | Words(Array<String>)

impl Owned for Wrap {
    fn release(consume self) {
        match consume self {
            Empty => {}
            Words(ws) => {
                drop ws
            }
        }
    }
}

type Doc = { title: String, body: String }

type Attr =
    | Cls(String)
    | Key(String)

fn emptyInts() -> Array<Int64> {
    let xs: Array<Int64> = []
    return xs
}

fn emptyStrs() -> Array<String> {
    let xs: Array<String> = []
    return xs
}

fn tag(n: Int64) -> Option<String> {
    if n > 0 {
        return Some("t-\{n}")
    }
    return None
}

fn mkNode(n: Int64) -> Node {
    if n > 0 {
        let mut xs: Array<Int64> = []
        xs.push(n)
        xs.push(n + 1)
        return Bunch(xs, "b-\{n}")
    }
    return Leaf(0)
}

fn mkDoc(n: Int64) -> Doc {
    return Doc { title: "ti-\{n}", body: "bo-\{n}" }
}

fn boxed(n: Int64) -> Option<Doc> {
    return Some(mkDoc(n))
}

fn listed(n: Int64) -> Option<Array<String>> {
    let mut xs: Array<String> = []
    xs.push("a-\{n}")
    xs.push("b-\{n}")
    return Some(xs)
}

fn nested(n: Int64) -> Option<Node> {
    return Some(mkNode(n))
}

fn width(s: String) -> Int64 {
    return Int64(s.byteLength)
}

fn words(n: Int64) -> Array<String> {
    let mut xs: Array<String> = []
    xs.push("w-\{n}")
    xs.push("x-\{n}")
    return xs
}

/// The callee an arm gives its payload to: it consumes the array and hands it
/// back, so the value has exactly one owner from the arm onward.
fn takeWords(ws: consume Array<String>) -> Array<String> {
    return ws
}

/// The give out of a `consume` PARAMETER, in RETURN position —
/// `std/openapi`'s `oaWithId`, and the shape the `$schema` fault was found on.
fn unwrapWords(w: consume Wrap) -> Array<String> {
    return match w {
        Empty => emptyStrs(),
        Words(ws) => takeWords(ws),
    }
}

/// A payload out by `return`, over a temporary — the shape a named scrutinee is
/// refused for (`rule 3`: a projection may not be returned).
fn byReturn(n: Int64) -> String {
    return match tag(n) {
        Some(s) => s,
        None => "none",
    }
}

/// The wrapped lend: a borrow put inside a constructor, stored in a local, and
/// returned. Nothing at the `return` names a place, so only the STORE can record
/// that this function hands back an element of its argument's array — and the
/// caller must then release neither the result nor a scrutinee holding it.
/// `std/html`'s `attrKey` is this function.
fn attrKey(attrs: Array<Attr>) -> Option<String> {
    let mut found: Option<String> = None
    for a in attrs {
        found = match a {
            Key(k) => Some(k.copy()),
            Cls(v) => found,
        }
    }
    return found
}

fn main() -> Int64 {
    // A payload out by `let`, from a NAMED scrutinee. The everyday unwrap-or,
    // and the one that aborted natively: `o` released the payload and `s` freed
    // it again.
    let o = tag(7)
    let s = match o {
        Some(v) => v,
        None => "miss",
    }
    print("let=\{s}")

    // The same through `if let`, assigning outward.
    let o2 = tag(9)
    let mut out = ""
    if let Some(v) = o2 {
        out = v
    }
    print("iflet=\{out}")

    // A payload that is a RECORD with owning fields.
    let dobj = boxed(3)
    let rec = match dobj {
        Some(d) => d,
        None => mkDoc(0),
    }
    print("rec=\{rec.title}/\{rec.body}")

    // A payload that is an `Array<String>`.
    let ao = listed(2)
    let arr = match ao {
        Some(a) => a,
        None => emptyStrs(),
    }
    print("arr=\{arr.length}")

    // A USER enum's payload, and a payload out of a NESTED enum. A
    // multi-payload arm binds BOTH payloads, and the one it does not hand
    // out is the arm's to finish — the consuming match takes the value, so
    // `drop` on the ignored sibling is the spelling of "I bound it, I own
    // it" (exit-residue round fifty-seven; the automatic sibling free is a
    // recorded gap for multi-binder arms).
    let nd = mkNode(5)
    let mut xs: Array<Int64> = []
    match consume nd {
        Leaf(kx) => { xs = emptyInts() }
        Bunch(vx, tx) => {
            xs = vx
            drop tx
        }
    }
    print("enum=\{xs.length}")
    let mut deep = "none"
    match nested(4) {
        Some(inner) => {
            match consume inner {
                Bunch(vy, ty) => {
                    deep = ty
                    drop vy
                }
                Leaf(ky) => { deep = "leaf" }
            }
        }
        None => {}
    }
    print("deep=\{deep}")

    // A payload out by `return`, and one as a CALL ARGUMENT.
    print("ret=\{byReturn(6)}")
    let co = boxed(7)
    let n = match co {
        Some(d) => width(d.title),
        None => 0,
    }
    print("call=\{n}")

    // The third arrangement: the arm gives its payload to a call that CONSUMES
    // it. The give is the CALL's, not the arm's, and reading only the arm's own
    // spelling left the scrutinee a deep release of a buffer the callee owned.
    // Once out of a named local, once out of a `consume` parameter in return
    // position.
    let wo = Words(words(2))
    let w1 = match wo {
        Empty => emptyStrs(),
        Words(ws) => takeWords(ws),
    }
    print("give=\{w1.length}/\{w1[0]}")
    let w2 = unwrapWords(Words(words(3)))
    print("giveret=\{w2.length}/\{w2[1]}")

    // The wrapped lend. `got` names an element `attrs` still holds, so neither
    // the binding nor the match below it may release one.
    let mut attrs: Array<Attr> = []
    attrs.push(Cls("row"))
    attrs.push(Key("k-\{1}"))
    let got = attrKey(attrs)
    let kw = match got {
        Some(v) => v.byteLength,
        None => 0,
    }
    print("lend=\{kw}/\{attrs.length}")

    // A statement-position `match` on a heap temporary, in a loop: nothing
    // leaves the arms, so the match is the scrutinee's last owner. Unfixed this
    // leaked one `Option<String>` a turn.
    let mut i = 0
    let mut sum = 0
    while i < 200 {
        let w = match tag(i + 1) {
            Some(v) => v.byteLength,
            None => 0,
        }
        sum = sum + Int64(w)
        i = i + 1
    }
    print("loop=\{sum}")

    // The same shapes through `while let`, which walks a temporary too.
    let mut j = 0
    let mut seen = 0
    while let Some(v) = tag(4 - j) {
        seen = seen + Int64(v.byteLength)
        j = j + 1
    }
    print("whilelet=\{seen}/\{j}")

    // And every one of them inside a `region`, where the arena owns what the
    // region allocated and the exit hands it back — so nothing here may free a
    // block twice.
    region {
        let mut k = 0
        let mut inner = 0
        while k < 50 {
            let w = match tag(k + 1) {
                Some(v) => v.byteLength,
                None => 0,
            }
            let r = match boxed(k) {
                Some(d) => d,
                None => mkDoc(0),
            }
            inner = inner + Int64(w) + Int64(r.title.byteLength)
            k = k + 1
        }
        print("region=\{inner}")
    }
    return 0
}
