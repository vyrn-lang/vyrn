// `tally` and `tallyBytes`.

fn main() -> Int64 {
    let mut words: Map<String, Int64> = [:]
    words.tally("ash", 2)
    words.tally("elm", 5)
    words.tally("ash", 3)
    let ash = match words["ash"] {
        Some(v) => v,
        None => 0,
    }
    print("tally \{words.length} ash \{ash}")

    let text = bytes("ababcab")
    let mut pairs: Map<String, Int64> = [:]
    let mut w: Array<UInt8> = [0, 0]
    let mut i = 0
    while i + 2 <= text.length {
        w[0] = text[i]
        w[1] = text[i + 1]
        pairs.tallyBytes(w, 1)
        i = i + 1
    }
    print("pairs \{pairs.length}")
    for k in pairs.keys() {
        let n = match pairs[k] {
            Some(v) => v,
            None => 0,
        }
        print("\{k} \{n}")
    }

    let mut runes: Map<String, Int64> = [:]
    let rune = bytes("é")
    runes.tallyBytes(rune, 1)
    runes.tallyBytes(rune, 40)
    let e = match runes["é"] {
        Some(v) => v,
        None => 0,
    }
    print("runes \{runes.length} e \{e}")

    let mut both: Map<String, Int64> = [:]
    both.tally("ash", 1)
    let ashBytes = bytes("ash")
    both.tallyBytes(ashBytes, 6)
    let sum = match both["ash"] {
        Some(v) => v,
        None => 0,
    }
    print("both \{both.length} ash \{sum}")

    let bad: Array<UInt8> = [255, 254]
    both.tallyBytes(bad, 1)
    print("unreachable")
    return 0
}
