// A `for` over an unnamed temporary, twice in one body.

fn mk(t: String) -> Array<String> {
    return [t.copy(), t.copy()]
}

fn one() {
    for a in [mk("a"), mk("b")] {
        for s in a {
            print(s)
        }
    }
}

fn two() {
    for a in [mk("c"), mk("d")] {
        print(a[0])
    }
    for a in [mk("e"), mk("f")] {
        print(a[0])
    }
}

fn main() -> Int64 {
    one()
    two()
    return 0
}
