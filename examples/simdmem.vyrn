/// Explicit SIMD, part two — memory, comparison and the four total operations
/// (RFC-0083 M2). `examples/simd.vyrn` is M1: construction, splat, lane reads
/// and lane-wise `+ - * /`.
///
///   F32x4.load(xs, i)          four consecutive Float32s of an Array<Float32>
///   F32x4.store(xs, i, v)      the same four, written back
///   a < b   a == b   a != b    lane-wise -> Mask32x4, NOT Bool
///   m.lane(k)                  one mask lane, as the Bool it is
///   m.anyTrue()  m.allTrue()  the whole mask, as one Bool
///   m & n   m | n   m ^ n   ~m   lane-wise, on two masks
///   F32x4.min/max/sqrt        (`abs` is in Vyrn here — see the note on `abs`)
///
/// **The mask combinators are `& | ^ ~`, not `&& || !`.** `&&` and `||` are
/// Vyrn's short-circuiting Bool operators — the right operand may not be
/// evaluated — and there is nothing to short-circuit in four lanes computed at
/// once, so borrowing that spelling would advertise a property the operation
/// does not have. The bitwise family promises only "both sides, always", which
/// is what this is; it is also already how a mask is stored on both backends.
/// `!` stays the Bool operator for the same reason `~` is not one.
///
/// **The bounds check is emitted ONCE for the whole vector**, not once per lane,
/// and that single check is most of what a vector load buys over a scalar loop —
/// a loop cannot amortise its own bounds test. `examples/simdoob.vyrn` and
/// `examples/simdoobstore.vyrn` pin the two branches of the trap.
///
/// **`min`/`max` are IEEE-754-2019 `minimum`/`maximum`: NaN in either operand
/// propagates, and `-0.0` orders below `+0.0`.** That is wasm's `f32x4.min`
/// rule. It is NOT `minNum`, which is what LLVM's `llvm.minnum` and Rust's
/// `f32::min` do — they return the non-NaN operand. Nothing here is left to a
/// host default: native calls `llvm.minimum` and the interpreter spells the rule
/// out, because unlike a NaN PAYLOAD difference (which M1 found unobservable,
/// the formatter answering `NaN` for all of them) a `min(NaN, 1.0)` that answers
/// `1.000000` on one engine and `NaN` on another survives the formatter intact.
///
/// A mask is its own type rather than an `I32x4` of all-ones/all-zeros. The bit
/// pattern IS that on both backends; what the type buys is that no program can
/// build a lane that is neither, which is the case the three engines have no
/// agreed answer for.
///
/// There is deliberately no `F32x4.select` builtin. Written in Vyrn on
/// `m.lane(k)` and `if` it measured 1.1x native and 1.06x wasm — both optimizers
/// turn the four branches back into a blend — so by RFC-0078's bar it had no
/// reason to be a primitive. `examples/simdbench.vyrn`'s `selectV` is both the
/// measurement and the replacement.

fn lanes(v: F32x4) {
    print(v.lane(0))
    print(v.lane(1))
    print(v.lane(2))
    print(v.lane(3))
}

/// A mask crosses a function boundary here, which is the ABI half — the same
/// thing `lanes` does for `F32x4` in `simd.vyrn`.
fn mlanes(m: Mask32x4) {
    print(m.lane(0))
    print(m.lane(1))
    print(m.lane(2))
    print(m.lane(3))
}

/// Both reductions of one mask, `anyTrue` first — the mask crosses a function
/// boundary on the way in, as it does for `mlanes`.
fn reduce(m: Mask32x4) {
    print(m.anyTrue())
    print(m.allTrue())
}

/// Lane *i* from `a` where the mask's lane *i* is true, from `b` where it is
/// not — a user function, because the measurement said it should be one.
fn select(m: Mask32x4, a: F32x4, b: F32x4) -> F32x4 {
    return F32x4(
        if m.lane(0) { a.lane(0) } else { b.lane(0) },
        if m.lane(1) { a.lane(1) } else { b.lane(1) },
        if m.lane(2) { a.lane(2) } else { b.lane(2) },
        if m.lane(3) { a.lane(3) } else { b.lane(3) },
    )
}

/// The sign bit cleared, NaN included — the BITS and not a comparison, since
/// `if x < 0.0` gets `-0.0` wrong. A user function, for `select`'s reason: the
/// builtin measured 1.00x native and 1.07x wasm against exactly this spelling
/// (RFC-0083 M4). `Float32` -> `Float64` is exact, so the widen/mask/narrow
/// round-trip loses nothing on the way there or back.
fn abs(v: F32x4) -> F32x4 {
    let mask: UInt64 = 9223372036854775807
    return F32x4(
        Float32(floatFromBits(floatBits(Float64(v.lane(0))) & mask)),
        Float32(floatFromBits(floatBits(Float64(v.lane(1))) & mask)),
        Float32(floatFromBits(floatBits(Float64(v.lane(2))) & mask)),
        Float32(floatFromBits(floatBits(Float64(v.lane(3))) & mask)),
    )
}

fn main() -> Int64 {
    // ---- load and store --------------------------------------------------
    let xs: Array<Float32> = [10.0, 11.0, 12.0, 13.0, 14.0, 15.0, 16.0]
    lanes(F32x4.load(xs, 0)) // 10 11 12 13
    lanes(F32x4.load(xs, 3)) // 13 14 15 16   (the last index that fits)

    // A store writes four elements and leaves the rest alone, which is what
    // reading the whole array back afterwards is for.
    F32x4.store(xs, 2, F32x4(1.0, 2.0, 3.0, 4.0))
    for x in xs {
        print(x) // 10 11 1 2 3 4 16
    }
    // Round-trip: what was stored is what loads back, at an unaligned offset —
    // the buffer is an array of `float`, so a 16-byte access at element 2 is
    // 8-byte aligned at best and neither backend may claim otherwise.
    lanes(F32x4.load(xs, 2)) // 1 2 3 4

    // ---- the values the engines are supposed to disagree about -----------
    // Built by arithmetic, as in `simd.vyrn`: there is no NaN or infinity
    // literal, and a runtime division also stops `consteval` folding the answer
    // with the compiler's arithmetic instead of the engine's.
    let z: Float32 = 0.0
    let o: Float32 = 1.0
    let neg = z - o
    let nan = z / z
    let inf = o / z
    let ninf = neg / z
    let nzero = neg * z
    let e: Float32 = 0.00000000000000000001
    let sub = e * e

    // ---- comparison: NaN in every operand position -----------------------
    // Lane 0 has NaN on the left, lane 1 on the right, lane 2 on both, lane 3
    // on neither. Under IEEE the four relational operators and `==` are ORDERED
    // — false whenever either operand is NaN — and `!=` is UNORDERED, so
    // `NaN != NaN` is TRUE. This is the pair RFC-0081 had to correct at scalar
    // width (native's `fcmp one` answered the ordered thing for `!=`), so it is
    // pinned here rather than assumed to have been inherited.
    let l = F32x4(nan, o, nan, o)
    let r = F32x4(o, nan, nan, o)
    mlanes(l < r) // false false false false
    mlanes(l <= r) // false false false true
    mlanes(l > r) // false false false false
    mlanes(l >= r) // false false false true
    mlanes(l == r) // false false false true
    mlanes(l != r) // true  true  true  false

    // `-0.0 == 0.0` is TRUE and `-0.0 < 0.0` is FALSE: the sign of zero is not
    // an ordering, which is exactly why `min` below needs its own rule for it.
    mlanes(F32x4(nzero, nzero, z, ninf) == F32x4(z, nzero, nzero, ninf)) // all true
    mlanes(F32x4(nzero, inf, ninf, sub) < F32x4(z, inf, ninf, sub)) // all false

    // ---- combining masks: the two-condition predicate ---------------------
    // `edgeLo < mid && mid < edgeHi` per lane, which is what no amount of `anyTrue`
    // could express before — a mask could be produced and reduced but never
    // combined.
    let mid = F32x4(0.5, 1.5, 2.5, 3.5)
    let edgeLo = F32x4.splat(1.0)
    let edgeHi = F32x4.splat(3.0)
    mlanes((edgeLo < mid) & (mid < edgeHi)) // false true true false
    mlanes((mid < edgeLo) | (edgeHi < mid)) // true false false true
    // De Morgan holds lane-wise, which is the pin that `~` complements each lane
    // rather than the whole vector: a whole-vector negation would still satisfy
    // it for all-true and all-false and diverge exactly here.
    mlanes(~((edgeLo < mid) & (mid < edgeHi))) // true false false true
    mlanes(~(edgeLo < mid) | ~(mid < edgeHi)) // true false false true
    // `^` is the lane-wise disagreement, so a mask against itself is empty and a
    // mask against its complement is full — the two answers that would coincide
    // if `^` had been wired to `&` or `|` by mistake.
    mlanes((edgeLo < mid) ^ (edgeLo < mid)) // all false
    mlanes((edgeLo < mid) ^ ~(edgeLo < mid)) // all true
    // NaN in every operand position, through the combinators. `nv != nv` is the
    // all-true mask and `nv == nv` the all-false one, so this is also the
    // identity check: `m & all` is `m`, `m | none` is `m`.
    let nv = F32x4.splat(nan)
    let all = nv != nv
    let none = nv == nv
    mlanes((l < r) | (l != r)) // true true true false
    mlanes((l >= r) & (l != r)) // all false   (ordered and unordered disagree)
    mlanes((l == r) ^ (l != r)) // all true    (exactly one holds, NaN or not)
    mlanes((l != r) & all) // true true true false
    mlanes((l != r) | none) // true true true false
    mlanes(~all) // all false
    // A combined mask reduces like any other, which is the point of having both.
    reduce(((edgeLo < mid) & (mid < edgeHi))) // true false
    reduce(~((edgeLo < mid) | (mid < edgeHi))) // false false

    // ---- the reductions: did any lane pass, did every lane -----------------
    // `anyTrue` lowers to `v128.any_true`, which is WHOLE-VECTOR (any bit set
    // anywhere) rather than per lane, while `allTrue` is `i32x4.all_true` and is
    // per lane. The two coincide only because a `Mask32x4` lane is all-ones or
    // all-zeros and no program can build one that is neither — the same closed
    // set of inhabitants that let the mask be its own type. Native reduces an
    // `icmp ne` instead, which is per lane at both widths, so a mask that ever
    // held a partial lane would split the engines here first.
    let t = F32x4.splat(o) == F32x4.splat(o)
    let f = F32x4.splat(o) < F32x4.splat(o)
    reduce(t) // true  true
    reduce(f) // false false

    // One true lane at a time, then one false lane at a time. This is the pin
    // for lane order and lane WIDTH: a reduction that read the vector at the
    // wrong lane width would still answer correctly for all-true and all-false
    // and only diverge here.
    let hi = F32x4(4.0, 3.0, 2.0, 1.0)
    let lo = F32x4(1.0, 2.0, 3.0, 4.0)
    reduce(hi == lo) // false false   (no lane: 4 3 2 1 vs 1 2 3 4)
    reduce(F32x4(1.0, 9.0, 9.0, 9.0) == lo) // true  false
    reduce(F32x4(9.0, 2.0, 9.0, 9.0) == lo) // true  false
    reduce(F32x4(9.0, 9.0, 3.0, 9.0) == lo) // true  false
    reduce(F32x4(9.0, 9.0, 9.0, 4.0) == lo) // true  false
    reduce(F32x4(9.0, 2.0, 3.0, 4.0) == lo) // true  false
    reduce(F32x4(1.0, 9.0, 3.0, 4.0) == lo) // true  false
    reduce(F32x4(1.0, 2.0, 9.0, 4.0) == lo) // true  false
    reduce(F32x4(1.0, 2.0, 3.0, 9.0) == lo) // true  false

    // NaN in every operand position, through the operators whose answers it
    // changes. A mask off a NaN comparison is not empty — `NaN != NaN` is true —
    // so these carry real content into the reduction rather than reducing zero.
    reduce(nv != nv) // true  true    (unordered: every lane true)
    reduce(nv == nv) // false false
    reduce(nv < nv) // false false
    reduce(l < r) // false false   NaN left, right, both, neither
    reduce(l != r) // true  false
    reduce(l == r) // true  false   (only lane 3, where neither is NaN)
    reduce(l >= r) // true  false
    // Infinities and signed zero reduce like any other ordered comparison.
    reduce(F32x4(inf, ninf, nzero, sub) == F32x4(inf, ninf, z, sub)) // true true
    reduce(F32x4(inf, ninf, nzero, sub) < F32x4(inf, ninf, z, sub)) // false false

    // The reduction is a `Bool` like any other, so it is what `if` and `&&` take
    // — which is the whole point of having it rather than four `lane` reads.
    if (l != r).anyTrue() && !(l != r).allTrue() {
        print("some but not all")
    }

    // ---- select, in the language rather than in the compiler --------------
    // What a mask is FOR, and it needs no builtin: `m.lane(k)` is a `Bool`, `if`
    // is an expression (RFC-0030), and both optimizers put the four branches
    // back together into one blend. `examples/simdbench.vyrn` is the number.
    lanes(select(l != r, l, r)) // NaN NaN NaN 1
    lanes(select(F32x4(o, neg, o, neg) > F32x4.splat(z), F32x4.splat(7.0), F32x4.splat(8.0)))

    // ---- min / max: the NaN rule, stated and checked ---------------------
    lanes(F32x4.min(l, r)) // NaN NaN NaN 1   (NaN PROPAGATES, it is not skipped)
    lanes(F32x4.max(l, r)) // NaN NaN NaN 1
    lanes(F32x4.min(F32x4(o, neg, inf, ninf), F32x4(neg, o, ninf, inf))) // -1 -1 -inf -inf
    lanes(F32x4.max(F32x4(o, neg, inf, ninf), F32x4(neg, o, ninf, inf))) //  1  1  inf  inf
    // `-0.0` below `+0.0`, in both argument orders — the half of the rule that
    // a naive `if a < b` gets wrong, since `-0.0 < 0.0` is false.
    lanes(F32x4.min(F32x4(nzero, z, nzero, z), F32x4(z, nzero, nzero, z))) // -0 -0 -0 0
    lanes(F32x4.max(F32x4(nzero, z, nzero, z), F32x4(z, nzero, nzero, z))) //  0  0 -0 0
    lanes(F32x4.min(F32x4.splat(sub), F32x4(z, sub, nzero, inf))) // 0 sub -0 sub

    // ---- abs / sqrt ------------------------------------------------------
    // `abs` clears the sign bit — a bit operation, so there is no NaN question,
    // and no builtin either: it is `abs` above, in Vyrn.
    lanes(abs(F32x4(neg, nzero, ninf, nan))) // 1 0 inf NaN
    // `sqrt` of a negative is NaN, of `-0.0` is `-0.0` (IEEE keeps the sign),
    // and of a subnormal is not flushed to zero on any of the three.
    lanes(F32x4.sqrt(F32x4(4.0, neg, nzero, inf))) // 2 NaN -0 inf
    lanes(F32x4.sqrt(F32x4(sub, nan, z, 2.0))) // ~1e-20 NaN 0 1.414214
    // 0.999997, not 1: `sub` is subnormal, so it carries fewer mantissa bits
    // than `e` did and the square root cannot recover them. The digits are the
    // point — an engine that flushed denormals would print `0.000000` here, and
    // the three agreeing on 0.999997 says none of them does.
    print(F32x4.sqrt(F32x4.splat(sub)).lane(0) / e)

    return 0
}
