// SIMD memory, comparison and the total operations.

fn lanes(v: F32x4) {
    print(v.lane(0))
    print(v.lane(1))
    print(v.lane(2))
    print(v.lane(3))
}

fn mlanes(m: Mask32x4) {
    print(m.lane(0))
    print(m.lane(1))
    print(m.lane(2))
    print(m.lane(3))
}

fn reduce(m: Mask32x4) {
    print(m.anyTrue())
    print(m.allTrue())
}

fn select(m: Mask32x4, a: F32x4, b: F32x4) -> F32x4 {
    return F32x4(
        if m.lane(0) { a.lane(0) } else { b.lane(0) },
        if m.lane(1) { a.lane(1) } else { b.lane(1) },
        if m.lane(2) { a.lane(2) } else { b.lane(2) },
        if m.lane(3) { a.lane(3) } else { b.lane(3) },
    )
}

fn abs(v: F32x4) -> F32x4 {
    let mask: UInt64 = 9223372036854775807
    return F32x4(
        Float32(float64FromBits(float64Bits(Float64(v.lane(0))) & mask)),
        Float32(float64FromBits(float64Bits(Float64(v.lane(1))) & mask)),
        Float32(float64FromBits(float64Bits(Float64(v.lane(2))) & mask)),
        Float32(float64FromBits(float64Bits(Float64(v.lane(3))) & mask)),
    )
}

fn main() -> Int64 {
    let xs: Array<Float32> = [10.0, 11.0, 12.0, 13.0, 14.0, 15.0, 16.0]
    lanes(F32x4.load(xs, 0)) // 10 11 12 13
    lanes(F32x4.load(xs, 3)) // 13 14 15 16   (the last index that fits)

    F32x4.store(xs, 2, F32x4(1.0, 2.0, 3.0, 4.0))
    for x in xs {
        print(x) // 10 11 1 2 3 4 16
    }
    lanes(F32x4.load(xs, 2)) // 1 2 3 4

    let z: Float32 = 0.0
    let o: Float32 = 1.0
    let neg = z - o
    let nan = z / z
    let inf = o / z
    let ninf = neg / z
    let nzero = neg * z
    let e: Float32 = 0.00000000000000000001
    let sub = e * e

    let l = F32x4(nan, o, nan, o)
    let r = F32x4(o, nan, nan, o)
    mlanes(l < r) // false false false false
    mlanes(l <= r) // false false false true
    mlanes(l > r) // false false false false
    mlanes(l >= r) // false false false true
    mlanes(l == r) // false false false true
    mlanes(l != r) // true  true  true  false

    mlanes(F32x4(nzero, nzero, z, ninf) == F32x4(z, nzero, nzero, ninf)) // all true
    mlanes(F32x4(nzero, inf, ninf, sub) < F32x4(z, inf, ninf, sub)) // all false

    let mid = F32x4(0.5, 1.5, 2.5, 3.5)
    let edgeLo = F32x4.splat(1.0)
    let edgeHi = F32x4.splat(3.0)
    mlanes((edgeLo < mid) & (mid < edgeHi)) // false true true false
    mlanes((mid < edgeLo) | (edgeHi < mid)) // true false false true
    mlanes(~((edgeLo < mid) & (mid < edgeHi))) // true false false true
    mlanes(~(edgeLo < mid) | ~(mid < edgeHi)) // true false false true
    mlanes((edgeLo < mid) ^ (edgeLo < mid)) // all false
    mlanes((edgeLo < mid) ^ ~(edgeLo < mid)) // all true
    let nv = F32x4.splat(nan)
    let all = nv != nv
    let none = nv == nv
    mlanes((l < r) | (l != r)) // true true true false
    mlanes((l >= r) & (l != r)) // all false   (ordered and unordered disagree)
    mlanes((l == r) ^ (l != r)) // all true    (exactly one holds, NaN or not)
    mlanes((l != r) & all) // true true true false
    mlanes((l != r) | none) // true true true false
    mlanes(~all) // all false
    reduce(((edgeLo < mid) & (mid < edgeHi))) // true false
    reduce(~((edgeLo < mid) | (mid < edgeHi))) // false false

    let t = F32x4.splat(o) == F32x4.splat(o)
    let f = F32x4.splat(o) < F32x4.splat(o)
    reduce(t) // true  true
    reduce(f) // false false

    let hi = F32x4(4.0, 3.0, 2.0, 1.0)
    let lo = F32x4(1.0, 2.0, 3.0, 4.0)
    reduce(hi == lo) // false false   (no lane: 4 3 2 1 vs 1 2 3 4)
    reduce(F32x4(1.0, 9.0, 9.0, 9.0) == lo) // true  false
    reduce(F32x4(9.0, 2.0, 9.0, 9.0) == lo) // true  false
    reduce(F32x4(9.0, 9.0, 3.0, 9.0) == lo) // true  false
    reduce(F32x4(9.0, 9.0, 9.0, 4.0) == lo) // true  false
    reduce(F32x4(9.0, 2.0, 3.0, 4.0) == lo) // true  false
    reduce(F32x4(1.0, 9.0, 3.0, 4.0) == lo) // true  false
    reduce(F32x4(1.0, 2.0, 9.0, 4.0) == lo) // true  false
    reduce(F32x4(1.0, 2.0, 3.0, 9.0) == lo) // true  false

    reduce(nv != nv) // true  true    (unordered: every lane true)
    reduce(nv == nv) // false false
    reduce(nv < nv) // false false
    reduce(l < r) // false false   NaN left, right, both, neither
    reduce(l != r) // true  false
    reduce(l == r) // true  false   (only lane 3, where neither is NaN)
    reduce(l >= r) // true  false
    reduce(F32x4(inf, ninf, nzero, sub) == F32x4(inf, ninf, z, sub)) // true true
    reduce(F32x4(inf, ninf, nzero, sub) < F32x4(inf, ninf, z, sub)) // false false

    if (l != r).anyTrue() && !(l != r).allTrue() {
        print("some but not all")
    }

    lanes(select(l != r, l, r)) // NaN NaN NaN 1
    lanes(select(F32x4(o, neg, o, neg) > F32x4.splat(z), F32x4.splat(7.0), F32x4.splat(8.0)))

    lanes(F32x4.min(l, r)) // NaN NaN NaN 1   (NaN PROPAGATES, it is not skipped)
    lanes(F32x4.max(l, r)) // NaN NaN NaN 1
    lanes(F32x4.min(F32x4(o, neg, inf, ninf), F32x4(neg, o, ninf, inf))) // -1 -1 -inf -inf
    lanes(F32x4.max(F32x4(o, neg, inf, ninf), F32x4(neg, o, ninf, inf))) //  1  1  inf  inf
    lanes(F32x4.min(F32x4(nzero, z, nzero, z), F32x4(z, nzero, nzero, z))) // -0 -0 -0 0
    lanes(F32x4.max(F32x4(nzero, z, nzero, z), F32x4(z, nzero, nzero, z))) //  0  0 -0 0
    lanes(F32x4.min(F32x4.splat(sub), F32x4(z, sub, nzero, inf))) // 0 sub -0 sub

    lanes(abs(F32x4(neg, nzero, ninf, nan))) // 1 0 inf NaN
    lanes(F32x4.sqrt(F32x4(4.0, neg, nzero, inf))) // 2 NaN -0 inf
    lanes(F32x4.sqrt(F32x4(sub, nan, z, 2.0))) // ~1e-20 NaN 0 1.414214
    print(F32x4.sqrt(F32x4.splat(sub)).lane(0) / e)

    return 0
}
