// mandelbrot, from the Computer Language Benchmarks Game.

let order = 200

fn ascii(s: String) -> Array<UInt8> {
    return bytes(s)
}

fn main() -> Int64 {
    let n = order
    writeStdout(ascii("P4\n\{n} \{n}\n"))

    let mut y = 0
    while y < n {
        let ci = 2.0 * Float64(y) / Float64(n) - 1.0
        let mut row: Array<UInt8> = []
        let mut bits = 0
        let mut nbits = 0
        let mut x = 0
        while x < n {
            let cr = 2.0 * Float64(x) / Float64(n) - 1.5
            let mut zr = 0.0
            let mut zi = 0.0
            let mut inside = 1
            let mut i = 0
            while i < 50 {
                let nzr = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = nzr
                if zr * zr + zi * zi > 4.0 {
                    inside = 0
                    i = 50
                } else {
                    i = i + 1
                }
            }
            bits = bits * 2 + inside
            nbits = nbits + 1
            if nbits == 8 {
                row.push(UInt8(bits))
                bits = 0
                nbits = 0
            }
            x = x + 1
        }
        if nbits > 0 {
            let mut pad = nbits
            while pad < 8 {
                bits = bits * 2
                pad = pad + 1
            }
            row.push(UInt8(bits))
        }
        writeStdout(row)
        y = y + 1
    }
    return 0
}
