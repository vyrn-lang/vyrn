// `Stream<T>`.

fn feed(n: Int64) -> Stream<Int64> {
    let mut xs: Array<Int64> = []
    let mut i = 0
    while i < n {
        xs.push(i * 10)
        i = i + 1
    }
    return fromArray(xs)
}

fn relay(n: Int64) -> Stream<Int64> {
    let s = feed(n)
    return s
}

fn total(s: Stream<Int64>) -> Int64 {
    let mut sum = 0
    for v in s {
        sum = sum + v
    }
    return sum
}

fn main() -> Int64 {
    for v in feed(3) {
        print(v) // 0 10 20
    }

    for v in feed(5) {
        if v > 20 {
            break
        }
        print(v) // 0 10 20
    }

    print(total(relay(4))) // 0 + 10 + 20 + 30 = 60

    let unread = feed(9)
    close(unread)
    print(-1)

    let s = feed(2)
    if 1 == 1 {
        close(s)
        print(-2)
    } else {
        close(s)
    }

    return 0
}
