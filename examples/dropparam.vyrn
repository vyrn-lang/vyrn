// `drop` on a bare type parameter is refused.
//
// Letting the instance decide would launder the record rule: a generic
// trampoline could drop a plain record that `drop` refuses directly. No
// instance check runs on a generic body, so the gate is at the `drop` itself.
fn toss<T>(v: consume T) -> Int64 {
    drop v
    return 0
}

fn main() -> Int64 {
    let n = toss("abc")
    return n
}
