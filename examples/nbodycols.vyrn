/// `nbody.vyrn` on a column layout: `std/columns` holds the bodies as one
/// array per field, and the integration reads `b.x[i]` where `nbody.vyrn`
/// reads `b[i].x`. The output is `nbody.vyrn`'s, byte for byte.
///
///     vyrn run examples/nbodycols.vyrn

import { Body } from "./lib/bodies"
import { columns } from "std/columns"
import { BodyColumns, bodyColumns, pushBody } from columns("./lib/bodies")

let steps = 1000

fn sqrtF(v: Float64) -> Float64 {
    return F64x2.sqrt(F64x2(v, v)).lane(0)
}

fn fixed9(v: Float64) -> String {
    let mut a = v
    let mut sign = ""
    if a < 0.0 {
        sign = "-"
        a = 0.0 - a
    }
    let scaled = Int64(a * 1000000000.0 + 0.5)
    let whole = scaled / 1000000000
    let mut frac = "\{scaled % 1000000000}"
    while frac.byteLength < 9 {
        frac = "0\{frac}"
    }
    return "\{sign}\{whole}.\{frac}"
}

fn solarMass() -> Float64 {
    return 4.0 * 3.141592653589793 * 3.141592653589793
}

fn system() -> BodyColumns {
    let sm = solarMass()
    let dy = 365.24
    let mut b = bodyColumns(5)
    pushBody(b, Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: sm })
    pushBody(b, Body {
        x: 4.84143144246472090,
        y: -1.16032004402742839,
        z: -0.103622044471123109,
        vx: 0.00166007664274403694 * dy,
        vy: 0.00769901118419740425 * dy,
        vz: -0.0000690460016972063023 * dy,
        mass: 0.000954791938424326609 * sm,
    })
    pushBody(b, Body {
        x: 8.34336671824457987,
        y: 4.12479856412430479,
        z: -0.403523417114321381,
        vx: -0.00276742510726862411 * dy,
        vy: 0.00499852801234917238 * dy,
        vz: 0.0000230417297573763929 * dy,
        mass: 0.000285885980666130812 * sm,
    })
    pushBody(b, Body {
        x: 12.8943695621391310,
        y: -15.1111514016986312,
        z: -0.223307578892655734,
        vx: 0.00296460137564761618 * dy,
        vy: 0.00237847173959480950 * dy,
        vz: -0.0000296589568540237556 * dy,
        mass: 0.0000436624404335156298 * sm,
    })
    pushBody(b, Body {
        x: 15.3796971148509165,
        y: -25.9193146099879641,
        z: 0.179258772950371181,
        vx: 0.00268067772490389322 * dy,
        vy: 0.00162824170038242295 * dy,
        vz: -0.0000951592254519715870 * dy,
        mass: 0.0000515138902046611451 * sm,
    })
    return b
}

fn offsetMomentum(bodies: consume BodyColumns) -> BodyColumns {
    let mut b = bodies
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    let mut i = 0
    while i < b.x.length {
        px = px + b.vx[i] * b.mass[i]
        py = py + b.vy[i] * b.mass[i]
        pz = pz + b.vz[i] * b.mass[i]
        i = i + 1
    }
    b.vx[0] = 0.0 - px / solarMass()
    b.vy[0] = 0.0 - py / solarMass()
    b.vz[0] = 0.0 - pz / solarMass()
    return b
}

fn energy(b: BodyColumns) -> Float64 {
    let n = b.x.length
    let mut e = 0.0
    let mut i = 0
    while i < n {
        e = e + 0.5 * b.mass[i] * (b.vx[i] * b.vx[i] + b.vy[i] * b.vy[i] + b.vz[i] * b.vz[i])
        let mut j = i + 1
        while j < n {
            let dx = b.x[i] - b.x[j]
            let dy = b.y[i] - b.y[j]
            let dz = b.z[i] - b.z[j]
            e = e - b.mass[i] * b.mass[j] / sqrtF(dx * dx + dy * dy + dz * dz)
            j = j + 1
        }
        i = i + 1
    }
    return e
}

fn advance(bodies: consume BodyColumns, dt: Float64) -> BodyColumns {
    let mut b = bodies
    let n = b.x.length
    let mut i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let dx = b.x[i] - b.x[j]
            let dy = b.y[i] - b.y[j]
            let dz = b.z[i] - b.z[j]
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrtF(d2))
            let mi = b.mass[i]
            let mj = b.mass[j]
            b.vx[i] = b.vx[i] - dx * mj * mag
            b.vy[i] = b.vy[i] - dy * mj * mag
            b.vz[i] = b.vz[i] - dz * mj * mag
            b.vx[j] = b.vx[j] + dx * mi * mag
            b.vy[j] = b.vy[j] + dy * mi * mag
            b.vz[j] = b.vz[j] + dz * mi * mag
            j = j + 1
        }
        i = i + 1
    }
    let mut k = 0
    while k < n {
        b.x[k] = b.x[k] + dt * b.vx[k]
        b.y[k] = b.y[k] + dt * b.vy[k]
        b.z[k] = b.z[k] + dt * b.vz[k]
        k = k + 1
    }
    return b
}

fn integrate(n: Int64) -> Float64 {
    let mut b = offsetMomentum(system())
    let mut i = 0
    while i < n {
        b = advance(b, 0.01)
        i = i + 1
    }
    return energy(b)
}

fn main() -> Int64 {
    print(fixed9(energy(offsetMomentum(system()))))
    print(fixed9(integrate(steps)))
    return 0
}
