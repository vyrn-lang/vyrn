// Vyrn Object Notation.
import { vonModule } from "./lib/gen_von"
import { configTypeName, configFieldNames, configText } from vonModule("./vondemo.von")

export type Port = Int64 where value >= 1 && value <= 65535

export type Level = enum { Debug, Info, Warn, Error }

export type AppConfig = {
    name: String,
    port: Port,
    workers: Option<Int64>,
    tls: Tls,
    level: Level,
    hosts: Array<String>,
    limits: Map<String, Int64>,
}

export type TlsFiles = { cert: String, key: String }

export type Tls = enum { Disabled, Enabled(TlsFiles) }

fn main() -> Int64 {
    print(configTypeName())
    print(configFieldNames())
    print(configText())
    return 0
}
