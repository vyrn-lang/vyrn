// Union-find that tests every index a caller passes.

type Forest = { parent: Array<Int64>, size: Array<Int64> }

fn forest(n: Int64) -> Forest {
    let mut f = Forest { parent: [], size: [] }
    let mut i = 0
    while i < n {
        f.parent.push(i)
        f.size.push(1)
        i = i + 1
    }
    return f
}

fn find(f: modify Forest, x: Int64) -> Int64 {
    if x < 0 || x >= f.parent.length {
        return x
    }
    let mut r = x
    while f.parent[r] != r {
        f.parent[r] = f.parent[f.parent[r]]
        r = f.parent[r]
    }
    return r
}

fn union(f: modify Forest, a: Int64, b: Int64) {
    let ra = find(f, a)
    let rb = find(f, b)
    if ra == rb || ra < 0 || rb < 0 || ra >= f.parent.length || rb >= f.parent.length || ra >= f.size.length || rb >= f.size.length {
        return
    }
    if f.size[ra] < f.size[rb] {
        f.parent[ra] = rb
        f.size[rb] = f.size[rb] + f.size[ra]
    } else {
        f.parent[rb] = ra
        f.size[ra] = f.size[ra] + f.size[rb]
    }
}

fn main() -> Int64 {
    let n = 2000
    let mut f = forest(n)
    let mut i = 0
    while i < n {
        union(f, i, (i * 37 + 11) % n)
        i = i + 1
    }
    let mut roots = 0
    let mut k = 0
    while k < n {
        if find(f, k) == k {
            roots = roots + 1
        }
        k = k + 1
    }
    print(roots)
    return 0
}
