// Every rule of std/args.

import { cli, flag, opt, positionals, rest } from "std/args"

fn showOpt(name: String, v: Option<String>) -> Int64 {
    if let Some(s) = v {
        print("\{name}=\{s}")
    } else {
        print("\{name}=none")
    }
    return 0
}

fn main() -> Int64 {
    let a = cli()

    print("verbose=\{flag(a, "--verbose")}")
    print("quiet=\{flag(a, "--quiet")}")

    showOpt("name", opt(a, "--name"))
    showOpt("miss", opt(a, "--miss"))
    showOpt("dup", opt(a, "--dup"))

    let count = match opt(a, "--count") {
        Some(s) => match parse(s) {
            Some(n) => n,
            None => 0,
        },
        None => 0,
    }
    print("count=\{count}")

    print("positionals:")
    for p in positionals(a) {
        print("- \{p}")
    }

    print("rest:")
    for r in rest(a, "--") {
        print("- \{r}")
    }

    print("countdown:")
    let mut c = count
    let mut printed = 0
    while c > 0 {
        if printed == 2 {
            break
        }
        print("\{c}")
        c = c - 1
        printed = printed + 1
    }

    return 0
}
