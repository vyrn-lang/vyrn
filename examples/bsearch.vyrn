// A binary search whose index reads the compiler proves. `half` bounds half
// a positive width by the width and by the array's length, and `mid` states
// that its `lo` is in range, so `lo + q` is an exact sum the prover reads.

fn half(d: Int64 where value >= 1, n: Int64 where value >= d) -> Int64 where value >= 0 && value < d && value < n {
    return d / 2
}

fn mid(xs: Array<Int64>, lo: Int64 where value >= 0 && value < xs.length, hi: Int64 where value > lo && value <= xs.length) -> Int64 where value >= lo && value < hi && value < xs.length {
    let q = half(hi - lo, xs.length)
    return lo + q
}

export fn bsearch(xs: Array<Int64>, v: Int64) -> Int64 {
    let mut lo = 0
    let mut hi = xs.length
    while lo < hi {
        let m = mid(xs, lo, hi)
        if xs[m] < v {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo
}

fn main() -> Int64 {
    let mut xs: Array<Int64> = []
    xs.push(1)
    xs.push(3)
    xs.push(5)
    xs.push(7)
    print(bsearch(xs, 7).toString())
    print(bsearch(xs, 4).toString())
    print(bsearch(xs, 0).toString())
    return 0
}
