// `listDir` and `listDirKinds`.
fn show(label: String, listed: Result<Array<String>, String>) {
    match listed {
        Ok(names) => {
            print("\{label}: \{names.length} entries")
            for name in names {
                print("  \{name}")
            }
        }
        Err(e) => print("\{label}: \{e}")
    }
}

fn main() -> Int64 {
    show("themes", listDir("data/themes"))
    show("pages", listDirKinds("pages"))
    show("missing", listDir("no-such-dir"))
    return 0
}
