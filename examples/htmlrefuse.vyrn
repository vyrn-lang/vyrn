// std/html refuses an attribute name it cannot render safely, so the run traps.
import { el, text, attr, toHtmlString } from "std/html"

fn untrusted() -> String {
    return "\" onload=\"alert(1)"
}

fn main() -> Int64 {
    print(toHtmlString(el("p", [attr("title", untrusted())], [text("still fine")])))
    print(toHtmlString(el("input", [attr("data-" + "field", "q")], [])))
    print(toHtmlString(el("img", [attr("src" + untrusted(), "/logo.png")], [])))
    return 0
}
