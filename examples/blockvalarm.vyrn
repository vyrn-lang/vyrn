// RFC-0118's containment: a `match` used as a VALUE keeps single-expression
// arms. A block arm in expression position is refused by name, because a
// block yields nothing a value position could consume.
fn main() -> Int64 {
    let x = match Some(1) {
        Some(n) => n,
        None => {
            print("none")
        }
    }
    return x
}
