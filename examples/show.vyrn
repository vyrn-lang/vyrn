// User types are interpolable.

protocol Show {
    fn show(self) -> String
}

type Point = { x: Int64, y: Int64 }

impl Show for Point {
    fn show(self) -> String { return "(\{self.x}, \{self.y})" }
}

impl Show for Int64 {
    fn show(self) -> String { return "the number " + self.toString() }
}

fn tag(parts: Array<String>, values: Array<Value>) -> String {
    let mut out: String = parts[0].copy()
    let mut i = 0
    for v in values {
        out = out + "[" + showValue(v) + "]"
        i = i + 1
        if i < parts.length {
            out = out + parts[i]
        }
    }
    return out
}

fn label<T: Show>(x: T) -> String {
    return "[\{x}]"
}

fn showValue(v: Value) -> String {
    return match v {
        IntVal(n) => n.toString(),
        BoolVal(b) => b.toString(),
        StrVal(s) => s.copy(),
    }
}

fn main() -> Int64 {
    let p = Point { x: 3, y: 4 }

    print("\{p}") // (3, 4)
    print(p.toString()) // (3, 4)
    print(p) // (3, 4)

    print(tag"at \{p} and \{7}") // at [(3, 4)] and [7]

    let n = 7
    print(n) // 7
    print("\{n}") // 7
    print(n.show()) // the number 7

    print(label(p)) // [(3, 4)]
    print(label(n)) // [7]

    return 0
}
