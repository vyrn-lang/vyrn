// Protocols — RFC-0002 §5. A protocol is a named set of method signatures a type
// can implement; a generic can be bounded by it. Dispatch is static (each generic
// is monomorphized to the concrete impl), so there is no vtable and no runtime
// cost — and the interpreter matches native by dispatching on the runtime type.
//
// Methods are subject-first: `x.show()` calls the `Show` impl for `x`'s type.

protocol Show {
    fn show(self) -> String
}

impl Show for Int64 {
    fn show(self) -> String { return self.toString() }
}

impl Show for Bool {
    fn show(self) -> String {
        if self { return "yes" }
        return "no"
    }
}

impl Show for String {
    fn show(self) -> String { return self }
}

// An impl head can bind type variables (RFC-0080 M1), so a protocol reaches a
// generic type ONCE rather than one instantiation at a time. `T: Show` is the
// same bound spelling `fn f<T: Show>` uses, and it is what lets the body call
// `.show()` on the payload.
//
// Selection keys on the type constructor alone — `Option<Int64>` and
// `Option<String>` both select this impl — and the payload type is recovered by
// unifying the receiver against the head, exactly as a generic function's type
// arguments are inferred from its arguments. So this stays statically
// dispatched and monomorphized: one specialization per payload type, no vtable.
impl<T: Show> Show for Option<T> {
    fn show(self) -> String {
        return match self {
            Some(v) => "Some(" + v.show() + ")",
            None => "None",
        }
    }
}

// A generic function bounded by `Show` can call `.show()` on its argument.
fn label(x: Int64, flag: Bool) -> String {
    return "x=" + show(x) + " flag=" + show(flag)
}

fn describe<T: Show>(x: T) -> String {
    return "= " + x.show()
}

fn main() -> Int64 {
    print(describe(42)) // = 42       (generic, T = Int64)
    print(describe(true)) // = yes      (generic, T = Bool)
    print(label(7, false)) // x=7 flag=no
    // One `impl<T: Show> Show for Option<T>`, two payload types, one program.
    let n: Option<Int64> = Some(7)
    let s: Option<String> = Some("hi")
    let nothing: Option<Int64> = None
    print(n.show()) // Some(7)
    print(s.show()) // Some(hi)
    print(nothing.show()) // None
    print(describe(n)) // = Some(7)   (a generic bounded by Show, T = Option<Int64>)
    return 0
}
