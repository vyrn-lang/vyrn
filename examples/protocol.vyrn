protocol Show {
    fn show(self) -> String
}

impl Show for Int64 {
    fn show(self) -> String { return self.toString() }
}

impl Show for Bool {
    fn show(self) -> String {
        if self { return "yes" }
        return "no"
    }
}

impl Show for String {
    fn show(self) -> String { return self.copy() }
}

impl<T: Show> Show for Option<T> {
    fn show(self) -> String {
        return match self {
            Some(v) => "Some(" + v.show() + ")",
            None => "None",
        }
    }
}

fn label(x: Int64, flag: Bool) -> String {
    return "x=" + show(x) + " flag=" + show(flag)
}

fn describe<T: Show>(x: T) -> String {
    return "= " + x.show()
}

fn main() -> Int64 {
    print(describe(42)) // = 42       (generic, T = Int64)
    print(describe(true)) // = yes      (generic, T = Bool)
    print(label(7, false)) // x=7 flag=no
    let n: Option<Int64> = Some(7)
    let s: Option<String> = Some("hi")
    let nothing: Option<Int64> = None
    print(n.show()) // Some(7)
    print(s.show()) // Some(hi)
    print(nothing.show()) // None
    print(describe(n)) // = Some(7)   (a generic bounded by Show, T = Option<Int64>)
    return 0
}
