protocol Pretty {
    fn pretty(self) -> String
}

impl Pretty for Int64 {
    fn pretty(self) -> String { return self.toString() }
}

impl Pretty for Bool {
    fn pretty(self) -> String {
        if self { return "yes" }
        return "no"
    }
}

impl Pretty for String {
    fn pretty(self) -> String { return self.copy() }
}

impl<T: Pretty> Pretty for Option<T> {
    fn pretty(self) -> String {
        return match self {
            Some(v) => "Some(" + v.pretty() + ")",
            None => "None",
        }
    }
}

fn label(x: Int64, flag: Bool) -> String {
    return "x=" + pretty(x) + " flag=" + pretty(flag)
}

fn describe<T: Pretty>(x: T) -> String {
    return "= " + x.pretty()
}

fn main() -> Int64 {
    print(describe(42)) // = 42       (generic, T = Int64)
    print(describe(true)) // = yes      (generic, T = Bool)
    print(label(7, false)) // x=7 flag=no
    let n: Option<Int64> = Some(7)
    let s: Option<String> = Some("hi")
    let nothing: Option<Int64> = None
    print(n.pretty()) // Some(7)
    print(s.pretty()) // Some(hi)
    print(nothing.pretty()) // None
    print(describe(n)) // = Some(7)   (a generic bounded by Pretty, T = Option<Int64>)
    return 0
}
