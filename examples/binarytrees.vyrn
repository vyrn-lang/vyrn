// binary-trees, from the Computer Language Benchmarks Game.

let order = 10

let benchOrder = 14

type Tree = | Leaf | Node(Tree, Tree)

impl Owned for Tree {
    fn release(consume self) {
        match consume self {
            Leaf => {}
            Node(l, r) => {
                drop l
                drop r
            }
        }
    }
}

fn make(depth: Int64) -> Tree {
    if depth == 0 {
        return Leaf
    }
    return Node(make(depth - 1), make(depth - 1))
}

fn check(t: Tree) -> Int64 {
    return match t {
        Leaf => 1,
        Node(l, r) => 1 + check(l) + check(r),
    }
}

fn checkAll(depth: Int64, iterations: Int64) -> Int64 {
    let mut sum = 0
    let mut i = 0
    while i < iterations {
        // A temporary on purpose: the corpus's witness that an argument temporary is released.
        sum = sum + check(make(depth))
        i = i + 1
    }
    return sum
}

fn iterationsFor(depth: Int64, maxDepth: Int64, minDepth: Int64) -> Int64 {
    let mut n = 1
    let mut s = 0
    while s < maxDepth - depth + minDepth {
        n = n * 2
        s = s + 1
    }
    return n
}

fn run(n: Int64) {
    let minDepth = 4
    let mut maxDepth = n
    if maxDepth < minDepth + 2 {
        maxDepth = minDepth + 2
    }
    let stretchDepth = maxDepth + 1

    print("stretch tree of depth \{stretchDepth}\t check: \{check(make(stretchDepth))}")
    let longLived = make(maxDepth)

    let mut depth = minDepth
    while depth < stretchDepth {
        let iterations = iterationsFor(depth, maxDepth, minDepth)
        print("\{iterations}\t trees of depth \{depth}\t check: \{checkAll(depth, iterations)}")
        depth = depth + 2
    }
    print("long lived tree of depth \{maxDepth}\t check: \{check(longLived)}")
}

bench "binary-trees, depth 14 at the minimum depth" {
    let depth = blackBox(4)
    blackBox(checkAll(depth, iterationsFor(depth, blackBox(benchOrder), depth)))
}

fn main() -> Int64 {
    run(order)
    return 0
}
