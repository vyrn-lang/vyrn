// A request just under 2^31 bytes rounds past an `Int32`, so the run is out of memory.
fn main() -> Int64 {
    let mut a: Array<UInt8> = []
    a.reserve(2147483644)
    let mut b: Array<UInt8> = [1, 2, 3, 4, 5, 6, 7, 8]
    let mut i = 0
    while i < 64 {
        a.push(UInt8(7))
        i = i + 1
    }
    print("b[0] \{Int64(b[0])}")
    let mut c: Array<UInt8> = []
    c.reserve(2147483644)
    print("unreached")
    return 0
}
