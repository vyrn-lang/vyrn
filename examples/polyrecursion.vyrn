// Refused on purpose: a generic function that calls itself at a bigger type.
type P<T> = { a: T, b: T }

fn mk<T>(x: T) -> P<T> {
    return P { a: x.copy(), b: x.copy() }
}

fn f<T>(x: T, n: Int64) -> Int64 {
    if n <= 0 {
        return 0
    }
    return f(mk(x), n - 1)
}

fn main() -> Int64 {
    print("\{f(1, 3)}")
    return 0
}
