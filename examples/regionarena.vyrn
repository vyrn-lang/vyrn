// The two ways that run for the shapes `region_consume.vyrn` refuses.

type Label = { text: String, size: Int64 }

let mut taken: Array<String> = []

fn keep(s: consume String) {
    taken.push(s)
}

fn measure(s: read String) -> Int64 {
    return s.byteLength
}

fn minted(n: Int64) -> String {
    region {
        return "minted-" + n.toString()
    }
    return ""
}

fn main() -> Int64 {
    let stem = "value-"

    let mut total = 0
    region {
        let mut i = 0
        while i < 40 {
            let s = stem + i.toString()
            total = total + measure(s)
            i = i + 1
        }
    }
    print(total) // 310

    let mut held = 0
    region {
        let mut names: Array<String> = []
        names.push(stem + "a")
        names.push(stem + "b")
        let tag = Label { text: stem + "c", size: names.length }
        held = measure(tag.text) + names.length
    }
    print(held) // 9

    let mut counted = 0
    region {
        counted = counted + tally(7)
    }
    print(counted) // 7

    let early = stem + "early"
    keep(early)
    let mut m = 0
    while m < 3 {
        keep(minted(m))
        m = m + 1
    }
    let mut j = 0
    while j < taken.length {
        print(taken[j])
        j = j + 1
    }
    return 0
}

fn tally(n: consume Int64) -> Int64 {
    return n
}
