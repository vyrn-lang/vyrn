// `fork` runs waiting calls at once, and `both` and `race` wait for two tasks.
// Each fork runs its task to its first `await`; the host's timers decide what
// ends first. A race cancels its loser where it waits, and the loser's frame
// releases what it holds.
import { both, race, join, sleep, Race } from "std/task"

type Tally = { evens: Array<Int64>, odds: Array<Int64> }

fn pause(label: String, ms: Int64) -> Int64 {
    let held = "held by \{label}"
    print("start \{label}")
    await sleep(ms)
    print("end \{label}, \{held}")
    return ms
}

fn word(label: String, ms: Int64) -> String {
    await sleep(ms)
    return "\{label} after \{ms}"
}

fn count(from: Int64, ms: Int64) -> Array<Int64> {
    let mut xs: Array<Int64> = []
    let mut i = from
    while i < 6 {
        await sleep(ms)
        xs.push(i)
        i = i + 2
    }
    return xs
}

fn twice(label: String, ms: Int64) -> Int64 {
    let r = await both(fork pause("\{label}.1", ms), fork pause("\{label}.2", ms * 2))
    return r.first + r.second
}

fn square(n: Int64) -> Int64 {
    return n * n
}

fn main() -> Int64 {
    let r = await both(fork pause("a", 30), fork pause("b", 10))
    print("both: \{r.first} \{r.second}")
    match await race(fork word("slow", 40), fork word("fast", 5)) {
        First(s) => print("race: first \{s}"),
        Second(s) => print("race: second \{s}"),
    }
    match await race(fork pause("work", 50), fork sleep(15)) {
        First(ms) => print("done in \{ms}"),
        Second(_) => print("timed out"),
    }
    let c = await both(fork count(0, 4), fork count(1, 3))
    let t = Tally { evens: consume c.first, odds: consume c.second }
    print("counted \{t.evens.length} \{t.odds.length}: \{t.evens.length} evens, \{t.odds.length} odds")
    let squared = square(7)
    let lone = await join(fork pause("lone", 5))
    print("mixed: \{squared} \{lone}")
    let mut total: Int64 = 0
    let mut i: Int64 = 1
    while i <= 2 {
        let n = await both(fork twice("t\{i}", i), fork word("w\{i}", 4))
        print("\{n.second}")
        total = total + n.first
        i = i + 1
    }
    print("total \{total}")
    return 0
}
