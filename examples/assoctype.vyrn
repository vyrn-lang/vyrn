protocol Unwrap {
    type Output
    fn present(self) -> Bool
    fn valueOr(self, fallback: Output) -> Output
}

type Reading = enum { Unread, Celsius(Int64) }
type Line = enum { Blank, Words(String) }

impl<T> Unwrap for Option<T> {
    type Output = T
    fn present(self) -> Bool {
        return match self {
            Some(v) => true,
            None => false,
        }
    }
    fn valueOr(self, fallback: Output) -> Output {
        return match self {
            Some(v) => v.copy(),
            None => fallback.copy(),
        }
    }
}

impl Unwrap for Reading {
    type Output = Int64
    fn present(self) -> Bool {
        return match self {
            Unread => false,
            Celsius(c) => true,
        }
    }
    fn valueOr(self, fallback: Output) -> Output {
        return match self {
            Unread => fallback,
            Celsius(c) => c,
        }
    }
}

impl Unwrap for Line {
    type Output = String
    fn present(self) -> Bool {
        return match self {
            Blank => false,
            Words(w) => true,
        }
    }
    fn valueOr(self, fallback: Output) -> Output {
        return match self {
            Blank => fallback.copy(),
            Words(w) => w.copy(),
        }
    }
}

fn main() -> Int64 {
    let n: Option<Int64> = Some(7)
    let missingN: Option<Int64> = None
    let s: Option<String> = Some("hi")
    print((n.valueOr(0) + missingN.valueOr(41)).toString()) // 48
    print(s.valueOr("none")) // hi

    let warm: Reading = Celsius(21)
    let unknown: Reading = Unread
    print((warm.valueOr(0) + unknown.valueOr(-1)).toString()) // 20

    let greeting: Line = Words("hello")
    let empty: Line = Blank
    print(greeting.valueOr("(blank)") + " " + empty.valueOr("(blank)")) // hello (blank)

    if warm.present() {
        print("a reading is present")
    }
    if !empty.present() {
        print("a line is blank")
    }
    return 0
}
