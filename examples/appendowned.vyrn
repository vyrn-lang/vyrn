/// The refusal: `append` is a byte copy of the source's elements, and
/// an element that owns heap — a String here — would give two arrays one
/// buffer. The `@Heapless` bound on its row is the rule.
fn main() -> Int64 {
    let mut a: Array<String> = ["x"]
    let b: Array<String> = ["y"]
    a.append(b)
    return a.length
}
