<script>
import { Markup } from "std/html"

props { title: String }

/// The separator, injected verbatim via `v-html`: markup this file owns.
fn sepMarkup() -> Markup {
    return TrustedMarkup("<hr class=\"sep\"/>")
}
</script>

<template>
<section class="panel">
    <h2 class="title">{{ title }}</h2>
    <div class="sepwrap" v-html="sepMarkup()"></div>
    <slot/>
</section>
</template>

<style>
.panel { border: 1px solid #cac4d0; padding: 1rem; }
.title { margin: 0; }
.panel :global(hr) { border: 0; border-top: 1px dashed #cac4d0; }
@keyframes vyxcompFade { from { opacity: 0; } to { opacity: 1; } }
.sepwrap { animation: vyxcompFade 0.2s; }
</style>
