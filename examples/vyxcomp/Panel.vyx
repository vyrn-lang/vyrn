<script>
import { Markup } from "std/html"

props { title: String }

/// The separator, injected verbatim via `v-html`: markup this file owns.
fn sepMarkup() -> Markup {
    return TrustedMarkup("<hr class=\"sep\"/>")
}
</script>

<template>
<section class="panel">
    <h2 class="title">{{ title }}</h2>
    <div class="sepwrap" v-html="sepMarkup()"></div>
    <slot/>
</section>
</template>
