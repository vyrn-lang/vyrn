// A declared `release` on a construct's temporaries and across early exits.

protocol Owned {
    fn release(consume self)
}

type Ring = {
    label: String
}

impl Owned for Ring {
    fn release(consume self) {
        print("release " + self.label)
        let label = consume self.label
        drop label
    }
}

fn ringOf(label: String) -> Ring {
    return Ring { label: label.copy() }
}

fn maybeRing(yes: Bool) -> Option<Ring> {
    if yes {
        return Some(ringOf("scrutinee"))
    }
    return None
}

fn overMatch() -> Int64 {
    let n = match maybeRing(true) {
        Some(r) => 1,
        None => 0
    }
    return n
}

fn overHandover() -> Int64 {
    let kept = match maybeRing(true) {
        Some(r) => r,
        None => ringOf("fallback")
    }
    print("held")
    return 1
}

fn overIfLet() -> Int64 {
    if let Some(r) = maybeRing(true) {
        print("bound")
    }
    return 2
}

fn ringList() -> Array<Ring> {
    let mut xs: Array<Ring> = []
    xs.push(ringOf("elem"))
    return xs
}

fn overForIn() -> Int64 {
    for r in ringList() {
        print("seen")
    }
    return 6
}

fn overBreak() -> Int64 {
    let mut i = 0
    while i < 3 {
        let inLoop = ringOf("break")
        if i == 0 {
            break
        }
        i = i + 1
    }
    return 3
}

fn overContinue() -> Int64 {
    let mut i = 0
    while i < 3 {
        let inLoop = ringOf("continue")
        i = i + 1
        continue
    }
    return 4
}

fn overReturn() -> Int64 {
    let outer = ringOf("outer")
    if true {
        let inner = ringOf("inner")
        return 5
    }
    return 0
}

fn main() -> Int64 {
    let a = overMatch()
    print("after match")
    let b = overHandover()
    print("after handover")
    let c = overIfLet()
    print("after iflet")
    let g = overForIn()
    print("after forin")
    let d = overBreak()
    print("after break")
    let e = overContinue()
    print("after continue")
    let f = overReturn()
    print("after return")
    return 0
}
