// Reading stdin.

fn nextLine() -> String {
    return match readLine() {
        Some(s) => s,
        None => "<eof>",
    }
}

fn numericValue(line: String) -> Int64 {
    return match parse(line) {
        Some(n) => n,
        None => 0,
    }
}

fn isWord(line: String) -> Bool {
    return match parse(line) {
        Some(n) => false,
        None => true,
    }
}

fn main() -> Int64 {
    let mut lines = 0
    let mut sum = 0
    let mut words = 0
    let mut going = true
    while going {
        let line = nextLine()
        if line == "<eof>" {
            going = false
        } else {
            lines = lines + 1
            sum = sum + numericValue(line)
            if isWord(line) {
                words = words + 1
            }
            print("line \{lines}: \{line}")
        }
    }
    print("\{lines} line(s): sum \{sum}, \{words} word(s)")
    return 0
}
