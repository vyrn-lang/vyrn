// Generational handles from `std/slots`.

import { Slots, Handle, newSlots, insert, remove, get, alive } from "std/slots"

fn bump(nums: modify Slots<Int64>, h: Handle<Int64>) -> Int64 {
    nums[h] = nums[h] + 1 // mutate through a handle passed by value
    return nums[h]
}

fn measure(strs: Slots<String>, h: Handle<String>, nums: modify Slots<Int64>) -> Handle<Int64> {
    let n = strs[h].byteLength
    let v = Int64(n)
    return insert(nums, v)
}

fn main() -> Int64 {
    let mut nums: Slots<Int64> = newSlots()
    let zero = 0
    let counter = insert(nums, zero)
    let alias = counter // a second handle to the same element — a plain copy
    nums[alias] = 40 // write through one alias…
    let a = bump(nums, counter) // …read/modify through another: 41
    print(bump(nums, alias)) // 42
    remove(nums, counter) // remove once; every copy of the handle is now stale
    print(alive(nums, alias)) // false — the generation moved on

    let mut strs: Slots<String> = newSlots()
    let hello = "hello"
    let s = insert(strs, hello)
    strs[s] = strs[s] + " world"
    print(strs[s]) // hello world

    if true {
        let tail = "!" + "!"
        strs[s] = tail
    }
    print(strs[s]) // !!

    let mut refs: Slots<Handle<Int64>> = newSlots()
    let fortyOne = 41
    let inner = insert(nums, fortyOne)
    let stored = inner
    let rr = insert(refs, stored)
    let got = refs[rr]
    nums[got] = nums[got] + 1
    print(nums[got]) // 42

    let n = measure(strs, s, nums) // a handle to 2
    print(get(nums, n) ?? 0 - 1) // 2

    remove(strs, s)
    remove(nums, inner)
    remove(refs, rr)
    remove(nums, n)
    return 0
}
