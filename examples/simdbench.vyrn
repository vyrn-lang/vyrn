/// Both halves of every pair, so the three engines check that the builtin and
/// the Vyrn implementation of it agree before the benchmark prices them.
fn main() -> Int64 {
    let xs = data(64)
    print(minBuiltin(xs, 64, 0.5))
    print(minVyrn(xs, 64, 0.5))
    print(maxBuiltin(xs, 64, 0.5))
    print(maxVyrn(xs, 64, 0.5))
    print(absBuiltin(xs, 64, 0.5))
    print(absVyrn(xs, 64, 0.5))
    // The rounds against a threshold that puts the lanes across several
    // integers, halves included: `data` steps by 0.001, so scaling by 8.5 makes
    // every 2000th lane land exactly on one and the tie rule gets exercised
    // rather than only asserted in `simdround.vyrn`.
    print(ceilBuiltin(xs, 64, 8.5))
    print(ceilVyrn(xs, 64, 8.5))
    print(floorBuiltin(xs, 64, 8.5))
    print(floorVyrn(xs, 64, 8.5))
    print(truncBuiltin(xs, 64, 8.5))
    print(truncVyrn(xs, 64, 8.5))
    print(nearestBuiltin(xs, 64, 8.5))
    print(nearestVyrn(xs, 64, 8.5))
    print(selVyrn(xs, 64, 0.5))
    // Threshold `0.0` and not `0.5`: over 64 elements `data` only reaches
    // 0.033, so `0.5` would make every mask empty and the two halves would
    // agree by both answering zero.
    print(anyBuiltin(xs, 64, 0.0))
    print(anyVyrn(xs, 64, 0.0))
    print(allBuiltin(xs, 64, 0.0))
    print(allVyrn(xs, 64, 0.0))
    drop xs
    return 0
}
