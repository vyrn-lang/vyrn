// Are `F32x4.min`/`max`/`abs` movable into Vyrn? Yes — and this is what moving
// them costs (RFC-0083 M2, and RFC-0078's census question).
//
// `select` is the reason this file exists at all, and it is the one operation
// M2 tried to add and then did not. While the builtin still existed it measured
// 1.1x native (7.08 us against 6.33 us over 65536 lanes) and 1.06x wasm (282 ms
// against 268 ms over 400000 passes): both optimizers turn `selectV`'s four
// branches back into a blend, so a `v128.bitselect` primitive bought nothing.
// A Rust builtin that buys nothing is exactly what RFC-0078's census exists to
// find, so `selectV` stayed and `F32x4.select` did not ship. Only the Vyrn half
// can be timed now — its partner is deleted — which is why it has no pair here.
//
// The mask reductions are the pair whose answer depends on the DATA, which none
// of the others do. Written in Vyrn they are `||`/`&&` over four lane reads, and
// those short-circuit: over the monotonic array below the chain bails at lane 0
// almost every pass and the branch is predicted perfectly, so the builtins win
// only 1.3x (`anyTrue`) and 2.3x (`allTrue`) natively. Rebuild `data` to return
// unpredictable lanes and the same four benches say 2.5x and 2.4x. The census
// quotes the unpredictable number, because sorted input is the unusual case and
// the friendly one sits at the bar `select` already failed to clear.
//
// Each `*V` function below is the honest Vyrn implementation of the builtin on
// the primitives M1 and M2 already ship: lane reads, lane-wise comparison, and
// `floatBits` for the sign of a zero. `main` runs both halves so the three
// engines check they agree; `vyrn bench` prices the difference.
//
// The `blackBox` on the threshold inside each bench loop is load-bearing.
// Without it the whole pass is loop-invariant, LLVM hoists it, and the
// benchmark times 64 float additions and one pass — which it duly did, and
// reported ratios to match, before the barrier went in.

/// IEEE-754-2019 `minimum` on one lane: NaN propagates, and `-0.0` orders below
/// `+0.0`. The zero case needs the sign BIT — `-0.0 < 0.0` is false, so no
/// comparison can separate them — and `floatBits` on the widened lane is the
/// only view of one there is. `Float32` -> `Float64` is exact, so nothing is
/// lost on the way there or back.
fn min1(a: Float32, b: Float32) -> Float32 {
    if a != a {
        return a
    }
    if b != b {
        return b
    }
    if a == b {
        let sign: UInt64 = 9223372036854775808
        if floatBits(Float64(a)) >= sign {
            return a
        }
        return b
    }
    if a < b {
        return a
    }
    return b
}

fn max1(a: Float32, b: Float32) -> Float32 {
    if a != a {
        return a
    }
    if b != b {
        return b
    }
    if a == b {
        let sign: UInt64 = 9223372036854775808
        if floatBits(Float64(a)) >= sign {
            return b
        }
        return a
    }
    if a > b {
        return a
    }
    return b
}

/// `abs` clears the sign bit, NaN included — so it is the bits and not a
/// comparison: `abs(-0.0)` is `+0.0`, which `if x < 0.0` gets wrong.
fn abs1(x: Float32) -> Float32 {
    let mask: UInt64 = 9223372036854775807
    return Float32(floatFromBits(floatBits(Float64(x)) & mask))
}

/// Truncation toward zero, which the other three rounds are built on.
///
/// Three things it cannot do naively. A `Float32` of magnitude >= 2^23 is
/// ALREADY an integer and would not survive the `Int64` round-trip anyway (the
/// conversion saturates), so it comes straight back — which also covers both
/// infinities. NaN fails every comparison, so it has to be tested for rather
/// than falling through; `Int64(NaN)` saturates to 0. And `Int64(-0.5)` is `0`,
/// whose `Float32` is `+0.0`, so a zero result gets its sign put back by
/// multiplying the input by zero — the one operation that answers `-0.0` for a
/// negative input and `+0.0` for a positive one.
fn trunc1(x: Float32) -> Float32 {
    if x != x {
        return x
    }
    let big: Float32 = 8388608.0
    if abs1(x) >= big {
        return x
    }
    let t = Float32(Int64(x))
    if t == 0.0 {
        return x * 0.0
    }
    return t
}

fn floor1(x: Float32) -> Float32 {
    let t = trunc1(x)
    if t > x {
        return t - 1.0
    }
    return t
}

fn ceil1(x: Float32) -> Float32 {
    let t = trunc1(x)
    if t < x {
        return t + 1.0
    }
    return t
}

/// roundTiesToEven, and the tie is the whole of the difference from the `round`
/// every language ships: at exactly a half this returns the EVEN neighbour, not
/// the one further from zero. `t * 0.5` is an integer exactly when `t` is even,
/// which is the cheapest evenness test available without an integer round-trip
/// that `t` might not survive.
fn nearest1(x: Float32) -> Float32 {
    if x != x {
        return x
    }
    let big: Float32 = 8388608.0
    if abs1(x) >= big {
        return x
    }
    let t = trunc1(x)
    let a = abs1(x - t)
    if a < 0.5 {
        return t
    }
    let up = if x < 0.0 { t - 1.0 } else { t + 1.0 }
    if a > 0.5 {
        return up
    }
    if trunc1(t * 0.5) == t * 0.5 {
        return t
    }
    return up
}

fn minV(a: F32x4, b: F32x4) -> F32x4 {
    return F32x4(
        min1(a.lane(0), b.lane(0)),
        min1(a.lane(1), b.lane(1)),
        min1(a.lane(2), b.lane(2)),
        min1(a.lane(3), b.lane(3)),
    )
}

fn maxV(a: F32x4, b: F32x4) -> F32x4 {
    return F32x4(
        max1(a.lane(0), b.lane(0)),
        max1(a.lane(1), b.lane(1)),
        max1(a.lane(2), b.lane(2)),
        max1(a.lane(3), b.lane(3)),
    )
}

fn absV(v: F32x4) -> F32x4 {
    return F32x4(abs1(v.lane(0)), abs1(v.lane(1)), abs1(v.lane(2)), abs1(v.lane(3)))
}

fn ceilV(v: F32x4) -> F32x4 {
    return F32x4(ceil1(v.lane(0)), ceil1(v.lane(1)), ceil1(v.lane(2)), ceil1(v.lane(3)))
}

fn floorV(v: F32x4) -> F32x4 {
    return F32x4(floor1(v.lane(0)), floor1(v.lane(1)), floor1(v.lane(2)), floor1(v.lane(3)))
}

fn truncV(v: F32x4) -> F32x4 {
    return F32x4(trunc1(v.lane(0)), trunc1(v.lane(1)), trunc1(v.lane(2)), trunc1(v.lane(3)))
}

fn nearestV(v: F32x4) -> F32x4 {
    return F32x4(
        nearest1(v.lane(0)),
        nearest1(v.lane(1)),
        nearest1(v.lane(2)),
        nearest1(v.lane(3)),
    )
}

fn selectV(m: Mask32x4, a: F32x4, b: F32x4) -> F32x4 {
    return F32x4(
        if m.lane(0) { a.lane(0) } else { b.lane(0) },
        if m.lane(1) { a.lane(1) } else { b.lane(1) },
        if m.lane(2) { a.lane(2) } else { b.lane(2) },
        if m.lane(3) { a.lane(3) } else { b.lane(3) },
    )
}

/// The mask reductions written out: four lane reads and a short-circuiting
/// chain, which is the only way to ask before `anyTrue`/`allTrue` existed.
fn anyV(m: Mask32x4) -> Bool {
    return m.lane(0) || m.lane(1) || m.lane(2) || m.lane(3)
}

fn allV(m: Mask32x4) -> Bool {
    return m.lane(0) && m.lane(1) && m.lane(2) && m.lane(3)
}

fn sum(v: F32x4) -> Float32 {
    return v.lane(0) + v.lane(1) + v.lane(2) + v.lane(3)
}

fn data(n: Int64) -> Array<Float32> {
    let mut xs: Array<Float32> = []
    let mut i = 0
    while i < n {
        xs.push(Float32(i) / 1000.0 - 0.03)
        i = i + 1
    }
    return xs
}

// Seven walks: three pairs, plus the Vyrn `select` whose partner was deleted.
// Each takes the threshold as an argument so the caller can hide it behind a
// `blackBox`.
fn minBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.min(F32x4.load(xs, i), h)
        i = i + 4
    }
    return sum(acc)
}

fn minVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + minV(F32x4.load(xs, i), h)
        i = i + 4
    }
    return sum(acc)
}

fn maxBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.max(F32x4.load(xs, i), h)
        i = i + 4
    }
    return sum(acc)
}

fn maxVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + maxV(F32x4.load(xs, i), h)
        i = i + 4
    }
    return sum(acc)
}

fn absBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.abs(F32x4.load(xs, i) - h)
        i = i + 4
    }
    return sum(acc)
}

fn absVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + absV(F32x4.load(xs, i) - h)
        i = i + 4
    }
    return sum(acc)
}

// The four rounds. Each scales by the threshold first, so the lanes span a few
// integers instead of sitting inside one — `data` only reaches 1.0 and every
// round of that is 0 or 1, which would time the loop rather than the operation.
fn ceilBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.ceil(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn ceilVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + ceilV(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn floorBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.floor(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn floorVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + floorV(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn truncBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.trunc(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn truncVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + truncV(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn nearestBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + F32x4.nearest(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn nearestVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        acc = acc + nearestV(F32x4.load(xs, i) * h)
        i = i + 4
    }
    return sum(acc)
}

fn selVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Float32 {
    let mut acc = F32x4.splat(0.0)
    let h = F32x4.splat(t)
    let mut i = 0
    while i < n {
        let v = F32x4.load(xs, i)
        acc = acc + selectV(v < h, v, h)
        i = i + 4
    }
    return sum(acc)
}

// The reduction pairs count vectors rather than summing lanes, because a
// reduction's whole output is a `Bool` — there is nothing else to accumulate.
// `data` rises monotonically, so the branch is well predicted and this is the
// case FRIENDLIEST to the Vyrn version: the short-circuit chain bails at lane 0
// for most of the array. A hostile-data variant would flatter the builtin; the
// friendly one is the honest bar for keeping it.
fn anyBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Int64 {
    let h = F32x4.splat(t)
    let mut c = 0
    let mut i = 0
    while i < n {
        if (F32x4.load(xs, i) > h).anyTrue() {
            c = c + 1
        }
        i = i + 4
    }
    return c
}

fn anyVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Int64 {
    let h = F32x4.splat(t)
    let mut c = 0
    let mut i = 0
    while i < n {
        if anyV(F32x4.load(xs, i) > h) {
            c = c + 1
        }
        i = i + 4
    }
    return c
}

fn allBuiltin(xs: Array<Float32>, n: Int64, t: Float32) -> Int64 {
    let h = F32x4.splat(t)
    let mut c = 0
    let mut i = 0
    while i < n {
        if (F32x4.load(xs, i) > h).allTrue() {
            c = c + 1
        }
        i = i + 4
    }
    return c
}

fn allVyrn(xs: Array<Float32>, n: Int64, t: Float32) -> Int64 {
    let h = F32x4.splat(t)
    let mut c = 0
    let mut i = 0
    while i < n {
        if allV(F32x4.load(xs, i) > h) {
            c = c + 1
        }
        i = i + 4
    }
    return c
}

bench "min builtin" {
    let xs = data(1024)
    let mut r: Float32 = 0.0
    let mut k = 0
    while k < 64 {
        r = r + minBuiltin(xs, 1024, blackBox(0.5))
        k = k + 1
    }
    blackBox(r)
    drop xs
}

bench "min in Vyrn" {
    let xs = data(1024)
    let mut r: Float32 = 0.0
    let mut k = 0
    while k < 64 {
        r = r + minVyrn(xs, 1024, blackBox(0.5))
        k = k + 1
    }
    blackBox(r)
    drop xs
}

