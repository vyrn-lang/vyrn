// Method-form mutation through a place, not only a bare variable.

type Store = { xs: Array<Int64>, n: Int64 }

let mut store: Store = Store { xs: [], n: 0 }

type Cell = { grid: Array<Array<Int64>> }

let mut gGrid: Array<Array<Int64>> = [[9], [7, 8]]

fn sumFirst(g: Array<Array<Int64>>) -> Int64 {
    let mut acc = 0
    let mut i = 0
    while i < g[0].length {
        acc = acc + g[0][i]
        i = i + 1
    }
    return acc
}

fn record(v: Int64) -> Int64 {
    store.xs.push(v)
    store.n = store.n + 1
    return 0
}

fn main() -> Int64 {
    let _ = record(10)
    let _ = record(20)
    let _ = record(30)
    print(store.xs.length) // 3 — the pushes stuck (was 0 before the fix)
    print(store.n) // 3 — the sibling scalar agrees
    print(store.xs[0]) // 10
    print(store.xs[2]) // 30

    let mut local: Store = Store { xs: [], n: 0 }
    local.xs.push(1)
    local.xs.push(2)
    local.n = local.xs.length
    print(local.xs.length) // 2
    print(local.n) // 2

    let mut rows: Array<Array<Int64>> = []
    let mut row: Array<Int64> = []
    row.push(7)
    rows.push(row)
    rows[0].push(8)
    rows[0].push(9)
    print(rows[0].length) // 3
    print(rows[0][2]) // 9

    let litRows: Array<Array<Int64>> = [[1], [2, 3]] // let-annotated, ragged
    print(litRows.length) // 2
    print(litRows[0][0]) // 1
    print(litRows[1][1]) // 3
    let litStrs: Array<Array<String>> = [["ada"], ["grace", "hopper"]] // string inner
    print(litStrs[1][1]) // hopper
    let cell: Cell = Cell { grid: [[4, 5], [6]] } // record-field init
    print(cell.grid[0][1]) // 5
    print(sumFirst([[10, 11], [12]])) // 21 — fn arg
    print(gGrid[1][1]) // 8 — module state (top-level nested literal)
    let litMap: Map<String, Array<Array<Int64>>> = ["k": [[5], [6, 7]]] // map value
    let got = match litMap["k"] {
        Some(v) => v[1][1],
        None => 0,
    }
    print(got) // 7
    let deep: Array<Array<Array<Int64>>> = [[[1]], [[2], [3, 4]]] // triple nesting
    print(deep[1][1][1]) // 4

    let mut names: NameBox = NameBox { items: [] }
    names.items.push("ada")
    names.items.push("grace")
    print(names.items.length) // 2
    print(names.items[1]) // grace
    let owned = consume names.items // take the field buffer out into a local
    drop owned // explicit reclaim of the field-pushed heap buffer

    return 0
}

type NameBox = { items: Array<String> }

test "field push on a global record persists (not a copy)" {
    let mut s: Store = Store { xs: [], n: 0 }
    s.xs.push(100)
    s.xs.push(200)
    s.n = s.xs.length
    assertEq(s.xs.length, 2)
    assertEq(s.n, 2)
    assertEq(s.xs[0], 100)
    assertEq(s.xs[1], 200)
}

test "array-element push writes back through the slot" {
    let mut rows: Array<Array<Int64>> = []
    let mut r: Array<Int64> = []
    r.push(1)
    rows.push(r)
    rows[0].push(2)
    rows[0].push(3)
    assertEq(rows[0].length, 3)
    assertEq(rows[0][2], 3)
}

test "nested array literals lower to growable rows, ragged included" {
    let litRows: Array<Array<Int64>> = [[1], [2, 3]]
    assertEq(litRows.length, 2)
    assertEq(litRows[0].length, 1)
    assertEq(litRows[1].length, 2)
    assertEq(litRows[1][1], 3)
    let mut mixed: Array<Array<Int64>> = [[1, 2]]
    mixed.push([3, 4, 5])
    assertEq(mixed[1].length, 3)
    assertEq(mixed[1][2], 5)
    let m: Map<String, Array<Array<Int64>>> = ["k": [[5], [6, 7]]]
    let got = match m["k"] {
        Some(v) => v[1][1],
        None => 0,
    }
    assertEq(got, 7)
}
