// The stream combinators are lazy.
import { Cursor, cursorGet, cursorSet, unfold, map, filter, take } from "std/stream"

let mut steps = 0

fn naturals(c: Cursor) -> Option<Int64> {
    let n = cursorGet(c)
    cursorSet(c, n + 1)
    steps = steps + 1
    return Some(n)
}

fn double(n: Int64) -> Int64 {
    return n * 2
}

fn byThree(n: Int64) -> Bool {
    return n % 3 == 0
}

fn small(n: Int64) -> Bool {
    return n < 4
}

fn mapCost(n: Int64) -> Int64 {
    steps = 0
    let mut seen = 0
    for v in take(map(unfold(0, naturals), double), n) {
        seen = seen + v
    }
    return steps
}

fn filterCost(n: Int64) -> Int64 {
    steps = 0
    let mut seen = 0
    for v in take(filter(unfold(0, naturals), byThree), n) {
        seen = seen + v
    }
    return steps
}

fn chainCycles(n: Int64) -> Int64 {
    let mut i = 0
    while i < n {
        let s = take(filter(map(unfold(i, naturals), double), small), 2)
        close(s)
        i = i + 1
    }
    return i
}

fn firstOver(limit: Int64) -> Int64 {
    for v in map(unfold(0, naturals), double) {
        if v > limit {
            return v
        }
    }
    return -1
}

fn main() -> Int64 {
    for v in take(map(unfold(0, naturals), double), 5) {
        print(v) // 0 2 4 6 8
    }
    print(mapCost(5)) // 5 — one ask per element, and no more
    print(mapCost(1000)) // 1000
    print(mapCost(20000)) // 20000

    for v in take(filter(unfold(0, naturals), byThree), 4) {
        print(v)
    }
    print(filterCost(4)) // 10
    print(filterCost(100)) // 298

    for v in take(map(filter(unfold(1, naturals), byThree), double), 3) {
        print(v) // 6 12 18
    }

    for v in map(unfold(0, naturals), double) {
        if v == 6 {
            break
        }
        print(v) // 0 2 4
    }

    print(firstOver(7)) // 8

    for v in map(filter(unfold(0, upToFive), small), double) {
        print(v) // 0 2 4 6
    }

    print(chainCycles(30000)) // 30000

    return 0
}

fn upToFive(c: Cursor) -> Option<Int64> {
    let n = cursorGet(c)
    if n > 5 {
        return None
    }
    cursorSet(c, n + 1)
    return Some(n)
}
