// The pull representation of a stream.
import { Cursor, cursorGet, cursorSet, unfold, map, filter, take } from "std/stream"

let mut steps = 0

fn naturals(c: Cursor) -> Option<Int64> {
    let n = cursorGet(c)
    cursorSet(c, n + 1)
    steps = steps + 1
    return Some(n)
}

fn upToThree(c: Cursor) -> Option<Int64> {
    let n = cursorGet(c)
    if n > 3 {
        return None
    }
    cursorSet(c, n + 1)
    return Some(n * 10)
}

fn powers(c: Cursor) -> Option<Int64> {
    let n = cursorGet(c)
    if n > 64 {
        return None
    }
    cursorSet(c, n * 2)
    return Some(n)
}

fn double(n: Int64) -> Int64 {
    return n * 2
}

fn odd(n: Int64) -> Bool {
    return n % 2 == 1
}

fn discard() -> Int64 {
    let s = unfold(100, naturals)
    close(s)
    return 0
}

fn cost(n: Int64) -> Int64 {
    steps = 0
    let mut seen = 0
    for v in take(unfold(0, naturals), n) {
        seen = seen + v
    }
    return steps
}

fn cycles(n: Int64) -> Int64 {
    let mut i = 0
    while i < n {
        let s = unfold(i, naturals)
        close(s)
        i = i + 1
    }
    return i
}

fn main() -> Int64 {
    for v in take(unfold(0, naturals), 5) {
        print(v) // 0 1 2 3 4
    }
    print(steps) // 5 — one ask per element, and no more

    for v in unfold(0, upToThree) {
        print(v) // 0 10 20 30
    }

    for v in unfold(1, powers) {
        print(v) // 1 2 4 8 16 32 64
    }

    for v in map(take(unfold(0, naturals), 4), double) {
        print(v) // 0 2 4 6
    }
    for v in filter(unfold(0, upToThree), odd) {
        print(v) // (nothing — every element is even)
    }
    print(-1)

    for v in unfold(0, naturals) {
        if v == 3 {
            break
        }
        print(v) // 0 1 2
    }

    print(firstOver(7))
    print(discard())

    print(cost(5)) // 5
    print(cost(1000)) // 1000
    print(cost(20000)) // 20000

    print(cycles(10000)) // 10000

    let mut a = unfold(0, upToThree)
    let mut b = unfold(0, powers)
    close(a)
    close(b)

    return 0
}

fn firstOver(limit: Int64) -> Int64 {
    for v in unfold(0, naturals) {
        if v > limit {
            return v
        }
    }
    return -1
}
