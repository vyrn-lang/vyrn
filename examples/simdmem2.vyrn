// A vector in a record field, an array element and a map value.
type Slot = { tag: UInt8, v: F32x4 }

fn lanes(v: F32x4) {
    print(v.lane(0))
    print(v.lane(1))
    print(v.lane(2))
    print(v.lane(3))
}

fn main() -> Int64 {
    let s = Slot { tag: 7, v: F32x4(1.0, 2.0, 3.0, 4.0) }
    print(s.tag)
    lanes(s.v)

    let mut t = s
    t.v = t.v * F32x4.splat(2.0)
    lanes(t.v)

    let mut vs: Array<F32x4> = []
    vs.push(F32x4.splat(1.5))
    vs.push(F32x4(10.0, 20.0, 30.0, 40.0))
    vs.push(F32x4.splat(-2.5))
    print(vs.length)
    lanes(vs[1])
    lanes(vs[2])

    vs[1] = vs[1] + F32x4.splat(0.5)
    lanes(vs[1])
    drop vs

    let mut m: Map<String, F32x4> = [:]
    m["one"] = F32x4.splat(1.0)
    m["two"] = F32x4(2.0, 4.0, 6.0, 8.0)
    print(m.length)
    if let Some(v) = m["two"] {
        lanes(v)
    }
    if let Some(v) = m["one"] {
        print(v.lane(3))
    }
    match m["three"] {
        Some(v) => print(v.lane(0)),
        None => print("no three"),
    }
    drop m

    return 0
}
