// The refutable `let`.

type Entry =
    | Tagged(String, Int64)
    | Blank

let mut ledger: Entry = Blank

fn ensure() {
    if let Blank = ledger {
        ledger = Tagged("a payload string that lives on the heap", 40)
    }
}

fn main() -> Int64 {
    let local = Tagged("first", 1)
    let Tagged(tag, n) = local
    print("local: \{tag} \{n}")

    ensure()
    let mut i = 0
    let mut total = 0
    while i < 1000 {
        let Tagged(s, k) = ledger
        total = total + s.byteLength + k
        i = i + 1
    }
    print("total: \{total}")
    return 0
}
