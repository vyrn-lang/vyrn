// spectral-norm, from the Computer Language Benchmarks Game.

let order = 100

let benchOrder = 500

fn sqrtF(v: Float64) -> Float64 {
    return F64x2.sqrt(F64x2(v, v)).lane(0)
}

fn fixed9(v: Float64) -> String {
    let mut a = v
    let mut sign = ""
    if a < 0.0 {
        sign = "-"
        a = 0.0 - a
    }
    let scaled = Int64(a * 1000000000.0 + 0.5)
    let whole = scaled / 1000000000
    let mut frac = "\{scaled % 1000000000}"
    while frac.byteLength < 9 {
        frac = "0\{frac}"
    }
    return "\{sign}\{whole}.\{frac}"
}

fn cell(i: Int64, j: Int64) -> Float64 {
    return 1.0 / Float64((i + j) * (i + j + 1) / 2 + i + 1)
}

fn multiplyAv(n: Int64, v: Array<Float64>, out: consume Array<Float64>) -> Array<Float64> {
    let mut w = out
    let mut i = 0
    while i < n {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            sum = sum + cell(i, j) * v[j]
            j = j + 1
        }
        w[i] = sum
        i = i + 1
    }
    return w
}

fn multiplyAtv(n: Int64, v: Array<Float64>, out: consume Array<Float64>) -> Array<Float64> {
    let mut w = out
    let mut i = 0
    while i < n {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            sum = sum + cell(j, i) * v[j]
            j = j + 1
        }
        w[i] = sum
        i = i + 1
    }
    return w
}

fn filled(n: Int64, x: Float64) -> Array<Float64> {
    let mut out: Array<Float64> = []
    let mut i = 0
    while i < n {
        out.push(x)
        i = i + 1
    }
    return out
}

fn spectralNorm(n: Int64) -> Float64 {
    let mut u = filled(n, 1.0)
    let mut v = filled(n, 0.0)
    let mut w = filled(n, 0.0)
    let mut round = 0
    while round < 10 {
        w = multiplyAv(n, u, w)
        v = multiplyAtv(n, w, v)
        w = multiplyAv(n, v, w)
        u = multiplyAtv(n, w, u)
        round = round + 1
    }
    let mut vbv = 0.0
    let mut vv = 0.0
    let mut k = 0
    while k < n {
        vbv = vbv + u[k] * v[k]
        vv = vv + v[k] * v[k]
        k = k + 1
    }
    return sqrtF(vbv / vv)
}

bench "spectral-norm, N = 500" {
    blackBox(fixed9(spectralNorm(blackBox(benchOrder))).byteLength)
}

fn main() -> Int64 {
    print(fixed9(spectralNorm(order)))
    return 0
}
