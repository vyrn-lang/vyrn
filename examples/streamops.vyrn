/// `std/stream` — the combinators (RFC-0075 M2).
///
/// Four of the seven the RFC lists: `map`, `filter`, `take`, `merge`. They are
/// ordinary Vyrn generics over `Stream<T>` (std/stream.vyrn), so this file is
/// also the parity evidence for them — interp == native == wasm, byte for byte.
///
/// The three that are missing are missing for one reason: `Stream<T>` lowers to
/// `Array<T>`'s three words, so a stream is a buffer that already exists.
/// `unfold` and `channel` are producers whose length is not known, and building
/// one over this representation means running the producer to exhaustion before
/// the consumer sees an element — which is the unbounded retention this RFC was
/// written to make impossible. See "As landed — M2" in the RFC.
///
/// The obligation is not weakened by any of this. Every combinator takes a
/// stream (the parameter carries the obligation into the callee), consumes it
/// with `for … in`, and returns a stream the caller now owes. Abandon one and
/// the program does not build — stream_map_abandoned.vyrn is that refusal.
import { map, filter, take, merge } from "std/stream"

/// The only producer M1 shipped: an array's buffer, handed over.
fn feed(from: Int64, count: Int64) -> Stream<Int64> {
    let mut xs: Array<Int64> = []
    let mut i = 0
    while i < count {
        xs.push(from + i)
        i = i + 1
    }
    return fromArray(xs)
}

fn double(n: Int64) -> Int64 {
    return n * 2
}

fn odd(n: Int64) -> Bool {
    return n % 2 == 1
}

/// A whole chain forwarded out of a function: nothing here disposes anything,
/// because the last stream leaves. The intermediates are each consumed by the
/// combinator they were passed to.
fn pipeline(n: Int64) -> Stream<Int64> {
    return take(map(filter(feed(1, n), odd), double), 3)
}

/// A combinator result disposed by `close` rather than by iteration — the same
/// discharge M1 gave `fromArray`, on a stream nothing produced directly.
fn discard(n: Int64) -> Int64 {
    let m = map(feed(0, n), double)
    close(m)
    return n
}

/// An EARLY RETURN out of a `for … in` over a combinator result. The release
/// runs on this path exactly as it does on the fall-through; there is no
/// `finally` here and none to forget.
fn firstOver(limit: Int64) -> Int64 {
    for v in map(feed(1, 20), double) {
        if v > limit {
            return v
        }
    }
    return -1
}

fn main() -> Int64 {
    // map ---------------------------------------------------------------------
    for v in map(feed(1, 4), double) {
        print(v) // 2 4 6 8
    }

    // filter ------------------------------------------------------------------
    for v in filter(feed(1, 7), odd) {
        print(v) // 1 3 5 7
    }

    // take: fewer than asked, exactly as asked, and none at all ---------------
    for v in take(feed(10, 2), 5) {
        print(v) // 10 11
    }
    for v in take(feed(20, 9), 3) {
        print(v) // 20 21 22
    }
    for v in take(feed(30, 4), 0) {
        print(v) // (nothing)
    }
    print(-1)

    // merge: turn by turn, then the longer one drains -------------------------
    for v in merge(feed(1, 3), feed(100, 5)) {
        print(v) // 1 100 2 101 3 102 103 104
    }
    print(-2)

    // A chain, and a `break` out of it: the release still runs, once.
    for v in pipeline(9) {
        if v == 10 {
            break
        }
        print(v) // 2 6
    }

    print(discard(5)) // 5
    print(firstOver(11)) // 12

    return 0
}
