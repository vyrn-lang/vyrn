// A user container that indexes like a builtin.

type Window = { data: Array<Int64>, start: Int64 }

impl Index for Window {
    fn at(read self, i: Int64) -> read Int64 {
        return self.data[self.start + i]
    }
}

type Strided = { data: Array<Int64>, stride: Int64 }

impl Index for Strided {
    fn at(read self, i: Int64) -> read Int64 {
        let k = i * self.stride
        return self.data[k]
    }
}

type Clamped = { data: Array<Int64> }

impl Index for Clamped {
    fn at(read self, i: Int64) -> read Int64 {
        let n = self.data.length
        let j = if i < n { i } else { n - 1 }
        return self.data[j]
    }
}

fn build(n: Int64) -> Array<Int64> {
    let mut out: Array<Int64> = []
    let mut i = 0
    while i < n {
        out.push(i * 10)
        i = i + 1
    }
    return out
}

fn main() -> Int64 {
    let w = Window { data: build(6), start: 2 }
    print("window: \{w[0]} \{w[1]} \{w[3]}")

    let s = Strided { data: build(9), stride: 3 }
    print("strided: \{s[0]} \{s[1]} \{s[2]}")

    let c = Clamped { data: build(3) }
    print("clamped: \{c[0]} \{c[2]} \{c[9]}")

    let mut a = build(4)
    a[1] = 99
    print("array: \{a[0]} \{a[1]} \{a[3]}")
    return 0
}
