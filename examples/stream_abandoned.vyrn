// Refused on purpose: a stream that is never disposed.

fn feed() -> Stream<Int64> {
    let xs: Array<Int64> = [1, 2, 3]
    return fromArray(xs)
}

fn drain(s: Stream<Int64>) -> Int64 {
    let mut total = 0
    for v in s {
        total = total + v
    }
    return total
}

fn main() -> Int64 {
    let events = feed()
    print(0)

    let conditional = feed()
    if 1 == 1 {
        close(conditional)
    }

    let early = feed()
    if 1 == 1 {
        return 1
    }
    close(early)

    let armed = feed()
    let pick: Option<Int64> = Some(1)
    let n = match pick {
        Some(k) => drain(armed) + k,
        None => 0,
    }
    print(n)

    return 0
}
