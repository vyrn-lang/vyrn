// A module's own `raw` and `render` beside a generator that means the builtins.
import { surface } from "./lib/gen_surface"
import { tagged } from surface("from-the-builtin")

fn raw(s: String) -> String {
    return "raw:" + s
}

fn render(n: Int64) -> String {
    return "render:\{n}"
}

fn main() -> Int64 {
    print(raw("mine"))
    print(render(7))
    print(tagged())
    return 0
}
