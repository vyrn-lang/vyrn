// k-nucleotide, from the Computer Language Benchmarks Game.

import { toUpper } from "std/strings"
import { startsWith } from "std/strpred"
import { sortWith } from "std/arrays"

let benchOrder = 200000

let maxWidth = 30

fn namedFragments() -> Array<String> {
    return ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]
}

type Entry = { key: Int64, count: Int64 }

fn code(b: UInt8) -> Int64 {
    return if b == 'A' { 0 } else if b == 'C' { 1 } else if b == 'G' { 2 } else { 3 }
}

fn modulusOf(k: Int64) -> Int64 {
    let mut m = 1
    let mut j = 0
    while j < k {
        m = m * 4
        j = j + 1
    }
    return m
}

fn thirdSequence() -> Array<UInt8> {
    let mut out: Array<UInt8> = []
    let mut inThird = false
    while let Some(l) = readLine() {
        if l.startsWith(">") {
            inThird = l.startsWith(">THREE")
        } else if inThird {
            for b in bytes(toUpper(l)) {
                out.push(b)
            }
        }
    }
    return out
}

fn countKmers(seq: Array<UInt8>, k: Int64) -> Map<Int64, Int64> {
    if k > maxWidth {
        panic("k-mer width above maxWidth")
    }
    let mut m: Map<Int64, Int64> = [:]
    if seq.length < k {
        return m
    }
    let modulus = modulusOf(k)
    let mut key = 0
    let mut i = 0
    while i < seq.length {
        key = (key * 4 + code(seq[i])) % modulus
        if i >= k - 1 {
            m.tally(key, 1)
        }
        i = i + 1
    }
    return m
}

fn unpack(key: Int64, k: Int64) -> String {
    let alphabet = bytes("ACGT")
    let mut w: Array<UInt8> = []
    w.reserve(k)
    let mut d = modulusOf(k) / 4
    while d >= 1 {
        w.push(alphabet[(key / d) % 4])
        d = d / 4
    }
    return match stringFromBytes(w) {
        Ok(s) => s,
        Err(_) => "",
    }
}

fn pack(frag: String) -> Int64 {
    let mut key = 0
    for b in bytes(frag) {
        key = key * 4 + code(b)
    }
    return key
}

fn fixed3(x: Float64) -> String {
    let scaled = Int64(x * 1000.0 + 0.5)
    let whole = scaled / 1000
    let mut frac = "\{scaled % 1000}"
    while frac.byteLength < 3 {
        frac = "0\{frac}"
    }
    return "\{whole}.\{frac}"
}

fn byCountThenFrag(a: Entry, b: Entry) -> Int64 {
    if a.count > b.count {
        return 0 - 1
    }
    if a.count < b.count {
        return 1
    }
    if a.key < b.key {
        return 0 - 1
    }
    if a.key > b.key {
        return 1
    }
    return 0
}

fn ranked(m: Map<Int64, Int64>) -> Array<Entry> {
    let mut es: Array<Entry> = []
    for key in m.keys() {
        let c = match m[key] {
            Some(v) => v,
            None => 0,
        }
        es.push(Entry { key: key, count: c })
    }
    return sortWith(es, byCountThenFrag)
}

fn report(seq: Array<UInt8>, k: Int64) {
    let m = countKmers(seq, k)
    let total = seq.length - k + 1
    for e in ranked(m) {
        print("\{unpack(e.key, k)} \{fixed3(100.0 * Float64(e.count) / Float64(total))}")
    }
    print("")
}

fn countOf(seq: Array<UInt8>, frag: String) -> Int64 {
    let m = countKmers(seq, Int64(frag.byteLength))
    return match m[pack(frag)] {
        Some(c) => c,
        None => 0,
    }
}

fn syntheticSequence(n: Int64) -> Array<UInt8> {
    let alphabet = bytes("ACGT")
    let mut out: Array<UInt8> = []
    let mut state = 42
    let mut i = 0
    while i < n {
        state = (state * 3877 + 29573) % 139968
        out.push(alphabet[(state * 4) / 139968])
        i = i + 1
    }
    return out
}

bench "k-nucleotide, 2-mers over 200000 bases" {
    let seq = syntheticSequence(blackBox(benchOrder))
    blackBox(countKmers(blackBox(seq), blackBox(2)).length)
}

bench "k-nucleotide, 18-mers over 200000 bases" {
    let seq = syntheticSequence(blackBox(benchOrder))
    blackBox(countKmers(blackBox(seq), blackBox(18)).length)
}

fn main() -> Int64 {
    let seq = thirdSequence()
    report(seq, 1)
    report(seq, 2)
    for frag in namedFragments() {
        print("\{countOf(seq, frag)}\t\{frag}")
    }
    return 0
}
