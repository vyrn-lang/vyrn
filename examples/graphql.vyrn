// A GraphQL query over the procedures `examples/shelf` publishes.
import { graphqlServer, gqlAnswer } from "std/graphql"
import { graphqlHandle } from graphqlServer("./shelf/server/api/books")
import { Json, JsonField } from "std/json"
import { contains } from "std/strpred"

fn ask(label: String, body: String) {
    let req = Request { method: "POST", path: "/graphql", headers: [:], body: body.copy() }
    match graphqlHandle(req) {
        Some(r) => print("\{label} -> \{r.status} \{r.body}"),
        None => print("\{label} -> unrouted"),
    }
}

fn main() -> Int64 {
    ask("{ browse { books { title } } }", "{ browse { books { title } } }")

    ask("envelope", "{\"query\": \"{ browse { books { title } } }\"}")

    ask("{ browse { books } }", "{ browse { books } }")

    ask("{ tags }", "{ tags }")

    ask("byId(input: {id: 2})", "{ byId(input: { id: 2 }) { Ok { title } } }")

    ask("byId(input: {id: -1})", "{ byId(input: { id: -1 }) { Ok { title } } }")

    ask(
        "mutation add(input: ..)",
        "mutation { add(input: { title: \"Vyrn\", url: \"https://vyrn.dev\", tags: [\"lang\"] }) { Ok { title } } }",
    )

    ask("alias", "{ recent: browse { books { name: title } } }")

    ask("undeclared member", "{ browse { books { nope } } }")

    ask("{ shelved { title } }", "{ shelved { title } }")

    ask("{ add { title } }", "{ add { title } }")

    ask("unknown argument", "{ byId(id: 1) { Ok { title } } }")
    ask("missing argument", "{ byId { Ok { title } } }")

    ask("two roots", "{ browse { books { title } } tags }")

    ask("a sibling survives", "{ browse { books { title } } nope }")

    ask("the null climbs to browse", "{ browse { books { title { nope } } } }")

    ask("the null stops at Ok", "{ byId(input: { id: 2 }) { Ok { title { nope } } } }")

    let top = gqlAnswer("{ book { title { nope } } }", topResolve, topSchema)
    print("a non-null root -> \{top.status} \{top.body}")

    match graphqlHandle(Request { method: "GET", path: "/graphql", headers: [:], body: "" }) {
        Some(r) => print("GET /graphql -> \{r.status} \{r.body}"),
        None => print("GET /graphql -> unrouted"),
    }
    match graphqlHandle(Request { method: "POST", path: "/_/books/browse", headers: [:], body: "" }) {
        Some(r) => print("POST /_/books/browse -> \{r.status}"),
        None => print("POST /_/books/browse -> unrouted (not our path)"),
    }
    return 0
}

fn topSchema(t: String, field: String) -> String {
    if t == "Query" {
        if field == "" {
            return t.copy()
        }
        if field == "book" {
            return "Book!"
        }
        return ""
    }
    if t == "Book" {
        if field == "" {
            return t.copy()
        }
        if field == "title" {
            return "Title!"
        }
        return ""
    }
    return ""
}

fn topResolve(root: String, field: String, args: Array<JsonField>) -> Result<Json, String> {
    if field == "book" {
        return Ok(JObj([JsonField { key: "title", value: JStr("SICP") }]))
    }
    return Err("Cannot query field `" + field + "` on type `Query`.")
}

fn reply(body: String) -> String {
    let r = graphqlHandle(Request { method: "POST", path: "/graphql", headers: [:], body: body.copy() })
    return match consume r {
        Some(res) => consume res.body,
        None => "",
    }
}

test "the projection omits every field the query did not select" {
    let body = reply("{ browse { books { title } } }")
    assert(body.contains("\"title\":\"SICP\""))
    assert(body.contains("url") == false)
    assert(body.contains("rating") == false)
    assert(body.contains("tags") == false)
    assert(body.contains("\"id\"") == false)
}

test "an undeclared field is a request fault — validation runs before anything executes" {
    assertEq(
        reply("{ shelved }"),
        "{\"errors\":[{\"message\":\"Cannot query field `shelved` on type `Query`.\"}]}",
    )
}

test "one invalid root field refuses the whole document before any of it answers" {
    let body = reply("{ browse { books { title } } nope }")
    assert(body.contains("\"title\":\"SICP\"") == false)
    assert(body.contains("\"message\":\"Cannot query field `nope` on type `Query`.\""))
    assert(body.contains("\"data\"") == false)
}

test "a selection below a scalar field is refused before the list is walked" {
    let body = reply("{ browse { books { title { nope } } } }")
    assert(
        body.contains(
            "\"message\":\"Field `title` must not have a selection since type `Title` has no subfields.\"",
        ),
    )
    assert(body.contains("\"path\"") == false)
    assert(body.contains("\"data\"") == false)
}

test "a selection on a byId scalar is a request fault — the procedure never runs" {
    let body = reply("{ byId(input: { id: 1 }) { Ok { title { deep } } } }")
    assert(body.contains("must not have a selection since type `Title` has no subfields."))
    assert(body.contains("\"data\"") == false)
}

test "a resolver-owned fault keeps its path and its siblings answer" {
    let body = reply("{ byId(id: 1) { Ok { title } } browse { books { title } } }")
    assert(body.contains("\"message\":\"Unknown argument `id` on field `byId`.\""))
    assert(body.contains("\"path\":[\"byId\"]"))
    assert(body.contains("\"title\":\"SICP\""))
    assert(body.contains("\"data\":null") == false)
}

test "an argument reaches the procedure and the right record comes back" {
    assertEq(
        reply("{ byId(input: { id: 2 }) { Ok { title } } }"),
        "{\"data\":{\"byId\":{\"Ok\":{\"title\":\"SICP\"}}}}",
    )
    assert(reply("{ byId(input: { id: -1 }) { Ok { title } } }").contains("invalid argument"))
    assertEq(
        reply("{ byId(id: 1) { Ok { title } } }"),
        "{\"errors\":[{\"message\":\"Unknown argument `id` on field `byId`.\","
        + "\"path\":[\"byId\"]}],\"data\":{\"byId\":null}}",
    )
}

test "an alias renames the answer and nothing else" {
    assertEq(
        reply("{ recent: browse { books { name: title } } }"),
        "{\"data\":{\"recent\":{\"books\":[{\"name\":\"The Pragmatic Programmer\"},{\"name\":\"Dune\"},{\"name\":\"SICP\"}]}}}",
    )
}

test "an undeclared member field is refused against the type graph, not the value" {
    let body = reply("{ browse { books { nope } } }")
    assert(body.contains("\"message\":\"Cannot query field `nope` on type `Book`.\""))
    assert(body.contains("\"data\"") == false)
}

test "a selection on a scalar is refused — M1's second hole" {
    let body = reply("{ browse { books { title { nope } } } }")
    assert(
        body.contains(
            "\"message\":\"Field `title` must not have a selection since type `Title` has no subfields.\"",
        ),
    )
}
