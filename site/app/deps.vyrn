import { endsWith } from "std/strpred"
import { includes } from "std/arrays"
import { importsOf } from "./guidecode"
import { quotedList, branch, lookup, entriesOf, vyrnStems, fenced } from "./gensrc"

type Uses = { path: String, uses: Array<String> }

gen fn usesOf(dir: String, name: String, shown: String) -> Uses {
    let src = match readFile(dir + "/" + name) {
        Ok(text) => text,
        Err(why) => "",
    }
    return Uses { path: shown.copy(), uses: importsOf(lex(src)).uses.copy() }
}

gen fn walk(root: String, sub: String, depth: Int64) -> Array<Uses> {
    let dir = if sub.byteLength == 0 { root.copy() } else { root + "/" + sub }
    let mut out: Array<Uses> = []
    for entry in entriesOf(dir) {
        let shown = if sub.byteLength == 0 { entry.copy() } else { sub + "/" + entry }
        if endsWith(entry, ".vyrn") {
            out.push(usesOf(dir, entry, shown))
        } else if depth > 0 {
            for deeper in walk(root, shown, depth - 1) {
                out.push(deeper)
            }
        }
    }
    return out
}

gen fn depthOf(m: String, all: Array<String>, edges: Array<Uses>, walking: Array<String>) -> Int64 {
    if includes(walking, m) {
        return 0
    }
    let mut here = walking.copy()
    here.push(m.copy())
    let mut deepest = 0 - 1
    for e in edges {
        if e.path == m {
            for u in e.uses {
                if includes(all, u) {
                    let d = depthOf(u, all, edges, here)
                    if d > deepest {
                        deepest = d
                    }
                }
            }
        }
    }
    return deepest + 1
}

export gen fn moduleDeps(stdDir: String, examplesDir: String) -> Code {
    // The graph draws what the reference lists, and `std/task` imports the fenced runtime.
    let mut all: Array<String> = []
    for m in vyrnStems(stdDir) {
        if !fenced(m) {
            all.push(m.copy())
        }
    }
    let mut edges: Array<Uses> = []
    for m in all {
        edges.push(usesOf(stdDir, m + ".vyrn", m))
    }
    let samples = walk(examplesDir, "", 2)

    let mut uses: Array<Code> = []
    let mut usedBy: Array<Code> = []
    let mut depth: Array<Code> = []
    let mut examples: Array<Code> = []
    for m in all {
        let mut mine: Array<String> = []
        for e in edges {
            if e.path == m {
                for u in e.uses {
                    if includes(all, u) && !includes(mine, u) {
                        mine.push(u.copy())
                    }
                }
            }
        }
        uses.push(branch("m", m, quotedList(mine)))

        let mut back: Array<String> = []
        for e in edges {
            if e.path != m && includes(e.uses, m) {
                back.push(e.path.copy())
            }
        }
        usedBy.push(branch("m", m, quotedList(back)))

        let mut users: Array<String> = []
        for s in samples {
            if includes(s.uses, m) {
                users.push(s.path.copy())
            }
        }
        examples.push(branch("m", m, quotedList(users)))

        let d = depthOf(m, all, edges, [])
        depth.push(branch("m", m, vyrn"\{d}"))
    }

    let strings = vyrn"Array<String>"
    let none = vyrn"[]"
    let usesFn = lookup("depUses", "m", strings, uses, none)
    let usedByFn = lookup("depUsedBy", "m", strings, usedBy, none)
    let depthFn = lookup("depDepth", "m", vyrn"Int64", depth, vyrn"0")
    let examplesFn = lookup("depExamples", "m", strings, examples, none)
    return vyrn"""
        /// The `std/` modules a module imports.
        \{usesFn}
        /// The `std/` modules that import a module.
        \{usedByFn}
        /// How far a module sits from the bottom of the graph.
        \{depthFn}
        /// The example programs that import a module, by path under `examples/`.
        \{examplesFn}

        """
}
