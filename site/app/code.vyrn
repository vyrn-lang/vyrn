/// Colour for code that is not Vyrn, and markup for text that is not code.
///
/// Vyrn is coloured by the compiler's lexer in `hl.vyrn`. This module colours
/// the Rust, TypeScript and Go comparison snippets with a word list, colours
/// shell commands by token class, and marks tool output line by line so the
/// stylesheet can dim it. `escapeHtml` is the site's one HTML escaper.
///
/// ponytail: word lists, no parser. If a snippet highlights wrongly, shorten
/// the snippet.
import { substring, split, joinWith, fromBytesOr } from "std/strings"
import { contains } from "std/strpred"
import { includes } from "std/arrays"

/// The Rust words the comparison snippets use.
export fn rustWords() -> Array<String> {
    return ["fn", "let", "mut", "if", "else", "while", "for", "in", "impl", "self", "return", "true", "false", "struct", "enum", "match", "pub", "use", "mod", "trait", "where", "const", "static", "unsafe", "move", "ref", "dyn", "async", "await", "crate"]
}

/// The TypeScript words the comparison snippets use.
export fn tsWords() -> Array<String> {
    return ["function", "let", "const", "var", "if", "else", "while", "for", "of", "in", "return", "true", "false", "class", "interface", "type", "enum", "import", "export", "from", "as", "new", "async", "await", "throw", "try", "catch", "extends", "implements", "readonly"]
}

/// The Go words the comparison snippets use.
export fn goWords() -> Array<String> {
    return ["func", "var", "const", "if", "else", "for", "range", "return", "true", "false", "type", "struct", "interface", "package", "import", "go", "defer", "chan", "select", "switch", "case", "map", "nil", "make", "new"]
}

/// One HTML-safe byte. Callers pass ASCII bytes only, so the fallback for a
/// byte that is not UTF-8 on its own is unreachable.
fn escapeByte(b: UInt8) -> String {
    if b == '&' {
        return "&amp;"
    }
    if b == '<' {
        return "&lt;"
    }
    if b == '>' {
        return "&gt;"
    }
    if b == '"' {
        return "&quot;"
    }
    if b == '\'' {
        return "&#39;"
    }
    return fromBytesOr([b], "")
}

/// `s` with `&`, `<`, `>`, `"` and `'` escaped, so the result is safe in
/// element content and in a quoted attribute. Multi-byte characters pass
/// through whole: no byte of one equals an ASCII byte.
export fn escapeHtml(s: String) -> String {
    let raw = bytes(s)
    let mut out = ""
    let mut plain = 0
    let mut i = 0
    while i < raw.length {
        let b = raw[i]
        if b == '&' || b == '<' || b == '>' || b == '"' || b == '\'' {
            out = out + substring(s, plain, i) + escapeByte(b)
            plain = i + 1
        }
        i = i + 1
    }
    return out + substring(s, plain, raw.length)
}

fn isLetter(b: UInt8) -> Bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'
}

fn isDigit(b: UInt8) -> Bool {
    return b >= '0' && b <= '9'
}

fn isWordByte(b: UInt8) -> Bool {
    return isLetter(b) || isDigit(b)
}

/// `text` inside a span of class `cls`, escaped.
fn span(cls: String, text: String) -> String {
    return "<span class=\"" + cls + "\">" + escapeHtml(text) + "</span>"
}

/// Highlight `src` against `words`, returning the inner HTML of a `<pre>`.
///
/// A comment runs to the newline, a string to the closing quote (a backslash
/// covers the next byte), a word run is one span or none, and anything else is
/// escaped.
export fn highlightWith(src: String, words: Array<String>) -> String {
    let raw = bytes(src)
    let mut out = ""
    let mut i = 0
    while i < raw.length {
        let b = raw[i]
        if b == '/' && i + 1 < raw.length && raw[i + 1] == '/' {
            let start = i
            while i < raw.length && raw[i] != 10 {
                i = i + 1
            }
            out = out + span("c", substring(src, start, i))
        } else if b == '"' {
            let start = i
            i = i + 1
            while i < raw.length && raw[i] != '"' {
                if raw[i] == 92 {
                    i = i + 1
                }
                i = i + 1
            }
            if i < raw.length {
                i = i + 1
            }
            out = out + span("s", substring(src, start, i))
        } else if isLetter(b) {
            let start = i
            while i < raw.length && isWordByte(raw[i]) {
                i = i + 1
            }
            let word = substring(src, start, i)
            if includes(words, word) {
                out = out + span("k", word)
            } else if b >= 'A' && b <= 'Z' {
                out = out + span("t", word)
            } else {
                out = out + escapeHtml(word)
            }
        } else if isDigit(b) {
            let start = i
            while i < raw.length && (isWordByte(raw[i]) || raw[i] == '.') {
                i = i + 1
            }
            out = out + span("n", substring(src, start, i))
        } else {
            out = out + escapeByte(b)
            i = i + 1
        }
    }
    return out
}

/// A shell block, coloured by token class: the program is the first word of a
/// line, a flag opens with `-`, a comment runs from `#`, and an argument is
/// plain text.
///
/// ponytail: not a shell parser. A `#` inside quotes reads as a comment, and
/// only `&&`, `||`, `|` and `;` start another program. No command on the site
/// needs more.
export fn shellHtml(src: String) -> String {
    let mut out: Array<String> = []
    for line in split(src, "\n") {
        out.push(shellLine(line))
    }
    return joinWith(out, "\n")
}

/// One command line. `head` is true until the first word is spent.
fn shellLine(line: String) -> String {
    let raw = bytes(line)
    let mut out = ""
    let mut head = true
    let mut i = 0
    while i < raw.length {
        if raw[i] == '#' {
            return out + span("c", substring(line, i, raw.length))
        }
        if raw[i] == ' ' || raw[i] == 9 {
            out = out + escapeByte(raw[i])
            i = i + 1
        } else {
            let start = i
            while i < raw.length && raw[i] != ' ' && raw[i] != 9 {
                i = i + 1
            }
            let word = substring(line, start, i)
            if word == "&&" || word == "||" || word == "|" || word == ";" {
                out = out + escapeHtml(word)
                head = true
            } else if head {
                out = out + span("k", word)
                head = false
            } else if raw[start] == '-' {
                out = out + span("n", word)
            } else {
                out = out + escapeHtml(word)
            }
        }
    }
    return out
}

/// Tool output, one marked span per line, so the stylesheet can prefix and dim
/// it. The text is escaped and otherwise untouched.
export fn terminalHtml(text: String) -> String {
    let mut out: Array<String> = []
    for line in split(text, "\n") {
        out.push("<span class=\"ol\">" + escapeHtml(line) + "</span>")
    }
    return joinWith(out, "\n")
}

/// One line of prose, escaped, with its backtick spans as `<code>`. Chapter
/// ledes use this one markdown construct and no other.
export fn inlineCode(text: String) -> String {
    let mut out = ""
    let mut plain = 0
    let mut open = 0 - 1
    let raw = bytes(text)
    let mut i = 0
    while i < raw.length {
        if raw[i] == '`' {
            if open < 0 {
                open = i
            } else {
                out = out + escapeHtml(substring(text, plain, open)) + "<code>" + escapeHtml(substring(text, open + 1, i)) + "</code>"
                plain = i + 1
                open = 0 - 1
            }
        }
        i = i + 1
    }
    // An unpaired backtick stays a backtick.
    return out + escapeHtml(substring(text, plain, text.byteLength))
}

test "a backtick span becomes code and everything else is escaped" {
    assertEq(inlineCode("plain"), "plain")
    assertEq(inlineCode("a `match` b"), "a <code>match</code> b")
    assertEq(inlineCode("`Option<T>`"), "<code>Option&lt;T&gt;</code>")
    assertEq(inlineCode("a < b"), "a &lt; b")
    // Two spans on one line, and a lone backtick that closes nothing.
    assertEq(inlineCode("`a` and `b`"), "<code>a</code> and <code>b</code>")
    assertEq(inlineCode("a ` b"), "a ` b")
}

test "another language uses its own word list" {
    assertEq(highlightWith("func x", goWords()), "<span class=\"k\">func</span> x")
    assertEq(highlightWith("pub struct Age", rustWords()), "<span class=\"k\">pub</span> <span class=\"k\">struct</span> <span class=\"t\">Age</span>")
}

test "a comment runs to the end of its line and no further" {
    assertEq(highlightWith("// note\nfn", rustWords()), "<span class=\"c\">// note</span>\n<span class=\"k\">fn</span>")
}

test "markup in a snippet cannot escape the pre" {
    assertEq(escapeHtml("<script>&"), "&lt;script&gt;&amp;")
    assertEq(highlightWith("a < b", goWords()), "a &lt; b")
}

test "an escaped quote does not end the string" {
    assertEq(highlightWith("\"a\\\"b\" c", goWords()), "<span class=\"s\">&quot;a\\&quot;b&quot;</span> c")
}

test "a signature cannot break out of an attribute" {
    assertEq(escapeHtml("\" onerror=\"alert(1)"), "&quot; onerror=&quot;alert(1)")
    assertEq(escapeHtml("it's"), "it&#39;s")
}

test "a shell block marks the program, its flags and its comments" {
    assertEq(shellHtml("cargo build --release -p vyrn-cli"), "<span class=\"k\">cargo</span> build <span class=\"n\">--release</span> <span class=\"n\">-p</span> vyrn-cli")
    assertEq(shellHtml("cd vyrn/compiler"), "<span class=\"k\">cd</span> vyrn/compiler")
    assertEq(shellHtml("mkdir out # first"), "<span class=\"k\">mkdir</span> out <span class=\"c\"># first</span>")
}

test "every line of a shell block gets its own program word" {
    assertEq(shellHtml("a\nb"), "<span class=\"k\">a</span>\n<span class=\"k\">b</span>")
    assertEq(shellHtml("  a b"), "  <span class=\"k\">a</span> b")
}

test "a connector starts another command, not another argument" {
    assertEq(shellHtml("a x && b"), "<span class=\"k\">a</span> x &amp;&amp; <span class=\"k\">b</span>")
}

test "a shell argument cannot carry markup out of the block" {
    assertEq(shellHtml("run <x> &"), "<span class=\"k\">run</span> &lt;x&gt; &amp;")
}

test "tool output is marked line by line and never coloured as code" {
    assertEq(terminalHtml("a\nb"), "<span class=\"ol\">a</span>\n<span class=\"ol\">b</span>")
    assertEq(terminalHtml("<x>"), "<span class=\"ol\">&lt;x&gt;</span>")
}

/// One recorded step as a terminal body: a prompt and the command, then the
/// output. A transcript is not source, so it gets three classes and no lexer;
/// a line naming a path is dimmed.
export fn shellOutHtml(cmd: String, out: String) -> String {
    let mut lines: Array<String> = []
    for line in split(out, "\n") {
        lines.push(demoLineHtml(line))
    }
    let prompt = if cmd.byteLength > 0 { "<span class=\"pr\">$</span> <span class=\"cx\">" + escapeHtml(cmd) + "</span>\n" } else { "" }
    return prompt + joinWith(lines, "\n")
}

/// One line of a recorded transcript.
fn demoLineHtml(line: String) -> String {
    if line.byteLength == 0 {
        return ""
    }
    let text = escapeHtml(line)
    let cls = if contains(line, "/") { "pa" } else { "pl" }
    return "<span class=\"" + cls + "\">" + text + "</span>"
}
