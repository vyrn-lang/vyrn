/// Colour for the code that is NOT Vyrn, and shape for the text that is not code.
///
/// Vyrn snippets are coloured by the compiler's own lexer, in `hl.vyrn`. This
/// module covers the two things that lexer cannot answer for:
///
///  - **Rust, TypeScript and Go.** A word-list colourer over a byte scan, which
///    the design brief permits explicitly (G3): "do not write three more lexers".
///    It is approximate, and the comparison page says so.
///  - **Tool output.** A compiler diagnostic or a `vyrn why` report is not code
///    and must not be dressed as code. `terminalHtml` marks each line so the
///    stylesheet can give output its own, dimmer treatment. Nothing on this site
///    ships as bare unstyled text.
///
/// ponytail: word-list colouring for the other three languages, no parser. If a
/// snippet ever highlights wrongly, shorten the snippet.
import { substring, split, fromBytesOr } from "std/strings"

/// The Rust words the comparison snippets use.
export fn rustWords() -> Array<String> {
    return ["fn", "let", "mut", "if", "else", "while", "for", "in", "impl", "self", "return", "true", "false", "struct", "enum", "match", "pub", "use", "mod", "trait", "where", "const", "static", "unsafe", "move", "ref", "dyn", "async", "await", "crate"]
}

/// The TypeScript words the comparison snippets use.
export fn tsWords() -> Array<String> {
    return ["function", "let", "const", "var", "if", "else", "while", "for", "of", "in", "return", "true", "false", "class", "interface", "type", "enum", "import", "export", "from", "as", "new", "async", "await", "throw", "try", "catch", "extends", "implements", "readonly"]
}

/// The Go words the comparison snippets use.
export fn goWords() -> Array<String> {
    return ["func", "var", "const", "if", "else", "for", "range", "return", "true", "false", "type", "struct", "interface", "package", "import", "go", "defer", "chan", "select", "switch", "case", "map", "nil", "make", "new"]
}

/// One HTML-safe byte. Only the three that can change the markup are replaced;
/// a quote inside a `<pre>` is text. A byte that is not valid UTF-8 on its own
/// is a continuation byte of a character the caller split, which cannot happen
/// here — every caller passes whole runs — so the fallback is unreachable.
fn escapeByte(b: UInt8) -> String {
    if b == '&' {
        return "&amp;"
    }
    if b == '<' {
        return "&lt;"
    }
    if b == '>' {
        return "&gt;"
    }
    return fromBytesOr([b], "")
}

/// `s` with the markup-significant bytes replaced. Multi-byte characters pass
/// through whole: only ASCII `&`, `<` and `>` are replaced, and neither byte of
/// a longer character can equal one of them.
export fn escapeHtml(s: String) -> String {
    let raw = bytes(s)
    let mut out = ""
    let mut plain = 0
    let mut i = 0
    while i < raw.length {
        let b = raw[i]
        if b == '&' || b == '<' || b == '>' {
            out = out + substring(s, plain, i) + escapeByte(b)
            plain = i + 1
        }
        i = i + 1
    }
    return out + substring(s, plain, raw.length)
}

fn isLetter(b: UInt8) -> Bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'
}

fn isDigit(b: UInt8) -> Bool {
    return b >= '0' && b <= '9'
}

fn isWordByte(b: UInt8) -> Bool {
    return isLetter(b) || isDigit(b)
}

fn isWord(word: String, words: Array<String>) -> Bool {
    for w in words {
        if w == word {
            return true
        }
    }
    return false
}

/// `text` inside a span of class `cls`, escaped.
fn span(cls: String, text: String) -> String {
    return "<span class=\"" + cls + "\">" + escapeHtml(text) + "</span>"
}

/// Highlight `src` against `words`, returning the inner HTML of a `<pre>`.
///
/// One left-to-right pass. A comment runs to the newline, a string runs to the
/// closing quote (a backslash covers the next byte), a word run is one span or
/// none, and everything else is escaped through.
export fn highlightWith(src: String, words: Array<String>) -> String {
    let raw = bytes(src)
    let mut out = ""
    let mut i = 0
    while i < raw.length {
        let b = raw[i]
        if b == '/' && i + 1 < raw.length && raw[i + 1] == '/' {
            let start = i
            while i < raw.length && raw[i] != 10 {
                i = i + 1
            }
            out = out + span("c", substring(src, start, i))
        } else if b == '"' {
            let start = i
            i = i + 1
            while i < raw.length && raw[i] != '"' {
                if raw[i] == 92 {
                    i = i + 1
                }
                i = i + 1
            }
            if i < raw.length {
                i = i + 1
            }
            out = out + span("s", substring(src, start, i))
        } else if isLetter(b) {
            let start = i
            while i < raw.length && isWordByte(raw[i]) {
                i = i + 1
            }
            let word = substring(src, start, i)
            if isWord(word, words) {
                out = out + span("k", word)
            } else if b >= 'A' && b <= 'Z' {
                out = out + span("t", word)
            } else {
                out = out + escapeHtml(word)
            }
        } else if isDigit(b) {
            let start = i
            while i < raw.length && (isWordByte(raw[i]) || raw[i] == '.') {
                i = i + 1
            }
            out = out + span("n", substring(src, start, i))
        } else {
            out = out + escapeByte(b)
            i = i + 1
        }
    }
    return out
}

/// One line of tool output, marked so the stylesheet can prefix and dim it.
///
/// The text is escaped and otherwise untouched: a compiler diagnostic means what
/// it says, and colouring parts of it would be this site editing the compiler.
export fn terminalHtml(text: String) -> String {
    let mut out = ""
    let mut first = true
    for line in split(text, "\n") {
        if !first {
            out = out + "\n"
        }
        first = false
        out = out + "<span class=\"ol\">" + escapeHtml(line) + "</span>"
    }
    return out
}

test "another language uses its own word list" {
    assertEq(highlightWith("func x", goWords()), "<span class=\"k\">func</span> x")
    assertEq(highlightWith("pub struct Age", rustWords()), "<span class=\"k\">pub</span> <span class=\"k\">struct</span> <span class=\"t\">Age</span>")
}

test "a comment runs to the end of its line and no further" {
    assertEq(highlightWith("// note\nfn", rustWords()), "<span class=\"c\">// note</span>\n<span class=\"k\">fn</span>")
}

test "markup in a snippet cannot escape the pre" {
    assertEq(escapeHtml("<script>&"), "&lt;script&gt;&amp;")
    assertEq(highlightWith("a < b", goWords()), "a &lt; b")
}

test "an escaped quote does not end the string" {
    assertEq(highlightWith("\"a\\\"b\" c", goWords()), "<span class=\"s\">\"a\\\"b\"</span> c")
}

test "tool output is marked line by line and never coloured as code" {
    assertEq(terminalHtml("a\nb"), "<span class=\"ol\">a</span>\n<span class=\"ol\">b</span>")
    assertEq(terminalHtml("<x>"), "<span class=\"ol\">&lt;x&gt;</span>")
}
