/// Cuts the record with `indexOf` instead of parsing it: `std/jsonread` is too slow under the interpreter.
import { indexOf, substring, trim, split, joinWith, padStart } from "std/strings"
import { contains } from "std/strpred"
import { sortBy } from "std/arrays"
import { parseFloat64 } from "std/num"
import { sin, cos } from "std/math"
import { ghBlob } from "./github"

/// Times in integer microseconds; -1 marks a field the reader could not cut.
export type Measure = {
    program: String,
    contestant: String,
    us: Int64,
    cpuUs: Int64,
    peakBytes: Int64,
    makeUs: Int64,
    gzBytes: Int64,
}

export type Prog = { key: String, name: String, n: String, note: String, game: String }

export type Series = { key: String, name: String, tone: String }

export type Ring = { id: String, points: String, label: String, y: String, tone: String }

export type Spoke = { key: String, name: String, x: String, y: String, lx: String, ly: String, anchor: String, wedge: String }

export type Line = { key: String, name: String, tone: String, points: String, marks: Array<Mark> }

export type Mark = { id: String, d: String, title: String }

export type Reading = { key: String, name: String, tone: String, cpu: String, mem: String, gz: String, make: String, ms: String, vsC: String, vsRust: String, pct: String, over: Bool }

export type Panel = { key: String, name: String, n: String, cause: String, label: String, verdict: String, game: String, cells: Array<Reading> }

export fn run1File() -> String {
    return "bench/results/2026-09-01.json"
}

export fn run1Href() -> String {
    return ghBlob(run1File())
}

fn after(src: String, needle: String) -> String {
    return match indexOf(src, needle) {
        Some(at) => substring(src, at + needle.byteLength, src.byteLength),
        None => "",
    }
}

fn upTo(src: String, needle: String) -> String {
    return match indexOf(src, needle) {
        Some(at) => substring(src, 0, at),
        None => src.copy(),
    }
}

fn objectAt(src: String, indent: String, key: String) -> String {
    return upTo(after(src, "\n" + indent + "\"" + key + "\": {"), "\n" + indent + "\"")
}

fn scalarAt(src: String, indent: String, key: String) -> String {
    let raw = upTo(after(src, "\n" + indent + "\"" + key + "\": "), "\n")
    let cut = if raw.byteLength > 0 && substring(raw, raw.byteLength - 1, raw.byteLength) == "," {
        substring(raw, 0, raw.byteLength - 1)
    } else {
        raw.copy()
    }
    return trim(cut)
}

fn textAt(src: String, indent: String, key: String) -> String {
    let raw = scalarAt(src, indent, key)
    if raw.byteLength >= 2 && substring(raw, 0, 1) == "\"" {
        return unescaped(substring(raw, 1, raw.byteLength - 1))
    }
    return unescaped(raw)
}

fn unescaped(text: String) -> String {
    if !contains(text, "\\") {
        return text.copy()
    }
    let raw = bytes(text)
    let mut out = ""
    let mut i = 0
    while i < raw.length {
        if raw[i] != '\\' || i + 1 >= raw.length {
            out = out + substring(text, i, i + 1)
            i = i + 1
            continue
        }
        let c = raw[i + 1]
        if c == 'u' && i + 5 < raw.length {
            out = out + charOf(hexAt(text, i + 2))
            i = i + 6
            continue
        }
        if c == 'n' {
            out = out + "\n"
        } else if c == 't' {
            out = out + "\t"
        } else if c == 'r' {
            out = out + "\r"
        } else {
            out = out + substring(text, i + 1, i + 2)
        }
        i = i + 2
    }
    return out
}

fn hexAt(text: String, at: Int64) -> Int64 {
    let raw = bytes(text)
    let mut n = 0
    let mut i = at
    while i < at + 4 {
        let b = Int64(raw[i])
        let d = if b >= 48 && b <= 57 {
            b - 48
        } else if b >= 97 && b <= 102 {
            b - 87
        } else {
            b - 55
        }
        n = n * 16 + d
        i = i + 1
    }
    return n
}

fn charOf(cp: Int64) -> String {
    let mut raw: Array<UInt8> = []
    if cp < 128 {
        raw.push(UInt8(cp))
    } else if cp < 2048 {
        raw.push(UInt8(192 + cp / 64))
        raw.push(UInt8(128 + cp % 64))
    } else {
        raw.push(UInt8(224 + cp / 4096))
        raw.push(UInt8(128 + (cp / 64) % 64))
        raw.push(UInt8(128 + cp % 64))
    }
    return match stringFromBytes(raw) {
        Ok(text) => text,
        Err(_) => "",
    }
}

fn microsOf(text: String) -> Int64 {
    return match parseFloat64(text) {
        Some(s) => Int64(s * 1000000.0 + 0.5),
        None => 0 - 1,
    }
}

let mut records: Map<String, String> = [:]

fn recordText(file: String) -> String {
    if let Some(hit) = records[file] {
        return hit.copy()
    }
    let body = match readFile(file) {
        Ok(text) => text.copy(),
        Err(why) => "",
    }
    records[file.copy()] = body.copy()
    return body
}

// Written out, not discovered, so a program missing from a re-run fails a test instead of shrinking the chart.
let mut progs: Array<Prog> = []

export fn programs() -> Array<Prog> {
    if progs.length > 0 {
        return progs.copy()
    }
    let src = recordText(run1File())
    let results = objectAt(src, "  ", "results")
    let mut out: Array<Prog> = []
    for p in progNames() {
        let slice = objectAt(results, "    ", p[0])
        out.push(Prog {
            key: p[0].copy(),
            name: p[1].copy(),
            n: grouped(scalarAt(slice, "      ", "n")),
            note: textAt(slice, "      ", "note"),
            game: gameHref(p[2]),
        })
    }
    progs = out.copy()
    return out
}

fn progNames() -> Array<Array<String>> {
    return [
        ["nbody", "nbody", "nbody"],
        ["spectralnorm", "spectral-norm", "spectralnorm"],
        ["fannkuch", "fannkuch-redux", "fannkuchredux"],
        ["binarytrees", "binary-trees", "binarytrees"],
        ["fasta", "fasta", "fasta"],
        ["revcomp", "reverse-complement", "revcomp"],
        ["knucleotide", "k-nucleotide", "knucleotide"],
        ["pidigits", "pidigits", "pidigits"],
        ["mandelbrot", "mandelbrot", "mandelbrot"],
        ["regexredux", "regex-redux", "regexredux"],
    ]
}

fn gameHref(slug: String) -> String {
    return "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/" + slug + ".html"
}

export fn contestants() -> Array<Series> {
    return [
        Series { key: "c", name: "C", tone: "sr-c" },
        Series { key: "rust", name: "Rust", tone: "sr-rust" },
        Series { key: "js", name: "node", tone: "sr-node" },
        Series { key: "vyrn-native", name: "Vyrn native", tone: "sr-vyrn" },
        Series { key: "vyrn-wasm", name: "Vyrn wasm", tone: "sr-vyrn dashed" },
    ]
}

let mut cells: Array<Measure> = []

fn loadCells() {
    if cells.length > 0 {
        return
    }
    let results = objectAt(recordText(run1File()), "  ", "results")
    for p in progNames() {
        let box = objectAt(objectAt(results, "    ", p[0]), "      ", "contestants")
        for s in contestants() {
            let cell = objectAt(box, "        ", s.key)
            cells.push(Measure {
                program: p[0].copy(),
                contestant: s.key.copy(),
                us: microsOf(scalarAt(cell, "          ", "median_s")),
                cpuUs: microsOf(scalarAt(cell, "          ", "cpu_median_s")),
                peakBytes: wholeOf(scalarAt(cell, "          ", "peak_bytes")),
                makeUs: microsOf(scalarAt(cell, "          ", "make_s")),
                gzBytes: wholeOf(scalarAt(cell, "          ", "gz_bytes")),
            })
        }
    }
}

fn cellOf(program: String, contestant: String) -> Measure {
    loadCells()
    for c in cells {
        if c.program == program && c.contestant == contestant {
            return c.copy()
        }
    }
    return Measure {
        program: program.copy(),
        contestant: contestant.copy(),
        us: 0 - 1,
        cpuUs: 0 - 1,
        peakBytes: 0 - 1,
        makeUs: 0 - 1,
        gzBytes: 0 - 1,
    }
}

fn medianUs(program: String, contestant: String) -> Int64 {
    return cellOf(program, contestant).us
}

fn tenthsText(t: Int64) -> String {
    return (t / 10).toString() + "." + (t % 10).toString()
}

fn hundredthsText(h: Int64) -> String {
    return (h / 100).toString() + "." + padStart((h % 100).toString(), 2, "0")
}

fn msOf(us: Int64) -> String {
    if us < 0 {
        return "\u{2014}"
    }
    if us >= 100000 {
        return ((us + 500) / 1000).toString() + " ms"
    }
    return tenthsText((us + 50) / 100) + " ms"
}

fn wholeOf(text: String) -> Int64 {
    return match parseFloat64(text) {
        Some(v) => Int64(v),
        None => 0 - 1,
    }
}

fn secsOf(us: Int64) -> String {
    if us < 0 {
        return "\u{2014}"
    }
    let cs = (us + 5000) / 10000
    if cs == 0 && us > 0 {
        return "<0.01"
    }
    return hundredthsText(cs)
}

fn makeOf(us: Int64) -> String {
    if us == 0 {
        return "\u{2014}"
    }
    return secsOf(us)
}

fn memOf(bytes: Int64) -> String {
    if bytes <= 0 {
        return "\u{2014}"
    }
    let kb = (bytes + 512) / 1024
    if kb < 10240 {
        return grouped(kb.toString()) + " KB"
    }
    let tenths = (bytes * 10 + 524288) / 1048576
    return grouped((tenths / 10).toString()) + "." + (tenths % 10).toString() + " MB"
}

fn bytesOf(n: Int64) -> String {
    if n <= 0 {
        return "\u{2014}"
    }
    return grouped(n.toString())
}

fn hundredths(a: Int64, b: Int64) -> Int64 {
    if b <= 0 {
        return 0
    }
    return (a * 100 + b / 2) / b
}

fn ratioText(h: Int64) -> String {
    if h <= 0 {
        return "\u{2014}"
    }
    if h >= 10000 {
        return ((h + 50) / 100).toString() + "x"
    }
    return hundredthsText(h) + "x"
}

fn grouped(digits: String) -> String {
    let raw = trim(digits)
    let mut out = ""
    let mut i = 0
    let n = raw.byteLength
    while i < n {
        if i > 0 && (n - i) % 3 == 0 {
            out = out + ","
        }
        out = out + substring(raw, i, i + 1)
        i = i + 1
    }
    return out
}

fn cx() -> Int64 {
    return 350
}

fn cy() -> Int64 {
    return 272
}

fn radius() -> Int64 {
    return 200
}

fn decades() -> Int64 {
    return 7
}

fn belowBase() -> Int64 {
    return 3
}

export fn radarBox() -> String {
    return "0 0 700 544"
}

export fn radarCx() -> String {
    return cx().toString()
}

export fn radarCy() -> String {
    return cy().toString()
}

fn log2(x: Float64) -> Float64 {
    if x <= 0.0 {
        return 0.0 - 1000.0
    }
    let mut m = x
    let mut e = 0
    while m >= 1.4142135623730951 {
        m = m / 2.0
        e = e + 1
    }
    while m < 0.7071067811865476 {
        m = m * 2.0
        e = e - 1
    }
    let z = (m - 1.0) / (m + 1.0)
    let zz = z * z
    let mut term = z
    let mut sum = z
    let mut k = 1
    while k < 20 {
        term = term * zz
        sum = sum + term / Float64(2 * k + 1)
        k = k + 1
    }
    return Float64(e) + 2.0 * sum / 0.6931471805599453
}

fn radiusOf(h: Int64) -> Int64 {
    if h <= 0 {
        return 0
    }
    let steps = log2(Float64(h) / 100.0) + Float64(belowBase())
    if steps <= 0.0 {
        return 0
    }
    let r = steps * Float64(radius()) / Float64(decades())
    if r >= Float64(radius()) {
        return radius()
    }
    return Int64(r + 0.5)
}

fn offScale(h: Int64) -> Bool {
    return h > 100 * pow2(decades() - belowBase())
}

fn pow2(n: Int64) -> Int64 {
    let mut v = 1
    let mut i = 0
    while i < n {
        v = v * 2
        i = i + 1
    }
    return v
}

fn angleOf(i: Int64) -> Float64 {
    return Float64(i) * 6.283185307179586 / Float64(progNames().length)
}

type Pixel = { x: Int64, y: Int64 }

fn spot(i: Int64, r: Int64) -> Pixel {
    let a = angleOf(i)
    let x = Float64(cx()) + Float64(r) * sin(a)
    let y = Float64(cy()) - Float64(r) * cos(a)
    return Pixel { x: Int64(x + 0.5), y: Int64(y + 0.5) }
}

fn pointAt(i: Int64, r: Int64) -> String {
    let p = spot(i, r)
    return p.x.toString() + "," + p.y.toString()
}

fn ringPoints(r: Int64) -> String {
    let mut out: Array<String> = []
    let mut i = 0
    while i < progNames().length {
        out.push(pointAt(i, r))
        i = i + 1
    }
    return joinWith(out, " ")
}

export fn radarRings() -> Array<Ring> {
    let mut out: Array<Ring> = []
    let mut step = 1
    while step <= decades() {
        let r = ringRadius(step)
        let power = step - belowBase()
        out.push(Ring {
            id: step.toString(),
            points: ringPoints(r),
            label: ringLabel(power),
            y: (cy() - r).toString(),
            tone: if power == 0 { "ring base" } else { "ring" },
        })
        step = step + 1
    }
    return out
}

fn ringRadius(step: Int64) -> Int64 {
    return (radius() * step + decades() / 2) / decades()
}

fn ringLabel(power: Int64) -> String {
    if power < 0 {
        return "1/" + pow2(0 - power).toString() + "x"
    }
    return pow2(power).toString() + "x"
}

export fn radarSpokes() -> Array<Spoke> {
    let progs = programs()
    let mut out: Array<Spoke> = []
    let mut i = 0
    while i < progs.length {
        let tip = spot(i, radius())
        let label = spot(i, radius() + 32)
        out.push(Spoke {
            key: progs[i].key.copy(),
            name: progs[i].name.copy(),
            x: tip.x.toString(),
            y: tip.y.toString(),
            lx: label.x.toString(),
            ly: labelBaseline(i, label.y),
            anchor: anchorOf(i),
            wedge: wedgeOf(i),
        })
        i = i + 1
    }
    return out
}

fn anchorOf(i: Int64) -> String {
    let half = progNames().length / 2
    if i == 0 || i == half {
        return "middle"
    }
    if i < half {
        return "start"
    }
    return "end"
}

fn labelBaseline(i: Int64, base: Int64) -> String {
    let half = progNames().length / 2
    if i == 0 {
        return (base - 2).toString()
    }
    if i == half {
        return (base + 12).toString()
    }
    return (base + 4).toString()
}

fn wedgeOf(i: Int64) -> String {
    let n = progNames().length
    let leftIdx = (i + n - 1) % n
    let rightIdx = (i + 1) % n
    return midPoint(i, leftIdx) + " " + cx().toString() + "," + cy().toString() + " " + midPoint(i, rightIdx) + " " + pointAt(i, radius() + 20)
}

fn midPoint(a: Int64, b: Int64) -> String {
    let one = spot(a, radius() + 20)
    let two = spot(b, radius() + 20)
    let mx = (one.x + two.x) / 2
    let my = (one.y + two.y) / 2
    return mx.toString() + "," + my.toString()
}

fn numOf(s: String) -> Int64 {
    return match parseFloat64(s) {
        Some(v) => Int64(v),
        None => 0,
    }
}

export fn radarLines() -> Array<Line> {
    let mut out: Array<Line> = []
    for s in contestants() {
        out.push(Line {
            key: s.key.copy(),
            name: s.name.copy(),
            tone: s.tone.copy(),
            points: polygonFor(s.key, "c"),
            marks: marksFor(s.key, "c"),
        })
    }
    return out
}

fn polygonFor(contestant: String, base: String) -> String {
    let progs = programs()
    let mut out: Array<String> = []
    let mut i = 0
    while i < progs.length {
        out.push(pointAt(i, radiusOf(ratioOf(progs[i].key, contestant, base))))
        i = i + 1
    }
    return joinWith(out, " ")
}

export fn ratioWay(program: String, contestant: String, base: String) -> String {
    let h = ratioOf(program, contestant, base)
    if h <= 0 {
        return "level"
    }
    if h < 98 {
        return "ahead"
    }
    if h > 102 {
        return "behind"
    }
    return "level"
}

fn ratioOf(program: String, contestant: String, base: String) -> Int64 {
    return hundredths(medianUs(program, contestant), medianUs(program, base))
}

fn marksFor(contestant: String, base: String) -> Array<Mark> {
    let progs = programs()
    let baseName = if base == "c" { "C" } else { "Rust" }
    let mut out: Array<Mark> = []
    let mut i = 0
    while i < progs.length {
        let h = ratioOf(progs[i].key, contestant, base)
        if offScale(h) {
            out.push(Mark {
                id: progs[i].key.copy(),
                d: chevronAt(i),
                title: progs[i].name + ": " + ratioText(h) + " " + baseName + ", past the " + ringLabel(decades() - belowBase()) + " rim of this scale",
            })
        }
        i = i + 1
    }
    return out
}

fn chevronAt(i: Int64) -> String {
    let a = spot(i, radius() + 6)
    let b = spot(i, radius() + 20)
    return "M " + a.x.toString() + " " + a.y.toString() + " L " + b.x.toString() + " " + b.y.toString()
}

fn readingsFor(program: String) -> Array<Reading> {
    let base = medianUs(program, "c")
    let mut out: Array<Reading> = []
    for s in contestants() {
        let cell = cellOf(program, s.key)
        out.push(Reading {
            key: s.key.copy(),
            name: s.name.copy(),
            tone: s.tone.copy(),
            cpu: secsOf(cell.cpuUs),
            mem: memOf(cell.peakBytes),
            gz: bytesOf(cell.gzBytes),
            make: makeOf(cell.makeUs),
            ms: msOf(cell.us),
            vsC: ratioText(ratioOf(program, s.key, "c")),
            vsRust: ratioText(ratioOf(program, s.key, "rust")),
            pct: trackPct(cell.us, base),
            over: base > 0 && cell.us > base * trackTimes(),
        })
    }
    return out
}

fn trackTimes() -> Int64 {
    return 4
}

fn trackPct(us: Int64, base: Int64) -> String {
    if us <= 0 || base <= 0 {
        return "0.0"
    }
    let full = base * trackTimes()
    return tenthsText(if us >= full { 1000 } else { us * 1000 / full })
}

export fn srcHref(program: String, engine: String) -> String {
    if engine == "c" {
        return ghBlob("bench/harness/c/" + program + ".c")
    }
    if engine == "rust" {
        return ghBlob("bench/harness/rust/" + program + ".rs")
    }
    if engine == "js" {
        return ghBlob("bench/harness/js/" + program + ".js")
    }
    return ghBlob("examples/" + program + ".vyrn")
}

export type BarRow = { key: String, name: String, tone: String, ms: String, pct: String }

export fn panelBars(program: String) -> Array<BarRow> {
    let order = sortBy(readingsFor(program), c -> medianUs(program, c.key))
    let mut top = 1
    for c in order {
        let us = medianUs(program, c.key)
        if us > top {
            top = us
        }
    }
    let mut out: Array<BarRow> = []
    for c in order {
        out.push(BarRow {
            key: c.key.copy(),
            name: c.name.copy(),
            tone: c.tone.copy(),
            ms: c.ms.copy(),
            pct: tenthsText(medianUs(program, c.key) * 1000 / top),
        })
    }
    return out
}

export fn frontPanels() -> Array<Panel> {
    let all = axisPanels()
    let mut out: Array<Panel> = []
    let mut i = 0
    while i < all.length && i < 6 {
        out.push(all[i].copy())
        i = i + 1
    }
    return out
}

export fn panelNote(program: String) -> String {
    for p in programs() {
        if p.key == program {
            return match indexOf(p.note, ". ") {
                Some(at) => substring(p.note, 0, at + 1),
                None => p.note.copy(),
            }
        }
    }
    return ""
}

export fn panelSpeed(program: String) -> String {
    let mut ours = 0
    let mut best = 0
    let mut bestName = ""
    for c in readingsFor(program) {
        if c.key == "vyrn-wasm" {
            continue
        }
        let us = medianUs(program, c.key)
        if us <= 0 {
            continue
        }
        if c.key == "vyrn-native" {
            ours = us
        }
        if best == 0 || us < best {
            best = us
            bestName = c.name.copy()
        }
    }
    if ours == 0 || best == 0 {
        return ""
    }
    if ours <= best {
        return "fastest of the five"
    }
    return ratioText(ours * 100 / best) + " " + bestName
}

fn panelMemRatio(program: String) -> String {
    let mut ours = 0
    let mut worst = 0
    for c in readingsFor(program) {
        let b = cellOf(program, c.key).peakBytes
        if c.key == "vyrn-native" {
            ours = b
        }
        if b > worst {
            worst = b
        }
    }
    if ours <= 0 || worst <= ours {
        return ""
    }
    let tenths = worst * 10 / ours
    if tenths % 10 == 0 {
        return (tenths / 10).toString() + "x less"
    }
    return tenthsText(tenths) + "x less"
}

fn panelMemPair(program: String) -> String {
    let mut ours = ""
    let mut worstName = ""
    let mut worstText = ""
    let mut worst = 0
    let mut runnerName = ""
    let mut runnerText = ""
    let mut runner = 0
    for c in readingsFor(program) {
        let b = cellOf(program, c.key).peakBytes
        if c.key == "vyrn-native" {
            ours = c.mem.copy()
        }
        if b > worst {
            runner = worst
            runnerName = worstName.copy()
            runnerText = worstText.copy()
            worst = b
            worstName = c.name.copy()
            worstText = c.mem.copy()
        } else if b > runner {
            runner = b
            runnerName = c.name.copy()
            runnerText = c.mem.copy()
        }
    }
    if ours.byteLength == 0 || worstText.byteLength == 0 {
        return ""
    }
    if worstName == "Vyrn native" {
        if runnerText.byteLength == 0 {
            return ours + " peak"
        }
        return ours + " peak \u{2014} the most here, over " + runnerName + " " + runnerText
    }
    return ours + " vs " + worstName + " " + worstText
}

export fn panelMemLine(program: String) -> String {
    let pair = panelMemPair(program)
    if pair.byteLength == 0 {
        return ""
    }
    let ratio = panelMemRatio(program)
    if ratio.byteLength == 0 {
        return pair
    }
    return pair + " \u{B7} " + ratio
}

export fn nativeVsRust(program: String) -> String {
    return ratioText(ratioOf(program, "vyrn-native", "rust"))
}

export fn axisPanels() -> Array<Panel> {
    let mut out: Array<Panel> = []
    for p in programs() {
        let row = causeRow(p.key)
        out.push(Panel {
            key: p.key.copy(),
            name: p.name.copy(),
            n: p.n.copy(),
            cause: row.cause.copy(),
            label: row.label.copy(),
            verdict: row.verdict.copy(),
            game: p.game.copy(),
            cells: readingsFor(p.key),
        })
    }
    return out
}

type Cause = { program: String, verdict: String, cause: String, label: String }

fn causeRow(program: String) -> Cause {
    for row in causeRows() {
        if row.program == program {
            return Cause { program: row.program.copy(), verdict: row.verdict.copy(), cause: row.cause.copy(), label: row.label.copy() }
        }
    }
    return Cause { program: "", verdict: "", cause: "", label: "" }
}

fn causeRows() -> Array<Cause> {
    return [
        Cause { program: "nbody", verdict: "a deviation", cause: "Rust's compiler folds the inner loop into instructions that do four sums at once; ours emits them one at a time. What that transformation needs to be safe \u{2014} that two arrays in the loop are never the same array \u{2014} the language already proves, because it uses the same fact to free memory. It does not yet reach the part of the compiler that would act on it.", label: "no vector instructions" },
        Cause { program: "spectralnorm", verdict: "inside the noise band", cause: "", label: "" },
        Cause { program: "fannkuch", verdict: "inside the noise band", cause: "The previous dataset was 679 ms behind Rust, and most of that was one array built fresh 39,916,800 times. The language gained a way to refill a buffer in place instead, and the row moved inside the band the day it landed.", label: "the copy that cost 600 ms" },
        Cause { program: "binarytrees", verdict: "at the edge of the band", cause: "Node wins this one outright, and the WebAssembly build is twice as fast as the native one \u{2014} because it brings its own allocator with it, and the native build asks the operating system for every node. The memory this row used to carry is settled: it peaked above two gigabytes when nothing was being freed, and now sits level with Rust.", label: "who allocates the memory" },
        Cause { program: "fasta", verdict: "a deviation", cause: "What one 60-byte output line costs: an array grown from nothing by doubling, then a check that its bytes are valid text \u{2014} over bytes already known to be plain ASCII \u{2014} and a second allocation, because the program still builds a piece of text per line. A way to write raw bytes straight out exists; this program has not been moved onto it.", label: "the price of one output line" },
        Cause { program: "revcomp", verdict: "a deviation", cause: "Three passes over every byte, and a cost per output line on top: about 120 million appends for 40 million bases, each one a bounds and capacity check into an array that grows by doubling, where Rust's output loop allocates nothing at all. The spread of the whole set is in this one program \u{2014} the C entry is itself four times slower than Rust here, for reading its input a line at a time.", label: "a pass per byte, and a cost per line" },
        Cause { program: "knucleotide", verdict: "ahead of the band", cause: "This row once took 211 times C's time, when looking a key up in a map meant reading every key in it. Maps carry a hash index now, and this program's key is a single number rolled along the sequence rather than a fresh piece of text at every position. Its N moved a hundredfold with this dataset: the old one was chosen for the slow version and outlived it.", label: "faster than C, and why" },
        Cause { program: "pidigits", verdict: "inside the noise band", cause: "", label: "" },
        Cause { program: "mandelbrot", verdict: "inside the noise band", cause: "Floating-point arithmetic with no allocation and no output shaping, so what is measured is the arithmetic \u{2014} which is why even the WebAssembly build, two to fourteen times slower everywhere else, is within 15% of C here. The program is on the list at all because Vyrn can write raw bytes now: this image's pixels are arbitrary bytes, and text cannot carry them.", label: "the closest five readings here" },
        Cause { program: "regexredux", verdict: "a deviation", cause: "The entries are not running comparable engines, which is the first thing to say about the number. Vyrn runs a general-purpose regular-expression engine, written in Vyrn and compiled like any other program. The C and Rust entries carry the smallest matcher that covers this one corpus \u{2014} about sixty lines, hand-fitted to these patterns, no backtracking \u{2014} and node uses the engine built into it. So the gap is the shape of a general engine against a special-cased scan, and not a finding about the language. What it does measure honestly is that Vyrn's engine has had no optimisation work at all.", label: "not the same engine on both sides" },
    ]
}

fn envText() -> String {
    return objectAt(recordText(run1File()), "  ", "environment")
}

export fn benchMachine() -> String {
    let env = envText()
    let hw = objectAt(env, "    ", "hardware")
    let vyrn = objectAt(env, "    ", "vyrn")
    let wasmtime = objectAt(env, "    ", "wasmtime")
    return textAt(hw, "      ", "cpu") + ", " + textAt(env, "    ", "os") + ", " + textAt(vyrn, "      ", "version") + ", wasmtime " + textAt(wasmtime, "      ", "version") + ", " + benchDate()
}

fn benchDate() -> String {
    return textAt(recordText(run1File()), "  ", "date")
}

export fn benchRuns() -> String {
    return scalarAt(recordText(run1File()), "  ", "runs")
}

export fn envRows() -> Array<Array<String>> {
    let env = envText()
    let hw = objectAt(env, "    ", "hardware")
    let vyrn = objectAt(env, "    ", "vyrn")
    let wasmtime = objectAt(env, "    ", "wasmtime")
    let flags = objectAt(env, "    ", "flags")
    // No host row: a machine's name is private.
    return [
        ["Operating system", textAt(env, "    ", "os")],
        ["CPU", textAt(hw, "      ", "cpu") + " (" + scalarAt(hw, "      ", "cores") + " logical cores)"],
        ["Memory", scalarAt(hw, "      ", "ram_gib") + " GiB"],
        ["clang", textAt(env, "    ", "clang")],
        ["rustc", textAt(env, "    ", "rustc")],
        ["node", textAt(env, "    ", "node")],
        ["python", textAt(env, "    ", "python")],
        ["vyrn", textAt(vyrn, "      ", "version") + " at " + textAt(vyrn, "      ", "commit")],
        ["wasmtime", textAt(wasmtime, "      ", "version") + ", sha256 " + textAt(wasmtime, "      ", "lock_sha256")],
        ["C flags", textAt(flags, "      ", "c")],
        ["Rust flags", textAt(flags, "      ", "rust")],
        ["JavaScript", textAt(flags, "      ", "js")],
        ["Vyrn native", textAt(flags, "      ", "vyrn-native")],
        ["Vyrn wasm", textAt(flags, "      ", "vyrn-wasm")],
    ]
}

test "the record still has the shape this reader cuts" {
    loadCells()
    assertEq(cells.length, 50)
    for c in cells {
        assert(c.us > 0)
        assert(c.cpuUs > 0)
        assert(c.peakBytes > 0)
    }
    assertEq(benchDate(), "2026-09-01")
    assertEq(benchRuns(), "10")
}

test "the medians are the ones the published record holds" {
    assertEq(msOf(medianUs("nbody", "c")), "897 ms")
    assertEq(msOf(medianUs("nbody", "rust")), "659 ms")
    assertEq(msOf(medianUs("nbody", "js")), "1125 ms")
    assertEq(msOf(medianUs("nbody", "vyrn-native")), "882 ms")
    assertEq(msOf(medianUs("nbody", "vyrn-wasm")), "12511 ms")
    assertEq(msOf(medianUs("knucleotide", "c")), "313 ms")
    assertEq(msOf(medianUs("knucleotide", "rust")), "221 ms")
    assertEq(msOf(medianUs("knucleotide", "vyrn-native")), "125 ms")
    assertEq(msOf(medianUs("binarytrees", "js")), "436 ms")
    assertEq(msOf(medianUs("pidigits", "vyrn-native")), "1330 ms")
}

test "the normalized figures are the ones the record computes" {
    assertEq(ratioText(ratioOf("nbody", "vyrn-native", "c")), "0.98x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-wasm", "c")), "13.95x")
    assertEq(ratioText(ratioOf("spectralnorm", "vyrn-native", "c")), "1.04x")
    assertEq(ratioText(ratioOf("binarytrees", "js", "c")), "0.47x")
    assertEq(ratioText(ratioOf("revcomp", "rust", "c")), "0.22x")
    assertEq(ratioText(ratioOf("knucleotide", "vyrn-native", "c")), "0.40x")
    assertEq(ratioText(ratioOf("knucleotide", "vyrn-wasm", "c")), "0.96x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-native", "rust")), "1.34x")
    assertEq(ratioText(ratioOf("pidigits", "vyrn-native", "rust")), "1.00x")
    assertEq(ratioText(ratioOf("revcomp", "vyrn-native", "rust")), "7.83x")
}

test "the log scale puts a doubling on every ring" {
    assertEq(radiusOf(100), ringRadius(belowBase()))
    assertEq(radiusOf(200), ringRadius(belowBase() + 1))
    assertEq(radiusOf(400), ringRadius(belowBase() + 2))
    assertEq(radiusOf(50), ringRadius(belowBase() - 1))
    assertEq(radiusOf(100), 86)
    assertEq(radiusOf(200), 114)
    assertEq(radiusOf(12), 0)
    assertEq(radiusOf(1600), radius())
    assertEq(radiusOf(30200), radius())
    assertEq(ringLabel(0 - 3), "1/8x")
    assertEq(ringLabel(0), "1x")
    assertEq(ringLabel(4), "16x")
}

test "no cell is ever silently truncated" {
    let mut clamped = 0
    let mut marked = 0
    for line in radarLines() {
        marked = marked + line.marks.length
        for p in programs() {
            if offScale(ratioOf(p.key, line.key, "c")) {
                clamped = clamped + 1
            }
        }
    }
    assertEq(clamped, marked)
    assertEq(clamped, 0)
    for line in radarLines() {
        for p in programs() {
            assert(radiusOf(ratioOf(p.key, line.key, "c")) > 0)
        }
    }
}

test "every polygon has one vertex per program" {
    for line in radarLines() {
        assertEq(split(line.points, " ").length, programs().length)
    }
    assertEq(radarLines().length, 5)
    let base = radarRings()[belowBase() - 1]
    assertEq(radarLines()[0].points, base.points)
    assertEq(base.label, "1x")
    assertEq(base.tone, "ring base")
}

test "no axis name runs off the sheet" {
    let spokes = radarSpokes()
    let mut i = 0
    while i < spokes.length {
        let x = numOf(spokes[i].lx)
        let room = spokes[i].name.byteLength * 6
        if spokes[i].anchor == "start" {
            assert(x + room <= 700)
        }
        if spokes[i].anchor == "end" {
            assert(x - room >= 0)
        }
        i = i + 1
    }
}

test "every axis carries a name, a spoke and a wedge to reach it" {
    let spokes = radarSpokes()
    assertEq(spokes.length, 10)
    assertEq(spokes[0].key, "nbody")
    assertEq(spokes[0].anchor, "middle")
    assertEq(spokes[2].anchor, "start")
    assertEq(spokes[5].anchor, "middle")
    assertEq(spokes[7].anchor, "end")
    for s in spokes {
        assert(s.name.byteLength > 0)
        assert(split(s.wedge, " ").length == 4)
    }
}

test "a panel is the whole of what is known about one program" {
    let panels = axisPanels()
    assertEq(panels.length, 10)
    for p in panels {
        assertEq(p.cells.length, 5)
        assert(p.verdict.byteLength > 0)
    }
    assertEq(panels[0].n, "25,000,000")
    assertEq(panels[0].cells[0].ms, "897 ms")
    assertEq(panels[0].cells[3].vsC, "0.98x")
    assertEq(panels[0].cells[3].vsRust, "1.34x")
    assertEq(nativeVsRust("nbody"), "1.34x")
    assertEq(nativeVsRust("pidigits"), "1.00x")
    assertEq(nativeVsRust("knucleotide"), "0.57x")
    assertEq(panels[1].verdict, "inside the noise band")
    assertEq(panels[2].verdict, "inside the noise band")
    assertEq(panels[3].verdict, "at the edge of the band")
    assertEq(panels[6].verdict, "ahead of the band")
    assertEq(panels[7].verdict, "inside the noise band")
}

test "the caption names the hardware and the toolchain, and never the machine" {
    let cap = benchMachine()
    assert(contains(cap, "Ryzen"))
    assert(contains(cap, "wasmtime 46.0.1"))
    assert(contains(cap, "2026-09-01"))
    assertEq(envRows().length, 14)
    for row in envRows() {
        assert(row[0].byteLength > 0)
        assert(row[1].byteLength > 0)
        assert(row[0] != "Host")
    }
    assert(!contains(envText(), "\"host\""))
}

test "every program links to the game's own page for it" {
    let progs = programs()
    assertEq(progs.length, 10)
    for p in progs {
        assert(contains(p.game, "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/"))
        assert(contains(p.game, ".html"))
    }
    assertEq(progs[2].key, "fannkuch")
    assertEq(progs[2].name, "fannkuch-redux")
    assert(contains(progs[2].game, "/fannkuchredux.html"))
    assert(contains(progs[1].game, "/spectralnorm.html"))
    assert(contains(progs[6].game, "/knucleotide.html"))
    assert(contains(progs[5].game, "/revcomp.html"))
}

test "every cell carries the columns the game prints" {
    for p in programs() {
        let cells = readingsFor(p.key)
        assertEq(cells.length, 5)
        for c in cells {
            assert(c.cpu.byteLength > 0)
            assert(c.mem.byteLength > 2)
            assert(c.gz.byteLength > 2)
        }
        assertEq(cells[2].make, "\u{2014}")
        assert(cells[0].make != "\u{2014}")
        assert(cells[3].make != "\u{2014}")
    }
}

test "every bar is measured against the same track, and none is clipped in silence" {
    assertEq(trackPct(medianUs("nbody", "c"), medianUs("nbody", "c")), "25.0")
    for p in programs() {
        let base = medianUs(p.key, "c")
        for c in readingsFor(p.key) {
            if c.key == "c" {
                assertEq(c.pct, "25.0")
            }
            assertEq(c.over, medianUs(p.key, c.key) > base * 4)
            if c.over {
                assertEq(c.pct, "100.0")
            } else {
                assert(c.pct != "100.0")
            }
        }
    }
    let mut past: Array<String> = []
    for p in programs() {
        for c in readingsFor(p.key) {
            if c.over {
                past.push(p.key + "/" + c.key)
            }
        }
    }
    assertEq(joinWith(past, " "), "nbody/vyrn-wasm regexredux/vyrn-native regexredux/vyrn-wasm")
}

test "every row points at the program behind it" {
    for p in programs() {
        assertEq(srcHref(p.key, "c"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/c/" + p.key + ".c")
        assertEq(srcHref(p.key, "rust"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/rust/" + p.key + ".rs")
        assertEq(srcHref(p.key, "js"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/js/" + p.key + ".js")
        assertEq(srcHref(p.key, "vyrn-native"), srcHref(p.key, "vyrn-wasm"))
        assertEq(srcHref(p.key, "vyrn-native"), "https://github.com/vyrn-lang/vyrn/blob/main/examples/" + p.key + ".vyrn")
    }
}

test "a row with nothing to explain explains nothing" {
    let mut silent = 0
    for p in axisPanels() {
        if p.cause.byteLength == 0 {
            assertEq(p.label, "")
            assertEq(p.verdict, "inside the noise band")
            silent = silent + 1
            continue
        }
        assert(p.label.byteLength > 0)
        assert(p.label.byteLength < 40)
        assert(p.cause.byteLength > 40)
        assert(!contains(p.cause, "Not a deviation"))
        assert(!contains(p.cause, "noise band"))
    }
    assertEq(silent, 2)
    for p in axisPanels() {
        if p.verdict == "a deviation" {
            assert(p.cause.byteLength > 40)
        }
    }
}

test "the page names no design record and no internal symbol" {
    let banned = ["RFC-", "std/", "noalias", "malloc", "sqrt", "()", "Int64", "wasm ", "UTF-8", "V8"]
    for row in causeRows() {
        for word in banned {
            assert(!contains(row.cause, word))
            assert(!contains(row.label, word))
        }
    }
}

test "a second, a memory size and a byte count read the way the game prints them" {
    assertEq(secsOf(898000), "0.90")
    assertEq(secsOf(13029000), "13.03")
    assertEq(secsOf(10100), "0.01")
    assertEq(secsOf(4000), "<0.01")
    assertEq(secsOf(0), "0.00")
    assertEq(secsOf(0 - 1), "\u{2014}")
    assertEq(makeOf(0), "\u{2014}")
    assertEq(makeOf(591825), "0.59")
    assertEq(memOf(4386816), "4,284 KB")
    assertEq(memOf(41000000), "39.1 MB")
    assertEq(memOf(0), "\u{2014}")
    assertEq(bytesOf(1168), "1,168")
    assertEq(bytesOf(0), "\u{2014}")
}

test "no escape survives into the page" {
    assertEq(unescaped("100,000 \\u2014 a hundred"), "100,000 \u{2014} a hundred")
    assertEq(unescaped("\\\\w+"), "\\w+")
    assertEq(unescaped("line\\nbreak"), "line\nbreak")
    assertEq(unescaped("nothing to undo"), "nothing to undo")
    assertEq(charOf(65), "A")
    assertEq(charOf(233), "\u{E9}")
    assertEq(charOf(8212), "\u{2014}")
    assertEq(hexAt("\\u2014", 2), 8212)
    assertEq(hexAt("00ff", 0), 255)
    assertEq(hexAt("00FF", 0), 255)
    for prog in programs() {
        assert(!contains(prog.note, "\\"))
    }
    for row in envRows() {
        assert(!contains(row[1], "\\"))
    }
}

test "a thousands separator lands every three digits and nowhere else" {
    assertEq(grouped("25000000"), "25,000,000")
    assertEq(grouped("100"), "100")
    assertEq(grouped("1000"), "1,000")
    assertEq(grouped("11"), "11")
}

test "a duration and a ratio read the way the record's tables print them" {
    assertEq(msOf(898000), "898 ms")
    assertEq(msOf(10100), "10.1 ms")
    assertEq(msOf(99900), "99.9 ms")
    assertEq(msOf(100000), "100 ms")
    assertEq(ratioText(97), "0.97x")
    assertEq(ratioText(1452), "14.52x")
    assertEq(ratioText(9999), "99.99x")
    assertEq(ratioText(10000), "100x")
    assertEq(ratioText(28700), "287x")
}
