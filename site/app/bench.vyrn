/// The Benchmarks Game data behind `/benchmarks` and the index's benchmark
/// cards, read at export time from the record `bench/harness/run.py` writes.
/// No figure on either page is typed in.
///
/// The record is cut with `indexOf` and `substring`, not parsed: `run.py`
/// writes `json.dump(indent=2)`, so every key sits at a known indentation.
/// `std/jsonread` took 72 s on one record under the interpreter; this reader
/// takes 0.3 s. The test "the record still has the shape this reader cuts"
/// fails when `run.py` changes the shape.
///
/// The radar's radial axis is log2 around the baseline: the centre is 1/8x,
/// each ring out is a doubling, and the rim is 16x. A value past the rim is
/// drawn at the rim with an off-scale mark on its spoke.
import { indexOf, substring, trim, split, joinWith, padStart } from "std/strings"
import { contains } from "std/strpred"
import { sortBy } from "std/arrays"
import { parseFloat64 } from "std/num"
import { sin, cos } from "std/math"
import { ghBlob } from "./github"

/// One measured cell: one program on one engine.
///
/// Times are integer microseconds. The record holds float seconds, and integer
/// microseconds carry every figure the pages print with no float arithmetic
/// between the record and the reader. A field the reader could not cut is -1.
export type Measure = {
    program: String,
    contestant: String,
    us: Int64,
    cpuUs: Int64,
    peakBytes: Int64,
    makeUs: Int64,
    gzBytes: Int64,
}

/// One program: the record's key, the game's name for it, its N, the harness's
/// note, and the game's own page for it.
export type Prog = { key: String, name: String, n: String, note: String, game: String }

/// One contestant: the key in the record, the name a reader sees, and the class
/// the stylesheet colours it with.
export type Series = { key: String, name: String, tone: String }

/// One ring of the radar: its polygon, its label and where the label sits.
export type Ring = { id: String, points: String, label: String, y: String, tone: String }

/// One axis: the spoke, where its name goes, and the hit wedge behind it.
export type Spoke = { key: String, name: String, x: String, y: String, lx: String, ly: String, anchor: String, wedge: String }

/// One contestant's polygon against C, with its off-scale marks.
export type Line = { key: String, name: String, tone: String, points: String, marks: Array<Mark> }

/// A point past the rim: drawn at the rim, and named here.
export type Mark = { id: String, d: String, title: String }

/// One row of a program's table. `cpu`, `mem`, `gz` and `make` are the
/// Benchmarks Game's own columns, in its order.
export type Reading = { key: String, name: String, tone: String, cpu: String, mem: String, gz: String, make: String, ms: String, vsC: String, vsRust: String, pct: String, over: Bool }

/// Everything known about one program.
export type Panel = { key: String, name: String, n: String, cause: String, label: String, verdict: String, game: String, cells: Array<Reading> }

/// The published record.
export fn run1File() -> String {
    return "bench/results/2026-09-01.json"
}

/// The published record on GitHub, for the page's provenance line.
export fn run1Href() -> String {
    return ghBlob(run1File())
}

/// The text after the first `needle`, or nothing.
fn after(src: String, needle: String) -> String {
    return match indexOf(src, needle) {
        Some(at) => substring(src, at + needle.byteLength, src.byteLength),
        None => "",
    }
}

/// The text before the first `needle`, or all of it.
fn upTo(src: String, needle: String) -> String {
    return match indexOf(src, needle) {
        Some(at) => substring(src, 0, at),
        None => src.copy(),
    }
}

/// The object written for `key` at `indent` spaces of depth, cut at the next key
/// of the same depth. Under `json.dump(indent=2)` only a key at depth d can
/// start a line at that indentation.
fn objectAt(src: String, indent: String, key: String) -> String {
    return upTo(after(src, "\n" + indent + "\"" + key + "\": {"), "\n" + indent + "\"")
}

/// The scalar written for `key` at `indent` spaces of depth: the text between the
/// colon and the end of its line, without a trailing comma.
fn scalarAt(src: String, indent: String, key: String) -> String {
    let raw = upTo(after(src, "\n" + indent + "\"" + key + "\": "), "\n")
    let cut = if raw.byteLength > 0 && substring(raw, raw.byteLength - 1, raw.byteLength) == "," {
        substring(raw, 0, raw.byteLength - 1)
    } else {
        raw.copy()
    }
    return trim(cut)
}

/// A string scalar without its quotes, its escapes undone.
fn textAt(src: String, indent: String, key: String) -> String {
    let raw = scalarAt(src, indent, key)
    if raw.byteLength >= 2 && substring(raw, 0, 1) == "\"" {
        return unescaped(substring(raw, 1, raw.byteLength - 1))
    }
    return unescaped(raw)
}

/// A JSON string body as the characters it stands for.
///
/// `json.dump` writes every non-ASCII character as `\uXXXX` and doubles every
/// backslash. This decodes `\u` escapes in the BMP and the short escapes, which
/// cover everything `run.py` writes; a surrogate pair is not decoded, and the
/// test "no escape survives into the page" catches one.
fn unescaped(text: String) -> String {
    if !contains(text, "\\") {
        return text.copy()
    }
    let raw = bytes(text)
    let mut out = ""
    let mut i = 0
    while i < raw.length {
        if raw[i] != '\\' || i + 1 >= raw.length {
            out = out + substring(text, i, i + 1)
            i = i + 1
            continue
        }
        let c = raw[i + 1]
        if c == 'u' && i + 5 < raw.length {
            out = out + charOf(hexAt(text, i + 2))
            i = i + 6
            continue
        }
        if c == 'n' {
            out = out + "\n"
        } else if c == 't' {
            out = out + "\t"
        } else if c == 'r' {
            out = out + "\r"
        } else {
            // `\\`, `\"`, `\/` and any unknown escape stand for the character
            // after the backslash.
            out = out + substring(text, i + 1, i + 2)
        }
        i = i + 2
    }
    return out
}

/// The four hex digits at `at`, as a number.
fn hexAt(text: String, at: Int64) -> Int64 {
    let raw = bytes(text)
    let mut n = 0
    let mut i = at
    while i < at + 4 {
        let b = Int64(raw[i])
        let d = if b >= 48 && b <= 57 {
            b - 48
        } else if b >= 97 && b <= 102 {
            b - 87
        } else {
            b - 55
        }
        n = n * 16 + d
        i = i + 1
    }
    return n
}

/// One code point below U+10000, as UTF-8. The boundaries are numbers because
/// a byte literal is a `UInt8` and the code point is an `Int64`.
fn charOf(cp: Int64) -> String {
    let mut raw: Array<UInt8> = []
    if cp < 128 {
        raw.push(UInt8(cp))
    } else if cp < 2048 {
        raw.push(UInt8(192 + cp / 64))
        raw.push(UInt8(128 + cp % 64))
    } else {
        raw.push(UInt8(224 + cp / 4096))
        raw.push(UInt8(128 + (cp / 64) % 64))
        raw.push(UInt8(128 + cp % 64))
    }
    return match stringFromBytes(raw) {
        Ok(text) => text,
        // Only a lone surrogate reaches here; it decodes to nothing rather than
        // to invalid UTF-8.
        Err(_) => "",
    }
}

/// Seconds, as the record writes them, in whole microseconds. A reading the
/// reader could not cut is -1, because a zero would plot as a real point.
fn microsOf(text: String) -> Int64 {
    return match parseFloat64(text) {
        Some(s) => Int64(s * 1000000.0 + 0.5),
        None => 0 - 1,
    }
}

/// Each record file's text, read once. The templates call the accessors below
/// inside every loop they draw.
let mut records: Map<String, String> = [:]

fn recordText(file: String) -> String {
    if let Some(hit) = records[file] {
        return hit.copy()
    }
    let body = match readFile(file) {
        Ok(text) => text.copy(),
        Err(why) => "",
    }
    records[file.copy()] = body.copy()
    return body
}

// The ten programs and the five contestants are written out here, not
// discovered in the record, so a program missing from a re-run fails "the
// record still has the shape this reader cuts" instead of shrinking the chart.

/// The ten programs, in the record's order, filled on first use.
let mut progs: Array<Prog> = []

export fn programs() -> Array<Prog> {
    if progs.length > 0 {
        return progs.copy()
    }
    let src = recordText(run1File())
    let results = objectAt(src, "  ", "results")
    let mut out: Array<Prog> = []
    for p in progNames() {
        let slice = objectAt(results, "    ", p[0])
        out.push(Prog {
            key: p[0].copy(),
            name: p[1].copy(),
            n: grouped(scalarAt(slice, "      ", "n")),
            note: textAt(slice, "      ", "note"),
            game: gameHref(p[2]),
        })
    }
    progs = out.copy()
    return out
}

/// Each program's record key, the game's name for it, and the slug of its page
/// on the game's site. The three spellings do not derive from one another:
/// `fannkuch`, `fannkuch-redux`, `fannkuchredux`.
fn progNames() -> Array<Array<String>> {
    return [
        ["nbody", "nbody", "nbody"],
        ["spectralnorm", "spectral-norm", "spectralnorm"],
        ["fannkuch", "fannkuch-redux", "fannkuchredux"],
        ["binarytrees", "binary-trees", "binarytrees"],
        ["fasta", "fasta", "fasta"],
        ["revcomp", "reverse-complement", "revcomp"],
        ["knucleotide", "k-nucleotide", "knucleotide"],
        ["pidigits", "pidigits", "pidigits"],
        ["mandelbrot", "mandelbrot", "mandelbrot"],
        ["regexredux", "regex-redux", "regexredux"],
    ]
}

/// The game's own page for one program.
fn gameHref(slug: String) -> String {
    return "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/" + slug + ".html"
}

/// The five contestants. `c` is the baseline.
export fn contestants() -> Array<Series> {
    return [
        Series { key: "c", name: "C", tone: "sr-c" },
        Series { key: "rust", name: "Rust", tone: "sr-rust" },
        Series { key: "js", name: "node", tone: "sr-node" },
        Series { key: "vyrn-native", name: "Vyrn native", tone: "sr-vyrn" },
        Series { key: "vyrn-wasm", name: "Vyrn wasm", tone: "sr-vyrn dashed" },
    ]
}

/// The fifty cells, ten programs by five contestants, filled on first use.
let mut cells: Array<Measure> = []

fn loadCells() {
    if cells.length > 0 {
        return
    }
    let results = objectAt(recordText(run1File()), "  ", "results")
    for p in progNames() {
        let box = objectAt(objectAt(results, "    ", p[0]), "      ", "contestants")
        for s in contestants() {
            let cell = objectAt(box, "        ", s.key)
            cells.push(Measure {
                program: p[0].copy(),
                contestant: s.key.copy(),
                us: microsOf(scalarAt(cell, "          ", "median_s")),
                cpuUs: microsOf(scalarAt(cell, "          ", "cpu_median_s")),
                peakBytes: wholeOf(scalarAt(cell, "          ", "peak_bytes")),
                makeUs: microsOf(scalarAt(cell, "          ", "make_s")),
                gzBytes: wholeOf(scalarAt(cell, "          ", "gz_bytes")),
            })
        }
    }
}

/// One cell, or a cell of -1 when the record does not hold it.
fn cellOf(program: String, contestant: String) -> Measure {
    loadCells()
    for c in cells {
        if c.program == program && c.contestant == contestant {
            return c.copy()
        }
    }
    return Measure {
        program: program.copy(),
        contestant: contestant.copy(),
        us: 0 - 1,
        cpuUs: 0 - 1,
        peakBytes: 0 - 1,
        makeUs: 0 - 1,
        gzBytes: 0 - 1,
    }
}

/// The median of `program` on `contestant`, in microseconds. `chart.vyrn`
/// reads it for bar widths.
export fn medianUs(program: String, contestant: String) -> Int64 {
    return cellOf(program, contestant).us
}

/// A count of tenths as text with one decimal: 123 is `12.3`.
fn tenthsText(t: Int64) -> String {
    return (t / 10).toString() + "." + (t % 10).toString()
}

/// A count of hundredths as text with two decimals: 1452 is `14.52`.
fn hundredthsText(h: Int64) -> String {
    return (h / 100).toString() + "." + padStart((h % 100).toString(), 2, "0")
}

/// Microseconds as milliseconds: whole from 100 ms up, one decimal below, where
/// a reading is close enough to the process floor for the decimal to matter.
export fn msOf(us: Int64) -> String {
    if us < 0 {
        return "\u{2014}"
    }
    if us >= 100000 {
        return ((us + 500) / 1000).toString() + " ms"
    }
    return tenthsText((us + 50) / 100) + " ms"
}

/// A whole number the record wrote, or -1 where it wrote nothing.
fn wholeOf(text: String) -> Int64 {
    return match parseFloat64(text) {
        Some(v) => Int64(v),
        None => 0 - 1,
    }
}

/// Seconds to two decimals, as the game's own tables print them. A reading that
/// would round to `0.00` prints `<0.01`, because the column cannot resolve it
/// and the program did take time.
fn secsOf(us: Int64) -> String {
    if us < 0 {
        return "\u{2014}"
    }
    let cs = (us + 5000) / 10000
    if cs == 0 && us > 0 {
        return "<0.01"
    }
    return hundredthsText(cs)
}

/// Build time. Zero is node, which has no build step, so it prints a dash.
fn makeOf(us: Int64) -> String {
    if us == 0 {
        return "\u{2014}"
    }
    return secsOf(us)
}

/// Peak resident memory: kilobytes below 10 MB, megabytes to one decimal above.
fn memOf(bytes: Int64) -> String {
    if bytes <= 0 {
        return "\u{2014}"
    }
    let kb = (bytes + 512) / 1024
    if kb < 10240 {
        return grouped(kb.toString()) + " KB"
    }
    let tenths = (bytes * 10 + 524288) / 1048576
    return grouped((tenths / 10).toString()) + "." + (tenths % 10).toString() + " MB"
}

/// A byte count, grouped: the game's `gz` column, the gzipped source size.
fn bytesOf(n: Int64) -> String {
    if n <= 0 {
        return "\u{2014}"
    }
    return grouped(n.toString())
}

/// `a / b` in hundredths, rounded.
fn hundredths(a: Int64, b: Int64) -> Int64 {
    if b <= 0 {
        return 0
    }
    return (a * 100 + b / 2) / b
}

/// A ratio in hundredths as text: two decimals below 100x, whole from 100x up.
fn ratioText(h: Int64) -> String {
    if h <= 0 {
        return "\u{2014}"
    }
    if h >= 10000 {
        return ((h + 50) / 100).toString() + "x"
    }
    return hundredthsText(h) + "x"
}

/// An integer's digits with a comma every three.
fn grouped(digits: String) -> String {
    let raw = trim(digits)
    let mut out = ""
    let mut i = 0
    let n = raw.byteLength
    while i < n {
        if i > 0 && (n - i) % 3 == 0 {
            out = out + ","
        }
        out = out + substring(raw, i, i + 1)
        i = i + 1
    }
    return out
}

/// The radar's centre. The box is 700 wide so the horizontal axis names,
/// `k-nucleotide` and `fannkuch-redux`, stay on the sheet; the test "no axis
/// name runs off the sheet" holds that.
fn cx() -> Int64 {
    return 350
}

fn cy() -> Int64 {
    return 272
}

/// The rim's radius.
fn radius() -> Int64 {
    return 200
}

/// How many doublings lie between the centre and the rim.
fn decades() -> Int64 {
    return 7
}

/// How many of those doublings lie below the baseline.
fn belowBase() -> Int64 {
    return 3
}

export fn radarBox() -> String {
    return "0 0 700 544"
}

export fn radarCx() -> String {
    return cx().toString()
}

export fn radarCy() -> String {
    return cy().toString()
}

/// The base-2 logarithm of `x` for x > 0; `std/math` has none. `x` is folded
/// into [1/sqrt(2), sqrt(2)), where the atanh series argument is at most 0.172
/// and twenty terms exceed any precision printed here.
fn log2(x: Float64) -> Float64 {
    if x <= 0.0 {
        return 0.0 - 1000.0
    }
    let mut m = x
    let mut e = 0
    while m >= 1.4142135623730951 {
        m = m / 2.0
        e = e + 1
    }
    while m < 0.7071067811865476 {
        m = m * 2.0
        e = e - 1
    }
    let z = (m - 1.0) / (m + 1.0)
    let zz = z * z
    let mut term = z
    let mut sum = z
    let mut k = 1
    while k < 20 {
        term = term * zz
        sum = sum + term / Float64(2 * k + 1)
        k = k + 1
    }
    // ln(m) = 2 * sum, and log2(m) = ln(m) / ln(2).
    return Float64(e) + 2.0 * sum / 0.6931471805599453
}

/// How far out a ratio in hundredths plots. Past the rim it is the rim, and
/// `marksFor` marks it.
fn radiusOf(h: Int64) -> Int64 {
    if h <= 0 {
        return 0
    }
    let steps = log2(Float64(h) / 100.0) + Float64(belowBase())
    if steps <= 0.0 {
        return 0
    }
    let r = steps * Float64(radius()) / Float64(decades())
    if r >= Float64(radius()) {
        return radius()
    }
    return Int64(r + 0.5)
}

/// Whether a ratio in hundredths is past the rim.
fn offScale(h: Int64) -> Bool {
    return h > 100 * pow2(decades() - belowBase())
}

/// Two to the power of `n`, for `n >= 0`.
fn pow2(n: Int64) -> Int64 {
    let mut v = 1
    let mut i = 0
    while i < n {
        v = v * 2
        i = i + 1
    }
    return v
}

/// The angle of axis `i`, in radians, clockwise from straight up.
fn angleOf(i: Int64) -> Float64 {
    return Float64(i) * 6.283185307179586 / Float64(progNames().length)
}

/// The point `r` out along axis `i`, as `x,y`.
fn pointAt(i: Int64, r: Int64) -> String {
    let a = angleOf(i)
    let x = Float64(cx()) + Float64(r) * sin(a)
    let y = Float64(cy()) - Float64(r) * cos(a)
    return Int64(x + 0.5).toString() + "," + Int64(y + 0.5).toString()
}

/// A closed ring at radius `r`, as a polygon's points.
fn ringPoints(r: Int64) -> String {
    let mut out: Array<String> = []
    let mut i = 0
    while i < progNames().length {
        out.push(pointAt(i, r))
        i = i + 1
    }
    return joinWith(out, " ")
}

/// The rings, one per doubling. The baseline ring has the tone `ring base`.
export fn radarRings() -> Array<Ring> {
    let mut out: Array<Ring> = []
    let mut step = 1
    while step <= decades() {
        let r = ringRadius(step)
        let power = step - belowBase()
        out.push(Ring {
            id: step.toString(),
            points: ringPoints(r),
            label: ringLabel(power),
            y: (cy() - r).toString(),
            tone: if power == 0 { "ring base" } else { "ring" },
        })
        step = step + 1
    }
    return out
}

/// How far out ring `step` sits, rounded as `radiusOf` rounds, so a point worth
/// a ring's value sits on that ring.
fn ringRadius(step: Int64) -> Int64 {
    return (radius() * step + decades() / 2) / decades()
}

/// What a ring is worth, as a multiple of the baseline.
fn ringLabel(power: Int64) -> String {
    if power < 0 {
        return "1/" + pow2(0 - power).toString() + "x"
    }
    return pow2(power).toString() + "x"
}

/// The ten spokes: the line, the name at its end, and the wedge a pointer
/// hovers to select the axis.
export fn radarSpokes() -> Array<Spoke> {
    let progs = programs()
    let mut out: Array<Spoke> = []
    let mut i = 0
    while i < progs.length {
        let tip = split(pointAt(i, radius()), ",")
        let label = split(pointAt(i, radius() + 32), ",")
        out.push(Spoke {
            key: progs[i].key.copy(),
            name: progs[i].name.copy(),
            x: tip[0].copy(),
            y: tip[1].copy(),
            lx: label[0].copy(),
            ly: labelBaseline(i, label[1]),
            anchor: anchorOf(i),
            wedge: wedgeOf(i),
        })
        i = i + 1
    }
    return out
}

/// Which side of its spoke's end a name sits on: centred straight up and
/// straight down, otherwise on the side the spoke points to.
fn anchorOf(i: Int64) -> String {
    let half = progNames().length / 2
    if i == 0 || i == half {
        return "middle"
    }
    if i < half {
        return "start"
    }
    return "end"
}

/// A name's baseline, nudged so the top name clears the rim and the bottom one
/// hangs below it.
fn labelBaseline(i: Int64, y: String) -> String {
    let base = match parseFloat64(y) {
        Some(v) => Int64(v),
        None => cy(),
    }
    let half = progNames().length / 2
    if i == 0 {
        return (base - 2).toString()
    }
    if i == half {
        return (base + 12).toString()
    }
    return (base + 4).toString()
}

/// The hit wedge behind axis `i`: a quadrilateral from the centre out to the
/// midpoints with the neighbouring axes, so a pointer near a spoke selects it.
fn wedgeOf(i: Int64) -> String {
    let n = progNames().length
    let leftIdx = (i + n - 1) % n
    let rightIdx = (i + 1) % n
    return midPoint(i, leftIdx) + " " + cx().toString() + "," + cy().toString() + " " + midPoint(i, rightIdx) + " " + pointAt(i, radius() + 20)
}

/// Halfway between two axes, just outside the rim.
fn midPoint(a: Int64, b: Int64) -> String {
    let one = split(pointAt(a, radius() + 20), ",")
    let two = split(pointAt(b, radius() + 20), ",")
    let mx = (numOf(one[0]) + numOf(two[0])) / 2
    let my = (numOf(one[1]) + numOf(two[1])) / 2
    return mx.toString() + "," + my.toString()
}

fn numOf(s: String) -> Int64 {
    return match parseFloat64(s) {
        Some(v) => Int64(v),
        None => 0,
    }
}

/// One polygon per contestant, against C, with its off-scale marks.
export fn radarLines() -> Array<Line> {
    let mut out: Array<Line> = []
    for s in contestants() {
        out.push(Line {
            key: s.key.copy(),
            name: s.name.copy(),
            tone: s.tone.copy(),
            points: polygonFor(s.key, "c"),
            marks: marksFor(s.key, "c"),
        })
    }
    return out
}

/// One contestant's ten vertices against `base`.
fn polygonFor(contestant: String, base: String) -> String {
    let progs = programs()
    let mut out: Array<String> = []
    let mut i = 0
    while i < progs.length {
        out.push(pointAt(i, radiusOf(ratioOf(progs[i].key, contestant, base))))
        i = i + 1
    }
    return joinWith(out, " ")
}

/// Whether `contestant` is `ahead` of, `level` with or `behind` `base` on
/// `program`. Level is the +/-2% band, inside the record's noise.
export fn ratioWay(program: String, contestant: String, base: String) -> String {
    let h = ratioOf(program, contestant, base)
    if h <= 0 {
        return "level"
    }
    if h < 98 {
        return "ahead"
    }
    if h > 102 {
        return "behind"
    }
    return "level"
}

/// The ratio of `contestant` to `base` on `program`, in hundredths.
fn ratioOf(program: String, contestant: String, base: String) -> Int64 {
    return hundredths(medianUs(program, contestant), medianUs(program, base))
}

/// Every point of one contestant past the rim, as a mark on its own spoke that
/// names the real figure.
fn marksFor(contestant: String, base: String) -> Array<Mark> {
    let progs = programs()
    let baseName = if base == "c" { "C" } else { "Rust" }
    let mut out: Array<Mark> = []
    let mut i = 0
    while i < progs.length {
        let h = ratioOf(progs[i].key, contestant, base)
        if offScale(h) {
            out.push(Mark {
                id: progs[i].key.copy(),
                d: chevronAt(i),
                title: progs[i].name + ": " + ratioText(h) + " " + baseName + ", past the " + ringLabel(decades() - belowBase()) + " rim of this scale",
            })
        }
        i = i + 1
    }
    return out
}

/// The off-scale mark on axis `i`: a stroke continuing outward past the rim.
fn chevronAt(i: Int64) -> String {
    let a = split(pointAt(i, radius() + 6), ",")
    let b = split(pointAt(i, radius() + 20), ",")
    return "M " + a[0] + " " + a[1] + " L " + b[0] + " " + b[1]
}

/// One program's five readings.
fn readingsFor(program: String) -> Array<Reading> {
    let base = medianUs(program, "c")
    let mut out: Array<Reading> = []
    for s in contestants() {
        let cell = cellOf(program, s.key)
        out.push(Reading {
            key: s.key.copy(),
            name: s.name.copy(),
            tone: s.tone.copy(),
            cpu: secsOf(cell.cpuUs),
            mem: memOf(cell.peakBytes),
            gz: bytesOf(cell.gzBytes),
            make: makeOf(cell.makeUs),
            ms: msOf(cell.us),
            vsC: ratioText(ratioOf(program, s.key, "c")),
            vsRust: ratioText(ratioOf(program, s.key, "rust")),
            pct: trackPct(cell.us, base),
            over: base > 0 && cell.us > base * trackTimes(),
        })
    }
    return out
}

/// How far a table's bar track runs, as a multiple of C. C lands a quarter of
/// the way along on every row, so the column reads down as well as across.
fn trackTimes() -> Int64 {
    return 4
}

/// A reading's share of the track, to one decimal. A reading past the end is
/// drawn at the end, and its row carries `over`.
fn trackPct(us: Int64, base: Int64) -> String {
    if us <= 0 || base <= 0 {
        return "0.0"
    }
    let full = base * trackTimes()
    return tenthsText(if us >= full { 1000 } else { us * 1000 / full })
}

/// Where one engine's program for one benchmark lives. Both Vyrn legs build
/// from one source, so they point at the same file.
export fn srcHref(program: String, engine: String) -> String {
    if engine == "c" {
        return ghBlob("bench/harness/c/" + program + ".c")
    }
    if engine == "rust" {
        return ghBlob("bench/harness/rust/" + program + ".rs")
    }
    if engine == "js" {
        return ghBlob("bench/harness/js/" + program + ".js")
    }
    return ghBlob("examples/" + program + ".vyrn")
}

/// One engine's bar on a card: its name, its time, and its width.
export type BarRow = { key: String, name: String, tone: String, ms: String, pct: String }

/// One program's bars, fastest first, each as a share of the slowest: a card is
/// its own scale.
export fn panelBars(program: String) -> Array<BarRow> {
    let order = sortBy(readingsFor(program), c -> medianUs(program, c.key))
    let mut top = 1
    for c in order {
        let us = medianUs(program, c.key)
        if us > top {
            top = us
        }
    }
    let mut out: Array<BarRow> = []
    for c in order {
        out.push(BarRow {
            key: c.key.copy(),
            name: c.name.copy(),
            tone: c.tone.copy(),
            ms: c.ms.copy(),
            pct: tenthsText(medianUs(program, c.key) * 1000 / top),
        })
    }
    return out
}

/// The six panels the index shows.
export fn frontPanels() -> Array<Panel> {
    let all = axisPanels()
    let mut out: Array<Panel> = []
    let mut i = 0
    while i < all.length && i < 6 {
        out.push(all[i].copy())
        i = i + 1
    }
    return out
}

/// A card's line about the program: the harness's note up to its first `. `,
/// with the stop kept.
export fn panelNote(program: String) -> String {
    for p in programs() {
        if p.key == program {
            return match indexOf(p.note, ". ") {
                Some(at) => substring(p.note, 0, at + 1),
                None => p.note.copy(),
            }
        }
    }
    return ""
}

/// A card's speed line for Vyrn native: `fastest of the five`, or its ratio to
/// the fastest engine and that engine's name, as in `1.36x Rust`. The wasm leg
/// is a different target and takes no part.
export fn panelSpeed(program: String) -> String {
    let mut ours = 0
    let mut best = 0
    let mut bestName = ""
    for c in readingsFor(program) {
        if c.key == "vyrn-wasm" {
            continue
        }
        let us = medianUs(program, c.key)
        if us <= 0 {
            continue
        }
        if c.key == "vyrn-native" {
            ours = us
        }
        if best == 0 || us < best {
            best = us
            bestName = c.name.copy()
        }
    }
    if ours == 0 || best == 0 {
        return ""
    }
    if ours <= best {
        return "fastest of the five"
    }
    return ratioText(ours * 100 / best) + " " + bestName
}

/// How much less memory Vyrn native needed than the hungriest engine, as
/// `9x less`, or "" when it needed no less.
fn panelMemRatio(program: String) -> String {
    let mut ours = 0
    let mut worst = 0
    for c in readingsFor(program) {
        let b = cellOf(program, c.key).peakBytes
        if c.key == "vyrn-native" {
            ours = b
        }
        if b > worst {
            worst = b
        }
    }
    if ours <= 0 || worst <= ours {
        return ""
    }
    let tenths = worst * 10 / ours
    if tenths % 10 == 0 {
        return (tenths / 10).toString() + "x less"
    }
    return tenthsText(tenths) + "x less"
}

/// Vyrn native's peak memory against the hungriest engine's. When Vyrn native
/// is the hungriest, the line says so and names the runner-up.
fn panelMemPair(program: String) -> String {
    let mut ours = ""
    let mut worstName = ""
    let mut worstText = ""
    let mut worst = 0
    let mut runnerName = ""
    let mut runnerText = ""
    let mut runner = 0
    for c in readingsFor(program) {
        let b = cellOf(program, c.key).peakBytes
        if c.key == "vyrn-native" {
            ours = c.mem.copy()
        }
        if b > worst {
            runner = worst
            runnerName = worstName.copy()
            runnerText = worstText.copy()
            worst = b
            worstName = c.name.copy()
            worstText = c.mem.copy()
        } else if b > runner {
            runner = b
            runnerName = c.name.copy()
            runnerText = c.mem.copy()
        }
    }
    if ours.byteLength == 0 || worstText.byteLength == 0 {
        return ""
    }
    if worstName == "Vyrn native" {
        if runnerText.byteLength == 0 {
            return ours + " peak"
        }
        return ours + " peak \u{2014} the most here, over " + runnerName + " " + runnerText
    }
    return ours + " vs " + worstName + " " + worstText
}

/// A card's memory line: the pair, and the ratio when Vyrn native needed less.
export fn panelMemLine(program: String) -> String {
    let pair = panelMemPair(program)
    if pair.byteLength == 0 {
        return ""
    }
    let ratio = panelMemRatio(program)
    if ratio.byteLength == 0 {
        return pair
    }
    return pair + " \u{B7} " + ratio
}

/// Vyrn native against Rust on one program. A program's verdict reads this
/// ratio, so the page prints it beside the verdict.
export fn nativeVsRust(program: String) -> String {
    return ratioText(ratioOf(program, "vyrn-native", "rust"))
}

/// The ten program panels.
export fn axisPanels() -> Array<Panel> {
    let mut out: Array<Panel> = []
    for p in programs() {
        let row = causeRow(p.key)
        out.push(Panel {
            key: p.key.copy(),
            name: p.name.copy(),
            n: p.n.copy(),
            cause: row[2].copy(),
            label: row[3].copy(),
            verdict: row[1].copy(),
            game: p.game.copy(),
            cells: readingsFor(p.key),
        })
    }
    return out
}

// The causes are prose written here, not read from the record: the record
// holds measurements, and a cause is a conclusion drawn from one.

/// The cause row for `program`, or four empty strings.
fn causeRow(program: String) -> Array<String> {
    for row in causeRows() {
        if row[0] == program {
            return row.copy()
        }
    }
    return ["", "", "", ""]
}

/// Program, verdict, cause, label. The verdict places Vyrn native's ratio to
/// Rust against the +/-10% noise band; the label is the cause in a few words.
fn causeRows() -> Array<Array<String>> {
    return [
        ["nbody", "a deviation", "Rust's compiler folds the inner loop into instructions that do four sums at once; ours emits them one at a time. What that transformation needs to be safe \u{2014} that two arrays in the loop are never the same array \u{2014} the language already proves, because it uses the same fact to free memory. It does not yet reach the part of the compiler that would act on it.", "no vector instructions"],
        ["spectralnorm", "inside the noise band", "", ""],
        ["fannkuch", "inside the noise band", "The previous dataset was 679 ms behind Rust, and most of that was one array built fresh 39,916,800 times. The language gained a way to refill a buffer in place instead, and the row moved inside the band the day it landed.", "the copy that cost 600 ms"],
        ["binarytrees", "at the edge of the band", "Node wins this one outright, and the WebAssembly build is twice as fast as the native one \u{2014} because it brings its own allocator with it, and the native build asks the operating system for every node. The memory this row used to carry is settled: it peaked above two gigabytes when nothing was being freed, and now sits level with Rust.", "who allocates the memory"],
        ["fasta", "a deviation", "What one 60-byte output line costs: an array grown from nothing by doubling, then a check that its bytes are valid text \u{2014} over bytes already known to be plain ASCII \u{2014} and a second allocation, because the program still builds a piece of text per line. A way to write raw bytes straight out exists; this program has not been moved onto it.", "the price of one output line"],
        ["revcomp", "a deviation", "Three passes over every byte, and a cost per output line on top: about 120 million appends for 40 million bases, each one a bounds and capacity check into an array that grows by doubling, where Rust's output loop allocates nothing at all. The spread of the whole set is in this one program \u{2014} the C entry is itself four times slower than Rust here, for reading its input a line at a time.", "a pass per byte, and a cost per line"],
        ["knucleotide", "ahead of the band", "This row once took 211 times C's time, when looking a key up in a map meant reading every key in it. Maps carry a hash index now, and this program's key is a single number rolled along the sequence rather than a fresh piece of text at every position. Its N moved a hundredfold with this dataset: the old one was chosen for the slow version and outlived it.", "faster than C, and why"],
        ["pidigits", "inside the noise band", "", ""],
        ["mandelbrot", "inside the noise band", "Floating-point arithmetic with no allocation and no output shaping, so what is measured is the arithmetic \u{2014} which is why even the WebAssembly build, two to fourteen times slower everywhere else, is within 15% of C here. The program is on the list at all because Vyrn can write raw bytes now: this image's pixels are arbitrary bytes, and text cannot carry them.", "the closest five readings here"],
        ["regexredux", "a deviation", "The entries are not running comparable engines, which is the first thing to say about the number. Vyrn runs a general-purpose regular-expression engine, written in Vyrn and compiled like any other program. The C and Rust entries carry the smallest matcher that covers this one corpus \u{2014} about sixty lines, hand-fitted to these patterns, no backtracking \u{2014} and node uses the engine built into it. So the gap is the shape of a general engine against a special-cased scan, and not a finding about the language. What it does measure honestly is that Vyrn's engine has had no optimisation work at all.", "not the same engine on both sides"],
    ]
}

/// The record's environment block.
fn envText() -> String {
    return objectAt(recordText(run1File()), "  ", "environment")
}

/// The machine, the toolchain and the date, in one line for a caption.
export fn benchMachine() -> String {
    let env = envText()
    let hw = objectAt(env, "    ", "hardware")
    let vyrn = objectAt(env, "    ", "vyrn")
    let wasmtime = objectAt(env, "    ", "wasmtime")
    return textAt(hw, "      ", "cpu") + ", " + textAt(env, "    ", "os") + ", " + textAt(vyrn, "      ", "version") + ", wasmtime " + textAt(wasmtime, "      ", "version") + ", " + benchDate()
}

/// When the record was measured.
fn benchDate() -> String {
    return textAt(recordText(run1File()), "  ", "date")
}

/// How many timed runs each median is of.
export fn benchRuns() -> String {
    return scalarAt(recordText(run1File()), "  ", "runs")
}

/// The environment, row by row: a name and the record's own text.
export fn envRows() -> Array<Array<String>> {
    let env = envText()
    let hw = objectAt(env, "    ", "hardware")
    let vyrn = objectAt(env, "    ", "vyrn")
    let wasmtime = objectAt(env, "    ", "wasmtime")
    let flags = objectAt(env, "    ", "flags")
    // No host row: a machine's name is private and says nothing about a
    // number. `bench/harness/run.py` does not record it.
    return [
        ["Operating system", textAt(env, "    ", "os")],
        ["CPU", textAt(hw, "      ", "cpu") + " (" + scalarAt(hw, "      ", "cores") + " logical cores)"],
        ["Memory", scalarAt(hw, "      ", "ram_gib") + " GiB"],
        ["clang", textAt(env, "    ", "clang")],
        ["rustc", textAt(env, "    ", "rustc")],
        ["node", textAt(env, "    ", "node")],
        ["python", textAt(env, "    ", "python")],
        ["vyrn", textAt(vyrn, "      ", "version") + " at " + textAt(vyrn, "      ", "commit")],
        ["wasmtime", textAt(wasmtime, "      ", "version") + ", sha256 " + textAt(wasmtime, "      ", "lock_sha256")],
        ["C flags", textAt(flags, "      ", "c")],
        ["Rust flags", textAt(flags, "      ", "rust")],
        ["JavaScript", textAt(flags, "      ", "js")],
        ["Vyrn native", textAt(flags, "      ", "vyrn-native")],
        ["Vyrn wasm", textAt(flags, "      ", "vyrn-wasm")],
    ]
}

test "the record still has the shape this reader cuts" {
    // The reader's contract with `run.py` is the indentation of
    // `json.dump(indent=2)`. If it changes, every number on two pages becomes
    // a dash, and this test fails instead.
    loadCells()
    assertEq(cells.length, 50)
    for c in cells {
        assert(c.us > 0)
        assert(c.cpuUs > 0)
        assert(c.peakBytes > 0)
    }
    assertEq(benchDate(), "2026-09-01")
    assertEq(benchRuns(), "10")
}

test "the medians are the ones the published record holds" {
    // Pins read off `2026-09-01.json` by hand. They fail when the record is
    // replaced, so a repointed reader is visible.
    assertEq(msOf(medianUs("nbody", "c")), "897 ms")
    assertEq(msOf(medianUs("nbody", "rust")), "659 ms")
    assertEq(msOf(medianUs("nbody", "js")), "1125 ms")
    assertEq(msOf(medianUs("nbody", "vyrn-native")), "882 ms")
    assertEq(msOf(medianUs("nbody", "vyrn-wasm")), "12511 ms")
    assertEq(msOf(medianUs("knucleotide", "c")), "313 ms")
    assertEq(msOf(medianUs("knucleotide", "rust")), "221 ms")
    assertEq(msOf(medianUs("knucleotide", "vyrn-native")), "125 ms")
    assertEq(msOf(medianUs("binarytrees", "js")), "436 ms")
    assertEq(msOf(medianUs("pidigits", "vyrn-native")), "1330 ms")
}

test "the normalized figures are the ones the record computes" {
    assertEq(ratioText(ratioOf("nbody", "vyrn-native", "c")), "0.98x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-wasm", "c")), "13.95x")
    assertEq(ratioText(ratioOf("spectralnorm", "vyrn-native", "c")), "1.04x")
    assertEq(ratioText(ratioOf("binarytrees", "js", "c")), "0.47x")
    assertEq(ratioText(ratioOf("revcomp", "rust", "c")), "0.22x")
    assertEq(ratioText(ratioOf("knucleotide", "vyrn-native", "c")), "0.40x")
    assertEq(ratioText(ratioOf("knucleotide", "vyrn-wasm", "c")), "0.96x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-native", "rust")), "1.34x")
    assertEq(ratioText(ratioOf("pidigits", "vyrn-native", "rust")), "1.00x")
    assertEq(ratioText(ratioOf("revcomp", "vyrn-native", "rust")), "7.83x")
}

test "the log scale puts a doubling on every ring" {
    assertEq(radiusOf(100), ringRadius(belowBase()))
    assertEq(radiusOf(200), ringRadius(belowBase() + 1))
    assertEq(radiusOf(400), ringRadius(belowBase() + 2))
    assertEq(radiusOf(50), ringRadius(belowBase() - 1))
    // 200 units over seven doublings: the baseline ring is 86 out.
    assertEq(radiusOf(100), 86)
    assertEq(radiusOf(200), 114)
    // The centre is 1/8x, the rim 16x, and past the rim the scale stops.
    assertEq(radiusOf(12), 0)
    assertEq(radiusOf(1600), radius())
    assertEq(radiusOf(30200), radius())
    assertEq(ringLabel(0 - 3), "1/8x")
    assertEq(ringLabel(0), "1x")
    assertEq(ringLabel(4), "16x")
}

test "no cell is ever silently truncated" {
    // Every point drawn at the rim carries a mark naming its figure.
    let mut clamped = 0
    let mut marked = 0
    for line in radarLines() {
        marked = marked + line.marks.length
        for p in programs() {
            if offScale(ratioOf(p.key, line.key, "c")) {
                clamped = clamped + 1
            }
        }
    }
    assertEq(clamped, marked)
    // No cell in this record passes the rim against C.
    assertEq(clamped, 0)
    // And none falls inside the centre: the fastest cell is 0.22x.
    for line in radarLines() {
        for p in programs() {
            assert(radiusOf(ratioOf(p.key, line.key, "c")) > 0)
        }
    }
}

test "every polygon has one vertex per program" {
    for line in radarLines() {
        assertEq(split(line.points, " ").length, programs().length)
    }
    assertEq(radarLines().length, 5)
    // C against C is the baseline ring, vertex for vertex.
    let base = radarRings()[belowBase() - 1]
    assertEq(radarLines()[0].points, base.points)
    assertEq(base.label, "1x")
    assertEq(base.tone, "ring base")
}

test "no axis name runs off the sheet" {
    // Ten-pixel mono is about six units a character.
    let spokes = radarSpokes()
    let mut i = 0
    while i < spokes.length {
        let x = numOf(spokes[i].lx)
        let room = spokes[i].name.byteLength * 6
        if spokes[i].anchor == "start" {
            assert(x + room <= 700)
        }
        if spokes[i].anchor == "end" {
            assert(x - room >= 0)
        }
        i = i + 1
    }
}

test "every axis carries a name, a spoke and a wedge to reach it" {
    let spokes = radarSpokes()
    assertEq(spokes.length, 10)
    assertEq(spokes[0].key, "nbody")
    assertEq(spokes[0].anchor, "middle")
    assertEq(spokes[2].anchor, "start")
    assertEq(spokes[5].anchor, "middle")
    assertEq(spokes[7].anchor, "end")
    for s in spokes {
        assert(s.name.byteLength > 0)
        assert(split(s.wedge, " ").length == 4)
    }
}

test "a panel is the whole of what is known about one program" {
    let panels = axisPanels()
    assertEq(panels.length, 10)
    for p in panels {
        assertEq(p.cells.length, 5)
        assert(p.verdict.byteLength > 0)
    }
    assertEq(panels[0].n, "25,000,000")
    assertEq(panels[0].cells[0].ms, "897 ms")
    assertEq(panels[0].cells[3].vsC, "0.98x")
    assertEq(panels[0].cells[3].vsRust, "1.34x")
    assertEq(nativeVsRust("nbody"), "1.34x")
    assertEq(nativeVsRust("pidigits"), "1.00x")
    assertEq(nativeVsRust("knucleotide"), "0.57x")
    // A row inside the band says so, a row on its edge says that, and a row
    // outside it on the fast side is not called a deviation.
    assertEq(panels[1].verdict, "inside the noise band")
    assertEq(panels[2].verdict, "inside the noise band")
    assertEq(panels[3].verdict, "at the edge of the band")
    assertEq(panels[6].verdict, "ahead of the band")
    assertEq(panels[7].verdict, "inside the noise band")
}

test "the caption names the hardware and the toolchain, and never the machine" {
    let cap = benchMachine()
    assert(contains(cap, "Ryzen"))
    assert(contains(cap, "wasmtime 46.0.1"))
    assert(contains(cap, "2026-09-01"))
    assertEq(envRows().length, 14)
    for row in envRows() {
        assert(row[0].byteLength > 0)
        assert(row[1].byteLength > 0)
        assert(row[0] != "Host")
    }
    assert(!contains(envText(), "\"host\""))
}

test "every program links to the game's own page for it" {
    let progs = programs()
    assertEq(progs.length, 10)
    for p in progs {
        assert(contains(p.game, "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/"))
        assert(contains(p.game, ".html"))
    }
    // The record's key, the reader's name and the game's slug differ.
    assertEq(progs[2].key, "fannkuch")
    assertEq(progs[2].name, "fannkuch-redux")
    assert(contains(progs[2].game, "/fannkuchredux.html"))
    assert(contains(progs[1].game, "/spectralnorm.html"))
    assert(contains(progs[6].game, "/knucleotide.html"))
    assert(contains(progs[5].game, "/revcomp.html"))
}

test "every cell carries the columns the game prints" {
    for p in programs() {
        let cells = readingsFor(p.key)
        assertEq(cells.length, 5)
        for c in cells {
            assert(c.cpu.byteLength > 0)
            assert(c.mem.byteLength > 2)
            assert(c.gz.byteLength > 2)
        }
        // node has no build step, and its column prints a dash, not a zero.
        assertEq(cells[2].make, "\u{2014}")
        assert(cells[0].make != "\u{2014}")
        assert(cells[3].make != "\u{2014}")
    }
}

test "every bar is measured against the same track, and none is clipped in silence" {
    assertEq(trackPct(medianUs("nbody", "c"), medianUs("nbody", "c")), "25.0")
    for p in programs() {
        let base = medianUs(p.key, "c")
        for c in readingsFor(p.key) {
            if c.key == "c" {
                assertEq(c.pct, "25.0")
            }
            assertEq(c.over, medianUs(p.key, c.key) > base * 4)
            if c.over {
                assertEq(c.pct, "100.0")
            } else {
                assert(c.pct != "100.0")
            }
        }
    }
    // Three cells pass the end of the track: nbody's wasm leg, from the backend
    // that runs no optimizer, and both regex-redux Vyrn legs, whose cause row
    // explains them.
    let mut past: Array<String> = []
    for p in programs() {
        for c in readingsFor(p.key) {
            if c.over {
                past.push(p.key + "/" + c.key)
            }
        }
    }
    assertEq(joinWith(past, " "), "nbody/vyrn-wasm regexredux/vyrn-native regexredux/vyrn-wasm")
}

test "every row points at the program behind it" {
    for p in programs() {
        assertEq(srcHref(p.key, "c"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/c/" + p.key + ".c")
        assertEq(srcHref(p.key, "rust"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/rust/" + p.key + ".rs")
        assertEq(srcHref(p.key, "js"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/js/" + p.key + ".js")
        assertEq(srcHref(p.key, "vyrn-native"), srcHref(p.key, "vyrn-wasm"))
        assertEq(srcHref(p.key, "vyrn-native"), "https://github.com/vyrn-lang/vyrn/blob/main/examples/" + p.key + ".vyrn")
    }
}

test "a row with nothing to explain explains nothing" {
    // A cause has a short label and a sentence the table cannot say, or the row
    // prints nothing. Two rows are level with Rust and print nothing.
    let mut silent = 0
    for p in axisPanels() {
        if p.cause.byteLength == 0 {
            assertEq(p.label, "")
            assertEq(p.verdict, "inside the noise band")
            silent = silent + 1
            continue
        }
        assert(p.label.byteLength > 0)
        assert(p.label.byteLength < 40)
        assert(p.cause.byteLength > 40)
        // A cause does not restate the verdict the header already prints.
        assert(!contains(p.cause, "Not a deviation"))
        assert(!contains(p.cause, "noise band"))
    }
    assertEq(silent, 2)
    for p in axisPanels() {
        if p.verdict == "a deviation" {
            assert(p.cause.byteLength > 40)
        }
    }
    for row in causeRows() {
        assertEq(row.length, 4)
    }
}

test "the page names no design record and no internal symbol" {
    // The causes are for readers outside the project. The site publishes no
    // design records, so an RFC number, a symbol or a mnemonic points at nothing.
    let banned = ["RFC-", "std/", "noalias", "malloc", "sqrt", "()", "Int64", "wasm ", "UTF-8", "V8"]
    for row in causeRows() {
        for word in banned {
            assert(!contains(row[2], word))
            assert(!contains(row[3], word))
        }
    }
}

test "a second, a memory size and a byte count read the way the game prints them" {
    assertEq(secsOf(898000), "0.90")
    assertEq(secsOf(13029000), "13.03")
    assertEq(secsOf(10100), "0.01")
    assertEq(secsOf(4000), "<0.01")
    assertEq(secsOf(0), "0.00")
    assertEq(secsOf(0 - 1), "\u{2014}")
    assertEq(makeOf(0), "\u{2014}")
    assertEq(makeOf(591825), "0.59")
    assertEq(memOf(4386816), "4,284 KB")
    assertEq(memOf(41000000), "39.1 MB")
    assertEq(memOf(0), "\u{2014}")
    assertEq(bytesOf(1168), "1,168")
    assertEq(bytesOf(0), "\u{2014}")
}

test "no escape survives into the page" {
    // `json.dump` writes a non-ASCII character as `\uXXXX` and doubles every
    // backslash; the page shows the characters they stand for.
    assertEq(unescaped("100,000 \\u2014 a hundred"), "100,000 \u{2014} a hundred")
    assertEq(unescaped("\\\\w+"), "\\w+")
    assertEq(unescaped("line\\nbreak"), "line\nbreak")
    assertEq(unescaped("nothing to undo"), "nothing to undo")
    assertEq(charOf(65), "A")
    assertEq(charOf(233), "\u{E9}")
    assertEq(charOf(8212), "\u{2014}")
    assertEq(hexAt("\\u2014", 2), 8212)
    assertEq(hexAt("00ff", 0), 255)
    assertEq(hexAt("00FF", 0), 255)
    for prog in programs() {
        assert(!contains(prog.note, "\\"))
    }
    for row in envRows() {
        assert(!contains(row[1], "\\"))
    }
}

test "a thousands separator lands every three digits and nowhere else" {
    assertEq(grouped("25000000"), "25,000,000")
    assertEq(grouped("100"), "100")
    assertEq(grouped("1000"), "1,000")
    assertEq(grouped("11"), "11")
}

test "a duration and a ratio read the way the record's tables print them" {
    assertEq(msOf(898000), "898 ms")
    assertEq(msOf(10100), "10.1 ms")
    assertEq(msOf(99900), "99.9 ms")
    assertEq(msOf(100000), "100 ms")
    assertEq(ratioText(97), "0.97x")
    assertEq(ratioText(1452), "14.52x")
    assertEq(ratioText(9999), "99.99x")
    assertEq(ratioText(10000), "100x")
    assertEq(ratioText(28700), "287x")
}
