/// Cuts the record with `indexOf` instead of parsing it: `std/jsonread` is too slow under the interpreter.
import { indexOf, substring, trim, split, joinWith, padStart } from "std/strings"
import { contains } from "std/strpred"
import { sortBy } from "std/arrays"
import { parseFloat64 } from "std/num"
import { ghBlob } from "./github"

/// Times in integer microseconds; -1 marks a field the reader could not cut.
export type Measure = {
    program: String,
    contestant: String,
    p50Us: Int64,
    p99Us: Int64,
    startUs: Int64,
    cpuUs: Int64,
    peakBytes: Int64,
    makeUs: Int64,
    makePeakBytes: Int64,
    gzBytes: Int64,
    artifactBytes: Int64,
}

export type Prog = { key: String, name: String, n: String, note: String, game: String }

export type Series = { key: String, name: String, tone: String }

/// A named group of a readout's numbers. A row is a label, a value and the lane segment the value belongs to, or "" for none.
export type NumGroup = { name: String, rows: Array<Array<String>> }

/// One engine's time to an answer. `style` sets the bar's share of the track and each segment's share of the bar; `runText` is written inside the run segment. The readout, the expanded list and `say` print `groups`.
export type Lane = { key: String, name: String, tone: String, href: String, style: String, runText: String, total: String, mem: String, say: String, groups: Array<NumGroup> }

/// A record on a sparkline: `groups` read like a lane's.
export type SparkStep = { key: String, name: String, say: String, groups: Array<NumGroup> }

/// One series of a sparkline with at least one point: `points` for a polyline, and the last point's `x` and `y` for its dot. The view box is 1200 by 240.
export type Trace = { key: String, tone: String, points: String, x: String, y: String }

/// Vyrn's p50 for one program in every committed record, one step per record, on one scale from zero. `first` and `last` are Vyrn native's first and latest p50.
export type Spark = { first: String, last: String, say: String, traces: Array<Trace>, pts: Array<SparkStep> }

/// `lanes` run fastest first; the readout shows the first until a reader points at another.
export type Panel = { key: String, name: String, n: String, cause: String, label: String, verdict: String, game: String, lanes: Array<Lane>, spark: Spark }

export fn run1File() -> String {
    return "bench/results/2026-10-17.json"
}

export fn run1Href() -> String {
    return ghBlob(run1File())
}

fn historyFile() -> String {
    return "bench/results/history.json"
}

fn after(src: String, needle: String) -> String {
    return match indexOf(src, needle) {
        Some(at) => substring(src, at + needle.byteLength, src.byteLength),
        None => "",
    }
}

fn upTo(src: String, needle: String) -> String {
    return match indexOf(src, needle) {
        Some(at) => substring(src, 0, at),
        None => src.copy(),
    }
}

fn objectAt(src: String, indent: String, key: String) -> String {
    return upTo(after(src, "\n" + indent + "\"" + key + "\": {"), "\n" + indent + "\"")
}

fn scalarAt(src: String, indent: String, key: String) -> String {
    let raw = upTo(after(src, "\n" + indent + "\"" + key + "\": "), "\n")
    let cut = if raw.byteLength > 0 && substring(raw, raw.byteLength - 1, raw.byteLength) == "," {
        substring(raw, 0, raw.byteLength - 1)
    } else {
        raw.copy()
    }
    return trim(cut)
}

fn textAt(src: String, indent: String, key: String) -> String {
    let raw = scalarAt(src, indent, key)
    if raw.byteLength >= 2 && substring(raw, 0, 1) == "\"" {
        return unescaped(substring(raw, 1, raw.byteLength - 1))
    }
    return unescaped(raw)
}

fn unescaped(text: String) -> String {
    if !contains(text, "\\") {
        return text.copy()
    }
    let raw = bytes(text)
    let mut out = ""
    let mut i = 0
    while i < raw.length {
        if raw[i] != '\\' || i + 1 >= raw.length {
            out = out + substring(text, i, i + 1)
            i = i + 1
            continue
        }
        let c = raw[i + 1]
        if c == 'u' && i + 5 < raw.length {
            out = out + charOf(hexAt(text, i + 2))
            i = i + 6
            continue
        }
        if c == 'n' {
            out = out + "\n"
        } else if c == 't' {
            out = out + "\t"
        } else if c == 'r' {
            out = out + "\r"
        } else {
            out = out + substring(text, i + 1, i + 2)
        }
        i = i + 2
    }
    return out
}

fn hexAt(text: String, at: Int64) -> Int64 {
    let raw = bytes(text)
    let mut n = 0
    let mut i = at
    while i < at + 4 {
        let b = Int64(raw[i])
        let d = if b >= 48 && b <= 57 {
            b - 48
        } else if b >= 97 && b <= 102 {
            b - 87
        } else {
            b - 55
        }
        n = n * 16 + d
        i = i + 1
    }
    return n
}

fn charOf(cp: Int64) -> String {
    let mut raw: Array<UInt8> = []
    if cp < 128 {
        raw.push(UInt8(cp))
    } else if cp < 2048 {
        raw.push(UInt8(192 + cp / 64))
        raw.push(UInt8(128 + cp % 64))
    } else {
        raw.push(UInt8(224 + cp / 4096))
        raw.push(UInt8(128 + (cp / 64) % 64))
        raw.push(UInt8(128 + cp % 64))
    }
    return match stringFromBytes(raw) {
        Ok(text) => text,
        Err(_) => "",
    }
}

fn microsOf(text: String) -> Int64 {
    return match parseFloat64(text) {
        Some(s) => Int64(s * 1000000.0 + 0.5),
        None => 0 - 1,
    }
}

let mut records: Map<String, String> = [:]

fn recordText(file: String) -> String {
    if let Some(hit) = records[file] {
        return hit.copy()
    }
    let body = match readFile(file) {
        Ok(text) => text.copy(),
        Err(why) => "",
    }
    records[file.copy()] = body.copy()
    return body
}

// Written out, not discovered, so a program missing from a re-run fails a test instead of shrinking the chart.
let mut progs: Array<Prog> = []

export fn programs() -> Array<Prog> {
    if progs.length > 0 {
        return progs.copy()
    }
    let src = recordText(run1File())
    let results = objectAt(src, "  ", "results")
    let mut out: Array<Prog> = []
    for p in progNames() {
        let slice = objectAt(results, "    ", p[0])
        out.push(Prog {
            key: p[0].copy(),
            name: p[1].copy(),
            n: grouped(scalarAt(slice, "      ", "n")),
            note: textAt(slice, "      ", "note"),
            game: gameHref(p[2]),
        })
    }
    progs = out.copy()
    return out
}

fn progNames() -> Array<Array<String>> {
    return [
        ["nbody", "nbody", "nbody"],
        ["spectralnorm", "spectral-norm", "spectralnorm"],
        ["fannkuch", "fannkuch-redux", "fannkuchredux"],
        ["binarytrees", "binary-trees", "binarytrees"],
        ["fasta", "fasta", "fasta"],
        ["revcomp", "reverse-complement", "revcomp"],
        ["knucleotide", "k-nucleotide", "knucleotide"],
        ["pidigits", "pidigits", "pidigits"],
        ["mandelbrot", "mandelbrot", "mandelbrot"],
        ["regexredux", "regex-redux", "regexredux"],
    ]
}

fn gameHref(slug: String) -> String {
    return "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/" + slug + ".html"
}

fn contestants() -> Array<Series> {
    return [
        Series { key: "c", name: "C", tone: "sr-c" },
        Series { key: "rust", name: "Rust", tone: "sr-rust" },
        Series { key: "js", name: "node", tone: "sr-node" },
        Series { key: "bun", name: "bun", tone: "sr-bun" },
        Series { key: "vyrn-native", name: "Vyrn native", tone: "sr-vyrn" },
        Series { key: "vyrn-wasm", name: "Vyrn wasm", tone: "sr-vyrn sr-wasm" },
        Series { key: "vyrn-wasm-opt", name: "Vyrn wasm-opt", tone: "sr-vyrn sr-wasmopt" },
    ]
}

let mut cells: Array<Measure> = []

fn loadCells() {
    if cells.length > 0 {
        return
    }
    let src = recordText(run1File())
    let results = objectAt(src, "  ", "results")
    let boot = objectAt(src, "  ", "startup")
    for p in progNames() {
        let box = objectAt(objectAt(results, "    ", p[0]), "      ", "contestants")
        for s in contestants() {
            let cell = objectAt(box, "        ", s.key)
            cells.push(Measure {
                program: p[0].copy(),
                contestant: s.key.copy(),
                p50Us: microsOf(scalarAt(cell, "          ", "p50_s")),
                p99Us: microsOf(scalarAt(cell, "          ", "p99_s")),
                startUs: microsOf(scalarAt(objectAt(boot, "    ", s.key), "      ", "p50_s")),
                cpuUs: microsOf(scalarAt(cell, "          ", "cpu_median_s")),
                peakBytes: wholeOf(scalarAt(cell, "          ", "peak_bytes")),
                makeUs: microsOf(scalarAt(cell, "          ", "make_s")),
                makePeakBytes: wholeOf(scalarAt(cell, "          ", "make_peak_bytes")),
                gzBytes: wholeOf(scalarAt(cell, "          ", "gz_bytes")),
                artifactBytes: wholeOf(scalarAt(cell, "          ", "artifact_bytes")),
            })
        }
    }
}

fn cellOf(program: String, contestant: String) -> Measure {
    loadCells()
    for c in cells {
        if c.program == program && c.contestant == contestant {
            return c.copy()
        }
    }
    return Measure {
        program: program.copy(),
        contestant: contestant.copy(),
        p50Us: 0 - 1,
        p99Us: 0 - 1,
        startUs: 0 - 1,
        cpuUs: 0 - 1,
        peakBytes: 0 - 1,
        makeUs: 0 - 1,
        makePeakBytes: 0 - 1,
        gzBytes: 0 - 1,
        artifactBytes: 0 - 1,
    }
}

fn p50Of(program: String, contestant: String) -> Int64 {
    return cellOf(program, contestant).p50Us
}

fn tenthsText(t: Int64) -> String {
    return (t / 10).toString() + "." + (t % 10).toString()
}

fn hundredthsText(h: Int64) -> String {
    return (h / 100).toString() + "." + padStart((h % 100).toString(), 2, "0")
}

fn msOf(us: Int64) -> String {
    if us < 0 {
        return "\u{2014}"
    }
    if us >= 100000 {
        return ((us + 500) / 1000).toString() + " ms"
    }
    return tenthsText((us + 50) / 100) + " ms"
}

fn wholeOf(text: String) -> Int64 {
    return match parseFloat64(text) {
        Some(v) => Int64(v),
        None => 0 - 1,
    }
}

fn secsOf(us: Int64) -> String {
    if us < 0 {
        return "\u{2014}"
    }
    let cs = (us + 5000) / 10000
    if cs == 0 && us > 0 {
        return "<0.01"
    }
    return hundredthsText(cs)
}

fn memOf(bytes: Int64) -> String {
    if bytes <= 0 {
        return "\u{2014}"
    }
    let tenths = (bytes * 10 + 524288) / 1048576
    return grouped((tenths / 10).toString()) + "." + (tenths % 10).toString() + " MB"
}

/// A file's size: KB under one MB and MB from there, one decimal either way.
fn sizeOf(bytes: Int64) -> String {
    if bytes <= 0 {
        return "\u{2014}"
    }
    let tenths = (bytes * 10 + 512) / 1024
    if tenths < 10240 {
        return (tenths / 10).toString() + "." + (tenths % 10).toString() + " KB"
    }
    return memOf(bytes)
}

fn hundredths(a: Int64, b: Int64) -> Int64 {
    if b <= 0 {
        return 0
    }
    return (a * 100 + b / 2) / b
}

fn ratioText(h: Int64) -> String {
    if h <= 0 {
        return "\u{2014}"
    }
    if h >= 10000 {
        return ((h + 50) / 100).toString() + "x"
    }
    return hundredthsText(h) + "x"
}

fn grouped(digits: String) -> String {
    let raw = trim(digits)
    let mut out = ""
    let mut i = 0
    let n = raw.byteLength
    while i < n {
        if i > 0 && (n - i) % 3 == 0 {
            out = out + ","
        }
        out = out + substring(raw, i, i + 1)
        i = i + 1
    }
    return out
}

fn ratioOf(program: String, contestant: String, base: String) -> Int64 {
    return hundredths(p50Of(program, contestant), p50Of(program, base))
}

fn atLeast0(us: Int64) -> Int64 {
    if us < 0 {
        return 0
    }
    return us
}

/// Build, then the whole run at p50: the run's wall clock already holds its startup.
fn totalOf(c: Measure) -> Int64 {
    return atLeast0(c.makeUs) + atLeast0(c.p50Us)
}

/// Where a lane's bar ends: the build plus p99, or plus p50 where the lane has no p99.
fn endOf(c: Measure) -> Int64 {
    let p50 = atLeast0(c.p50Us)
    return atLeast0(c.makeUs) + if c.p99Us > p50 { c.p99Us } else { p50 }
}

fn shareOf(part: Int64, whole: Int64) -> String {
    if whole <= 0 {
        return "0.0%"
    }
    return tenthsText(part * 1000 / whole) + "%"
}

fn thousandthsText(k: Int64) -> String {
    return (k / 1000).toString() + "." + padStart((k % 1000).toString(), 3, "0")
}

fn buildOf(us: Int64) -> String {
    if us == 0 {
        return "none"
    }
    return msOf(us)
}

/// The lanes of one program, fastest total first, on one linear scale whose full width is the largest build plus p99.
export fn lanesFor(program: String) -> Array<Lane> {
    let mut ms: Array<Measure> = []
    for s in contestants() {
        ms.push(cellOf(program, s.key))
    }
    return lanesOf(ms, true)
}

/// Each engine summed over every program: its builds, one startup, one run at p50 and one artifact per program, and the largest of each peak. A sum of p99s is no percentile, so `p99Us` is -1 and the lane has no tail.
fn summed() -> Array<Measure> {
    let mut out: Array<Measure> = []
    for s in contestants() {
        let mut sum = Measure { program: "", contestant: s.key.copy(), p50Us: 0, p99Us: 0 - 1, startUs: 0, cpuUs: 0, peakBytes: 0, makeUs: 0, makePeakBytes: 0 - 1, gzBytes: 0, artifactBytes: 0 }
        for p in progNames() {
            let c = cellOf(p[0], s.key)
            sum.p50Us = sum.p50Us + c.p50Us
            sum.startUs = sum.startUs + c.startUs
            sum.cpuUs = sum.cpuUs + c.cpuUs
            sum.makeUs = sum.makeUs + c.makeUs
            sum.gzBytes = sum.gzBytes + c.gzBytes
            sum.artifactBytes = sum.artifactBytes + c.artifactBytes
            if c.peakBytes > sum.peakBytes {
                sum.peakBytes = c.peakBytes
            }
            if c.makePeakBytes > sum.makePeakBytes {
                sum.makePeakBytes = c.makePeakBytes
            }
        }
        out.push(sum)
    }
    return out
}

/// The front page's lanes: every program, built and run once, per engine.
export fn frontLanes() -> Array<Lane> {
    return lanesOf(summed(), false)
}

fn seriesOf(key: String) -> Series {
    for s in contestants() {
        if s.key == key {
            return s
        }
    }
    return Series { key: key.copy(), name: key.copy(), tone: "" }
}

/// The lanes on one linear scale whose full width is the largest end, so `--w` is at most 1. `full` adds the numbers only the benchmarks page shows: startup, p99, cpu and sizes.
fn lanesOf(ms: Array<Measure>, full: Bool) -> Array<Lane> {
    let order = sortBy(ms, m -> totalOf(m))
    let best = totalOf(order[0])
    let mut top = 1
    for c in order {
        if endOf(c) > top {
            top = endOf(c)
        }
    }
    let mut out: Array<Lane> = []
    for c in order {
        let s = seriesOf(c.contestant)
        let build = atLeast0(c.makeUs)
        let p50 = atLeast0(c.p50Us)
        let end = endOf(c)
        let start = if c.startUs < 0 { 0 } else if c.startUs > p50 { p50 } else { c.startUs }
        let total = totalOf(c)
        let groups = if full { fullGroups(c, total, best) } else { frontGroups(c, total, best) }
        let mut said: Array<String> = []
        for g in groups {
            for r in g.rows {
                said.push(g.name + " " + r[0] + " " + r[1])
            }
        }
        out.push(Lane {
            key: s.key.copy(),
            name: s.name.copy(),
            tone: s.tone.copy(),
            href: if c.program.byteLength == 0 { "/benchmarks.html" } else { srcHref(c.program, c.contestant) },
            style: "--w: " + thousandthsText(end * 1000 / top) + "; --b: " + shareOf(build, end) + "; --s: " + shareOf(start, end) + "; --r: " + shareOf(p50 - start, end) + "; --t: " + shareOf(end - build - p50, end),
            runText: "run " + msOf(p50),
            total: msOf(total),
            mem: memOf(c.peakBytes),
            say: s.name + ": " + joinWith(said, ", "),
            groups: groups,
        })
    }
    return out
}

fn fullGroups(c: Measure, total: Int64, best: Int64) -> Array<NumGroup> {
    let mut run: Array<Array<String>> = [["startup", msOf(c.startUs), "start"], ["p50", msOf(c.p50Us), "run"]]
    if c.p99Us >= 0 {
        run.push(["p99", msOf(c.p99Us), "tail"])
        run.push(["p99/p50", ratioText(hundredths(c.p99Us, c.p50Us)), ""])
    }
    run.push(["peak", memOf(c.peakBytes), ""])
    run.push(["cpu", secsOf(c.cpuUs) + " s", ""])
    return [
        NumGroup { name: "build", rows: [["time", buildOf(c.makeUs), "build"], ["peak", if c.makeUs == 0 { "none" } else { memOf(c.makePeakBytes) }, "build"]] },
        NumGroup { name: "run", rows: run },
        NumGroup { name: "size", rows: [["source gz", sizeOf(c.gzBytes), ""], ["output", sizeOf(c.artifactBytes) + if c.makeUs == 0 { ", the source" } else { "" }, ""]] },
        NumGroup { name: "total", rows: [["time", msOf(total), ""], ["vs fastest", ratioText(hundredths(total, best)), ""]] },
    ]
}

/// The front page's readout: what the reader needs to rank the lanes.
fn frontGroups(c: Measure, total: Int64, best: Int64) -> Array<NumGroup> {
    return [
        NumGroup { name: "build", rows: [["time", buildOf(c.makeUs), "build"]] },
        NumGroup { name: "run", rows: [["p50", msOf(c.p50Us), "run"], ["peak", memOf(c.peakBytes), ""]] },
        NumGroup { name: "total", rows: [["time", msOf(total), ""], ["vs fastest", ratioText(hundredths(total, best)), ""]] },
    ]
}

fn srcHref(program: String, engine: String) -> String {
    if engine == "c" {
        return ghBlob("bench/harness/c/" + program + ".c")
    }
    if engine == "rust" {
        return ghBlob("bench/harness/rust/" + program + ".rs")
    }
    if engine == "js" || engine == "bun" {
        return ghBlob("bench/harness/js/" + program + ".js")
    }
    return ghBlob("examples/" + program + ".vyrn")
}

export fn nativeVsRust(program: String) -> String {
    return ratioText(ratioOf(program, "vyrn-native", "rust"))
}

export fn axisPanels() -> Array<Panel> {
    let mut out: Array<Panel> = []
    for p in programs() {
        let row = causeRow(p.key)
        let lanes = lanesFor(p.key)
        out.push(Panel {
            key: p.key.copy(),
            name: p.name.copy(),
            n: p.n.copy(),
            cause: row.cause.copy(),
            label: row.label.copy(),
            verdict: row.verdict.copy(),
            game: p.game.copy(),
            lanes: lanes,
            spark: sparkOf(p.key),
        })
    }
    return out
}

/// One list of the history file, which holds each on one line: `["a", "b"]` or `[0.88, null]`.
fn listAt(src: String, indent: String, key: String) -> Array<String> {
    let raw = scalarAt(src, indent, key)
    let mut out: Array<String> = []
    if raw.byteLength < 3 {
        return out
    }
    for part in split(substring(raw, 1, raw.byteLength - 1), ", ") {
        let t = trim(part)
        out.push(if substring(t, 0, 1) == "\"" { substring(t, 1, t.byteLength - 1) } else { t })
    }
    return out
}

fn sparkOf(program: String) -> Spark {
    let src = recordText(historyFile())
    let files = listAt(src, "  ", "files")
    let commits = listAt(src, "  ", "commits")
    let row = objectAt(objectAt(src, "  ", "p50_s"), "    ", program)
    let keys = ["vyrn-native", "vyrn-wasm", "vyrn-wasm-opt"]
    let mut series: Array<Array<Int64>> = []
    let mut top = 1
    for k in keys {
        let mut us: Array<Int64> = []
        for v in listAt(row, "      ", k) {
            let t = microsOf(v)
            us.push(t)
            if t > top {
                top = t
            }
        }
        series.push(us)
    }
    let n = files.length
    let mut traces: Array<Trace> = []
    let mut j = 0
    while j < keys.length {
        let mut at: Array<String> = []
        let mut x = ""
        let mut y = ""
        let mut i = 0
        while i < n {
            let t = usAt(series[j], i)
            if t >= 0 {
                x = ((2 * i + 1) * 600 / n).toString()
                y = (230 - t * 220 / top).toString()
                at.push(x + "," + y)
            }
            i = i + 1
        }
        if at.length > 0 {
            traces.push(Trace { key: keys[j].copy(), tone: seriesOf(keys[j]).tone.copy(), points: joinWith(at, " "), x: x, y: y })
        }
        j = j + 1
    }
    let mut pts: Array<SparkStep> = []
    let mut i = 0
    while i < n {
        let commit = if i < commits.length { substring(commits[i], 0, 9) } else { "\u{2014}" }
        let mut p50s: Array<Array<String>> = []
        j = 0
        while j < keys.length {
            p50s.push([seriesOf(keys[j]).name, msOf(usAt(series[j], i)), ""])
            j = j + 1
        }
        let groups: Array<NumGroup> = [NumGroup { name: "built at", rows: [["vyrn", commit, ""]] }, NumGroup { name: "p50", rows: p50s }]
        let mut said: Array<String> = []
        for g in groups {
            for r in g.rows {
                said.push(g.name + " " + r[0] + " " + r[1])
            }
        }
        let name = substring(files[i], 0, files[i].byteLength - 5)
        pts.push(SparkStep { key: name.copy(), name: name.copy(), say: name + ": " + joinWith(said, ", "), groups: groups })
        i = i + 1
    }
    return Spark {
        first: msOf(usAt(series[0], 0)),
        last: msOf(usAt(series[0], n - 1)),
        say: "Vyrn's p50 in each of " + n.toString() + " records, oldest first",
        traces: traces,
        pts: pts,
    }
}

/// The `i`th time of a history list, or -1 where the list has none.
fn usAt(us: Array<Int64>, i: Int64) -> Int64 {
    if i < 0 || i >= us.length {
        return 0 - 1
    }
    return us[i]
}

type Cause = { program: String, verdict: String, cause: String, label: String }

fn causeRow(program: String) -> Cause {
    for row in causeRows() {
        if row.program == program {
            return Cause { program: row.program.copy(), verdict: row.verdict.copy(), cause: row.cause.copy(), label: row.label.copy() }
        }
    }
    return Cause { program: "", verdict: "", cause: "", label: "" }
}

fn causeRows() -> Array<Cause> {
    return [
        Cause { program: "nbody", verdict: "a deviation", cause: "Rust's compiler pairs the inner loop's multiplies into vector instructions, and Vyrn's does not: 103 paired multiplies against 5.", label: "no vector instructions" },
        Cause { program: "spectralnorm", verdict: "inside the noise band", cause: "", label: "" },
        Cause { program: "fannkuch", verdict: "at the edge of the band", cause: "The loop allocates nothing and checks no index. Where the remaining 152 ms against Rust goes is not yet measured.", label: "nothing allocated in the loop" },
        Cause { program: "binarytrees", verdict: "ahead of the band", cause: "Both Vyrn builds reuse freed nodes from a free list of their size; the C and Rust entries call the system allocator for every node.", label: "who allocates the memory" },
        Cause { program: "fasta", verdict: "a deviation", cause: "The random seed lives in a module global, so every byte drawn reads and writes memory where Rust keeps the seed in a register.", label: "a seed kept in memory" },
        Cause { program: "revcomp", verdict: "a deviation", cause: "Every byte goes in through an append that checks capacity, where Rust writes it into place. C is 2.6 times Rust here.", label: "a capacity check per byte" },
        Cause { program: "knucleotide", verdict: "ahead of the band", cause: "Maps carry a hash index, and the key is one number rolled along the sequence, not a fresh piece of text per position.", label: "faster than C, and why" },
        Cause { program: "pidigits", verdict: "inside the noise band", cause: "", label: "" },
        Cause { program: "mandelbrot", verdict: "inside the noise band", cause: "Plain floating-point arithmetic with no allocation, so six of the seven readings sit within 17% of C.", label: "the closest six readings here" },
        Cause { program: "regexredux", verdict: "a deviation", cause: "Vyrn runs a general regular-expression engine written in Vyrn; the C and Rust entries carry a sixty-line matcher fitted to this corpus.", label: "not the same engine on both sides" },
    ]
}

fn envText() -> String {
    return objectAt(recordText(run1File()), "  ", "environment")
}

export fn benchMachine() -> String {
    let env = envText()
    let hw = objectAt(env, "    ", "hardware")
    let vyrn = objectAt(env, "    ", "vyrn")
    let wasmtime = objectAt(env, "    ", "wasmtime")
    return textAt(hw, "      ", "cpu") + ", " + textAt(env, "    ", "os") + ", " + textAt(vyrn, "      ", "version") + ", wasmtime " + textAt(wasmtime, "      ", "version") + ", " + benchDate()
}

fn benchDate() -> String {
    return textAt(recordText(run1File()), "  ", "date")
}

export fn benchRuns() -> String {
    return scalarAt(recordText(run1File()), "  ", "runs")
}

export fn envRows() -> Array<Array<String>> {
    let env = envText()
    let hw = objectAt(env, "    ", "hardware")
    let vyrn = objectAt(env, "    ", "vyrn")
    let wasmtime = objectAt(env, "    ", "wasmtime")
    let wasmOpt = objectAt(env, "    ", "wasm_opt")
    let flags = objectAt(env, "    ", "flags")
    // No host row: a machine's name is private.
    return [
        ["Operating system", textAt(env, "    ", "os")],
        ["CPU", textAt(hw, "      ", "cpu") + " (" + scalarAt(hw, "      ", "cores") + " logical cores)"],
        ["Memory", scalarAt(hw, "      ", "ram_gib") + " GiB"],
        ["clang", textAt(env, "    ", "clang")],
        ["rustc", textAt(env, "    ", "rustc")],
        ["node", textAt(env, "    ", "node")],
        ["bun", textAt(env, "    ", "bun")],
        ["python", textAt(env, "    ", "python")],
        ["vyrn", textAt(vyrn, "      ", "version") + " at " + textAt(vyrn, "      ", "commit")],
        ["wasmtime", textAt(wasmtime, "      ", "version") + ", sha256 " + textAt(wasmtime, "      ", "lock_sha256")],
        ["wasm-opt", textAt(wasmOpt, "      ", "version") + ", sha256 " + textAt(wasmOpt, "      ", "lock_sha256")],
        ["C flags", textAt(flags, "      ", "c")],
        ["Rust flags", textAt(flags, "      ", "rust")],
        ["JavaScript on node", textAt(flags, "      ", "js")],
        ["JavaScript on bun", textAt(flags, "      ", "bun")],
        ["Vyrn native", textAt(flags, "      ", "vyrn-native")],
        ["Vyrn wasm", textAt(flags, "      ", "vyrn-wasm")],
        ["Vyrn wasm-opt", textAt(flags, "      ", "vyrn-wasm-opt")],
    ]
}

test "the record still has the shape this reader cuts" {
    loadCells()
    assertEq(cells.length, 70)
    for c in cells {
        assert(c.p50Us > 0)
        assert(c.p99Us >= c.p50Us)
        assert(c.startUs > 0)
        assert(c.startUs < c.p50Us)
        assert(c.cpuUs > 0)
        assert(c.peakBytes > 0)
        assert(c.artifactBytes > 0)
        assert(c.makeUs == 0 || c.makePeakBytes > 0)
    }
    assertEq(benchDate(), "2026-10-17")
    assertEq(benchRuns(), "100")
}

test "the p50s are the ones the published record holds" {
    assertEq(msOf(p50Of("nbody", "c")), "847 ms")
    assertEq(msOf(p50Of("nbody", "rust")), "637 ms")
    assertEq(msOf(p50Of("nbody", "js")), "1030 ms")
    assertEq(msOf(p50Of("nbody", "vyrn-native")), "974 ms")
    assertEq(msOf(p50Of("nbody", "vyrn-wasm")), "1059 ms")
    assertEq(msOf(p50Of("nbody", "vyrn-wasm-opt")), "933 ms")
    assertEq(msOf(p50Of("spectralnorm", "vyrn-wasm-opt")), "949 ms")
    assertEq(msOf(p50Of("knucleotide", "c")), "302 ms")
    assertEq(msOf(p50Of("knucleotide", "rust")), "195 ms")
    assertEq(msOf(p50Of("knucleotide", "vyrn-native")), "102 ms")
    assertEq(msOf(p50Of("binarytrees", "js")), "386 ms")
    assertEq(msOf(p50Of("binarytrees", "bun")), "338 ms")
    assertEq(msOf(p50Of("pidigits", "vyrn-native")), "1267 ms")
}

test "the normalized figures are the ones the record computes" {
    assertEq(ratioText(ratioOf("nbody", "vyrn-native", "c")), "1.15x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-wasm", "c")), "1.25x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-wasm-opt", "c")), "1.10x")
    assertEq(ratioText(ratioOf("spectralnorm", "vyrn-native", "c")), "1.00x")
    assertEq(ratioText(ratioOf("spectralnorm", "vyrn-wasm", "c")), "2.90x")
    assertEq(ratioText(ratioOf("spectralnorm", "vyrn-wasm-opt", "c")), "1.02x")
    assertEq(ratioText(ratioOf("binarytrees", "js", "c")), "0.49x")
    assertEq(ratioText(ratioOf("revcomp", "rust", "c")), "0.39x")
    assertEq(ratioText(ratioOf("knucleotide", "vyrn-native", "c")), "0.34x")
    assertEq(ratioText(ratioOf("knucleotide", "vyrn-wasm", "c")), "0.81x")
    assertEq(ratioText(ratioOf("nbody", "vyrn-native", "rust")), "1.53x")
    assertEq(ratioText(ratioOf("pidigits", "vyrn-native", "rust")), "1.01x")
    assertEq(ratioText(ratioOf("revcomp", "vyrn-native", "rust")), "1.50x")
}

test "a panel is the whole of what is known about one program" {
    let panels = axisPanels()
    assertEq(panels.length, 10)
    for p in panels {
        assertEq(p.lanes.length, 7)
        assert(p.verdict.byteLength > 0)
    }
    assertEq(panels[0].n, "25,000,000")
    assertEq(msOf(p50Of("nbody", "c")), "847 ms")
    assertEq(msOf(p50Of("nbody", "vyrn-wasm-opt")), "933 ms")
    assertEq(nativeVsRust("nbody"), "1.53x")
    assertEq(nativeVsRust("pidigits"), "1.01x")
    assertEq(nativeVsRust("knucleotide"), "0.52x")
    assertEq(panels[1].verdict, "inside the noise band")
    assertEq(panels[2].verdict, "at the edge of the band")
    assertEq(panels[3].verdict, "ahead of the band")
    assertEq(panels[6].verdict, "ahead of the band")
    assertEq(panels[7].verdict, "inside the noise band")
}

test "the caption names the hardware and the toolchain, and never the machine" {
    let cap = benchMachine()
    assert(contains(cap, "Ryzen"))
    assert(contains(cap, "wasmtime 49.0.3"))
    assert(contains(cap, "2026-10-17"))
    assertEq(envRows().length, 18)
    for row in envRows() {
        assert(row[0].byteLength > 0)
        assert(row[1].byteLength > 0)
        assert(row[0] != "Host")
    }
    assert(!contains(envText(), "\"host\""))
}

test "every program links to the game's own page for it" {
    let progs = programs()
    assertEq(progs.length, 10)
    for p in progs {
        assert(contains(p.game, "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/"))
        assert(contains(p.game, ".html"))
    }
    assertEq(progs[2].key, "fannkuch")
    assertEq(progs[2].name, "fannkuch-redux")
    assert(contains(progs[2].game, "/fannkuchredux.html"))
    assert(contains(progs[1].game, "/spectralnorm.html"))
    assert(contains(progs[6].game, "/knucleotide.html"))
    assert(contains(progs[5].game, "/revcomp.html"))
}

fn numOf(l: Lane, group: String, label: String) -> String {
    for g in l.groups {
        for r in g.rows {
            if g.name == group && r[0] == label {
                return r[1].copy()
            }
        }
    }
    return ""
}

fn rowCount(l: Lane) -> Int64 {
    let mut n = 0
    for g in l.groups {
        n = n + g.rows.length
    }
    return n
}

test "every lane carries the columns the game prints, its output and its build's memory" {
    for p in programs() {
        for l in lanesFor(p.key) {
            assert(contains(numOf(l, "run", "cpu"), " s"))
            assert(!contains(numOf(l, "run", "cpu"), "\u{2014}"))
            assert(contains(numOf(l, "run", "peak"), " MB"))
            assert(contains(l.mem, " MB"))
            assert(contains(numOf(l, "size", "source gz"), " KB"))
            assert(contains(numOf(l, "size", "output"), "B"))
            if l.key == "js" || l.key == "bun" {
                assertEq(numOf(l, "build", "peak"), "none")
                assert(contains(numOf(l, "size", "output"), " KB, the source"))
            } else {
                assert(contains(numOf(l, "build", "peak"), " MB"))
            }
        }
    }
}

test "the lanes of a program share one scale and run fastest first" {
    for p in programs() {
        let lanes = lanesFor(p.key)
        assertEq(lanes.length, 7)
        let mut full = 0
        let mut last = 0
        for l in lanes {
            let total = totalOf(cellOf(p.key, l.key))
            assert(total >= last)
            last = total
            if contains(l.style, "--w: 1.000;") {
                full = full + 1
            }
        }
        assert(full >= 1)
        assertEq(numOf(lanes[0], "total", "vs fastest"), "1.00x")
    }
}

test "a lane is its build, its startup, the rest of its p50 and its tail to p99" {
    let lanes = lanesFor("nbody")
    assertEq(lanes[0].key, "rust")
    assertEq(lanes[6].key, "bun")
    for l in lanes {
        if l.key == "c" {
            assertEq(l.style, "--w: 0.692; --b: 13.4%; --s: 0.3%; --r: 79.6%; --t: 6.5%")
            assertEq(l.total, "989 ms")
            assertEq(l.runText, "run 847 ms")
        }
        if l.key == "js" || l.key == "bun" {
            assert(contains(l.style, "; --b: 0.0%;"))
            assertEq(numOf(l, "build", "time"), "none")
        }
    }
    assertEq(shareOf(1, 4), "25.0%")
    assertEq(shareOf(1, 3), "33.3%")
    assertEq(shareOf(5, 0), "0.0%")
    assertEq(thousandthsText(1000), "1.000")
    assertEq(thousandthsText(390), "0.390")
    assertEq(thousandthsText(5), "0.005")
}

test "the front page's lanes sum every program, and claim no p99" {
    let lanes = frontLanes()
    assertEq(lanes.length, 7)
    for l in lanes {
        let mut total = 0
        for p in progNames() {
            total = total + totalOf(cellOf(p[0], l.key))
        }
        assertEq(l.total, msOf(total))
        assertEq(rowCount(l), 5)
        assertEq(numOf(l, "run", "peak"), l.mem)
        assertEq(l.href, "/benchmarks.html")
        assert(contains(l.style, "; --t: 0.0%"))
        assert(!contains(l.say, "p99"))
    }
}

test "a lane's accessible name carries every number its readout shows" {
    for p in programs() {
        for l in lanesFor(p.key) {
            assertEq(rowCount(l), 12)
            assert(contains(l.say, l.name + ": "))
            for g in l.groups {
                for r in g.rows {
                    assert(contains(l.say, g.name + " " + r[0] + " " + r[1]))
                }
            }
        }
    }
}

test "every row points at the program behind it" {
    for p in programs() {
        assertEq(srcHref(p.key, "c"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/c/" + p.key + ".c")
        assertEq(srcHref(p.key, "rust"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/rust/" + p.key + ".rs")
        assertEq(srcHref(p.key, "js"), "https://github.com/vyrn-lang/vyrn/blob/main/bench/harness/js/" + p.key + ".js")
        assertEq(srcHref(p.key, "bun"), srcHref(p.key, "js"))
        assertEq(srcHref(p.key, "vyrn-native"), srcHref(p.key, "vyrn-wasm"))
        assertEq(srcHref(p.key, "vyrn-wasm-opt"), srcHref(p.key, "vyrn-wasm"))
        assertEq(srcHref(p.key, "vyrn-native"), "https://github.com/vyrn-lang/vyrn/blob/main/examples/" + p.key + ".vyrn")
    }
}

test "a row with nothing to explain explains nothing" {
    let mut silent = 0
    for p in axisPanels() {
        if p.cause.byteLength == 0 {
            assertEq(p.label, "")
            assertEq(p.verdict, "inside the noise band")
            silent = silent + 1
            continue
        }
        assert(p.label.byteLength > 0)
        assert(p.label.byteLength < 40)
        assert(p.cause.byteLength > 40)
        assert(!contains(p.cause, "Not a deviation"))
        assert(!contains(p.cause, "noise band"))
    }
    assertEq(silent, 2)
    for p in axisPanels() {
        if p.verdict == "a deviation" {
            assert(p.cause.byteLength > 40)
        }
    }
}

test "the page names no design record and no internal symbol" {
    let banned = ["RFC-", "std/", "noalias", "malloc", "sqrt", "()", "Int64", "wasm ", "UTF-8", "V8"]
    for row in causeRows() {
        for word in banned {
            assert(!contains(row.cause, word))
            assert(!contains(row.label, word))
        }
    }
}

test "a second, a memory size and a byte count read the way the game prints them" {
    assertEq(secsOf(898000), "0.90")
    assertEq(secsOf(13029000), "13.03")
    assertEq(secsOf(10100), "0.01")
    assertEq(secsOf(4000), "<0.01")
    assertEq(secsOf(0), "0.00")
    assertEq(secsOf(0 - 1), "\u{2014}")
    assertEq(buildOf(0), "none")
    assertEq(buildOf(591825), "592 ms")
    assertEq(memOf(4386816), "4.2 MB")
    assertEq(memOf(1048576), "1.0 MB")
    assertEq(memOf(41000000), "39.1 MB")
    assertEq(memOf(0), "\u{2014}")
    assertEq(sizeOf(1168), "1.1 KB")
    assertEq(sizeOf(1048524), "1023.9 KB")
    assertEq(sizeOf(1048576), "1.0 MB")
    assertEq(sizeOf(1433088), "1.4 MB")
    assertEq(sizeOf(0), "\u{2014}")
}

test "no escape survives into the page" {
    assertEq(unescaped("100,000 \\u2014 a hundred"), "100,000 \u{2014} a hundred")
    assertEq(unescaped("\\\\w+"), "\\w+")
    assertEq(unescaped("line\\nbreak"), "line\nbreak")
    assertEq(unescaped("nothing to undo"), "nothing to undo")
    assertEq(charOf(65), "A")
    assertEq(charOf(233), "\u{E9}")
    assertEq(charOf(8212), "\u{2014}")
    assertEq(hexAt("\\u2014", 2), 8212)
    assertEq(hexAt("00ff", 0), 255)
    assertEq(hexAt("00FF", 0), 255)
    for prog in programs() {
        assert(!contains(prog.note, "\\"))
    }
    for row in envRows() {
        assert(!contains(row[1], "\\"))
    }
}

test "a thousands separator lands every three digits and nowhere else" {
    assertEq(grouped("25000000"), "25,000,000")
    assertEq(grouped("100"), "100")
    assertEq(grouped("1000"), "1,000")
    assertEq(grouped("11"), "11")
}

test "a duration and a ratio read the way the record's tables print them" {
    assertEq(msOf(898000), "898 ms")
    assertEq(msOf(10100), "10.1 ms")
    assertEq(msOf(99900), "99.9 ms")
    assertEq(msOf(100000), "100 ms")
    assertEq(ratioText(97), "0.97x")
    assertEq(ratioText(1452), "14.52x")
    assertEq(ratioText(9999), "99.99x")
    assertEq(ratioText(10000), "100x")
    assertEq(ratioText(28700), "287x")
}

test "a sparkline has one step per committed record, on one scale from zero" {
    let s = sparkOf("nbody")
    assertEq(s.pts.length, 6)
    assertEq(s.pts[0].name, "2026-09-01")
    assertEq(s.pts[5].name, "2026-10-17")
    assertEq(s.first, "882 ms")
    assertEq(s.last, "974 ms")
    assertEq(s.traces.length, 3)
    assertEq(s.traces[1].points, "100,13 300,10 500,210 700,210 900,209 1100,212")
    assertEq(s.traces[2].points, "900,213 1100,214")
    assertEq(s.pts[0].groups[1].rows[2][1], "\u{2014}")
    for p in s.pts {
        for g in p.groups {
            for r in g.rows {
                assert(contains(p.say, g.name + " " + r[0] + " " + r[1]))
            }
        }
    }
    assertEq(listAt("\n  \"k\": [\"a\", \"b\"],\n", "  ", "k").length, 2)
    assertEq(listAt("\n  \"k\": [],\n", "  ", "k").length, 0)
}

test "no lane's bar or total crosses into the memory column" {
    // `.lbar` takes `--w` of the track less 9ch for the total, so a bar fits when `--w` is at most 1 and the total is at most 9 characters.
    let mut all: Array<Array<Lane>> = [frontLanes()]
    for p in programs() {
        all.push(lanesFor(p.key))
    }
    for lanes in all {
        let mut widest = 0
        for l in lanes {
            let w = substring(l.style, 5, 10)
            assert(w == "1.000" || substring(w, 0, 2) == "0.")
            if w == "1.000" {
                widest = widest + 1
            }
            assert(l.total.byteLength <= 9)
        }
        assert(widest >= 1)
    }
}
