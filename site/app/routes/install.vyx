<script>
// GET /install: the quickstart. Two installers exist, `install.sh` and
// `install.ps1`, so the page shows two commands; macOS and Linux share the
// first. The commands live in `installTargets()` in `../repo`, which the
// landing's hero reads too.
//
// A tile names its OS in words: the two bound icon collections (`bytesize`,
// `codex`) hold no OS glyph, and a provider tag takes static attributes only.
// Neither installer takes a version; both resolve the newest release, and the
// version shown comes from `../repo`.
import { Head } from "std/ui"
import { pageHeadOf } from "../nav"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, InstallTarget, installTargets, installScript } from "../repo"

export fn head() -> Head {
    return pageHeadOf("/install")
}

/// The source build, which is the same three lines everywhere.
fn sourceBuild() -> String {
    return "git clone https://github.com/vyrn-lang/vyrn.git\ncd vyrn/compiler\ncargo build --release -p vyrn-cli"
}

/// Deleting the directory the installer wrote. That IS the uninstall: nothing
/// is registered, nothing is written outside it, and no service is installed.
fn uninstall() -> String {
    return "rm -rf ~/.vyrn"
}

fn firstRun() -> String {
    return "vyrn run examples/fib.vyrn"
}

/// Pinning a tag instead of taking the newest release. The variable goes on the
/// `sh` at the end of the pipe, which is where the script actually runs.
/// With no release there is no tag to name, so the command shows where one goes.
fn pinnedInstall() -> String {
    let tag = if hasRelease() { releaseTag() } else { "TAG" }
    return "curl -fsSL " + installScript("install.sh") + " | VYRN_VERSION=" + tag + " sh"
}

/// Checking a manual download by hand, which is what the installer does for you.
fn manualCheck() -> String {
    return "sha256sum -c SHA256SUMS"
}

/// The kicker over the heading: the word, then the version it installs today.
fn kicker() -> String {
    if !hasRelease() {
        return "Install"
    }
    return "Install · " + releaseTag()
}

/// The radio that selects one target's pane. The first is checked, and the
/// stylesheet selects the pane with `:checked ~`, so the picker needs no script.
fn osId(p: InstallTarget) -> String {
    return "os-" + p.id
}

/// The script the selected command pipes into a shell, as a page a reader can
/// read first. The link names the `.txt` twin: GitHub Pages types a file by
/// its extension, so `/install.sh` and `/install.ps1` download instead of
/// showing, and a `.txt` is served as `text/plain`. The bytes are the same.
fn scriptHref(p: InstallTarget) -> String {
    if p.id == "windows" {
        return "/install.ps1.txt"
    }
    return "/install.sh.txt"
}

/// The same file under its own name, for the reader who wants the file and not
/// a page of it. The command pipes this one.
fn scriptDownload(p: InstallTarget) -> String {
    if p.id == "windows" {
        return "/install.ps1"
    }
    return "/install.sh"
}

</script>

<template>
<main class="page wide">
        <section class="hero mid">
            <p class="eyebrow">{{ kicker() }}</p>
            <h1 class="display">Install Vyrn</h1>
            <p class="lede">One command installs one self-contained binary. To uninstall, delete its directory.</p>

            <!-- Two radio buttons and no script. The inputs come first so
                 `:checked ~ .ospanes` reaches the panes, which the stylesheet
                 selects by position. They are written out because only the
                 first carries `checked`: `v-for` cannot put an attribute on one
                 iteration, and an empty `checked=""` still checks. `widgets.js`
                 reads `data-os` to open on the visitor's own system. -->
            <fieldset class="picker">
                <legend class="sr-only">Operating system</legend>
                <input class="sr-only" type="radio" name="os" id="os-unix" checked="checked" data-os="unix"/>
                <input class="sr-only" type="radio" name="os" id="os-windows" data-os="windows"/>
                <div class="tabrow">
                    <div class="ostabs">
                        <label v-for="p in installTargets()" :key="p.id" :for="osId(p)">{{ p.name }}</label>
                    </div>
                </div>
                <div class="ospanes">
                    <div class="ospane" v-for="p in installTargets()" :key="p.id">
                        <div class="cmd" data-copy>
                            <code v-html="shellHtml(p.cmd)"></code>
                            <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                        </div>
                        <p class="ctarow"><a class="cta" :href="scriptHref(p)">View the install script</a> <a class="cta" :href="scriptDownload(p)" download>Download</a></p>
                    </div>
                </div>
            </fieldset>

            <p class="ctarow"><a class="cta" href="/releases.html">Release notes</a></p>
        </section>

        <section class="band split" id="verify">
            <div class="say">
                <h2>Checksum verification</h2>
                <p>Read the script before you run it: <a href="https://github.com/vyrn-lang/vyrn/blob/main/install.sh">install.sh</a>, <a href="https://github.com/vyrn-lang/vyrn/blob/main/install.ps1">install.ps1</a>.</p>
            </div>
            <ul class="plain">
                <li><strong>Downloads the release's own <code>SHA256SUMS</code></strong></li>
                <li><strong>Hashes the archive and compares</strong><span>A mismatch deletes it and installs nothing.</span></li>
                <li><strong>Both refusals run on every push</strong><span>On all three platforms, against a fake release.</span></li>
            </ul>
        </section>

        <section class="band" id="advanced">
            <h2>Advanced</h2>
            <details class="disc">
                <summary>Pin a version, check by hand, uninstall, build from source</summary>
                <p>It installs one archive into <code>~/.vyrn/bin</code>, or <code>%USERPROFILE%\.vyrn\bin</code> on Windows, and writes nothing outside it.</p>
                <p>Pin a tag instead of taking the newest release:</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(pinnedInstall())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the pinned install command">Copy</button>
                </div>
                <p>Check a manual download yourself:</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(manualCheck())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the checksum command">Copy</button>
                </div>
                <p>Uninstall:</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(uninstall())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the uninstall command">Copy</button>
                </div>
                <p>Build from source, for the newest commit or a machine with no archive. It needs a recent Rust toolchain, and <code>clang</code> on <code>PATH</code> for a native binary.</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(sourceBuild())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the build commands">Copy</button>
                </div>
            </details>
        </section>

        <section class="band" id="after">
            <h2>Next steps</h2>
            <div class="cmd" data-copy>
                <code v-html="shellHtml(firstRun())"></code>
                <button type="button" data-copy-btn aria-label="Copy the run command">Copy</button>
            </div>
            <p class="ctarow"><a class="cta" href="/guide/getting-started.html">Quickstart</a> <a class="cta" href="/docs.html">Reference</a> <a class="cta" href="/play.html">Play</a> <a class="cta" href="/tooling/editors.html">Editor</a></p>
        </section>
</main>
</template>
