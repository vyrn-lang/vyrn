<script>
// GET /install — the quickstart (RFC-0106 M2).
//
// THREE TILES, ONE COMMAND EACH, and no method a reader could not run today.
// Two installers exist — `install.sh` and `install.ps1` — so the tiles carry two
// commands between them. There is no `brew` line, no `apt` line and no `winget`
// line, because there is no formula, no package and no manifest; a tab for a
// method that does not exist is the same fabrication as a "used by" logo.
//
// NO OS GLYPH ON A TILE, and the reason is measured rather than assumed: the two
// hash-locked collections this site binds (`bytesize`, `codex`) hold 180 glyphs
// between them and none of them is an apple, a penguin or a window. A `v-for`
// could not carry one either — a provider tag takes static attributes, and
// `:name` binds an expression (RFC-0107 M1) — so the tiles stay a loop over
// `platforms()` and the OS is named in words, which is what a reader scans for.
//
// NO VERSION IS WRITTEN HERE. Neither installer takes one: both resolve the
// newest release themselves, pre-releases included. The version SHOWN comes from
// `site/release.txt` through `../repo`, baked while this page built, and
// `fresh.js` says so on the page if a newer one appears before the next build.
import { Head } from "std/ui"
import { pageHeadOf } from "../nav"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, releaseDate, releasePre, releaseUrl } from "../repo"
import { Icon } from "../icons"

/// One platform: the one-line install, and what lands.
type Platform = { id: String, name: String, install: String, archive: String, home: String }

export fn head() -> Head {
    return pageHeadOf("/install")
}

fn platforms() -> Array<Platform> {
    return [
        Platform {
            id: "macos",
            name: "macOS",
            install: "curl -fsSL https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh | sh",
            archive: "vyrn-aarch64-macos.tar.gz",
            home: "~/.vyrn/bin",
        },
        Platform {
            id: "linux",
            name: "Linux",
            install: "curl -fsSL https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh | sh",
            archive: "vyrn-x86_64-linux.tar.gz",
            home: "~/.vyrn/bin",
        },
        Platform {
            id: "windows",
            name: "Windows",
            install: "irm https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.ps1 | iex",
            archive: "vyrn-x86_64-windows.zip",
            home: "%USERPROFILE%\\.vyrn\\bin",
        },
    ]
}

/// The source build, which is the same three lines everywhere.
fn sourceBuild() -> String {
    return "git clone https://github.com/vyrn-lang/vyrn.git\ncd vyrn/compiler\ncargo build --release -p vyrn-cli"
}

/// Deleting the directory the installer wrote. That IS the uninstall: nothing
/// is registered, nothing is written outside it, and no service is installed.
fn uninstall() -> String {
    return "rm -rf ~/.vyrn"
}

fn firstRun() -> String {
    return "vyrn run examples/fib.vyrn"
}

/// Pinning a tag instead of taking the newest release. The variable goes on the
/// `sh` at the end of the pipe, which is where the script actually runs.
fn pinnedInstall() -> String {
    if !hasRelease() {
        return "VYRN_VERSION=v0.1.0 sh"
    }
    return "curl -fsSL https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh | VYRN_VERSION=" + releaseTag() + " sh"
}

/// Checking a manual download by hand, which is what the installer does for you.
fn manualCheck() -> String {
    return "sha256sum -c SHA256SUMS"
}

/// The version line under the heading. One function, because the two states
/// differ by a fact and not by a layout.
fn versionLine() -> String {
    if !hasRelease() {
        return "Nothing published yet: the script says so and points at the source build."
    }
    let kind = if releasePre() { "pre-release" } else { "release" }
    return releaseTag() + ", published " + releaseDate() + " as a " + kind + "."
}

/// The kicker over the heading: the word, then the version it installs today.
fn kicker() -> String {
    if !hasRelease() {
        return "Install"
    }
    return "Install · " + releaseTag()
}

/// The radio that selects one platform's pane. Three inputs, one name, and the
/// FIRST is checked — which is what makes the picker work with no script at
/// all: the sheet selects the pane with `:checked ~`, and a browser with
/// JavaScript switched off still has radio buttons.
fn osId(p: Platform) -> String {
    return "os-" + p.id
}
</script>

<template>
<main class="page wide">
        <!-- A CENTRED HERO, AND ONE COMMAND ON IT (RFC-0106 M3). Three tiles
             with three commands made a reader compare rows before they could
             type anything; the picker answers "which machine" once and shows
             one command. -->
        <section class="hero mid">
            <p class="eyebrow">{{ kicker() }}</p>
            <h1 class="display">Install Vyrn</h1>
            <p class="lede">One command, one self-contained binary, nothing else to install. Uninstalling is deleting a directory.</p>

            <!-- THE PICKER IS THREE RADIO BUTTONS AND NO SCRIPT. The inputs come
                 first so `:checked ~ .ospanes` can reach the panes; the sheet
                 selects by position (`:nth-of-type`), so nothing here depends on
                 an id spelled twice. They are written out rather than looped
                 because only the first carries `checked`, and `v-for` has no way
                 to put an attribute on one iteration — an empty `checked=""` is
                 still checked in HTML, so a bound value cannot express it. -->
            <fieldset class="picker">
                <legend class="sr-only">Operating system</legend>
                <input class="sr-only" type="radio" name="os" id="os-macos" checked="checked"/>
                <input class="sr-only" type="radio" name="os" id="os-linux"/>
                <input class="sr-only" type="radio" name="os" id="os-windows"/>
                <div class="ostabs">
                    <label v-for="p in platforms()" :key="p.id" :for="osId(p)">{{ p.name }}</label>
                </div>
                <div class="ospanes">
                    <div class="ospane" v-for="p in platforms()" :key="p.id">
                        <div class="cmd" data-copy>
                            <code v-html="shellHtml(p.install)"></code>
                            <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                        </div>
                        <p class="eyebrow"><code>{{ p.archive }}</code> into <code>{{ p.home }}</code></p>
                    </div>
                </div>
            </fieldset>

            <p class="eyebrow">{{ versionLine() }} <a :href="releaseUrl()">Release notes</a></p>
            <p class="notice" role="status" :data-release-note="releaseTag()" hidden="hidden"></p>
        </section>

        <section class="band split" id="verify">
            <div class="say">
                <p class="eyebrow"><Icon name="bytesize:lock"/> Verified</p>
                <h2>It refuses what it cannot check</h2>
                <p>Running a stranger's script deserves this much. Read it first: <a href="https://github.com/vyrn-lang/vyrn/blob/main/install.sh">install.sh</a>, <a href="https://github.com/vyrn-lang/vyrn/blob/main/install.ps1">install.ps1</a>.</p>
            </div>
            <ul class="plain">
                <li><strong>Downloads the release's own <code>SHA256SUMS</code></strong></li>
                <li><strong>Hashes the archive and compares</strong><span>A mismatch deletes it and installs nothing.</span></li>
                <li><strong>Both refusals run on every push</strong><span>On all three platforms, against a fake release.</span></li>
            </ul>
        </section>

        <section class="band" id="advanced">
            <p class="eyebrow">Advanced</p>
            <details class="disc">
                <summary>Pin a version, check by hand, uninstall, build from source</summary>
                <p>Pin a tag instead of taking the newest release:</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(pinnedInstall())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the pinned install command">Copy</button>
                </div>
                <p>Check a manual download yourself:</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(manualCheck())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the checksum command">Copy</button>
                </div>
                <p>Uninstall:</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(uninstall())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the uninstall command">Copy</button>
                </div>
                <p>Build from source, for the newest commit or a machine with no archive. Needs a recent Rust toolchain; a native binary needs <code>clang</code> on <code>PATH</code>.</p>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(sourceBuild())"></code>
                    <button type="button" data-copy-btn aria-label="Copy the build commands">Copy</button>
                </div>
            </details>
        </section>

        <section class="band" id="after">
            <p class="eyebrow">Then</p>
            <h2>Build something</h2>
            <div class="cmd" data-copy>
                <code v-html="shellHtml(firstRun())"></code>
                <button type="button" data-copy-btn aria-label="Copy the run command">Copy</button>
            </div>
            <p class="ctarow"><a class="cta" href="/guide/getting-started.html">Quickstart</a> <a class="cta" href="/docs.html">Reference</a> <a class="cta" href="/play.html">Play</a> <a class="cta" href="/docs/editors.html">Editor</a></p>
        </section>
</main>
</template>
