<script>
// GET /install — the quickstart, and the most important page on the site after
// the landing page.
//
// It used to say there was no binary and send every reader to `cargo build`.
// There is one: `install.sh` and `install.ps1` ship in the repository, CI runs
// both of them on Linux, macOS and Windows on every push, and they download the
// archive for the machine they are on, verify it against the release's own
// SHA256SUMS, and refuse to install anything they cannot verify.
//
// NO VERSION IS WRITTEN HERE. Neither installer takes one: both resolve the
// newest release themselves, pre-releases included, which is why the command is
// the same on the day of a release and the day after. The version SHOWN comes
// from `site/release.txt` through `../repo`, baked while this page built, and
// `fresh.js` says so on the page if a newer one appears before the next build.
import { Head } from "std/ui"
import { pageHead } from "../nav"
import { vyrnHtml } from "../snippets"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, releaseDate, releasePre, releaseUrl } from "../repo"

/// One platform: the one-line install, what it fetches, and the first run.
type Platform = { id: String, name: String, install: String, archive: String, deps: String, run: String }

export fn head() -> Head {
    return pageHead("Install — Vyrn")
}

fn platforms() -> Array<Platform> {
    return [
        Platform {
            id: "linux",
            name: "Linux",
            install: "curl -fsSL https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh | sh",
            archive: "vyrn-x86_64-linux.tar.gz — on a machine with no published archive the script says so and stops",
            deps: "Nothing. <code>clang</code>, and only for a native binary.",
            run: "vyrn run examples/fib.vyrn",
        },
        Platform {
            id: "macos",
            name: "macOS",
            install: "curl -fsSL https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh | sh",
            archive: "vyrn-aarch64-macos.tar.gz — Apple silicon; an Intel Mac builds from source",
            deps: "Nothing. Xcode command line tools supply the <code>clang</code> a native binary needs.",
            run: "vyrn run examples/fib.vyrn",
        },
        Platform {
            id: "windows",
            name: "Windows",
            install: "irm https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.ps1 | iex",
            archive: "vyrn-x86_64-windows.zip",
            deps: "Nothing. <code>clang</code>, and only for a native binary.",
            run: "vyrn run examples\\fib.vyrn",
        },
    ]
}

/// What to build next, and what each command proves.
type Step = { title: String, command: String, what: String }

fn steps() -> Array<Step> {
    return [
        Step { title: "Run a program", command: "vyrn run examples/fib.vyrn", what: "The tree-walking interpreter. Needs nothing but the compiler." },
        Step { title: "Build a WebAssembly module", command: "vyrn build examples/fib.vyrn --target wasm -o fib.wasm", what: "The compiler emits the module directly. No LLVM, no <code>clang</code>, no sysroot." },
        Step { title: "Build a native binary", command: "vyrn build examples/fib.vyrn -o fib", what: "Textual LLVM IR, linked with <code>clang</code>. Needs <code>clang</code> on <code>PATH</code>, or <code>$CLANG</code>." },
        Step { title: "Run the tests in a file", command: "vyrn test examples/testing.vyrn", what: "<code>test</code> blocks live in the source file, beside the code they check." },
        Step { title: "Ask about the memory", command: "vyrn why --memory examples/ownership.vyrn", what: "Per binding: whether it is reclaimed, how, and the reason when it is not." },
    ]
}

fn firstProgram() -> String {
    return vyrnHtml("hello")
}

/// The one command that builds the language server. It is written here rather
/// than in the template because the template shows it coloured, and a coloured
/// command is built from its text.
fn lspBuild() -> String {
    return "cargo build --release --manifest-path vyrn-lsp/Cargo.toml"
}

/// The source build, which is the same three lines everywhere.
fn sourceBuild() -> String {
    return "git clone https://github.com/vyrn-lang/vyrn.git\ncd vyrn/compiler\ncargo build --release -p vyrn-cli"
}

fn sourceRun() -> String {
    return "./target/release/vyrn run ../examples/fib.vyrn"
}

/// Pinning a tag instead of taking the newest release. The variable goes on the
/// `sh` at the end of the pipe, which is where the script actually runs.
fn pinnedInstall() -> String {
    if !hasRelease() {
        return "VYRN_VERSION=v0.1.0 sh"
    }
    return "curl -fsSL https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh | VYRN_VERSION=" + releaseTag() + " sh"
}

/// Checking a manual download by hand, which is what the installer does for you.
fn manualCheck() -> String {
    return "sha256sum -c SHA256SUMS"
}

/// The version line under the heading, or the honest sentence when there is no
/// release to name. One function, because the two states differ by a fact and
/// not by a layout.
fn versionLine() -> String {
    if !hasRelease() {
        return "Nothing is published yet, so the commands below build from source."
    }
    let kind = if releasePre() { "pre-release" } else { "release" }
    return releaseTag() + ", published " + releaseDate() + " as a " + kind + "."
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#get"><span class="n">01</span>install it</a>
        <a href="#verify"><span class="n">02</span>what it verifies</a>
        <a href="#source"><span class="n">03</span>from source</a>
        <a href="#check"><span class="n">04</span>check it</a>
        <a href="#first"><span class="n">05</span>first program</a>
        <a href="#editor"><span class="n">06</span>editor</a>
    </aside>
        <section class="hero">
            <p class="eyebrow">Install</p>
            <h1 class="display">One command, and it runs</h1>
            <p class="lede">Vyrn is early and the language still changes without a deprecation period. Installing it is one line: the script downloads the archive for your machine, checks it against the release's own checksums, and refuses to install bytes it cannot verify.</p>
            <p class="notice">{{ versionLine() }} <a :href="releaseUrl()">Release notes</a></p>
            <p class="notice" :data-release-note="releaseTag()" hidden="hidden"></p>
        </section>

        <section class="band" id="get">
            <p class="eyebrow">01 — install it</p>
            <h2>The one line</h2>
            <div class="plate" data-install>
                <div class="plate-head">
                    <span class="pill live">Quickstart</span>
                    <span class="eyebrow">newest release</span>
                </div>
                <div class="tabs">
                    <button type="button" v-for="p in platforms()" :key="p.id" :data-plat="p.id">{{ p.name }}</button>
                </div>
                <div class="stage panes">
                    <div v-for="p in platforms()" :key="p.id" :data-plat-pane="p.id">
                        <div class="cmd" data-copy>
                            <code v-html="shellHtml(p.install)"></code>
                            <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                        </div>
                        <p class="eyebrow" style="margin-top:24px">It downloads</p>
                        <p>{{ p.archive }}</p>
                        <p class="eyebrow" style="margin-top:24px">Then</p>
                        <div class="cmd" data-copy>
                            <code v-html="shellHtml(p.run)"></code>
                            <button type="button" data-copy-btn aria-label="Copy the run command">Copy</button>
                        </div>
                        <p class="eyebrow" style="margin-top:24px">You need</p>
                        <p v-html="p.deps"></p>
                    </div>
                </div>
                <p class="cap">The platform is picked from your browser and you can change it. The binary lands in <code>~/.vyrn/bin</code> (<code>%USERPROFILE%\.vyrn\bin</code> on Windows) with <code>std/</code> and <code>web/</code> beside it, and the script tells you what to add to your <code>PATH</code>.</p>
            </div>
            <p class="notice">No version is written in that command, and none needs to be: the script resolves the newest release itself — pre-releases included, which is what every release so far has been. To pin one instead: <code>{{ pinnedInstall() }}</code>, or <code>$env:VYRN_VERSION</code> on Windows.</p>
        </section>

        <section class="band" id="verify">
            <p class="eyebrow">02 — what it verifies</p>
            <h2>It refuses what it cannot check</h2>
            <p>A one-line installer is a request to run a stranger's shell script, so this is what that script does before it writes anything to your disk:</p>
            <ul class="plain">
                <li><strong>It downloads the release's own <code>SHA256SUMS</code></strong><span class="note">Published as an asset of the same release, generated by <code>sha256sum</code> over the archives in the workflow that built them.</span></li>
                <li><strong>It hashes what it downloaded and compares</strong><span class="note">On a mismatch it deletes the download, prints both hashes, and installs nothing. On an archive that is not listed at all, it refuses for that reason instead.</span></li>
                <li><strong>Both refusals are executed on every push</strong><span class="note"><code>install-test.sh</code> and <code>install-test.ps1</code> run the real installers against a fake release, on Linux, macOS and Windows, including the corrupted-archive case. A checksum check nobody executes is a paragraph, not a check.</span></li>
            </ul>
            <p>Prefer to do it by hand? Download the archive and <code>SHA256SUMS</code> from the release page and run:</p>
            <div class="cmd" data-copy>
                <code v-html="shellHtml(manualCheck())"></code>
                <button type="button" data-copy-btn aria-label="Copy the checksum command">Copy</button>
            </div>
            <p class="notice">Read the script before you pipe it: <a href="https://github.com/vyrn-lang/vyrn/blob/main/install.sh">install.sh</a> and <a href="https://github.com/vyrn-lang/vyrn/blob/main/install.ps1">install.ps1</a> are both about a hundred and thirty lines, and every line of them is on that page.</p>
        </section>

        <section class="band" id="source">
            <p class="eyebrow">03 — from source</p>
            <h2>Or build the compiler</h2>
            <p>The newest commit rather than the newest release, a platform with no published archive, or plain preference. It is one clone and one <code>cargo build</code>, the same three lines on every platform, and it needs a recent Rust toolchain.</p>
            <div class="cmd" data-copy>
                <code v-html="shellHtml(sourceBuild())"></code>
                <button type="button" data-copy-btn aria-label="Copy the build commands">Copy</button>
            </div>
            <p>Then run an example from <code>vyrn/compiler</code>, where the examples are one directory up:</p>
            <div class="cmd" data-copy>
                <code v-html="shellHtml(sourceRun())"></code>
                <button type="button" data-copy-btn aria-label="Copy the run command">Copy</button>
            </div>
            <p class="cap">On Windows that last one is <code>.\target\release\vyrn.exe run ..\examples\fib.vyrn</code>.</p>
            <p class="notice">A native binary needs <code>clang</code> on <code>PATH</code> (or <code>$CLANG</code>). A WebAssembly module needs nothing extra. The full parity harness also needs a <code>wasmtime</code>, through <code>$VYRN_WASMTIME</code>.</p>
        </section>

        <section class="band" id="check">
            <p class="eyebrow">04 — check it</p>
            <h2>Five commands worth knowing on day one</h2>
            <ul class="plain">
                <li v-for="s in steps()" :key="s.title">
                    <strong>{{ s.title }}</strong>
                    <div class="cmd" data-copy>
                        <code v-html="shellHtml(s.command)"></code>
                        <button type="button" data-copy-btn aria-label="Copy this command">Copy</button>
                    </div>
                    <span class="note" v-html="s.what"></span>
                </li>
            </ul>
        </section>

        <section class="band" id="first">
            <p class="eyebrow">05 — first program</p>
            <h2>Hello</h2>
            <p>Put this in <code>hello.vyrn</code> and run <code>vyrn run hello.vyrn</code>. The same file builds to a native binary and to a WebAssembly module, and all three print the same bytes.</p>
            <pre class="code" v-html="firstProgram()"></pre>
        </section>

        <section class="band" id="editor">
            <p class="eyebrow">06 — editor</p>
            <h2>The language server</h2>
            <p><code>vyrn-lsp</code> is a synchronous language server: diagnostics, hover, go-to-definition and completion, across linked files. The VS Code extension lives in <code>editor/vscode/</code>. It is excluded from the main workspace, so it is built on its own:</p>
            <div class="cmd" data-copy>
                <code v-html="shellHtml(lspBuild())"></code>
                <button type="button" data-copy-btn aria-label="Copy the language server build command">Copy</button>
            </div>
            <p class="notice">Modules resolve from <code>vyrn.json</code>. Remote imports (<code>github:</code>, <code>gist:</code>, <code>https:</code>) are pinned in <code>vyrn.lock</code> and cached by sha256 under <code>~/.vyrn</code>. <code>--offline</code> refuses to fetch.</p>
        </section>
</main>
</template>
