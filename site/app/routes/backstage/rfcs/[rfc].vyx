<script>
// GET /backstage/rfcs/[rfc] — one design record, rendered from its own file.
//
// The markdown is read at export time and rendered by `site/app/markdown.vyrn`,
// which knows the subset the corpus is written in and REFUSES anything else. A
// refusal returns 404 here, which fails the export, which fails the build — the
// reason is printed beside it so the log names the construct and the record it
// was found in. That is the whole honesty argument: the record cannot grow a
// construct this site renders wrongly without somebody being told.
//
// The document supplies its own `<h1>` — every record opens with one — so this
// page does not write a second heading above it.
layout="none"
import { IndexRow, rfcRow, rfcSlug, rfcTag, rfcBody, rfcSource, rfcPagesExcept, rfcNumberOf, backstageHead, backstageNav, backstageFooter } from "../../../backstage"
import { renderMarkdown } from "../../../markdown"
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
params { rfc: String }

/// One record, ready to render: what the index says about it, and its body.
type Record = { number: Int64, tag: String, title: String, status: String, source: String, body: String }

export fn head(d: Record) -> Head {
    return backstageHead(d.tag + " " + d.title + " — Vyrn backstage")
}

export fn data() -> ParamQuery<Params, Result<Record, PageError>> {
    return paramQuery(fetchRecord)
}

fn fetchRecord(p: Params) -> Result<Record, PageError> {
    let n = rfcNumberOf(p.rfc)
    let row = rfcRow(n)
    // The four digits are the page's name, so `91` is not this page and neither
    // is a number the index does not carry.
    if row.number == 0 || rfcSlug(n) != p.rfc {
        return Err(notFound("there is no design record " + p.rfc))
    }
    let src = match rfcBody(row) {
        Ok(text) => text.copy(),
        Err(why) => "",
    }
    if src.byteLength == 0 {
        return Err(notFound(reported(rfcTag(n), "its file could not be read")))
    }
    return match renderMarkdown(src, rfcPagesExcept(n)) {
        Ok(html) => Ok(Record { number: n, tag: rfcTag(n), title: row.title.copy(), status: row.status.copy(), source: rfcSource(row), body: html }),
        Err(why) => Err(notFound(reported(rfcTag(n), why))),
    }
}

/// Say what went wrong while the page is being built, and hand the same words
/// back for the page. The export prints the failing path; this prints the
/// reason, which is the half a log cannot work out for itself.
fn reported(tag: String, why: String) -> String {
    print("REFUSED " + tag + ": " + why)
    return tag + " holds " + why
}
</script>

<template>
<div id="root" class="backstage">
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead backstage" v-html='backstageNav("record")'></header>
    <div id="main" class="skip-target" tabindex="-1"></div>
    <main class="page">
        <section class="band">
            <p class="eyebrow"><a href="/backstage.html">The record</a> — {{ data.tag }}</p>
            <p class="status"><strong>Status</strong> {{ data.status }}</p>
            <article class="prose rfcdoc" v-html="data.body"></article>
            <p class="cap">Rendered from <a :href="data.source">rfcs/{{ data.tag }}</a> while this page was built. The file in the repository is the record; this is the same bytes, read here.</p>
        </section>
    </main>
    <footer class="foot backstage" v-html="backstageFooter()"></footer>
</div>
</template>
