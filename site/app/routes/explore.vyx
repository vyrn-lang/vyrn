<script>
// GET /explore — the standard library as one page: search it, and see what
// depends on what.
//
// The rows are the search index. Each one carries its own lowercased haystack
// (`data-q`) and its export names (`data-e`), so the page fetches nothing, and a
// reader with no script still gets every module, its first line and a link.
// `widgets.js` filters the rows and builds a link per matching export with
// `createElement` — never by assembling markup out of what was typed.
//
// The graph's geometry is computed in Vyrn while this page is built:
// `site/app/explore.vyrn` lays the modules out in columns by depth and writes
// every wire's path. The script lights up one module's wires and nothing else.
import { Head } from "std/ui"
import { pageHead } from "../nav"
import { ExploreRow, GraphNode, GraphEdge, exploreRows, exportTotal, graphNodes, graphEdges, graphViewBox, graphWidth, edgeCount, leafCount } from "../explore"
import { blob } from "../repo"

export fn head() -> Head {
    return pageHead("Explore the modules — Vyrn")
}

/// The width the drawing needs, as a style. Below it the graph scrolls inside
/// its own box; the page never scrolls sideways.
fn graphStyle() -> String {
    return "min-width:" + graphWidth().toString() + "px"
}

/// The source of a module, in the repository.
fn sourceOf(r: ExploreRow) -> String {
    return blob("std/" + r.name + ".vyrn")
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#search"><span class="n">01</span>search</a>
        <a href="#graph"><span class="n">02</span>graph</a>
        <a href="#built"><span class="n">03</span>how it is built</a>
    </aside>

    <section class="hero">
        <p class="eyebrow">Explore</p>
        <h1 class="display">{{ exploreRows().length }} modules, {{ exportTotal() }} exports</h1>
        <p class="lede">The standard library is written in Vyrn. Search it by module, by export name or by what a module is for, and read the import graph the compiler's own lexer found in the source.</p>
    </section>

    <section class="band" id="search">
        <p class="eyebrow">01 — search</p>
        <h2>Find a name</h2>
        <p>Type a module name, an export name, or a word from a module's first line. The list narrows as you type, and a match inside a module lists the exports it matched, each one a link to that export on its own page.</p>
        <div class="finder" data-explore>
            <label class="eyebrow" for="explore-q">Search modules and exports</label>
            <input id="explore-q" type="search" autocomplete="off" spellcheck="false" placeholder="parse, Map, schema, byteLength" data-explore-input/>
            <p class="cap" data-explore-count aria-live="polite">{{ exploreRows().length }} modules</p>
        </div>
        <ul class="modlist" data-explore-list>
            <li v-for="r in exploreRows()" :key="r.name" :data-q="r.q" :data-e="r.e" :data-m="r.name">
                <a :href="r.href">std/{{ r.name }}</a>
                <span class="count">{{ r.count }}</span>
                <span class="note" v-html="r.summary"></span>
            </li>
        </ul>
        <p class="cap">Read off <code>std/</code> while this page was built. The count is how many things a module exports.</p>
    </section>

    <section class="band" id="graph">
        <p class="eyebrow">02 — graph</p>
        <h2>{{ edgeCount() }} imports between {{ exploreRows().length }} modules</h2>
        <p>Every wire is an <code>import</code> line in the source. A module sits one column to the right of everything it imports, so dependencies are on the left and the modules that need them are on the right. {{ leafCount() }} modules import nothing else in <code>std/</code>.</p>
        <div class="plate">
            <div class="plate-head">
                <span class="pill">Built</span>
                <span class="eyebrow">point at a module to light its imports</span>
            </div>
            <div class="stage scroller">
                <svg class="graph" :viewBox="graphViewBox()" :style="graphStyle()" role="img" aria-label="The import graph of the standard library. Every module is a link; the list above carries the same modules as text.">
                    <path class="wire" v-for="e in graphEdges()" :key="e.id" :d="e.d" :data-from="e.from" :data-to="e.to"/>
                    <g class="node" v-for="n in graphNodes()" :key="n.name" :data-m="n.name" :data-uses="n.uses" :data-usedby="n.usedBy">
                        <a :href="n.href">
                            <rect :x="n.hx" :y="n.hy" :width="n.w" height="18" class="hit"/>
                            <circle :cx="n.x" :cy="n.y" r="3"/>
                            <text :x="n.tx" :y="n.ty">{{ n.name }}</text>
                        </a>
                    </g>
                </svg>
            </div>
            <p class="cap">Read from the <code>import</code> lines of <code>std/*.vyrn</code> by the compiler's own lexer while this page was built. An import written inside a code quote is a string, and is not a wire.</p>
        </div>
    </section>

    <section class="band" id="built">
        <p class="eyebrow">03 — how it is built</p>
        <h2>Nothing here is written twice</h2>
        <p>The index and the graph come from the same files the <a href="/docs.html">reference</a> is generated from. A module added to <code>std/</code> appears in the list, in the graph, and on its own page on the next build, with nothing written by hand.</p>
        <p>The search runs in the page over data that is already in the page. There is no request, no index file, and no service behind it — which is also why it works on a static host.</p>
        <p>The <a href="/guide.html">guide</a> teaches these modules in order. Each reference page links back to the chapter that uses it.</p>
    </section>
</main>
</template>
