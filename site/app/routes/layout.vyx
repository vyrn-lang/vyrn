<script>
import { navRows, themeControl } from "../nav"
import { Icon } from "../icons"
import { hasRelease, releaseTag, releasePre } from "../repo"
head {
    stylesheet "/style.css"
    module "/theme.js"
    module "/widgets.js"
}

fn standing() -> String {
    if !hasRelease() {
        return "Early. No versioned release yet."
    }
    if releasePre() {
        return "Early. " + releaseTag() + " is the newest release, and it is a pre-release."
    }
    return "Early. " + releaseTag() + " is the newest release."
}
</script>

<template>
<!-- The layout needs one root; `display: contents` keeps it boxless. -->
<div class="shell">
<a class="skip" href="#main">Skip to content</a>
<header class="masthead">
        <a href="/" class="wordmark">vyrn</a>
        <details class="menu">
            <summary>Menu</summary>
            <nav class="nav" aria-label="Site">
                <a v-for="r in navRows()" :key="r.href" :href="r.href">{{ r.label }}</a>
            </nav>
        </details>
        <div class="tools">
            <!-- `[data-js]`-gated: without script it would take focus and do nothing. -->
            <button type="button" class="find" data-find-open aria-label="Search this site. Press slash."><Icon name="bytesize:search"/> <span class="word">Search<span class="hint"> docs, reference…</span></span> <kbd class="key">/</kbd></button>
            <a class="gh" href="https://github.com/vyrn-lang/vyrn"><Icon name="bytesize:github" label="Vyrn on GitHub"/></a>
            <span class="slot" v-html="themeControl()"></span>
        </div>
    </header>
    <div class="findbox" data-find hidden>
        <div class="findpanel" role="dialog" aria-modal="true" aria-label="Search">
            <div class="findrow">
                <Icon name="bytesize:search"/>
                <input type="search" data-find-input aria-label="Search the docs, the reference, packages" placeholder="Search the docs, the reference, packages" autocomplete="off" spellcheck="false" aria-controls="find-results"/>
                <kbd class="key">esc</kbd>
            </div>
            <div class="findtabs" data-find-tabs>
                <button type="button" class="on" data-sect="">All</button>
                <button type="button" data-sect="Docs">Docs</button>
                <button type="button" data-sect="Reference">Reference</button>
                <button type="button" data-sect="Packages">Packages</button>
                <button type="button" data-sect="Releases">Releases</button>
                <span class="keys"><kbd class="key">tab</kbd> section <kbd class="key">↑</kbd><kbd class="key">↓</kbd> move <kbd class="key">↵</kbd> open</span>
            </div>
            <div id="find-results" data-find-results role="listbox" aria-label="Results"></div>
            <p class="cap" data-find-note>Type to search, or try <button type="button" data-try>Map</button>, <button type="button" data-try>readLine</button> or <button type="button" data-try>panic</button>.</p>
        </div>
    </div>
    <noscript>
        <p class="notice">Search needs JavaScript. <a href="/docs.html">The reference landing</a> filters its own module list without it.</p>
    </noscript>
<div id="root">
    <!-- Not the `<main>`: it is `display: contents`, and an element with no box cannot take focus. -->
    <div id="main" class="skip-target" tabindex="-1"></div>
    <slot/>
    <footer class="foot">
        <span>Copyright 2026 vyrn-lang. MIT or Apache-2.0.</span>
        <a href="/releases.html"><Icon name="bytesize:tag"/> Releases</a>
        <span>{{ standing() }}</span>
    </footer>
</div>
</div>
</template>
