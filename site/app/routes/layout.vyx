<script>
// The site shell (RFC-0041 §1): every page body renders into the <slot/>.
//
// The navigation is built from the typed URL helpers the router generates, so a
// link cannot name a route that does not exist — the compiler rejects it. That is
// what reserves the v2 sockets: `/guide` and `/explorer` have room in the route
// table and no page, so nothing links to them and no "coming soon" page exists.
// Adding the guide book is a directory drop plus one row in `navRows`.
import { navRows, NavRow } from "../nav"

// The `head` block takes `title`, `stylesheet`, `module` and `script` and
// nothing else. There is no `meta` entry, and the document shell emits no
// viewport meta of its own, so a std/ui page is not responsive on a phone until
// one of those two changes. Reported with this change; not fixed here.
head {
    stylesheet "/style.css"
}
</script>

<template>
<div id="root">
    <header class="masthead">
        <a href="/" class="wordmark">vyrn</a>
        <nav class="nav">
            <a v-for="r in navRows()" :key="r.href" :href="r.href">{{ r.label }}</a>
        </nav>
    </header>
    <slot/>
    <footer class="foot">
        <p>One program, three backends, identical bytes.</p>
    </footer>
</div>
</template>
