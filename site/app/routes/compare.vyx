<script>
// GET /compare — the densest page on the site, and the one that has to earn it.
//
// It was a set of one-row tables whose Vyrn cell repeated the section heading.
// That is filler, not comparison. It is now three things a reader can act on:
// ONE matrix of six axes across four languages, THREE code plates showing the
// same small task in each language, and THREE charts — every one of them
// plotting a number this repository can produce on demand.
//
// THE DATA RULE, which shapes this page more than anything else: no widget here
// renders a number the project cannot produce on demand. The module ladder was
// measured with the release binary, one `vyrn build --target wasm` per row. The
// leak-shape figures are the ones `rfcs/census-call-arguments.md` recorded, and
// the caption names that file. The speed chart is `bench/engines.sh` over
// `examples/threeengines.vyrn` — one program, the three engines it runs on, and
// the machine and the date printed beside the numbers.
//
// SECTION 08 IS THE CROSS-LANGUAGE CHART THIS PAGE USED TO SAY IT COULD NOT MAKE
// (RFC-0104 M3). The objection it stated was real — a cross-language chart needs
// programs somebody wrote in someone else's language, and a reader has to trust
// they were written well. What changed is that the programs, the discipline they
// were held to, the flags, the verification that all five print the same bytes,
// and every raw reading are now published for anyone to disagree with. The radar
// is computed in `app/bench.vyrn` from the two committed JSON records, and NOT
// ONE figure on it is typed in by hand.
import { Head } from "std/ui"
import { pageHeadOf, hrefOf } from "../nav"
import { typeSpecs, memorySpecs, failureSpecs, Snippet } from "../snippets"
import { programs, contestants, radarBox, radarCx, radarCy, radarRings, radarSpokes, radarLines, tableRows, axisPanels, benchMachine, benchRuns, Prog, Series, Ring, Spoke, Line, Mark, Reading, Row, Panel } from "../bench"
import { moduleSizes, moduleSizesBox, moduleSizesGrid, moduleLadder, moduleLadderBox, moduleLadderGrid, moduleLadderPlot, twoRowPlot, moduleRatio, largestModule, leakBars, leakBox, leakGrid, leakPeak, engineBars, engineBox, engineGrid, enginePlot, engineRatio, engineRounds, engineCommand, engineMachine, wasmRatio, compiledBars, compiledGrid, barLeft, barRight, barText, barRow, Bar, Grid } from "../chart"

/// One comparison axis: what is being compared, and where each answer stands.
type Axis = { id: String, name: String, vyrn: String, rust: String, ts: String, go: String }

export fn head() -> Head {
    return pageHeadOf("/compare")
}

/// Text that holds an angle bracket lives here rather than in the template: a
/// template escapes what it renders, so an entity written by hand is escaped a
/// second time and the reader sees `&lt;`.
fn buildCommand() -> String {
    return "vyrn build examples/<name>.vyrn --target wasm"
}

/// The signature the leak chart is measuring, with and without the keyword.
fn leakWord(declared: Bool) -> String {
    if declared {
        return "fn wrap(s: consume String) -> Option<String>"
    }
    return "fn wrap(s: String) -> Option<String>"
}

/// Where the whole dataset is written out, one page down from this one.
fn benchDetail() -> String {
    return hrefOf("/backstage/benchmarks")
}

fn axes() -> Array<Axis> {
    return [
        Axis {
            id: "01",
            name: "Memory",
            vyrn: "Declared: read, modify, consume, share",
            rust: "Inferred lifetimes and borrows",
            ts: "The host's collector",
            go: "A collector, with a pause",
        },
        Axis {
            id: "02",
            name: "Validation",
            vyrn: "A where clause in the type",
            rust: "A constructor beside the type",
            ts: "A schema library beside the type",
            go: "A function you must remember",
        },
        Axis {
            id: "03",
            name: "Concurrency",
            vyrn: "spawn and join, no function colour",
            rust: "async/await, plus a runtime",
            ts: "async/await, one thread",
            go: "Goroutines and channels",
        },
        Axis {
            id: "04",
            name: "Metaprogramming",
            vyrn: "Generators: compile-time Vyrn, readable output",
            rust: "Macros, in a second language",
            ts: "Decorators and codegen tools",
            go: "go:generate, outside the language",
        },
        Axis {
            id: "05",
            name: "Targets",
            vyrn: "Interpreter, native, wasm — byte-identical",
            rust: "Native and wasm, via LLVM",
            ts: "One runtime, interpreted or JIT",
            go: "Native and wasm",
        },
        Axis {
            id: "06",
            name: "Failure",
            vyrn: "Option, Result, exhaustive match, no null",
            rust: "Option, Result, and panics",
            ts: "null, undefined, and exceptions",
            go: "Explicit error returns, and nil",
        },
    ]
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#axes"><span class="n">01</span>the axes</a>
        <a href="#rule"><span class="n">02</span>a rule</a>
        <a href="#memory"><span class="n">03</span>an argument</a>
        <a href="#failure"><span class="n">04</span>an absence</a>
        <a href="#numbers"><span class="n">05</span>size</a>
        <a href="#leak"><span class="n">06</span>a leak</a>
        <a href="#speed"><span class="n">07</span>three engines</a>
        <a href="#radar"><span class="n">08</span>eight programs</a>
    </aside>
        <section class="hero">
            <p class="eyebrow">Compare</p>
            <h1 class="display">Where Vyrn differs, and where it has nothing to show yet</h1>
            <p class="lede">Every row names a real difference. Every number traces to something this repository can produce on demand. Where no honest measurement exists, this page says so instead of printing one.</p>
        </section>

        <section class="band" id="axes">
            <p class="eyebrow">01 — six axes</p>
            <h2>The whole comparison, on one screen</h2>
            <div class="scroller">
            <table class="matrix">
                <thead>
                    <tr><th>Axis</th><th class="yes">Vyrn</th><th>Rust</th><th>TypeScript</th><th>Go</th></tr>
                </thead>
                <tbody>
                    <tr v-for="a in axes()" :key="a.id">
                        <th scope="row">{{ a.name }}</th>
                        <td class="yes">{{ a.vyrn }}</td>
                        <td class="no">{{ a.rust }}</td>
                        <td class="no">{{ a.ts }}</td>
                        <td class="no">{{ a.go }}</td>
                    </tr>
                </tbody>
            </table>
            </div>
            <p class="cap">Each of the next three sections takes one row of this table and writes the same small task in all four languages.</p>
        </section>

        <section class="band" id="rule">
            <p class="eyebrow">02 — a rule about a value</p>
            <h2>A number that is only valid at 18 or above</h2>
            <p>In Vyrn the rule is part of the type. Everywhere else it lives beside the type — in a constructor, a schema object, or a function the caller has to remember.</p>
            <div class="plate" data-tabs>
                <div class="plate-head">
                    <span class="pill">Specimen</span>
                    <span class="eyebrow">the same rule, four ways</span>
                </div>
                <div class="tabs">
                    <button type="button" v-for="s in typeSpecs()" :key="s.id" :data-tab="s.id">{{ s.label }}</button>
                </div>
                <div class="stage panes">
                    <div v-for="s in typeSpecs()" :key="s.id" :data-pane="s.id">
                        <pre class="code" v-html="s.html"></pre>
                    </div>
                </div>
                <p class="cap">The Vyrn pane is coloured by the compiler's own lexer. The other three are keyword-set colouring over snippets written the way each language's documentation writes them — illustrative, not measured.</p>
            </div>
        </section>

        <section class="band" id="memory">
            <p class="eyebrow">03 — what a function does with its argument</p>
            <h2>Read it, change it, or take it</h2>
            <p>Three intents, one word each. Rust spells them as reference kinds and adds a lifetime the moment one is stored; the other two hand the question to a collector.</p>
            <div class="plate" data-tabs>
                <div class="plate-head">
                    <span class="pill">Specimen</span>
                    <span class="eyebrow">the same three functions, four ways</span>
                </div>
                <div class="tabs">
                    <button type="button" v-for="s in memorySpecs()" :key="s.id" :data-tab="s.id">{{ s.label }}</button>
                </div>
                <div class="stage panes">
                    <div v-for="s in memorySpecs()" :key="s.id" :data-pane="s.id">
                        <pre class="code" v-html="s.html"></pre>
                    </div>
                </div>
                <p class="cap">Vyrn's three declarations are enforced by the compiler and cost nothing at run time. The section below measures what one of those words is worth.</p>
            </div>
        </section>

        <section class="band" id="failure">
            <p class="eyebrow">04 — when the value is not there</p>
            <h2>There is no null to forget</h2>
            <p>Vyrn and Rust both make absence a value you have to open. TypeScript has two absences and a compiler flag; Go has a convention.</p>
            <div class="plate" data-tabs>
                <div class="plate-head">
                    <span class="pill">Specimen</span>
                    <span class="eyebrow">the same missing seat, four ways</span>
                </div>
                <div class="tabs">
                    <button type="button" v-for="s in failureSpecs()" :key="s.id" :data-tab="s.id">{{ s.label }}</button>
                </div>
                <div class="stage panes">
                    <div v-for="s in failureSpecs()" :key="s.id" :data-pane="s.id">
                        <pre class="code" v-html="s.html"></pre>
                    </div>
                </div>
                <p class="cap">Vyrn has no unwrap and no panic-on-absence: <code>?</code> propagates, and <code>match</code> must cover every arm.</p>
            </div>
        </section>

        <section class="band" id="numbers">
            <p class="eyebrow">05 — measured</p>
            <h2>What a WebAssembly module weighs</h2>
            <p>Every bar was built with the release binary in this repository, one command per row, and read off the file. A module carries only the runtime its own code reaches.</p>
            <div class="plate" data-widget="bars">
                <div class="plate-head">
                    <span class="pill live">Measured</span>
                    <span class="eyebrow">{{ buildCommand() }}</span>
                    <span class="spacer"></span>
                    <div class="controls">
                        <button type="button" data-bars-replay>Replay</button>
                    </div>
                </div>
                <div class="stage">
                    <svg class="chart" :viewBox="moduleLadderBox()" role="group" aria-label="Eight example programs, and the size of the WebAssembly module each one builds to">
<g class="axis">
                            <line v-for="g in moduleLadderGrid()" :key="g.id" :x1="g.x" y1="0" :x2="g.x" :y2="moduleLadderPlot()"/>
                            <text v-for="g in moduleLadderGrid()" :key="g.id" :x="g.x" :y="moduleLadderPlot()" dy="16" text-anchor="middle">{{ g.label }}</text>
                        </g>
                        <g class="row" v-for="b in moduleLadder()" :key="b.id">
                            <title>{{ b.title }}</title>
                            <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                            <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                            <a :href="b.href" :aria-label="b.title"><text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text></a>
                            <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val" :data-to="b.value">{{ b.value }}</text>
                        </g>
                    </svg>
                </div>
                <p class="cap">Eight examples, smallest first, on one linear scale against {{ largestModule() }}. Hover a row for the exact byte count, or open the example on GitHub. Rebuild any row in one command; nothing here is estimated.</p>
            </div>

            <div class="plate" data-widget="bars">
                <div class="plate-head">
                    <span class="pill">Two routes</span>
                    <span class="eyebrow">examples/fib.vyrn</span>
                    <span class="spacer"></span>
                    <div class="controls">
                        <button type="button" data-bars-replay>Replay</button>
                    </div>
                </div>
                <span class="bignum">{{ moduleRatio() }}<small>times smaller</small></span>
                <div class="stage">
                    <svg class="chart" :viewBox="moduleSizesBox()" role="group" aria-label="fib.wasm is 1.5 KB through the direct encoder and 277 KB through clang">
<g class="axis">
                            <line v-for="g in moduleSizesGrid()" :key="g.id" :x1="g.x" y1="0" :x2="g.x" :y2="twoRowPlot()"/>
                            <text v-for="g in moduleSizesGrid()" :key="g.id" :x="g.x" :y="twoRowPlot()" dy="16" text-anchor="middle">{{ g.label }}</text>
                        </g>
                        <g class="row" v-for="b in moduleSizes()" :key="b.id">
                            <title>{{ b.title }}</title>
                            <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                            <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                            <a :href="b.href" :aria-label="b.title"><text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text></a>
                            <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val" :data-to="b.value">{{ b.value }}</text>
                        </g>
                    </svg>
                </div>
                <p class="cap">The direct figure is the ladder's first row, measured. 277 KB is the figure <code>README.md</code> and <code>ROADMAP.md</code> both state for the old route through textual LLVM IR and <code>clang</code>. One linear scale, so the small bar is a sliver — which is what the difference looks like.</p>
            </div>
        </section>

        <section class="band" id="leak">
            <p class="eyebrow">06 — measured</p>
            <h2>What one keyword is worth</h2>
            <p>The same loop, a million turns, native. One word changes on the callee's parameter, and a shape that grows becomes a shape that does not.</p>
            <div class="plate" data-widget="leak">
                <div class="plate-head">
                    <span class="pill live">Measured</span>
                    <span class="eyebrow">rfcs/census-call-arguments.md</span>
                    <span class="spacer"></span>
                    <div class="controls">
                        <button type="button" data-leak-toggle aria-pressed="false">Declare consume</button>
                    </div>
                </div>
                <span class="bignum" data-leak-peak :data-alt="leakPeak(true)">{{ leakPeak(false) }}<small>peak, at 1,000,000 turns</small></span>
                <div class="stage">
                    <svg class="chart" data-leak-svg :viewBox="leakBox()" role="group" aria-label="Peak resident memory of the same loop, with and without the consume declaration">
<g class="axis">
                            <line v-for="g in leakGrid()" :key="g.id" :x1="g.x" y1="0" :x2="g.x" :y2="twoRowPlot()"/>
                            <text v-for="g in leakGrid()" :key="g.id" :x="g.x" :y="twoRowPlot()" dy="16" text-anchor="middle">{{ g.label }}</text>
                        </g>
                        <g data-series="no">
                            <g class="row" v-for="b in leakBars(false)" :key="b.id">
                                <title>{{ b.title }}</title>
                                <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                                <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                                <a :href="b.href" :aria-label="b.title"><text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text></a>
                                <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val" :data-to="b.value">{{ b.value }}</text>
                            </g>
                        </g>
                        <g data-series="yes">
                            <g class="row" v-for="b in leakBars(true)" :key="b.id">
                                <title>{{ b.title }}</title>
                                <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                                <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                                <a :href="b.href" :aria-label="b.title"><text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text></a>
                                <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val" :data-to="b.value">{{ b.value }}</text>
                            </g>
                        </g>
                    </svg>
                    <p class="verdict" data-leak-word :data-alt="leakWord(true)">{{ leakWord(false) }}</p>
                </div>
                <p class="cap">Peak resident memory, native, as recorded in rfcs/census-call-arguments.md (Finding 2). Both series are on one scale. The leak is not a missing release; it is a missing declaration, which is why one keyword closes it and no rule could.</p>
            </div>
        </section>

        <section class="band" id="speed">
            <p class="eyebrow">07 — measured</p>
            <h2>One program, three engines</h2>
            <p>The same source file runs three ways: the tree-walking interpreter, a native binary, and a WebAssembly module. They print the same forty bytes — the harness checks that before it reports a single time — and they take these times to do it.</p>
            <div class="plate" data-widget="bars">
                <div class="plate-head">
                    <span class="pill live">Measured</span>
                    <span class="eyebrow">{{ engineCommand() }}</span>
                    <span class="spacer"></span>
                    <div class="controls">
                        <button type="button" data-bars-replay>Replay</button>
                    </div>
                </div>
                <span class="bignum">{{ engineRatio() }}<small>times faster, compiled than interpreted</small></span>
                <div class="stage">
                    <svg class="chart" :viewBox="engineBox()" role="group" aria-label="The same program takes 38.1 seconds under the interpreter, 207 milliseconds as WebAssembly and 87 milliseconds as a native binary">
<g class="axis">
                            <line v-for="g in engineGrid()" :key="g.id" :x1="g.x" y1="0" :x2="g.x" :y2="enginePlot()"/>
                            <text v-for="g in engineGrid()" :key="g.id" :x="g.x" :y="enginePlot()" dy="16" text-anchor="middle">{{ g.label }}</text>
                        </g>
                        <g class="row" v-for="b in engineBars()" :key="b.id">
                            <title>{{ b.title }}</title>
                            <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                            <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                            <a :href="b.href" :aria-label="b.title"><text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text></a>
                            <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val" :data-to="b.value">{{ b.value }}</text>
                        </g>
                    </svg>
                </div>
                <p class="cap">{{ engineRounds() }} rounds of a SHA-1 chain, where each round hashes the one before it, so no engine can hoist or precompute any of it. One linear scale: the interpreter's bar is the chart, and the two compiled bars are slivers. Hover a row for its exact reading.</p>
            </div>

            <div class="plate" data-widget="bars">
                <div class="plate-head">
                    <span class="pill">The two compiled engines</span>
                    <span class="eyebrow">examples/threeengines.vyrn</span>
                    <span class="spacer"></span>
                    <div class="controls">
                        <button type="button" data-bars-replay>Replay</button>
                    </div>
                </div>
                <span class="bignum">{{ wasmRatio() }}<small>times the native time, as WebAssembly under wasmtime</small></span>
                <div class="stage">
                    <svg class="chart" :viewBox="moduleSizesBox()" role="group" aria-label="The same two compiled engines rescaled: 207 milliseconds as WebAssembly against 87 milliseconds native">
<g class="axis">
                            <line v-for="g in compiledGrid()" :key="g.id" :x1="g.x" y1="0" :x2="g.x" :y2="twoRowPlot()"/>
                            <text v-for="g in compiledGrid()" :key="g.id" :x="g.x" :y="twoRowPlot()" dy="16" text-anchor="middle">{{ g.label }}</text>
                        </g>
                        <g class="row" v-for="b in compiledBars()" :key="b.id">
                            <title>{{ b.title }}</title>
                            <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                            <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                            <a :href="b.href" :aria-label="b.title"><text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text></a>
                            <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val" :data-to="b.value">{{ b.value }}</text>
                        </g>
                    </svg>
                </div>
                <p class="cap">The two bars a hair apart on the chart above, rescaled. The WebAssembly module came out of the compiler's own encoder — no LLVM, no <code>clang</code> — and ran under <code>wasmtime</code>, which is a standalone runtime and not a browser. A browser's engine is a different measurement, and this page does not make it.</p>
            </div>

            <p class="notice">Where these numbers come from: <code>{{ engineCommand() }}</code>, on {{ engineMachine() }}, best of three runs per engine. Each reading is the whole process minus the same process at one round, so process start-up and the shell that timed it are out of it; the harness prints both halves. The ratio is the claim — one machine, one afternoon — and the milliseconds are published so it can be checked. The command was run twice: the second pass came in 8% slower on the interpreter and 6% on the native binary, the spread of an ordinary desktop, and the ratios moved by under 3%. There is no cross-language chart here: that would need a second program written by us in someone else's language, and a reader would have to take on trust that we wrote it well.</p>
            <p class="notice">Per-operation figures are a different instrument: <code>vyrn bench</code> and the <code>bench</code> blocks in <code>examples/</code>. CI runs every one of them on each push and refuses to merge one that stops compiling. It does not yet fail on a slowdown — <code>bench/baseline.json</code> is still an unseeded placeholder, and the file says exactly how to seed it from a CI run — so nothing on this page claims a trend over time.</p>
            <p class="notice">That objection is answered one section down, and the answer is what section 08 is. It took eight Benchmarks Game programs, wrote each one four more times under a stated discipline, checked that all five print the same bytes before anything was timed, and published the sources, the flags and every raw reading. A reader still has to judge whether the C, Rust and JavaScript were written well — but now there is something to judge, rather than a promise.</p>
        </section>

        <section class="band" id="radar">
            <p class="eyebrow">08 — measured</p>
            <h2>Eight Benchmarks Game programs, five contestants</h2>
            <p>The same eight programs written five ways: plain C, safe Rust, plain node, Vyrn native and Vyrn as WebAssembly. Further from the centre is <em>slower</em>, so a small shape is a fast one.</p>
            <div class="plate" data-widget="radar">
                <div class="plate-head">
                    <span class="pill live">Measured</span>
                    <span class="eyebrow">rfcs/bench-0104/results/2026-08-19-LOCUST-v2.json</span>
                    <span class="spacer"></span>
                    <div class="controls" role="group" aria-label="Normalize the chart to">
                        <button type="button" data-norm="c" aria-pressed="true">C = 1</button>
                        <button type="button" data-norm="rust" aria-pressed="false">Rust = 1</button>
                    </div>
                </div>
                <div class="stage">
                    <svg class="chart radar" :viewBox="radarBox()" role="img" aria-label="A radar with one axis per Benchmarks Game program and one polygon per contestant. Every reading it plots is in the table below it.">
                        <g class="axis">
                            <polygon v-for="r in radarRings()" :key="r.id" :class="r.tone" :points="r.points"/>
                            <line v-for="s in radarSpokes()" :key="s.key" :x1="radarCx()" :y1="radarCy()" :x2="s.x" :y2="s.y"/>
                            <text v-for="r in radarRings()" :key="r.id" :x="radarCx()" :y="r.y" dx="6" dy="-3">{{ r.label }}</text>
                        </g>
                        <g class="series" v-for="l in radarLines()" :key="l.key" :data-series="l.key">
                            <polygon :class="l.tone" :points="l.points" :data-alt="l.alt"/>
                            <g class="marks" data-norm="c">
                                <path v-for="m in l.marks" :key="m.id" class="offscale" :d="m.d"><title>{{ l.name }} — {{ m.title }}</title></path>
                            </g>
                            <g class="marks" data-norm="rust">
                                <path v-for="m in l.altMarks" :key="m.id" class="offscale" :d="m.d"><title>{{ l.name }} — {{ m.title }}</title></path>
                            </g>
                        </g>
                        <g class="wedges">
                            <polygon v-for="s in radarSpokes()" :key="s.key" class="wedge" :points="s.wedge" :data-axis-hit="s.key"><title>{{ s.name }}</title></polygon>
                        </g>
                        <g class="names">
                            <text v-for="s in radarSpokes()" :key="s.key" :x="s.lx" :y="s.ly" :text-anchor="s.anchor" :data-axis-name="s.key">{{ s.name }}</text>
                        </g>
                    </svg>
                </div>
                <div class="serieskeys" role="group" aria-label="Show or hide a contestant">
                    <button type="button" v-for="s in contestants()" :key="s.key" :class="s.tone" :data-series-toggle="s.key" aria-pressed="true">{{ s.name }}</button>
                </div>
                <div class="tabs axes">
                    <button type="button" v-for="p in programs()" :key="p.key" :data-axis="p.key">{{ p.name }}</button>
                </div>
                <div class="stage axispanes">
                    <div v-for="p in axisPanels()" :key="p.key" :data-axis-pane="p.key">
                        <p class="eyebrow"><a :href="p.game">{{ p.name }}</a> — N = {{ p.n }}</p>
                        <!-- The `.scroller` its two siblings on this page always
                             had (RFC-0106 M1). This table was the one wide block
                             on the site with no scroller around it, and it broke
                             RFC-0105's own rule that the body never scrolls
                             sideways: six nowrap columns paint 422px inside a
                             309px column at 375px, and the 80px went to the
                             document (RFC-0106 M0, checklist row 26). Two rules
                             meet to make it 422px and both are right —
                             `.axispanes table.matrix { min-width: 0 }` keeps a
                             five-column panel off the 46rem floor, and
                             `white-space: nowrap` keeps a column of numbers
                             comparable down its own length. What was missing was
                             the box to scroll in. -->
                        <div class="scroller">
                        <table class="matrix bench game">
                            <thead>
                                <tr><th>source</th><th>cpu secs</th><th>secs</th><th>mem</th><th>gz</th><th>make secs</th></tr>
                            </thead>
                            <tbody>
                                <tr v-for="c in p.cells" :key="c.key" :title="c.norm">
                                    <th scope="row"><span :class="c.tone">{{ c.name }}</span><span v-if="c.noisy" class="flag" title="The widest reading of this cell is more than 15% off the narrowest, within one run."> noisy</span></th>
                                    <td class="num">{{ c.cpu }}</td>
                                    <td class="num">{{ c.secs }}</td>
                                    <td class="num">{{ c.mem }}</td>
                                    <td class="num">{{ c.gz }}</td>
                                    <td class="num">{{ c.make }}</td>
                                </tr>
                            </tbody>
                        </table>
                        </div>
                        <p class="note"><a :href="p.href">{{ p.verdict }} — {{ p.label }}</a></p>
                    </div>
                </div>
                <p class="cap">The game's own columns: cpu time, wall time, peak memory, gzipped source, build time. Medians of {{ benchRuns() }} runs on {{ benchMachine() }}. The radial axis is log2 around the baseline — the rim is sixteen times it, and a reading past it is drawn at the rim with a stroke continuing outward. The program name opens the game's page for it.</p>
            </div>

            <p>The chart, as a table. It is the same two ratios the polygons plot, and it is what the page says with no script running at all.</p>
            <div class="scroller">
            <table class="matrix bench">
                <caption>Each cell is the program's median against C and against Rust. The seconds behind them are in the tables above; every raw reading is on <a :href="benchDetail()">the backstage page</a>.</caption>
                <thead>
                    <tr>
                        <th>Program</th>
                        <th>N</th>
                        <th v-for="s in contestants()" :key="s.key"><span :class="s.tone">{{ s.name }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="r in tableRows()" :key="r.key">
                        <th scope="row">{{ r.name }}</th>
                        <td class="n">{{ r.n }}</td>
                        <td v-for="c in r.cells" :key="c.key">
                            <span class="ms">{{ c.vsC }} C</span>
                            <span class="norm">{{ c.vsRust }} Rust</span>
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>

            <p class="notice">Eight of the ten Benchmarks Game programs; the other two are absent because the language cannot express them, which is recorded rather than worked around. The C is plain C11, the Rust is safe and standard-library only, the JavaScript is plain node — no intrinsics, no threads. All five printed the same bytes before anything was timed. CI does not run the harness: it needs clang, rustc, node and wasmtime together and takes about fifteen minutes, so it is run by hand and the committed JSON is the record. Both runs, every raw reading, the environment, and the named cause under each deviation are on <a :href="benchDetail()">the backstage page for this dataset</a>.</p>
        </section>

</main>
</template>
