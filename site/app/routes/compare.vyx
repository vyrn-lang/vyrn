<script>
// GET /compare: a redirect stub to `/benchmarks` (see `philosophy.vyx`).
import { Head } from "std/ui"
import { pageHead, hrefOf } from "../nav"

export fn head() -> Head {
    return pageHead("Moved to Benchmarks — Vyrn")
}

/// Where this stub sends a reader.
fn target() -> String {
    return hrefOf("/benchmarks")
}
</script>

<template>
<main class="page">
    <section class="hero">
        <p class="eyebrow">Moved</p>
        <h1 class="display">The numbers are on the benchmarks page</h1>
        <p class="lede">Nothing was deleted. <a :href="target()">Read the benchmarks</a>.</p>
    </section>
</main>
</template>
