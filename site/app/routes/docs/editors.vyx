<script>
// GET /docs/editors — a stub, for a bookmark and a search result (RFC-0106 M5).
//
// The page sat here from M1, which folded the original `/editors` into the
// reference's directory; M5 gave the documentation areas, and an editor is a
// tool, so the page lives on the Tooling shelf now. `site/export.vyrn` stamps
// the refresh and the canonical off `redirects()`, which names this pair
// beside the two moved chapters.
import { Head } from "std/ui"
import { pageHead, hrefOf } from "../../nav"

export fn head() -> Head {
    return pageHead("Moved to Tooling — Vyrn")
}

/// Where this stub sends a reader.
fn target() -> String {
    return hrefOf("/tooling/editors")
}
</script>

<template>
<main class="page">
    <section class="hero">
        <p class="eyebrow">Moved</p>
        <h1 class="display">Editors is a Tooling page now</h1>
        <p class="lede">Nothing was deleted. <a :href="target()">Read the editors page</a>.</p>
    </section>
</main>
</template>
