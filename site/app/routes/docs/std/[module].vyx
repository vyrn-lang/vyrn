<script>
// GET /docs/std/[module]: one standard library module, generated from its
// source by `app/apidoc.vyrn`, with its import neighbours and example programs
// from `app/deps.vyrn`.
//
// An export links to the playground only when a guide program imports it,
// because the link carries a program the site ran. A name that is not a module
// renders the 404 page.
import { ApiEntry, apiBlurb, apiEntries, apiIntro, apiKnown, apiSource, apiSourceLine, apiTests, apiHref, exportPhrase } from "../../../docs"
import { Demo, demoFor, guideUseCount, chapterHref } from "../../../guide"
import { examplesUsing, usesOfModule, usedByModule } from "../../../stdgraph"
import { blob } from "../../../repo"
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
import { pageHeadWith } from "../../../nav"
import { mdUrl, askClaudeUrl } from "../../../pagemd"
import { TreeGroup, Pager, docsTree, pagerFor } from "../../../docshell"
import { Icon } from "../../../icons"
params { module: String }

/// One module's whole page: its name, its header prose, and its exports.
type ModuleDoc = { name: String, intro: String, entries: Array<ApiEntry> }

/// The document title names the module.
export fn head(d: ModuleDoc) -> Head {
    return pageHeadWith("std/" + d.name + " — Vyrn", apiBlurb(d.name))
}

export fn data() -> ParamQuery<Params, Result<ModuleDoc, PageError>> {
    return paramQuery(fetchModule)
}

fn fetchModule(p: Params) -> Result<ModuleDoc, PageError> {
    if !apiKnown(p.module) {
        return Err(notFound("std/" + p.module + " is not a module"))
    }
    return Ok(ModuleDoc { name: p.module.copy(), intro: apiIntro(p.module), entries: apiEntries(p.module) })
}

/// A count with its noun: `1 test`, `3 tests`.
fn plural(n: Int64, one: String, many: String) -> String {
    return if n == 1 { "1 " + one } else { n.toString() + " " + many }
}

/// The anchor an export is linked by; export names are unique in a module.
fn anchorOf(name: String) -> String {
    return "e-" + name
}

/// The link to an export, within this page.
fn hrefFor(name: String) -> String {
    return "#" + anchorOf(name)
}

/// One neighbour in the module graph: a module this one imports, or one that
/// imports it.
type Neighbour = { name: String, href: String }

fn neighbours(names: Array<String>) -> Array<Neighbour> {
    let mut out: Array<Neighbour> = []
    for n in names {
        out.push(Neighbour { name: n.copy(), href: apiHref(n) })
    }
    return out
}

fn importsOfThis(m: String) -> Array<Neighbour> {
    return neighbours(usesOfModule(m))
}

fn importersOfThis(m: String) -> Array<Neighbour> {
    return neighbours(usedByModule(m))
}

/// One example program that imports this module, linked on GitHub.
type Sample = { path: String, href: String }

fn samples(m: String) -> Array<Sample> {
    let mut out: Array<Sample> = []
    for path in examplesUsing(m) {
        out.push(Sample { path: path.copy(), href: blob(path) })
    }
    return out
}

/// The guide program that imports `e` from this module, if the book has one.
fn demoOf(m: String, e: ApiEntry) -> Demo {
    return demoFor(m, e.name)
}

/// The tooltip on the guide icon: the chapter, and how many programs use the
/// export when more than one does. Built here because a template attribute
/// cannot hold a string literal.
fn usedInLabel(m: String, e: ApiEntry) -> String {
    let n = guideUseCount(m, e.name)
    let title = demoOf(m, e).title
    if n > 1 {
        return "Used in " + n.toString() + " guide programs, first in: " + title
    }
    return "Used in the guide: " + title
}

/// Whether a guide program imports the export; no program, no link.
fn hasDemo(m: String, e: ApiEntry) -> Bool {
    return demoFor(m, e.name).block.byteLength > 0
}

fn demoChapterHref(m: String, e: ApiEntry) -> String {
    let d = demoFor(m, e.name)
    return chapterHref(d.chapter) + "#" + d.section
}

/// The sidebar for this page: the whole reference, with this module marked.
fn tree(m: String) -> Array<TreeGroup> {
    return docsTree(m)
}

/// The module before and after this one, taken from that same tree.
fn pager(m: String) -> Pager {
    return pagerFor(docsTree(m))
}

/// The Open-in-Claude link for this module's page.
fn claudeHref(m: String) -> String {
    return askClaudeUrl(apiHref(m), "std/" + m)
}
</script>

<template>
<main class="page docs docpage">
    <!-- The whole reference, this module marked. A `<details>`: above 1024px
         the stylesheet strips the disclosure, and below it the tree is a menu,
         with no script at either width. -->
    <aside class="docstree">
        <details class="treebox">
            <summary>Reference</summary>
            <div class="treegroup" v-for="g in tree(data.name)" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <!-- The crumbs, and the page's two tools. -->
    <div class="crumbrow">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/docs.html">Reference</a>
            <a href="/docs.html#std">std</a>
            <span>{{ data.name }}</span>
        </nav>
        <div class="docutils">
            <a :href="apiSource(data.name)">Source</a>
            <a class="btn" :href="mdUrl(apiHref(data.name))" data-copy-md>Copy page</a>
            <details class="pagemenu">
                <summary aria-label="More page actions"><span class="gl">▾</span></summary>
                <div class="acts">
                    <a :href="mdUrl(apiHref(data.name))" data-copy-md><span class="ic"><Icon name="bytesize:clipboard"/></span><span class="t"><span>Copy page</span><span class="d">Markdown, ready to paste into an LLM</span></span></a>
                    <a :href="mdUrl(apiHref(data.name))"><span class="ic"><Icon name="bytesize:file"/></span><span class="t"><span>View as Markdown</span><span class="d">This page as plain text</span></span></a>
                    <a :href="claudeHref(data.name)" rel="noopener"><span class="ic"><Icon name="bytesize:external"/></span><span class="t"><span>Open in Claude</span><span class="d">Ask Claude about this page</span></span></a>
                </div>
            </details>
        </div>
    </div>

    <section class="hero">
        <h1 class="display">std/{{ data.name }}</h1>
        <p class="lede">{{ exportPhrase(data.entries.length) }}, from <code>std/{{ data.name }}.vyrn</code>.</p>
    </section>

    <section class="band" id="about">
        <div class="prose" v-html="data.intro"></div>
    </section>

    <section class="band" id="graph">
        <h2>Dependencies</h2>
        <p><a href="/docs/graph.html">The import graph</a> shows the whole library.</p>
        <dl class="specs">
            <div>
                <dt>Imports</dt>
                <dd class="links">
                    <a v-for="n in importsOfThis(data.name)" :key="n.name" :href="n.href">{{ n.name }}</a>
                    <span class="none" v-if="importsOfThis(data.name).length == 0">nothing else in std/</span>
                </dd>
            </div>
            <div>
                <dt>Imported by</dt>
                <dd class="links">
                    <a v-for="n in importersOfThis(data.name)" :key="n.name" :href="n.href">{{ n.name }}</a>
                    <span class="none" v-if="importersOfThis(data.name).length == 0">no other std module</span>
                </dd>
            </div>
        </dl>
    </section>

    <section class="band" id="api">
        <article class="entry" v-for="e in data.entries" :key="e.name" :id="anchorOf(e.name)">
            <h2><a :href="hrefFor(e.name)">{{ e.name }}</a> <span class="kindpill">{{ e.kind }}</span></h2>
            <pre class="code" v-html="e.sig"></pre>
            <div class="prose" v-html="e.prose"></div>
            <!-- One row per entry: the source link, and the guide and
                 playground links as icons whose words are in the tooltip
                 and the accessible name. -->
            <p class="cap entrycap">
                <a :href="apiSourceLine(data.name, e.line)">std/{{ data.name }}.vyrn, line {{ e.line }}</a>
                <span class="entryacts" v-if="hasDemo(data.name, e)">
                    <a class="iconlink" :href="demoChapterHref(data.name, e)" :title="usedInLabel(data.name, e)"><Icon name="bytesize:book"/><span class="sr-only">{{ usedInLabel(data.name, e) }}</span></a>
                    <a class="iconlink" :href="demoOf(data.name, e).play" title="Run it in the playground"><Icon name="bytesize:play"/><span class="sr-only">Run it in the playground</span></a>
                </span>
            </p>
        </article>
    </section>

    <section class="band" id="tests">
        <h2>Tests</h2>
        <p v-if="apiTests(data.name).length > 0">{{ plural(apiTests(data.name).length, "test block", "test blocks") }} in <code>std/{{ data.name }}.vyrn</code>. CI runs all of them.</p>
        <details class="promises">
            <summary>Test names</summary>
            <ul class="plain">
                <li v-for="t in apiTests(data.name)" :key="t">{{ t }}</li>
            </ul>
        </details>
        <p class="cap" v-if="apiTests(data.name).length == 0">This module carries no test block of its own.</p>
    </section>

    <section class="band" id="examples">
        <h2>Examples</h2>
        <p v-if="samples(data.name).length > 0">{{ plural(samples(data.name).length, "program", "programs") }} in <code>examples/</code> import this module. Each runs on all three backends.</p>
        <ul class="plain paths">
            <li v-for="s in samples(data.name)" :key="s.path"><a :href="s.href">{{ s.path }}</a></li>
        </ul>
        <p class="cap" v-if="samples(data.name).length == 0">No example program imports this module.</p>
    </section>

    <nav class="pager" aria-label="Reference">
        <a class="prev" v-if="pager(data.name).prevHref.byteLength > 0" :href="pager(data.name).prevHref"><span class="eyebrow">Previous</span>{{ pager(data.name).prevLabel }}</a>
        <a class="next" v-if="pager(data.name).nextHref.byteLength > 0" :href="pager(data.name).nextHref"><span class="eyebrow">Next</span>{{ pager(data.name).nextLabel }}</a>
    </nav>

    <!-- This page's headings, in document order, as plain links.
         `widgets.js` marks the one in view. -->
    <aside class="onpage">
        <p class="eyebrow">On this page</p>
        <a href="#about">About</a>
        <a href="#graph">Dependencies</a>
        <a class="sub" v-for="e in data.entries" :key="e.name" :href="hrefFor(e.name)">{{ e.name }}</a>
        <a href="#tests">Tests</a>
        <a href="#examples">Examples</a>
    </aside>
</main>
</template>
