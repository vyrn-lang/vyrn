<script>
// GET /docs — the reference entry: every standard library module, on this site.
//
// The reference used to be six links to the repository. It is now generated from
// the source while the site compiles — `site/app/apidoc.vyrn` lexes every
// `std/*.vyrn` and emits each export's signature, prose and line — so a module
// name here opens a page rather than a Markdown file on GitHub.
//
// The links that remain point at things this site does not host: the README, the
// roadmap, the examples. Those are the only ones worth leaving for — the design
// record and the compiler notes were two of them, and both were development
// reading on a consumer page (RFC-0105 M1). The record is a section of its own
// now, reached from the footer.
//
// THE SEARCH AND THE GRAPH ARE HERE (RFC-0105 M2). They were `/explore`, which
// was a second view of this same list and answered no question this page could
// not. The module list below IS the search index: each row carries its own
// lowercased haystack in `data-q` and its export names in `data-e`, so there is
// no fetch, no index file, and a reader with no script still gets every module,
// its first line and a link. `widgets.js` filters the rows and builds a link per
// matching export with `createElement` — never by assembling markup out of what
// was typed. The graph's geometry is computed in Vyrn while this page is built
// (`site/app/stdgraph.vyrn`), and the script only lights up one module's wires.
//
// There is one module list on this site and it is this one. `/explore` renders
// packages — a different set, a different shape, and every card goes to that
// package's own page.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { exampleCount, blob } from "../../repo"
import { ApiModule, apiModules, apiHref } from "../../docs"
import { SearchRow, SearchGroup, GraphNode, GraphEdge, searchRows, searchGroups, graphNodes, graphEdges, graphViewBox, graphWidth, edgeCount, leafCount } from "../../stdgraph"

/// One place to read next, outside this site.
type Link = { href: String, name: String, what: String }

export fn head() -> Head {
    return pageHeadOf("/docs")
}

/// How many exports the whole reference covers.
fn exportCount() -> Int64 {
    let mut n = 0
    for m in apiModules() {
        n = n + m.count
    }
    return n
}

fn links() -> Array<Link> {
    return [
        Link { href: blob("examples"), name: "Examples", what: "Single-file programs, every one run on three engines." },
        Link { href: blob("README.md"), name: "README", what: "The language in one page." },
        Link { href: blob("ROADMAP.md"), name: "Roadmap", what: "What ships today, and what is next." },
    ]
}

/// One row of the command table: what you type, and what it does.
///
/// The name is CODE, not a link. An earlier round wrapped each command in an
/// anchor so the row would do something when clicked; that was wrong twice over.
/// A command is something you copy — every inline code span on this site copies
/// itself when you click it — and the anchors it grew pointed at GitHub, which
/// is exactly the redirect this site exists to remove. Where a row has more to
/// say, the sentence carries an ON-SITE link, in the sentence, as a link looks.
type Command = { name: String, what: String }

/// The width the graph needs, as a style. Below it the drawing scrolls inside
/// its own box; the page never scrolls sideways.
fn graphStyle() -> String {
    return "min-width:" + graphWidth().toString() + "px"
}

fn commands() -> Array<Command> {
    return [
        Command { name: "vyrn run | check | build | test | bench", what: "Run, type-check, compile, and run the tests and benchmarks written in the file. <a href=\"/guide/getting-started.html#first\">Your first program.</a>" },
        Command { name: "vyrn fmt --check", what: "The canonical formatter. <code>--check</code> is the CI gate." },
        Command { name: "vyrn doc", what: "Markdown API docs from /// comments. <a href=\"/docs.html#std\">The pages on this site</a> are read off the same declarations." },
        Command { name: "vyrn why <file>", what: "Why the compiler decided what it decided. <code>--memory</code> and <code>--contract</code> narrow it. <a href=\"/guide/ownership.html\">The chapter on ownership.</a>" },
        Command { name: "vyrn emit-gen <file>", what: "The source a generator produced. A generator is not magic, and this prints it." },
        Command { name: "vyrn serve | dev | routes", what: "An HTTP host, the development server, and the resolved wire table." },
        Command { name: "vyrn new | add | update | vendor | deps", what: "Projects and modules. Remote imports pin in <code>vyrn.lock</code> and cache by sha256." },
    ]
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#std"><span class="n">01</span>std</a>
        <a href="#graph"><span class="n">02</span>graph</a>
        <a href="#cli"><span class="n">03</span>cli</a>
        <a href="#read"><span class="n">04</span>elsewhere</a>
    </aside>
        <section class="hero split">
            <div class="say">
                <p class="eyebrow">Reference</p>
                <h1 class="display">Generated from the source</h1>
                <p class="lede">{{ apiModules().length }} modules, {{ exportCount() }} exports, read off <code>std/</code> by the compiler's own lexer while this page was built.</p>
            </div>
            <div class="finder" data-search>
                <label class="eyebrow" for="std-q">Search modules and exports</label>
                <input id="std-q" type="search" autocomplete="off" spellcheck="false" placeholder="parse, Map, schema, byteLength" data-search-input/>
                <p class="eyebrow" data-search-count aria-live="polite">{{ searchRows().length }} modules</p>
            </div>
        </section>

        <!-- THE WHOLE LIBRARY, IN FOUR GROUPS AND THREE COLUMNS (RFC-0106 M3).
             Every row is generated — `apiGroups()` reads `std/` — so a module
             added tomorrow is on this page on the next build. The rows still
             carry `data-q` and `data-e`, so the search above filters them where
             they sit; a group whose rows are all filtered out hides itself. -->
        <section class="band" id="std">
            <div data-search-list>
                <div class="modgroup" v-for="g in searchGroups()" :key="g.name">
                    <h2 class="eyebrow">{{ g.name }}</h2>
                    <ul class="modgrid">
                        <li v-for="r in g.rows" :key="r.name" :data-q="r.q" :data-e="r.e" :data-m="r.name">
                            <a :href="r.href">std/{{ r.name }}</a>
                            <span class="count">{{ r.count }}</span>
                            <span class="d" v-html="r.summary"></span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="band" id="graph">
            <p class="eyebrow">The graph</p>
            <h2>{{ edgeCount() }} imports between {{ searchRows().length }} modules</h2>
            <p>Every wire is an <code>import</code> line; {{ leafCount() }} modules import nothing else in <code>std/</code>.</p>
            <div class="plate">
                <div class="plate-head">
                    <span class="pill">Built</span>
                    <span class="eyebrow">point at a module to light its wires</span>
                </div>
                <div class="stage scroller">
                    <!-- `role="group"` and not `role="img"` (RFC-0105 M4). Every
                         node is a link, so every node is a tab stop; under
                         `role="img"` those thirty-seven stops were present in
                         the tab order and absent from the accessibility tree,
                         which is the worst of both. The graph is a group of
                         links now, and each link's name carries the two counts
                         the highlight draws. -->
                    <svg class="graph" :viewBox="graphViewBox()" :style="graphStyle()" role="group" aria-label="The import graph of the standard library. Every module is a link, named with what it imports and what imports it.">
                        <path class="wire" v-for="e in graphEdges()" :key="e.id" :d="e.d" :data-from="e.from" :data-to="e.to"/>
                        <g class="node" v-for="n in graphNodes()" :key="n.name" :data-m="n.name" :data-uses="n.uses" :data-usedby="n.usedBy">
                            <a :href="n.href" :aria-label="n.label">
                                <rect :x="n.hx" :y="n.hy" :width="n.w" height="18" class="hit"/>
                                <circle :cx="n.x" :cy="n.y" r="3"/>
                                <text :x="n.tx" :y="n.ty">{{ n.name }}</text>
                            </a>
                        </g>
                    </svg>
                </div>
                <p class="cap">Read from the <code>import</code> lines of <code>std/*.vyrn</code>. An import inside a code quote is a string, not a wire.</p>
            </div>
        </section>

        <section class="band" id="cli">
            <p class="eyebrow">The driver</p>
            <h2>What <code>vyrn</code> does</h2>
            <div class="scroller">
            <table>
                <thead>
                    <tr><th>Command</th><th>What it does</th></tr>
                </thead>
                <tbody>
                    <tr v-for="c in commands()" :key="c.name">
                        <td><code>{{ c.name }}</code></td>
                        <td v-html="c.what"></td>
                    </tr>
                </tbody>
            </table>
            </div>
        </section>

        <section class="band split" id="read">
            <div class="say">
                <p class="eyebrow">Elsewhere</p>
                <h2>Three ways on, three off</h2>
                <p><a href="/guide.html">The guide</a> teaches the language in order. <a href="/explore.html">The registry</a> lists what a project pulls in from outside <code>std/</code>.</p>
            </div>
            <ul class="plain">
                <li v-for="l in links()" :key="l.href">
                    <a :href="l.href">{{ l.name }}</a>
                    <span>{{ l.what }}</span>
                </li>
            </ul>
        </section>
</main>
</template>
