<script>
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { searchRows, graphNodes, graphEdges, graphViewBox, graphWidth, edgeCount, graphLede, graphIntro, graphCaption } from "../../stdgraph"
import { mdUrl, askClaudeUrl } from "../../pagemd"
import { Icon } from "../../icons"
import { TreeGroup, Pager, docsTree, pagerFor } from "../../docshell"

export fn head() -> Head {
    return pageHeadOf("/docs/graph")
}

fn pageHref() -> String {
    return "/docs/graph.html"
}

fn claudeHref() -> String {
    return askClaudeUrl(pageHref(), "The import graph")
}

fn tree() -> Array<TreeGroup> {
    return docsTree("graph")
}

fn pager() -> Pager {
    return pagerFor(tree())
}

fn graphStyle() -> String {
    return "min-width:" + graphWidth().toString() + "px"
}
</script>

<template>
<main class="page docs">
    <aside class="docstree">
        <details class="treebox">
            <summary>Reference</summary>
            <div class="treegroup" v-for="g in tree()" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <div class="crumbrow">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/docs.html">Reference</a>
            <span>The import graph</span>
        </nav>
        <div class="docutils">
            <a class="btn" :href="mdUrl(pageHref())" data-copy-md>Copy page</a>
            <details class="pagemenu">
                <summary aria-label="More page actions"><span class="gl">▾</span></summary>
                <div class="acts">
                    <a :href="mdUrl(pageHref())" data-copy-md><span class="ic"><Icon name="bytesize:clipboard"/></span><span class="t"><span>Copy page</span><span class="d">Markdown, ready to paste into an LLM</span></span></a>
                    <a :href="mdUrl(pageHref())"><span class="ic"><Icon name="bytesize:file"/></span><span class="t"><span>View as Markdown</span><span class="d">This page as plain text</span></span></a>
                    <a :href="claudeHref()" rel="noopener"><span class="ic"><Icon name="bytesize:external"/></span><span class="t"><span>Open in Claude</span><span class="d">Ask Claude about this page</span></span></a>
                </div>
            </details>
        </div>
    </div>

    <section class="hero">
        <h1 class="display">{{ edgeCount() }} imports between {{ searchRows().length }} modules</h1>
        <p class="lede" v-html="graphLede()"></p>
    </section>

    <section class="band" id="graph">
        <h2>Import graph</h2>
        <p>{{ graphIntro() }}</p>
        <div class="plate">
            <div class="plate-head">
                <span class="pill">Built</span>
                <span class="eyebrow">point at a module to light its wires</span>
            </div>
            <div class="stage scroller">
                <!-- `group`, not `img`: under `img` every node's tab stop leaves the accessibility tree. -->
                <svg class="graph" :viewBox="graphViewBox()" :style="graphStyle()" role="group" aria-label="The import graph of the standard library. Every module is a link, named with what it imports and what imports it.">
                    <path class="wire" v-for="e in graphEdges()" :key="e.id" :d="e.d" :data-from="e.from" :data-to="e.to"/>
                    <g class="node" v-for="n in graphNodes()" :key="n.name" :data-m="n.name" :data-uses="n.uses" :data-usedby="n.usedBy">
                        <a :href="n.href" :aria-label="n.label">
                            <rect :x="n.hx" :y="n.hy" :width="n.w" height="18" class="hit"/>
                            <circle :cx="n.x" :cy="n.y" r="3"/>
                            <text :x="n.tx" :y="n.ty">{{ n.name }}</text>
                        </a>
                    </g>
                </svg>
            </div>
            <p class="cap" v-html="graphCaption()"></p>
        </div>
    </section>

    <nav class="pager" aria-label="Reference">
        <a class="prev" v-if="pager().prevHref.byteLength > 0" :href="pager().prevHref"><span class="eyebrow">Previous</span>{{ pager().prevLabel }}</a>
        <a href="#graph">Import graph</a>
    </nav>
</main>
</template>
