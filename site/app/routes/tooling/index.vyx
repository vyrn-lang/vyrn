<script>
// GET /tooling: the Tooling area's contents, from `areaChapters("tooling")`.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Chapter, areaGroups, groupChapters, chapterHref } from "../../guide"
import { inlineCode } from "../../code"
import { TreeGroup, areaTree } from "../../docshell"

export fn head() -> Head {
    return pageHeadOf("/tooling")
}

/// This shelf's groups, as the sidebar prints them.
fn groups() -> Array<String> {
    return areaGroups("tooling")
}

/// One group's pages.
fn of(g: String) -> Array<Chapter> {
    return groupChapters("tooling", g)
}

/// Whether `g` is the group that also lists Editors. Built here because a
/// template attribute cannot hold a string literal.
fn holdsEditors(g: String) -> Bool {
    return g == "Workspace"
}

/// The sidebar, with nothing marked: the subnav's own row is this landing's
/// marker.
fn tree() -> Array<TreeGroup> {
    return areaTree("tooling", "index")
}
</script>

<template>
<main class="page docs docpage">
    <aside class="docstree">
        <details class="treebox">
            <summary>Tooling</summary>
            <div class="treegroup" v-for="g in tree()" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <section class="hero">
        <h1 class="display">Tooling</h1>
        <p class="lede">The CLI, the test and bench runner, projects and dependency pinning, and the editors.</p>
    </section>

    <section class="band" id="pages">
        <div class="chapgroup" v-for="g in groups()" :key="g">
            <p class="eyebrow">{{ g }}</p>
            <ul class="modgrid chapters">
                <li v-for="c in of(g)" :key="c.slug">
                    <a :href="chapterHref(c.slug)">{{ c.title }}</a>
                    <span class="d" v-html="inlineCode(c.lede)"></span>
                </li>
                <!-- The one page of this shelf that is not a chapter: the same
                     hand-listed row the sidebar's Workspace group carries. -->
                <li v-if="holdsEditors(g)">
                    <a href="/tooling/editors.html">Editors</a>
                    <span class="d">One VS Code extension and one language server, both answering from the compiler front end itself.</span>
                </li>
            </ul>
        </div>
    </section>
</main>
</template>
