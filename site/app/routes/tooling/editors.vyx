<script>
// GET /tooling/editors: what the editor extension and the language server
// do. The stubs at `/editors` and `/docs/editors` point here.
//
// Every row names its implementation in `data-impl`; `site/export.vyrn` opens
// each path, so a row for something nobody wrote fails the build. The rows in
// `../editors` follow the code where the extension's README disagrees.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { shellHtml } from "../../code"
import { features, steps, implHref, pageTitle, lede, notice, featuresHeading, featuresIntro, featuresCap, featuresNotice, installHeading, installIntro, installNotice, installCap, otherHeading, otherIntro, otherClose } from "../../editors"
import { mdUrl, askClaudeUrl } from "../../pagemd"
import { Icon } from "../../icons"
import { TreeGroup, Pager, areaTree, pagerFor } from "../../docshell"

export fn head() -> Head {
    return pageHeadOf("/tooling/editors")
}

/// This page's own URL, in the form the markdown twin's helpers take.
fn pageHref() -> String {
    return "/tooling/editors.html"
}

/// The Open-in-Claude link for this page.
fn claudeHref() -> String {
    return askClaudeUrl(pageHref(), pageTitle())
}

fn tree() -> Array<TreeGroup> {
    return areaTree("tooling", "editors")
}

fn pager() -> Pager {
    return pagerFor(tree())
}
</script>

<template>
<main class="page docs">
    <aside class="docstree">
        <details class="treebox">
            <summary>Tooling</summary>
            <div class="treegroup" v-for="g in tree()" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <div class="crumbrow">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/tooling.html">Tooling</a>
            <span>Editors</span>
        </nav>
        <div class="docutils">
            <a class="btn" :href="mdUrl(pageHref())" data-copy-md>Copy page</a>
            <details class="pagemenu">
                <summary aria-label="More page actions"><span class="gl">▾</span></summary>
                <div class="acts">
                    <a :href="mdUrl(pageHref())" data-copy-md><span class="ic"><Icon name="bytesize:clipboard"/></span><span class="t"><span>Copy page</span><span class="d">Markdown, ready to paste into an LLM</span></span></a>
                    <a :href="mdUrl(pageHref())"><span class="ic"><Icon name="bytesize:file"/></span><span class="t"><span>View as Markdown</span><span class="d">This page as plain text</span></span></a>
                    <a :href="claudeHref()" rel="noopener"><span class="ic"><Icon name="bytesize:external"/></span><span class="t"><span>Open in Claude</span><span class="d">Ask Claude about this page</span></span></a>
                </div>
            </details>
        </div>
    </div>

    <section class="hero" id="what">
        <h1 class="display">{{ pageTitle() }}</h1>
        <p class="lede" v-html="lede()"></p>
        <p class="notice" v-html="notice()"></p>
    </section>

    <section class="band" id="features">
        <h2>{{ features().length }} {{ featuresHeading() }}</h2>
        <p v-html="featuresIntro()"></p>
        <div class="scroller">
        <table>
            <thead>
                <tr><th scope="col">Feature</th><th scope="col">What you get</th><th scope="col">Implemented by</th></tr>
            </thead>
            <tbody>
                <tr v-for="f in features()" :key="f.name" :data-impl="f.path">
                    <td>{{ f.name }}</td>
                    <td v-html="f.what"></td>
                    <td><a :href="implHref(f)"><code>{{ f.symbol }}</code></a></td>
                </tr>
            </tbody>
        </table>
        </div>
        <p class="cap" v-html="featuresCap()"></p>
        <p class="notice" v-html="featuresNotice()"></p>
    </section>

    <section class="band" id="get">
        <h2>{{ installHeading() }}</h2>
        <p v-html="installIntro()"></p>
        <ul class="plain">
            <li v-for="s in steps()" :key="s.title">
                <strong>{{ s.title }}</strong>
                <div class="cmd" data-copy>
                    <code v-html="shellHtml(s.command)"></code>
                    <button type="button" data-copy-btn aria-label="Copy this command">Copy</button>
                </div>
                <span class="note" v-html="s.what"></span>
            </li>
        </ul>
        <p class="notice" v-html="installNotice()"></p>
        <p class="cap" v-html="installCap()"></p>
    </section>

    <section class="band" id="other">
        <h2>{{ otherHeading() }}</h2>
        <p v-html="otherIntro()"></p>
        <p v-html="otherClose()"></p>
    </section>

    <nav class="pager" aria-label="Pages">
        <a class="prev" v-if="pager().prevHref.byteLength > 0" :href="pager().prevHref"><span class="eyebrow">Previous</span>{{ pager().prevLabel }}</a>
        <a class="next" v-if="pager().nextHref.byteLength > 0" :href="pager().nextHref"><span class="eyebrow">Next</span>{{ pager().nextLabel }}</a>
    </nav>

    <aside class="onpage">
        <p class="eyebrow">On this page</p>
        <a href="#what">Overview</a>
        <a href="#features">Features</a>
        <a href="#get">Install</a>
        <a href="#other">Other editors</a>
    </aside>
</main>
</template>
