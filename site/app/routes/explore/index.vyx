<script>
// GET /explore — the registry: what you can install into a project you did not
// write (RFC-0105 M2, amended).
//
// This page has been the standard library twice. First as a search field and an
// import graph over the modules `/docs` documents; both moved to the reference.
// Then as a card per `std/` module, which was the same list again in a different
// frame — and a reader looking at it learned nothing about DEPENDING on
// anything, because nobody depends on `std/`: it arrives with the compiler.
//
// What a registry answers is what a reference cannot: what exists outside your
// project, what it costs, and what you type to pull it in. So every card here is
// a package with a `github:` specifier, and every page is the story of typing
// it — the command, the two files it writes, and the `import` line that follows.
//
// No script. Four cards of static markup need no filter; the search that exists
// is on the reference, where the four hundred exports are.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Package, packages } from "../../packages"
import { stdCount } from "../../repo"

export fn head() -> Head {
    return pageHeadOf("/explore")
}

/// `1 export`, `14 exports` — how many names the module this package offers
/// gives you.
fn unitLabel(p: Package) -> String {
    return if p.exports == 1 { "1 export" } else { p.exports.toString() + " exports" }
}

/// The same rule for the dependency count.
fn depLabel(p: Package) -> String {
    if p.deps == 0 {
        return "no dependencies"
    }
    return if p.deps == 1 { "1 dependency" } else { p.deps.toString() + " dependencies" }
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#packages"><span class="n">01</span>packages</a>
        <a href="#install"><span class="n">02</span>how you install one</a>
        <a href="#young"><span class="n">03</span>the state of it</a>
    </aside>

    <section class="hero">
        <p class="eyebrow">Registry</p>
        <h1 class="display">{{ packages().length }} packages</h1>
        <p class="lede">Everything you can pull into a project from outside it, fetched by URL and pinned by hash. Not the standard library — that arrives with the compiler and is in <a href="/docs.html">the reference</a>.</p>
    </section>

    <section class="band" id="packages">
        <p class="eyebrow">the index</p>
        <h2>One card per package</h2>
        <p>The two numbers are what a dependency is weighed by: what it gives you, and what it drags in. Both are read off the source while this page is built.</p>
        <ul class="pkgs">
            <li v-for="p in packages()" :key="p.slug" :data-kind="p.kind">
                <a :href="p.href">{{ p.name }}</a>
                <span class="kindpill">{{ p.kind }}</span>
                <span class="d" v-html="p.summary"></span>
                <span class="nums">{{ unitLabel(p) }} · {{ depLabel(p) }}</span>
            </li>
        </ul>
        <p class="cap">Read off <code>examples/</code> while this page was built. Each card opens the package's own page, which carries the specifier, the command and the two files the command writes.</p>
    </section>

    <section class="band" id="install">
        <p class="eyebrow">how you install one</p>
        <h2>A URL, a hash, and two files</h2>
        <p>Vyrn has no registry server and no account. A dependency is a URL — <code>github:owner/repo@ref/path.vyrn</code>, <code>gist:</code>, or a plain <code>https:</code> address. <code>vyrn add</code> fetches it once, records the immutable URL and the sha256 of the bytes in <code>vyrn.lock</code>, and writes the alias into <code>vyrn.json</code>. The hash is checked on every load after that, so an upstream that changes under a pinned URL fails the build instead of changing your program.</p>
        <p>The bytes are cached by content under <code>~/.vyrn</code>. <code>vyrn vendor</code> copies them into your repository and <code>--offline</code> forbids the network outright, so any copy with the right hash restores an upstream that vanished. <a href="/docs.html#cli">The four commands</a> are the whole mechanism.</p>
    </section>

    <section class="band" id="young">
        <p class="eyebrow">the state of it</p>
        <h2>The ecosystem is young</h2>
        <p>Nothing is published outside this repository yet, so every package here comes from it — and nothing is listed that does not. The {{ stdCount() }} standard library modules are not in the count: you do not install them. The page schema is the one a third-party package will use unchanged, and when somebody publishes one it is a card.</p>
    </section>
</main>
</template>
