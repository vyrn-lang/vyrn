<script>
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Package, packages, offerOf } from "../../packages"
import { toLower } from "std/strings"

export fn head() -> Head {
    return pageHeadOf("/explore")
}

fn numsOf(p: Package) -> String {
    let ex = if p.exports == 1 { "1 export" } else { p.exports.toString() + " exports" }
    let deps = if p.deps == 0 { "no deps" } else if p.deps == 1 { "1 dep" } else { p.deps.toString() + " deps" }
    return ex + " · " + deps
}

fn haystack(p: Package) -> String {
    return toLower(p.name + " " + p.kind + " " + p.summary)
}

fn exportsOf(p: Package) -> String {
    let mut out = ""
    for e in offerOf(p.slug).exports {
        out = out + if out.byteLength == 0 { e.copy() } else { " " + e }
    }
    return out
}
</script>

<template>
<main class="page registry">
    <section class="hero reghead">
        <h1 class="display">Registry</h1>
        <p class="lede">{{ packages().length }} packages a project can import from outside itself, fetched by URL and pinned by hash.</p>
        <div class="regsearch">
            <input type="search" data-search-input placeholder="Search — a name, an export, kind:project" autocomplete="off" spellcheck="false" aria-label="Search packages"/>
            <span class="count" data-search-count data-search-noun="package">{{ packages().length }}</span>
        </div>
        <p class="reghint">Hint: <code>kind:project</code> narrows by kind, and an export's name, such as <code>addBook</code>, finds the package that offers it.</p>
    </section>

    <section class="band">
        <div data-search-list>
            <ul class="reglist">
                <li v-for="p in packages()" :key="p.slug" :data-kind="p.kind" :data-q="haystack(p)" :data-e="exportsOf(p)">
                    <div class="regrow">
                        <a class="name" :href="p.href">{{ p.name }}</a>
                        <span class="kind">{{ p.kind }}</span>
                        <span class="nums">{{ numsOf(p) }}</span>
                    </div>
                    <span class="d">{{ p.summary }}</span>
                </li>
            </ul>
        </div>
        <p class="cap">No registry server and no account: a dependency is a URL. <a href="/tooling/projects.html">Projects and dependencies</a> explains how one is pinned.</p>
    </section>
</main>
</template>
