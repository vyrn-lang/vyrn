<script>
// GET /explore — the registry: what you can install into a project you did not
// write (RFC-0105 M2; registry front RFC-0106 M5 rounds 3-4).
//
// The shape is a package index's (user: "like npm or crates", and the first
// registry cut drowned it in prose): a search field, a count, and one compact
// row per package — name, kind, one sentence, two numbers. The install
// command, the manifest and the mechanism live on the package's own page,
// which is where a reader who has chosen a package goes next. One line under
// the list points at the mechanism's page and that is all the prose there is.
//
// The search is the reference landing's own scriptless-degrading mechanism:
// every row carries its lowercased haystack in `data-q`, `widgets.js` filters
// rows where they stand, and with no script the full index is simply visible.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Package, packages } from "../../packages"
import { toLower } from "std/strings"

export fn head() -> Head {
    return pageHeadOf("/explore")
}

/// `1 export · 2 deps` — what a dependency is weighed by, in a row's worth of
/// space.
fn numsOf(p: Package) -> String {
    let ex = if p.exports == 1 { "1 export" } else { p.exports.toString() + " exports" }
    let deps = if p.deps == 0 { "no deps" } else if p.deps == 1 { "1 dep" } else { p.deps.toString() + " deps" }
    return ex + " · " + deps
}

/// The row's search haystack: name, kind, and the summary's words, lowercased —
/// the same contract the reference's rows carry.
fn haystack(p: Package) -> String {
    return toLower(p.name + " " + p.kind + " " + p.summary)
}
</script>

<template>
<main class="page registry">
    <section class="hero reghead">
        <p class="eyebrow">The registry</p>
        <h1 class="display">{{ packages().length }} packages</h1>
        <p class="lede">What you can pull into a project from outside it — fetched by URL, pinned by hash.</p>
        <div class="regsearch">
            <input type="search" data-search-input placeholder="Search packages" autocomplete="off" spellcheck="false" aria-label="Search packages"/>
            <span class="count" data-search-count data-search-noun="package">{{ packages().length }}</span>
        </div>
    </section>

    <section class="band">
        <div data-search-list>
            <ul class="reglist">
                <li v-for="p in packages()" :key="p.slug" :data-kind="p.kind" :data-q="haystack(p)">
                    <div class="regrow">
                        <a class="name" :href="p.href">{{ p.name }}</a>
                        <span class="kind">{{ p.kind }}</span>
                        <span class="nums">{{ numsOf(p) }}</span>
                    </div>
                    <span class="d" v-html="p.summary"></span>
                </li>
            </ul>
        </div>
        <p class="cap">No registry server and no account — a dependency is a URL, and <code>vyrn add</code> pins its sha256 in <code>vyrn.lock</code>. <a href="/tooling/projects.html">How installing works</a>.</p>
    </section>
</main>
</template>
