<script>
// GET /explore/[package] — one package, and the story of installing it
// (RFC-0105 M2, amended).
//
// Everything on this page is read off the package's own files while the site
// compiles: the artifacts from its `vyrn.json`, the module it offers and that
// module's export names from the source, and the standard library modules it
// needs from the `import` lines under it.
//
// THE SPECIFIER IS THE POINT OF THE PAGE. It is carried in the markup as
// `data-spec` as well as in the box, and `site/test/importline.test.mjs`
// re-parses every one of them with the grammar
// `compiler/vyrn-cli/src/remote.rs` applies. A line that reads like a command
// and does not resolve is worse than no line: the reader types it, the compiler
// refuses, and the page was the one that lied.
//
// The two file shapes are shapes, not transcripts. The commit `@main` resolves
// to and the sha256 of the fetched bytes are the two facts a page built from a
// checkout cannot know, and they are shown as what they are rather than as
// numbers somebody might copy.
import { Package, Artifact, PkgLink, Offer, packageKnown, packageOf, packageDeps, packageSource, offerOf, addCommand, manifestShape, lockShape, importFrom, artifactsOf } from "../../packages"
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
import { pageHead } from "../../nav"
params { package: String }

export fn head(d: Package) -> Head {
    return pageHead(d.name + " — the Vyrn registry")
}

export fn data() -> ParamQuery<Params, Result<Package, PageError>> {
    return paramQuery(fetchPackage)
}

fn fetchPackage(p: Params) -> Result<Package, PageError> {
    if !packageKnown(p.package) {
        return Err(notFound(p.package + " is not a package"))
    }
    return Ok(packageOf(p.package))
}

/// `1 export`, `14 exports`. A count and its noun disagreeing is the sort of
/// thing a reader takes as a sign that nothing here was read.
fn unitLabel(d: Package) -> String {
    return if d.exports == 1 { "1 export" } else { d.exports.toString() + " exports" }
}

/// `no dependencies`, `1 dependency`, `6 dependencies`.
fn depLabel(d: Package) -> String {
    if d.deps == 0 {
        return "no dependencies"
    }
    return if d.deps == 1 { "1 dependency" } else { d.deps.toString() + " dependencies" }
}

/// `1 artifact`, `2 artifacts` — what the project builds, which is a different
/// question from what it offers.
fn buildLabel(d: Package) -> String {
    let n = artifactsOf(d.slug).length
    return if n == 1 { "1 artifact" } else { n.toString() + " artifacts" }
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#use"><span class="n">01</span>install it</a>
        <a href="#api"><span class="n">02</span>what it gives</a>
        <a href="#deps"><span class="n">03</span>what it needs</a>
    </aside>

    <section class="hero">
        <p class="eyebrow"><a href="/explore.html">Registry</a> — {{ data.kind }}</p>
        <h1 class="display">{{ data.name }}</h1>
        <p class="lede" v-html="data.summary"></p>
        <p class="notice"><a :href="packageSource(data.slug)">Read the source</a> — <code>{{ data.name }}/</code>, the one thing this site does not host.</p>
    </section>

    <section class="band" id="use">
        <p class="eyebrow">install it</p>
        <h2>One command</h2>
        <p>This package is a directory in a public repository, so its specifier is that repository, a ref, and a path. <code>vyrn add</code> fetches it, hashes it, pins it and records the alias — you type this once.</p>
        <div class="cmd" data-copy>
            <code :data-spec="offerOf(data.slug).spec">{{ addCommand(data.slug) }}</code>
            <button type="button" data-copy-btn aria-label="Copy it">Copy</button>
        </div>
        <p class="cap">The ref is <code>main</code>, the branch this site is built from, so what is listed below is what you get. Write a tag instead — the releases are on <a href="/releases.html">the releases page</a> — and everything else is the same.</p>

        <h3>What it writes</h3>
        <p>Two files, both in your project. <code>vyrn.json</code> gains the alias, which is the name your <code>import</code> lines use — appended after the keys you already had:</p>
        <pre class="code">{{ manifestShape(data.slug) }}</pre>
        <p><code>vyrn.lock</code> gains a line: the specifier, the immutable URL it resolved to, and the sha256 of the bytes. Tab-separated, sorted, one per pinned file. The hash is verified on every load afterwards, so an upstream that changes under a pinned URL fails the build rather than changing your program.</p>
        <div class="scroller">
        <pre class="code">{{ lockShape(data.slug) }}</pre>
        </div>
        <p class="cap"><code>&lt;commit&gt;</code> is the 40 hex digits <code>main</code> pointed at when you ran it, and <code>&lt;sha256&gt;</code> the 64 hex digits of the bytes it fetched. They are the two facts this page cannot know — nothing has been fetched — and <code>vyrn add</code> writes both.</p>

        <h3>Then you import it</h3>
        <p>The alias is a bare specifier the manifest maps, so the module reads like any other:</p>
        <div class="cmd" data-copy>
            <code>{{ importFrom(data.slug) }}</code>
            <button type="button" data-copy-btn aria-label="Copy it">Copy</button>
        </div>
    </section>

    <section class="band" id="api">
        <p class="eyebrow">what it gives</p>
        <h2>{{ unitLabel(data) }}</h2>
        <p>The specifier above names <code>{{ offerOf(data.slug).path }}</code>: the module with the most exports that this project does not itself build from. An entry point is what a project BUILDS; this is what it gives away. Any other module in the tree takes the same specifier with its own path in it.</p>
        <dl class="specs">
            <div>
                <dt>Exports</dt>
                <dd class="links">
                    <code v-for="e in offerOf(data.slug).exports" :key="e">{{ e }}</code>
                </dd>
            </div>
        </dl>
        <p class="cap">Read off <code>{{ data.name }}/{{ offerOf(data.slug).path }}</code> while this page was built. A relative import inside a fetched module resolves inside the same pinned tree, so what this one reaches arrives with it — each file with a lock line of its own.</p>

        <h3>{{ buildLabel(data) }}</h3>
        <p>What the project builds, if you clone it rather than depend on it. The target is a capability declaration rather than a build flag: a browser has no filesystem, and no edit to the manifest can give it one.</p>
        <div class="scroller">
        <table>
            <thead>
                <tr><th>Artifact</th><th>Entry</th><th>Target</th></tr>
            </thead>
            <tbody>
                <tr v-for="a in artifactsOf(data.slug)" :key="a.name">
                    <td><code>{{ a.name }}</code></td>
                    <td><code>{{ a.entry }}</code></td>
                    <td><code>{{ a.target }}</code></td>
                </tr>
            </tbody>
        </table>
        </div>
        <p class="cap">Read from <code>{{ data.name }}/vyrn.json</code> while this page was built.</p>
    </section>

    <section class="band" id="deps">
        <p class="eyebrow">what it needs</p>
        <h2>{{ depLabel(data) }}</h2>
        <p>Standard library modules, and nothing else — this package depends on no registry, because there is none. Every one of them arrives with the compiler, so none of them is a fetch; each link opens its page on the reference.</p>
        <dl class="specs">
            <div>
                <dt>Depends on</dt>
                <dd class="links">
                    <a v-for="d in packageDeps(data.slug)" :key="d.name" :href="d.href">{{ d.name }}</a>
                    <span class="none" v-if="data.deps == 0">nothing at all</span>
                </dd>
            </div>
        </dl>
        <p class="cap">Read from the <code>import</code> lines under <code>{{ data.name }}/</code> by the compiler's own lexer.</p>
    </section>
</main>
</template>
