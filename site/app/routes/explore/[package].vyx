<script>
// GET /explore/[package] — one package (RFC-0105 M2; compacted by RFC-0106 M5
// round 5 — the long-band cut was "overloaded and hardly readable", user).
//
// The shape is a package index's page: the identity at the top, the install
// command and the source in a side card, and the substance — the import line,
// the exports, the artifacts, the dependencies — as short blocks. The two file
// SHAPES `vyrn add` writes are behind one `<details>`: they are reference
// material, and open-by-default they were most of the page.
//
// Everything here is still read off the package's own files while the site
// compiles, and THE SPECIFIER IS STILL THE POINT: it is carried in `data-spec`
// and `site/test/importline.test.mjs` re-parses every one with the grammar
// `compiler/vyrn-cli/src/remote.rs` applies.
import { Package, Artifact, PkgLink, Offer, packageBlurb, packageKnown, packageOf, packageDeps, packageSource, offerOf, addCommand, manifestShape, lockShape, importFrom, artifactsOf } from "../../packages"
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
import { pageHeadWith } from "../../nav"
params { package: String }

export fn head(d: Package) -> Head {
    return pageHeadWith(d.name + " — the Vyrn registry", packageBlurb(d))
}

export fn data() -> ParamQuery<Params, Result<Package, PageError>> {
    return paramQuery(fetchPackage)
}

fn fetchPackage(p: Params) -> Result<Package, PageError> {
    if !packageKnown(p.package) {
        return Err(notFound(p.package + " is not a package"))
    }
    return Ok(packageOf(p.package))
}

/// `1 export`, `14 exports`. A count and its noun disagreeing is the sort of
/// thing a reader takes as a sign that nothing here was read.
fn unitLabel(d: Package) -> String {
    return if d.exports == 1 { "1 export" } else { d.exports.toString() + " exports" }
}

/// `no dependencies`, `1 dependency`, `6 dependencies`.
fn depLabel(d: Package) -> String {
    if d.deps == 0 {
        return "no dependencies"
    }
    return if d.deps == 1 { "1 dependency" } else { d.deps.toString() + " dependencies" }
}

/// `1 artifact`, `2 artifacts` — what the project builds, which is a different
/// question from what it offers.
fn buildLabel(d: Package) -> String {
    let n = artifactsOf(d.slug).length
    return if n == 1 { "1 artifact" } else { n.toString() + " artifacts" }
}
</script>

<template>
<main class="page pkg">
    <!-- The header a package index gives a package (user, off jsr.io): the
         name at reading size with its badge beside it, the sentence, and the
         numbers - not a poster. -->
    <section class="pkghead">
        <p class="eyebrow"><a href="/explore.html">Registry</a></p>
        <div class="pkgtitle">
            <h1>{{ data.name }}</h1>
            <span class="kindpill">{{ data.kind }}</span>
        </div>
        <p class="lede" v-html="data.summary"></p>
        <p class="pkgmeta">{{ unitLabel(data) }} · {{ depLabel(data) }} · <a :href="packageSource(data.slug)">source</a></p>
    </section>

    <section class="band pkgbody">
        <div class="pkgmain">
            <div class="pkgblock" id="api">
                <p class="eyebrow">overview</p>
                <p>The specifier names <code>{{ offerOf(data.slug).path }}</code>. Any other module in the tree takes the same specifier with its own path in it.</p>
            </div>

            <div class="pkgblock" id="builds">
                <p class="eyebrow">what it builds</p>
                <h2>{{ buildLabel(data) }}</h2>
                <div class="scroller">
                <table>
                    <thead>
                        <tr><th scope="col">Artifact</th><th scope="col">Entry</th><th scope="col">Target</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="a in artifactsOf(data.slug)" :key="a.name">
                            <td><code>{{ a.name }}</code></td>
                            <td><code>{{ a.entry }}</code></td>
                            <td><code>{{ a.target }}</code></td>
                        </tr>
                    </tbody>
                </table>
                </div>
                <p class="cap">From <code>{{ data.name }}/vyrn.json</code> — what you get if you clone it rather than depend on it.</p>
            </div>

            <div class="pkgblock" id="deps">
                <p class="eyebrow">what it needs</p>
                <h2>{{ depLabel(data) }}</h2>
                <dl class="specs">
                    <div>
                        <dt>Depends on</dt>
                        <dd class="links">
                            <a v-for="d in packageDeps(data.slug)" :key="d.name" :href="d.href">{{ d.name }}</a>
                            <span class="none" v-if="data.deps == 0">nothing at all</span>
                        </dd>
                    </div>
                </dl>
                <p class="cap">Standard library modules and nothing else. Each arrives with the compiler, so none is a fetch.</p>
            </div>
        </div>

        <aside class="pkgside">
            <div class="regcard">
                <p class="eyebrow">add package</p>
                <div class="cmd" data-copy>
                    <code :data-spec="offerOf(data.slug).spec">{{ addCommand(data.slug) }}</code>
                    <button type="button" data-copy-btn aria-label="Copy it">Copy</button>
                </div>
                <details class="writes">
                    <summary>What the command writes</summary>
                    <p><code>vyrn.json</code> gains the alias your <code>import</code> lines use:</p>
                    <pre class="code">{{ manifestShape(data.slug) }}</pre>
                    <p><code>vyrn.lock</code> gains the pin — the specifier, the immutable URL it resolved to, and the sha256 of the bytes:</p>
                    <div class="scroller">
                    <pre class="code">{{ lockShape(data.slug) }}</pre>
                    </div>
                    <p class="cap"><code>vyrn add</code> writes the commit and the <code>sha256</code>. This page cannot know either.</p>
                </details>
                <p class="cap">The command pins what it fetched. <a href="/tooling/projects.html">Projects and dependencies</a> explains <code>vyrn.json</code> and <code>vyrn.lock</code>.</p>
            </div>
            <div class="regcard">
                <p class="eyebrow">import</p>
                <div class="cmd" data-copy>
                    <code>{{ importFrom(data.slug) }}</code>
                    <button type="button" data-copy-btn aria-label="Copy it">Copy</button>
                </div>
                <p class="cap">The alias is a bare specifier the manifest maps.</p>
            </div>
            <div class="regcard">
                <p class="eyebrow">symbols</p>
                <p class="syms">
                    <code v-for="e in offerOf(data.slug).exports" :key="e">{{ e }}</code>
                </p>
                <p class="cap">{{ unitLabel(data) }}, from <code>{{ offerOf(data.slug).path }}</code>.</p>
            </div>
        </aside>
    </section>
</main>
</template>
