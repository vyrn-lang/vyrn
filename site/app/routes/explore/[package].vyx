<script>
import { Package, Artifact, packageBlurb, packageKnown, packageOf, packageDeps, packageSource, offerOf, addCommand, artifactsOf, packageReadme } from "../../packages"
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
import { pageHeadWith } from "../../nav"
params { package: String }

export fn head(d: Package) -> Head {
    return pageHeadWith(d.name + " — the Vyrn registry", packageBlurb(d))
}

export fn data() -> ParamQuery<Params, Result<Package, PageError>> {
    return paramQuery(fetchPackage)
}

fn fetchPackage(p: Params) -> Result<Package, PageError> {
    if !packageKnown(p.package) {
        return Err(notFound(p.package + " is not a package"))
    }
    return Ok(packageOf(p.package))
}

fn unitLabel(d: Package) -> String {
    return if d.exports == 1 { "1 export" } else { d.exports.toString() + " exports" }
}

fn depLabel(d: Package) -> String {
    if d.deps == 0 {
        return "no dependencies"
    }
    return if d.deps == 1 { "1 dependency" } else { d.deps.toString() + " dependencies" }
}

fn buildLabel(d: Package) -> String {
    let n = artifactsOf(d.slug).length
    return if n == 1 { "1 artifact" } else { n.toString() + " artifacts" }
}
</script>

<template>
<main class="page pkg">
    <section class="pkghead">
        <p class="eyebrow"><a href="/explore.html">Registry</a></p>
        <div class="pkgtitle">
            <h1>{{ data.name }}</h1>
            <span class="kindpill">{{ data.kind }}</span>
        </div>
        <p class="lede">{{ data.summary }}</p>
        <p class="pkgmeta">{{ unitLabel(data) }} · {{ depLabel(data) }} · <a :href="packageSource(data.slug)">source</a></p>
    </section>

    <section class="band pkgbody">
        <div class="pkgmain prose" v-html="packageReadme(data.slug)"></div>

        <aside class="pkgside">
            <div class="regcard">
                <p class="eyebrow">add package</p>
                <div class="cmd" data-copy>
                    <code :data-spec="offerOf(data.slug).spec">{{ addCommand(data.slug) }}</code>
                    <button type="button" data-copy-btn aria-label="Copy it">Copy</button>
                </div>
            </div>
            <div class="regcard">
                <p class="eyebrow">symbols</p>
                <p class="syms">
                    <code v-for="e in offerOf(data.slug).exports" :key="e">{{ e }}</code>
                </p>
                <p class="cap">{{ unitLabel(data) }}, from <code>{{ offerOf(data.slug).path }}</code>.</p>
            </div>
            <div class="regcard" id="builds">
                <p class="eyebrow">{{ buildLabel(data) }}</p>
                <ul class="arts">
                    <li v-for="a in artifactsOf(data.slug)" :key="a.name"><code>{{ a.name }}</code><span>{{ a.entry }}</span><span class="target">{{ a.target }}</span></li>
                </ul>
            </div>
            <div class="regcard" id="deps">
                <p class="eyebrow">{{ depLabel(data) }}</p>
                <p class="syms">
                    <a v-for="d in packageDeps(data.slug)" :key="d.name" :href="d.href">{{ d.name }}</a>
                </p>
            </div>
        </aside>
    </section>
</main>
</template>
