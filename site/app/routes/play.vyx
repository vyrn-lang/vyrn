<script>
// GET /play — the compiler, in the reader's browser.
//
// The front end is compiled to WebAssembly (`compiler/vyrn-play`) and answers
// three questions on this page: where the tokens are, what the diagnostics are,
// and what the program prints. All three come from the same Rust the `vyrn`
// binary is built from, so the page cannot disagree with the compiler.
//
// THE PAGE IS AN EDITOR'S WINDOW (RFC-0106 M5 rounds 3-4, user: "like
// vscode" — and the first cut "wasn't even close", so this one carries the
// frame AND the behaviour that make an editor read as one): an explorer whose
// rows open TABS, each tab keeping its own buffer of edits with a dirty mark
// and a close button; a line-number gutter; Enter that keeps the line's
// indentation; a docked panel whose tabs reflect what the run produced; and a
// filled status bar whose items are the caret position and the editor's
// facts. Every element is real, because a control that does nothing is a
// picture of an editor. What the page has to SAY about itself is four
// sentences on the status bar's (?) — the About section below the window
// went with the footer (user): an editor's window has nothing under it.
//
// EVERYTHING ON THIS PAGE IS MARKUP THE EXPORT WROTE. The examples are Vyrn
// data rendered into hidden `<pre>` blocks, escaped by the template, and
// `play.js` reads them back with `textContent`. Every `data-play-*` element is
// `play.js`'s contract; the frame's own hooks (`data-play-file`,
// `data-play-gutter`, `data-play-lncol`) are queried and silently absent on
// the hero editors.
import { Head } from "std/ui"
import { pageHeadOf } from "../nav"
import { playExamples, Example } from "../play"

export fn head() -> Head {
    return pageHeadOf("/play")
}

fn examples() -> Array<Example> {
    return playExamples()
}
</script>

<template>
<main class="page play ide" data-widget="play">
    <h1 class="sr-only">Playground</h1>

    <!-- One box, because `main.page` is `display: contents` and the shell grid
         owns its children: the editor's window is a grid of its own. -->
    <div class="idewrap">
        <aside class="ideside" aria-label="Files">
            <p class="sidehead">Explorer</p>
            <p class="sidesect">Examples</p>
            <button type="button" class="idefile" v-for="e in examples()" :key="e.id" :data-play-file="e.id" :title="e.title">{{ e.id }}.vyrn</button>
        </aside>

        <div class="idemain">
            <div class="idebar">
                <!-- The open files. `play.js` renders one tab per file the
                     explorer opened, with its dirty mark and its close button —
                     each tab holds its own buffer of edits, exactly as the
                     editor this page resembles does. -->
                <span class="idetabs" data-play-tabs></span>
                <span class="spacer"></span>
                <span class="eyebrow" data-play-status>Loading the compiler…</span>
                <button type="button" class="btn" data-play-reset>Reset</button>
                <button type="button" class="btn" data-play-share>Copy link</button>
                <button type="button" class="btn primary" data-play-run disabled="disabled" title="Ctrl+Enter">Run</button>
            </div>

            <div class="editor" data-play-editor>
                <div class="gutter" data-play-gutter aria-hidden="true"></div>
                <pre class="code hl" aria-hidden="true"><code data-play-hl></code></pre>
                <textarea data-play-src spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" wrap="off" aria-label="Vyrn source"></textarea>
            </div>
        </div>

        <div class="idepanel">
            <!-- The strip reflects the run: Problems appears when the compiler
                 has any (play.js unhides the pane; `:has` reads that), Output
                 is always there. State, not controls. -->
            <div class="paneltabs" aria-hidden="true"><span class="ptab problems">Problems</span><span class="ptab output">Output</span></div>

            <details class="stdinbox" data-play-stdin-box>
                <summary>Standard input</summary>
                <textarea data-play-stdin spellcheck="false" aria-label="Standard input"></textarea>
                <p class="cap">These lines reach <code>readLine()</code>, one per call. At the end of them it answers <code>None</code>, exactly as a pipe does.</p>
            </details>

            <!-- Both panes are what the status says, and running is a button press
                 with no page load behind it — so without a live region a screen
                 reader is told nothing at all about the result (RFC-0105 M4). -->
            <div class="diags" data-play-diags hidden="hidden" aria-live="polite"></div>
            <div class="out" data-play-out aria-live="polite"><span class="dim">Nothing has run yet.</span></div>
        </div>

        <div class="idestatus">
            <span class="idehelp" tabindex="0" role="note" aria-label="About this playground" title="The compiler front end runs in this tab as WebAssembly — the same tree-walking interpreter `vyrn run` uses — and nothing is uploaded. A program is stopped after five seconds, recursion stops near 466 calls (the worker's stack; the compiler's own limit is 1,000), and the tab has no filesystem and no arguments. One file runs, plus std/, which is embedded; a relative import has nowhere to resolve to and says so.">?</span>
            <span class="spacer"></span>
            <span data-play-lncol>Ln 1, Col 1</span>
            <span>Spaces: 2</span>
            <span>UTF-8</span>
            <span>Ctrl+↵ Run</span>
        </div>
    </div>

    <div hidden="hidden" data-play-examples>
        <pre v-for="e in examples()" :key="e.id" :data-play-example="e.id">{{ e.src }}</pre>
        <pre v-for="e in examples()" :key="e.id" :data-play-example-stdin="e.id">{{ e.stdin }}</pre>
    </div>
</main>
</template>
