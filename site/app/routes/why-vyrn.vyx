<script>
// GET /why-vyrn — the one page allowed to be quiet, and the page that carries
// the non-goals.
//
// It was `/philosophy` until RFC-0106 M1. The path moved and NOTHING BELOW THE
// SCRIPT CHANGED: the milestone owns the shell, and M4 owns this page's words.
// `/philosophy.html` is still published, as a stub that points here. One content
// link named this route and nothing outside the site did (RFC-0106 M0), which is
// what made it the one page safe to move.
//
// It was a run of static prose. The claim a reader can actually test is now a
// plate with a control: the capability words, one tab each with the code that
// word produces. The prose around it says the one thing a plate cannot.
//
// The design-record plate left with RFC-0105 M1. Counting the records is an
// argument about how the project works, not about what the language is, and the
// backstage renders every one of them rather than counting them.
//
// The non-goals are the list in README.md's "Not in v1" and RFC-0001's Non-goals
// section, with the reason each one is refused.
import { Head } from "std/ui"
import { pageHeadOf } from "../nav"
import { vyrnHtml } from "../snippets"

/// Something the language refuses, and why.
type NonGoal = { what: String, why: String }

/// One capability word: what it means, the code it produces, and what the
/// compiler stops you doing once you have written it.
type Capability = { id: String, word: String, means: String, refuses: String, html: String }

export fn head() -> Head {
    return pageHeadOf("/why-vyrn")
}

/// An angle bracket written in a template is escaped twice, so the command that
/// contains one is built here instead.
fn whyCommand() -> String {
    return "vyrn why --memory <file>"
}

fn nonGoals() -> Array<NonGoal> {
    return [
        NonGoal { what: "No garbage collector", why: "Collection time is a cost you cannot see in the source. Ownership is declared instead, and memory is reclaimed at a site the compiler can name." },
        NonGoal { what: "No async, no await", why: "Two colours of function split a library in half. The host owns the loop; Vyrn owns the state and the logic." },
        NonGoal { what: "No macros", why: "A generator is ordinary Vyrn that runs at compile time and returns Vyrn source, and <code>vyrn emit-gen</code> prints what it produced. RPC, UI, i18n, OpenAPI and GraphQL are libraries built this way." },
        NonGoal { what: "No higher-kinded types", why: "The cost lands on every error message, paid by every reader, to serve a few abstractions." },
        NonGoal { what: "No inheritance, no metaclasses", why: "A protocol states what a type does. A record states what it holds. Nothing needs a third relationship." },
        NonGoal { what: "No null", why: "Option<T>, Result<T, E>, exhaustive match, and ? propagation. A failure is a value you have to look at." },
    ]
}

fn capabilities() -> Array<Capability> {
    return [
        Capability {
            id: "read",
            word: "read",
            means: "The function looks at the value and does not change it.",
            refuses: "Assigning through the parameter is a compile error, and the caller still owns the value afterwards.",
            html: vyrnHtml("capRead"),
        },
        Capability {
            id: "modify",
            word: "modify",
            means: "The function changes the value in place.",
            refuses: "The caller keeps the value, changed. No second alias to it may exist while the call runs.",
            html: vyrnHtml("capModify"),
        },
        Capability {
            id: "consume",
            word: "consume",
            means: "The function takes ownership.",
            refuses: "Naming the value again after the call is a compile error — that is the whole meaning of the word.",
            html: vyrnHtml("capConsume"),
        },
        Capability {
            id: "share",
            word: "share",
            means: "The value is shared.",
            refuses: "The compiler enforces what sharing permits, rather than trusting a comment that says it is safe.",
            html: vyrnHtml("capShare"),
        },
    ]
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#intent"><span class="n">01</span>intent</a>
        <a href="#rules"><span class="n">02</span>rules</a>
        <a href="#ownership"><span class="n">03</span>ownership</a>
        <a href="#refuses"><span class="n">04</span>refusals</a>
        <a href="#predictable"><span class="n">05</span>predictability</a>
    </aside>
        <section class="hero" id="intent">
            <p class="eyebrow">Philosophy</p>
            <h1 class="display">Intent over mechanism</h1>
            <p class="lede">State what must be true of a value, and let the compiler decide how to keep it true. State what a function does with its argument, and let the compiler decide when the memory goes back.</p>
        </section>

        <section class="band" id="rules">
            <p class="eyebrow">a rule is part of a type</p>
            <h2>The check you cannot forget</h2>
            <p>A validated type carries its <code>where</code> clause everywhere it goes. The compiler rejects what it can prove invalid, erases the check where it can prove validity, and emits it where it can prove neither — which is every boundary a value arrives at. <a href="/play.html">The playground runs one</a>.</p>
        </section>

        <section class="band" id="ownership">
            <p class="eyebrow">ownership is declared</p>
            <h2>Four words, and no lifetime syntax</h2>
            <p>A parameter says what the function intends. Nothing is inferred, so there is nothing to fight.</p>
            <div class="plate" data-tabs>
                <div class="plate-head">
                    <span class="pill">The four words</span>
                    <span class="eyebrow">read, modify, consume, share</span>
                </div>
                <div class="tabs">
                    <button type="button" v-for="c in capabilities()" :key="c.id" :data-tab="c.id">{{ c.word }}</button>
                </div>
                <div class="stage panes">
                    <div v-for="c in capabilities()" :key="c.id" :data-pane="c.id">
                        <p class="lede" style="font-size:1.05rem">{{ c.means }}</p>
                        <pre class="code" v-html="c.html"></pre>
                        <!-- `.refuses` AND NOT `.cap` (RFC-0106 M4). What the
                             compiler stops you doing is the pane's own claim —
                             the whole reason the tab exists — and `.cap` is what
                             the census counts against THE RULE's ceiling of one
                             disclosure per plate. Four panes were four. The
                             plate's real caption is the one under them. -->
                        <p class="refuses">{{ c.refuses }}</p>
                    </div>
                </div>
                <p class="cap">Every pane is coloured by the compiler's own lexer, and the capability word is tinted as the keyword it is in that position.</p>
            </div>
            <p><code>{{ whyCommand() }}</code> names the site each binding is reclaimed at, and the reason when it is not. <a href="/guide/ownership.html">The chapter on ownership walks one.</a></p>
        </section>

        <section class="band" id="refuses">
            <p class="eyebrow">non-goals</p>
            <h2>What Vyrn refuses</h2>
            <p>What a language refuses is the sharpest statement of what it believes.</p>
            <dl class="nongoals">
                <div v-for="g in nonGoals()" :key="g.what">
                    <dt>{{ g.what }}</dt>
                    <dd v-html="g.why"></dd>
                </div>
            </dl>
        </section>

        <section class="band" id="predictable">
            <p class="eyebrow">predictability</p>
            <h2>The same program means the same thing</h2>
            <p>The native binary and the WebAssembly module must agree with the interpreter byte for byte, floating point included. A language whose backends disagree has no meaning, only implementations. <a href="/compare.html#numbers">Every reading is published</a>, and the parity harness fails CI when the bytes disagree.</p>
        </section>
</main>
</template>
