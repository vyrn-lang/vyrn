<script>
// GET /philosophy: a redirect stub to `/why-vyrn`, for bookmarks and search
// results.
//
// A static host has no 301, so a document at the old path is the redirect.
// `site/export.vyrn` stamps its refresh and canonical, which `Head` cannot
// express. The visible link is for a reader whose browser declines the refresh.
import { Head } from "std/ui"
import { pageHead, hrefOf } from "../nav"

export fn head() -> Head {
    return pageHead("Moved to Why Vyrn — Vyrn")
}

/// Where this stub sends a reader; `export.vyrn` reads it for the canonical.
fn target() -> String {
    return hrefOf("/why-vyrn")
}
</script>

<template>
<main class="page">
    <section class="hero">
        <h1 class="display">Page moved</h1>
        <p class="lede">This page moved to <a :href="target()">Why Vyrn</a>.</p>
    </section>
</main>
</template>
