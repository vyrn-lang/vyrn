<script>
// GET /web/[chapter] — one page of the Web area (RFC-0106 M5).
//
// The same shell and the same machinery as a guide chapter: the prose lives in
// `site/app/guide.vyrn` with the rest of the documentation's pages, and a code
// block on this page is a program that ran while the page was built. Only the
// shelf differs — this route answers for the chapters whose `area` is
// "web", and 404s every other slug, so one slug has one page.
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
import { pageHeadWith } from "../../nav"
import { Chapter, Section, chapterArea, chapterBlurb, chapterCount, chapterOf, chapterKnown, chapterNumber, chapterHref, sectionBody, sectionEyebrow } from "../../guide"
import { mdUrl, askClaudeUrl } from "../../pagemd"
import { inlineCode } from "../../code"
import { TreeGroup, Pager, areaTree, pagerFor } from "../../docshell"
import { Icon } from "../../icons"
params { chapter: String }

/// One page, with its number on this shelf.
type ChapterPage = { n: Int64, chapter: Chapter }

export fn head(d: ChapterPage) -> Head {
    return pageHeadWith(d.chapter.title + " — Vyrn docs", chapterBlurb(d.chapter.slug))
}

export fn data() -> ParamQuery<Params, Result<ChapterPage, PageError>> {
    return paramQuery(fetchChapter)
}

fn fetchChapter(p: Params) -> Result<ChapterPage, PageError> {
    if !chapterKnown(p.chapter) || chapterArea(p.chapter) != "web" {
        return Err(notFound(p.chapter + " is not a page of the web area"))
    }
    return Ok(ChapterPage { n: chapterNumber(p.chapter), chapter: chapterOf(p.chapter) })
}

/// The sidebar for this page: this shelf, with this page marked.
fn tree(here: String) -> Array<TreeGroup> {
    return areaTree("web", here)
}

/// The link to one section of this page — a function for the reason the guide's
/// twin gives: `'#'` in Vyrn is a byte.
fn sectionHref(s: Section) -> String {
    return "#" + s.anchor
}

/// How many pages this shelf holds.
fn shelfSize() -> Int64 {
    return chapterCount("web")
}

/// The pages beside this one — FROM THE TREE, not from the chapter chain, so
/// a shelf's hand-listed rows (Tooling ends with Editors) are neighbours too.
fn pager(here: String) -> Pager {
    return pagerFor(tree(here))
}

/// The Open-in-Claude link for this page.
fn claudeHref(slug: String, title: String) -> String {
    return askClaudeUrl(chapterHref(slug), title)
}
</script>

<template>
<main class="page docs">
    <aside class="docstree">
        <details class="treebox">
            <summary>Web</summary>
            <div class="treegroup" v-for="g in tree(data.chapter.slug)" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <div class="crumbrow">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/web.html">Web</a>
            <span>Page {{ data.n }} of {{ shelfSize() }}</span>
        </nav>
        <div class="docutils">
            <a class="btn" :href="mdUrl(chapterHref(data.chapter.slug))" data-copy-md>Copy page</a>
            <details class="pagemenu">
                <summary aria-label="More page actions"><span class="gl">▾</span></summary>
                <div class="acts">
                    <a :href="mdUrl(chapterHref(data.chapter.slug))" data-copy-md><span class="ic"><Icon name="bytesize:clipboard"/></span><span class="t"><span>Copy page</span><span class="d">Markdown, ready to paste into an LLM</span></span></a>
                    <a :href="mdUrl(chapterHref(data.chapter.slug))"><span class="ic"><Icon name="bytesize:file"/></span><span class="t"><span>View as Markdown</span><span class="d">This page as plain text</span></span></a>
                    <a :href="claudeHref(data.chapter.slug, data.chapter.title)" rel="noopener"><span class="ic"><Icon name="bytesize:external"/></span><span class="t"><span>Open in Claude</span><span class="d">Ask Claude about this page</span></span></a>
                </div>
            </details>
        </div>
    </div>

    <section class="hero">
        <h1 class="display">{{ data.chapter.title }}</h1>
        <p class="lede" v-html="inlineCode(data.chapter.lede)"></p>
    </section>

    <section class="band" v-for="s in data.chapter.sections" :key="s.anchor" :id="s.anchor">
        <p class="eyebrow">{{ sectionEyebrow(data.chapter, s) }}</p>
        <h2>{{ s.heading }}</h2>
        <div v-html="sectionBody(s)"></div>
    </section>

    <nav class="pager" aria-label="Pages">
        <a class="prev" v-if="pager(data.chapter.slug).prevHref.byteLength > 0" :href="pager(data.chapter.slug).prevHref"><span class="eyebrow">Previous</span>{{ pager(data.chapter.slug).prevLabel }}</a>
        <a class="next" v-if="pager(data.chapter.slug).nextHref.byteLength > 0" :href="pager(data.chapter.slug).nextHref"><span class="eyebrow">Next</span>{{ pager(data.chapter.slug).nextLabel }}</a>
    </nav>

    <aside class="onpage">
        <p class="eyebrow">On this page</p>
        <a v-for="s in data.chapter.sections" :key="s.anchor" :href="sectionHref(s)">{{ s.heading }}</a>
    </aside>
</main>
</template>
