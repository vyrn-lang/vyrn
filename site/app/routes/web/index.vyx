<script>
// GET /web — the Web area's contents (RFC-0106 M5).
//
// The page list is `areaChapters("web")` — the same run of the one
// chapter table the sidebar, the subnav, the export and the search index read —
// so a page added there appears here with nothing written twice.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Chapter, areaChapters, chapterHref } from "../../guide"
import { inlineCode } from "../../code"
import { TreeGroup, areaTree } from "../../docshell"

export fn head() -> Head {
    return pageHeadOf("/web")
}

/// This shelf's pages.
fn shelf() -> Array<Chapter> {
    return areaChapters("web")
}

/// The sidebar, with nothing marked: the subnav's own row is this landing's
/// marker.
fn tree() -> Array<TreeGroup> {
    return areaTree("web", "index")
}
</script>

<template>
<main class="page docs docpage">
    <aside class="docstree">
        <details class="treebox">
            <summary>Web</summary>
            <div class="treegroup" v-for="g in tree()" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <section class="hero">
        <p class="eyebrow">The web</p>
        <h1 class="display">Build for the browser</h1>
        <p class="lede">Four pages: the view tree, single-file components, routes and RPC, styling and icons. The whole stack is libraries and generators — the compiler has no web feature in it.</p>
    </section>

    <section class="band" id="pages">
        <ul class="modgrid chapters">
            <li v-for="c in shelf()" :key="c.slug">
                <a :href="chapterHref(c.slug)">{{ c.title }}</a>
                <span class="d" v-html="inlineCode(c.lede)"></span>
            </li>
        </ul>
    </section>
</main>
</template>
