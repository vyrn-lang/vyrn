<script>
// GET /docs — one curated entry page that links out.
//
// The guide book and an in-page reference browser both need a Markdown reader,
// and there is no `std/md`. Building one for v1 would be several hundred lines
// of Vyrn to render documentation that already exists and is already generated.
// So v1 links out, and says why. The `/guide` route is reserved in the route
// table with no page behind it, so the book is a directory drop later.
import { Head } from "std/ui"
import { pageHead } from "../nav"
import { stdModules, stdCount, exampleCount, rfcCount } from "../repo"

/// One place to read next.
type Link = { href: String, name: String, what: String }

export fn head() -> Head {
    return pageHead("Docs — Vyrn")
}

fn links() -> Array<Link> {
    return [
        Link { href: "https://github.com/vyrn-lang/vyrn/tree/main/docs/api", name: "Standard library reference", what: "Generated from the source by `vyrn doc`. CI fails if it drifts from the code." },
        Link { href: "https://github.com/vyrn-lang/vyrn/tree/main/examples", name: "Examples", what: "Single-file programs. The parity harness runs every one on all three backends." },
        Link { href: "https://github.com/vyrn-lang/vyrn/tree/main/rfcs", name: "The design record", what: "Every language decision, with the argument that produced it. Start with RFC-0001, RFC-0003 and RFC-0004." },
        Link { href: "https://github.com/vyrn-lang/vyrn/blob/main/README.md", name: "README", what: "What the language is, in one page, with the feature tour." },
        Link { href: "https://github.com/vyrn-lang/vyrn/blob/main/ROADMAP.md", name: "Roadmap", what: "What ships today and what is next, in detail." },
        Link { href: "https://github.com/vyrn-lang/vyrn/tree/main/compiler", name: "Compiler notes", what: "The crate map, the build notes, and how to build the excluded crates." },
    ]
}

/// The commands worth learning, grouped the way the README groups them.
type Command = { name: String, what: String }

fn commands() -> Array<Command> {
    return [
        Command { name: "vyrn run | check | build | test | bench", what: "Run, type-check, compile, and run the tests and benchmarks written in the file." },
        Command { name: "vyrn fmt --check", what: "The canonical formatter. `--check` is the CI gate." },
        Command { name: "vyrn doc", what: "Markdown API docs from `///` comments." },
        Command { name: "vyrn why <file>", what: "Why the compiler decided what it decided. `--memory` and `--contract` narrow it." },
        Command { name: "vyrn emit-gen <file>", what: "The source a generator produced. A generator is not magic, and this prints it." },
        Command { name: "vyrn serve | dev | routes", what: "An HTTP host, the development server, and the resolved wire table." },
        Command { name: "vyrn new | add | update | vendor | deps", what: "Projects and modules. Remote imports pin in `vyrn.lock` and cache by sha256." },
    ]
}
</script>

<template>
<main class="page">
    <aside class="rail">
        <a href="#read"><span class="n">01</span>read</a>
        <a href="#std"><span class="n">02</span>std</a>
        <a href="#cli"><span class="n">03</span>cli</a>
        <a href="#soon"><span class="n">04</span>later</a>
    </aside>
        <section class="hero">
            <p class="eyebrow">Docs</p>
            <h1 class="display">The reference lives in the repository</h1>
            <p class="lede">{{ stdCount() }} standard library modules, {{ exampleCount() }} example programs, {{ rfcCount() }} design records. All of it generated from the source or checked against it, and all of it one link away.</p>
        </section>

        <section class="band" id="read">
            <p class="eyebrow">01 — read</p>
            <h2>Six places to start</h2>
            <ul class="plain">
                <li v-for="l in links()" :key="l.href">
                    <a :href="l.href">{{ l.name }}</a>
                    <span class="note">{{ l.what }}</span>
                </li>
            </ul>
        </section>

        <section class="band" id="std">
            <p class="eyebrow">02 — the standard library</p>
            <h2>{{ stdCount() }} modules, written in Vyrn</h2>
            <p>Not one of them is a compiler feature. RPC, UI, i18n, OpenAPI and GraphQL are libraries built on compile-time generators, and <code>vyrn emit-gen</code> prints the source each one produces.</p>
            <div class="modgrid">
                <span v-for="m in stdModules()" :key="m">std/{{ m }}</span>
            </div>
            <p class="cap" style="margin-top:24px">Listed from std/ while this page was built. Each one has generated API documentation under docs/api/.</p>
        </section>

        <section class="band" id="cli">
            <p class="eyebrow">03 — the driver</p>
            <h2>What <code>vyrn</code> does</h2>
            <div class="scroller">
            <table>
                <thead>
                    <tr><th>Command</th><th>What it does</th></tr>
                </thead>
                <tbody>
                    <tr v-for="c in commands()" :key="c.name">
                        <td><code>{{ c.name }}</code></td>
                        <td>{{ c.what }}</td>
                    </tr>
                </tbody>
            </table>
            </div>
        </section>

        <section class="band" id="soon">
            <p class="eyebrow">04 — later</p>
            <h2>What is not here yet</h2>
            <p>A guide book, and a reference browser over the generated API docs. Both need a Markdown reader in Vyrn, and there is no <code>std/md</code>. Writing one to render documentation that is already generated and already readable would be work for its own sake.</p>
            <p>The route table has room for <code>/guide</code> already, with no page behind it, so the book is a directory drop rather than a navigation rewrite. There is no placeholder page and no dead link — the navigation renders a link only for a route that exists.</p>
        </section>
</main>
</template>
