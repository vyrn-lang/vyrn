<script>
// GET / — the landing page (RFC-0106 M2).
//
// THE RULE, applied. Claims inline, evidence behind one click. One viewport
// carries the claim, a program that RUNS, and the install command; everything
// under it is proof of one of those three and nothing else. The methodology
// that used to sit in a caption under each plate is now a `<details>` or a link,
// and the five narrated sections this page had — a canvas, a diagnostic replay,
// an ownership playhead, a schematic and a digest comparison — are gone. The
// census counted 644 words of prose on this page against a ceiling of 260.
//
// THE HERO EDITOR LOADS ON INTERACTION. `play.js`, `play-wasm.js`, `wasi-min.js`
// and `play.wasm` are the playground, and none of them is fetched by this
// document: `widgets.js` imports them when a reader points at the editor or
// presses Run, which is the difference between a page that WEIGHS a compiler and
// a page that OFFERS one. Without script the same markup is a coloured code
// block with a link to `/play`.
import { Head } from "std/ui"
import { pageHeadOf } from "../nav"
import { vyrnHtml, vyrnSource } from "../snippets"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, releaseDate, releasePre, InstallTarget, installTargets } from "../repo"
import { ArrivalRow, arrivalList } from "../history"
import { heroBars, heroBarsBox, heroBarsGrid, heroBarsPlot, heroBench, barLeft, barRight, barRow, barText, Bar, Grid } from "../chart"
import { envRows } from "../bench"
import { demoSteps, demoVersion, demoRecorded, DemoStep } from "../demo"
import { Icon } from "../icons"

/// The id of the snippet the hero runs. One name, two halves: the coloured
/// lines the page paints and the raw source the textarea holds.
fn heroSnippet() -> String {
    return "runme"
}

export fn head() -> Head {
    return pageHeadOf("/")
}

/// The radio that selects one target's pane, matching the install page's. The
/// two commands themselves live in `../repo` — this hero and `/install` show the
/// same pair, and two copies of a command are two commands.
fn osId(p: InstallTarget) -> String {
    return "os-" + p.id
}

/// The newest tag, or the honest sentence when there is not one.
fn headline() -> String {
    if !hasRelease() {
        return "Not released yet"
    }
    return releaseTag()
}

/// What is published, in one line. `Checksum-verified.` used to sit here and on
/// the install hero: the verification story is a whole section of `/install`,
/// which is where a reader who cares about it is going, and a hero is not where
/// they read it (RFC-0106 M3, third round).
fn standing() -> String {
    if !hasRelease() {
        return "Nothing published yet — build from source."
    }
    let kind = if releasePre() { " as a pre-release." } else { "." }
    return "Published " + releaseDate() + kind
}

/// The design records that arrived after the tag, newest first, capped at three.
/// The releases page carries the whole list; this is the teaser (RFC-0106 M3,
/// third round). Release NOTES are written on GitHub and are not in this
/// repository, so the honest highlight is the record, with the status it holds.
fn highlights() -> Array<ArrivalRow> {
    let all = arrivalList()
    let mut out: Array<ArrivalRow> = []
    let mut i = all.length - 1
    while i >= 0 && out.length < 3 {
        if all[i].date > releaseDate() {
            out.push(ArrivalRow { tag: all[i].tag.copy(), href: all[i].href.copy(), date: all[i].date.copy(), band: all[i].band.copy() })
        }
        i = i - 1
    }
    return out
}

/// The four pillar commands, coloured. They are indexed rather than looped
/// because the cards around them are written out one by one: `<Icon>` is a
/// generation-time provider and `:name` is refused at the tag (RFC-0107 M1), so
/// four cards with four glyphs are four elements.
fn pillarCmd(i: Int64) -> String {
    // SHORT, AND STILL REAL. A card is 280px wide and a command does not wrap
    // (RFC-0106 M3, second round), so a 49-character line would be a 40px
    // window on it. Every one of these runs as written.
    let all = [
        "vyrn check main.vyrn",
        "vyrn why --memory main.vyrn",
        "vyrn build main.vyrn --target wasm",
        "vyrn emit-gen main.vyrn",
    ]
    return shellHtml(all[i])
}
</script>

<template>
<main class="page wide">
        <section class="hero split">
            <div>
                <p class="eyebrow">A systems language</p>
                <h1 class="display">Types carry the <em>rules</em>.<br/>Native speed. No collector.</h1>
                <p class="lede">Write the rule into the type. The compiler proves it, or refuses the value.</p>

                <!-- ONE OS PICKER ON THIS SITE (RFC-0106 M3, second round). This
                     was a second one — underline tabs driven by `tabsWidget` —
                     doing the same job as the install page's with a different
                     shape and a different keyboard model. It is the same three
                     radio buttons now: no script, a native group, and the tiles
                     joined to the command box they select. -->
                <fieldset class="picker">
                    <legend class="sr-only">Operating system</legend>
                    <input class="sr-only" type="radio" name="os" id="os-unix" checked="checked" data-os="unix"/>
                    <input class="sr-only" type="radio" name="os" id="os-windows" data-os="windows"/>
                    <div class="ostabs">
                        <label v-for="p in installTargets()" :key="p.id" :for="osId(p)">{{ p.name }}</label>
                    </div>
                    <div class="ospanes">
                        <div class="ospane" v-for="p in installTargets()" :key="p.id">
                            <div class="cmd" data-copy>
                                <code v-html="shellHtml(p.cmd)"></code>
                                <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <p class="eyebrow"><a href="/install.html">Other ways to install</a></p>

                <ul class="chips">
                    <li>No collector</li>
                    <li>One binary</li>
                    <li>Native and wasm</li>
                    <li>Alpha, no deprecations</li>
                </ul>
            </div>

            <!-- THE RUNNABLE HERO. The `data-play-*` hooks are the playground's
                 own, so this is `mountPlay` on a smaller root and not a second
                 editor: one contract, one keyboard model, one highlighter.
                 `data-widget="playhero"` and not `"play"` is what keeps it lazy
                 — `boot()` mounts the second on sight and arms the first. -->
            <div class="plate play heroplay" data-widget="playhero">
                <div class="plate-head">
                    <span class="pill live">Runs here</span>
                    <span class="eyebrow" data-play-status>Press Run</span>
                    <span class="spacer"></span>
                    <button type="button" class="btn primary" data-play-run>Run</button>
                </div>
                <div class="editor" data-play-editor>
                    <pre class="code hl" aria-hidden="true"><code data-play-hl v-html="vyrnHtml(heroSnippet())"></code></pre>
                    <textarea data-play-src readonly="readonly" rows="15" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" wrap="off" aria-label="Vyrn source, editable after the first press">{{ vyrnSource(heroSnippet()) }}</textarea>
                </div>
                <div class="diags" data-play-diags hidden="hidden" aria-live="polite"></div>
                <div class="out" data-play-out aria-live="polite"><span class="dim">Not run yet.</span></div>
                <noscript><p class="cap">Without script: <a href="/play.html">the playground</a>.</p></noscript>
            </div>
        </section>

        <!-- SPLIT (RFC-0106 M3): the claim and its link on the left, the chart
             on the right. The section is exactly as tall as the chart plus the
             rhythm's padding, which is the geometry rule this milestone asserts
             in the browser rather than eyeballs. -->
        <section class="band split" id="speed">
            <div class="say">
                <p class="eyebrow"><Icon name="bytesize:activity"/> Measured</p>
                <h2>As quick as C</h2>
                <p><code>{{ heroBench() }}</code>, one of eight. Five of the rest are slower than Rust, each with a named cause.</p>
                <p class="ctarow"><a class="cta" href="/compare.html#numbers">All eight, and the causes</a></p>
            </div>
            <div class="plate barstrip" data-widget="bars">
                <div class="stage">
                    <svg class="chart" :viewBox="heroBarsBox()" role="group" aria-label="Five engines running the same numeric kernel, fastest first">
<g class="axis">
                            <line v-for="g in heroBarsGrid()" :key="g.id" :x1="g.x" y1="0" :x2="g.x" :y2="heroBarsPlot()"/>
                            <text v-for="g in heroBarsGrid()" :key="g.id" :x="g.x" :y="heroBarsPlot()" dy="16" text-anchor="middle">{{ g.label }}</text>
                        </g>
                        <g class="row" v-for="b in heroBars()" :key="b.id">
                            <title>{{ b.title }}</title>
                            <rect class="hit" x="0" :y="b.hy" :width="barRight()" :height="barRow()"/>
                            <rect :class="b.tone" :x="barLeft()" :y="b.y" :width="b.w" height="20" fill="currentColor" fill-opacity="0.28"/>
                            <!-- The row NAME is a label and not a link. Every
                                 other bar chart on this site links each row at
                                 its own source, and an `<a>` inside an `<svg>`
                                 has no CSS box for padding to grow — five rows
                                 were five sub-24px targets (RFC-0105 M4 row 29),
                                 all five pointing at the one page the notice
                                 under this plate already names. -->
                            <text x="0" :y="b.y" :dy="barText()">{{ b.label }}</text>
                            <text :x="barRight()" :y="b.y" :dy="barText()" text-anchor="end" class="val">{{ b.value }}</text>
                        </g>
                    </svg>
                </div>
                <details class="disc">
                    <summary>The machine, and the method</summary>
                    <!-- Inside a `.scroller`, like every other wide block on
                         this site: at 375px the environment rows are 769px and
                         a table with no scroller over it takes the document
                         sideways with it (RFC-0105 M4 rows 26 and 28). -->
                    <div class="scroller">
                        <table class="matrix">
                            <tr v-for="r in envRows()" :key="r[0]"><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td></tr>
                        </table>
                    </div>
                </details>
            </div>
        </section>

        <section class="band" id="what">
            <p class="eyebrow">Four ideas</p>
            <!-- FOUR CARDS, WRITTEN OUT. A `v-for` cannot carry `<Icon>`: a
                 provider tag takes static attributes and `:name` binds an
                 expression, which RFC-0107 M1 refuses at the tag. Four cards
                 that differ in every field are four cards. -->
            <ul class="cards">
                <li>
                    <h3><Icon name="bytesize:checkmark"/> Types carry rules</h3>
                    <p>A check you cannot forget to write.</p>
                    <div class="cmd" data-copy><code v-html="pillarCmd(0)"></code><button type="button" data-copy-btn aria-label="Copy the check command">Copy</button></div>
                </li>
                <li>
                    <h3><Icon name="bytesize:lock"/> Ownership is a word</h3>
                    <p><code>read</code>, <code>modify</code>, <code>consume</code>, <code>share</code>. No lifetimes.</p>
                    <div class="cmd" data-copy><code v-html="pillarCmd(1)"></code><button type="button" data-copy-btn aria-label="Copy the memory command">Copy</button></div>
                </li>
                <li>
                    <h3><Icon name="bytesize:lightning"/> One program, three engines</h3>
                    <p>CI fails unless all three agree, byte for byte.</p>
                    <div class="cmd" data-copy><code v-html="pillarCmd(2)"></code><button type="button" data-copy-btn aria-label="Copy the build command">Copy</button></div>
                </li>
                <li>
                    <h3><Icon name="bytesize:code"/> Generators are libraries</h3>
                    <p>It runs while you compile and emits Vyrn.</p>
                    <div class="cmd" data-copy><code v-html="pillarCmd(3)"></code><button type="button" data-copy-btn aria-label="Copy the emit-gen command">Copy</button></div>
                </li>
            </ul>
        </section>

        <section class="band" id="minute">
            <p class="eyebrow"><Icon name="bytesize:play"/> A minute with Vyrn</p>
            <!-- Every line of output below came out of the real binary, recorded
                 by `scripts/site-demo.py` before this page was rendered. Without
                 script all seven steps are on the page at once. -->
            <div class="plate demo" data-widget="demo">
                <ol class="steps">
                    <li v-for="s in demoSteps()" :key="s.id" :data-step="s.id">
                        <h3>{{ s.title }}</h3>
                        <div class="cmd" v-if="s.cmd.byteLength > 0"><code v-html="shellHtml(s.cmd)"></code></div>
                        <pre class="out">{{ s.out }}</pre>
                        <p>{{ s.note }}</p>
                    </li>
                </ol>
                <p class="eyebrow">Recorded by running <code>{{ demoVersion() }}</code> on <code>{{ demoRecorded() }}</code>.</p>
            </div>
        </section>

        <!-- LATEST RELEASE (RFC-0106 M3, third round). `Releases` left the
             masthead — four names a reader knows beats five, and a changelog is
             not what anybody navigates to before they have installed anything —
             so the page arrives HERE instead, where a reader who has just read
             the install command is standing. It is the good half of a blog for a
             project that has no blog, and every line of it is computed: the tag
             and the date are baked, and the highlights are the design records
             that arrived after the tag, with the status each holds today.
             The section it replaced was a heading and three buttons repeating
             three links already on the page. -->
        <section class="band split" id="release">
            <div class="say">
                <p class="eyebrow">Latest release</p>
                <h2>{{ headline() }}</h2>
                <p>{{ standing() }}</p>
                <!-- One word, and it is the page's own name. The index's word
                     budget is 260 and this section put it at 261. -->
                <p class="ctarow"><a class="cta" href="/releases.html">Releases</a></p>
            </div>
            <ul class="plain">
                <li v-for="r in highlights()" :key="r.tag"><strong><a :href="r.href">{{ r.tag }}</a></strong><span>{{ r.band }}</span></li>
            </ul>
        </section>
</main>
</template>
