<script>
import { Head } from "std/ui"
import { pageHeadOf } from "../nav"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, InstallTarget, installTargets } from "../repo"
import { Markup } from "std/html"
import { vyrnLine } from "../snippets"

export fn head() -> Head {
    return pageHeadOf("/")
}

fn osId(p: InstallTarget) -> String {
    return "os-" + p.id
}

fn props(n: Int64) -> Markup {
    return vyrnLine("cardProps", n)
}

fn fx(n: Int64) -> Markup {
    return vyrnLine("cardEffects", n)
}

fn own(n: Int64) -> Markup {
    return vyrnLine("cardOwn", n)
}

fn installLabel() -> String {
    if !hasRelease() {
        return "Install Vyrn"
    }
    return "Install Vyrn " + releaseTag()
}
</script>

<template>
<!-- `vortex.js` draws the water behind these panels and pages them; without WebGL2 they stay one stacked page. -->
<main class="page vx" data-widget="vortex">
    <section class="vx-panel vx-hero" data-panel="Rules">
        <div>
            <h1 class="vx-title">Vyrn</h1>
            <p class="vx-lede vx-big">Write <span class="vx-rulew">the rule</span>.<br/>The compiler <span class="vx-w vx-p" data-vx="proves">proves it</span>, <span class="vx-w vx-c" data-vx="checks">checks it</span>,<br/><span class="vx-w vx-x" data-vx="refuses">or tells you why not.</span></p>
            <p class="vx-note">A systems language with no garbage collector. It compiles to native code and WebAssembly.</p>
            <div class="vx-cta"><a class="vx-btn" href="/install.html">Install</a><a class="vx-btn ghost" href="/play.html">Try it</a></div>
        </div>
    </section>

    <section class="vx-panel" data-panel="Properties">
        <div>
            <p class="vx-eyebrow">Facts on results</p>
            <h2 class="vx-h">A result carries what is true of it.</h2>
            <p class="vx-lede"><em>sort</em> makes xs <em>sorted(byAge)</em>. <em>binarySearch</em> needs that fact, and the compiler checks it before anything runs. Every other line keeps it, turns it, or drops it.</p>
        </div>
        <div class="vx-code">
            <div class="vx-head"><span>ages.vyrn</span><span data-vx="props-state">proved</span></div>
            <div class="vx-line" v-html="props(0)"></div>
            <div class="vx-line vx-op" data-g="p" data-op="sort" v-html="props(1)"></div>
            <div class="vx-line vx-op" data-g="p" data-op="reverse" v-html="props(2)"></div>
            <div class="vx-line vx-op" data-g="p" data-op="filter" v-html="props(3)"></div>
            <div class="vx-line vx-op" data-g="p" data-op="map" v-html="props(4)"></div>
            <div class="vx-line vx-op" data-g="p" data-op="push" v-html="props(5)"></div>
            <div class="vx-line" v-html="props(6)"></div>
            <div class="vx-line c vx-js">// click a line to add or remove it</div>
            <p class="vx-diag" data-vx="props-diag" aria-live="polite"></p>
        </div>
    </section>

    <section class="vx-panel" data-panel="Effects">
        <div>
            <p class="vx-eyebrow">Effects</p>
            <h2 class="vx-h">Every function says what it touches.</h2>
            <p class="vx-lede">A pure function keeps everything inside the seal. <em>print</em> leaps over it to stdout; a write to <em>count</em> runs out to its buoy. <em>A gen fn must stay sealed.</em></p>
        </div>
        <div class="vx-code">
            <div class="vx-head"><span>table.vyrn</span><span data-vx="fx-state">pure</span></div>
            <div class="vx-line"><span class="vx-op" data-g="e" data-op="gen"><span class="k">gen</span> </span><span v-html="fx(0)"></span></div>
            <div class="vx-line" v-html="fx(1)"></div>
            <div class="vx-line vx-op" data-g="e" data-op="print" v-html="fx(2)"></div>
            <div class="vx-line vx-op" data-g="e" data-op="state" v-html="fx(3)"></div>
            <div class="vx-line" v-html="fx(4)"></div>
            <div class="vx-line" v-html="fx(5)"></div>
            <div class="vx-line c vx-js">// click gen, print or count</div>
            <p class="vx-diag" data-vx="fx-diag" aria-live="polite"></p>
        </div>
    </section>

    <section class="vx-panel" data-panel="Ownership">
        <div>
            <p class="vx-eyebrow">No collector</p>
            <h2 class="vx-h">Every value sinks once, at a point known before the run.</h2>
            <p class="vx-lede">Nothing piles up and nothing is swept. Press run and watch the pool drain: <em>allocations equal frees.</em></p>
        </div>
        <div class="vx-code">
            <div class="vx-head"><span>main.vyrn</span><span data-vx="own-state">ready</span></div>
            <div class="vx-line" v-html="own(0)"></div>
            <div class="vx-line" v-html="own(1)"></div>
            <div class="vx-line" v-html="own(2)"></div>
            <div class="vx-line" v-html="own(3)"></div>
            <div class="vx-line" v-html="own(4)"></div>
            <div class="vx-stat vx-js"><span><b>90,000</b>allocated</span><span><b data-vx="freed">0</b>released</span></div>
            <div class="vx-cta vx-js"><button type="button" class="vx-btn" data-vx="run">Run</button><button type="button" class="vx-btn ghost" data-vx="refill">Refill</button></div>
        </div>
    </section>

    <section class="vx-panel" data-panel="Install">
        <div>
            <p class="vx-eyebrow">Still water</p>
            <h2 class="vx-h">Write the rule. Let the compiler carry it.</h2>
            <p class="vx-note">{{ installLabel() }}</p>
            <fieldset class="picker vx-picker">
                <legend class="sr-only">Operating system</legend>
                <input class="sr-only" type="radio" name="os" id="os-unix" checked="checked" data-os="unix"/>
                <input class="sr-only" type="radio" name="os" id="os-windows" data-os="windows"/>
                <div class="ospanes">
                    <div class="ospane" v-for="p in installTargets()" :key="p.id">
                        <div class="cmd" data-copy>
                            <code v-html="shellHtml(p.cmd)"></code>
                            <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                        </div>
                    </div>
                </div>
                <div class="tabrow">
                    <div class="ostabs">
                        <label v-for="p in installTargets()" :key="p.id" :for="osId(p)">{{ p.name }}</label>
                    </div>
                    <a class="tablink" href="/install.html">Other ways to install</a>
                </div>
            </fieldset>
            <div class="vx-cta"><a class="vx-btn" href="/guide.html">Read the guide</a><a class="vx-btn ghost" href="/play.html">Open the playground</a><a class="vx-btn ghost" href="/benchmarks.html">Benchmarks</a></div>
        </div>
    </section>
</main>
</template>
