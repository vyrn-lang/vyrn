<script>
// GET /: the landing page. The first viewport holds the claim, a program
// that runs, and the install command; every section under it backs one of
// those three.
//
// The hero editor loads on interaction: `widgets.js` imports the playground's
// scripts and `play.wasm` when a reader points at the editor or presses Run.
// Without script the same markup is a coloured code block with a link to
// `/play`.
import { Head } from "std/ui"
import { pageHeadOf, hrefOf } from "../nav"
import { vyrnHtml, vyrnSource } from "../snippets"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, releaseDate, releasePre, InstallTarget, installTargets, stdCount } from "../repo"
// The showcase's programs are files in `site/guide/`, compiled and run by the
// guide and tested in CI. Import them through `../guide`, never by calling
// `guideCode` here: the generator's cache keys on its argument string, so a
// second spelling of the directory generates a second module, and its exports
// collide with the first.
import { blockOf, chapterOfBlock, sectionOfBlock, chapterHref } from "../guide"
import { ApiGroup, ApiModule, apiGroups, apiHref } from "../docs"
import { joinWith } from "std/strings"
import { frontPanels, panelBars, panelNote, panelSpeed, panelMemLine, benchMachine, benchRuns } from "../bench"
import { demoSteps, demoVersion, demoRecorded, DemoStep } from "../demo"
import { shellOutHtml } from "../code"
// The demo steps whose output is a file, coloured by the compiler's lexer at
// compile time.
import { demoCode } from "../demohl"
import { demoHl } from demoCode("../../data/demo.json")

/// The id of the snippet the hero runs. One name, two halves: the coloured
/// lines the page paints and the raw source the textarea holds.
fn heroSnippet() -> String {
    return "runme"
}

export fn head() -> Head {
    return pageHeadOf("/")
}

/// The radio that selects one target's pane, as on `/install`.
fn osId(p: InstallTarget) -> String {
    return "os-" + p.id
}

/// The newest tag, or a sentence saying there is none.
fn headline() -> String {
    if !hasRelease() {
        return "Not released yet"
    }
    return releaseTag()
}

/// What is published, in one line.
fn standing() -> String {
    if !hasRelease() {
        return "Nothing is published. Build from source."
    }
    let kind = if releasePre() { " as a pre-release." } else { "." }
    return "Published " + releaseDate() + kind
}

/// One tab of the showcase: the program in `site/guide/` it shows, the word on
/// the tab, and the line that says what to look at.
///
/// The programs are picked to be close in length, so switching a tab does not
/// resize the section under the cursor. `protocols` is left out at 31 lines,
/// and `std/stream` has no chapter program.
type Tab = { id: String, label: String, block: String, caption: String }

fn tabs() -> Array<Tab> {
    return [
        Tab { id: "types", label: "Validated types", block: "validated", caption: "The rule is part of the type, and the compiler proves what it can." },
        Tab { id: "own", label: "Ownership", block: "regions", caption: "read, modify and consume are written on the parameter. There are no lifetimes." },
        Tab { id: "records", label: "Records and enums", block: "records", caption: "A record is a shape and an enum is a choice. There is no inheritance." },
        Tab { id: "html", label: "Views", block: "html", caption: "The server renders the tree; the browser gets the same one." },
        Tab { id: "gen", label: "Generators", block: "genuse", caption: "A generator runs at compile time and returns Vyrn source." },
        Tab { id: "bench", label: "bench blocks", block: "benches", caption: "A bench block is a body the timer runs, beside the code it is about." },
    ]
}

/// The chapter section that holds this panel's program.
fn tabDocs(t: Tab) -> String {
    let slug = chapterOfBlock(t.block)
    if slug.byteLength == 0 {
        return hrefOf("/guide")
    }
    return chapterHref(slug) + "#" + sectionOfBlock(t.block)
}

/// The radio that selects one tab's pane, matching the install page's picker.
fn tabId(t: Tab) -> String {
    return "tab-" + t.id
}

/// One tab's program, coloured by the compiler's lexer at generation time.
fn tabCode(t: Tab) -> String {
    return joinWith(blockOf(t.block).lines, "\n")
}

/// Where that program opens in the playground, or empty when it is not a whole
/// program (`genuse` imports a sibling file). The template writes no link for
/// empty: `site/export.vyrn` fails the build on an `href=""`.
fn tabPlay(t: Tab) -> String {
    return blockOf(t.block).play
}

/// The program's file in the repository.
fn tabFile(t: Tab) -> String {
    return blockOf(t.block).source
}

fn tabPath(t: Tab) -> String {
    return "site/guide/" + t.block + ".vyrn"
}

/// The standard library teaser: the two modules with the most exports in each
/// group, in the reference's order, so no one maintains the list.
fn teaserGroups() -> Array<ApiGroup> {
    let mut out: Array<ApiGroup> = []
    for g in apiGroups() {
        // The two biggest of the group: seed with the first two, then let any
        // bigger module displace the smaller of the pair.
        let mut top: Array<ApiModule> = []
        for m in g.modules {
            if top.length < 2 {
                top.push(ApiModule { name: m.name.copy(), summary: "", count: m.count })
            } else {
                let least = if top[1].count < top[0].count { 1 } else { 0 }
                if m.count > top[least].count {
                    top[least] = ApiModule { name: m.name.copy(), summary: "", count: m.count }
                }
            }
        }
        out.push(ApiGroup { name: g.name.copy(), modules: top.copy(), icon: g.icon.copy() })
    }
    return out
}

/// The reference page, and how many modules are on it.
fn allModules() -> String {
    return "All " + stdCount().toString() + " modules"
}

/// One step's terminal body: the compiler's own colours when the step printed
/// a file, the shell's three voices when it printed a transcript.
fn stepHtml(s: DemoStep) -> String {
    let source = demoHl(s.id)
    if source.byteLength > 0 {
        return source
    }
    return shellOutHtml(s.cmd, s.out)
}

/// The width of one engine's bar, as the percentage the record measured.
fn barStyle(pct: String) -> String {
    return "width: " + pct + "%"
}
</script>

<template>
<main class="page wide">
        <section class="hero split">
            <div>
                <h1 class="display">Vyrn</h1>
                <p class="lede">A systems language that compiles to native code and WebAssembly, with no garbage collector. A type carries its rules: the compiler proves a value valid, refuses it, or checks it where it arrives.</p>

                <!-- The same scriptless OS picker as `/install`: the command
                     first, the version above it, the radio labels under it. -->
                <p class="cmdlabel" v-if="hasRelease()">Install Vyrn <a href="/releases.html">{{ releaseTag() }}</a></p>
                <p class="cmdlabel" v-else>Install Vyrn</p>
                <fieldset class="picker">
                    <legend class="sr-only">Operating system</legend>
                    <input class="sr-only" type="radio" name="os" id="os-unix" checked="checked" data-os="unix"/>
                    <input class="sr-only" type="radio" name="os" id="os-windows" data-os="windows"/>
                    <div class="ospanes">
                        <div class="ospane" v-for="p in installTargets()" :key="p.id">
                            <div class="cmd" data-copy>
                                <code v-html="shellHtml(p.cmd)"></code>
                                <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                            </div>
                        </div>
                    </div>
                    <div class="tabrow">
                        <div class="ostabs">
                            <label v-for="p in installTargets()" :key="p.id" :for="osId(p)">{{ p.name }}</label>
                        </div>
                        <a class="tablink" href="/install.html">Other ways to install</a>
                    </div>
                </fieldset>
            </div>

            <!-- The playground's own `data-play-*` hooks on a smaller root.
                 `data-widget="playhero"`, not `"play"`, keeps it lazy: `boot()`
                 mounts `play` on sight and only arms `playhero`. -->
            <div class="plate play heroplay" data-widget="playhero">
                <!-- `data-play-status` shows the run state. `Reset` is
                     `[data-js]`-gated: with no script the textarea is
                     read-only. -->
                <div class="plate-head">
                    <span class="eyebrow" data-play-status>Ready</span>
                    <span class="spacer"></span>
                    <button type="button" class="btn jsonly" data-play-reset>Reset</button>
                    <button type="button" class="btn primary" data-play-run title="Ctrl+Enter">Run</button>
                </div>
                <div class="editor" data-play-editor>
                    <pre class="code hl" aria-hidden="true"><code data-play-hl v-html="vyrnHtml(heroSnippet())"></code></pre>
                    <textarea data-play-src readonly="readonly" rows="15" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" wrap="off" aria-label="Vyrn source, editable after the first press">{{ vyrnSource(heroSnippet()) }}</textarea>
                </div>
                <div class="diags" data-play-diags hidden="hidden" aria-live="polite"></div>
                <div class="out" data-play-out aria-live="polite"><span class="dim">Not run yet.</span></div>
                <noscript><p class="cap">Without script: <a href="/play.html">the playground</a>.</p></noscript>
            </div>
        </section>

        <!-- One card per benchmark program, each on its own scale, so a
             400ms program and a 3s one are both readable. -->
        <section class="band" id="speed">
            <div class="benchhead">
                <h2 class="display">Benchmarks</h2>
                <p class="lede">Benchmarks Game programs in Vyrn, C, Rust and JavaScript on node, with Vyrn's WebAssembly build beside them. A card where Vyrn is slower names the cause.</p>
                <p class="ctarow"><a class="cta" href="/benchmarks.html">The benchmarks page</a></p>
            </div>

            <div class="benchgrid">
                <article class="benchcard" v-for="p in frontPanels()" :key="p.key">
                    <h3>{{ p.name }}<span class="size">{{ p.n }}</span></h3>
                    <p class="what">{{ panelNote(p.key) }}</p>
                    <ul class="bars">
                        <li v-for="b in panelBars(p.key)" :key="b.key" :data-tone="b.tone">
                            <span class="who">{{ b.name }}</span>
                            <span class="track"><span class="fill" :style="barStyle(b.pct)"></span></span>
                            <span class="ms">{{ b.ms }}</span>
                        </li>
                    </ul>
                    <p class="bfoot">
                        <span class="bspeed">{{ panelSpeed(p.key) }}</span>
                        <span class="bram">RAM {{ panelMemLine(p.key) }}</span>
                    </p>
                    <p class="bcause" v-if="p.label.byteLength > 0">{{ p.label }}</p>
                </article>
            </div>

            <p class="cap benchcap">{{ benchMachine() }} · medians of {{ benchRuns() }} · every engine at its own defaults · <a href="/benchmarks.html">every program, the table and the radar</a></p>
        </section>

        <!-- The showcase: a reader picks an idea and its program answers.
             Scriptless, like the install picker: radios and `:checked ~`. The
             inputs are written out because only the first carries `checked`,
             and `v-for` cannot put an attribute on one iteration. -->
        <section class="band" id="ideas">
            <div class="showhead">
                <h2 class="display">Examples</h2>
                <p class="lede">Each panel is a program from the guide, with a link to the chapter that teaches it.</p>
            </div>
            <fieldset class="picker showcase">
                <legend class="sr-only">Language feature</legend>
                <input class="sr-only" type="radio" name="tab" id="tab-types" checked="checked"/>
                <input class="sr-only" type="radio" name="tab" id="tab-own"/>
                <input class="sr-only" type="radio" name="tab" id="tab-records"/>
                <input class="sr-only" type="radio" name="tab" id="tab-html"/>
                <input class="sr-only" type="radio" name="tab" id="tab-gen"/>
                <input class="sr-only" type="radio" name="tab" id="tab-bench"/>
                <div class="showgrid">
                    <div class="showlist">
                        <label v-for="t in tabs()" :key="t.id" :for="tabId(t)">{{ t.label }}</label>
                    </div>
                    <div class="showpanes">
                        <div class="showpane" v-for="t in tabs()" :key="t.id">
                            <div class="showbar">
                                <span class="what">{{ t.caption }}</span>
                                <a class="docs" :href="tabDocs(t)">Docs →</a>
                            </div>
                            <p class="file">{{ tabPath(t) }}</p>
                            <pre class="code"><code v-html="tabCode(t)"></code></pre>
                            <p class="cap"><a :href="tabFile(t)">The file in the repository</a><span v-if="tabPlay(t).byteLength > 0"> · <a :href="tabPlay(t)">Run it in the playground</a></span></p>
                        </div>
                    </div>
                </div>
            </fieldset>
        </section>
        <!-- The reference, teased: module names and export counts from the
             generator the reference landing reads. -->
        <section class="band split" id="std">
            <div class="say">
                <h2>Standard library</h2>
                <p>Every module is written in Vyrn and compiles under the same rules as any other program.</p>
                <p class="ctarow"><a class="cta" href="/docs.html">{{ allModules() }}</a></p>
            </div>
            <ul class="modteaser">
                <li v-for="g in teaserGroups()" :key="g.name">
                    <p class="eyebrow">{{ g.name }}</p>
                    <a v-for="m in g.modules" :key="m.name" :href="apiHref(m.name)"><code>std/{{ m.name }}</code> <span>{{ m.count }}</span></a>
                </li>
            </ul>
        </section>

        <section class="band" id="minute">
            <div class="minutehead">
                <h2 class="display">Workflow</h2>
                <p class="lede">The steps create, run, edit, test and build a project with one binary. Each step shows its command and the output it printed.</p>
            </div>
            <!-- Every line of output was recorded from the real binary by
                 `scripts/site-demo.py`. The steps and their outputs are two
                 sibling lists with one index; `widgets.js` marks the nth row
                 and the nth pane, and with no script every pane shows. -->
            <div class="demo" data-widget="demo">
                <ol class="steps">
                    <li v-for="s in demoSteps()" :key="s.id" :data-step="s.id">
                        <h3>{{ s.title }}</h3>
                        <div class="cmd" v-if="s.cmd.byteLength > 0"><code v-html="shellHtml(s.cmd)"></code></div>
                        <p class="stepnote">{{ s.note }}</p>
                        <span class="tick" aria-hidden="true"></span>
                    </li>
                </ol>
                <!-- A terminal: a title bar with the path and the step number. -->
                <div class="term">
                    <div class="termbar" aria-hidden="true">
                        <span class="lights"><i></i><i></i><i></i></span>
                        <span class="where">~/demo — vyrn</span>
                        <span class="counter" data-demo-count></span>
                    </div>
                    <div class="panes">
                        <div class="pane" v-for="s in demoSteps()" :key="s.id" :data-pane="s.id">
                            <pre class="out" v-html="stepHtml(s)"></pre>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Below the card, not inside it: inside the plate it overlaps the
                 last step's row. -->
            <p class="cap minutecap">Recorded by running <code>{{ demoVersion() }}</code> on <code>{{ demoRecorded() }}</code>. Hover to pause.</p>
        </section>

        <!-- The latest release. The masthead has no `Releases` link, so the
             changelog is reached from here. The tag and the date are baked. -->
        <section class="band" id="release">
            <div class="say">
                <p class="eyebrow">Latest release</p>
                <h2>{{ headline() }}</h2>
                <p>{{ standing() }}</p>
                <p class="ctarow"><a class="cta" href="/releases.html">Releases</a></p>
            </div>
        </section>
</main>
</template>
