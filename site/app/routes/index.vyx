<script>
// GET / — the landing page (RFC-0106 M2).
//
// THE RULE, applied. Claims inline, evidence behind one click. One viewport
// carries the claim, a program that RUNS, and the install command; everything
// under it is proof of one of those three and nothing else. The methodology
// that used to sit in a caption under each plate is now a `<details>` or a link,
// and the five narrated sections this page had — a canvas, a diagnostic replay,
// an ownership playhead, a schematic and a digest comparison — are gone. The
// census counted 644 words of prose on this page against a ceiling of 260.
//
// THE HERO EDITOR LOADS ON INTERACTION. `play.js`, `play-wasm.js`, `wasi-min.js`
// and `play.wasm` are the playground, and none of them is fetched by this
// document: `widgets.js` imports them when a reader points at the editor or
// presses Run, which is the difference between a page that WEIGHS a compiler and
// a page that OFFERS one. Without script the same markup is a coloured code
// block with a link to `/play`.
import { Head } from "std/ui"
import { pageHeadOf, hrefOf } from "../nav"
import { vyrnHtml, vyrnSource } from "../snippets"
import { shellHtml } from "../code"
import { hasRelease, releaseTag, releaseDate, releasePre, InstallTarget, installTargets, stdCount } from "../repo"
// THE SHOWCASE READS THE BOOK'S OWN PROGRAMS (RFC-0106 M3, fourth round). Every
// snippet in these tabs is a FILE in `site/guide/`, which means it is compiled
// while this page renders, run by `/guide` while that page renders, and checked
// by `vyrn test site/guide/*.vyrn` in CI. There is no snippet literal on this
// page and none in `hl.vyrn` for it: a showcase of code that does not compile is
// the fabrication this RFC's design section rules out by name.
//
// It imports `../guide` rather than calling `guideCode` itself, and that is
// load-bearing: the generator's cache is keyed on its argument string, so a
// second call site naming the directory with a different `../` prefix would
// generate a second module whose exports collide with the first program-wide.
import { Block, blockOf, chapterOfBlock, sectionOfBlock, chapterHref } from "../guide"
// The reference's own module list, from the same generator the reference page
// reads. Nine names on this page and thirty-eight on that one, and neither list
// is typed by hand.
import { ApiGroup, ApiModule, apiGroups, apiHref } from "../docs"
import { joinWith } from "std/strings"
import { heroBars, heroBarsBox, heroBarsGrid, heroBarsPlot, heroBench, barLeft, barRight, barRow, barText, Bar, Grid } from "../chart"
import { envRows, frontPanels, panelBars, panelNote, panelSpeed, panelMemLine, benchMachine, benchRuns, Panel, BarRow } from "../bench"
import { demoSteps, demoVersion, demoRecorded, DemoStep } from "../demo"
import { shellOutHtml } from "../code"
// The two steps whose output is a FILE arrive already coloured by the
// compiler's own lexer (`demohl.vyrn` runs it at compile time); the rest are
// transcripts, which `shellOutHtml` speaks.
import { demoCode } from "../demohl"
import { demoHl } from demoCode("../../data/demo.json")
import { Icon } from "../icons"

/// The id of the snippet the hero runs. One name, two halves: the coloured
/// lines the page paints and the raw source the textarea holds.
fn heroSnippet() -> String {
    return "runme"
}

export fn head() -> Head {
    return pageHeadOf("/")
}

/// The radio that selects one target's pane, matching the install page's. The
/// two commands themselves live in `../repo` — this hero and `/install` show the
/// same pair, and two copies of a command are two commands.
fn osId(p: InstallTarget) -> String {
    return "os-" + p.id
}

/// The newest tag, or the honest sentence when there is not one.
fn headline() -> String {
    if !hasRelease() {
        return "Not released yet"
    }
    return releaseTag()
}

/// What is published, in one line. `Checksum-verified.` used to sit here and on
/// the install hero: the verification story is a whole section of `/install`,
/// which is where a reader who cares about it is going, and a hero is not where
/// they read it (RFC-0106 M3, third round).
fn standing() -> String {
    if !hasRelease() {
        return "Nothing published yet — build from source."
    }
    let kind = if releasePre() { " as a pre-release." } else { "." }
    return "Published " + releaseDate() + kind
}

/// One tab of the showcase: the file in `site/guide/` it shows, the word on the
/// tab, and the one line that says what to look at.
///
/// FIVE OF THE BOOK'S TWENTY-FIVE PROGRAMS, and the choice is the only editorial
/// line here. They are picked to be a language feature, a data shape, a standard
/// library the reader would reach for, the compile-time story and the tooling —
/// and to be within nine lines of each other in length, so switching a tab does
/// not resize the section under the reader's cursor.
///
/// TWO THINGS THE BRIEF ASKED FOR THAT ARE NOT HERE, both because the tree does
/// not hold them: `std/stream` has no chapter program yet, and `protocols` is 31
/// lines against this set's 10 to 19. Writing a snippet for either would have
/// made it the one block on the page that nothing compiles.
type Tab = { id: String, label: String, block: String, caption: String }

fn tabs() -> Array<Tab> {
    return [
        Tab { id: "types", label: "Types carry rules", block: "validated", caption: "The rule is part of the type, and the compiler proves what it can." },
        Tab { id: "own", label: "Ownership is a word", block: "regions", caption: "read, modify, consume, share — written on the parameter, and no lifetimes." },
        Tab { id: "records", label: "Records and enums", block: "records", caption: "A shape, a choice, and no inheritance." },
        Tab { id: "html", label: "A view is a function", block: "html", caption: "The server renders the tree; the browser gets the same one." },
        Tab { id: "gen", label: "Generators are libraries", block: "genuse", caption: "It runs while you compile, and emits Vyrn." },
        Tab { id: "bench", label: "The timer is in the language", block: "benches", caption: "A bench block is a body the timer runs, beside the code it is about." },
    ]
}

/// The chapter that teaches this panel's idea — the block's own chapter, so a
/// program moved between chapters takes its link with it.
fn tabDocs(t: Tab) -> String {
    let slug = chapterOfBlock(t.block)
    if slug.byteLength == 0 {
        return hrefOf("/guide")
    }
    return chapterHref(slug) + "#" + sectionOfBlock(t.block)
}

/// The radio that selects one tab's pane, matching the install page's picker.
fn tabId(t: Tab) -> String {
    return "tab-" + t.id
}

/// One tab's program, coloured by the compiler's own lexer at generation time.
fn tabCode(t: Tab) -> String {
    return joinWith(blockOf(t.block).lines, "\n")
}

/// Where that program opens in the playground, or NOTHING when it is not a whole
/// program on its own — `genuse` imports its generator from a sibling file, and
/// the playground takes one source. The template asks whether this is empty
/// before it writes the link, because an `href=""` is a link that silently
/// reloads the page a reader is on, and `site/export.vyrn` fails the build over
/// one. It did, on the first export of this section.
fn tabPlay(t: Tab) -> String {
    return blockOf(t.block).play
}

/// The file itself, in the repository. The claim this section makes is that the
/// code is real, and this is the link that lets a reader check it.
fn tabFile(t: Tab) -> String {
    return blockOf(t.block).source
}

fn tabPath(t: Tab) -> String {
    return "site/guide/" + t.block + ".vyrn"
}

/// The standard library teaser: the two biggest modules of each named group,
/// eight in all, in the reference's own order.
///
/// BIGGEST BY EXPORT COUNT, which is a fact and not a favourite. "Notable" would
/// have been a list somebody maintains, and the same sentence that asked for this
/// grid forbade hand-listing it — so the order is `apiGroups()`, the group names
/// are the reference's, and the only number here is one the generator counted.
fn teaserGroups() -> Array<ApiGroup> {
    let mut out: Array<ApiGroup> = []
    for g in apiGroups() {
        // The two biggest of the group: seed with the first two, then let any
        // bigger module displace the smaller of the pair.
        let mut top: Array<ApiModule> = []
        for m in g.modules {
            if top.length < 2 {
                top.push(ApiModule { name: m.name.copy(), summary: "", count: m.count })
            } else {
                let least = if top[1].count < top[0].count { 1 } else { 0 }
                if m.count > top[least].count {
                    top[least] = ApiModule { name: m.name.copy(), summary: "", count: m.count }
                }
            }
        }
        out.push(ApiGroup { name: g.name.copy(), modules: top.copy(), icon: g.icon.copy() })
    }
    return out
}

/// The reference page, and how many modules are on it.
fn allModules() -> String {
    return "All " + stdCount().toString() + " modules"
}

/// The four pillar commands, coloured. They are indexed rather than looped
/// because the cards around them are written out one by one: `<Icon>` is a
/// generation-time provider and `:name` is refused at the tag (RFC-0107 M1), so

/// One step's terminal body: the compiler's own colours when the step printed
/// a file, the shell's three voices when it printed a transcript.
fn stepHtml(s: DemoStep) -> String {
    let source = demoHl(s.id)
    if source.byteLength > 0 {
        return source
    }
    return shellOutHtml(s.cmd, s.out)
}

/// The width of one engine's bar, as the percentage the record measured.
fn barStyle(pct: String) -> String {
    return "width: " + pct + "%"
}
</script>

<template>
<main class="page wide">
        <section class="hero split">
            <div>
                <p class="eyebrow">A systems language</p>
                <h1 class="display">Types carry the <em>rules</em>.<br/>Native speed.<br/>No collector.</h1>
                <p class="lede">Write the rule into the type. The compiler proves it, or refuses the value.</p>

                <!-- ONE OS PICKER ON THIS SITE (RFC-0106 M3, second round). This
                     was a second one — underline tabs driven by `tabsWidget` —
                     doing the same job as the install page's with a different
                     shape and a different keyboard model. It is the same three
                     radio buttons now: no script, a native group, and the tiles
                     joined to the command box they select. -->
                <!-- Command first, the chips under it — the reference front
                     page's order: the command is the point and the tabs are
                     the quietest thing near it. The label above the box names
                     the version, so the hero says what today's install is. -->
                <p class="cmdlabel">Install Vyrn <a href="/releases.html">{{ releaseTag() }}</a></p>
                <fieldset class="picker">
                    <legend class="sr-only">Operating system</legend>
                    <input class="sr-only" type="radio" name="os" id="os-unix" checked="checked" data-os="unix"/>
                    <input class="sr-only" type="radio" name="os" id="os-windows" data-os="windows"/>
                    <div class="ospanes">
                        <div class="ospane" v-for="p in installTargets()" :key="p.id">
                            <div class="cmd" data-copy>
                                <code v-html="shellHtml(p.cmd)"></code>
                                <button type="button" data-copy-btn aria-label="Copy the install command">Copy</button>
                            </div>
                        </div>
                    </div>
                    <div class="tabrow">
                        <div class="ostabs">
                            <label v-for="p in installTargets()" :key="p.id" :for="osId(p)">{{ p.name }}</label>
                        </div>
                        <a class="tablink" href="/install.html">Other ways to install</a>
                    </div>
                </fieldset>
            </div>

            <!-- THE RUNNABLE HERO. The `data-play-*` hooks are the playground's
                 own, so this is `mountPlay` on a smaller root and not a second
                 editor: one contract, one keyboard model, one highlighter.
                 `data-widget="playhero"` and not `"play"` is what keeps it lazy
                 — `boot()` mounts the second on sight and arms the first. -->
            <div class="plate play heroplay" data-widget="playhero">
                <!-- ONE ROW OF STATE AND TWO CONTROLS (RFC-0106 M3, fourth
                     round). `data-play-status` is the run state and it is real:
                     `Press Run`, then `Loading the compiler…`, `Running…`, and
                     then `Ran`, `Did not compile` or `Stopped` — with the exit
                     code printed under the output beside it. `Reset` puts the
                     original program back; it is `[data-js]`-gated, because with
                     no script this textarea is read-only and there is nothing to
                     reset. -->
                <div class="plate-head">
                    <span class="eyebrow" data-play-status>Ready</span>
                    <span class="spacer"></span>
                    <button type="button" class="btn jsonly" data-play-reset>Reset</button>
                    <button type="button" class="btn primary" data-play-run title="Ctrl+Enter">Run</button>
                </div>
                <div class="editor" data-play-editor>
                    <pre class="code hl" aria-hidden="true"><code data-play-hl v-html="vyrnHtml(heroSnippet())"></code></pre>
                    <textarea data-play-src readonly="readonly" rows="15" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" wrap="off" aria-label="Vyrn source, editable after the first press">{{ vyrnSource(heroSnippet()) }}</textarea>
                </div>
                <div class="diags" data-play-diags hidden="hidden" aria-live="polite"></div>
                <div class="out" data-play-out aria-live="polite"><span class="dim">Not run yet.</span></div>
                <noscript><p class="cap">Without script: <a href="/play.html">the playground</a>.</p></noscript>
            </div>
        </section>

        <!-- EIGHT PROGRAMS, EIGHT CARDS (RFC-0106 M5 round 21, against the
             reference site's own benchmark page). One chart of one program
             said "as quick as C" and showed a single kernel; the record holds
             eight, each with its engines, its peak memory and — where Vyrn is
             behind — the cause somebody named. A card is its own scale, so a
             400ms program and a 3s one are both readable. -->
        <section class="band" id="speed">
            <div class="benchhead">
                <p class="eyebrow"><Icon name="bytesize:activity"/> Measured</p>
                <h2 class="display">Eight programs, five engines,<br/>one afternoon on one machine.</h2>
                <p class="lede">The Benchmarks Game programs, run against C, Rust and node, with the WebAssembly build beside them. Every number below came out of that run — the ones where Vyrn is behind carry the reason.</p>
                <p class="ctarow"><a class="cta" href="/benchmarks.html">The benchmarks page</a></p>
            </div>

            <div class="benchgrid">
                <article class="benchcard" v-for="p in frontPanels()" :key="p.key">
                    <h3>{{ p.name }}<span class="size">{{ p.n }}</span></h3>
                    <p class="what">{{ panelNote(p.key) }}</p>
                    <ul class="bars">
                        <li v-for="b in panelBars(p.key)" :key="b.key" :data-tone="b.tone">
                            <span class="who">{{ b.name }}</span>
                            <span class="track"><span class="fill" :style="barStyle(b.pct)"></span></span>
                            <span class="ms">{{ b.ms }}</span>
                        </li>
                    </ul>
                    <p class="bfoot">
                        <span class="bspeed">{{ panelSpeed(p.key) }}</span>
                        <span class="bram">RAM {{ panelMemLine(p.key) }}</span>
                    </p>
                    <p class="bcause" v-if="p.label.byteLength > 0">{{ p.label }}</p>
                </article>
            </div>

            <p class="cap benchcap">{{ benchMachine() }} · medians of {{ benchRuns() }} · every engine at its own defaults · <a href="/benchmarks.html">all eight programs, the table and the radar →</a></p>
        </section>

        <!-- ONE SHOWCASE, NOT TWO SECTIONS (RFC-0106 M5 round 24, against
             the reference site's own). Four cards said what the language
             believes and five tabs showed the code; they were the same
             section written twice. The idea is the row a reader picks and the
             program is what answers — every one of them compiled by this
             build, from `site/guide/`.

             SCRIPTLESS, like the install page's picker: radios and
             `:checked ~`, so a reader with no JavaScript gets a working list
             and a keyboard gets a native radio group. The inputs are written
             out because only the first carries `checked` and `v-for` cannot
             put an attribute on one iteration. -->
        <section class="band" id="ideas">
            <div class="showhead">
                <p class="eyebrow"><Icon name="bytesize:lightning"/> The ideas, in code</p>
                <h2 class="display">Six ideas. Six programs<br/>this build compiled.</h2>
                <p class="lede">Every panel is a file in this repository, with the chapter that teaches it one press away.</p>
            </div>
            <fieldset class="picker showcase">
                <legend class="sr-only">Language feature</legend>
                <input class="sr-only" type="radio" name="tab" id="tab-types" checked="checked"/>
                <input class="sr-only" type="radio" name="tab" id="tab-own"/>
                <input class="sr-only" type="radio" name="tab" id="tab-records"/>
                <input class="sr-only" type="radio" name="tab" id="tab-html"/>
                <input class="sr-only" type="radio" name="tab" id="tab-gen"/>
                <input class="sr-only" type="radio" name="tab" id="tab-bench"/>
                <div class="showgrid">
                    <div class="showlist">
                        <label v-for="t in tabs()" :key="t.id" :for="tabId(t)">{{ t.label }}</label>
                    </div>
                    <div class="showpanes">
                        <div class="showpane" v-for="t in tabs()" :key="t.id">
                            <div class="showbar">
                                <span class="what">{{ t.caption }}</span>
                                <a class="docs" :href="tabDocs(t)">Docs →</a>
                            </div>
                            <p class="file">{{ tabPath(t) }}</p>
                            <pre class="code"><code v-html="tabCode(t)"></code></pre>
                            <p class="cap"><a :href="tabFile(t)">The file in the repository</a><span v-if="tabPlay(t).byteLength > 0"> · <a :href="tabPlay(t)">Run it in the playground</a></span></p>
                        </div>
                    </div>
                </div>
            </fieldset>
        </section>
        <!-- THE REFERENCE, TEASED (RFC-0106 M3, fourth round). Eight names and
             their export counts, read off `std/` by the same generator the
             reference landing reads — so a module added tomorrow can appear here
             and none of this is a list somebody maintains. -->
        <section class="band split" id="std">
            <div class="say">
                <p class="eyebrow">Standard library</p>
                <h2>Written in Vyrn, all of it</h2>
                <p>Every module below compiles under the same rules your program does.</p>
                <p class="ctarow"><a class="cta" href="/docs.html">{{ allModules() }}</a></p>
            </div>
            <ul class="modteaser">
                <li v-for="g in teaserGroups()" :key="g.name">
                    <p class="eyebrow">{{ g.name }}</p>
                    <a v-for="m in g.modules" :key="m.name" :href="apiHref(m.name)"><code>std/{{ m.name }}</code> <span>{{ m.count }}</span></a>
                </li>
            </ul>
        </section>

        <section class="band" id="minute">
            <p class="eyebrow"><Icon name="bytesize:play"/> A minute with Vyrn</p>
            <div class="minutehead">
                <h2 class="display">One binary,<br/>from new to shipped.</h2>
                <p class="lede">Write, check, test and build with the same tool. Every step below is a real command with its real output. Press one, or let it run through.</p>
            </div>
            <!-- Every line of output below came out of the real binary, recorded
                 by `scripts/site-demo.py` before this page was rendered. Without
                 script all seven steps are on the page at once. -->
            <!-- TWO LISTS, ONE INDEX (RFC-0106 M3, fourth round). The steps are
                 column 1 and their outputs are column 2, as siblings, because
                 the card is the split — one `li` carrying its own output was a
                 shape that only worked in the state nobody sees, with all seven
                 open. `widgets.js` marks the nth row and the nth pane; with no
                 script every pane is on the page under its own title. -->
            <div class="demo" data-widget="demo">
                <ol class="steps">
                    <li v-for="s in demoSteps()" :key="s.id" :data-step="s.id">
                        <h3>{{ s.title }}</h3>
                        <div class="cmd" v-if="s.cmd.byteLength > 0"><code v-html="shellHtml(s.cmd)"></code></div>
                        <!-- The note rides WITH its step now, the way the
                             reference site carries it: the marked row explains
                             itself, and the rest are a table of contents. -->
                        <p class="stepnote">{{ s.note }}</p>
                        <span class="tick" aria-hidden="true"></span>
                    </li>
                </ol>
                <!-- A terminal, drawn as one: the window's own bar with its
                     path and the step's number, and output coloured by
                     `shellOutHtml` — a prompt is a prompt, a path is a path. -->
                <div class="term">
                    <div class="termbar" aria-hidden="true">
                        <span class="lights"><i></i><i></i><i></i></span>
                        <span class="where">~/demo — vyrn</span>
                        <span class="counter" data-demo-count></span>
                    </div>
                    <div class="panes">
                        <div class="pane" v-for="s in demoSteps()" :key="s.id" :data-pane="s.id">
                            <pre class="out" v-html="stepHtml(s)"></pre>
                        </div>
                    </div>
                </div>
            </div>
            <!-- The provenance line, BELOW the card and not inside it. `.cap` is
                 the class built to sit flush under the block it is about; as an
                 `.eyebrow` inside the plate it landed on top of the last step's
                 row. -->
            <p class="cap minutecap">Recorded by running <code>{{ demoVersion() }}</code> on <code>{{ demoRecorded() }}</code>. Hover to pause.</p>
        </section>

        <!-- LATEST RELEASE (RFC-0106 M3, third round). `Releases` left the
             masthead — four names a reader knows beats five, and a changelog is
             not what anybody navigates to before they have installed anything —
             so the page arrives HERE instead, where a reader who has just read
             the install command is standing. It is the good half of a blog for a
             project that has no blog, and every line of it is computed: the tag
             and the date are baked, and the highlights are the design records
             that arrived after the tag, with the status each holds today.
             The section it replaced was a heading and three buttons repeating
             three links already on the page. -->
        <section class="band" id="release">
            <div class="say">
                <p class="eyebrow">Latest release</p>
                <h2>{{ headline() }}</h2>
                <p>{{ standing() }}</p>
                <!-- One word, and it is the page's own name. The index's word
                     budget is 260 and this section put it at 261. -->
                <p class="ctarow"><a class="cta" href="/releases.html">Releases</a></p>
            </div>
        </section>
</main>
</template>
