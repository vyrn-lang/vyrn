<script>
// GET /guide: the book's contents, from the book's own `chapters()`.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Chapter, areaGroups, groupChapters, chapterHref, chapterCount, blockCount } from "../../guide"
import { inlineCode } from "../../code"
import { TreeGroup, areaTree } from "../../docshell"

export fn head() -> Head {
    return pageHeadOf("/guide")
}

/// The book's groups, as the sidebar prints them.
fn groups() -> Array<String> {
    return areaGroups("guide")
}

/// One group's chapters.
fn of(g: String) -> Array<Chapter> {
    return groupChapters("guide", g)
}

/// The sidebar: the book's contents, with the Overview marked.
fn tree() -> Array<TreeGroup> {
    return areaTree("guide", "index")
}
</script>

<template>
<main class="page docs docpage">
    <aside class="docstree">
        <details class="treebox">
            <summary>The guide</summary>
            <div class="treegroup" v-for="g in tree()" :key="g.name">
                <p class="eyebrow"><span class="slot" v-html="g.icon"></span>{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <section class="hero">
        <h1 class="display">Guide</h1>
        <p class="lede">{{ chapterCount("guide") }} chapters, from the first program to a command-line tool, for a developer who knows one other language. Each chapter builds on the ones before it. The web stack and the toolchain have their own sections: <a href="/web.html">Web</a> and <a href="/tooling.html">Tooling</a>.</p>
    </section>

    <section class="band" id="chapters">
        <div class="chapgroup" v-for="g in groups()" :key="g">
            <p class="eyebrow">{{ g }}</p>
            <ul class="modgrid chapters">
                <li v-for="c in of(g)" :key="c.slug">
                    <a :href="chapterHref(c.slug)">{{ c.title }}</a>
                    <span class="d" v-html="inlineCode(c.lede)"></span>
                </li>
            </ul>
        </div>
    </section>

    <section class="band" id="run">
        <h2>Code blocks</h2>
        <p>Every code block in this documentation is a file in <code>site/guide/</code>: {{ blockCount() }} programs, each run while the pages were built. The output under a block is what that program printed. The run link opens the whole source in the playground.</p>
    </section>
</main>
</template>
