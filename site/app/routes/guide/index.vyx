<script>
// GET /guide — the book's contents.
//
// The chapter list is the book's own `chapters()`, so a chapter added there
// appears here, in the tree of every chapter page, and in the export's route
// table, with nothing written twice.
//
// THE LANDING WEARS THE SHELL (RFC-0106 M4 follow-up). It kept the old
// numbered rail and three landing-scale bands around five sentences — a page
// that was mostly its own margins. It is a docs page now: the book's tree on
// the left with Overview marked, and one flowing column — the claim, the
// grid, one note about the programs.
import { Head } from "std/ui"
import { pageHeadOf } from "../../nav"
import { Chapter, chapters, chapterHref, chapterNumber, chapterTag, blockCount } from "../../guide"
import { inlineCode } from "../../code"
import { TreeGroup, guideTree, docSubnav } from "../../docshell"

export fn head() -> Head {
    return pageHeadOf("/guide")
}

/// The chapter's number, as the tree and the list print it.
fn tagOf(c: Chapter) -> String {
    return chapterTag(chapterNumber(c.slug))
}

/// The sidebar: the book's contents, with the Overview marked.
fn tree() -> Array<TreeGroup> {
    return guideTree("index")
}

/// The subnav row, with this section marked.
fn subnav() -> String {
    return docSubnav("guide")
}
</script>

<template>
<main class="page docs docpage">
    <nav class="subnav" aria-label="Documentation sections" v-html="subnav()"></nav>
    <aside class="docstree">
        <details class="treebox">
            <summary>The guide</summary>
            <div class="treegroup" v-for="g in tree()" :key="g.name">
                <p class="eyebrow">{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <section class="hero">
        <p class="eyebrow">The guide</p>
        <h1 class="display">Learn the language in order</h1>
        <p class="lede">Thirteen chapters, from the first program to a web application, for a developer who knows one other language. They build on each other, so the first read is best in order; the <a href="/docs.html">reference</a> answers one question at a time, and the book answers them in the order they come up.</p>
    </section>

    <section class="band" id="chapters">
        <ul class="modgrid chapters">
            <li v-for="c in chapters()" :key="c.slug">
                <a :href="chapterHref(c.slug)">{{ c.title }}</a>
                <span class="count">{{ tagOf(c) }}</span>
                <span class="d" v-html="inlineCode(c.lede)"></span>
            </li>
        </ul>
    </section>

    <section class="band" id="run">
        <p class="eyebrow">Running the code</p>
        <p>Every code block in this book is a file in <code>site/guide/</code> — {{ blockCount() }} programs, each imported and called while the pages are built, printing what it answered. A program that does not compile fails the build; one that traps fails the export. The run link on a block carries its whole source to the playground, so what you run is what you read.</p>
    </section>
</main>
</template>
