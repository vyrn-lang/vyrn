<script>
// GET /guide/[chapter] — one chapter of the book.
//
// The prose is in `site/app/guide.vyrn`; the programs are files in
// `site/guide/`, imported and CALLED by that module while this page renders. So
// a block on this page is a program that ran, and its output is what it printed.
//
// A String segment binds the slug, and the query returns
// `Result<ChapterPage, PageError>`, so a slug that is not a chapter renders the
// themed error page at 404 rather than an empty book.
import { Head, PageError, ParamQuery, notFound, paramQuery } from "std/ui"
import { pageHead } from "../../nav"
import { Chapter, Section, chapters, chapterOf, chapterKnown, chapterNumber, chapterTag, chapterHref, chapterNavHtml, sectionBody, sectionEyebrow } from "../../guide"
import { mdUrl } from "../../pagemd"
import { inlineCode } from "../../code"
// THE DOCS SHELL (RFC-0106 M4). The same three panes the reference wears: the
// book's contents on the left, this chapter's sections on the right, the chapter
// before and after at the foot.
import { TreeGroup, guideTree } from "../../docshell"
params { chapter: String }

/// One chapter, with the number the rail prints beside it.
type ChapterPage = { n: Int64, chapter: Chapter }

export fn head(d: ChapterPage) -> Head {
    return pageHead(d.chapter.title + " — the Vyrn guide")
}

export fn data() -> ParamQuery<Params, Result<ChapterPage, PageError>> {
    return paramQuery(fetchChapter)
}

fn fetchChapter(p: Params) -> Result<ChapterPage, PageError> {
    if !chapterKnown(p.chapter) {
        return Err(notFound(p.chapter + " is not a chapter of the guide"))
    }
    return Ok(ChapterPage { n: chapterNumber(p.chapter), chapter: chapterOf(p.chapter) })
}

/// The sidebar for this page: the book's contents, with this chapter marked.
fn tree(here: String) -> Array<TreeGroup> {
    return guideTree(here)
}

/// The link to one section of this chapter. A function rather than `"#" + …` in
/// the template, because a template attribute is delimited by the same quote a
/// String literal is and `'#'` in Vyrn is a byte.
fn sectionHref(s: Section) -> String {
    return "#" + s.anchor
}
</script>

<template>
<main class="page docs">
    <aside class="docstree">
        <details class="treebox">
            <summary>The guide</summary>
            <div class="treegroup" v-for="g in tree(data.chapter.slug)" :key="g.name">
                <p class="eyebrow">{{ g.name }}</p>
                <a v-for="r in g.rows" :key="r.href" :href="r.href" :aria-current="r.here">{{ r.label }}</a>
            </div>
        </details>
    </aside>

    <div class="crumbrow">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/guide.html">Docs</a>
            <span>Chapter {{ data.n }} of {{ chapters().length }}</span>
        </nav>
        <p class="docutils">
            <!-- A LINK to the file the export writes beside this page;
                 `widgets.js` turns a press into a clipboard write when the
                 browser has a clipboard. Without script it is the file. -->
            <a class="btn" :href="mdUrl(chapterHref(data.chapter.slug))" data-copy-md>Copy page</a>
        </p>
    </div>

    <section class="hero">
        <h1 class="display">{{ data.chapter.title }}</h1>
        <p class="lede" v-html="inlineCode(data.chapter.lede)"></p>
    </section>

    <section class="band" v-for="s in data.chapter.sections" :key="s.anchor" :id="s.anchor">
        <p class="eyebrow">{{ sectionEyebrow(data.chapter, s) }}</p>
        <h2>{{ s.heading }}</h2>
        <div v-html="sectionBody(s)"></div>
    </section>

    <nav class="pager" aria-label="Chapters" v-html="chapterNavHtml(data.chapter.slug)"></nav>

    <!-- THE RIGHT PANE: this chapter's own sections, from the same array the
         `<h2>`s above are rendered from, so the two cannot disagree. Every
         fragment here is checked against the ids the page carries by the link
         gate in `site/export.vyrn`. -->
    <aside class="onpage">
        <p class="eyebrow">On this page</p>
        <a v-for="s in data.chapter.sections" :key="s.anchor" :href="sectionHref(s)">{{ s.heading }}</a>
    </aside>
</main>
</template>
