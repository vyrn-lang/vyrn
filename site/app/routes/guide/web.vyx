<script>
// GET /guide/web: a redirect stub (see `philosophy.vyx`). The target comes from
// `movedChapters()`, the table `site/export.vyrn` stamps the refresh from.
import { Head } from "std/ui"
import { pageHead } from "../../nav"
import { movedTarget } from "../../guide"

export fn head() -> Head {
    return pageHead("Moved — Vyrn")
}

/// Where this stub sends a reader.
fn target() -> String {
    return movedTarget("/guide/web") + ".html"
}
</script>

<template>
<main class="page">
    <section class="hero">
        <h1 class="display">Page moved</h1>
        <p class="lede">This page moved to <a :href="target()">Views and HTML</a>.</p>
    </section>
</main>
</template>
