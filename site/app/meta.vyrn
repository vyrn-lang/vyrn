import { startsWith, endsWith, contains } from "std/strpred"
import { substring, indexOf, replace, trimEnd } from "std/strings"

export type PageMeta = { path: String, title: String, blurb: String }

export fn pageMetas() -> Array<PageMeta> {
    return [
        PageMeta { path: "/", title: "Vyrn — a systems language with the expressiveness of TypeScript", blurb: "Types carry the rules that make a value valid. Ownership is a word you write on a parameter. No garbage collector, three backends, one result." },
        PageMeta { path: "/guide", title: "Docs — Vyrn", blurb: "The book, in reading order. Every code block in it is a program this site compiled and ran while it built the page." },
        PageMeta { path: "/web", title: "Web — Vyrn", blurb: "The web stack, page by page: the view tree, single-file components, routes and RPC, styling and icons — all libraries, none of it compiler." },
        PageMeta { path: "/tooling", title: "Tooling — Vyrn", blurb: "Everything the vyrn binary does: run and build, test and bench, format and document, and the pins that keep a build reproducible." },
        PageMeta { path: "/benchmarks", title: "Benchmarks — Vyrn", blurb: "Eight Benchmarks Game programs against C, Rust and node, with peak memory, the raw table, and a named cause under every deviation." },
        PageMeta { path: "/docs", title: "Reference — Vyrn", blurb: "Every standard library module and every name it exports, with the signature, the tests and the example programs for each." },
        PageMeta { path: "/explore", title: "Explore — Vyrn", blurb: "The packages you can install, each with the vyrn add line that installs it and the manifest it resolves to." },
        PageMeta { path: "/releases", title: "Releases — Vyrn", blurb: "What is published, whether it is safe to depend on, and how a release is made." },
        PageMeta { path: "/play", title: "Playground — Vyrn", blurb: "Write Vyrn in the page and run it. The compiler front end is WebAssembly and the program never leaves your browser." },
        PageMeta { path: "/install", title: "Install — Vyrn", blurb: "One command per operating system, what it verifies, and how to build from source. Uninstalling is deleting a directory." },
        PageMeta { path: "/why-vyrn", title: "Why Vyrn — Vyrn", blurb: "Intent over mechanism: state what must be true of a value, and what a function does with its argument. And the six things Vyrn refuses." },
        PageMeta { path: "/tooling/editors", title: "Editors — Vyrn", blurb: "One VS Code extension and one language server, both in this repository, both answering from the compiler front end itself." },
        PageMeta { path: "/docs/graph", title: "The import graph — Vyrn", blurb: "Every import between the standard library's modules, drawn from the import lines themselves." },
    ]
}

export fn metaOf(path: String) -> PageMeta {
    for m in pageMetas() {
        if m.path == path {
            return PageMeta { path: m.path.copy(), title: m.title.copy(), blurb: m.blurb.copy() }
        }
    }
    return PageMeta { path: path.copy(), title: "", blurb: "" }
}

export fn hasMeta(path: String) -> Bool {
    return metaOf(path).title.byteLength > 0
}

export fn blurbLimit() -> Int64 {
    return 155
}

export fn blurbFloor() -> Int64 {
    return 50
}

export fn blurbFrom(markup: String, tail: String) -> String {
    let flat = collapse(decodeEntities(stripTags(markup)))
    let room = blurbLimit() - tail.byteLength
    if flat.byteLength <= room {
        return flat + tail
    }
    let stop = lastSentenceEnd(flat, room)
    if stop >= blurbFloor() {
        return substring(flat, 0, stop) + tail
    }
    return withoutDanglingJoiner(substring(flat, 0, wordEnd(flat, room - 3))) + "…" + tail
}

fn withoutDanglingJoiner(text: String) -> String {
    let mut out = trimEnd(text)
    while out.byteLength > 0 {
        if endsWith(out, "—") {
            out = trimEnd(substring(out, 0, out.byteLength - 3))
        } else if out[out.byteLength - 1] == ',' || out[out.byteLength - 1] == ';' || out[out.byteLength - 1] == ':' {
            out = trimEnd(substring(out, 0, out.byteLength - 1))
        } else {
            return out.copy()
        }
    }
    return out.copy()
}

export fn stripTags(markup: String) -> String {
    let mut out = ""
    let mut rest = markup.copy()
    while rest.byteLength > 0 {
        let at = match indexOf(rest, "<") {
            Some(i) => i,
            None => 0 - 1,
        }
        if at < 0 {
            return out + rest
        }
        out = out + substring(rest, 0, at)
        let tag = substring(rest, at, rest.byteLength)
        rest = match indexOf(tag, ">") {
            Some(close) => substring(tag, close + 1, tag.byteLength),
            None => "",
        }
    }
    return out.copy()
}

/// `&amp;` goes last, so `&amp;lt;` decodes to `&lt;`.
export fn decodeEntities(text: String) -> String {
    let lt = replace(text, "&lt;", "<")
    let gt = replace(lt, "&gt;", ">")
    let quot = replace(gt, "&quot;", "\"")
    let apos = replace(quot, "&#39;", "'")
    return replace(apos, "&amp;", "&")
}

fn collapse(text: String) -> String {
    return replace(replace(text, "\n", " "), "  ", " ")
}

fn lastSentenceEnd(text: String, max: Int64) -> Int64 {
    let mut best = 0
    let mut i = 0
    while i < max && i < text.byteLength {
        if text[i] == '.' && (i + 1 == text.byteLength || text[i + 1] == ' ') {
            best = i + 1
        }
        i = i + 1
    }
    return best
}

fn wordEnd(text: String, max: Int64) -> Int64 {
    if max >= text.byteLength {
        return text.byteLength
    }
    let mut at = max
    while at > 0 {
        if text[at] == ' ' {
            return at
        }
        at = at - 1
    }
    let mut boundary = max
    while boundary > 0 && text[boundary] >= 128 && text[boundary] < 192 {
        boundary = boundary - 1
    }
    return boundary
}

test "every row is a consumer path with a sentence on it" {
    let all = pageMetas()
    assertEq(all.length, 13)
    for m in all {
        assert(startsWith(m.path, "/"))
        assert(m.title.byteLength > 0)
        assert(m.blurb.byteLength > 50)
        assert(m.blurb.byteLength <= blurbLimit())
        assertEq(m.blurb[m.blurb.byteLength - 1], '.')
    }
}

test "a page with no row says so rather than answering with someone else's" {
    assertEq(metaOf("/install").title, "Install — Vyrn")
    assert(hasMeta("/"))
    assert(hasMeta("/tooling/editors"))
    assert(!hasMeta("/docs/std/json"))
    assert(!hasMeta("/guide/values"))
    assertEq(metaOf("/guide/values").blurb, "")
}

test "no two rows share a title or a blurb" {
    let all = pageMetas()
    let mut i = 0
    while i < all.length {
        let mut j = i + 1
        while j < all.length {
            assert(all[i].title != all[j].title)
            assert(all[i].blurb != all[j].blurb)
            assert(all[i].path != all[j].path)
            j = j + 1
        }
        i = i + 1
    }
}

test "a derived blurb is plain text, and short enough to be read whole" {
    assertEq(blurbFrom("the <code>Stream&lt;T&gt;</code> combinators, written in Vyrn.", ""), "the Stream<T> combinators, written in Vyrn.")
    assertEq(decodeEntities("a &amp;lt; b"), "a &lt; b")
    assertEq(blurbFrom("a > b <em>c</em>", ""), "a > b c")
}

test "a long sentence is cut where a reader would stop, not where the byte count runs out" {
    let three = "A gen fn is ordinary Vyrn that runs while the program compiles and returns Vyrn source. RPC, UI, i18n and GraphQL are libraries built this way. None of them is a compiler feature."
    let cut = blurbFrom(three, "")
    assert(cut.byteLength <= blurbLimit())
    assertEq(cut[cut.byteLength - 1], '.')
    assert(!contains(cut, "None of them"))
    let short = "One binary. vyrn run needs nothing else on your machine, vyrn build writes a native binary, and every other task — tests, benchmarks, formatting, documents — is a subcommand"
    let fallback = blurbFrom(short, "")
    assert(fallback.byteLength > blurbLimit() - 20)
    assert(fallback.byteLength <= blurbLimit())
    assert(endsWith(fallback, "…"))
    let stem = substring(fallback, 0, fallback.byteLength - 3)
    assert(contains(short, stem))
    assert(stem[stem.byteLength - 1] != ' ')
    assert(stem[stem.byteLength - 1] != ',')
    assertEq(withoutDanglingJoiner("every other task — tests, docs —"), "every other task — tests, docs")
    assertEq(withoutDanglingJoiner("a sentence."), "a sentence.")
}

test "the tail survives the cut, because it is the fact the prose does not carry" {
    let long = "std/symbolmap — the shared shape of a generated module&#39;s symbol map: for each exported symbol, the source declaration it stands for, plus any derived facts."
    let out = blurbFrom(long, " 5 exports.")
    assert(out.byteLength <= blurbLimit())
    assert(endsWith(out, " 5 exports."))
    assert(contains(out, "module's symbol map"))
}

test "a tag is removed and not escaped" {
    assertEq(stripTags("a <code>b</code> c"), "a b c")
    assertEq(stripTags("plain"), "plain")
    assertEq(stripTags("<b>only</b>"), "only")
    assertEq(stripTags("half <b"), "half ")
}
