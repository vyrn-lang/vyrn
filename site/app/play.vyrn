/// The programs the playground starts from.
///
/// Each is a whole program: it declares `main`, prints, and returns an exit
/// code, because the playground runs it. None imports anything: the
/// playground's module resolver is empty, since `std/` lives on a filesystem.
/// The template copies each source into a hidden `<pre>`, escaped, and
/// `play.js` reads it back with `textContent`.
import { contains } from "std/strpred"

/// One example: the id the dropdown uses, the label a reader sees, the source it
/// loads, and the standard input that source expects.
export type Example = { id: String, title: String, src: String, stdin: String }

export fn playExamples() -> Array<Example> {
    return [
        Example {
            id: "hello",
            title: "Hello",
            src: "fn main() -> Int64 {
    print(\"hello\")
    return 0
}
",
            stdin: "",
        },
        Example {
            id: "types",
            title: "Types that carry their rule",
            src: "type Age = Int64 where value >= 18

fn admit(n: Int64) -> Int64 {
    // `Age?(n)` is None when the rule fails, so untrusted input never traps.
    return match Age?(n) {
        Some(a) => a,
        None => 0 - 1,
    }
}

fn main() -> Int64 {
    print(admit(30))
    print(admit(5))
    // Uncomment the next line. The compiler refuses it, and says why.
    // let bad = Age(5)
    return 0
}
",
            stdin: "",
        },
        Example {
            id: "ownership",
            title: "Ownership is a word on a parameter",
            src: "type Ticket = { id: Int64, seats: Int64 }

fn seatCount(t: read Ticket) -> Int64 { return t.seats }
fn addSeat(t: modify Ticket) { t.seats = t.seats + 1 }
fn redeem(t: consume Ticket) -> Int64 { return t.id }

fn main() -> Int64 {
    let mut t = Ticket { id: 7, seats: 2 }
    print(seatCount(t))
    addSeat(t)
    print(seatCount(t))
    print(redeem(t))
    // `t` was consumed above. Name it again and the compiler refuses:
    // print(seatCount(t))
    return 0
}
",
            stdin: "",
        },
        Example {
            id: "fib",
            title: "Recursion",
            src: "fn fib(n: Int64) -> Int64 {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn main() -> Int64 {
    let mut i = 0
    while i <= 15 {
        print(fib(i))
        i = i + 1
    }
    return 0
}
",
            stdin: "",
        },
        Example {
            id: "input",
            title: "Reading standard input",
            src: "// The lines in the standard input box below arrive here, one per call.
// At the end of them `readLine()` answers None, exactly as a pipe does.
fn main() -> Int64 {
    let mut n = 0
    while let Some(line) = readLine() {
        print(\"\\{n}: \\{line}\")
        n = n + 1
    }
    print(\"\\{n} line(s)\")
    return 0
}
",
            stdin: "alpha
beta
gamma
",
        },
        Example {
            id: "trap",
            title: "A trap, and the exit code",
            src: "// A trap writes to standard error and the program exits non-zero — the same
// channels a terminal gives it.
fn main() -> Int64 {
    print(\"before\")
    panic(\"this is a trap\")
    return 0
}
",
            stdin: "",
        },
    ]
}

test "every example is a whole program with a unique id" {
    let all = playExamples()
    assert(all.length > 0)
    for e in all {
        assert(e.id.byteLength > 0)
        assert(e.title.byteLength > 0)
        assert(contains(e.src, "fn main() -> Int64"))
        let mut seen = 0
        for other in playExamples() {
            if other.id == e.id {
                seen = seen + 1
            }
        }
        assertEq(seen, 1)
    }
}
