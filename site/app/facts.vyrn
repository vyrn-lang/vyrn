import { lines, trim, fromBytesOr } from "std/strings"
import { startsWith } from "std/strpred"
import { quotedList, vyrnStems } from "./gensrc"

fn contentLines(file: String) -> Array<String> {
    let body = match readFile(file) {
        Ok(text) => text.copy(),
        Err(why) => "",
    }
    let mut out: Array<String> = []
    for line in lines(body) {
        let t = trim(line)
        if t.byteLength > 0 && !startsWith(t, "#") {
            out.push(t)
        }
    }
    return out
}

fn releaseTagOf(file: String) -> String {
    let tag = releaseField(file, 0)
    if !startsWith(tag, "v") {
        return ""
    }
    return tag
}

fn releaseField(file: String, i: Int64) -> String {
    let rows = contentLines(file)
    if i >= rows.length {
        return ""
    }
    return rows[i].copy()
}

/// One argument per path: a generator may read only the paths its call site names.
export gen fn repoFacts(examplesDir: String, stdDir: String, releaseFile: String) -> Code {
    let examples = vyrnStems(examplesDir).length
    let mods = vyrnStems(stdDir)
    let count = mods.length
    let names = quotedList(mods)
    let tag = releaseTagOf(releaseFile)
    let date = if tag.byteLength == 0 { "" } else { releaseField(releaseFile, 1) }
    return vyrn"""
        /// Single-file programs in `examples/`. Each one meant to run runs as WebAssembly and as a native binary.
        export fn exampleCount() -> Int64 { return \{examples} }
        /// Modules in `std/`, all written in Vyrn.
        export fn stdCount() -> Int64 { return \{count} }
        /// The `std/` module names.
        export fn stdModules() -> Array<String> { return \{names} }
        /// The newest published release's tag, or "" when there is none.
        export fn releaseTag() -> String { return \{tag} }
        /// The day GitHub published it, or "".
        export fn releaseDate() -> String { return \{date} }

        """
}

test "a missing release file has no tag and no fields" {
    assertEq(releaseField("no/such/release.txt", 0), "")
    assertEq(releaseTagOf("no/such/release.txt"), "")
    assertEq(contentLines("no/such/release.txt").length, 0)
}
