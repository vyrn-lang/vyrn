/// Repository facts, counted at compile time.
///
/// The design brief's data rule is absolute: no widget renders a number the
/// project cannot produce on demand. So the site never writes a count by hand.
/// This generator reads the repository's own directories with `listDir`
/// while the site compiles, and emits the answers as Vyrn source.
/// Add an example, and the landing page says so on the next build. Write the
/// number by hand, and it starts drifting the same day.
///
///     import { repoFacts } from "./facts"
///     import { exampleCount, stdModules } from repoFacts("../examples", "../std", "../release.txt")
///
/// Import it through `site/app/repo.vyrn` rather than calling it twice. The
/// generator cache is keyed on the argument STRINGS, so two call sites spelling
/// the same directory with different `../` prefixes would generate two modules,
/// and their exported names would collide program-wide.
///
/// `listDir` and `readFile` are the two file effects a generator is allowed,
/// and the sandbox scopes them to the CONSTANT PATH ARGUMENTS at the call site.
/// That is why the two directories are two separate parameters rather than one
/// repository root: the call site states exactly what the generator may read,
/// and the release file is a third argument for the same reason. Read the
/// emitted module with `vyrn emit-gen`.
import { substring, lines, trim, fromBytesOr } from "std/strings"
import { startsWith } from "std/strpred"

/// `true` when `name` ends with `suffix`.
fn endsWithStr(name: String, suffix: String) -> Bool {
    if name.byteLength < suffix.byteLength {
        return false
    }
    return substring(name, name.byteLength - suffix.byteLength, name.byteLength) == suffix
}

/// The entries of `dir`, sorted (the generator sorts every listing, so what is
/// emitted does not depend on the order a filesystem hands them back). An
/// unreadable directory yields nothing, and the count that follows is zero,
/// which is visible on the page rather than silently wrong.
fn entriesOf(dir: String) -> Array<String> {
    return match listDir(dir) {
        Ok(names) => names.copy(),
        Err(why) => [],
    }
}

/// How many entries of `dir` end in `suffix`. A directory entry cannot, so this
/// counts files and nothing else.
fn countIn(dir: String, suffix: String) -> Int64 {
    let mut n = 0
    for entry in entriesOf(dir) {
        if endsWithStr(entry, suffix) {
            n = n + 1
        }
    }
    return n
}

/// The `std/` module names, without the extension, in sorted order.
fn stdNames(stdDir: String) -> Array<String> {
    let mut out: Array<String> = []
    for entry in entriesOf(stdDir) {
        if endsWithStr(entry, ".vyrn") {
            out.push(substring(entry, 0, entry.byteLength - 5))
        }
    }
    return out
}

/// A Vyrn array literal of quoted strings. The names come from file names in
/// this repository, which hold no quote or backslash, so a plain quote is safe
/// here in a way it would never be for untrusted text.
fn quotedList(items: Array<String>) -> String {
    let mut out = "["
    let mut first = true
    for it in items {
        if !first {
            out = out + ", "
        }
        first = false
        out = out + "\"" + it + "\""
    }
    return out + "]"
}

/// The lines of `file` that say something: comments and blank lines dropped,
/// each one trimmed. An unreadable file yields nothing, which is the "nothing is
/// released yet" state and renders as such rather than as a broken page.
fn contentLines(file: String) -> Array<String> {
    let body = match readFile(file) {
        Ok(text) => text.copy(),
        Err(why) => "",
    }
    let mut out: Array<String> = []
    for line in lines(body) {
        let t = trim(line)
        if t.byteLength > 0 && !startsWith(t, "#") {
            out.push(t)
        }
    }
    return out
}

/// The release tag in `file`, or "" when it does not carry one.
///
/// A tag must start with `v`: it is the only shape `release.yml` publishes, and
/// requiring it means a file that has lost its shape — a stray byte in front of
/// a comment marker, a half-written refresh — reads as "nothing released" rather
/// than as a release named after the accident.
fn releaseTagOf(file: String) -> String {
    let tag = releaseField(file, 0)
    if !startsWith(tag, "v") {
        return ""
    }
    return tag
}

/// Field `i` of the release file, or "" when the file does not carry it.
///
/// The bytes are filtered to what a version tag and a date are made of. Every
/// other value this generator emits comes from a file NAME in this repository;
/// this one comes from a file a workflow writes out of a GitHub API response, so
/// it is the one string here that is not already trusted. A byte outside the set
/// is dropped rather than escaped: a tag is not a place for a quote, and a
/// generator that emitted one would be emitting Vyrn source with a hole in it.
fn releaseField(file: String, i: Int64) -> String {
    let rows = contentLines(file)
    if i >= rows.length {
        return ""
    }
    return safeTag(rows[i])
}

/// `s` with every byte a version tag or a date is not made of removed.
fn safeTag(s: String) -> String {
    let mut out = ""
    for b in bytes(s) {
        if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '.' || b == '-' || b == '_' || b == '+' {
            out = out + fromBytesOr([b], "")
        }
    }
    return out
}

/// Count the repository, and emit the answers as a module.
export gen fn repoFacts(examplesDir: String, stdDir: String, releaseFile: String) -> String {
    let examples = countIn(examplesDir, ".vyrn")
    let mods = stdNames(stdDir)
    let mut out = "/// Counted from the repository while the site compiled. Do not edit.\n"
    out = out + "/// Single-file programs in `examples/`. Every one runs on all three backends.\n"
    out = out + "export fn exampleCount() -> Int64 { return " + examples.toString() + " }\n"
    out = out + "/// Modules in `std/`, all written in Vyrn.\n"
    out = out + "export fn stdCount() -> Int64 { return " + mods.length.toString() + " }\n"
    out = out + "/// The `std/` module names.\n"
    out = out + "export fn stdModules() -> Array<String> { return " + quotedList(mods) + " }\n"
    let tag = releaseTagOf(releaseFile)
    out = out + "/// The newest published release's tag, or \"\" when there is none.\n"
    out = out + "export fn releaseTag() -> String { return \"" + tag + "\" }\n"
    out = out + "/// The day GitHub published it, or \"\".\n"
    out = out + "export fn releaseDate() -> String { return \"" + if tag.byteLength == 0 { "" } else { releaseField(releaseFile, 1) } + "\" }\n"
    return out
}

test "a release field keeps what a tag is made of and drops the rest" {
    assertEq(safeTag("v0.1.0-alpha.1"), "v0.1.0-alpha.1")
    assertEq(safeTag("2026-08-11"), "2026-08-11")
    // The one string here that comes off the network. A quote or a backslash
    // would end the string literal this generator writes it into.
    assertEq(safeTag("v1\" }\nfn evil() -> Int64 { return 0"), "v1fnevil-Int64return0")
    assertEq(safeTag(""), "")
    // Read through a file that is not there: the missing-file path is the
    // "nothing is released yet" state, and it must be empty rather than a trap.
    assertEq(releaseField("no/such/release.txt", 0), "")
    assertEq(releaseTagOf("no/such/release.txt"), "")
    assertEq(contentLines("no/such/release.txt").length, 0)
}

test "the quoted list is a Vyrn array literal" {
    assertEq(quotedList([]), "[]")
    assertEq(quotedList(["a", "b"]), "[\"a\", \"b\"]")
}
