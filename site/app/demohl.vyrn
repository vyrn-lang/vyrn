import { highlightSrc } from "./hl"
import { quoted, branch, lookup } from "./gensrc"
import { substring, split, joinWith, indexOf } from "std/strings"
import { startsWith, contains } from "std/strpred"

export gen fn demoCode(path: String) -> String {
    let raw = match readFile(path) {
        Ok(text) => text,
        Err(_) => "",
    }
    let mut hits: Array<String> = []
    for step in stepsOf(raw) {
        if looksLikeSource(step[1]) {
            hits.push(branch("id", step[0], quoted(highlightSrc(step[1], lex(step[1])))))
        }
    }
    let mut out = "/// Coloured by the compiler's own lexer while the site compiled. Do not edit.\n"
    out = out + "/// One step's output as source, or \"\" when it is a transcript.\n"
    return out + lookup("demoHl", "id", "String", hits, "\"\"")
}

/// A hand walk, not the JSON reader, because this runs inside a generator.
fn stepsOf(raw: String) -> Array<Array<String>> {
    let mut out: Array<Array<String>> = []
    let mut rest = raw.copy()
    while true {
        let id = fieldAfter(rest, "\"id\"")
        if id[0].byteLength == 0 && id[1].byteLength == 0 {
            return out
        }
        rest = id[1].copy()
        let body = fieldAfter(rest, "\"out\"")
        if body[0].byteLength == 0 && body[1].byteLength == 0 {
            return out
        }
        rest = body[1].copy()
        let mut pair: Array<String> = []
        pair.push(id[0].copy())
        pair.push(unescapeJson(body[0]))
        out.push(pair.copy())
    }
    return out
}

fn fieldAfter(s: String, key: String) -> Array<String> {
    let mut none: Array<String> = []
    none.push("")
    none.push("")
    let mut at = 0
    if let Some(i) = indexOf(s, key) {
        at = i
    } else {
        return none
    }
    let after = substring(s, at + key.byteLength, s.byteLength)
    let mut open = 0
    if let Some(i) = indexOf(after, "\"") {
        open = i
    } else {
        return none
    }
    let body = substring(after, open + 1, after.byteLength)
    let raw = bytes(body)
    let mut i = 0
    while i < raw.length {
        if raw[i] == '\\' {
            i = i + 2
        } else if raw[i] == '"' {
            let mut got: Array<String> = []
            got.push(substring(body, 0, i))
            got.push(substring(body, i + 1, body.byteLength))
            return got
        } else {
            i = i + 1
        }
    }
    return none
}

fn unescapeJson(s: String) -> String {
    return joinWith(split(joinWith(split(s, "\\n"), "\n"), "\\\""), "\"")
}

fn looksLikeSource(text: String) -> Bool {
    return contains(text, "fn ") || startsWith(text, "type ") || contains(text, "\ntype ")
}
