/// The documentation shell's data: the sidebar trees, the pager and the docs
/// subnav. `.page.docs` in `site/public/style.css` lays it out.
///
/// Every row is generated: the reference tree from `apiGroups()`, an area's
/// tree from its chapters. The pager walks the tree the sidebar prints, so the
/// two cannot disagree.
import { apiGroups, apiHref } from "./docs"
import { areaChapters, areaGroups, groupChapters, chapterHref } from "./guide"
import { split } from "std/strings"
import { contains } from "std/strpred"
import { book, bookmark, file, archive, link, settings, activity, code } from icons("bytesize", "book bookmark file archive link settings activity code")
import { Html, toHtmlString } from "std/html"
import { icons, iconAttrs } from "std/icons"

/// One row of the sidebar: where it goes, its label, and `here`, the value of
/// `aria-current`: `"page"` on the page being read, "" elsewhere.
export type TreeRow = { href: String, label: String, here: String }

/// A named run of rows, with its glyph drawn.
export type TreeGroup = { name: String, rows: Array<TreeRow>, icon: String }

/// The links at the foot of the content: the pages before and after this one in
/// the tree. An empty `href` means there is none.
export type Pager = { prevHref: String, prevLabel: String, nextHref: String, nextLabel: String }

/// One glyph as markup for `v-html`: decoration beside a printed name.
fn draw(g: consume Html) -> String {
    return toHtmlString(iconAttrs(g, "", "", ""))
}

/// The glyph a data table names ("file", "archive"), drawn, or "" for a name
/// no generated glyph function has.
fn drawNamed(glyph: String) -> String {
    if glyph == "book" { return draw(book()) }
    if glyph == "bookmark" { return draw(bookmark()) }
    if glyph == "file" { return draw(file()) }
    if glyph == "archive" { return draw(archive()) }
    if glyph == "link" { return draw(link()) }
    if glyph == "settings" { return draw(settings()) }
    if glyph == "code" { return draw(code()) }
    if glyph == "activity" { return draw(activity()) }
    return ""
}

/// `"page"` when `a` and `b` name the same page, and "" when they do not.
fn mark(a: String, b: String) -> String {
    return if a == b { "page" } else { "" }
}

/// The reference's sidebar: the import graph page, then every module in its
/// group. `current` is a module name or a page key such as `"graph"`.
export fn docsTree(current: String) -> Array<TreeGroup> {
    let mut top: Array<TreeRow> = []
    top.push(TreeRow { href: "/docs/graph.html", label: "The import graph", here: mark(current, "graph") })
    let mut out: Array<TreeGroup> = [TreeGroup { name: "Reference", rows: top.copy(), icon: drawNamed("activity") }]
    for g in apiGroups() {
        let mut got: Array<TreeRow> = []
        for m in g.modules {
            got.push(TreeRow { href: apiHref(m.name), label: "std/" + m.name, here: mark(current, m.name) })
        }
        out.push(TreeGroup { name: g.name.copy(), rows: got.copy(), icon: drawNamed(g.icon) })
    }
    return out
}

/// Every area of the documentation, in subnav order: key, landing, label and
/// glyph.
fn areas() -> Array<Array<String>> {
    return [
        ["guide", "/guide.html", "Guide", "book"],
        ["web", "/web.html", "Web", "link"],
        ["tooling", "/tooling.html", "Tooling", "settings"],
        ["reference", "/docs.html", "Reference", "code"],
        ["benchmarks", "/benchmarks.html", "Benchmarks", "activity"],
    ]
}

/// The glyph beside a shelf group's name. Group names are unique across areas.
fn shelfGroupIcon(group: String) -> String {
    let table = [
        ["First steps", "book"],
        ["The memory model", "archive"],
        ["Abstractions", "code"],
        ["Programs", "activity"],
        ["The page", "file"],
        ["The server", "link"],
        ["Commands", "settings"],
        ["Workspace", "bookmark"],
    ]
    for row in table {
        if row[0] == group {
            return row[1].copy()
        }
    }
    return "file"
}

/// One area's sidebar: its named groups, each with its chapters in reading
/// order. Tooling's Workspace group also lists Editors, the one hand-written
/// row.
export fn areaTree(area: String, current: String) -> Array<TreeGroup> {
    let mut out: Array<TreeGroup> = []
    for g in areaGroups(area) {
        let mut rows: Array<TreeRow> = []
        for c in groupChapters(area, g) {
            rows.push(TreeRow { href: chapterHref(c.slug), label: c.title.copy(), here: mark(current, c.slug) })
        }
        if area == "tooling" && g == "Workspace" {
            rows.push(TreeRow { href: "/tooling/editors.html", label: "Editors", here: mark(current, "editors") })
        }
        out.push(TreeGroup { name: g.copy(), rows: rows.copy(), icon: drawNamed(shelfGroupIcon(g)) })
    }
    return out
}

/// The marked row's neighbours across the tree's groups, in the order the
/// sidebar prints them. A tree with nothing marked, as on a landing, gets two
/// empty hrefs.
export fn pagerFor(groups: Array<TreeGroup>) -> Pager {
    let mut flat: Array<TreeRow> = []
    for g in groups {
        for r in g.rows {
            flat.push(TreeRow { href: r.href.copy(), label: r.label.copy(), here: r.here.copy() })
        }
    }
    let mut at = 0 - 1
    let mut i = 0
    while i < flat.length {
        if flat[i].here == "page" {
            at = i
        }
        i = i + 1
    }
    if at < 0 {
        return Pager { prevHref: "", prevLabel: "", nextHref: "", nextLabel: "" }
    }
    let back = at - 1
    let ahead = at + 1
    return Pager {
        prevHref: if back >= 0 { flat[back].href.copy() } else { "" },
        prevLabel: if back >= 0 { flat[back].label.copy() } else { "" },
        nextHref: if ahead < flat.length { flat[ahead].href.copy() } else { "" },
        nextLabel: if ahead < flat.length { flat[ahead].label.copy() } else { "" },
    }
}

/// How many rows a tree holds.
fn treeSize(groups: Array<TreeGroup>) -> Int64 {
    let mut n = 0
    for g in groups {
        n = n + g.rows.length
    }
    return n
}

test "the reference tree carries every module the library documents, once" {
    let tree = docsTree("json")
    let mut modules = 0
    for g in tree {
        if g.name != "Reference" {
            modules = modules + g.rows.length
        }
    }
    let mut all = 0
    for g in apiGroups() {
        all = all + g.modules.length
    }
    assertEq(modules, all)
    // Plus the graph row.
    assertEq(treeSize(tree), all + 1)
}

test "exactly one row is marked, and it is the page that asked" {
    for tree in [docsTree("json"), areaTree("guide", "ownership")] {
        let mut marked = 0
        for g in tree {
            for r in g.rows {
                if r.here == "page" {
                    marked = marked + 1
                }
            }
        }
        assertEq(marked, 1)
    }
    // A landing marks nothing: the subnav marks it.
    for tree in [docsTree("index"), areaTree("guide", "index")] {
        for g in tree {
            for r in g.rows {
                assertEq(r.here, "")
            }
        }
    }
    let none = pagerFor(docsTree("nope"))
    assertEq(none.prevHref, "")
    assertEq(none.nextHref, "")
}

test "the pager walks the tree the sidebar prints" {
    let landing = pagerFor(docsTree("index"))
    assertEq(landing.prevHref, "")
    assertEq(landing.nextHref, "")
    // Keep the tree in a binding: a label read out of an unnamed temporary
    // leaves a hole the release walk cannot skip.
    let tree = docsTree("x")
    let first = tree[0].rows[0].label
    assertEq(first, "The import graph")
    let mid = pagerFor(docsTree("json"))
    assert(mid.prevHref.byteLength > 0)
    assert(mid.nextHref.byteLength > 0)
    let shelf = areaChapters("guide")
    let start = pagerFor(areaTree("guide", shelf[0].slug))
    assertEq(start.prevHref, "")
    let end2 = pagerFor(areaTree("guide", shelf[shelf.length - 1].slug))
    assertEq(end2.nextHref, "")
    let end = pagerFor(areaTree("tooling", "editors"))
    assertEq(end.nextHref, "")
    assert(end.prevHref.byteLength > 0)
}

test "each area's tree covers its shelf, in its named groups" {
    assertEq(treeSize(areaTree("guide", "index")), areaChapters("guide").length)
    assertEq(treeSize(areaTree("web", "index")), areaChapters("web").length)
    assertEq(treeSize(areaTree("tooling", "index")), areaChapters("tooling").length + 1)
    assertEq(areaTree("guide", "index").length, areaGroups("guide").length)
    for g in areaTree("guide", "index") {
        assert(g.rows.length > 0)
        assert(g.name.byteLength > 0)
    }
    let tooling = areaTree("tooling", "editors")
    let last = tooling[tooling.length - 1]
    assertEq(last.name, "Workspace")
    assertEq(last.rows[last.rows.length - 1].label, "Editors")
}

/// The docs subnav under the masthead: one link per area, the current one
/// marked.
export fn docSubnav(current: String) -> String {
    let mut out = ""
    for it in areas() {
        let markAttr = if it[0] == current { " aria-current=\"true\"" } else { "" }
        out = out + "<a href=\"" + it[1] + "\"" + markAttr + ">" + drawNamed(it[3]) + it[2] + "</a>"
    }
    return out
}

test "the subnav names every area and marks exactly one" {
    let html = docSubnav("reference")
    assert(contains(html, "/guide.html"))
    assert(contains(html, "/web.html"))
    assert(contains(html, "/tooling.html"))
    assert(contains(html, "/docs.html"))
    assert(contains(html, "/benchmarks.html"))
    assertEq((split(html, "aria-current").length - 1), 1)
    assert(contains(html, "/docs.html\" aria-current"))
    assertEq((split(docSubnav("nope"), "aria-current").length - 1), 0)
}
