/// The releases feed, as RSS 2.0: one item per tag in the repository's
/// history, newest first.
///
/// An aggregator reads the feed with no page around it, so every URL in it is
/// absolute (`siteOrigin`). An item carries what the repository knows (the tag,
/// its day, whether it is a pre-release) and links to the GitHub release for
/// the notes and archives. There is no `lastBuildDate`: the export has no
/// clock, and the newest item's date answers the same question.
import { Release, releaseRows, fixtureReleaseRows, wholeOf } from "./history"
import { siteOrigin, releaseUrlOf, isPrerelease } from "./repo"
import { hrefOf } from "./nav"
import { escapeHtml } from "./code"
import { substring, split } from "std/strings"
import { startsWith, contains } from "std/strpred"

/// The file the feed publishes as, beside the pages.
export fn feedName() -> String {
    return "releases.xml"
}

/// The feed's own URL, which the `atom:link` element states, because an
/// aggregator handed the file has no other way back to it.
export fn feedUrl() -> String {
    return siteOrigin() + feedName()
}

/// How many releases the feed carries. The export prints it.
export fn feedItemCount() -> Int64 {
    return releaseRows().length
}

/// The whole feed.
export fn feedXml() -> String {
    return feedOf(releaseRows())
}

/// The feed for `rows`, oldest first. With no rows it is a channel with no
/// items, and its description says that nothing has been published.
fn feedOf(rows: Array<Release>) -> String {
    let mut out = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
    out = out + "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">\n<channel>\n"
    out = out + "<title>Vyrn releases</title>\n"
    out = out + "<link>\{siteOrigin()}\{substring(hrefOf("/releases"), 1, hrefOf("/releases").byteLength)}</link>\n"
    out = out + "<atom:link href=\"\{feedUrl()}\" rel=\"self\" type=\"application/rss+xml\"/>\n"
    out = out + "<description>\{channelWords(rows.length)}</description>\n"
    out = out + "<language>en</language>\n"
    // Newest first, which is the order a reader's aggregator shows them in and
    // the reverse of the order the history writes them in.
    let mut i = rows.length - 1
    while i >= 0 {
        out = out + item(rows[i].tag, rows[i].date)
        i = i - 1
    }
    return out + "</channel>\n</rss>\n"
}

/// What the channel says it holds. An aggregator shows this for an empty feed,
/// so with no release it says so instead of promising items.
fn channelWords(count: Int64) -> String {
    if count == 0 {
        return "Every published Vyrn release. None has been published, so the feed has no items."
    }
    return "Every published Vyrn release: the tag, the day it was published, and whether it is a pre-release."
}

/// One release, as an item. The `guid` is the release page's URL with
/// `isPermaLink="true"`, so an aggregator shows a tag once however often the
/// feed is rebuilt.
fn item(tag: String, date: String) -> String {
    let url = releaseUrlOf(tag)
    let kind = if isPrerelease(tag) { "A pre-release" } else { "A stable release" }
    let words = "\{kind}, tagged \{date}. The release page lists one archive per platform and the SHA256SUMS that both installers check them against."
    let mut out = "<item>\n"
    out = out + "<title>\{escapeHtml(tag)}</title>\n"
    out = out + "<link>\{escapeHtml(url)}</link>\n"
    out = out + "<guid isPermaLink=\"true\">\{escapeHtml(url)}</guid>\n"
    out = out + "<pubDate>\{rfc822(date)}</pubDate>\n"
    out = out + "<description>\{escapeHtml(words)}</description>\n"
    return out + "</item>\n"
}

/// `2026-08-19` as `Wed, 19 Aug 2026 00:00:00 GMT`, the RFC 822 date RSS
/// takes. Midnight UTC, because the history records the day only.
fn rfc822(date: String) -> String {
    let parts = split(date, "-")
    if parts.length != 3 {
        return date.copy()
    }
    let y = wholeOf(parts[0])
    let m = wholeOf(parts[1])
    let d = wholeOf(parts[2])
    return "\{dayName(y, m, d)}, \{parts[2]} \{monthName(m)} \{parts[0]} 00:00:00 GMT"
}

/// The three-letter day of the week, by Zeller's congruence.
/// `site/test/feed.test.mjs` checks every one against the platform's calendar.
fn dayName(y: Int64, m: Int64, d: Int64) -> String {
    // January and February are months 13 and 14 of the year before, so one
    // formula covers a leap day.
    let year = if m < 3 { y - 1 } else { y }
    let month = if m < 3 { m + 12 } else { m }
    let c = year / 100
    let k = year % 100
    let h = (d + (13 * (month + 1)) / 5 + k + k / 4 + c / 4 + 5 * c) % 7
    // Zeller counts from Saturday.
    let names = ["Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri"]
    return names[h].copy()
}

/// The three-letter month name, or "" for a number outside 1..12.
fn monthName(m: Int64) -> String {
    let names = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    if m < 1 || m > 12 {
        return ""
    }
    return names[m].copy()
}

test "a date becomes the RFC 822 date RSS reads" {
    assertEq(rfc822("2026-08-12"), "Wed, 12 Aug 2026 00:00:00 GMT")
    assertEq(rfc822("2026-08-19"), "Wed, 19 Aug 2026 00:00:00 GMT")
    assertEq(rfc822("2026-01-01"), "Thu, 01 Jan 2026 00:00:00 GMT")
    assertEq(rfc822("2026-02-28"), "Sat, 28 Feb 2026 00:00:00 GMT")
    // A leap day, and the century rule under it.
    assertEq(rfc822("2024-02-29"), "Thu, 29 Feb 2024 00:00:00 GMT")
    assertEq(rfc822("2000-03-01"), "Wed, 01 Mar 2000 00:00:00 GMT")
    // A date that is not a date stays as it is.
    assertEq(rfc822("nonsense"), "nonsense")
}

test "the feed is one channel with one item per release" {
    assertEq(feedFault(releaseRows()), "")
    let empty: Array<Release> = []
    assertEq(feedFault(empty), "")
    assert(contains(feedOf(empty), "None has been published"))
    // The fixture's one release is a pre-release.
    let rows = fixtureReleaseRows()
    assert(rows.length > 0)
    assertEq(feedFault(rows), "")
    assert(contains(feedOf(rows), "A pre-release, tagged"))
    assert(!contains(feedOf(rows), "None has been published"))
}

test "the feed carries no unescaped markup and no relative link" {
    let empty: Array<Release> = []
    assertEq(linkFault(feedOf(empty), empty), "")
    assertEq(linkFault(feedOf(fixtureReleaseRows()), fixtureReleaseRows()), "")
    assertEq(linkFault(feedXml(), releaseRows()), "")
}

/// The first fact the feed of `rows` breaks, or "": one channel, each release
/// exactly once, newest first.
fn feedFault(rows: Array<Release>) -> String {
    let xml = feedOf(rows)
    if !startsWith(xml, "<?xml version=\"1.0\" encoding=\"utf-8\"?>") {
        return "no XML declaration first"
    }
    if timesIn(xml, "<rss version=\"2.0\"") != 1 || timesIn(xml, "<channel>") != 1 {
        return "not one RSS 2.0 channel"
    }
    if !contains(xml, "<atom:link href=\"\{feedUrl()}\" rel=\"self\"") {
        return "no self link"
    }
    for r in rows {
        if timesIn(xml, "<title>\{r.tag}</title>") != 1 {
            return "\{r.tag} is not one title"
        }
        if timesIn(xml, "https://github.com/vyrn-lang/vyrn/releases/tag/\{r.tag}") != 2 {
            return "\{r.tag} is not one link and one guid"
        }
    }
    if timesIn(xml, "<item>") != rows.length || timesIn(xml, "</item>") != rows.length {
        return "not one item per release"
    }
    if rows.length > 0 && !contains(xml, "<item>\n<title>\{rows[rows.length - 1].tag}</title>") {
        return "the newest release is not the first item"
    }
    return ""
}

/// The first URL in `xml` that is not absolute, or a tag in `rows` that could
/// end an element, or "". An aggregator has no document to resolve against.
fn linkFault(xml: String, rows: Array<Release>) -> String {
    if timesIn(xml, "<link>\{siteOrigin()}") != 1 || timesIn(xml, "href=\"\{siteOrigin()}") != 1 {
        return "the channel does not link the site's origin once"
    }
    if timesIn(xml, "<link>https://") != 1 + rows.length {
        return "a link is not absolute"
    }
    if timesIn(xml, "<link>/") != 0 || timesIn(xml, "href=\"/") != 0 {
        return "a link is relative"
    }
    if timesIn(xml, "<guid isPermaLink=\"true\">https://") != rows.length {
        return "a guid is not an absolute permalink"
    }
    for r in rows {
        if contains(r.tag, "<") {
            return "\{r.tag} holds markup"
        }
    }
    if !contains(xml, "<description>Every published Vyrn release") {
        return "the channel has no description"
    }
    return ""
}

/// How many times `needle` occurs in `hay`, without overlap.
fn timesIn(hay: String, needle: String) -> Int64 {
    return split(hay, needle).length - 1
}
