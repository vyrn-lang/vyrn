import { substring, split, joinWith, trim, trimEnd } from "std/strings"
import { startsWith, endsWith } from "std/strpred"
import { escapeHtml } from "./code"
import { highlightSrc, lineStarts } from "./hl"
import { quoted, quotedList, branch, lookup, vyrnStems } from "./gensrc"

type Entry = { name: String, kind: String, sig: String, doc: String, line: Int64 }

type Mod = { name: String, doc: String, entries: Array<Entry>, tests: Array<String> }

gen fn offsetOf(starts: Array<Int64>, t: Token) -> Int64 {
    return starts[t.line - 1] + t.col - 1
}

/// The brace rule goes first: a record's closing `}` is itself in column 1.
gen fn sigEnd(toks: Array<Token>, from: Int64, head: String) -> Int64 {
    let mut depth = 0
    let mut i = from
    while i < toks.length {
        let t = toks[i]
        if t.kind == "punct" && t.text == "{" {
            if depth == 0 && head == "fn" {
                return i
            }
            depth = depth + 1
        }
        if t.kind == "punct" && t.text == "}" {
            depth = depth - 1
            if depth == 0 && (head == "protocol" || head == "type") {
                return i + 1
            }
        }
        if head == "type" && depth == 0 && i > from && t.col == 1 {
            return i
        }
        i = i + 1
    }
    return toks.length
}

fn trimTail(s: String) -> String {
    let all = split(s, "\n")
    let mut keep = all.length
    let mut done = false
    while keep > 0 && !done {
        let last = trim(all[keep - 1])
        if last.byteLength > 0 && !startsWith(last, "//") {
            done = true
        } else {
            keep = keep - 1
        }
    }
    let mut out: Array<String> = []
    let mut i = 0
    while i < keep {
        out.push(trimEnd(all[i]))
        i = i + 1
    }
    return joinWith(out, "\n")
}

gen fn declAt(src: String, toks: Array<Token>, starts: Array<Int64>, i: Int64, doc: String) -> Entry {
    let none = Entry { name: "", kind: "", sig: "", doc: "", line: 0 }
    if i + 2 >= toks.length {
        return none
    }
    let first = i + 1
    let mut j = first
    if toks[j].text == "gen" {
        j = j + 1
    }
    let head = toks[j].text.copy()
    if head != "fn" && head != "type" && head != "protocol" {
        return none
    }
    if j + 1 >= toks.length {
        return none
    }
    let stop = sigEnd(toks, j, head)
    let from = offsetOf(starts, toks[first])
    let to = if stop < toks.length { offsetOf(starts, toks[stop]) } else { bytes(src).length }
    return Entry {
        name: toks[j + 1].text.copy(),
        kind: if head == "fn" { "fn" } else { head.copy() },
        sig: trimTail(substring(src, from, to)),
        doc: doc.copy(),
        line: toks[first].line,
    }
}

gen fn exportsOf(src: String, toks: Array<Token>) -> Array<Entry> {
    let starts = lineStarts(src)
    let mut out: Array<Entry> = []
    let mut docBuf: Array<String> = []
    let mut docEnd = 0 - 2
    let mut i = 0
    while i < toks.length {
        let t = toks[i]
        if t.kind == "doc" {
            if t.line != docEnd + 1 {
                docBuf = []
            }
            docBuf.push(t.text.copy())
            docEnd = t.line
        } else {
            if t.kind == "keyword" && t.text == "export" && t.col == 1 {
                let doc = if docEnd + 1 == t.line { joinWith(docBuf, "\n") } else { "" }
                let e = declAt(src, toks, starts, i, doc)
                if e.kind.byteLength > 0 {
                    out.push(e)
                }
            }
            docBuf = []
            docEnd = 0 - 2
        }
        i = i + 1
    }
    return out
}

gen fn testNames(toks: Array<Token>) -> Array<String> {
    let mut out: Array<String> = []
    let mut i = 0
    while i + 1 < toks.length {
        if toks[i].text == "test" && toks[i].col == 1 && toks[i + 1].kind == "string" {
            out.push(toks[i + 1].text.copy())
        }
        i = i + 1
    }
    return out
}

gen fn headerDoc(toks: Array<Token>) -> String {
    let mut out: Array<String> = []
    let mut i = 0
    while i < toks.length && toks[i].kind == "doc" {
        out.push(toks[i].text.copy())
        i = i + 1
    }
    return joinWith(out, "\n")
}

fn tickHtml(escaped: String) -> String {
    let parts = split(escaped, "`")
    let mut markers = 0
    let mut i = 0
    while i < parts.length {
        let code = i % 2 == 1 && i + 1 < parts.length
        if !code {
            markers = markers + split(parts[i], "**").length - 1
        }
        i = i + 1
    }
    let mut out = ""
    let mut seen = 0
    i = 0
    while i < parts.length {
        if i % 2 == 1 && i + 1 < parts.length {
            out = out + "<code>" + parts[i] + "</code>"
        } else {
            let piece = if i % 2 == 1 { "`" + parts[i] } else { parts[i].copy() }
            let bits = split(piece, "**")
            let mut j = 0
            while j < bits.length {
                out = out + bits[j]
                if j + 1 < bits.length {
                    if seen == markers - 1 && markers % 2 == 1 {
                        out = out + "**"
                    } else {
                        out = out + if seen % 2 == 0 { "<strong>" } else { "</strong>" }
                    }
                    seen = seen + 1
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn inlineHtml(s: String) -> String {
    let parts = split(escapeHtml(s), "``")
    let mut out = ""
    let mut i = 0
    while i < parts.length {
        if i % 2 == 1 && i + 1 < parts.length {
            out = out + "<code>" + trim(parts[i]) + "</code>"
        } else if i % 2 == 1 {
            out = out + "``" + tickHtml(parts[i])
        } else {
            out = out + tickHtml(parts[i])
        }
        i = i + 1
    }
    return out
}

gen fn blockHtml(kind: String, rows: Array<String>) -> String {
    if rows.length == 0 {
        return ""
    }
    if kind == "code" {
        // A backtick is not Vyrn, and `lex` would give up on the whole block.
        let mut body = ""
        for row in rows {
            let mut inner = trimEnd(row)
            let core = trim(inner)
            if core.byteLength > 1 && startsWith(core, "`") && endsWith(core, "`") {
                let lead = substring(inner, 0, inner.byteLength - core.byteLength)
                inner = lead + substring(core, 1, core.byteLength - 1)
            }
            body = body + inner + "\n"
        }
        let src = trimEnd(body) + "\n"
        return "<pre class=\"doccode\">" + highlightSrc(src, lex(src)) + "</pre>"
    }
    if kind == "list" {
        let mut out = "<ul class=\"docprose\">"
        for row in rows {
            out = out + "<li>" + inlineHtml(row) + "</li>"
        }
        return out + "</ul>"
    }
    return "<p>" + inlineHtml(joinWith(rows, " ")) + "</p>"
}

fn indentOf(line: String) -> Int64 {
    let raw = bytes(line)
    let mut i = 0
    while i < raw.length && raw[i] == ' ' {
        i = i + 1
    }
    return i
}

gen fn proseHtml(doc: String) -> String {
    if doc.byteLength == 0 {
        return ""
    }
    let mut out = ""
    let mut kind = ""
    let mut rows: Array<String> = []
    let mut fenced = false
    let mut margin = 0
    let ls = split(doc, "\n")
    let mut i = 0
    while i < ls.length {
        let line = ls[i]
        let flat = trim(line)
        if !fenced && isBanner(flat) && i + 2 < ls.length && trim(ls[i + 1]).byteLength > 0 && isBanner(trim(ls[i + 2])) {
            out = out + blockHtml(kind, rows)
            rows = []
            kind = ""
            out = out + "<h3>" + inlineHtml(trim(ls[i + 1])) + "</h3>"
            i = i + 3
            continue
        }
        if startsWith(flat, "```") {
            if fenced {
                out = out + blockHtml("code", rows)
                rows = []
                kind = ""
            } else {
                out = out + blockHtml(kind, rows)
                rows = []
                kind = "code"
            }
            fenced = !fenced
        } else if fenced {
            rows.push(line.copy())
        } else if flat.byteLength == 0 {
            out = out + blockHtml(kind, rows)
            rows = []
            kind = ""
        } else if startsWith(flat, "- ") {
            if kind != "list" {
                out = out + blockHtml(kind, rows)
                rows = []
                kind = "list"
            }
            rows.push(substring(flat, 2, flat.byteLength))
        } else if kind == "list" {
            rows[rows.length - 1] = rows[rows.length - 1] + " " + flat
        } else if indentOf(line) >= 2 && (kind != "para" || endsWith(rows[rows.length - 1], ":")) {
            if kind != "code" {
                out = out + blockHtml(kind, rows)
                rows = []
                kind = "code"
                margin = indentOf(line)
            }
            let cut = if indentOf(line) < margin { indentOf(line) } else { margin }
            rows.push(substring(line, cut, line.byteLength))
        } else {
            if kind == "code" {
                out = out + blockHtml(kind, rows)
                rows = []
            }
            kind = "para"
            rows.push(flat.copy())
        }
        i = i + 1
    }
    return out + blockHtml(kind, rows)
}

fn isBanner(t: String) -> Bool {
    if t.byteLength < 3 {
        return false
    }
    for b in bytes(t) {
        if b != '=' {
            return false
        }
    }
    return true
}

fn summaryOf(doc: String) -> String {
    let mut flat = ""
    for line in split(doc, "\n") {
        let t = trim(line)
        if t.byteLength == 0 {
            if flat.byteLength > 0 {
                break
            }
        } else {
            flat = if flat.byteLength == 0 { t.copy() } else { flat + " " + t }
        }
    }
    let mut cut = flat.byteLength
    let raw = bytes(flat)
    let mut i = 0
    while i + 1 < raw.length {
        if raw[i] == '.' && raw[i + 1] == ' ' {
            cut = i + 1
            break
        }
        i = i + 1
    }
    return inlineHtml(substring(flat, 0, cut))
}

/// Mirrors `is_fenced` in `compiler/vyrn-frontend/src/loader.rs`, which a generator cannot call.
fn fenced(name: String) -> Bool {
    return name == "mem" || name == "runtime"
}

export gen fn apiDocs(stdDir: String) -> String {
    let mut mods: Array<Mod> = []
    for name in vyrnStems(stdDir) {
        if !fenced(name) {
            let src = match readFile(stdDir + "/" + name + ".vyrn") {
                Ok(text) => text,
                Err(why) => "",
            }
            let toks = lex(src)
            mods.push(Mod {
                name: name.copy(),
                doc: headerDoc(toks),
                entries: exportsOf(src, toks),
                tests: testNames(toks),
            })
        }
    }

    let mut names: Array<String> = []
    let mut summaries: Array<String> = []
    let mut intros: Array<String> = []
    let mut nameLists: Array<String> = []
    let mut kindLists: Array<String> = []
    let mut sigLists: Array<String> = []
    let mut proseLists: Array<String> = []
    let mut lineLists: Array<String> = []
    let mut testLists: Array<String> = []
    let mut counts: Array<String> = []
    for m in mods {
        names.push(m.name.copy())
        summaries.push(branch("m", m.name, quoted(summaryOf(m.doc))))
        intros.push(branch("m", m.name, quoted(proseHtml(m.doc))))
        let mut en: Array<String> = []
        let mut ek: Array<String> = []
        let mut es: Array<String> = []
        let mut ep: Array<String> = []
        let mut el: Array<String> = []
        for e in m.entries {
            en.push(e.name.copy())
            ek.push(e.kind.copy())
            es.push(highlightSrc(e.sig, lex(e.sig)))
            ep.push(proseHtml(e.doc))
            el.push(e.line.toString())
        }
        nameLists.push(branch("m", m.name, quotedList(en)))
        kindLists.push(branch("m", m.name, quotedList(ek)))
        sigLists.push(branch("m", m.name, quotedList(es)))
        proseLists.push(branch("m", m.name, quotedList(ep)))
        lineLists.push(branch("m", m.name, "[" + joinWith(el, ", ") + "]"))
        testLists.push(branch("m", m.name, quotedList(m.tests)))
        counts.push(branch("m", m.name, m.entries.length.toString()))
    }

    let mut out = "/// The standard library reference, read off `std/` by `site/app/apidoc.vyrn`\n/// while the site compiled. Do not edit.\n"
    out = out + "/// Every documented module, sorted.\n"
    out = out + "export fn docModules() -> Array<String> { return " + quotedList(names) + " }\n"
    out = out + "/// The first sentence of a module's header block.\n"
    out = out + lookup("docSummary", "m", "String", summaries, "\"\"")
    out = out + "/// A module's header block, as HTML.\n"
    out = out + lookup("docIntro", "m", "String", intros, "\"\"")
    out = out + "/// The names of a module's exports, in declaration order.\n"
    out = out + lookup("docNames", "m", "Array<String>", nameLists, "[]")
    out = out + "/// What each export is: `fn`, `type` or `protocol`.\n"
    out = out + lookup("docKinds", "m", "Array<String>", kindLists, "[]")
    out = out + "/// Each export's signature, coloured by the compiler's own lexer.\n"
    out = out + lookup("docSigs", "m", "Array<String>", sigLists, "[]")
    out = out + "/// Each export's `///` prose, as HTML.\n"
    out = out + lookup("docProse", "m", "Array<String>", proseLists, "[]")
    out = out + "/// The source line each export is declared on.\n"
    out = out + lookup("docLines", "m", "Array<Int64>", lineLists, "[]")
    out = out + "/// The name of every `test` block the module keeps, in source order.\n"
    out = out + lookup("docTests", "m", "Array<String>", testLists, "[]")
    out = out + "/// How many exports a module has.\n"
    out = out + lookup("docCount", "m", "Int64", counts, "0")
    return out
}

test "a code span becomes a code element and a stray tick stays text" {
    assertEq(inlineHtml("call `min(a, b)` first"), "call <code>min(a, b)</code> first")
    assertEq(inlineHtml("``field `name` `` is the key"), "<code>field `name`</code> is the key")
    assertEq(inlineHtml("a ` b"), "a ` b")
    assertEq(inlineHtml("2 < 3"), "2 &lt; 3")
}

test "the four prose shapes render" {
    assertEq(proseHtml("one line"), "<p>one line</p>")
    assertEq(proseHtml("one\ntwo"), "<p>one two</p>")
    assertEq(proseHtml("- a\n- b"), "<ul class=\"docprose\"><li>a</li><li>b</li></ul>")
    assertEq(proseHtml("    let a = 1"), "<pre class=\"doccode\"><span class=\"k\">let</span> a = <span class=\"n\">1</span>\n</pre>")
    assertEq(proseHtml("one\n\ntwo"), "<p>one</p><p>two</p>")
}

test "a list item wraps onto the next line, however far it is indented" {
    assertEq(proseHtml("- a\n  more"), "<ul class=\"docprose\"><li>a more</li></ul>")
    assertEq(proseHtml(" - a\n     more"), "<ul class=\"docprose\"><li>a more</li></ul>")
}

test "an emphasised pair is emphasis and a lone marker is text" {
    assertEq(inlineHtml("**loud** and `**quiet**`"), "<strong>loud</strong> and <code>**quiet**</code>")
    assertEq(inlineHtml("a **`chars` and `colAt` are retired** now"), "a <strong><code>chars</code> and <code>colAt</code> are retired</strong> now")
    assertEq(inlineHtml("**a `b`"), "**a <code>b</code>")
    assertEq(inlineHtml("**one** and ** alone"), "<strong>one</strong> and ** alone")
    assertEq(inlineHtml("2 ** 3"), "2 ** 3")
}

test "the summary is the first sentence of the first paragraph" {
    assertEq(summaryOf("std/math — helpers. And more.\n\nlater"), "std/math — helpers.")
    assertEq(summaryOf("no full stop here"), "no full stop here")
}

test "the trailing comment between two declarations is not part of a signature" {
    assertEq(trimTail("type A = Int64\n\n// a note\n"), "type A = Int64")
    assertEq(trimTail("fn f() -> Int64 "), "fn f() -> Int64")
}
