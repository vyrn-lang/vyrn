/// The site's `<Icon>` component: a capitalized tag resolves against what a
/// `<script>` imports, so `<Icon>` exists because this file exports it.
///
/// `std/icons` draws the glyph. The prefixes `bytesize` and `codex` are keys in
/// this project's `vyrn.json`, pinned and hash-locked in `vyrn.lock`, so the
/// collections come from the content cache and nothing is fetched at run time.
///
///   <script>
///   import { Icon } from "../icons"
///   </script>
///   <template>
///   <a href="..."><Icon name="bytesize:github"/> Source on GitHub</a>
///   </template>
///
/// `name` is required; `size`, `label` and `class` are optional, and any other
/// attribute is refused. A glyph with no `label` is `aria-hidden` decoration;
/// give it a `label` when the icon is the only label, and it becomes
/// `role="img"` with that name.
import { iconProvider } from "std/icons"

/// One `<Icon>` tag: its static attributes as a JSON object, and where it was
/// written, so a misspelled glyph is reported there.
export gen fn Icon(attrs: String, file: String, line: Int64, col: Int64) -> String {
    return iconProvider(attrs, file, line, col, "bytesize codex")
}
