import { moduleDeps } from "./deps"
import { depUses, depUsedBy, depDepth, depExamples } from moduleDeps("../../std", "../../examples")
import { apiModules, apiGroups, apiEntries, apiHref } from "./docs"
import { joinWith, toLower } from "std/strings"
import { contains } from "std/strpred"
import { stripTags, decodeEntities } from "./meta"
import { Markup } from "std/html"

export type SearchRow = { name: String, href: String, summary: Markup, count: Int64, exports: Array<String>, q: String, e: String }

export type GraphNode = { name: String, href: String, x: String, y: String, tx: String, ty: String, hx: String, hy: String, w: String, uses: String, usedBy: String, label: String }

export type GraphEdge = { id: String, d: String, from: String, to: String }

export fn searchRows() -> Array<SearchRow> {
    let mut out: Array<SearchRow> = []
    for m in apiModules() {
        let mut names: Array<String> = []
        for e in apiEntries(m.name) {
            names.push(e.name.copy())
        }
        let joined = joinWith(names, " ")
        out.push(SearchRow {
            name: m.name.copy(),
            href: apiHref(m.name),
            summary: TrustedMarkup(m.summary.copy()),
            count: m.count,
            exports: names.copy(),
            q: toLower(m.name + " " + joined + " " + decodeEntities(stripTags(m.summary))),
            e: joined,
        })
    }
    return out
}

export type SearchGroup = { name: String, rows: Array<SearchRow> }

export fn searchGroups() -> Array<SearchGroup> {
    let rows = searchRows()
    let mut out: Array<SearchGroup> = []
    for g in apiGroups() {
        let mut got: Array<SearchRow> = []
        for m in g.modules {
            for r in rows {
                if r.name == m.name {
                    got.push(SearchRow {
                        name: r.name.copy(),
                        href: r.href.copy(),
                        summary: r.summary.copy(),
                        count: r.count,
                        exports: r.exports.copy(),
                        q: r.q.copy(),
                        e: r.e.copy(),
                    })
                }
            }
        }
        out.push(SearchGroup { name: g.name.copy(), rows: got.copy() })
    }
    return out
}

let mut depthCache: Map<String, Int64> = [:]

fn depthOf(name: String) -> Int64 {
    if let Some(hit) = depthCache[name] {
        return hit
    }
    let d = depDepth(name)
    depthCache[name.copy()] = d
    return d
}

let mut deepestCache = 0 - 1

fn deepest() -> Int64 {
    if deepestCache >= 0 {
        return deepestCache
    }
    let mut d = 0
    for m in apiModules() {
        if depthOf(m.name) > d {
            d = depthOf(m.name)
        }
    }
    deepestCache = d
    return d
}

let mut layers: Map<String, Array<String>> = [:]

fn layer(d: Int64) -> Array<String> {
    let key = d.toString()
    if let Some(hit) = layers[key] {
        return hit.copy()
    }
    let mut out: Array<String> = []
    for m in apiModules() {
        if depthOf(m.name) == d {
            out.push(m.name.copy())
        }
    }
    layers[key.copy()] = out.copy()
    return out
}

fn tallest() -> Int64 {
    let mut n = 0
    let mut d = 0
    let last = deepest()
    while d <= last {
        if layer(d).length > n {
            n = layer(d).length
        }
        d = d + 1
    }
    return n
}

fn columnStep() -> Int64 {
    return 150
}

fn rowStep() -> Int64 {
    return 24
}

fn columnX(d: Int64) -> Int64 {
    return 16 + d * columnStep()
}

fn rowY(i: Int64) -> Int64 {
    return 40 + i * rowStep()
}

fn labelWidth(name: String) -> Int64 {
    return 7 * name.byteLength
}

let mut rowIndex: Map<String, Int64> = [:]

fn rowOf(name: String) -> Int64 {
    if let Some(hit) = rowIndex[name] {
        return hit
    }
    let mut i = 0
    for m in layer(depthOf(name)) {
        if m == name {
            rowIndex[name.copy()] = i
            return i
        }
        i = i + 1
    }
    rowIndex[name.copy()] = 0
    return 0
}

fn nodeX(name: String) -> Int64 {
    return columnX(depthOf(name))
}

fn nodeY(name: String) -> Int64 {
    return rowY(rowOf(name))
}

export fn graphWidth() -> Int64 {
    return columnX(deepest()) + 110
}

fn graphHeight() -> Int64 {
    return rowY(tallest()) + 8
}

export fn graphViewBox() -> String {
    return "0 0 " + graphWidth().toString() + " " + graphHeight().toString()
}

export fn graphNodes() -> Array<GraphNode> {
    let mut out: Array<GraphNode> = []
    for m in apiModules() {
        out.push(GraphNode {
            name: m.name.copy(),
            href: apiHref(m.name),
            x: nodeX(m.name).toString(),
            y: nodeY(m.name).toString(),
            tx: (nodeX(m.name) + 10).toString(),
            ty: (nodeY(m.name) + 4).toString(),
            hx: (nodeX(m.name) - 6).toString(),
            hy: (nodeY(m.name) - 9).toString(),
            w: (labelWidth(m.name) + 20).toString(),
            uses: joinWith(depUses(m.name), " "),
            usedBy: joinWith(depUsedBy(m.name), " "),
            label: nodeLabel(m.name),
        })
    }
    return out
}

fn nodeLabel(name: String) -> String {
    let uses = depUses(name).length
    let usedBy = depUsedBy(name).length
    return "std/" + name + ", imports " + countWord(uses) + ", imported by " + countWord(usedBy)
}

fn countWord(n: Int64) -> String {
    if n == 0 {
        return "no modules"
    }
    if n == 1 {
        return "1 module"
    }
    return n.toString() + " modules"
}

fn wire(from: String, to: String) -> String {
    let x1 = nodeX(from) - 6
    let y1 = nodeY(from)
    let x2 = nodeX(to) + labelWidth(to) + 12
    let y2 = nodeY(to)
    let c1 = x1 - 40
    let c2 = x2 + 40
    return "M \{x1} \{y1} C \{c1} \{y1}, \{c2} \{y2}, \{x2} \{y2}"
}

export fn graphEdges() -> Array<GraphEdge> {
    let mut out: Array<GraphEdge> = []
    for m in apiModules() {
        for u in depUses(m.name) {
            out.push(GraphEdge { id: m.name + "-" + u, d: wire(m.name, u), from: m.name.copy(), to: u.copy() })
        }
    }
    return out
}

export fn edgeCount() -> Int64 {
    return graphEdges().length
}

export fn leafCount() -> Int64 {
    return layer(0).length
}

export fn examplesUsing(m: String) -> Array<String> {
    let mut out: Array<String> = []
    for e in depExamples(m) {
        out.push("examples/" + e)
    }
    return out
}

export fn usesOfModule(m: String) -> Array<String> {
    return depUses(m)
}

export fn usedByModule(m: String) -> Array<String> {
    return depUsedBy(m)
}

test "every module is a row, and every row carries its own search text" {
    let rows = searchRows()
    assertEq(rows.length, apiModules().length)
    for r in rows {
        assert(r.name.byteLength > 0)
        assert(r.count > 0)
        assertEq(r.exports.length, r.count)
        assertEq(r.q, toLower(r.q))
        assert(r.q.byteLength > r.name.byteLength)
    }
}

test "a summary's tags are not part of what a search matches" {
    assertEq(decodeEntities(stripTags("an <code>Option&lt;T&gt;</code> &amp; &quot;q&quot;&#39;s")), "an Option<T> & \"q\"'s")
    let mut sawVyx = false
    for r in searchRows() {
        if r.name == "vyx" {
            sawVyx = contains(r.q, ".vyx") && !contains(r.q, "<code>")
        }
        assert(!contains(r.q, "&lt;"))
        assert(!contains(r.q, "&gt;"))
        assert(!contains(r.q, "&amp;"))
    }
    assert(sawVyx)
}

test "every node sits in a column, and no two share a place" {
    let nodes = graphNodes()
    assertEq(nodes.length, apiModules().length)
    for a in nodes {
        let mut same = 0
        for b in nodes {
            if a.x == b.x && a.y == b.y {
                same = same + 1
            }
        }
        assertEq(same, 1)
    }
    assert(graphWidth() > 300)
    assert(graphHeight() > 200)
}

test "every wire joins two modules the graph draws" {
    let edges = graphEdges()
    assert(edges.length > 40)
    for e in edges {
        let mut fromFound = false
        let mut toFound = false
        for n in graphNodes() {
            if n.name == e.from {
                fromFound = true
            }
            if n.name == e.to {
                toFound = true
            }
        }
        assert(fromFound)
        assert(toFound)
        assert(e.from != e.to)
        assert(e.d.byteLength > 10)
    }
}

test "a module sits deeper than everything it imports" {
    for m in apiModules() {
        for u in depUses(m.name) {
            assert(depDepth(u) < depDepth(m.name))
        }
    }
}

test "the graph and the reference agree about what imports what" {
    assertEq(depUses("json").length, 0)
    assert(depUsedBy("json").length > 3)
    assert(depUses("jsonread").length > 0)
    assert(examplesUsing("json").length > 0)
    assertEq(examplesUsing("nope").length, 0)
}

export fn graphLede() -> Markup {
    return TrustedMarkup("Every wire is an <code>import</code> line in <code>std/</code>. " + leafCount().toString() + " modules import nothing else in the library.")
}

export fn graphIntro() -> String {
    return "A module sits in the column after the deepest thing it imports, so nothing on the left imports anything on the right."
}

export fn graphCaption() -> Markup {
    return TrustedMarkup("Read from the <code>import</code> lines of <code>std/*.vyrn</code>.")
}
