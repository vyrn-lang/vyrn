/// The reference's module index and its import graph, both from `deps.vyrn`'s
/// reading of the `import` lines.
///
/// Each index row carries its own search text in `data-q` and its export names
/// in `data-e`, so the page filters with no fetch and works with no script.
/// The graph has one node per module and one wire per import, laid out in
/// columns by depth; every coordinate is computed here, and the script only
/// lights the wires of the module under the pointer.
import { moduleDeps } from "./deps"
import { depUses, depUsedBy, depDepth, depExamples } from moduleDeps("../../std", "../../examples")
import { apiModules, apiGroups, apiEntries, apiHref } from "./docs"
import { joinWith, toLower } from "std/strings"
import { contains } from "std/strpred"
import { stripTags, decodeEntities } from "./meta"

/// One row of the index: a module, what it is, and every name it exports.
export type SearchRow = { name: String, href: String, summary: String, count: Int64, exports: Array<String>, q: String, e: String }

/// One node of the graph: where it sits, what it is called, and the two lists
/// the highlight needs.
export type GraphNode = { name: String, href: String, x: String, y: String, tx: String, ty: String, hx: String, hy: String, w: String, uses: String, usedBy: String, label: String }

/// One wire: the path, and the two modules it joins.
export type GraphEdge = { id: String, d: String, from: String, to: String }

/// Every module, with everything a search over it can match.
export fn searchRows() -> Array<SearchRow> {
    let mut out: Array<SearchRow> = []
    for m in apiModules() {
        let mut names: Array<String> = []
        for e in apiEntries(m.name) {
            names.push(e.name.copy())
        }
        let joined = joinWith(names, " ")
        out.push(SearchRow {
            name: m.name.copy(),
            href: apiHref(m.name),
            summary: m.summary.copy(),
            count: m.count,
            exports: names.copy(),
            // The module name, every export name and the summary's words,
            // lowercased.
            q: toLower(m.name + " " + joined + " " + decodeEntities(stripTags(m.summary))),
            e: joined,
        })
    }
    return out
}

/// One named group of index rows. A group whose rows the search hides all of
/// hides itself in the stylesheet with `:has`.
export type SearchGroup = { name: String, rows: Array<SearchRow> }

/// The index, in `docs.vyrn`'s groups and in its order.
export fn searchGroups() -> Array<SearchGroup> {
    let rows = searchRows()
    let mut out: Array<SearchGroup> = []
    for g in apiGroups() {
        let mut got: Array<SearchRow> = []
        for m in g.modules {
            for r in rows {
                if r.name == m.name {
                    got.push(SearchRow {
                        name: r.name.copy(),
                        href: r.href.copy(),
                        summary: r.summary.copy(),
                        count: r.count,
                        exports: r.exports.copy(),
                        q: r.q.copy(),
                        e: r.e.copy(),
                    })
                }
            }
        }
        out.push(SearchGroup { name: g.name.copy(), rows: got.copy() })
    }
    return out
}

// The layout is a pure function of the module set, so every step of it is
// memoised: computed per node and per wire, `/docs/graph` measured 6.7 s of
// a 95 s export.
let mut depthCache: Map<String, Int64> = [:]

fn depthOf(name: String) -> Int64 {
    if let Some(hit) = depthCache[name] {
        return hit
    }
    let d = depDepth(name)
    depthCache[name.copy()] = d
    return d
}

let mut deepestCache = 0 - 1

fn deepest() -> Int64 {
    if deepestCache >= 0 {
        return deepestCache
    }
    let mut d = 0
    for m in apiModules() {
        if depthOf(m.name) > d {
            d = depthOf(m.name)
        }
    }
    deepestCache = d
    return d
}

/// The modules of one layer, in the order the reference lists them.
let mut layers: Map<String, Array<String>> = [:]

fn layer(d: Int64) -> Array<String> {
    let key = d.toString()
    if let Some(hit) = layers[key] {
        return hit.copy()
    }
    let mut out: Array<String> = []
    for m in apiModules() {
        if depthOf(m.name) == d {
            out.push(m.name.copy())
        }
    }
    layers[key.copy()] = out.copy()
    return out
}

/// The tallest layer, which sets the height of the drawing.
fn tallest() -> Int64 {
    let mut n = 0
    let mut d = 0
    let last = deepest()
    while d <= last {
        if layer(d).length > n {
            n = layer(d).length
        }
        d = d + 1
    }
    return n
}

/// The horizontal step between two layers, clear of a ten-character label in
/// 11px mono.
fn columnStep() -> Int64 {
    return 150
}

/// The vertical step between two modules of one layer.
fn rowStep() -> Int64 {
    return 24
}

/// Where layer `d` starts.
fn columnX(d: Int64) -> Int64 {
    return 16 + d * columnStep()
}

/// Where row `i` of a layer sits.
fn rowY(i: Int64) -> Int64 {
    return 40 + i * rowStep()
}

/// How wide a label is, in px: 11px mono is 6.6px per character, rounded up so
/// a wire never starts inside a name.
fn labelWidth(name: String) -> Int64 {
    return 7 * name.byteLength
}

/// A module's row inside its layer.
let mut rowIndex: Map<String, Int64> = [:]

fn rowOf(name: String) -> Int64 {
    if let Some(hit) = rowIndex[name] {
        return hit
    }
    let mut i = 0
    for m in layer(depthOf(name)) {
        if m == name {
            rowIndex[name.copy()] = i
            return i
        }
        i = i + 1
    }
    rowIndex[name.copy()] = 0
    return 0
}

/// The x of a module's dot: the left edge of its label.
fn nodeX(name: String) -> Int64 {
    return columnX(depthOf(name))
}

/// The y of a module's dot.
fn nodeY(name: String) -> Int64 {
    return rowY(rowOf(name))
}

/// The whole drawing's width and height, which the viewBox takes.
export fn graphWidth() -> Int64 {
    return columnX(deepest()) + 110
}

fn graphHeight() -> Int64 {
    return rowY(tallest()) + 8
}

/// The viewBox, as one attribute.
export fn graphViewBox() -> String {
    return "0 0 " + graphWidth().toString() + " " + graphHeight().toString()
}

/// Every node, in layer order.
export fn graphNodes() -> Array<GraphNode> {
    let mut out: Array<GraphNode> = []
    for m in apiModules() {
        out.push(GraphNode {
            name: m.name.copy(),
            href: apiHref(m.name),
            x: nodeX(m.name).toString(),
            y: nodeY(m.name).toString(),
            // The label sits right of the dot; the hit area covers both.
            tx: (nodeX(m.name) + 10).toString(),
            ty: (nodeY(m.name) + 4).toString(),
            hx: (nodeX(m.name) - 6).toString(),
            hy: (nodeY(m.name) - 9).toString(),
            w: (labelWidth(m.name) + 20).toString(),
            uses: joinWith(depUses(m.name), " "),
            usedBy: joinWith(depUsedBy(m.name), " "),
            label: nodeLabel(m.name),
        })
    }
    return out
}

/// A node's accessible name: the module, how many modules it imports and how
/// many import it, which is what the highlight shows a pointer.
fn nodeLabel(name: String) -> String {
    let uses = depUses(name).length
    let usedBy = depUsedBy(name).length
    return "std/" + name + ", imports " + countWord(uses) + ", imported by " + countWord(usedBy)
}

/// `no modules`, `1 module`, `4 modules`.
fn countWord(n: Int64) -> String {
    if n == 0 {
        return "no modules"
    }
    if n == 1 {
        return "1 module"
    }
    return n.toString() + " modules"
}

/// The wire from `from` to the module it imports.
///
/// It leaves the dependent on its left and arrives past the right end of the
/// dependency's name, so no wire crosses a name.
fn wire(from: String, to: String) -> String {
    let x1 = nodeX(from) - 6
    let y1 = nodeY(from)
    let x2 = nodeX(to) + labelWidth(to) + 12
    let y2 = nodeY(to)
    let c1 = x1 - 40
    let c2 = x2 + 40
    return "M \{x1} \{y1} C \{c1} \{y1}, \{c2} \{y2}, \{x2} \{y2}"
}

/// Every wire, one per import.
export fn graphEdges() -> Array<GraphEdge> {
    let mut out: Array<GraphEdge> = []
    for m in apiModules() {
        for u in depUses(m.name) {
            out.push(GraphEdge { id: m.name + "-" + u, d: wire(m.name, u), from: m.name.copy(), to: u.copy() })
        }
    }
    return out
}

/// How many imports the graph draws.
export fn edgeCount() -> Int64 {
    return graphEdges().length
}

/// How many modules import nothing else in `std/`.
export fn leafCount() -> Int64 {
    return layer(0).length
}

/// The example programs that import `m`, by path under the repository.
export fn examplesUsing(m: String) -> Array<String> {
    let mut out: Array<String> = []
    for e in depExamples(m) {
        out.push("examples/" + e)
    }
    return out
}

/// The `std/` modules `m` imports.
export fn usesOfModule(m: String) -> Array<String> {
    return depUses(m)
}

/// The `std/` modules that import `m`.
export fn usedByModule(m: String) -> Array<String> {
    return depUsedBy(m)
}

test "every module is a row, and every row carries its own search text" {
    let rows = searchRows()
    assertEq(rows.length, apiModules().length)
    for r in rows {
        assert(r.name.byteLength > 0)
        assert(r.count > 0)
        assertEq(r.exports.length, r.count)
        assertEq(r.q, toLower(r.q))
        assert(r.q.byteLength > r.name.byteLength)
    }
}

test "a summary's tags are not part of what a search matches" {
    // The haystack is the text a reader sees, so `option<t` matches.
    assertEq(decodeEntities(stripTags("an <code>Option&lt;T&gt;</code> &amp; &quot;q&quot;&#39;s")), "an Option<T> & \"q\"'s")
    // std/vyx's summary wraps `.vyx` in a code tag; its row matches the text.
    let mut sawVyx = false
    for r in searchRows() {
        if r.name == "vyx" {
            sawVyx = contains(r.q, ".vyx") && !contains(r.q, "<code>")
        }
        assert(!contains(r.q, "&lt;"))
        assert(!contains(r.q, "&gt;"))
        assert(!contains(r.q, "&amp;"))
    }
    assert(sawVyx)
}

test "every node sits in a column, and no two share a place" {
    let nodes = graphNodes()
    assertEq(nodes.length, apiModules().length)
    for a in nodes {
        let mut same = 0
        for b in nodes {
            if a.x == b.x && a.y == b.y {
                same = same + 1
            }
        }
        assertEq(same, 1)
    }
    assert(graphWidth() > 300)
    assert(graphHeight() > 200)
}

test "every wire joins two modules the graph draws" {
    let edges = graphEdges()
    assert(edges.length > 40)
    for e in edges {
        let mut fromFound = false
        let mut toFound = false
        for n in graphNodes() {
            if n.name == e.from {
                fromFound = true
            }
            if n.name == e.to {
                toFound = true
            }
        }
        assert(fromFound)
        assert(toFound)
        assert(e.from != e.to)
        assert(e.d.byteLength > 10)
    }
}

test "a module sits deeper than everything it imports" {
    // Dependencies sit to the left of the modules that need them.
    for m in apiModules() {
        for u in depUses(m.name) {
            assert(depDepth(u) < depDepth(m.name))
        }
    }
}

test "the graph and the reference agree about what imports what" {
    // `std/json` is a leaf with dependents.
    assertEq(depUses("json").length, 0)
    assert(depUsedBy("json").length > 3)
    assert(depUses("jsonread").length > 0)
    assert(examplesUsing("json").length > 0)
    assertEq(examplesUsing("nope").length, 0)
}

// The graph page's prose, as markup. `routes/docs/graph.vyx` and the markdown
// twin in `pagemd.vyrn` render the same strings.

export fn graphLede() -> String {
    return "Every wire is an <code>import</code> line in <code>std/</code>. " + leafCount().toString() + " modules import nothing else in the library."
}

export fn graphIntro() -> String {
    return "A module sits in the column after the deepest thing it imports, so nothing on the left imports anything on the right."
}

export fn graphCaption() -> String {
    return "Read from the <code>import</code> lines of <code>std/*.vyrn</code>."
}
