/// Vyrn syntax highlighting by the compiler's own lexer, and the Vyrn snippets
/// the site shows.
///
///     import { vyrnCode } from "./hl"
///     import { hlLines } from vyrnCode()
///
/// `lex()` runs only inside a generator, so this module lexes every snippet
/// while the site compiles and emits the coloured markup as Vyrn source; a
/// visitor downloads HTML and no highlighter. Token kinds come from `lex()`.
/// This file adds two things the token list lacks: the source extent of a
/// string, doc comment or number, whose token text is decoded, and the
/// comments between tokens, which the lexer drops.
import { substring, split } from "std/strings"
import { includes } from "std/arrays"
import { escapeHtml } from "./code"
import { quoted, quotedList, branch, lookup } from "./gensrc"

/// One snippet, under the id the pages ask for.
type Piece = { id: String, src: String }

/// Every Vyrn snippet the site shows. Each is copied from a file in this
/// repository (`README.md`, `examples/ownership.vyrn`), so a reader who follows
/// the link finds the same lines.
fn pieces() -> Array<Piece> {
    return [
        Piece {
            id: "ownership",
            src: "fn fullName(first: String, last: String) -> String {
    let firstSpace = first + \" \" // inner temp - freed inside fullName
    let whole = firstSpace + last // built by reading firstSpace
    return whole                  // moved out to the caller
}
",
        },
        // The index's hero editor runs this, so it has a `main`. The editor
        // also needs the raw text, which `hlSource` gives.
        Piece {
            id: "runme",
            src: "type Age = Int64 where value >= 18

fn admit(n: Int64) -> String {
    // None when the rule fails, so input never traps.
    return match Age?(n) {
        Some(a) => \"admitted at \\{a}\",
        None => \"refused: \\{n} is under 18\",
    }
}

fn main() -> Int64 {
    print(admit(30))
    print(admit(5))
    return 0
}
",
        },
        Piece {
            id: "cmpTypes",
            src: "type Age = Int64 where value >= 18

let ok = Age(30)        // no runtime check is emitted
let maybe = Age?(input) // Option<Age>, total over any input
",
        },
        Piece {
            id: "cmpMemory",
            src: "fn seatCount(t: read Ticket) -> Int64 { return t.seats }
fn addSeat(t: modify Ticket) { t.seats = t.seats + 1 }
fn redeem(t: consume Ticket) -> Int64 { return t.id }

// No lifetime, no borrow annotation, no collector. The word is the contract.
",
        },
        Piece {
            id: "cmpFailure",
            src: "fn seat(t: read Ticket) -> Option<Int64>

match seat(t) {
    Some(n) => n,
    None => 0,  // there is no null to forget, and no arm to leave out
}
",
        },
        Piece {
            id: "capRead",
            src: "fn seatCount(t: read Ticket) -> Int64 {
    return t.seats  // the caller still owns t afterwards
}
",
        },
        Piece {
            id: "capModify",
            src: "fn addSeat(t: modify Ticket) {
    t.seats = t.seats + 1  // changed in place, still the caller's
}
",
        },
        Piece {
            id: "capConsume",
            src: "fn redeem(t: consume Ticket) -> Int64 {
    return t.id  // the caller may not name t again
}
",
        },
    ]
}

/// The words the grammar reads as keywords in position and the lexer hands back
/// as identifiers. They are coloured as keywords, so `read`, `modify` and
/// `consume` do not render as ordinary names.
fn contextual() -> Array<String> {
    return ["read", "modify", "consume", "gen", "test", "bench", "panic", "from", "as"]
}

/// `text` under class `cls`, escaped. A run is closed and reopened at every
/// newline, so each line of the result is balanced HTML.
fn emit(cls: String, text: String) -> String {
    if cls == "" {
        return escapeHtml(text)
    }
    let mut out = ""
    let mut first = true
    for part in split(text, "\n") {
        if !first {
            out = out + "\n"
        }
        first = false
        if part.byteLength > 0 {
            out = out + "<span class=\"" + cls + "\">" + escapeHtml(part) + "</span>"
        }
    }
    return out
}

fn digitByte(b: UInt8) -> Bool {
    return b >= '0' && b <= '9'
}

fn letterByte(b: UInt8) -> Bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'
}

/// The byte offset each line starts at, so a token's `(line, col)` becomes an
/// offset into the source.
export fn lineStarts(src: String) -> Array<Int64> {
    let mut out: Array<Int64> = [0]
    let raw = bytes(src)
    let mut i = 0
    while i < raw.length {
        if raw[i] == 10 {
            out.push(i + 1)
        }
        i = i + 1
    }
    return out
}

/// Past the closing quote of the string that starts at `start`. A backslash
/// covers the next byte.
///
/// ponytail: a `\{...}` interpolation holding its own string literal would end
/// the scan early. No snippet has one; the upgrade is the lexer's brace depth.
fn scanString(raw: Array<UInt8>, start: Int64) -> Int64 {
    let mut i = start + 1
    while i < raw.length && raw[i] != '"' {
        if raw[i] == 92 {
            i = i + 1
        }
        i = i + 1
    }
    if i < raw.length {
        i = i + 1
    }
    return i
}

/// The end of the line `start` is on.
fn scanToEol(raw: Array<UInt8>, start: Int64) -> Int64 {
    let mut i = start
    while i < raw.length && raw[i] != 10 {
        i = i + 1
    }
    return i
}

/// Past the numeric literal at `start`: a byte literal, or digits with at most
/// one fractional part. A `.` is only part of the number when a digit follows,
/// so `1.0.toString()` ends the number at `1.0`.
fn scanNumber(raw: Array<UInt8>, start: Int64) -> Int64 {
    if raw[start] == 39 {
        let mut i = start + 1
        while i < raw.length && raw[i] != 39 {
            if raw[i] == 92 {
                i = i + 1
            }
            i = i + 1
        }
        if i < raw.length {
            i = i + 1
        }
        return i
    }
    let mut i = start
    while i < raw.length && (digitByte(raw[i]) || letterByte(raw[i])) {
        i = i + 1
    }
    if i + 1 < raw.length && raw[i] == '.' && digitByte(raw[i + 1]) {
        i = i + 1
        while i < raw.length && (digitByte(raw[i]) || letterByte(raw[i])) {
            i = i + 1
        }
    }
    return i
}

/// Where the token at `start` ends in the source.
fn extentOf(raw: Array<UInt8>, start: Int64, kind: String, text: String) -> Int64 {
    if kind == "string" || kind == "template" {
        return scanString(raw, start)
    }
    if kind == "doc" || kind == "error" {
        return scanToEol(raw, start)
    }
    if kind == "int" || kind == "float" {
        return scanNumber(raw, start)
    }
    return start + text.byteLength
}

/// The CSS class for a token, or "" for text that carries no colour.
fn classOf(kind: String, text: String) -> String {
    if kind == "keyword" {
        return "k"
    }
    if kind == "string" || kind == "template" {
        return "s"
    }
    if kind == "int" || kind == "float" {
        return "n"
    }
    if kind == "doc" {
        return "c"
    }
    if kind == "ident" {
        if includes(contextual(), text) {
            return "k"
        }
        let b = bytes(text)
        if b.length > 0 && b[0] >= 'A' && b[0] <= 'Z' {
            return "t"
        }
    }
    return ""
}

/// The gap between two tokens: whitespace, and the comments the token list drops.
fn trivia(src: String, raw: Array<UInt8>, from: Int64, to: Int64) -> String {
    let mut out = ""
    let mut plain = from
    let mut i = from
    while i < to {
        if raw[i] == '/' && i + 1 < to && raw[i + 1] == '/' {
            out = out + emit("", substring(src, plain, i))
            let stop = scanToEol(raw, i)
            let end = if stop < to { stop } else { to }
            out = out + emit("c", substring(src, i, end))
            plain = end
            i = end
        } else {
            i = i + 1
        }
    }
    return out + emit("", substring(src, plain, to))
}

/// `src` as coloured markup, one left-to-right pass over the compiler's tokens.
///
/// The caller passes `lex(src)`, because `lex()` is callable only from a
/// generator's own body.
export gen fn highlightSrc(src: String, toks: Array<Token>) -> String {
    let raw = bytes(src)
    let starts = lineStarts(src)
    let mut out = ""
    let mut cursor = 0
    for t in toks {
        let start = starts[t.line - 1] + t.col - 1
        if start >= cursor {
            out = out + trivia(src, raw, cursor, start)
            let stop = extentOf(raw, start, t.kind, t.text)
            out = out + emit(classOf(t.kind, t.text), substring(src, start, stop))
            cursor = stop
        }
    }
    return out + trivia(src, raw, cursor, raw.length)
}

/// The coloured lines of `src`, one string per source line. The trailing
/// newline every source ends with would otherwise become an empty final row.
export gen fn highlightRows(src: String, toks: Array<Token>) -> Array<String> {
    let all = split(highlightSrc(src, toks), "\n")
    let mut out: Array<String> = []
    let mut i = 0
    while i < all.length {
        if i + 1 < all.length || all[i].byteLength > 0 {
            out.push(all[i].copy())
        }
        i = i + 1
    }
    return out
}

/// Colours every snippet, and emits the answers as a module.
export gen fn vyrnCode() -> String {
    let mut lines: Array<String> = []
    let mut sources: Array<String> = []
    for p in pieces() {
        lines.push(branch("id", p.id, quotedList(highlightRows(p.src, lex(p.src)))))
        sources.push(branch("id", p.id, quoted(p.src)))
    }
    let mut out = "/// Coloured by the compiler's own lexer while the site compiled. Do not edit.\n"
    out = out + "/// The lines of one snippet, already coloured, one string per source line.\n"
    out = out + lookup("hlLines", "id", "Array<String>", lines, "[]")
    out = out + "/// The raw source of one snippet, exactly as `hlLines` was measured from.\n"
    out = out + lookup("hlSource", "id", "String", sources, "\"\"")
    return out
}

// `lex()` cannot run in a test block, so the tests of the emitted markup are in
// `snippets.vyrn`.

test "a coloured run never crosses a newline, so every line is balanced markup" {
    assertEq(emit("s", "a\nb"), "<span class=\"s\">a</span>\n<span class=\"s\">b</span>")
    assertEq(emit("", "a<b"), "a&lt;b")
}

test "a number ends where the language ends it" {
    assertEq(scanNumber(bytes("1.0.toString()"), 0), 3)
    assertEq(scanNumber(bytes("'A' x"), 0), 3)
    assertEq(scanNumber(bytes("0x1F,"), 0), 4)
}

test "a string's extent is its quotes, not its decoded text" {
    assertEq(scanString(bytes("\"a//b\" x"), 0), 6)
    assertEq(scanString(bytes("\"a\\\"b\""), 0), 6)
}

test "a capability word is a keyword here and an ordinary name is not" {
    assert(includes(contextual(), "consume"))
    assert(!includes(contextual(), "consumer"))
    assertEq(classOf("ident", "read"), "k")
    assertEq(classOf("ident", "Ticket"), "t")
    assertEq(classOf("ident", "seats"), "")
    assertEq(classOf("keyword", "where"), "k")
}
