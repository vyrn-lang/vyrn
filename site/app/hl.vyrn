import { substring, split } from "std/strings"
import { escapeHtml } from "./code"
import { quotedList, branch, lookup } from "./gensrc"

type Piece = { id: String, src: String }

fn pieces() -> Array<Piece> {
    return [
        Piece {
            id: "runme",
            src: "type Age = Int64 where value >= 18

fn admit(n: Int64) -> String {
    // None when the rule fails, so input never traps.
    return match Age?(n) {
        Some(a) => \"admitted at \\{a}\",
        None => \"refused: \\{n} is under 18\",
    }
}

fn main() -> Int64 {
    print(admit(30))
    print(admit(5))
    return 0
}
",
        },
        Piece {
            id: "cmpTypes",
            src: "type Age = Int64 where value >= 18

let ok = Age(30)        // no runtime check is emitted
let maybe = Age?(input) // Option<Age>, total over any input
",
        },
        Piece {
            id: "cmpMemory",
            src: "fn seatCount(t: read Ticket) -> Int64 { return t.seats }
fn addSeat(t: modify Ticket) { t.seats = t.seats + 1 }
fn redeem(t: consume Ticket) -> Int64 { return t.id }

// No lifetime, no borrow annotation, no collector. The word is the contract.
",
        },
        Piece {
            id: "cmpFailure",
            src: "fn seat(t: read Ticket) -> Option<Int64>

match seat(t) {
    Some(n) => n,
    None => 0,  // there is no null to forget, and no arm to leave out
}
",
        },
        Piece {
            id: "capRead",
            src: "fn seatCount(t: read Ticket) -> Int64 {
    return t.seats  // the caller still owns t afterwards
}
",
        },
        Piece {
            id: "capModify",
            src: "fn addSeat(t: modify Ticket) {
    t.seats = t.seats + 1  // changed in place, still the caller's
}
",
        },
        Piece {
            id: "cardProps",
            src: "let xs = readAges()
  .sort(byAge)
  .reverse()
  .filter(isAdult)
  .map(jitter)
xs.push(17)
binarySearch(xs, 30)  // needs sorted(byAge)
",
        },
        Piece {
            id: "cardEffects",
            src: "fn table() -> Array<Int64> {
    let xs = build()
    print(xs.length)
    count = count + 1
    return xs
}
",
        },
        Piece {
            id: "cardOwn",
            src: "fn main() {
    let xs = readAges()     // owned by xs
    let s = summarize(xs)   // xs moves in
    print(s)                // released at its end
}
",
        },
        Piece {
            id: "capConsume",
            src: "fn redeem(t: consume Ticket) -> Int64 {
    return t.id  // the caller may not name t again
}
",
        },
    ]
}

fn emit(cls: String, text: String) -> String {
    if cls == "" {
        return escapeHtml(text)
    }
    let mut out = ""
    let mut first = true
    for part in split(text, "\n") {
        if !first {
            out = out + "\n"
        }
        first = false
        if part.byteLength > 0 {
            out = out + "<span class=\"" + cls + "\">" + escapeHtml(part) + "</span>"
        }
    }
    return out
}

export fn lineStarts(src: String) -> Array<Int64> {
    let mut out: Array<Int64> = [0]
    let raw = bytes(src)
    let mut i = 0
    while i < raw.length {
        if raw[i] == 10 {
            out.push(i + 1)
        }
        i = i + 1
    }
    return out
}

export gen fn highlightSrc(src: String) -> String {
    let mut out = ""
    let mut cursor = 0
    for run in codeRuns(src) {
        out = out + emit("", substring(src, cursor, run.start)) + emit(run.class, substring(src, run.start, run.stop))
        cursor = run.stop
    }
    return out + emit("", substring(src, cursor, src.byteLength))
}

export gen fn highlightRows(src: String) -> Array<String> {
    let all = split(highlightSrc(src), "\n")
    let mut out: Array<String> = []
    let mut i = 0
    while i < all.length {
        if i + 1 < all.length || all[i].byteLength > 0 {
            out.push(all[i].copy())
        }
        i = i + 1
    }
    return out
}

export gen fn vyrnCode() -> Code {
    let mut lines: Array<Code> = []
    let mut sources: Array<Code> = []
    for p in pieces() {
        lines.push(branch("id", p.id, quotedList(highlightRows(p.src))))
        sources.push(branch("id", p.id, vyrn"\{p.src}"))
    }
    let linesFn = lookup("hlLines", "id", vyrn"Array<String>", lines, vyrn"[]")
    let sourceFn = lookup("hlSource", "id", vyrn"String", sources, vyrn"\"\"")
    return vyrn"""
        /// The lines of one snippet, already coloured, one string per source line.
        \{linesFn}
        /// The raw source of one snippet, exactly as `hlLines` was measured from.
        \{sourceFn}

        """
}

test "a coloured run never crosses a newline, so every line is balanced markup" {
    assertEq(emit("s", "a\nb"), "<span class=\"s\">a</span>\n<span class=\"s\">b</span>")
    assertEq(emit("", "a<b"), "a&lt;b")
}
