/// The standard library reference, as the pages read it.
///
/// This is the one call site of `apiDocs` (see `repo.vyrn` for why there is
/// one). The generated module answers in parallel arrays, because it cannot
/// name a record type declared here, so this module zips them into records.
import { apiDocs } from "./apidoc"
import { docModules, docSummary, docIntro, docNames, docKinds, docSigs, docProse, docLines, docTests, docCount } from apiDocs("../../std")
import { startsWith } from "std/strpred"
import { substring, trimStart, split } from "std/strings"
import { includes } from "std/arrays"
import { hrefOf } from "./nav"
import { blob } from "./repo"
import { blurbFrom } from "./meta"

/// One exported declaration: what it is called, what it is, its signature as
/// written (already coloured), its `///` prose as HTML, and where it is declared.
export type ApiEntry = { name: String, kind: String, sig: String, prose: String, line: Int64 }

/// One module in the list: its name, its first sentence as HTML, and how many
/// exports it has.
export type ApiModule = { name: String, summary: String, count: Int64 }

/// A module's summary without the module's name in front of it, because the
/// list prints the name in its own column.
fn shorten(name: String, summary: String) -> String {
    let full = "std/" + name
    if !startsWith(summary, full) {
        return summary.copy()
    }
    let rest = trimStart(substring(summary, full.byteLength, summary.byteLength))
    if startsWith(rest, "— ") {
        return trimStart(substring(rest, 4, rest.byteLength))
    }
    return rest
}

/// Every documented module, sorted.
export fn apiModules() -> Array<ApiModule> {
    let mut out: Array<ApiModule> = []
    for m in docModules() {
        out.push(ApiModule { name: m.copy(), summary: shorten(m, docSummary(m)), count: docCount(m) })
    }
    return out
}

/// One named group of the reference index, and the modules in it.
export type ApiGroup = { name: String, modules: Array<ApiModule>, icon: String }

/// The group a module belongs to: the reference's one hand-written table. A
/// module it does not name lands in the last group, where a reader sees it.
fn groupOf(m: String) -> String {
    let text = ["strings", "strpred", "text", "scan", "codecs", "hash", "num"]
    let data = ["json", "jsonread", "jsondec", "von", "arrays", "math", "slots", "stream", "storage", "random", "symbolmap"]
    let web = ["http", "rpc", "connect", "openapi", "graphql", "html", "ui", "vyx", "vyx-hints", "tw", "icons", "i18n"]
    for n in text {
        if n == m {
            return "Text and bytes"
        }
    }
    for n in data {
        if n == m {
            return "Data"
        }
    }
    for n in web {
        if n == m {
            return "Web"
        }
    }
    return "Programs and tools"
}

/// The groups in the order the page prints them, each with the glyph the
/// sidebar draws beside its name.
fn groupDefs() -> Array<Array<String>> {
    return [
        ["Text and bytes", "file"],
        ["Data", "archive"],
        ["Web", "link"],
        ["Programs and tools", "settings"],
    ]
}

fn groupNames() -> Array<String> {
    let mut out: Array<String> = []
    for d in groupDefs() {
        out.push(d[0].copy())
    }
    return out
}

/// The glyph name `groupDefs` records for `name`, or "" for a name it does not.
fn groupIcon(name: String) -> String {
    for d in groupDefs() {
        if d[0] == name {
            return d[1].copy()
        }
    }
    return ""
}

/// Every documented module, in named groups. An empty group is left out.
export fn apiGroups() -> Array<ApiGroup> {
    let mut out: Array<ApiGroup> = []
    for g in groupNames() {
        let mut mods: Array<ApiModule> = []
        for m in apiModules() {
            if groupOf(m.name) == g {
                mods.push(ApiModule { name: m.name.copy(), summary: m.summary.copy(), count: m.count })
            }
        }
        if mods.length > 0 {
            out.push(ApiGroup { name: g.copy(), modules: mods.copy(), icon: groupIcon(g) })
        }
    }
    return out
}

/// Whether `m` names a module the reference covers.
export fn apiKnown(m: String) -> Bool {
    return includes(docModules(), m)
}

/// The exports of `m`, in declaration order.
export fn apiEntries(m: String) -> Array<ApiEntry> {
    let names = docNames(m)
    let kinds = docKinds(m)
    let sigs = docSigs(m)
    let prose = docProse(m)
    let lines = docLines(m)
    let mut out: Array<ApiEntry> = []
    let mut i = 0
    while i < names.length {
        out.push(ApiEntry { name: names[i].copy(), kind: kinds[i].copy(), sig: sigs[i].copy(), prose: prose[i].copy(), line: lines[i] })
        i = i + 1
    }
    return out
}

/// `1 export`, `44 exports`.
export fn exportPhrase(n: Int64) -> String {
    return if n == 1 { "1 export" } else { n.toString() + " exports" }
}

/// What a module page's card says: the module's first documentation line with
/// its export count after it. It uses the full `docSummary`, because a card has
/// no name column for the shortened one to lean on.
export fn apiBlurb(m: String) -> String {
    if !apiKnown(m) {
        return ""
    }
    return blurbFrom(docSummary(m), " " + exportPhrase(docCount(m)) + ".")
}

/// The module's header block, as HTML.
export fn apiIntro(m: String) -> String {
    return docIntro(m)
}

/// The names of the module's `test` blocks: in this repository each is a
/// sentence about what the module guarantees.
export fn apiTests(m: String) -> Array<String> {
    return docTests(m)
}

/// The page that documents `m`.
///
/// Built from the path rather than the router's typed helper, which would be an
/// import cycle; `export.vyrn` checks it against the helper.
export fn apiHref(m: String) -> String {
    return hrefOf("/docs/std/" + m)
}

/// The module's source file on GitHub.
export fn apiSource(m: String) -> String {
    return blob("std/" + m + ".vyrn")
}

/// The declaration itself, at its line.
export fn apiSourceLine(m: String, line: Int64) -> String {
    return apiSource(m) + "#L" + line.toString()
}

test "every signature the reference renders is a whole declaration" {
    // A truncated signature renders silently; balanced brackets catch it. It
    // runs here, where the real `std/` reference is generated.
    //
    // ponytail: brackets are counted, not parsed, so a bracket inside a string
    // literal in a signature would be a false alarm. None in `std/` has one.
    let mut total = 0
    for m in apiModules() {
        for e in apiEntries(m.name) {
            assert(e.sig.byteLength > 0)
            assertEq(split(e.sig, "{").length, split(e.sig, "}").length)
            assertEq(split(e.sig, "(").length, split(e.sig, ")").length)
            assertEq(split(e.sig, "[").length, split(e.sig, "]").length)
            total = total + 1
        }
    }
    assert(total > 300)
}

test "every module has a name, a summary and at least one export" {
    let mods = apiModules()
    assert(mods.length > 20)
    for m in mods {
        assert(m.name.byteLength > 0)
        assert(m.summary.byteLength > 0)
        assert(m.count > 0)
    }
}

test "a module's exports arrive zipped, in declaration order" {
    let math = apiEntries("math")
    assertEq(math[0].name, "min")
    assertEq(math[0].kind, "fn")
    assert(math[0].line > 0)
    assert(math[0].sig.byteLength > 0)
    for e in math {
        assert(e.name.byteLength > 0)
        assert(e.kind == "fn" || e.kind == "type" || e.kind == "protocol")
    }
}

test "the reference covers the modules it lists and nothing else" {
    assert(apiKnown("math"))
    assert(!apiKnown("nope"))
    assertEq(apiEntries("nope").length, 0)
    assertEq(apiIntro("nope"), "")
}

test "a summary does not repeat the module's own name" {
    assertEq(shorten("json", "std/json — the value tree."), "the value tree.")
    assertEq(shorten("json", "std/json (strict) — the value tree."), "(strict) — the value tree.")
    assertEq(shorten("fallible", "`Fallible` — the protocol."), "`Fallible` — the protocol.")
}

test "the groups hold every module, once" {
    let mut seen = 0
    for g in apiGroups() {
        assert(g.name.byteLength > 0)
        assert(g.modules.length > 0)
        seen = seen + g.modules.length
    }
    // Every module is in exactly one group: this fails only when a group lists
    // a name twice.
    assertEq(seen, apiModules().length)
}

test "a module page and its source are one link each" {
    assertEq(apiHref("json"), "/docs/std/json.html")
    assertEq(apiSourceLine("json", 12), "https://github.com/vyrn-lang/vyrn/blob/main/std/json.vyrn#L12")
}
