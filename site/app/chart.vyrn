/// Bar chart geometry, computed while the site builds.
///
/// Every position, width and label is in the exported markup before a script
/// runs, so a chart reads correctly with JavaScript off; a script only animates
/// one value. Every bar chart uses one three-column layout: the name at the left
/// edge, the bar in the middle, the value right-aligned at the right edge. No
/// label sits above a bar, so none can leave the viewBox. Each chart marks one
/// bar as focal, its axis starts at zero, and every coordinate is a multiple of
/// four. Every field is a `String`, because an SVG attribute is one.
///
/// Entry point: `heroBars`, the index's five bars for one benchmark program,
/// read from the record `bench.vyrn` reads.
import { sortBy } from "std/arrays"
import { medianUs, contestants, msOf } from "./bench"
import { hrefOf } from "./nav"

/// One row of a bar chart: the bar, the row's hit area, the label, the value,
/// the native `<title>`, and where the row's name points.
///
/// `hy` is the top of the hit area. A bar is 20 units tall inside a 36-unit
/// row, and a reader hovers the row, so the hit area spans all of it.
export type Bar = { id: String, y: String, hy: String, w: String, label: String, value: String, title: String, href: String, tone: String }

// The bar geometry, in viewBox units:
//
//   0            160                              832        904
//   | name       | bar                              |  value |
//
// A row is 36 units: a 20-unit bar and its air. The bar ends at 832 and the
// value is anchored at 896, so no label leaves the viewBox at either end.

/// Where a bar starts.
export fn barLeft() -> String {
    return barLeftN().toString()
}

fn barLeftN() -> Int64 {
    return 160
}

/// How wide the longest bar is.
fn barRoom() -> Int64 {
    return 672
}

/// Where every value label is anchored: eight units in from the right edge, so
/// an end-anchored glyph is not clipped.
export fn barRight() -> String {
    return "896"
}

/// The baseline of a row's text, relative to the row's `y`.
export fn barText() -> String {
    return "16"
}

/// How tall the plot is for `rows` bars, before the axis strip.
fn plotHeight(rows: Int64) -> Int64 {
    return rows * 36 + 8
}

/// A chart's viewBox: the plot, plus a 20-unit axis strip under it.
fn barViewBox(rows: Int64) -> String {
    return "0 0 904 " + (plotHeight(rows) + 20).toString()
}

fn rowY(i: Int64) -> String {
    return (i * 36 + 8).toString()
}

fn hitY(i: Int64) -> String {
    return (i * 36).toString()
}

/// How tall a row's hit area is.
export fn barRow() -> String {
    return "36"
}

/// One gridline: where it stands, and what it is worth.
export type Grid = { id: String, x: String, label: String }

/// Gridlines from zero up to `full`, one every `step`. `full` is in the chart's
/// own integer units, `per` of them make one `step` unit, and `unit` names it.
/// The unit is printed once, on the last gridline.
fn gridOf(full: Int64, step: Int64, per: Int64, unit: String) -> Array<Grid> {
    let mut out: Array<Grid> = []
    let mut v = 0
    while v * per <= full {
        out.push(Grid {
            id: v.toString(),
            x: (barLeftN() + barRoom() * v * per / full).toString(),
            label: v.toString(),
        })
        v = v + step
    }
    let last = out.length - 1
    out[last].label = out[last].label + " " + unit
    return out
}

// The index's five bars: one program on all five contestants, from the record
// `/benchmarks` draws its radar from.

/// The program the index shows: `spectralnorm`, the numeric kernel.
export fn heroBench() -> String {
    return "spectralnorm"
}

/// Its five bars, fastest first, on one linear scale against the slowest.
export fn heroBars() -> Array<Bar> {
    let rows = heroOrder()
    let full = medianUs(heroBench(), rows[rows.length - 1])
    let mut out: Array<Bar> = []
    let mut i = 0
    while i < rows.length {
        let key = rows[i]
        let us = medianUs(heroBench(), key)
        out.push(Bar {
            id: key.copy(),
            y: rowY(i),
            hy: hitY(i),
            w: (barRoom() * us / full).toString(),
            label: heroName(key),
            value: msOf(us),
            title: heroName(key) + " ran " + heroBench() + " in " + msOf(us),
            href: hrefOf("/compare") + "#numbers",
            tone: if i == 0 { "bar focal" } else { "bar" },
        })
        i = i + 1
    }
    return out
}

/// The contestant keys, fastest first by the record's medians.
fn heroOrder() -> Array<String> {
    let mut keys: Array<String> = []
    for s in contestants() {
        keys.push(s.key.copy())
    }
    return sortBy(keys, k -> medianUs(heroBench(), k))
}

/// The name a reader sees for one contestant key.
fn heroName(key: String) -> String {
    for s in contestants() {
        if s.key == key {
            return s.name.copy()
        }
    }
    return key.copy()
}

export fn heroBarsBox() -> String {
    return barViewBox(contestants().length)
}

/// The strip's axis: a gridline every whole second of the slowest bar.
export fn heroBarsGrid() -> Array<Grid> {
    let rows = heroOrder()
    return gridOf(medianUs(heroBench(), rows[rows.length - 1]), 1, 1000000, "s")
}

export fn heroBarsPlot() -> String {
    return plotHeight(contestants().length).toString()
}

test "the five bars are the five contestants, fastest first, and the last fills the scale" {
    let bars = heroBars()
    assertEq(bars.length, contestants().length)
    let order = heroOrder()
    let mut i = 1
    while i < order.length {
        assert(medianUs(heroBench(), order[i]) >= medianUs(heroBench(), order[i - 1]))
        i = i + 1
    }
    assertEq(bars[bars.length - 1].w, "672")
    assertEq(bars[0].tone, "bar focal")
    for b in bars {
        assert(b.value != "\u{2014}")
    }
}

test "a row's text sits inside the row, under a viewBox that holds every row" {
    assertEq(barText(), "16")
    assertEq(heroBars()[0].y, "8")
    assertEq(heroBars()[0].hy, "0")
    assertEq(heroBarsBox(), "0 0 904 208")
    assertEq(heroBarsPlot(), "188")
}

test "an axis starts at zero, is named once, and does not run past the data" {
    let g = heroBarsGrid()
    assertEq(g[0].x, barLeft())
    assertEq(g[0].label, "0")
    assertEq(g[g.length - 1].label, "3 s")
    for line in g {
        assert(line.x.byteLength <= 3)
    }
}
