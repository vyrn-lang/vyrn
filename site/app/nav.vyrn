/// The site navigation, and the one place that maps a route to its published
/// file.
///
/// It sits OUTSIDE `routes/` on purpose. `pages("./app/routes")` scans that
/// directory, so a page importing the module the scan generates would be a cycle.
/// The binding is kept honest from the other side instead: `export.vyrn` asserts
/// every row here against the generated typed-URL helper, so a route that is
/// renamed or deleted fails the export.
///
/// The two sockets the brief reserved are filled: `/guide` is the book, and
/// `/explore` is the package explorer. Both arrived as a directory drop plus a
/// row here, which is what reserving them was for. A row is still only written
/// when the route behind it exists — there is no placeholder page anywhere.
import { substring, split, repeat } from "std/strings"
import { Head, noHead, withTitle, withMeta } from "std/ui"

/// The head every page shares: its title, the viewport (without which a page
/// renders at desktop width on a phone), and one description.
///
/// It lives here rather than in the layout because the layout's `head { … }`
/// block has entries for a stylesheet and a script and none for a `<meta>`,
/// while a page's `head()` returns a `Head` value, which does.
export fn pageHead(title: String) -> Head {
    let titled = withTitle(noHead(), title)
    let sized = withMeta(titled, "viewport", "width=device-width, initial-scale=1")
    return withMeta(sized, "description", "Vyrn is a systems language with the expressiveness of TypeScript. Types carry the rules that make a value valid. Ownership is a word you write on a parameter. No garbage collector, and one program for three backends.")
}

/// One navigation entry: where it goes, and what it is called.
export type NavRow = { href: String, label: String }

/// The published file for a route path: `/philosophy` is `philosophy.html`, and
/// `/docs/std/json` is `docs/std/json.html`.
///
/// A route keeps its own shape, and the URL keeps the `.html`. RFC-0014 has
/// `readFile`, `writeFile` and `listDir` but no way to CREATE a directory, so a
/// nested route needs its directory made before the export runs — `site.yml`
/// makes `out/docs/std` and `out/explore` — and `philosophy/index.html` would
/// need one per page.
/// When a `makeDir` builtin lands, this one function changes and the extension
/// can go.
export fn published(path: String) -> String {
    if path == "/" {
        return "index.html"
    }
    return substring(path, 1, path.byteLength) + ".html"
}

/// The URL a link uses for a route path, as the site's own root names it.
///
/// This is the route's IDENTITY — the string the navigation marker matches on,
/// the string a `data-key` carries, the string one route compares to another.
/// It is not what the published document says. `site/export.vyrn` turns every
/// `href` and `src` it writes into a document-relative URL as the last thing it
/// does to a page, with `upTo` below. Nothing here has to know where the site
/// is served from, because nothing here writes the URL a browser reads.
export fn hrefOf(path: String) -> String {
    return "/" + published(path)
}

/// The step back up to the site's root from the page published for `path`:
/// `""` for `index.html`, `"../"` for `guide/values.html`, `"../../"` for
/// `docs/std/json.html`.
///
/// A page's own depth is the only input, and that is the whole point. A
/// build-time `--base` flag bakes one host into the output, and the next host
/// breaks: the site shipped every link as `/style.css`, which is correct at a
/// domain root and 404 under GitHub Pages' `/vyrn/`. A URL written relative to
/// the document that carries it is correct at a domain root, under `/vyrn/`, on
/// a fork's Pages, behind a preview URL, and opened from disk as `file://` —
/// one artifact, no configuration, nothing to get wrong twice.
export fn upTo(path: String) -> String {
    return repeat("../", split(published(path), "/").length - 1)
}

/// The navigation, in reading order.
///
/// Guide sits before Docs: the book teaches in order, the reference answers one
/// question at a time, and a reader who wants the second usually knows it.
export fn navRows() -> Array<NavRow> {
    return [
        NavRow { href: hrefOf("/philosophy"), label: "Philosophy" },
        NavRow { href: hrefOf("/compare"), label: "Compare" },
        NavRow { href: hrefOf("/install"), label: "Install" },
        NavRow { href: hrefOf("/releases"), label: "Releases" },
        NavRow { href: hrefOf("/guide"), label: "Guide" },
        NavRow { href: hrefOf("/docs"), label: "Docs" },
        NavRow { href: hrefOf("/explore"), label: "Explore" },
        NavRow { href: hrefOf("/play"), label: "Play" },
    ]
}

test "the home page keeps the bare index name" {
    assertEq(published("/"), "index.html")
    assertEq(hrefOf("/"), "/index.html")
}

test "a route becomes one file, and a nested route keeps its directory" {
    assertEq(published("/philosophy"), "philosophy.html")
    assertEq(hrefOf("/compare"), "/compare.html")
    assertEq(published("/docs/std/json"), "docs/std/json.html")
    assertEq(hrefOf("/docs/std/json"), "/docs/std/json.html")
}

test "a page's climb back to the root is its own depth and nothing else" {
    assertEq(upTo("/"), "")
    assertEq(upTo("/philosophy"), "")
    assertEq(upTo("/guide/values"), "../")
    assertEq(upTo("/docs/std/json"), "../../")
}

test "the navigation covers every route but the home page" {
    assertEq(navRows().length, 8)
}
