/// The masthead's navigation and controls, page heads, and the mapping from a
/// route path to its published file and URL.
///
/// It sits outside `routes/`, because `pages("./app/routes")` scans that
/// directory and a page importing the generated module would be a cycle.
/// `export.vyrn` checks every row here against the generated typed-URL helper,
/// so a renamed or deleted route fails the export.
import { substring, split, repeat } from "std/strings"
import { startsWith } from "std/strpred"
import { Head, noHead, withTitle, withMeta } from "std/ui"
import { metaOf } from "./meta"

/// The head of a redirect stub: the language's own paragraph as the
/// description. Every other page writes its own sentence.
export fn pageHead(title: String) -> Head {
    return pageHeadWith(title, "Vyrn is a systems language with the expressiveness of TypeScript. Types carry the rules that make a value valid. Ownership is a word you write on a parameter. No garbage collector, and one program for three backends.")
}

/// A head with a title and a description. `site/export.vyrn` reads both back
/// out of the document to build the page's card.
export fn pageHeadWith(title: String, description: String) -> Head {
    let titled = withTitle(noHead(), title)
    let sized = withMeta(titled, "viewport", "width=device-width, initial-scale=1")
    return withMeta(sized, "description", description)
}

/// The head for a page `meta.vyrn` lists, looked up by its path so a route
/// cannot drift from the table.
export fn pageHeadOf(path: String) -> Head {
    let m = metaOf(path)
    return pageHeadWith(m.title, m.blurb)
}

/// One navigation entry: where it goes, and what it is called.
export type NavRow = { href: String, label: String }

/// The theme control: one button that cycles System, Light and Dark, so it fits
/// the masthead's line.
///
/// The state is the button's text, and the accessible name states it and the
/// next press ("Theme: System. Press to use Light."). Every page renders the
/// `System` state; `site/public/theme.js` rewrites the word and the name from
/// `localStorage` as the document parses. Without script the button is hidden
/// (`[data-js]` gates it).
export fn themeControl() -> String {
    return "<button type=\"button\" class=\"theme\" data-theme-cycle aria-label=\"Theme: System. Press to use Light.\">System</button>"
}

/// The published file for a route path: `/why-vyrn` is `why-vyrn.html`, and
/// `/docs/std/json` is `docs/std/json.html`.
///
/// A Vyrn program cannot create a directory, so `site.yml` makes each nested
/// route's directory before the export, and a page is a file rather than a
/// `dir/index.html`.
export fn published(path: String) -> String {
    if path == "/" {
        return "index.html"
    }
    return substring(path, 1, path.byteLength) + ".html"
}

/// The root-relative URL of a route path: its identity, which the navigation
/// marker and `data-key` match on. `site/export.vyrn` rewrites every `href` and
/// `src` to a document-relative URL with `upTo` as the last step.
export fn hrefOf(path: String) -> String {
    return "/" + published(path)
}

/// The step back up to the site's root from the page published for `path`:
/// `""` for `index.html`, `"../"` for `guide/values.html`, `"../../"` for
/// `docs/std/json.html`.
///
/// Document-relative URLs make one exported tree work at a domain root, under
/// GitHub Pages' `/vyrn/`, behind a preview path and from `file://`.
export fn upTo(path: String) -> String {
    return repeat("../", split(published(path), "/").length - 1)
}

/// The masthead's navigation rows, in reading order.
///
/// `Docs` is the book at `/guide`; the documentation areas, the reference at
/// `/docs` among them, are the docs subnav's rows. `/install` is the button
/// beside the rows, and `/releases`, `/compare`, `/why-vyrn` and the editors
/// page are linked from the pages and the footer.
export fn navRows() -> Array<NavRow> {
    return [
        NavRow { href: hrefOf("/guide"), label: "Docs" },
        NavRow { href: hrefOf("/explore"), label: "Explore" },
        NavRow { href: hrefOf("/play"), label: "Play" },
    ]
}

/// The masthead's install link, styled as a button.
///
/// A string rather than template markup, because `site/export.vyrn` stamps
/// `aria-current` by finding `<a href="..." data-key="..."`: the two attributes
/// must come first and in that order.
export fn installCta() -> String {
    return "<a href=\"\{hrefOf("/install")}\" data-key=\"\{hrefOf("/install")}\" class=\"cta\">Install</a>"
}

test "the home page keeps the bare index name" {
    assertEq(published("/"), "index.html")
    assertEq(hrefOf("/"), "/index.html")
}

test "a route becomes one file, and a nested route keeps its directory" {
    assertEq(published("/why-vyrn"), "why-vyrn.html")
    assertEq(hrefOf("/compare"), "/compare.html")
    assertEq(published("/docs/std/json"), "docs/std/json.html")
    assertEq(hrefOf("/docs/std/json"), "/docs/std/json.html")
}

test "a page's climb back to the root is its own depth and nothing else" {
    assertEq(upTo("/"), "")
    assertEq(upTo("/why-vyrn"), "")
    assertEq(upTo("/guide/values"), "../")
    assertEq(upTo("/docs/std/json"), "../../")
}

test "the navigation is three rows, and the book keeps its label" {
    let rows = navRows()
    assertEq(rows.length, 3)
    assertEq(rows[0].label, "Docs")
    assertEq(rows[0].href, "/guide.html")
    assertEq(rows[1].label, "Explore")
    assertEq(rows[1].href, "/explore.html")
    // The routes linked elsewhere are not rows.
    for row in rows {
        assert(row.href != hrefOf("/install"))
        assert(row.href != hrefOf("/compare"))
        assert(row.href != hrefOf("/why-vyrn"))
        assert(row.href != hrefOf("/tooling/editors"))
        assert(row.href != hrefOf("/releases"))
    }
}

test "the call to action names the install route, and names it first" {
    let cta = installCta()
    assert(startsWith(cta, "<a href=\"/install.html\" data-key=\"/install.html\""))
}
