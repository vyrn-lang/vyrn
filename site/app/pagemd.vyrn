import { chapterOf, chapterSlugs, chapterHref, chapterArea, blockOf, blockSource } from "./guide"
import { apiModules, apiEntries, apiIntro, apiHref } from "./docs"
import { published } from "./nav"
import { siteOrigin } from "./repo"
import { decodeEntities } from "./meta"
import { substring, indexOf, replace, trimEnd } from "std/strings"
import { startsWith, endsWith, contains } from "std/strpred"
import { urlEncode } from "std/codecs"
import { pageTitle, lede, notice, features, featuresHeading, featuresIntro, featuresCap, featuresNotice, installHeading, installIntro, installNotice, installCap, otherHeading, otherIntro, otherClose, steps } from "./editors"
import { edgeCount, searchRows, graphLede, graphIntro, graphCaption } from "./stdgraph"

export fn mdUrl(pageHref: String) -> String {
    return swapExtension(pageHref, ".md")
}

export fn mdName(path: String) -> String {
    return swapExtension(published(path), ".md")
}

fn swapExtension(name: String, ext: String) -> String {
    if !endsWith(name, ".html") {
        return name.copy()
    }
    return substring(name, 0, name.byteLength - 5) + ext
}

export fn mdPaths() -> Array<String> {
    let mut out: Array<String> = []
    for slug in chapterSlugs() {
        out.push("/\{chapterArea(slug)}/\{slug}")
    }
    for m in apiModules() {
        out.push("/docs/std/\{m.name}")
    }
    out.push("/tooling/editors")
    out.push("/docs/graph")
    return out
}

export fn markdownOf(path: String) -> String {
    if path == "/tooling/editors" {
        return editorsMd()
    }
    if path == "/docs/graph" {
        return graphMd()
    }
    if startsWith(path, "/guide/") {
        return chapterMd(substring(path, 7, path.byteLength))
    }
    if startsWith(path, "/web/") {
        return chapterMd(substring(path, 5, path.byteLength))
    }
    if startsWith(path, "/tooling/") {
        return chapterMd(substring(path, 9, path.byteLength))
    }
    if startsWith(path, "/docs/std/") {
        return moduleMd(substring(path, 10, path.byteLength))
    }
    return ""
}

fn editorsMd() -> String {
    let mut out = "# \{pageTitle()}\n\n\{asMarkdown(lede())}\n\n\{asMarkdown(notice())}\n"
    out = out + "\n## \{features().length} \{featuresHeading()}\n\n"
    out = out + asMarkdown(featuresIntro()) + "\n\n"
    for f in features() {
        out = out + "- **\{f.name}** — \{asMarkdown(f.what)} Implemented by `\{f.path}` (`\{f.symbol}`).\n"
    }
    out = out + "\n" + asMarkdown(featuresCap()) + "\n\n" + asMarkdown(featuresNotice()) + "\n"
    out = out + "\n## \{installHeading()}\n\n" + asMarkdown(installIntro()) + "\n"
    for s in steps() {
        out = out + "\n### \{s.title}\n\n"
        out = out + fenced("sh", s.command)
        out = out + asMarkdown(s.what) + "\n\n"
    }
    out = out + asMarkdown(installNotice()) + "\n\n" + asMarkdown(installCap()) + "\n"
    out = out + "\n## \{otherHeading()}\n\n" + asMarkdown(otherIntro()) + "\n\n" + asMarkdown(otherClose()) + "\n"
    return collapse(out + "\n") + trailer(absolute("/tooling/editors.html"))
}

fn graphMd() -> String {
    let mut out = "# \{edgeCount().toString()} imports between \{searchRows().length} modules\n\n"
    out = out + asMarkdown(graphLede()) + "\n"
    out = out + "\n## Import graph\n\n" + asMarkdown(graphIntro()) + "\n\n"
    out = out + "The drawing is on the page: one node per module, one wire per `import`. Pointing at a module lights its wires.\n"
    out = out + "\n" + asMarkdown(graphCaption()) + "\n"
    return collapse(out + "\n") + trailer(absolute("/docs/graph.html"))
}

fn chapterMd(slug: String) -> String {
    let ch = chapterOf(slug)
    let mut out = "# \{ch.title}\n\n\{ch.lede}\n"
    for s in ch.sections {
        out = out + "\n## \{s.heading}\n\n"
        for p in s.prose {
            out = out + asMarkdown(p) + "\n\n"
        }
        for id in s.blocks {
            out = out + fenced("vyrn", blockSource(id))
            let printed = blockOf(id).output
            if printed.byteLength > 0 {
                out = out + "Built output:\n\n" + fenced("", printed)
            }
        }
    }
    return collapse(out) + trailer(absolute(chapterHref(slug)))
}

fn moduleMd(name: String) -> String {
    let mut out = "# std/\{name}\n\n" + asMarkdown(apiIntro(name)) + "\n"
    for e in apiEntries(name) {
        out = out + "\n## \{e.name}\n\n`\{e.kind}`, at line \{e.line}.\n\n"
        out = out + fenced("vyrn", asMarkdown(e.sig))
        let prose = asMarkdown(e.prose)
        if prose.byteLength > 0 {
            out = out + prose + "\n\n"
        }
    }
    return collapse(out) + trailer(absolute(apiHref(name)))
}

fn fenced(lang: String, body: String) -> String {
    return "```\{lang}\n" + trimEnd(body) + "\n```\n\n"
}

fn trailer(url: String) -> String {
    return "---\n\nFrom \{url} — generated by `site/export.vyrn` from the Vyrn repository.\n"
}

fn absolute(url: String) -> String {
    if startsWith(url, "/") {
        return siteOrigin() + substring(url, 1, url.byteLength)
    }
    return url.copy()
}

export fn asMarkdown(html: String) -> String {
    let mut out = ""
    let mut text = 0
    let mut i = 0
    let mut href = ""
    let mut fence = false
    while i < html.byteLength {
        if html[i] != '<' {
            i = i + 1
            continue
        }
        let close = closeFrom(html, i)
        if close < 0 {
            break
        }
        out = out + decodeEntities(substring(html, text, i))
        let tag = substring(html, i + 1, close)
        let name = tagName(tag)
        if name == "a" {
            href = absolute(attr(tag, "href"))
            out = out + "["
        } else if name == "/a" {
            out = out + "](\{href})"
        } else if name == "pre" {
            fence = true
            out = out + "```vyrn\n"
        } else if name == "/pre" {
            fence = false
            out = out + "\n```\n\n"
        } else if name == "code" || name == "/code" {
            out = out + if fence { "" } else { "`" }
        } else if name == "/p" || name == "br" || name == "/div" {
            out = out + "\n\n"
        } else if name == "li" {
            out = out + "- "
        } else if name == "/li" || name == "/ul" || name == "/ol" {
            out = out + "\n"
        } else if name == "strong" || name == "/strong" || name == "b" || name == "/b" {
            out = out + "**"
        } else if name == "em" || name == "/em" || name == "i" || name == "/i" {
            out = out + "*"
        }
        i = close + 1
        text = i
    }
    return collapse(trimEnd(out + decodeEntities(substring(html, text, html.byteLength))))
}

fn closeFrom(html: String, at: Int64) -> Int64 {
    let mut j = at
    while j < html.byteLength {
        if html[j] == '>' {
            return j
        }
        j = j + 1
    }
    return 0 - 1
}

fn tagName(tag: String) -> String {
    let cut = match indexOf(tag, " ") {
        Some(at) => at,
        None => tag.byteLength,
    }
    return substring(tag, 0, cut)
}

fn attr(tag: String, key: String) -> String {
    let needle = "\{key}=\""
    return match indexOf(tag, needle) {
        Some(at) => upTo(substring(tag, at + needle.byteLength, tag.byteLength), "\""),
        None => "",
    }
}

fn upTo(text: String, close: String) -> String {
    return match indexOf(text, close) {
        Some(end) => substring(text, 0, end),
        None => text.copy(),
    }
}

fn collapse(s: String) -> String {
    let mut out = s.copy()
    while contains(out, "\n\n\n") {
        out = replace(out, "\n\n\n", "\n\n")
    }
    return out
}

test "the tags this site writes become the markdown they mean" {
    assertEq(asMarkdown("<p>A <code>let</code> binds.</p>"), "A `let` binds.")
    assertEq(asMarkdown("A <a href=\"/install.html\">page</a>."), "A [page](\{siteOrigin()}install.html).")
    assertEq(asMarkdown("<a href=\"https://example.org/x\">x</a>"), "[x](https://example.org/x)")
    assertEq(asMarkdown("fn f(xs: Array&lt;String&gt;) -&gt; Bool"), "fn f(xs: Array<String>) -> Bool")
    assertEq(asMarkdown("&amp;amp; is an escaped ampersand"), "&amp; is an escaped ampersand")
    assertEq(asMarkdown("<span class=\"k\">import</span> x"), "import x")
    assertEq(asMarkdown("<b>b</b> and <em>e</em>"), "**b** and *e*")
    assertEq(asMarkdown("<p>One.</p><p>Two.</p>"), "One.\n\nTwo.")
    assertEq(asMarkdown("a < b"), "a < b")
}

test "a code span inside a fence stays inside it" {
    let fenced = asMarkdown("<pre><code>let x = 1</code></pre>")
    assertEq(fenced, "```vyrn\nlet x = 1\n```")
    assertEq(asMarkdown("<code>x</code>"), "`x`")
}

test "the two names beside a page are the page's own" {
    assertEq(mdUrl("/guide/values.html"), "/guide/values.md")
    assertEq(mdUrl("/docs/std/json.html"), "/docs/std/json.md")
    assertEq(mdName("/guide/values"), "guide/values.md")
    assertEq(mdName("/docs/std/json"), "docs/std/json.md")
    assertEq(mdUrl("/style.css"), "/style.css")
}

test "every chapter and every module publishes a markdown twin" {
    let paths = mdPaths()
    assertEq(paths.length, chapterSlugs().length + apiModules().length + 2)
    assertEq(markdownOf("/install"), "")
    assertEq(markdownOf("/nowhere/at/all"), "")
    assert(markdownOf("/tooling/editors").byteLength > 0)
    assert(markdownOf("/docs/graph").byteLength > 0)
}

test "a chapter's markdown carries its programs and its prose" {
    let md = markdownOf("/guide/getting-started")
    assert(startsWith(md, "# Getting started\n"))
    assert(contains(md, "\n## Install and check\n"))
    assert(contains(md, "```vyrn\n"))
    assert(contains(md, "fn main() -> Int64"))
    assert(contains(md, "Built output:\n\n```\nhello, world\n```"))
    assert(!contains(md, "\n\n\n"))
    assert(!contains(md, "<code>"))
    assert(!contains(md, "<a href"))
    assert(!contains(md, "](/"))
    assert(!contains(md, "&lt;"))
    assert(contains(md, siteOrigin()))
}

test "a module's markdown carries every export it documents" {
    let md = markdownOf("/docs/std/json")
    assert(startsWith(md, "# std/json\n"))
    for e in apiEntries("json") {
        assert(contains(md, "\n## \{e.name}\n"))
    }
    assert(contains(md, "import {"))
    assert(!contains(md, "<span"))
    assert(!contains(md, "&quot;"))
}

export fn askClaudeUrl(pageHref: String, title: String) -> String {
    let md = siteOrigin() + substring(mdUrl(pageHref), 1, mdUrl(pageHref).byteLength)
    return "https://claude.ai/new?q=" + urlEncode("Read " + md + " (the Vyrn documentation page \"" + title + "\") so I can ask questions about it.")
}

test "the hand-off link carries the twin's absolute URL, encoded" {
    let url = askClaudeUrl("/docs/std/json.html", "std/json")
    assert(startsWith(url, "https://claude.ai/new?q=Read%20"))
    if let Some(i) = indexOf(url, urlEncode(siteOrigin())) {
        assert(i > 0)
    } else {
        assert(false)
    }
    if let Some(j) = indexOf(url, urlEncode("\"std/json\"")) {
        assert(j > 0)
    } else {
        assert(false)
    }
}
