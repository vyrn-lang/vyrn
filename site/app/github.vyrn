fn repoName() -> String {
    return "vyrn-lang/vyrn"
}

export fn ghBlob(path: String) -> String {
    return "https://github.com/" + repoName() + "/blob/main/" + path
}

export fn ghSpec(path: String) -> String {
    return "github:" + repoName() + "@main/" + path
}

export fn ghRaw(gitRef: String, path: String) -> String {
    return "https://raw.githubusercontent.com/" + repoName() + "/" + gitRef + "/" + path
}

export fn ghRelease(tag: String) -> String {
    if tag.byteLength == 0 {
        return "https://github.com/" + repoName() + "/releases"
    }
    return "https://github.com/" + repoName() + "/releases/tag/" + tag
}

test "one repository name, four URL shapes" {
    assertEq(ghBlob("README.md"), "https://github.com/vyrn-lang/vyrn/blob/main/README.md")
    assertEq(ghSpec("std/json.vyrn"), "github:vyrn-lang/vyrn@main/std/json.vyrn")
    assertEq(ghRaw("main", "install.sh"), "https://raw.githubusercontent.com/vyrn-lang/vyrn/main/install.sh")
    assertEq(ghRelease("v0.1.0"), "https://github.com/vyrn-lang/vyrn/releases/tag/v0.1.0")
    assertEq(ghRelease(""), "https://github.com/vyrn-lang/vyrn/releases")
}
