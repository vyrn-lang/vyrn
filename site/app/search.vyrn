import { emit, Json, JsonField } from "std/json"
import { apiModules, apiEntries, apiHref } from "./docs"
import { chapterSlugs, chapterOf, chapterHref } from "./guide"
import { packages, packageHref } from "./packages"
import { pageMetas, stripTags } from "./meta"
import { hasRelease, releaseTag, releaseDate, releasePre } from "./repo"
import { hrefOf } from "./nav"
import { substring, replace } from "std/strings"
import { startsWith, contains } from "std/strpred"

/// One-byte keys keep the index small; `widgets.js` is the only reader.
export type FindRow = { s: String, t: String, u: String, d: String }

export fn rows() -> Array<FindRow> {
    let mut out: Array<FindRow> = []
    for m in pageMetas() {
        out.push(FindRow { s: "Docs", t: m.title.copy(), u: hrefOf(m.path), d: m.blurb.copy() })
    }
    for slug in chapterSlugs() {
        let ch = chapterOf(slug)
        out.push(FindRow { s: "Docs", t: ch.title.copy(), u: chapterHref(slug), d: oneLine(ch.lede) })
        for sec in ch.sections {
            out.push(FindRow { s: "Docs", t: "\{ch.title} — \{sec.heading}", u: "\{chapterHref(slug)}#\{sec.anchor}", d: oneLine(firstOf(sec.prose)) })
        }
    }
    for mod in apiModules() {
        out.push(FindRow { s: "Reference", t: "std/\{mod.name}", u: apiHref(mod.name), d: oneLine(mod.summary) })
        for e in apiEntries(mod.name) {
            // No signature and no `#e-` fragment, to stay under the ceiling; `widgets.js` derives the fragment from the title.
            out.push(FindRow { s: "Reference", t: "\{e.name} — std/\{mod.name}", u: apiHref(mod.name), d: e.kind.copy() })
        }
    }
    for p in packages() {
        out.push(FindRow { s: "Packages", t: p.name.copy(), u: packageHref(p.slug), d: oneLine(p.summary) })
    }
    out.push(FindRow { s: "Releases", t: "Releases", u: hrefOf("/releases"), d: "Every published release, and how a release is made." })
    if hasRelease() {
        let kind = if releasePre() { "pre-release" } else { "release" }
        out.push(FindRow { s: "Releases", t: releaseTag(), u: hrefOf("/releases"), d: "Published \{releaseDate()} as a \{kind}." })
    }
    return out
}

fn firstOf(xs: Array<String>) -> String {
    if xs.length == 0 {
        return ""
    }
    return xs[0].copy()
}

fn oneLine(text: String) -> String {
    let flat = replace(replace(stripTags(text), "\n", " "), "  ", " ")
    if flat.byteLength <= 60 {
        return flat.copy()
    }
    return substring(flat, 0, boundaryAt(flat, 59)) + "…"
}

fn boundaryAt(text: String, max: Int64) -> Int64 {
    let mut at = max
    while at > 0 && text[at] >= 128 && text[at] < 192 {
        at = at - 1
    }
    return at
}

export fn indexJsonOf(all: Array<FindRow>) -> String {
    let mut items: Array<Json> = []
    for r in all {
        items.push(JObj([JsonField { key: "s", value: JStr(r.s.copy()) }, JsonField { key: "t", value: JStr(r.t.copy()) }, JsonField { key: "u", value: JStr(r.u.copy()) }, JsonField { key: "d", value: JStr(r.d.copy()) }]))
    }
    return emit(JArr(items))
}

export fn indexName() -> String {
    return "search.json"
}

test "the index covers every section, and the counts are the census's" {
    let all = rows()
    let mut docs = 0
    let mut ref = 0
    let mut pkg = 0
    let mut rel = 0
    for r in all {
        if r.s == "Docs" {
            docs = docs + 1
        }
        if r.s == "Reference" {
            ref = ref + 1
        }
        if r.s == "Packages" {
            pkg = pkg + 1
        }
        if r.s == "Releases" {
            rel = rel + 1
        }
    }
    assertEq(docs, pageMetas().length + chapterSlugs().length + sectionCount())
    assertEq(ref, apiModules().length + exportCount())
    assertEq(pkg, packages().length)
    assertEq(rel, if hasRelease() { 2 } else { 1 })
    assertEq(all.length, docs + ref + pkg + rel)
    assert(all.length >= 440)
}

fn sectionCount() -> Int64 {
    let mut n = 0
    for slug in chapterSlugs() {
        n = n + chapterOf(slug).sections.length
    }
    return n
}

fn exportCount() -> Int64 {
    let mut n = 0
    for m in apiModules() {
        n = n + apiEntries(m.name).length
    }
    return n
}

test "no row is empty, and no row points at nothing" {
    for r in rows() {
        assert(r.t.byteLength > 0)
        assert(r.u.byteLength > 0)
        assertEq(r.u[0], '/')
        assert(!contains(r.d, "<"))
        assert(!contains(r.d, "\n"))
        assert(r.d.byteLength <= 160)
        if r.s == "Reference" {
            assert(!contains(r.u, "#"))
        }
    }
}

test "the index is one JSON array the overlay can read" {
    let json = indexJsonOf(rows())
    assertEq(json[0], '[')
    assertEq(json[json.byteLength - 1], ']')
    assert(!contains(json, "\n"))
    assert(startsWith(json, "[{\"s\":\"Docs\",\"t\":\""))
    assert(json.byteLength > 20000)
    assert(!contains(json, "/backstage"))
}
