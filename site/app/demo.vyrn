import { fieldsOf, itemsOf, fieldAt, tagOf } from "std/jsondec"
import { readData } from "./history"

export type DemoStep = { id: String, title: String, cmd: String, out: String, note: String }

export fn demoPath() -> String {
    return "site/data/demo.json"
}

export fn demoCommand() -> String {
    return "python scripts/site-demo.py --vyrn compiler/target/release/vyrn > " + demoPath()
}

export fn demoIsFixture() -> Bool {
    loadDemo()
    return fromFixture
}

export fn demoError() -> String {
    loadDemo()
    return corrupt.copy()
}

let mut loaded = false
let mut fromFixture = false
let mut stepRows: Array<DemoStep> = []
let mut version = ""
let mut recordedOn = ""
let mut corrupt = ""

fn loadDemo() {
    if loaded {
        return
    }
    loaded = true
    let data = readData(demoPath(), "site/data/demo.fixture.json")
    fromFixture = data.fixture
    corrupt = data.error.copy()
    version = tagOf(fieldAt(data.fields, "vyrn"))
    recordedOn = tagOf(fieldAt(data.fields, "recorded"))
    for s in itemsOf(fieldAt(data.fields, "steps")) {
        let f = fieldsOf(s)
        stepRows.push(DemoStep {
            id: tagOf(fieldAt(f, "id")),
            title: tagOf(fieldAt(f, "title")),
            cmd: tagOf(fieldAt(f, "cmd")),
            out: tagOf(fieldAt(f, "out")),
            note: tagOf(fieldAt(f, "note")),
        })
    }
}

export fn demoSteps() -> Array<DemoStep> {
    loadDemo()
    return stepRows.copy()
}

export fn demoVersion() -> String {
    loadDemo()
    return version.copy()
}

export fn demoRecorded() -> String {
    loadDemo()
    return recordedOn.copy()
}

test "the recording parses into steps a page could draw" {
    let steps = demoSteps()
    assert(steps.length >= 3)
    for s in steps {
        assert(s.id.byteLength > 0)
        assert(s.title.byteLength > 0)
        assert(s.out.byteLength > 0)
        assert(s.note.byteLength > 0)
    }
    assertEq(steps[0].cmd, "vyrn new demo")
    assertEq(demoError(), "")
}

test "the steps are version-stamped" {
    assert(demoVersion().byteLength > 0)
    assert(demoRecorded().byteLength > 0)
}
