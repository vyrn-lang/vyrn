/// Call each generator from one site: the cache keys on argument strings, so a second spelling emits colliding exports.
import { join } from "std/code"
import { substring } from "std/strings"
import { endsWith } from "std/strpred"

/// `items` as an array literal of strings.
export gen fn quotedList(items: Array<String>) -> Code {
    let mut parts: Array<Code> = []
    for it in items {
        parts.push(vyrn"\{it}")
    }
    let list = join(parts, vyrn", ")
    return vyrn"[\{list}]"
}

/// One branch of a [`lookup`]: `if param == key { return value }`.
export gen fn branch(param: String, key: String, value: Code) -> Code {
    return vyrn"if \{name(param)} == \{key} { return \{value} }"
}

/// `export fn fnName(param: String) -> ret`: one branch per key, then
/// `fallback`.
export gen fn lookup(fnName: String, param: String, ret: Code, branches: Array<Code>, fallback: Code) -> Code {
    let body = join(branches, vyrn"\n")
    return vyrn"""
        export fn \{name(fnName)}(\{name(param)}: String) -> \{ret} {
            \{body}
            return \{fallback}
        }
        """
}

export fn entriesOf(dir: String) -> Array<String> {
    return match listDir(dir) {
        Ok(names) => names.copy(),
        Err(why) => [],
    }
}

/// Mirrors `is_fenced` in `compiler/vyrn-frontend/src/loader.rs`, which a generator cannot call.
export fn fenced(name: String) -> Bool {
    return name == "mem" || name == "runtime"
}

export fn vyrnStems(dir: String) -> Array<String> {
    let mut out: Array<String> = []
    for entry in entriesOf(dir) {
        if endsWith(entry, ".vyrn") {
            out.push(substring(entry, 0, entry.byteLength - 5))
        }
    }
    return out
}

/// A one-branch lookup's text, which a test can read.
gen fn sampleLookup() -> String {
    return render(lookup("f", "m", vyrn"Int64", [branch("m", "json", vyrn"[]")], vyrn"0"))
}

/// A list's text, which a test can read.
gen fn sampleList(items: Array<String>) -> String {
    return render(quotedList(items))
}

test "a list holds each string as a literal" {
    assertEq(sampleList([]), "[]")
    assertEq(sampleList(["a\"b", "c\nd"]), "[\"a\\\"b\", \"c\\nd\"]")
}

test "a lookup is a Vyrn function with one branch per key" {
    assertEq(sampleLookup(), "export fn f(m: String) -> Int64 {\n    if m == \"json\" { return [] }\n    return 0\n}")
}
