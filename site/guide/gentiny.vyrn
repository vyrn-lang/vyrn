// A `gen fn` is ordinary Vyrn that runs while the program compiles and returns
// Vyrn code. The compiler links what it returns as a module. This one writes a
// lookup table nobody has to keep up to date.
import { join } from "std/code"

export gen fn squares() -> Code {
    let mut arms: Array<Code> = []
    let mut i = 1
    while i <= 9 {
        let square = i * i
        arms.push(vyrn"if n == \{i} { return \{square} }")
        i = i + 1
    }
    let body = join(arms, vyrn"\n")
    return vyrn"""
        export fn squareOf(n: Int64) -> Int64 {
            \{body}
            return 0
        }

        """
}
