/// The static export: renders every route the site has and writes it as files.
///
/// `pages()` builds `route(req) -> Response` for a server, and GitHub Pages
/// serves files, so `main` calls `route` once per path and writes the answer.
/// Each route is written twice: the document as `<name>.html` and the
/// soft-navigation payload as `<name>.data.json`. A static host cannot vary on
/// `Accept`, so `vyrn-nav.js` reads `__vyrnNavConfig.staticData` and fetches the
/// second file.
///
///     mkdir -p out/docs/std out/guide out/web out/tooling out/explore
///     vyrn run site/export.vyrn out
///
/// A Vyrn program cannot create a directory, so the caller makes them. The
/// tests below check the documents this program writes, through
/// `publishedDocument`.
import { pages } from "std/ui"
import { route, rootPath, philosophyPath, whyVyrnPath, comparePath, installPath, editorsPath, docsEditorsPath, docsGraphPath, releasesPath, docsPath, explorePath, guidePath, webPath, toolingPath, toolingEditorsPath, benchmarksPath, playPath, hrefDocsStd, hrefGuide, hrefWeb, hrefTooling, hrefExplore } from pages("./app/routes")
import { published, navRows, hrefOf, upTo } from "./app/nav"
import { historyIsFixture, historyPath, historyCommand, releaseRows, historyError } from "./app/history"
import { releaseTag, siteOrigin } from "./app/repo"
import { demoIsFixture, demoPath, demoCommand, demoError } from "./app/demo"
import { docSubnav } from "./app/docshell"
import { apiModules, apiEntries, apiHref } from "./app/docs"
import { chapterSlugs, chapterHref, chapterArea, movedChapters } from "./app/guide"
import { searchRows } from "./app/stdgraph"
import { packages, packageHref, offerOf, addCommand } from "./app/packages"
import { features } from "./app/editors"
import { indexJsonOf, indexName, rows } from "./app/search"
import { pageMetas, metaOf, hasMeta, decodeEntities, blurbLimit, blurbFloor } from "./app/meta"
import { mdPaths, mdName, mdUrl, markdownOf } from "./app/pagemd"
import { feedName, feedUrl, feedXml, feedItemCount } from "./app/feed"
// `emit` below is this program's file writer, so the JSON writer gets a name
// that says what it writes.
import { emit as jsonText, Json, JsonField } from "std/json"
import { substring, indexOf, lastIndexOf, split, replace, lines, trim } from "std/strings"
import { startsWith, contains } from "std/strpred"
import { includes } from "std/arrays"

/// Every path the site publishes, built from the router's typed URL helpers, so
/// a renamed or deleted route fails to compile here. The reference pages, the
/// package pages and the chapters come from the tables their pages render from.
fn sitePaths() -> Array<String> {
    let mut out: Array<String> = [rootPath(), whyVyrnPath(), installPath(), toolingEditorsPath(), docsGraphPath(), releasesPath(), docsPath(), guidePath(), webPath(), toolingPath(), benchmarksPath(), explorePath(), playPath()]
    for pair in redirects() {
        out.push(pair[0].copy())
    }
    for m in apiModules() {
        out.push(hrefDocsStd(m.name))
    }
    for p in packages() {
        out.push(hrefExplore(p.slug))
    }
    for slug in chapterSlugs() {
        let area = chapterArea(slug)
        if area == "web" {
            out.push(hrefWeb(slug))
        } else if area == "tooling" {
            out.push(hrefTooling(slug))
        } else {
            out.push(hrefGuide(slug))
        }
    }

    return out
}

/// The renamed routes: the old path, and the path that carries the page. Each
/// old path publishes a stub that sends the reader on.
///
/// A target is a page's final home, never another stub; the stub test refuses
/// a chain.
fn redirects() -> Array<Array<String>> {
    let mut out: Array<Array<String>> = [[philosophyPath(), whyVyrnPath()], [editorsPath(), toolingEditorsPath()], [docsEditorsPath(), toolingEditorsPath()], [comparePath(), benchmarksPath()]]
    for pair in movedChapters() {
        out.push(pair.copy())
    }
    return out
}

/// The path that replaced `path`, or "" when `path` was not renamed.
fn redirectTarget(path: String) -> String {
    for pair in redirects() {
        if pair[0] == path {
            return pair[1].copy()
        }
    }
    return ""
}

/// The request for a path's document.
fn documentRequest(path: String) -> Request {
    return Request { method: "GET", path: path.copy(), headers: ["accept": "text/html"], body: "" }
}

/// The request for a path's soft-navigation payload: the same URL, a different
/// `Accept`.
fn dataRequest(path: String) -> Request {
    return Request { method: "GET", path: path.copy(), headers: ["accept": "application/json"], body: "" }
}

/// The payload file beside a document: `why-vyrn.html` -> `why-vyrn.data.json`.
fn payloadName(name: String) -> String {
    return substring(name, 0, name.byteLength - 5) + ".data.json"
}

/// The masthead entry a path marks as current, or "" for none.
///
/// A row marks its own path. Every documentation path marks Docs, whose row is
/// `/guide`, and the subnav names the area. A package page marks Explore.
/// `/install` is not a row, and marks the persistent Install button. A stub
/// marks nothing: it is the old name of a page, not a place.
fn currentNav(path: String) -> String {
    if redirectTarget(path).byteLength > 0 {
        return ""
    }
    let here = hrefOf(path)
    for row in navRows() {
        if row.href == here {
            return row.href.copy()
        }
    }
    if path == "/install" {
        return hrefOf("/install")
    }
    if path == "/docs" || startsWith(path, "/docs/") || startsWith(path, "/guide/") {
        return hrefOf("/guide")
    }
    if startsWith(path, "/web") || startsWith(path, "/tooling") || startsWith(path, "/benchmarks") {
        return hrefOf("/guide")
    }
    if startsWith(path, "/explore/") {
        return hrefOf("/explore")
    }
    return ""
}

/// `html` with the masthead entry for `path` marked `aria-current="page"`.
///
/// The layout is shared by every page and is not told which route it renders,
/// so the export stamps the marker. Only the first match is marked: the
/// masthead comes first in the document, so a link to the same route in the
/// body is left alone. A soft navigation keeps the masthead, and `widgets.js`
/// moves the marker after each one.
///
/// The needle ends after the `data-key` value, not at `>`, so it also matches
/// the Install button, `<a href="/install.html" data-key="/install.html"
/// class="cta">`, the only element that can carry the marker for `/install`.
fn markCurrent(html: String, path: String) -> String {
    let href = currentNav(path)
    if href.byteLength == 0 {
        return html.copy()
    }
    let anchor = "<a href=\"\{href}\" data-key=\"\{href}\""
    return match indexOf(html, anchor) {
        Some(at) => substring(html, 0, at) + anchor + " aria-current=\"page\"" + substring(html, at + anchor.byteLength, html.byteLength),
        None => html.copy(),
    }
}

/// `html` with the documentation's area band stamped after the header, on a
/// page of the documentation that is not a stub. The layout is not told which
/// route it renders, so the export stamps it.
fn withSubnav(html: String, path: String) -> String {
    if redirectTarget(path).byteLength > 0 {
        return html.copy()
    }
    let key = subnavKey(path)
    if key.byteLength == 0 {
        return html.copy()
    }
    let band = "<nav class=\"subnav\" data-nav-swap=\"subnav\" aria-label=\"Documentation sections\">" + docSubnav(key) + "</nav>"
    return match indexOf(html, "</header>") {
        Some(at) => substring(html, 0, at + 9) + band + substring(html, at + 9, html.byteLength),
        None => html.copy(),
    }
}

/// Which documentation area a path belongs to, or "" for none. `/docs/graph`
/// goes first because it is the reference's own page.
fn subnavKey(path: String) -> String {
    if path == "/docs/graph" {
        return "reference"
    }
    if startsWith(path, "/guide") {
        return "guide"
    }
    if startsWith(path, "/web") {
        return "web"
    }
    if startsWith(path, "/tooling") {
        return "tooling"
    }
    if startsWith(path, "/docs") {
        return "reference"
    }
    if startsWith(path, "/benchmarks") {
        return "benchmarks"
    }
    return ""
}

test "the documentation band is stamped under the header, and only there" {
    let shell = "<header class=\"masthead\">nav</header><main>body</main>"
    let stamped = withSubnav(shell, "/docs/std/json")
    assert(contains(stamped, "</header><nav class=\"subnav\""))
    assertEq(countOf(stamped, "aria-current=\"true\""), 1)
    assert(contains(stamped, "href=\"/docs.html\" aria-current"))
    assertEq(subnavKey("/tooling/editors"), "tooling")
    assertEq(subnavKey("/docs/graph"), "reference")
    assertEq(subnavKey("/guide/ownership"), "guide")
    assertEq(subnavKey("/web/views"), "web")
    assertEq(subnavKey("/tooling/projects"), "tooling")
    assertEq(subnavKey("/benchmarks"), "benchmarks")
    assertEq(subnavKey("/docs"), "reference")
    assertEq(subnavKey("/"), "")
    assertEq(subnavKey("/install"), "")
    assertEq(withSubnav(shell, "/install"), shell)
}

/// `html` with `lang="en"` on the document element (WCAG 3.1.1), and
/// `data-landing` on a landing page. `std/html`'s `document` writes a bare
/// `<html>`, so the export stamps both attributes in one pass.
fn withLang(html: String, path: String) -> String {
    let attrs = if isLanding(path) { "<html lang=\"en\" data-landing>" } else { "<html lang=\"en\">" }
    return match indexOf(html, "<html>") {
        Some(at) => substring(html, 0, at) + attrs + substring(html, at + 6, html.byteLength),
        None => html.copy(),
    }
}

/// The nine pages that get the display type step, which the stylesheet raises
/// on `[data-landing]` alone.
///
/// A list, not a rule: every candidate rule is wrong on some page. "Top-level"
/// admits the stubs, and "not under a directory" admits `/docs/editors`.
fn landingPaths() -> Array<String> {
    return [rootPath(), installPath(), whyVyrnPath(), benchmarksPath(), releasesPath(), guidePath(), docsPath(), explorePath(), playPath()]
}

fn isLanding(path: String) -> Bool {
    return includes(landingPaths(), path)
}

/// `html` with the site's mark as its icon, which `assets()` copies to
/// `favicon.svg`. Without it a browser asks for `/favicon.ico`, which the site
/// does not publish. SVG only: `writeFile` takes a `String`, so this program
/// cannot write an `.ico`.
fn withIcon(html: String) -> String {
    return insertInHead(html, "<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">")
}

/// `html` with the head elements that decide the page's colour before the
/// first paint.
///
/// `<meta name="color-scheme">` lets a dark system paint a dark canvas before
/// the stylesheet arrives, and `theme-color` colours the browser's own bar. The
/// inline script reads the reader's choice from storage, which needs no
/// request, and sets three attributes on the root before the first paint:
/// `data-theme` (the reader's choice), `idecompact` (the masthead height handed
/// over by `theme.js`) and `data-js` (shows the theme control without moving its
/// row). `theme.js` is a deferred module that holds the toggle.
fn withThemeBoot(html: String) -> String {
    let boot = "<script>try{var r=document.documentElement,t=localStorage.getItem(\"vyrn.theme\");if(t===\"light\"||t===\"dark\")r.setAttribute(\"data-theme\",t);if(sessionStorage.getItem(\"vyrn.mast\")===\"compact\")r.classList.add(\"idecompact\");r.setAttribute(\"data-js\",\"on\")}catch(e){document.documentElement.setAttribute(\"data-js\",\"on\")}</script>"
    return insertAfterCharset(html, "<meta name=\"color-scheme\" content=\"light dark\">" + themeColours() + boot)
}

fn themeColours() -> String {
    let paper = paperColours()
    if paper.length < 2 {
        return ""
    }
    return "<meta name=\"theme-color\" media=\"(prefers-color-scheme: light)\" content=\"\{paper[0]}\"><meta name=\"theme-color\" media=\"(prefers-color-scheme: dark)\" content=\"\{paper[1]}\">"
}

let mut papers: Array<String> = []

/// The first two `--n4` values in the sheet: the light palette's, then the
/// system-dark one's.
fn paperColours() -> Array<String> {
    if papers.length > 0 {
        return papers.copy()
    }
    let sheet = match stylesheet() {
        Ok(body) => body,
        Err(why) => "",
    }
    let mark = "--n4:"
    let mut out: Array<String> = []
    let mut from = 0
    while out.length < 2 && from < sheet.byteLength {
        let rest = substring(sheet, from, sheet.byteLength)
        let at = match indexOf(rest, mark) {
            Some(i) => i,
            None => 0 - 1,
        }
        if at < 0 {
            from = sheet.byteLength
            continue
        }
        let value = substring(rest, at + mark.byteLength, rest.byteLength)
        let end = match indexOf(value, ";") {
            Some(e) => e,
            None => 0 - 1,
        }
        if end > 0 {
            out.push(trim(substring(value, 0, end)))
        }
        from = from + at + mark.byteLength
    }
    papers = out.copy()
    return out.copy()
}

/// After the charset, not after `<head>`: the charset must stay in the first 1024 bytes.
fn insertAfterCharset(html: String, extra: String) -> String {
    let mark = "<meta charset=\"utf-8\">"
    return match indexOf(html, mark) {
        Some(at) => substring(html, 0, at + mark.byteLength) + extra + substring(html, at + mark.byteLength, html.byteLength),
        None => insertInHead(html, extra),
    }
}

/// `html` with the releases feed declared. Every page carries it, because a
/// feed reader discovers a feed from whatever page it is given.
fn withFeed(html: String) -> String {
    return insertInHead(html, "<link rel=\"alternate\" type=\"application/rss+xml\" title=\"Vyrn releases\" href=\"/\{feedName()}\">")
}

/// `html` with its link-preview metas, its canonical URL and its JSON-LD record.
///
/// Every value comes from the page's own `<title>` and `<meta description>`, so
/// the card cannot disagree with the page. `og:type` is `website` on the home
/// page and a section index, and `article` on a page inside a section.
/// `og:title` drops the site name, which `og:site_name` carries. The canonical
/// and `og:url` are absolute, unlike every link (see `relativize`): a relative
/// canonical names a different page at each mount point, and a crawler reads
/// `og:url` with no document to resolve it against. There is no `og:image`:
/// the site's one graphic is an SVG, which no card renders, and this program
/// cannot write a PNG. A stub gets none of this.
fn withCards(html: String, path: String) -> String {
    if redirectTarget(path).byteLength > 0 {
        return html.copy()
    }
    let kind = if isIndex(path) { "website" } else { "article" }
    let title = withoutSiteName(titleOf(html))
    let desc = descriptionOf(html)
    let url = absoluteUrl(path)
    let section = articleSection(path, kind)
    let band = if section.byteLength > 0 { "<meta property=\"article:section\" content=\"\{section}\">" } else { "" }
    let card = "<link rel=\"canonical\" href=\"\{url}\"><meta property=\"og:site_name\" content=\"Vyrn\"><meta property=\"og:type\" content=\"\{kind}\"><meta property=\"og:title\" content=\"\{title}\"><meta property=\"og:description\" content=\"\{desc}\"><meta property=\"og:url\" content=\"\{url}\">\{band}<meta name=\"twitter:card\" content=\"summary\"><meta name=\"twitter:title\" content=\"\{title}\"><meta name=\"twitter:description\" content=\"\{desc}\">"
    return appendInHead(html, card + linkedData(path, kind, title, desc, url))
}

/// `html` with `extra` spliced in at the end of its head. The cards go last so
/// they do not push `<meta charset>` out of the first 1024 bytes; nothing reads
/// them before the document is parsed.
fn appendInHead(html: String, extra: String) -> String {
    return match indexOf(html, "</head>") {
        Some(at) => substring(html, 0, at) + extra + substring(html, at, html.byteLength),
        None => html.copy(),
    }
}

/// Whether `path` is the home page or a section index rather than a page inside
/// a section.
fn isIndex(path: String) -> Bool {
    return sectionPath(path) == path
}

/// The section a path belongs to: `/docs/std/json` is under `/docs`, and `/docs`
/// is under itself.
fn sectionPath(path: String) -> String {
    let rest = substring(path, 1, path.byteLength)
    return match indexOf(rest, "/") {
        Some(at) => substring(path, 0, at + 1),
        None => path.copy(),
    }
}

/// A page's `article:section`: the title of the section index it sits under,
/// without the site name. "" for an index, and for a section with no title in
/// the meta table.
fn articleSection(path: String, kind: String) -> String {
    if kind != "article" {
        return ""
    }
    let up = sectionPath(path)
    if !hasMeta(up) {
        return ""
    }
    return withoutSiteName(metaOf(up).title)
}

/// The absolute URL of a route. The home page is the origin itself, not
/// `index.html`, so a reader's pasted address and the canonical agree.
fn absoluteUrl(path: String) -> String {
    if path == rootPath() {
        return siteOrigin()
    }
    return siteOrigin() + published(path)
}

/// `title` without the site's name: everything before the last spaced em dash
/// whose tail mentions Vyrn. Every page title ends that way except the
/// home page's, which stays whole.
fn withoutSiteName(title: String) -> String {
    let mark = " \u{2014} "
    let at = match lastIndexOf(title, mark) {
        Some(i) => i,
        None => 0 - 1,
    }
    if at < 0 {
        return title.copy()
    }
    if !contains(substring(title, at + mark.byteLength, title.byteLength), "Vyrn") {
        return title.copy()
    }
    return substring(title, 0, at)
}

/// The page as a schema.org record, or "" for a page that is neither the home
/// page nor an article.
///
/// It carries the card's title and description and nothing else, so it cannot
/// disagree with the page. Both arrive entity-escaped from an attribute, so they
/// are decoded and re-escaped by the JSON writer.
fn linkedData(path: String, kind: String, title: String, description: String, url: String) -> String {
    let name = decodeEntities(title)
    let about = decodeEntities(description)
    let mut fields: Array<JsonField> = []
    if path == rootPath() {
        fields = [JsonField { key: "@context", value: JStr("https://schema.org") }, JsonField { key: "@type", value: JStr("SoftwareApplication") }, JsonField { key: "name", value: JStr(name) }, JsonField { key: "description", value: JStr(about) }, JsonField { key: "url", value: JStr(url.copy()) }, JsonField { key: "applicationCategory", value: JStr("DeveloperApplication") }]
    } else if kind == "article" {
        fields = [JsonField { key: "@context", value: JStr("https://schema.org") }, JsonField { key: "@type", value: JStr("TechArticle") }, JsonField { key: "headline", value: JStr(name) }, JsonField { key: "description", value: JStr(about) }, JsonField { key: "url", value: JStr(url.copy()) }, JsonField { key: "inLanguage", value: JStr("en") }]
    }
    if fields.length == 0 {
        return ""
    }
    // A `<` could close the script element early, so it is written as an escape.
    let body = replace(jsonText(JObj(fields)), "<", "\\u003C")
    return "<script type=\"application/ld+json\">\{body}</script>"
}

/// The document's title, between its first `<title>` tags.
fn titleOf(html: String) -> String {
    return between(html, "<title>", "</title>")
}

/// The document's description, from its `<meta name="description">`.
fn descriptionOf(html: String) -> String {
    return between(html, "<meta name=\"description\" content=\"", "\"")
}

/// The text between the first `open` and the next `close` after it, or "".
///
/// Nothing is unescaped: `std/html` escaped the value, `"` included, on the way
/// into the attribute it is read from and copied into. That makes the copy safe
/// here; it would not be for arbitrary HTML.
fn between(html: String, open: String, close: String) -> String {
    if let Some(at) = indexOf(html, open) {
        let rest = substring(html, at + open.byteLength, html.byteLength)
        if let Some(end) = indexOf(rest, close) {
            return substring(rest, 0, end)
        }
    }
    return ""
}

/// `html` with `extra` spliced in after `<head>`. The icon, the feed and a
/// stub's redirect use it: `std/ui`'s `Head` cannot express a `<link>` of another
/// `rel`, a `<meta property>` or a `<meta http-equiv>`.
fn insertInHead(html: String, extra: String) -> String {
    return match indexOf(html, "<head>") {
        Some(at) => substring(html, 0, at) + "<head>" + extra + substring(html, at + 6, html.byteLength),
        None => html.copy(),
    }
}

/// `html` with a stub's refresh and canonical, when `path` is a renamed route.
///
/// The refresh URL is made document-relative here because `relativize` only
/// rewrites `href` and `src`, and this URL sits in `content=`. The delay is
/// zero: the stub has nothing to read.
fn withRedirect(html: String, path: String) -> String {
    let to = redirectTarget(path)
    if to.byteLength == 0 {
        return html.copy()
    }
    return insertInHead(html, "<meta http-equiv=\"refresh\" content=\"0; url=\{upTo(path)}\{published(to)}\"><link rel=\"canonical\" href=\"\{hrefOf(to)}\">")
}

/// `text` with every root-absolute `href` and `src` made relative to the
/// document published for `path`, so one export works at any mount point.
///
/// It runs last, on the whole page, because URLs come from the navigation, the
/// layout's head, the stamps above and hand-written prose in the book. Only
/// `href` and `src` change: `data-key` is the route's identity and must be the
/// same string on every page. The second pair matches the same attributes
/// inside a JSON string, where the quote is escaped; a payload is consumed on
/// the page it was exported for, so its depth is this one. The leading space
/// keeps the match on a whole attribute name, and `std/html` escapes `"` in
/// text, so no text matches.
fn relativize(text: String, path: String) -> String {
    let up = upTo(path)
    let plain = replace(replace(text, " href=\"/", " href=\"" + up), " src=\"/", " src=\"" + up)
    return replace(replace(plain, " href=\\\"/", " href=\\\"" + up), " src=\\\"/", " src=\\\"" + up)
}

/// Write one file. Returns 1 on failure, so failures add up, and prints the
/// reason.
fn emit(file: String, body: String) -> Int64 {
    return match writeFile(file, body) {
        Ok(done) => 0,
        Err(why) => failed(file, why),
    }
}

/// Print what failed and why, and count one failure. A match arm is an
/// expression, so the print lives here rather than in the arm.
fn failed(what: String, why: String) -> Int64 {
    print("FAIL \{what}: \{why}")
    return 1
}

/// Export one route: its document and its payload. Returns the failure count.
fn exportPath(outDir: String, path: String) -> Int64 {
    let name = published(path)
    let status = documentStatus(path)
    if status != 200 {
        print("FAIL \{path} -> \{status}")
        return 1
    }
    let document = publishedDocument(path)
    let mut bad = emit("\{outDir}/\{name}", document)
    let json = payloadName(name)
    let payload = relativize(renderedData(path), path)
    bad = bad + emit("\{outDir}/\{json}", payload)
    print("\{path} -> \{name} (\{renderedBody(path).byteLength} bytes) + \{json} (\{payload.byteLength} bytes)")
    return bad
}

/// A binary file, such as `play.wasm`, is written by `.github/workflows/site.yml`.
fn assets() -> Array<Array<String>> {
    return [
        ["site/public/theme.js", "theme.js"],
        ["site/public/widgets.js", "widgets.js"],
        ["site/public/play.js", "play.js"],
        ["site/public/play-wasm.js", "play-wasm.js"],
        ["site/public/play-worker.js", "play-worker.js"],
        ["web/wasi-min.js", "wasi-min.js"],
        ["web/vyrn-nav.js", "vyrn-nav.js"],
        ["web/vyrn-dom.js", "vyrn-dom.js"],
        ["editor/vscode/icons/vyrn.svg", "favicon.svg"],
        ["install.sh", "install.sh"],
        ["install.ps1", "install.ps1"],
        // GitHub Pages serves `.txt` as `text/plain`, so the link shows the script.
        ["install.sh", "install.sh.txt"],
        ["install.ps1", "install.ps1.txt"],
    ]
}

fn copyAsset(outDir: String, source: String, name: String) -> Int64 {
    return match readFile(source) {
        Ok(body) => written(outDir, source, name, body),
        Err(why) => failed(source, why),
    }
}

/// The files in `site/public/css` in name order, which is the cascade order.
fn stylesheet() -> Result<String, String> {
    let mut sheet = ""
    for name in listDir("site/public/css")? {
        sheet = sheet + readFile("site/public/css/\{name}")?
    }
    return Ok(stripCssComments(sheet))
}

fn writeStylesheet(outDir: String) -> Int64 {
    return match stylesheet() {
        Ok(sheet) => written(outDir, "site/public/css", "style.css", sheet),
        Err(why) => failed("site/public/css", why),
    }
}

/// It skips quoted strings, because `content: "/*"` is legal CSS.
fn stripCssComments(css: String) -> String {
    let mut out = ""
    let mut keep = 0
    let mut i = 0
    let mut quote: UInt8 = 0
    while i < css.byteLength {
        let c = css[i]
        if quote != 0 {
            if c == 92 && i + 1 < css.byteLength {
                i = i + 2
                continue
            }
            if c == quote {
                quote = 0
            }
            i = i + 1
            continue
        }
        if c == '"' || c == 39 {
            quote = c
            i = i + 1
            continue
        }
        if c == '/' && i + 1 < css.byteLength && css[i + 1] == '*' {
            out = out + substring(css, keep, i)
            i = i + 2
            while i + 1 < css.byteLength && !(css[i] == '*' && css[i + 1] == '/') {
                i = i + 1
            }
            if i + 1 >= css.byteLength {
                return withoutBlankLines(out)
            }
            i = i + 2
            keep = i
            continue
        }
        i = i + 1
    }
    out = out + substring(css, keep, css.byteLength)
    return withoutBlankLines(out)
}

fn withoutBlankLines(text: String) -> String {
    let mut out = ""
    for line in lines(text) {
        if trim(line).byteLength > 0 {
            out = out + line + "\n"
        }
    }
    return out
}

fn written(outDir: String, source: String, name: String, body: String) -> Int64 {
    if body.byteLength == 0 {
        print("FAIL \{source}: read, but empty \u{2014} the site links it, so it cannot be nothing")
        return 1
    }
    return emit("\{outDir}/\{name}", body)
}

/// Whether the release history this program is handed is missing or broken.
///
/// The release table comes from git history, and this program can read files
/// but cannot run git, so `scripts/site-history.py` writes the history first.
/// A committed fixture keeps the tests runnable on a fresh clone; this check
/// keeps the fixture, or a truncated file, off a published page.
fn missingHistory() -> Bool {
    let broken = historyError()
    if broken.byteLength > 0 {
        print("FAIL \{historyPath()}: does not parse \u{2014} \{broken}")
        print("     Run: \{historyCommand()}")
        return true
    }
    if !historyIsFixture() {
        return false
    }
    print("FAIL \{historyPath()}: not there, so the velocity charts would be five made-up days.")
    print("     Run: \{historyCommand()}")
    print("     The site workflow runs it before this program, from a checkout with fetch-depth: 0.")
    return true
}

/// Whether the terminal recording this program is handed is missing or broken.
///
/// The index's terminal demo shows what the real binary printed, and this
/// program cannot start a process, so `scripts/site-demo.py` records it first.
/// As with the history, the committed fixture keeps the tests runnable and this
/// check keeps it, or a truncated file, off a published page.
fn missingDemo() -> Bool {
    let broken = demoError()
    if broken.byteLength > 0 {
        print("FAIL \{demoPath()}: does not parse \u{2014} \{broken}")
        print("     Run: \{demoCommand()}")
        return true
    }
    if !demoIsFixture() {
        return false
    }
    print("FAIL \{demoPath()}: not there, so the terminal demo would be three made-up steps.")
    print("     Run: \{demoCommand()}")
    print("     The site workflow runs it after the CLI build, against the binary it just made.")
    return true
}

/// The output directory: the first argument, or `out`. `args()` excludes the
/// program's own name.
fn outDirFrom(argv: Array<String>) -> String {
    if argv.length > 0 {
        return argv[0].copy()
    }
    return "out"
}

test "the export writes where it is told, and to `out` when it is told nothing" {
    assertEq(outDirFrom([]), "out")
    assertEq(outDirFrom(["dist"]), "dist")
    assertEq(outDirFrom(["dist", "extra"]), "dist")
}

fn main() -> Int64 {
    let outDir = outDirFrom(args())
    if missingHistory() || missingDemo() {
        return 1
    }
    let mut failures = 0
    for path in sitePaths() {
        failures = failures + exportPath(outDir, path)
    }
    for asset in assets() {
        failures = failures + copyAsset(outDir, asset[0], asset[1])
    }
    failures = failures + writeStylesheet(outDir)
    for path in mdPaths() {
        failures = failures + writeMarkdown(outDir, path)
    }
    failures = failures + writeIndex(outDir)
    failures = failures + writeFeed(outDir)
    if failures > 0 {
        print("export failed: \{failures} file(s)")
        return 1
    }
    print("exported \{sitePaths().length} route(s) and \{assets().length} asset(s) to \{outDir}")
    return 0
}

/// One page's markdown twin, beside the page, built by `app/pagemd.vyrn`. An
/// empty one is a failure: a "copy as markdown" button that copies nothing is
/// worse than none.
fn writeMarkdown(outDir: String, path: String) -> Int64 {
    let md = markdownOf(path)
    if md.byteLength == 0 {
        print("FAIL \{mdName(path)}: no markdown for \{path}")
        return 1
    }
    print("\{path} -> \{mdName(path)} (\{md.byteLength} bytes)")
    return emit("\{outDir}/\{mdName(path)}", md)
}

/// The releases feed, as RSS 2.0.
fn writeFeed(outDir: String) -> Int64 {
    print("\{feedName()} (\{feedItemCount()} item(s))")
    return emit("\{outDir}/\{feedName()}", feedXml())
}

/// The search index that `app/search.vyrn` builds, written beside the pages.
///
/// The ceiling is 8,000 bytes gzipped, and this program cannot gzip, so it
/// checks 80,000 raw, from a measured ratio of 8.0. `site/test/search.test.mjs`
/// gzips the written file and checks the 8,000.
fn writeIndex(outDir: String) -> Int64 {
    let all = rows()
    let json = indexJsonOf(all)
    if json.byteLength > 80000 {
        print("FAIL \{indexName()}: \{json.byteLength} bytes of index, ceiling 80,000 raw")
        print("     The ceiling is 8,000 gzipped; this is the raw check the export can make.")
        return 1
    }
    print("\{indexName()} (\{all.length} entries, \{json.byteLength} bytes)")
    return emit("\{outDir}/\{indexName()}", json)
}

// The link gate: every `href` with a fragment, generated or hand-written, must
// land on an `id` of the page it names.

/// Every value of the attribute `name` in `html`, in document order.
///
/// `split` and `indexOf` do the scan, because a byte loop in Vyrn over every
/// document took minutes. The needle starts with a space, so `data-id="` is not
/// read as `id="`.
fn attrValues(html: String, name: String) -> Array<String> {
    let parts = split(html, " " + name + "=\"")
    let mut out: Array<String> = []
    let mut i = 1
    while i < parts.length {
        out.push(match indexOf(parts[i], "\"") {
            Some(at) => substring(parts[i], 0, at),
            None => "",
        })
        i = i + 1
    }
    return out
}

/// `href` split at its `#`: the document it names (empty for this one) and the
/// fragment (empty when it has none).
fn fragmentOf(href: String) -> Array<String> {
    return match indexOf(href, "#") {
        Some(at) => [substring(href, 0, at), substring(href, at + 1, href.byteLength)],
        None => [href.copy(), ""],
    }
}

test "every reference link points at the route the router generated" {
    for m in apiModules() {
        assertEq(apiHref(m.name), "/" + published(hrefDocsStd(m.name)))
    }
}

test "a module the reference does not cover answers 404, not an empty page" {
    assertEq(documentStatus("/docs/std/nope"), 404)
}

test "every navigation row points at a route that exists" {
    for row in navRows() {
        let mut found = false
        for path in sitePaths() {
            if row.href == "/" + published(path) {
                found = true
            }
        }
        assert(found)
    }
}

test "every route answers 200 as a document and as data" {
    for path in sitePaths() {
        assertEq(documentStatus(path), 200)
        assert(renderedData(path).byteLength > 0)
    }
}

test "the two representations of one URL differ" {
    let doc = route(documentRequest(rootPath()))
    let data = route(dataRequest(rootPath()))
    assertEq(doc.contentType, "text/html")
    assertEq(data.contentType, "application/json")
}

test "every published document marks exactly one thing in its masthead" {
    // The masthead is the navigation rows plus the Install button; a page marks
    // one of them or none.
    let mut targets: Array<String> = [hrefOf("/install")]
    for row in navRows() {
        targets.push(row.href.copy())
    }
    for path in sitePaths() {
        let html = markCurrent(renderedBody(path), path)
        let mut marked = 0
        for href in targets {
            marked = marked + countOf(html, "data-key=\"\{href}\" aria-current=\"page\"")
        }
        // These mark nothing: the home page, which is the wordmark's; the pages
        // reached from content rather than the masthead; and the stubs.
        let orphan = path == "/" || path == "/compare" || path == "/why-vyrn" || path == "/releases" || redirectTarget(path).byteLength > 0
        assertEq(marked, if orphan { 0 } else { 1 })
    }
}

test "each renamed route publishes a stub that carries the reader to the new one" {
    // A stub carries three ways on: the refresh a browser follows, the
    // canonical a search engine reads, and the visible link a screen reader has.
    assertEq(redirects().length, 6)
    for pair in redirects() {
        let old = pair[0]
        let to = pair[1]
        assertEq(documentStatus(old), 200)
        assertEq(route(dataRequest(old)).status, 200)
        assertEq(documentStatus(to), 200)
        let doc = publishedDocument(old)
        let hop = upTo(old) + published(to)
        assert(contains(doc, "<meta http-equiv=\"refresh\" content=\"0; url=\{hop}\">"))
        assert(contains(doc, "<link rel=\"canonical\" href=\"\{hop}\">"))
        assert(contains(doc, "<a href=\"\{hop}\">"))
        assert(!contains(doc, "aria-current=\"page\""))
        // The target is not itself a stub, so no two stubs form a loop.
        assertEq(redirectTarget(to).byteLength, 0)
        assert(!contains(publishedDocument(to), "http-equiv=\"refresh\""))
    }
    // Each pair by name, so dropping one fails here.
    assertEq(redirectTarget("/philosophy"), "/why-vyrn")
    assertEq(redirectTarget("/editors"), "/tooling/editors")
    assertEq(redirectTarget("/docs/editors"), "/tooling/editors")
    assertEq(redirectTarget("/guide/testing"), "/tooling/testing")
    assertEq(redirectTarget("/guide/web"), "/web/views")
    assertEq(redirectTarget("/compare"), "/benchmarks")
    assertEq(redirectTarget("/docs"), "")
}

test "every page carries the theme control, and carries it without a flash" {
    // Pages at the root and one two directories deep. The theme is decided by an
    // inline script right after the charset, before the stylesheet and with no
    // request; `theme.js` is a module that holds the one toggle button.
    for path in ["/", "/docs/std/json", "/benchmarks"] {
        let doc = publishedDocument(path)
        let up = upTo(path)
        let head = split(doc, "<body")[0]
        let mark = "<meta charset=\"utf-8\">"
        assert(startsWith(split(doc, mark)[1], "<meta name=\"color-scheme\" content=\"light dark\"><meta name=\"theme-color\""))
        let beforeSheet = split(doc, "<link rel=\"stylesheet\"")[0]
        assert(contains(beforeSheet, "<script>try{var r=document.documentElement"))
        assertEq(countOf(beforeSheet, "name=\"color-scheme\""), 1)
        assertEq(countOf(beforeSheet, "name=\"theme-color\""), 2)
        // The encoding stays inside the first 1024 bytes.
        assert(split(doc, mark)[0].byteLength < 1024)
        assert(contains(head, "localStorage.getItem(\"vyrn.theme\")"))
        assert(contains(head, "r.setAttribute(\"data-theme\",t)"))
        assert(contains(head, "r.setAttribute(\"data-js\",\"on\")"))
        assert(!contains(doc, "<script src=\"" + up + "theme.js\">"))
        assert(contains(head, "<script type=\"module\" src=\"" + up + "theme.js\">"))
        assertEq(countOf(doc, "data-theme-cycle"), 1)
        assertEq(countOf(doc, "<button type=\"button\" class=\"theme\" data-theme-cycle aria-label=\"Theme: System. Press to use Light.\">System</button>"), 1)
        assertEq(countOf(doc, "class=\"skip\" href=\"#main\""), 1)
        assertEq(countOf(doc, "id=\"main\" class=\"skip-target\" tabindex=\"-1\""), 1)
    }
}

test "every documentation page marks Docs, and the home page nothing" {
    assertEq(currentNav("/docs"), "/guide.html")
    assertEq(currentNav("/docs/std/json"), "/guide.html")
    assertEq(currentNav("/guide"), "/guide.html")
    assertEq(currentNav("/tooling/editors"), "/guide.html")
    assertEq(currentNav("/docs/editors"), "")
    assertEq(currentNav("/editors"), "")
    assertEq(currentNav("/install"), "/install.html")
    assertEq(currentNav("/"), "")
    assertEq(currentNav("/compare"), "")
    assertEq(currentNav("/why-vyrn"), "")
    assertEq(currentNav("/philosophy"), "")
}

test "the marker lands on the navigation, not on the first link in the body" {
    let nav = "<a href=\"/guide.html\" data-key=\"/guide.html\">Docs</a>"
    let body = "<p>" + nav + "</p>"
    assertEq(markCurrent(nav + body, "/docs"), "<a href=\"/guide.html\" data-key=\"/guide.html\" aria-current=\"page\">Docs</a>" + body)
    // The Install button carries a third attribute, and still gets the marker.
    let cta = "<a href=\"/install.html\" data-key=\"/install.html\" class=\"cta\">Install</a>"
    assertEq(markCurrent(cta, "/install"), "<a href=\"/install.html\" data-key=\"/install.html\" aria-current=\"page\" class=\"cta\">Install</a>")
}

test "every name in a module's index points at an export that is on the page" {
    // A rail entry whose anchor no element carries does nothing when clicked.
    for m in apiModules() {
        let html = renderedBody(hrefDocsStd(m.name))
        for e in apiEntries(m.name) {
            assert(contains(html, "href=\"#e-\{e.name}\""))
            assert(contains(html, "id=\"e-\{e.name}\""))
        }
    }
}

/// The document this export writes for `path`, with every stamp applied,
/// cached. The tests read this, because the router's raw body is not what
/// ships.
///
/// `withThemeBoot` is outermost so the colour decision comes first in the
/// head; the order of the other stamps carries nothing. Every cache in this
/// section exists because the tests ask for the same pages many times, and a
/// page here is a pure function of the tree; without them the site's test step
/// took 1392 s of a 1788 s CI job.
let mut renderedPages: Map<String, String> = [:]

fn publishedDocument(path: String) -> String {
    if let Some(hit) = renderedPages[path] {
        return hit.copy()
    }
    let doc = relativize(withThemeBoot(withRedirect(withCards(withFeed(withIcon(withLang(withSubnav(markCurrent(renderedBody(path), path), path), path))), path), path)), path)
    renderedPages[path.copy()] = doc.copy()
    return doc
}

/// Each route's answer to the document request, cached.
let mut documentAnswers: Map<String, Response> = [:]

fn documentAnswer(path: String) -> Response {
    if let Some(hit) = documentAnswers[path] {
        return hit.copy()
    }
    let answer = route(documentRequest(path))
    documentAnswers[path.copy()] = answer.copy()
    return answer
}

/// A route's document body, before the stamps.
fn renderedBody(path: String) -> String {
    return documentAnswer(path).body
}

/// A route's document status.
fn documentStatus(path: String) -> Int64 {
    return documentAnswer(path).status
}

/// A route's soft-navigation payload, cached.
let mut dataPages: Map<String, String> = [:]

fn renderedData(path: String) -> String {
    if let Some(hit) = dataPages[path] {
        return hit.copy()
    }
    let body = route(dataRequest(path)).body
    dataPages[path.copy()] = body.copy()
    return body
}

/// How many times `needle` occurs in `hay`.
fn countOf(hay: String, needle: String) -> Int64 {
    return split(hay, needle).length - 1
}

test "a URL is written relative to the document that carries it" {
    assertEq(relativize("<a href=\"/docs.html\">", "/"), "<a href=\"docs.html\">")
    assertEq(relativize("<link href=\"/style.css\"><script src=\"/widgets.js\">", "/"), "<link href=\"style.css\"><script src=\"widgets.js\">")
    assertEq(relativize("<a href=\"/docs.html\">", "/guide/values"), "<a href=\"../docs.html\">")
    assertEq(relativize("<script src=\"/widgets.js\">", "/docs/std/json"), "<script src=\"../../widgets.js\">")
    // A fragment, an external URL and the route identity are left as they are.
    assertEq(relativize("<a href=\"#main\">", "/docs/std/json"), "<a href=\"#main\">")
    assertEq(relativize("<a href=\"https://x/y\">", "/guide/values"), "<a href=\"https://x/y\">")
    assertEq(relativize("<a data-key=\"/docs.html\">", "/guide/values"), "<a data-key=\"/docs.html\">")
    // The same attributes inside a JSON string, where the quote is escaped.
    assertEq(relativize("{\"p\":\"<a href=\\\"/docs.html\\\">\"}", "/guide/values"), "{\"p\":\"<a href=\\\"../docs.html\\\">\"}")
}

test "no published document names a root that only one host has" {
    // Every `="/` left in a document must be a `data-key`, so a URL in any
    // attribute, named here or not, fails the test.
    for path in sitePaths() {
        let doc = publishedDocument(path)
        if countOf(doc, "=\"/") != countOf(doc, "data-key=\"/") {
            print("FAIL \{path}: a root-absolute URL survived relativize")
        }
        assertEq(countOf(doc, "=\"/"), countOf(doc, "data-key=\"/"))
        // An empty href is a link to the page itself.
        assertEq(countOf(doc, " href=\"\""), 0)
        assertEq(countOf(doc, " src=\"\""), 0)
        assertEq(countOf(relativize(renderedData(path), path), "=\\\"/"), 0)
    }
    assert(contains(publishedDocument("/"), "<link rel=\"stylesheet\" href=\"style.css\">"))
    assert(contains(publishedDocument("/docs/std/json"), "<link rel=\"stylesheet\" href=\"../../style.css\">"))
    assert(contains(publishedDocument("/docs/std/json"), "<script type=\"module\" src=\"../../widgets.js\">"))
    assert(contains(publishedDocument("/guide/values"), "<link rel=\"icon\" href=\"../favicon.svg\" type=\"image/svg+xml\">"))
}

test "a payload sits beside its document" {
    assertEq(payloadName("index.html"), "index.data.json")
    assertEq(payloadName("why-vyrn.html"), "why-vyrn.data.json")
}

test "every published document declares its language" {
    assertEq(withLang("<!doctype html>\n<html>\n<head>", "/docs/std/json"), "<!doctype html>\n<html lang=\"en\">\n<head>")
    for path in sitePaths() {
        let html = withLang(renderedBody(path), path)
        assert(contains(html, "<html lang=\"en\""))
        assert(!contains(html, "<html>"))
    }
}

test "the display type step reaches nine pages and no leaf page" {
    // The stylesheet raises the display step on `[data-landing]` alone, which
    // `site/test/typescale.test.mjs` checks, so a leaf page keeps its type
    // scale exactly when it does not carry the attribute.
    assertEq(landingPaths().length, 9)
    let mut stamped = 0
    for path in sitePaths() {
        let doc = publishedDocument(path)
        let on = countOf(doc, "<html lang=\"en\" data-landing>")
        assertEq(on, if isLanding(path) { 1 } else { 0 })
        stamped = stamped + on
        assertEq(countOf(doc, "<html lang=\"en\""), 1)
    }
    assertEq(stamped, 9)
    for slug in chapterSlugs() {
        assert(!isLanding(hrefGuide(slug)))
    }
    for m in apiModules() {
        assert(!isLanding(hrefDocsStd(m.name)))
    }
    for p in packages() {
        assert(!isLanding(hrefExplore(p.slug)))
    }
    assert(!isLanding("/philosophy"))
    assert(!isLanding("/editors"))
    // Under `/docs/` and not the reference landing.
    assert(!isLanding("/docs/editors"))
    assert(isLanding("/docs"))
}

test "the version the pages feature is the newest one the repository has" {
    // `repo.vyrn` reconciles `site/release.txt` with the repository's tags.
    let rows = releaseRows()
    if rows.length > 0 {
        assertEq(releaseTag(), rows[rows.length - 1].tag)
    }
    // Only the release table names an older tag.
    for path in sitePaths() {
        if path != "/releases" {
            for row in rows {
                if row.tag != releaseTag() {
                    assert(!contains(publishedDocument(path), row.tag))
                }
            }
        }
    }
}

test "the published stylesheet keeps every rule and none of the prose" {
    assertEq(stripCssComments(".a { color: red }\n"), ".a { color: red }\n")
    assertEq(stripCssComments("/* why */\n.a { color: red }\n"), ".a { color: red }\n")
    assertEq(stripCssComments(".a { /* why */ color: red }\n"), ".a {  color: red }\n")
    // A `/*` inside a string is not a comment.
    assertEq(stripCssComments(".a::before { content: \"/*\" }\n"), ".a::before { content: \"/*\" }\n")
    assertEq(stripCssComments(".a::before { content: '*/' }\n/* g */\n.b { top: 0 }\n"), ".a::before { content: '*/' }\n.b { top: 0 }\n")
    // An unterminated comment drops the rest of the sheet and does not trap.
    assertEq(stripCssComments(".a { color: red }\n/* merge artifact"), ".a { color: red }\n")

    let shipped = match stylesheet() {
        Ok(text) => text,
        Err(why) => why,
    }
    assert(contains(shipped, ".band { padding: var(--sect) 0;"))
    assert(!contains(shipped, "/*"))
}

test "every published document points at an icon this export writes" {
    let mut copied = false
    for asset in assets() {
        if asset[1] == "favicon.svg" {
            copied = true
        }
    }
    assert(copied)
    for path in sitePaths() {
        let html = withIcon(renderedBody(path))
        assert(contains(html, "<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">"))
    }
}

test "every page says what it is to a crawler, and no two pages say the same" {
    // Each card is present, and no two pages share a title or a description.
    let mut blurbs: Array<String> = []
    let mut titles: Array<String> = []
    let mut websites = 0
    for path in sitePaths() {
        let doc = publishedDocument(path)
        if redirectTarget(path).byteLength > 0 {
            assert(!contains(doc, "og:title"))
            continue
        }
        let kind = if isIndex(path) { "website" } else { "article" }
        if isIndex(path) {
            websites = websites + 1
        }
        let url = absoluteUrl(path)
        let title = withoutSiteName(titleOf(doc))
        let blurb = descriptionOf(doc)
        assert(contains(doc, "<link rel=\"canonical\" href=\"\{url}\">"))
        assert(contains(doc, "<meta property=\"og:url\" content=\"\{url}\">"))
        assert(contains(doc, "<meta property=\"og:site_name\" content=\"Vyrn\">"))
        assert(contains(doc, "<meta property=\"og:type\" content=\"\{kind}\">"))
        assert(contains(doc, "<meta property=\"og:title\" content=\"\{title}\">"))
        assert(contains(doc, "<meta property=\"og:description\" content=\"\{blurb}\">"))
        assert(contains(doc, "<meta name=\"twitter:card\" content=\"summary\">"))
        assert(contains(doc, "<meta name=\"twitter:title\" content=\"\{title}\">"))
        assert(contains(doc, "<meta name=\"twitter:description\" content=\"\{blurb}\">"))
        assert(contains(doc, "<meta name=\"theme-color\" media=\"(prefers-color-scheme: dark)\""))
        assert(title.byteLength > 0)
        assert(blurb.byteLength >= blurbFloor())
        assert(blurb.byteLength <= blurbLimit())
        if kind == "article" {
            assert(contains(doc, "<meta property=\"article:section\" content=\"\{articleSection(path, kind)}\">"))
            assert(contains(doc, "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\""))
        }
        for was in blurbs {
            assert(was != blurb)
        }
        for was in titles {
            assert(was != title)
        }
        blurbs.push(blurb.copy())
        titles.push(title.copy())
    }
    assertEq(blurbs.length, sitePaths().length - redirects().length)
    // The home page and the ten section indexes.
    assertEq(websites, 11)
    assert(contains(publishedDocument(rootPath()), "\"@type\":\"SoftwareApplication\""))
    let leaf = publishedDocument(hrefDocsStd("json"))
    assertEq(titleOf(leaf), "std/json \u{2014} Vyrn")
    assert(contains(leaf, "<meta property=\"og:title\" content=\"std/json\">"))
    assert(contains(leaf, "<meta property=\"og:type\" content=\"article\">"))
    assert(contains(leaf, "<meta property=\"article:section\" content=\"Reference\">"))
    assert(contains(leaf, "<meta name=\"description\" content=\"std/json: the JSON value tree"))
}

test "a title fits a search result, and the site name is only in the tab" {
    // A search result cuts a title at 60 characters. The home page's title is
    // allowed 65, which stops it growing.
    for path in sitePaths() {
        let title = titleOf(publishedDocument(path))
        let ceiling = if path == rootPath() { 65 } else { 60 }
        assert(title.byteLength <= ceiling)
    }
    assertEq(withoutSiteName("std/json \u{2014} Vyrn"), "std/json")
    assertEq(withoutSiteName("Ownership, consume, regions \u{2014} the Vyrn guide"), "Ownership, consume, regions")
    assertEq(withoutSiteName("Routes, RPC and the dev server \u{2014} Vyrn docs"), "Routes, RPC and the dev server")
    assertEq(withoutSiteName("examples/bin \u{2014} the Vyrn registry"), "examples/bin")
    assertEq(withoutSiteName("Vyrn \u{2014} a systems language with the expressiveness of TypeScript"), "Vyrn \u{2014} a systems language with the expressiveness of TypeScript")
    assertEq(withoutSiteName("Nothing to drop"), "Nothing to drop")
}

test "a route's own address is absolute, and its section is the shelf it sits on" {
    assertEq(absoluteUrl(rootPath()), siteOrigin())
    assertEq(absoluteUrl(hrefDocsStd("json")), siteOrigin() + "docs/std/json.html")
    assert(isIndex(rootPath()))
    assert(isIndex(webPath()))
    assert(isIndex(toolingPath()))
    assert(!isIndex(hrefGuide("values")))
    assert(!isIndex(docsGraphPath()))
    assertEq(articleSection(hrefGuide("values"), "article"), "Docs")
    assertEq(articleSection(hrefDocsStd("json"), "article"), "Reference")
    assertEq(articleSection(hrefWeb("views"), "article"), "Web")
    assertEq(articleSection(hrefExplore("shelf"), "article"), "Explore")
    assertEq(articleSection(docsPath(), "website"), "")
}

test "the browser furniture is the colour the stylesheet paints" {
    let paper = paperColours()
    assertEq(paper.length, 2)
    assert(startsWith(paper[0], "oklch("))
    assert(startsWith(paper[1], "oklch("))
    assert(paper[0] != paper[1])
    assert(contains(themeColours(), "media=\"(prefers-color-scheme: light)\" content=\"\{paper[0]}\""))
}

test "a value is read out of one attribute and into another, or it is not there" {
    let head = "<title>A \u{2014} Vyrn</title><meta name=\"description\" content=\"One line.\">"
    assertEq(titleOf(head), "A \u{2014} Vyrn")
    assertEq(descriptionOf(head), "One line.")
    assertEq(titleOf("<head>nothing</head>"), "")
    assertEq(descriptionOf("<head>nothing</head>"), "")
    // An unterminated value is nothing, not the rest of the document.
    assertEq(titleOf("<title>A \u{2014} Vyrn"), "")
    // The head's title comes before any SVG `<title>` in the body.
    assertEq(titleOf("<title>Head</title><svg><title>A bar</title></svg>"), "Head")
}

test "an attribute scan reads the values and stops at the quote" {
    let hrefs = attrValues("<a href=\"/a.html\"><b id=\"x\">", "href")
    assertEq(hrefs.length, 1)
    assertEq(hrefs[0], "/a.html")
    let ids = attrValues("<b id=\"x\"><i id=\"y\">", "id")
    assertEq(ids.length, 2)
    assertEq(ids[0], "x")
    assertEq(ids[1], "y")
    assertEq(attrValues("<b>", "id").length, 0)
    // An attribute whose name ends in the name is not the attribute.
    assertEq(attrValues("<li data-id=\"x\" id=\"y\">", "id").length, 1)
    let cross = fragmentOf("/compare.html#numbers")
    assertEq(cross[0], "/compare.html")
    assertEq(cross[1], "numbers")
    let here = fragmentOf("#graph")
    assertEq(here[0], "")
    assertEq(here[1], "graph")
    assertEq(fragmentOf("/docs.html")[1], "")
}

test "every fragment the site writes lands on an element that is there" {
    let mut files: Array<String> = []
    let mut links: Array<Array<String>> = []
    let mut ids: Array<Array<String>> = []
    for path in sitePaths() {
        let html = renderedBody(path)
        files.push("/" + published(path))
        links.push(attrValues(html, "href"))
        ids.push(attrValues(html, "id"))
    }
    let mut checked = 0
    let mut i = 0
    while i < links.length {
        for href in links[i] {
            let parts = fragmentOf(href)
            if parts[1].byteLength > 0 && !startsWith(parts[0], "http") {
                // The page the fragment is on: this one, or the one it names.
                let mut target = i
                if parts[0].byteLength > 0 {
                    target = 0 - 1
                    let mut k = 0
                    while k < files.length {
                        if files[k] == parts[0] {
                            target = k
                        }
                        k = k + 1
                    }
                    // A link to a page this export does not write is broken.
                    // `/play.html` is the exception, checked by its own test.
                    if parts[0] != "/play.html" {
                        if target < 0 {
                            print("FAIL \{files[i]}: \{href} names a page this export does not write")
                        }
                        assert(target >= 0)
                    }
                }
                if target >= 0 && parts[0] != "/play.html" {
                    if !includes(ids[target], parts[1]) {
                        print("FAIL \{files[i]}: \{href} lands on no id of that page")
                    }
                    assert(includes(ids[target], parts[1]))
                    checked = checked + 1
                }
            }
        }
        i = i + 1
    }
    // A gate that checked nothing would pass in silence.
    assert(checked > 200)
}

test "every playground link carries base64url and nothing else" {
    // `play.html#c=` takes base64url of the program's UTF-8 bytes: `-` for `+`,
    // `_` for `/`, no padding. A `+` would arrive as a space.
    let mut links = 0
    for path in sitePaths() {
        for href in attrValues(renderedBody(path), "href") {
            if startsWith(href, "/play.html#c=") {
                let code = substring(href, 13, href.byteLength)
                assert(code.byteLength > 0)
                for b in bytes(code) {
                    assert((b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || b == '-' || b == '_')
                }
                links = links + 1
            }
        }
    }
    assert(links > 20)
}

test "every export the search offers has an anchor on the page it points at" {
    // The search script builds `/docs/std/<m>.html#e-<name>` in the browser, so
    // each name it offers is checked against the reference page here.
    let mut names = 0
    for row in searchRows() {
        let html = renderedBody(hrefDocsStd(row.name))
        for name in row.exports {
            assert(contains(html, "id=\"e-\{name}\""))
            names = names + 1
        }
    }
    assert(names > 300)
}

test "the registry publishes one page per package, and an unknown name is a 404" {
    let all = packages()
    assert(all.length >= 4)
    for p in all {
        assertEq(packageHref(p.slug), "/" + published(hrefExplore(p.slug)))
        assertEq(documentStatus(hrefExplore(p.slug)), 200)
    }
    // A standard library module is not a package.
    assertEq(documentStatus("/explore/json"), 404)
    assertEq(documentStatus("/explore/nope"), 404)
    assertEq(currentNav("/explore/shelf"), "/explore.html")
    assertEq(currentNav("/explore"), "/explore.html")
}

test "every package page carries the specifier" {
    // The line a reader copies is also an attribute, because a gate cannot read
    // a highlighted code box and a reader cannot copy an attribute. Both come
    // from `offerOf`, so the two cannot disagree.
    //
    // `site/test/installspec.test.mjs` re-parses every specifier with the
    // grammar `compiler/vyrn-cli/src/remote.rs` applies.
    let mut specs = 0
    for p in packages() {
        let html = renderedBody(hrefExplore(p.slug))
        let spec = offerOf(p.slug).spec
        assert(startsWith(spec, "github:"))
        assert(contains(html, "data-spec=\"" + escapedQuotes(spec) + "\""))
        assert(contains(html, addCommand(p.slug)))
        specs = specs + 1
    }
    assertEq(specs, packages().length)
}

/// `s` with its quotes as `std/html` writes them into an attribute value.
fn escapedQuotes(s: String) -> String {
    return replace(s, "\"", "&quot;")
}

test "one module list, and the pages that do not render it" {
    // The reference lists modules and the registry lists packages, and neither
    // links into the other's pages.
    let docs = renderedBody(docsPath())
    let explore = renderedBody(explorePath())
    assert(!contains(explore, "href=\"/docs/std/"))
    for m in apiModules() {
        assert(contains(docs, "href=\"/docs/std/\{m.name}.html\""))
        assert(!contains(explore, "href=\"/explore/\{m.name}.html\""))
        assert(!contains(docs, "href=\"/explore/\{m.name}.html\""))
    }
    for p in packages() {
        assert(contains(explore, "href=\"/explore/\{p.slug}.html\""))
        assert(!contains(docs, "href=\"/explore/\{p.slug}.html\""))
    }
    // Each page has one search input over its own list, and every row carries
    // the text the filter matches.
    assert(contains(docs, "data-search-list"))
    assert(contains(explore, "data-search-list"))
    assertEq(countOf(docs, "data-search-input"), 1)
    assertEq(countOf(explore, "data-search-input"), 1)
    assertEq(countOf(docs, " data-q=\""), apiModules().length)
    assertEq(countOf(docs, " data-e=\""), apiModules().length)
    assertEq(countOf(explore, " data-q=\""), packages().length)
}

/// Whether `path`, relative to the repository root, is a non-empty file. A
/// missing one is printed with the page that claimed it.
fn implExists(path: String) -> Bool {
    return match readFile(path) {
        Ok(body) => body.byteLength > 0,
        Err(why) => saidMissing(path, why),
    }
}

/// The failure arm of `implExists`, so both arms answer a `Bool`.
fn saidMissing(path: String, why: String) -> Bool {
    print("the editors page claims `\{path}`, which this repository does not have: \{why}")
    return false
}

test "every feature the editors page claims names a file that is in this repository" {
    // Each feature row carries its implementing file as `data-impl`. This reads
    // the rendered page, not the table behind it, and opens every path.
    let html = renderedBody(toolingEditorsPath())
    let claimed = attrValues(html, "data-impl")
    assert(claimed.length > 15)
    assertEq(claimed.length, features().length)
    for path in claimed {
        assert(implExists(path))
    }
}

test "each shelf publishes one page per chapter, and an unknown slug is a 404" {
    for slug in chapterSlugs() {
        let area = chapterArea(slug)
        let path = if area == "web" {
            hrefWeb(slug)
        } else if area == "tooling" {
            hrefTooling(slug)
        } else {
            hrefGuide(slug)
        }
        assertEq(documentStatus(path), 200)
        assertEq("/" + published(path), chapterHref(slug))
    }
    assertEq(documentStatus("/guide/nope"), 404)
    // A slug from another shelf is not this shelf's page.
    assertEq(documentStatus("/web/values"), 404)
    assertEq(documentStatus("/tooling/views"), 404)
    assertEq(currentNav("/guide/values"), "/guide.html")
    assertEq(currentNav("/web/views"), "/guide.html")
    assertEq(currentNav("/tooling"), "/guide.html")
    assertEq(currentNav("/guide"), "/guide.html")
}
