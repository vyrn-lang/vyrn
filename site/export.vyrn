test "every page says what it is to a crawler, and no two pages say the same" {
    let mut blurbs: Array<String> = []
    let mut titles: Array<String> = []
    let mut websites = 0
    for path in sitePaths() {
        let doc = publishedDocument(path)
        if redirectTarget(path).byteLength > 0 {
            assert(!contains(doc, "og:title"))
            continue
        }
        let kind = if isIndex(path) { "website" } else { "article" }
        if isIndex(path) {
            websites = websites + 1
        }
        let url = absoluteUrl(path)
        let title = withoutSiteName(titleOf(doc))
        let blurb = descriptionOf(doc)
        assert(contains(doc, "<link rel=\"canonical\" href=\"\{url}\">"))
        assert(contains(doc, "<meta property=\"og:url\" content=\"\{url}\">"))
        assert(contains(doc, "<meta property=\"og:site_name\" content=\"Vyrn\">"))
        assert(contains(doc, "<meta property=\"og:type\" content=\"\{kind}\">"))
        assert(contains(doc, "<meta property=\"og:title\" content=\"\{title}\">"))
        assert(contains(doc, "<meta property=\"og:description\" content=\"\{blurb}\">"))
        assert(contains(doc, "<meta name=\"twitter:card\" content=\"summary\">"))
        assert(contains(doc, "<meta name=\"twitter:title\" content=\"\{title}\">"))
        assert(contains(doc, "<meta name=\"twitter:description\" content=\"\{blurb}\">"))
        assert(contains(doc, "<meta name=\"theme-color\" media=\"(prefers-color-scheme: dark)\""))
        assert(title.byteLength > 0)
        assert(blurb.byteLength >= blurbFloor())
        assert(blurb.byteLength <= blurbLimit())
        if kind == "article" {
            assert(contains(doc, "<meta property=\"article:section\" content=\"\{articleSection(path, kind)}\">"))
            assert(contains(doc, "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"TechArticle\""))
        }
        for was in blurbs {
            assert(was != blurb)
        }
        for was in titles {
            assert(was != title)
        }
        blurbs.push(blurb.copy())
        titles.push(title.copy())
    }
    assertEq(blurbs.length, sitePaths().length - redirects().length)
    assertEq(websites, 11)
    assert(contains(publishedDocument(rootPath()), "\"@type\":\"SoftwareApplication\""))
    let leaf = publishedDocument(hrefDocsStd("json"))
    assertEq(titleOf(leaf), "std/json \u{2014} Vyrn")
    assert(contains(leaf, "<meta property=\"og:title\" content=\"std/json\">"))
    assert(contains(leaf, "<meta property=\"og:type\" content=\"article\">"))
    assert(contains(leaf, "<meta property=\"article:section\" content=\"Reference\">"))
    assert(contains(leaf, "<meta name=\"description\" content=\"std/json: the JSON value tree"))
}

test "a title fits a search result, and the site name is only in the tab" {
    for path in sitePaths() {
        let title = titleOf(publishedDocument(path))
        let ceiling = if path == rootPath() { 65 } else { 60 }
        assert(title.byteLength <= ceiling)
    }
    assertEq(withoutSiteName("std/json \u{2014} Vyrn"), "std/json")
    assertEq(withoutSiteName("Ownership, consume, regions \u{2014} the Vyrn guide"), "Ownership, consume, regions")
    assertEq(withoutSiteName("Routes, RPC and the dev server \u{2014} Vyrn docs"), "Routes, RPC and the dev server")
    assertEq(withoutSiteName("examples/bin \u{2014} the Vyrn registry"), "examples/bin")
    assertEq(withoutSiteName("Vyrn \u{2014} a systems language with the expressiveness of TypeScript"), "Vyrn \u{2014} a systems language with the expressiveness of TypeScript")
    assertEq(withoutSiteName("Nothing to drop"), "Nothing to drop")
}

