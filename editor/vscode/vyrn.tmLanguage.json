    { "name": "comment.line.vyrn", "match": "\\/\\/(?!\\/(?!\\/))(?>(?:(?!\\x0a)[\\s\\S])*)" },
    { "name": "string.quoted.vyrn", "begin": "\\\"\\\"\\\"", "end": "(?>\\\"\\\"\\\")", "beginCaptures": { "0": { "name": "punctuation.definition.string.quoted.begin.vyrn" } }, "endCaptures": { "0": { "name": "punctuation.definition.string.quoted.end.vyrn" } }, "patterns": [{ "name": "meta.interpolation.vyrn", "begin": "\\\\\\{", "end": "(?>\\})", "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.vyrn" } }, "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.vyrn" } }, "patterns": [{ "include": "#braces" }, { "include": "$self" }] }, { "name": "constant.character.escape.vyrn", "match": "\\\\u(?>\\{)(?>(?:(?!\\})[\\s\\S])*)(?>\\})" }, { "name": "constant.character.escape.vyrn", "match": "\\\\[ntr\\\\\\\"]" }] },
    { "name": "string.quoted.vyrn", "begin": "\\\"", "end": "(?>\\\")", "beginCaptures": { "0": { "name": "punctuation.definition.string.quoted.begin.vyrn" } }, "endCaptures": { "0": { "name": "punctuation.definition.string.quoted.end.vyrn" } }, "patterns": [{ "name": "meta.interpolation.vyrn", "begin": "\\\\\\{", "end": "(?>\\})", "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.vyrn" } }, "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.vyrn" } }, "patterns": [{ "include": "#braces" }, { "include": "$self" }] }, { "name": "constant.character.escape.vyrn", "match": "\\\\u(?>\\{)(?>(?:(?!\\})[\\s\\S])*)(?>\\})" }, { "name": "constant.character.escape.vyrn", "match": "\\\\[ntr\\\\\\\"]" }] },
    { "name": "constant.character.vyrn", "match": "\\'(?>\\\\(?>[ntr0\\\\\\']|x(?>[0-9A-Fa-f][0-9A-Fa-f]))|[ -\\~])(?>\\')" },
    { "name": "constant.numeric.vyrn", "match": "\\b(?>(?:[0-9])+)(?>(?:\\.(?>(?:[0-9])+))?)" },
    { "name": "support.type.vyrn", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:break|continue|drop|else|enum|export|false|fn|for|if|impl|import|in|let|match|mut|protocol|region|return|self|true|type|where|while)\\b" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:Bool|F32x4|F64x2|Float32|Float64|I32x4|Int16|Int32|Int64|Int8|Logger|Mask32x4|Mask64x2|String|UInt16|UInt32|UInt64|UInt8|Unit)\\b(?=\\s*(?:Array\\b|Bool\\b|F32x4\\b|F64x2\\b|Float32\\b|Float64\\b|I32x4\\b|Int16\\b|Int32\\b|Int64\\b|Int8\\b|Logger\\b|Map\\b|Mask32x4\\b|Mask64x2\\b|Merge\\b|Omit\\b|Option\\b|Partial\\b|Pick\\b|Readonly\\b|Result\\b|SmallArray\\b|Stream\\b|String\\b|UInt16\\b|UInt32\\b|UInt64\\b|UInt8\\b|Unit\\b|[0-9]|\\&|\\)|\\,|\\/\\/|\\;|\\=|\\>|\\p{L}|\\{|\\||\\}|_|bench\\b|contract\\b|export\\b|extern\\b|fn\\b|gen\\b|impl\\b|import\\b|let\\b|logging\\b|mut\\b|protocol\\b|test\\b|type\\b|where\\b))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:await)\\b(?=\\s*(?:[0-9]|\\\"|\\\"\\\"\\\"|\\'|\\(|\\[|\\p{L}|_|false\\b|if\\b|match\\b|self\\b|true\\b|vyrn\\b))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:bench|test|vyrn)\\b(?=\\s*(?:\\\"|\\\"\\\"\\\"))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:from)\\b(?=\\s*(?:\\\"|\\\"\\\"\\\"|\\p{L}|_))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:Array|Map|Merge|Omit|Option|Partial|Pick|Readonly|Result|SmallArray|Stream)\\b(?=\\s*(?:\\<))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:as|contract)\\b(?=\\s*(?:\\p{L}|_))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:await|consume)\\b(?=\\s*(?:\\p{L}|_|self\\b))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:logging)\\b(?=\\s*(?:\\{))" },
    { "name": "keyword.control.vyrn", "match": "\\b(?:extern|gen)\\b(?=\\s*(?:fn\\b))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\(|\\(\\s|\\:|\\:\\s)\\b(?:consume|modify|read)\\b(?=\\s*(?:\\p{L}|_|fn\\b|self\\b))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\*|\\*\\s)\\b(?:as)\\b(?=\\s*(?:\\p{L}|_))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\,|\\,\\s|\\{|\\{\\s)\\b(?:level|sink)\\b(?=\\s*(?:\\:))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\-\\>|\\-\\>\\s)\\b(?:modify|read)\\b(?=\\s*(?:\\(|\\p{L}|_|fn\\b))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\:|\\:\\s)\\b(?:lazy)\\b(?=\\s*(?:Array\\b|Bool\\b|F32x4\\b|F64x2\\b|Float32\\b|Float64\\b|I32x4\\b|Int16\\b|Int32\\b|Int64\\b|Int8\\b|Logger\\b|Map\\b|Mask32x4\\b|Mask64x2\\b|Merge\\b|Omit\\b|Option\\b|Partial\\b|Pick\\b|Readonly\\b|Result\\b|SmallArray\\b|Stream\\b|String\\b|UInt16\\b|UInt32\\b|UInt64\\b|UInt8\\b|Unit\\b|[0-9]|\\p{L}|\\{|_|fn\\b))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\:|\\:\\s)\\b(?:file)\\b(?=\\s*(?:\\())" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\:|\\:\\s)\\b(?:debug|error|info|stderr|stdout|trace|warn)\\b(?=\\s*(?:\\,|\\p{L}|\\}|_|level\\b|sink\\b))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\bexport\\s)\\b(?:to)\\b(?=\\s*(?:\\\"|\\\"\\\"\\\"))" },
    { "name": "keyword.control.vyrn", "match": "(?<=\\bin\\s)\\b(?:consume)\\b(?=\\s*(?:\\p{L}|_))" },
    { "name": "entity.name.function.vyrn", "match": "(?<=\\bfn\\s)[a-z_][A-Za-z0-9_]*" },
    { "name": "entity.name.function.vyrn", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\(|\")" },
    { "name": "variable.other.vyrn", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
    { "name": "keyword.operator.vyrn", "match": "\\-\\>|\\=\\>|\\=\\~|\\=\\=|\\!\\=|\\<\\=|\\>\\=|\\&\\&|\\|\\||\\?\\?|\\<\\<|\\>\\>|\\+|\\-|\\*|\\/|\\%|\\=|\\<|\\>|\\!|\\?|\\||\\&|\\^|\\~" },
    { "name": "punctuation.section.braces.vyrn", "match": "\\{|\\}" },
    { "name": "punctuation.section.brackets.vyrn", "match": "\\[|\\]" },
    { "name": "punctuation.section.parens.vyrn", "match": "\\(|\\)" },
    { "name": "punctuation.separator.vyrn", "match": "\\,|\\;|\\:|\\." }
  ],
  "repository": {
    "braces": { "name": "meta.block.vyrn", "begin": "\\{", "end": "\\}", "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.vyrn" } }, "endCaptures": { "0": { "name": "punctuation.section.braces.end.vyrn" } }, "patterns": [{ "include": "#braces" }, { "include": "$self" }] }
