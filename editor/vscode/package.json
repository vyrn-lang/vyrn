{
  "name": "vyrn",
  "displayName": "Vyrn",
  "description": "Language support for Vyrn: syntax highlighting + diagnostics via the vyrn-lsp server.",
  "version": "0.1.0-indev",
  "publisher": "vyrn-lang",
  "license": "MIT",
  "icon": "icons/vyrn.png",
  "engines": { "vscode": "^1.91.0" },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:vyrn",
    "onLanguage:vyx",
    "onLanguage:syntax",
    "workspaceContains:**/vyrn.json"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx --yes @vscode/vsce@3.9.2 package --allow-missing-repository --no-update-package-json"
  },
  "contributes": {
    "languages": [
      {
        "id": "vyrn",
        "aliases": ["Vyrn", "vyrn"],
        "extensions": [".vyrn"],
        "icon": { "light": "./icons/vyrn.svg", "dark": "./icons/vyrn.svg" },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "vyx",
        "aliases": ["Vyx", "vyx"],
        "extensions": [".vyx"],
        "icon": { "light": "./icons/vyrn.svg", "dark": "./icons/vyrn.svg" },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "von",
        "aliases": ["VON", "von"],
        "extensions": [".von"],
        "icon": { "light": "./icons/vyrn.svg", "dark": "./icons/vyrn.svg" },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "syntax",
        "aliases": ["Vyrn Syntax", "syntax"],
        "extensions": [".syntax"],
        "icon": { "light": "./icons/syntax.svg", "dark": "./icons/syntax.svg" },
        "configuration": "./syntax-language-configuration.json"
      },
      {
        "id": "vyrn-dsl",
        "aliases": ["Vyrn language file"],
        "icon": { "light": "./icons/dsl.svg", "dark": "./icons/dsl.svg" }
      }
    ],
    "grammars": [
      {
        "language": "vyrn",
        "scopeName": "source.vyrn",
        "path": "./vyrn.tmLanguage.json",
        "tokenTypes": { "constant.character.vyrn": "string", "meta.template.expression.vyrn": "other" }
      },
      {
        "language": "von",
        "scopeName": "source.vyrn",
        "path": "./vyrn.tmLanguage.json",
        "tokenTypes": { "constant.character.vyrn": "string", "meta.template.expression.vyrn": "other" }
      },
      {
        "language": "vyx",
        "scopeName": "source.vyx",
        "path": "./vyx.tmLanguage.json",
        "tokenTypes": { "constant.character.vyrn": "string", "meta.template.expression.vyrn": "other" }
      },
      {
        "language": "syntax",
        "scopeName": "source.syntax",
        "path": "./syntax.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "escapeSequence", "superType": "string", "description": "constant.character.escape" },
      { "id": "regexpGroup", "superType": "regexp", "description": "punctuation.definition.group.regexp" },
      { "id": "regexpQuantifier", "superType": "regexp", "description": "keyword.operator.quantifier.regexp" },
      { "id": "regexpAlternation", "superType": "regexp", "description": "keyword.operator.or.regexp" },
      { "id": "regexpLookaround", "superType": "regexp", "description": "keyword.operator.lookaround.regexp" },
      { "id": "regexpAnchor", "superType": "regexp", "description": "keyword.control.anchor.regexp" },
      { "id": "regexpBackref", "superType": "regexp", "description": "keyword.other.back-reference.regexp" }
    ],
    "semanticTokenScopes": [
      {
        "language": "vyrn",
        "scopes": {
          "enumMember": ["variable.other.enummember"],
          "namespace": ["entity.name.namespace"],
          "type": ["entity.name.type"],
          "parameter": ["variable.parameter"],
          "macro": ["entity.name.function.macro"],
          "method": ["entity.name.function.member"],
          "escapeSequence": ["constant.character.escape"],
          "regexpGroup": ["punctuation.definition.group.regexp"],
          "regexpQuantifier": ["keyword.operator.quantifier.regexp"],
          "regexpAlternation": ["keyword.operator.or.regexp"],
          "regexpLookaround": ["keyword.operator.lookaround.regexp"],
          "regexpAnchor": ["keyword.control.anchor.regexp"],
          "regexpBackref": ["keyword.other.back-reference.regexp"],
          "*.modification": ["markup.deleted"]
        }
      },
      {
        "language": "vyx",
        "scopes": {
          "enumMember": ["variable.other.enummember"],
          "namespace": ["entity.name.namespace"],
          "type": ["entity.name.type"],
          "parameter": ["variable.parameter"],
          "macro": ["entity.name.function.macro"],
          "method": ["entity.name.function.member"],
          "escapeSequence": ["constant.character.escape"],
          "regexpGroup": ["punctuation.definition.group.regexp"],
          "regexpQuantifier": ["keyword.operator.quantifier.regexp"],
          "regexpAlternation": ["keyword.operator.or.regexp"],
          "regexpLookaround": ["keyword.operator.lookaround.regexp"],
          "regexpAnchor": ["keyword.control.anchor.regexp"],
          "regexpBackref": ["keyword.other.back-reference.regexp"],
          "*.modification": ["markup.deleted"]
        }
      }
    ],
    "snippets": [
      {
        "language": "vyrn",
        "path": "./snippets/vyrn.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "vyrn.run",
        "title": "Vyrn: Run File",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.test",
        "title": "Vyrn: Run Test",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.testAll",
        "title": "Vyrn: Run All Tests",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.dev",
        "title": "Vyrn: Run Dev Server",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.bench",
        "title": "Vyrn: Run Bench",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.benchAll",
        "title": "Vyrn: Run All Benches",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.profile",
        "title": "Vyrn: Profile File",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.profileTests",
        "title": "Vyrn: Profile Tests",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.whyCost",
        "title": "Vyrn: Explain Costs",
        "category": "Vyrn"
      },
      {
        "command": "vyrn.associateLanguages",
        "title": "Vyrn: associate project languages",
        "category": "Vyrn"
      }
    ],
    "configuration": {
      "title": "Vyrn",
      "properties": {
        "vyrn.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the vyrn-lsp server binary. When empty, resolves vyrn-lsp from PATH (or from beside the vyrn on PATH — the release archive ships both), then the repository's own debug build at compiler/vyrn-lsp/target/debug/vyrn-lsp(.exe)."
        },
        "vyrn.costHints": {
          "type": "boolean",
          "default": true,
          "description": "Show what each line costs at its end (allocates Folded, copies String, index checked), with the reason in the tooltip, and the blocks of the last `vyrn run --profile` beside each line and above each function when the source has not changed since. Turning it off restarts the language server."
        },
        "vyrn.hints.style": {
          "type": "string",
          "enum": ["compact", "full"],
          "default": "compact",
          "enumDescriptions": [
            "One glyph per fact with its count; hover a glyph for its causes and a link to `vyrn why --cost`.",
            "The facts in words, as `vyrn why --cost` labels them."
          ],
          "description": "How the cost hints read. A change restarts the language server."
        },
        "vyrn.path": {
          "type": "string",
          "default": "",
          "description": "Path to the vyrn compiler binary used by the ▶ Run CodeLens. When empty, resolves ${workspaceFolder}/compiler/target/release/vyrn(.exe), then the debug build, then falls back to `cargo run -p vyrn-cli`."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}