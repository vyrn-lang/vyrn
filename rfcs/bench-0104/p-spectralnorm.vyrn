/// Probe: spectral-norm at N = 100, whole — `Float64` arrays, the eigenvalue
/// iteration, one square root and a `%.9f` print, checked against
/// `spectralnorm-100.expected`.
///
/// It is the end-to-end version of `p-sqrt.vyrn` and `p-fmt9.vyrn`: those two
/// answer "is there a sqrt" and "can nine places be printed", this one answers
/// whether the two together reproduce a number the game publishes. nbody needs
/// exactly the same three things.

/// The scalar square root, which is one lane of the SIMD one — see `p-sqrt`.
fn sqrtF(x: Float64) -> Float64 {
    return F64x2.sqrt(F64x2(x, x)).lane(0)
}

fn fixed9(x: Float64) -> String {
    let scaled = Int64(x * 1000000000.0 + 0.5)
    let whole = scaled / 1000000000
    let mut frac = "\{scaled % 1000000000}"
    while frac.byteLength < 9 {
        frac = "0\{frac}"
    }
    return "\{whole}.\{frac}"
}

fn cell(i: Int64, j: Int64) -> Float64 {
    return 1.0 / Float64((i + j) * (i + j + 1) / 2 + i + 1)
}

fn multiplyAv(n: Int64, v: Array<Float64>, out: consume Array<Float64>) -> Array<Float64> {
    let mut w = out
    let mut i = 0
    while i < n {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            sum = sum + cell(i, j) * v[j]
            j = j + 1
        }
        w[i] = sum
        i = i + 1
    }
    return w
}

fn multiplyAtv(n: Int64, v: Array<Float64>, out: consume Array<Float64>) -> Array<Float64> {
    let mut w = out
    let mut i = 0
    while i < n {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            sum = sum + cell(j, i) * v[j]
            j = j + 1
        }
        w[i] = sum
        i = i + 1
    }
    return w
}

fn main() -> Int64 {
    let n = 100
    let mut u: Array<Float64> = []
    let mut v: Array<Float64> = []
    let mut w: Array<Float64> = []
    let mut i = 0
    while i < n {
        u.push(1.0)
        v.push(0.0)
        w.push(0.0)
        i = i + 1
    }
    let mut it = 0
    while it < 10 {
        w = multiplyAv(n, u, w)
        v = multiplyAtv(n, w, v)
        w = multiplyAv(n, v, w)
        u = multiplyAtv(n, w, u)
        it = it + 1
    }
    let mut vbv = 0.0
    let mut vv = 0.0
    let mut k = 0
    while k < n {
        vbv = vbv + u[k] * v[k]
        vv = vv + v[k] * v[k]
        k = k + 1
    }
    print(fixed9(sqrtF(vbv / vv)))
    return 0
}
