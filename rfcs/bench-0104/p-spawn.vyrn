/// Probe: can `spawn` / `join` express a data-parallel variant of one of these
/// programs? spectral-norm is the natural one — its matrix-vector product is a
/// row range per worker and nothing shared is written.
///
/// The doubts are the isolation rule (a spawned function may not do I/O) and
/// ownership: two workers both want to read the same vector, and an `Array` has
/// one owner. This runs the same N = 100 iteration as `p-spectralnorm.vyrn` over
/// two tasks and prints the same number.

fn sqrtF(x: Float64) -> Float64 {
    return F64x2.sqrt(F64x2(x, x)).lane(0)
}

fn fixed9(x: Float64) -> String {
    let scaled = Int64(x * 1000000000.0 + 0.5)
    let whole = scaled / 1000000000
    let mut frac = "\{scaled % 1000000000}"
    while frac.byteLength < 9 {
        frac = "0\{frac}"
    }
    return "\{whole}.\{frac}"
}

fn cell(i: Int64, j: Int64) -> Float64 {
    return 1.0 / Float64((i + j) * (i + j + 1) / 2 + i + 1)
}

/// Rows `lo ..< hi` of `A v` (or of `At v` when `transposed`) — one worker's
/// share. It returns its slice; nothing is written through a shared name.
fn rows(n: Int64, v: Array<Float64>, lo: Int64, hi: Int64, transposed: Bool) -> Array<Float64> {
    let mut out: Array<Float64> = []
    let mut i = lo
    while i < hi {
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            if transposed {
                sum = sum + cell(j, i) * v[j]
            } else {
                sum = sum + cell(i, j) * v[j]
            }
            j = j + 1
        }
        out.push(sum)
        i = i + 1
    }
    return out
}

/// Two tasks, each over half the rows, joined into one vector.
///
/// The version of this probe that was written first passed `v.copy()` to each
/// worker, expecting the arguments to be moved into the task. They are not: `v`
/// is a `read` parameter of `rows`, both tasks read the same array, and the
/// copies were unnecessary. That is the answer for every one of these programs —
/// a read-only input needs no per-worker duplicate.
fn parallelMultiply(n: Int64, v: Array<Float64>, transposed: Bool) -> Array<Float64> {
    let half = n / 2
    let top = spawn rows(n, v, 0, half, transposed)
    let bottom = spawn rows(n, v, half, n, transposed)
    let mut out = top.join()
    for x in bottom.join() {
        out.push(x)
    }
    return out
}

fn main() -> Int64 {
    let n = 100
    let mut u: Array<Float64> = []
    let mut i = 0
    while i < n {
        u.push(1.0)
        i = i + 1
    }
    let mut v: Array<Float64> = []
    let mut it = 0
    while it < 10 {
        let w1 = parallelMultiply(n, u, false)
        v = parallelMultiply(n, w1, true)
        let w2 = parallelMultiply(n, v, false)
        u = parallelMultiply(n, w2, true)
        it = it + 1
    }
    let mut vbv = 0.0
    let mut vv = 0.0
    let mut k = 0
    while k < n {
        vbv = vbv + u[k] * v[k]
        vv = vv + v[k] * v[k]
        k = k + 1
    }
    print(fixed9(sqrtF(vbv / vv)))
    return 0
}
