/// Probe: mandelbrot's output is a binary PBM. Can Vyrn emit one?
///
/// The game's mandelbrot writes `P4\n<n> <n>\n` and then one bit per pixel,
/// packed eight to a byte — so most of the output bytes are >= 0x80 and none of
/// it is text. Vyrn's only two sinks are `print` (a `String`, plus a newline)
/// and `writeFile` (two `String` arguments). This asks what happens when the
/// bytes are not UTF-8.

fn main() -> Int64 {
    // The header is ASCII and goes out fine.
    print("P4")
    print("4 4")

    // A packed row of pixels. 0xFF is a legal PBM byte and not a legal UTF-8
    // scalar on its own.
    let mut row: Array<UInt8> = []
    row.push(255)
    row.push(128)
    row.push(15)
    match stringFromBytes(row) {
        Ok(s) => print("string from packed bytes: ok, \{s.byteLength} bytes"),
        Err(e) => print("string from packed bytes: \{e}"),
    }

    // And the ASCII half, to show the refusal is about the bytes and not the call.
    let mut ascii: Array<UInt8> = []
    ascii.push('P')
    ascii.push('4')
    match stringFromBytes(ascii) {
        Ok(s) => print("string from ASCII bytes: ok, \{s}"),
        Err(e) => print("string from ASCII bytes: \{e}"),
    }
    return 0
}
