/// Probe: mandelbrot at 200x200 — the `Float64` kernel and the bit packing.
///
/// The arithmetic is ordinary and `F64x2` is here (RFC-0083 M4), so the doubt
/// is not the maths: it is the output. The game's mandelbrot writes a binary
/// PBM, and `p-binout.vyrn` shows that neither sink Vyrn has will carry those
/// bytes. So this probe computes the same bits and prints them as hex, one row
/// a line, and `ref/checkhex.py` compares them against `mandelbrot-200.expected`.
/// The pixels are right; only the way out is missing.

fn hex2(b: Int64) -> String {
    let digits = "0123456789abcdef"
    let d = bytes(digits)
    let mut w: Array<UInt8> = []
    w.push(d[(b / 16) % 16])
    w.push(d[b % 16])
    return match stringFromBytes(w) {
        Ok(s) => s,
        Err(_) => "",
    }
}

fn main() -> Int64 {
    let n = 200
    print("P4")
    print("\{n} \{n}")
    let mut y = 0
    while y < n {
        let ci = 2.0 * Float64(y) / Float64(n) - 1.0
        let mut row = ""
        let mut bits = 0
        let mut nbits = 0
        let mut x = 0
        while x < n {
            let cr = 2.0 * Float64(x) / Float64(n) - 1.5
            let mut zr = 0.0
            let mut zi = 0.0
            let mut inside = 1
            let mut i = 0
            while i < 50 {
                let nzr = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = nzr
                if zr * zr + zi * zi > 4.0 {
                    inside = 0
                    i = 50
                } else {
                    i = i + 1
                }
            }
            bits = bits * 2 + inside
            nbits = nbits + 1
            if nbits == 8 {
                row = "\{row}\{hex2(bits)}"
                bits = 0
                nbits = 0
            }
            x = x + 1
        }
        if nbits > 0 {
            let mut pad = nbits
            while pad < 8 {
                bits = bits * 2
                pad = pad + 1
            }
            row = "\{row}\{hex2(bits)}"
        }
        print(row)
        y = y + 1
    }
    return 0
}
