/// Probe: nbody at n = 1000, whole — checked against `nbody-1000.expected`.
///
/// `p-sqrt.vyrn` and `p-fmt9.vyrn` answer its two doubtful pieces separately.
/// The third is here: nbody keeps an array of bodies and writes their velocity
/// and position fields through an index, `bodies[i].vx = ...`, in the innermost
/// loop of the whole benchmark set.

type Body = {
    x: Float64,
    y: Float64,
    z: Float64,
    vx: Float64,
    vy: Float64,
    vz: Float64,
    mass: Float64,
}

fn sqrtF(v: Float64) -> Float64 {
    return F64x2.sqrt(F64x2(v, v)).lane(0)
}

fn fixed9(v: Float64) -> String {
    let mut a = v
    let mut sign = ""
    if a < 0.0 {
        sign = "-"
        a = 0.0 - a
    }
    let scaled = Int64(a * 1000000000.0 + 0.5)
    let whole = scaled / 1000000000
    let mut frac = "\{scaled % 1000000000}"
    while frac.byteLength < 9 {
        frac = "0\{frac}"
    }
    return "\{sign}\{whole}.\{frac}"
}

fn solarMass() -> Float64 {
    return 4.0 * 3.141592653589793 * 3.141592653589793
}

fn daysPerYear() -> Float64 {
    return 365.24
}

fn system() -> Array<Body> {
    let sm = solarMass()
    let dy = daysPerYear()
    let mut b: Array<Body> = []
    b.push(Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: sm })
    b.push(Body {
            x: 4.84143144246472090,
            y: -1.16032004402742839,
            z: -0.103622044471123109,
            vx: 0.00166007664274403694 * dy,
            vy: 0.00769901118419740425 * dy,
            vz: -0.0000690460016972063023 * dy,
            mass: 0.000954791938424326609 * sm,
        })
    b.push(Body {
            x: 8.34336671824457987,
            y: 4.12479856412430479,
            z: -0.403523417114321381,
            vx: -0.00276742510726862411 * dy,
            vy: 0.00499852801234917238 * dy,
            vz: 0.0000230417297573763929 * dy,
            mass: 0.000285885980666130812 * sm,
        })
    b.push(Body {
            x: 12.8943695621391310,
            y: -15.1111514016986312,
            z: -0.223307578892655734,
            vx: 0.00296460137564761618 * dy,
            vy: 0.00237847173959480950 * dy,
            vz: -0.0000296589568540237556 * dy,
            mass: 0.0000436624404335156298 * sm,
        })
    b.push(Body {
            x: 15.3796971148509165,
            y: -25.9193146099879641,
            z: 0.179258772950371181,
            vx: 0.00268067772490389322 * dy,
            vy: 0.00162824170038242295 * dy,
            vz: -0.0000951592254519715870 * dy,
            mass: 0.0000515138902046611451 * sm,
        })
    return b
}

/// The sun's velocity is set so the whole system's momentum is zero.
fn offsetMomentum(bodies: consume Array<Body>) -> Array<Body> {
    let mut b = bodies
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    for body in b {
        px = px + body.vx * body.mass
        py = py + body.vy * body.mass
        pz = pz + body.vz * body.mass
    }
    b[0].vx = 0.0 - px / solarMass()
    b[0].vy = 0.0 - py / solarMass()
    b[0].vz = 0.0 - pz / solarMass()
    return b
}

fn energy(b: Array<Body>) -> Float64 {
    let mut e = 0.0
    let mut i = 0
    while i < b.length {
        e = e + 0.5 * b[i].mass * (b[i].vx * b[i].vx + b[i].vy * b[i].vy + b[i].vz * b[i].vz)
        let mut j = i + 1
        while j < b.length {
            let dx = b[i].x - b[j].x
            let dy = b[i].y - b[j].y
            let dz = b[i].z - b[j].z
            e = e - b[i].mass * b[j].mass / sqrtF(dx * dx + dy * dy + dz * dz)
            j = j + 1
        }
        i = i + 1
    }
    return e
}

fn advance(bodies: consume Array<Body>, dt: Float64) -> Array<Body> {
    let mut b = bodies
    let mut i = 0
    while i < b.length {
        let mut j = i + 1
        while j < b.length {
            let dx = b[i].x - b[j].x
            let dy = b[i].y - b[j].y
            let dz = b[i].z - b[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrtF(d2))
            let mi = b[i].mass
            let mj = b[j].mass
            b[i].vx = b[i].vx - dx * mj * mag
            b[i].vy = b[i].vy - dy * mj * mag
            b[i].vz = b[i].vz - dz * mj * mag
            b[j].vx = b[j].vx + dx * mi * mag
            b[j].vy = b[j].vy + dy * mi * mag
            b[j].vz = b[j].vz + dz * mi * mag
            j = j + 1
        }
        i = i + 1
    }
    let mut k = 0
    while k < b.length {
        b[k].x = b[k].x + dt * b[k].vx
        b[k].y = b[k].y + dt * b[k].vy
        b[k].z = b[k].z + dt * b[k].vz
        k = k + 1
    }
    return b
}

fn main() -> Int64 {
    let mut b = offsetMomentum(system())
    print(fixed9(energy(b)))
    let mut i = 0
    while i < 1000 {
        b = advance(b, 0.01)
        i = i + 1
    }
    print(fixed9(energy(b)))
    return 0
}
