/// The toy provider (RFC-0107 M0 probe). An ordinary module that knows nothing
/// about `.vyx`: `glyphs(dir, names)` reads the pinned collection under `dir` and
/// emits one `Html` function per named glyph. `glyphsAt` takes an anchor as well,
/// so probe P7b can ask where a provider's diagnostic is allowed to land.
///
/// The collection is `name=body` lines rather than Iconify JSON: this probe is
/// about the loading/evaluation MECHANISM, and a JSON reader would only make the
/// transcript longer.
import { lines, split, splitWhitespace, editDistance } from "std/strings"
import { report, Severity } from "std/diag"
import { contains } from "std/strpred"

/// The provider proper: a module exporting one `Html` function per named glyph.
export gen fn glyphs(dir: String, names: String) -> String {
    return glyphsSource(dir, names, "", 0, 0)
}

/// The same provider, told where its caller stood (`anchorFile:line:col`) so an
/// unknown-name report can be anchored there instead of in the collection.
export gen fn glyphsAt(
    dir: String,
    names: String,
    anchorFile: String,
    line: Int64,
    col: Int64,
) -> String {
    return glyphsSource(dir, names, anchorFile, line, col)
}

/// The pure core: read the collection under `dir`, emit one function per name in
/// `names`, and report an unknown name with a nearest-name suggestion.
gen fn glyphsSource(
    dir: String,
    names: String,
    anchorFile: String,
    line: Int64,
    col: Int64,
) -> String {
    let path = dir + "/collection.txt"
    let raw = match readFile(path) {
        Ok(v) => v,
        Err(e) => "",
    }
    let known = glyphNames(raw)
    let mut out = "/// Generated by the RFC-0107 M0 probe provider — do not edit.\n"
    out = out + "import { el, text, Html } from \"std/html\"\n"
    for want in splitWhitespace(names) {
        let body = glyphBody(raw, want)
        if body == "" {
            let msg = "the collection under `\{dir}` has no glyph `\{want}` — nearest is `\{nearest(known, want)}`"
            if anchorFile == "" {
                out = out + report(Error, path, 1, 1, msg)
            } else {
                out = out + report(Error, anchorFile, line, col, msg)
            }
        } else {
            out = out + "export fn \{want}() -> Html {\n"
            out = out + "    return el(\"svg\", [], [text(\"\{body}\")])\n"
            out = out + "}\n"
        }
    }
    return out
}

/// Every glyph name in the collection, in file order.
fn glyphNames(raw: String) -> Array<String> {
    let mut out: Array<String> = []
    for ln in lines(raw) {
        let kv = split(ln, "=")
        if kv.length == 2 {
            out.push(kv[0].copy())
        }
    }
    return out
}

/// The body of glyph `want`, or "" when the collection does not carry it.
fn glyphBody(raw: String, want: String) -> String {
    for ln in lines(raw) {
        let kv = split(ln, "=")
        if kv.length == 2 && kv[0] == want {
            return kv[1].copy()
        }
    }
    return ""
}

/// The known name closest to `want` (RFC-0107's "nearest" suggestion).
fn nearest(known: Array<String>, want: String) -> String {
    let mut best = ""
    let mut bestD = 1000
    for k in known {
        let d = editDistance(k, want)
        if d < bestD {
            bestD = d
            best = k.copy()
        }
    }
    return best
}

test "an unknown glyph is reported at the anchor it was given, not emitted" {
    let src = glyphsSource("./data", "definitelyNotAGlyph", "./T.vyx", 3, 4)
    assert(contains(src, "//@diag error ./T.vyx:3:4"))
    assert(contains(src, "export fn definitelyNotAGlyph") == false)
}
