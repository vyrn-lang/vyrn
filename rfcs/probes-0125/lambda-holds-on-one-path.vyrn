// RFC-0125 M3 probe: a lambda that holds a String on one path and not the
// other. `pick` binds `s`, hands it to `keep` on every third turn and leaves
// it held on the others. The analysis's fate for `s` is "moved into the
// call", so it places no release on the `return 0` path (the shape of
// `returned-on-one-path.vyrn`, inside a lambda). Before this slice no row
// inside a lambda ran at all: both compiled backends lifted a lambda under a
// shell that owned no rows, and the kernel did not judge lambda frames.
// Peak working set at 200,000 and 400,000 turns, before: see RFC-0125 §3 M3,
// "lambda frames".
let turns = 200000

fn make(i: Int64) -> String {
    return "value-" + i.toString() + "-with-enough-length-to-live-on-the-heap"
}

fn keep(s: consume String) -> Int64 {
    return s.byteLength
}

fn main() -> Int64 {
    let pick: fn(Int64) -> Int64 = n -> {
        let s = make(n)
        if n % 3 == 0 {
            return keep(s)
        }
        return 0
    }
    let mut i = 0
    let mut total = 0
    while i < turns {
        total = total + pick(i)
        i = i + 1
    }
    print(total)
    return 0
}
