/// The untyped half of `fromJson`, and the generator of the
/// typed half.
///
/// `jsonDecoders` writes the typed half per target type. What it writes reads
/// the source once through a `JsonReader` and decodes each value into its slot;
/// it builds no `Json` tree. It calls this module for the reader, `Issue`s,
/// paths and scalar decoders. Decoding accumulates: a decoder records its
/// failure and returns, and a composite constructs only when every part
/// succeeded. So every decoder returns an `Array<T>` of zero or one element;
/// empty means the issue is already recorded. `Option<T>` cannot serve: with
/// `T = Option<U>` it has no wire form. Every message is the canonical wording,
/// byte for byte. A refused document yields its `json.parse` Issue alone, and a
/// record's Issues follow its members' declaration order, whatever the
/// document's key order.
///
/// The tree accessors (`fieldsOf`, `fieldAt` and the rest) serve programs that
/// read a `Json` from `parseJson`.

import { Json, JsonField, JsonReader, copyJson, copyJsonArray, copyJsonFields } from "std/json"
import { JsonKeySet } from "std/jsonread"
import * as jr from "std/jsonread"
import { parseInt64, parseUInt64, parseFloat64, parseFloat32 } from "std/num"

/// An object's fields in document order, or `[]` for anything else.
export fn fieldsOf(v: Json) -> Array<JsonField> {
    return match v {
        JObj(fs) => copyJsonFields(fs),
        JNull => [],
        JBool(b) => [],
        JNum(t) => [],
        JStr(s) => [],
        JArr(a) => [],
    }
}

/// An array's items, or `[]` for anything else.
export fn itemsOf(v: Json) -> Array<Json> {
    return match v {
        JArr(items) => copyJsonArray(items),
        JNull => [],
        JBool(b) => [],
        JNum(t) => [],
        JStr(s) => [],
        JObj(f) => [],
    }
}

/// A number's raw source text, or `""` for anything else.
export fn numText(v: Json) -> String {
    return match v {
        JNum(t) => t.copy(),
        JNull => "",
        JBool(b) => "",
        JStr(s) => "",
        JArr(a) => "",
        JObj(f) => "",
    }
}

/// Whether an object carries `key` at all (a present `null` is still present).
export fn hasField(fs: Array<JsonField>, key: String) -> Bool {
    for f in fs {
        if f.key == key {
            return true
        }
    }
    return false
}

/// The value of `key`, or `JNull` when absent.
export fn fieldAt(fs: Array<JsonField>, key: String) -> Json {
    for f in fs {
        if f.key == key {
            return copyJson(f.value)
        }
    }
    return JNull
}

/// Element `i`, or `JNull` when the index is past the end.
export fn elemAt(items: Array<Json>, i: Int64) -> Json {
    if i < 0 || i >= items.length {
        return JNull
    }
    return copyJson(items[i])
}

/// A bare string's content (a nullary enum variant's wire form), or `""`. No
/// variant can be named `""`, so the sentinel cannot collide with a real tag.
export fn tagOf(v: Json) -> String {
    return match v {
        JStr(s) => s.copy(),
        JNull => "",
        JBool(b) => "",
        JNum(t) => "",
        JArr(a) => "",
        JObj(f) => "",
    }
}

/// `json.type`: `expected <what>, found <kind>`.
export fn pushType(iss: modify Array<Issue>, path: String, expected: String, found: String) -> Unit {
    iss.push(Issue {
        key: "json.type",
        path: path.copy(),
        message: "expected " + expected + ", found " + found,
    })
}

/// ``json.missing``: ``missing required field `name` ``.
export fn pushMissing(iss: modify Array<Issue>, path: String, field: String) -> Unit {
    iss.push(Issue {
        key: "json.missing",
        path: path.copy(),
        message: "missing required field `" + field + "`",
    })
}

/// `validate`: a refined type's `where` clause did not hold. The caller passes
/// the compiler's validation message, so the trap and this path word it the
/// same.
export fn pushValidate(iss: modify Array<Issue>, path: String, message: String) -> Unit {
    iss.push(Issue { key: "validate", path: path.copy(), message: message.copy() })
}

/// A dotted path extended by a record field (or an enum tag).
export fn fieldPath(parent: String, field: String) -> String {
    if parent == "" {
        return field.copy()
    }
    return parent + "." + field
}

/// A path extended by an array index.
export fn indexPath(parent: String, i: Int64) -> String {
    return parent + "[" + i.toString() + "]"
}

/// The path of a value a decoder reads: `path` itself when `idx` is `-2`,
/// `path[idx]` for an element, and `path.seg` for a member when `idx` is `-1`.
/// A decoder builds it only for an Issue or for its own members, so a value
/// that decodes builds no path.
export fn pathAt(path: String, seg: String, idx: Int64) -> String {
    if idx == -2 {
        return path.copy()
    }
    if idx >= 0 {
        return indexPath(path, idx)
    }
    return fieldPath(path, seg)
}

// The reader the generated decoders call. Generated source spells only this
// module's names, so the `std/jsonread` functions it needs pass through here.

/// A reader over `src`.
export fn openDoc(src: String) -> JsonReader {
    return jr.jsonReader(src)
}

/// Ends a decode: `[]`, or the one `json.parse` Issue of a refused document.
export fn closeDoc(p: modify JsonReader) -> Array<Issue> {
    jr.finishJson(p)
    let mut out: Array<Issue> = []
    if jr.jsonRefused(p) {
        out.push(Issue { key: "json.parse", path: "", message: p.err.copy() })
    }
    return out
}

/// The kind of the value at the cursor, as `std/jsonread`'s `kindAt` names it.
export fn kindAt(p: JsonReader) -> Int64 {
    return jr.jsonKindAt(p)
}

export fn kindName(k: Int64) -> String {
    return jr.jsonKindName(k)
}

/// Whether the value at the cursor is of `kind`, a `kindAt` kind. If it is
/// not, records `expected <what>, found <kind>` at the value's path (see
/// `pathAt`) and reads the value past.
export fn expect(
    p: modify JsonReader,
    path: String,
    seg: String,
    idx: Int64,
    iss: modify Array<Issue>,
    kind: Int64,
    what: String,
) -> Bool {
    let k = jr.jsonKindAt(p)
    if k == kind {
        return true
    }
    pushType(iss, pathAt(path, seg, idx), what, jr.jsonKindName(k))
    jr.skipJsonValue(p)
    return false
}

/// Reads a `null` at the cursor and answers whether there was one: the wire
/// form of an absent `Option`.
export fn readNull(p: modify JsonReader) -> Bool {
    if jr.jsonKindAt(p) == 'n' {
        jr.readJsonKeyword(p)
        return true
    }
    return false
}

export fn readString(p: modify JsonReader) -> String {
    return jr.readJsonString(p)
}

export fn skipValue(p: modify JsonReader) -> Unit {
    jr.skipJsonValue(p)
}

export fn enterObject(p: modify JsonReader) -> Bool {
    return jr.enterJsonObject(p)
}

export fn enterArray(p: modify JsonReader) -> Bool {
    return jr.enterJsonArray(p)
}

export fn readKey(p: modify JsonReader) -> String {
    return jr.readJsonKey(p)
}

export fn keyIs(p: modify JsonReader, name: String) -> Bool {
    return jr.readJsonKeyIf(p, name)
}

export fn nextMember(p: modify JsonReader) -> Bool {
    return jr.nextJsonMember(p)
}

export fn nextItem(p: modify JsonReader) -> Bool {
    return jr.nextJsonItem(p)
}

export fn keySet() -> JsonKeySet {
    return jr.jsonKeySet()
}

/// Reads past the `:` after a record member's `key`, or refuses the key as a
/// duplicate when the member was `seen`.
export fn member(p: modify JsonReader, seen: Bool, key: String) -> Unit {
    if seen {
        jr.refuseJsonDuplicate(p, key)
        return
    }
    jr.readJsonColon(p)
}

/// Records `key` in `keys` and reads past the `:`, answering `true`; or
/// refuses the key as a duplicate and answers `false`.
export fn mapMember(p: modify JsonReader, keys: modify JsonKeySet, key: String) -> Bool {
    if jr.admitJsonKey(p, keys, key) {
        jr.readJsonColon(p)
        return true
    }
    return false
}

/// Reads a member no field claims: an unknown field is ignored, but its key
/// may not repeat and its value must be JSON.
export fn skipMember(p: modify JsonReader, keys: modify JsonKeySet, key: String) -> Unit {
    if mapMember(p, keys, key) {
        jr.skipJsonValue(p)
    }
}

/// Moves `iss[base..]` out, in order: a record puts its members' Issues back
/// in declaration order with `putIssues`.
export fn takeIssues(iss: modify Array<Issue>, base: Int64) -> Array<Issue> {
    let mut late: Array<Issue> = []
    let mut i = base
    while i < iss.length {
        late.push(copyIssue(iss[i]))
        i = i + 1
    }
    while iss.length > base {
        iss.pop()
    }
    return late
}

/// Appends `late[a..b]`, end excluded, to `iss`.
export fn putIssues(iss: modify Array<Issue>, late: Array<Issue>, a: Int64, b: Int64) -> Unit {
    let mut i = a
    while i < b {
        iss.push(copyIssue(late[i]))
        i = i + 1
    }
}

fn copyIssue(x: Issue) -> Issue {
    return Issue { key: x.key.copy(), path: x.path.copy(), message: x.message.copy() }
}

export fn dStr(p: modify JsonReader, path: String, seg: String, idx: Int64, iss: modify Array<Issue>) -> Array<String> {
    let mut out: Array<String> = []
    if expect(p, path, seg, idx, iss, '"', "string") {
        out.push(jr.readJsonString(p))
    }
    return out
}

export fn dBool(p: modify JsonReader, path: String, seg: String, idx: Int64, iss: modify Array<Issue>) -> Array<Bool> {
    let mut out: Array<Bool> = []
    if expect(p, path, seg, idx, iss, 't', "boolean") {
        out.push(jr.readJsonKeyword(p))
    }
    return out
}

/// A JSON integer-syntax number as an exact `Int64`. A fraction, an exponent or
/// a magnitude outside `Int64` is `expected integer`, never a rounded value.
export fn dInt64(p: modify JsonReader, path: String, seg: String, idx: Int64, iss: modify Array<Issue>) -> Array<Int64> {
    return dIntRange(p, path, seg, idx, iss, 0 - 9223372036854775807 - 1, 9223372036854775807)
}

/// An object key read as an `Int64`, the wire form of `Map<Int64, V>`, in the
/// map at `path`. Only the canonical text (`n.toString()`) passes: `"007"`
/// and `"+7"` would otherwise collapse into the key `"7"` with no Issue.
export fn dIntKey(key: String, path: String, iss: modify Array<Issue>) -> Array<Int64> {
    let mut out: Array<Int64> = []
    if let Some(n) = parseInt64(key) {
        if n.toString() == key {
            out.push(n)
            return out
        }
    }
    pushType(iss, fieldPath(path, key), "an integer key", "\"" + key + "\"")
    return out
}

/// `dInt64` restricted to `[lo, hi]`, for the sized signed integers.
export fn dIntRange(
    p: modify JsonReader,
    path: String,
    seg: String,
    idx: Int64,
    iss: modify Array<Issue>,
    lo: Int64,
    hi: Int64,
) -> Array<Int64> {
    let mut out: Array<Int64> = []
    if expect(p, path, seg, idx, iss, '0', "integer") == false {
        return out
    }
    if let Some(n) = parseInt64(jr.readJsonNumber(p)) {
        if n >= lo && n <= hi {
            out.push(n)
            return out
        }
    }
    pushType(iss, pathAt(path, seg, idx), "integer", "number")
    return out
}

/// A JSON integer-syntax number as an exact `UInt64` in `[0, hi]`.
/// `parseInt64` cannot serve: it has no room above `Int64.max`.
export fn dUIntMax(
    p: modify JsonReader,
    path: String,
    seg: String,
    idx: Int64,
    iss: modify Array<Issue>,
    hi: UInt64,
) -> Array<UInt64> {
    let mut out: Array<UInt64> = []
    if expect(p, path, seg, idx, iss, '0', "integer") == false {
        return out
    }
    if let Some(n) = parseUInt64(jr.readJsonNumber(p)) {
        if n <= hi {
            out.push(n)
            return out
        }
    }
    pushType(iss, pathAt(path, seg, idx), "integer", "number")
    return out
}

/// A JSON number as a `Float64`, correctly rounded (`std/num`). Integer syntax is
/// accepted: `1` decodes into a `Float64` target as `1.0`.
export fn dFloat64(p: modify JsonReader, path: String, seg: String, idx: Int64, iss: modify Array<Issue>) -> Array<Float64> {
    let mut out: Array<Float64> = []
    if expect(p, path, seg, idx, iss, '0', "number") == false {
        return out
    }
    if let Some(f) = parseFloat64(jr.readJsonNumber(p)) {
        out.push(f)
        return out
    }
    pushType(iss, pathAt(path, seg, idx), "number", "number")
    return out
}

/// A JSON number as a `Float32`, rounded once: decimal -> `Float64` ->
/// `Float32` rounds twice and is wrong near a `Float32` tie.
export fn dFloat32(p: modify JsonReader, path: String, seg: String, idx: Int64, iss: modify Array<Issue>) -> Array<Float32> {
    let mut out: Array<Float32> = []
    if expect(p, path, seg, idx, iss, '0', "number") == false {
        return out
    }
    if let Some(f) = parseFloat32(jr.readJsonNumber(p)) {
        out.push(f)
        return out
    }
    pushType(iss, pathAt(path, seg, idx), "number", "number")
    return out
}

// The typed half is generated; its tests live in `examples/jsondecbytes.vyrn`.

/// Writes the decoders `fromJson` calls: for each root, the entry that reads a
/// document into `Validation<T>`, and for each node, the function that decodes
/// the value at a reader's cursor into zero or one value. Generated source
/// cannot spell reserved names, so it writes `VyrnRt_` for `std/json`'s,
/// `VyrnRd_` for this module's and `VyrnWp_` for a `where` type's predicate.
export gen fn jsonDecoders(t: TypeArg) -> String {
    let mut out = ""
    for r in t.roots {
        let n = t.nodes[r]
        // `consume` walks: a borrowed walk leaks the decoded snapshot on every
        // call.
        out = out + "fn " + n.name + "(src: String) -> Validation<" + n.spelling + "> {\n"
        out = out + "    let mut iss: Array<Issue> = []\n    let mut p = VyrnRd_openDoc(src)\n"
        out = out + "    let val = d" + n.name + "(p, \"\", \"\", 0 - 2, iss)\n    let bad = VyrnRd_closeDoc(p)\n"
        out = out + "    if bad.length > 0 {\n        return Invalid(consume bad)\n    }\n"
        out = out + "    if iss.length > 0 {\n        return Invalid(consume iss)\n    }\n"
        out = out + "    for x in consume val {\n        return Valid(x)\n    }\n    return Invalid(consume iss)\n}\n"
    }
    for n in t.nodes {
        out = out + "fn d" + n.name + "(p: modify VyrnRt_JsonReader, path: String, seg: String, idx: Int64, iss: modify Array<Issue>) -> Array<" + n.spelling + "> {\n"
        out = out + jsonDecoderBody(t, n) + "}\n"
        // `{ c: 1 }` is not an expression, so a record without a name gets an
        // alias for its literal.
        if n.kind == "record" && !isName(n.spelling) {
            let mut fs = ""
            for m in n.members {
                fs = fs + (if fs == "" { "" } else { ", " }) + m.name + ": " + t.nodes[m.args[0]].spelling
            }
            out = out + "type r" + n.name + " = { " + fs + " }\n"
        }
    }
    return out
}

gen fn isName(s: String) -> Bool {
    for b in bytes(s) {
        let word = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
        if !word {
            return false
        }
    }
    return true
}

/// The statement that returns `out` unless the value at the cursor is of
/// `kind`, a `kindAt` kind written as a byte literal, worded `what` in the
/// Issue.
gen fn expectLine(kind: String, what: String) -> String {
    return "    if VyrnRd_expect(p, path, seg, idx, iss, '" + kind + "', \"" + what + "\") == false {\n        return out\n    }\n"
}

/// A decoder's body. A composite constructs only when every part produced a
/// value; each part's issues are already recorded.
gen fn jsonDecoderBody(t: TypeArg, n: TypeNode) -> String {
    let out = "    let mut out: Array<" + n.spelling + "> = []\n"
    // Decode the base, then run the declaration's predicate. The push into
    // `Array<T>` is the construction, and it holds for a record base too.
    if n.kind == "where" {
        let mut binds = ""
        for m in n.members {
            binds = binds + (if binds == "" { "" } else { ", " }) + "b." + m.name
        }
        let args = if binds == "" { "b" } else { binds }
        let base = "    for b in d" + t.nodes[n.args[0]].name + "(p, path, seg, idx, iss) {\n"
        let test = "        if VyrnWp_" + n.spelling + "(" + args + ") {\n            out.push(b)\n"
        let fail = "        } else {\n            VyrnRd_pushValidate(iss, VyrnRd_pathAt(path, seg, idx), \"" + n.predicate + "\")\n        }\n    }\n"
        return out + base + test + fail + "    return out\n"
    }
    if n.kind == "record" {
        return out + expectLine("{", "object") + jsonRecordBody(t, n)
    }
    // Each element decodes at `path[i]`; a bad element is an issue, not a
    // missing array.
    if n.kind == "array" {
        let e = t.nodes[n.args[0]]
        let walk = "    let here = VyrnRd_pathAt(path, seg, idx)\n    let mut acc: Array<" + e.spelling + "> = []\n    if VyrnRd_enterArray(p) {\n        let mut i = 0\n        while true {\n"
        let each = "            for e in d" + e.name + "(p, here, \"\", i, iss) {\n                acc.push(e)\n            }\n            i = i + 1\n"
        let next = "            if VyrnRd_nextItem(p) == false {\n                break\n            }\n        }\n    }\n"
        return out + expectLine("[", "array") + walk + each + next + "    out.push(acc)\n    return out\n"
    }
    // Document order becomes insertion order; the reader refuses a repeated
    // key. An `Int64` key must be canonical decimal text, and a refused key's
    // value is read past.
    if n.kind == "map" {
        let k = t.nodes[n.args[0]]
        let val = t.nodes[n.args[1]]
        let mut put = "                for x in d" + val.name + "(p, here, key, 0 - 1, iss) {\n                    m[key.copy()] = x\n                }\n"
        if k.kind != "String" {
            put = "                let kn = VyrnRd_dIntKey(key, here, iss)\n                if kn.length == 1 {\n"
            put = put + "                    for x in d" + val.name + "(p, here, key, 0 - 1, iss) {\n                        m[kn[0]] = x\n                    }\n"
            put = put + "                } else {\n                    VyrnRd_skipValue(p)\n                }\n"
        }
        let m = "    let here = VyrnRd_pathAt(path, seg, idx)\n    let mut m: Map<" + k.spelling + ", " + val.spelling + "> = [:]\n    let mut keys = VyrnRd_keySet()\n"
        let walk = "    if VyrnRd_enterObject(p) {\n        while true {\n            let key = VyrnRd_readKey(p)\n            if VyrnRd_mapMember(p, keys, key) {\n"
        let next = "            }\n            if VyrnRd_nextMember(p) == false {\n                break\n            }\n        }\n    }\n"
        return out + expectLine("{", "object") + m + walk + put + next + "    out.push(m)\n    return out\n"
    }
    if n.kind == "option" {
        let none = "    if VyrnRd_readNull(p) {\n        out.push(None)\n        return out\n    }\n"
        let some = "    for x in d" + t.nodes[n.args[0]].name + "(p, path, seg, idx, iss) {\n        out.push(Some(x))\n    }\n"
        return out + none + some + "    return out\n"
    }
    if n.kind == "enum" {
        return out + jsonVariantsBody(t, n)
    }
    return jsonScalarBody(n)
}

/// A record: each member decodes into its own slot in the document's key order,
/// and the record is built once every required member has a value. An
/// `Option<T>` member is inlined: absent or `null` is `None`, and a failed
/// inner decode leaves `None` with its issue recorded. Member `i`'s Issues are
/// `iss[base + a_i .. base + b_i]`; if any Issue or a missing member exists,
/// they are put back in declaration order, each missing member's in its place.
gen fn jsonRecordBody(t: TypeArg, n: TypeNode) -> String {
    let mut slots = "    let here = VyrnRd_pathAt(path, seg, idx)\n    let base = iss.length\n    let mut unk = VyrnRd_keySet()\n"
    let mut arms = ""
    let mut fast = ""
    let mut slow = ""
    let mut order = ""
    let mut missing = ""
    let mut guards = ""
    let mut inits = ""
    let mut i = 0
    for m in n.members {
        let f = t.nodes[m.args[0]]
        let ix = i.toString()
        let name = "\"" + m.name + "\""
        let at = "(p, here, " + name + ", 0 - 1, iss)"
        slots = slots + "    let mut s" + ix + " = false\n    let mut a" + ix + " = 0\n    let mut b" + ix + " = 0\n"
        inits = inits + (if i == 0 { "" } else { ", " }) + m.name + ": f" + ix
        let put = "        if s" + ix + " {\n            VyrnRd_putIssues(iss, late, a" + ix + ", b" + ix + ")\n        }"
        let mut read = ""
        if f.kind == "option" {
            let inner = t.nodes[f.args[0]]
            slots = slots + "    let mut f" + ix + ": Option<" + inner.spelling + "> = None\n"
            read = "                if VyrnRd_readNull(p) == false {\n                    for x in d" + inner.name + at + " {\n"
            read = read + "                        f" + ix + " = Some(x)\n                    }\n                }\n"
            order = order + put + "\n"
        } else {
            slots = slots + "    let mut f" + ix + ": Array<" + f.spelling + "> = []\n"
            read = "                f" + ix + " = d" + f.name + at + "\n"
            order = order + put + " else {\n            VyrnRd_pushMissing(iss, VyrnRd_fieldPath(here, " + name + "), " + name + ")\n        }\n"
            missing = missing + " || s" + ix + " == false"
            guards = guards + (if guards == "" { "" } else { " && " }) + "f" + ix + ".length == 1"
            // Take the value out of its one-element carrier: an element read
            // borrows its container.
            inits = inits + ".swapRemove(0)"
        }
        let first = i == 0
        fast = fast + (if first { "            if" } else { " else if" }) + " VyrnRd_keyIs(p, " + name + ") {\n                ix = " + ix + "\n            }"
        slow = slow + (if first { "                if" } else { " else if" }) + " key == " + name + " {\n                    ix = " + ix + "\n                }"
        arms = arms + (if first { "            if" } else { " else if" }) + " ix == " + ix + " {\n"
        arms = arms + "                VyrnRd_member(p, s" + ix + ", " + name + ")\n                s" + ix + " = true\n"
        arms = arms + "                a" + ix + " = iss.length - base\n" + read + "                b" + ix + " = iss.length - base\n            }"
        i = i + 1
    }
    // A key spelled as its member is matched in place; any other key is read,
    // so an escaped spelling still names its member and an unknown key is kept
    // for the duplicate check.
    let skip = "VyrnRd_skipMember(p, unk, key)\n"
    let mut claim = "            let key = VyrnRd_readKey(p)\n            " + skip
    if arms != "" {
        claim = "            let mut key = \"\"\n            let mut ix = 0 - 1\n" + fast + " else {\n                key = VyrnRd_readKey(p)\n" + slow + "\n            }\n"
        claim = claim + arms + " else {\n                " + skip + "            }\n"
    }
    let walk = "    if VyrnRd_enterObject(p) {\n        while true {\n" + claim
    let next = "            if VyrnRd_nextMember(p) == false {\n                break\n            }\n        }\n    }\n"
    let fix = "    if iss.length > base" + missing + " {\n        let late = VyrnRd_takeIssues(iss, base)\n" + order + "    }\n"
    let lit = (if isName(n.spelling) { n.spelling.copy() } else { "r" + n.name }) + " { " + inits + " }"
    let body = slots + walk + next + fix
    if guards == "" {
        return body + "    out.push(" + lit + ")\n    return out\n"
    }
    return body + "    if " + guards + " {\n        out.push(" + lit + ")\n    }\n    return out\n"
}

/// A sum in wire form: a bare string is a nullary variant, and a one-key
/// object `{"Tag":..}` a payload variant, a tuple payload as an array. Any
/// other form is a `json.type` issue that names every variant. A payload's
/// value waits in `got` and its Issues in `late` until the object proves to
/// hold one member.
gen fn jsonVariantsBody(t: TypeArg, n: TypeNode) -> String {
    let mut out = "    let k = VyrnRd_kindAt(p)\n"
    let mut expected = ""
    let mut tags = ""
    let mut keys = ""
    for m in n.members {
        expected = expected + (if expected == "" { "one of `" } else { ", `" }) + m.name + "`"
        if m.args.length == 0 {
            tags = tags + "        if tag == \"" + m.name + "\" {\n            out.push(" + m.name + ")\n            return out\n        }\n"
        } else {
            keys = keys + (if keys == "" { "            if" } else { " else if" }) + " key == \"" + m.name + "\" {\n                hit = true\n"
            keys = keys + jsonPayloadArm(t, m) + "            }"
        }
    }
    let wrong = "VyrnRd_pushType(iss, VyrnRd_pathAt(path, seg, idx), \"" + expected + "\", "
    if tags != "" {
        out = out + "    if k == '\"' {\n        let tag = VyrnRd_readString(p)\n" + tags
        out = out + "        " + wrong + "\"string\")\n        return out\n    }\n"
    }
    if keys != "" {
        out = out + "    if k == '{' {\n        let here = VyrnRd_pathAt(path, seg, idx)\n        let mut got: Array<" + n.spelling + "> = []\n        let mut late: Array<Issue> = []\n        let mut hit = false\n        let mut one = false\n"
        out = out + "        let mut keys = VyrnRd_keySet()\n        if VyrnRd_enterObject(p) {\n"
        out = out + "            let key = VyrnRd_readKey(p)\n            VyrnRd_mapMember(p, keys, key)\n"
        out = out + keys + " else {\n                VyrnRd_skipValue(p)\n            }\n            one = true\n"
        out = out + "            while VyrnRd_nextMember(p) {\n                one = false\n                let more = VyrnRd_readKey(p)\n"
        out = out + "                VyrnRd_skipMember(p, keys, more)\n            }\n        }\n"
        out = out + "        if one && hit {\n            VyrnRd_putIssues(iss, late, 0, late.length)\n            return got\n        }\n"
        out = out + "        " + wrong + "\"object\")\n        return out\n    }\n"
    }
    return out + "    " + wrong + "VyrnRd_kindName(k))\n    VyrnRd_skipValue(p)\n    return out\n"
}

/// One payload variant's arm, decoding at `path.Tag` and a tuple's members at
/// `path.Tag[i]`, with Issues into `late`. A tuple's arity is checked once the
/// array is read; its members' Issues count only when the arity holds, so they
/// wait in `el`.
gen fn jsonPayloadArm(t: TypeArg, m: TypeMember) -> String {
    let c = "                let c = VyrnRd_fieldPath(here, \"" + m.name + "\")\n"
    if m.args.length == 1 {
        let each = "                for a0 in d" + t.nodes[m.args[0]].name + "(p, here, \"" + m.name + "\", 0 - 1, late) {\n"
        return each + "                    got.push(" + m.name + "(a0))\n                }\n"
    }
    let arity = m.args.length.toString()
    let mut out = c + "                if VyrnRd_expect(p, c, \"\", 0 - 2, late, '[', \"array\") {\n"
    out = out + "                    let mut el: Array<Issue> = []\n"
    let mut reads = ""
    let mut guards = ""
    let mut binds = ""
    let mut i = 0
    for a in m.args {
        let ix = i.toString()
        let sep = if i == 0 { "" } else { ", " }
        let e = t.nodes[a]
        out = out + "                    let mut a" + ix + ": Array<" + e.spelling + "> = []\n"
        reads = reads + "if n == " + ix + " {\n                                a" + ix + " = d" + e.name + "(p, c, \"\", " + ix + ", el)\n                            } else "
        guards = guards + (if i == 0 { "" } else { " && " }) + "a" + ix + ".length == 1"
        binds = binds + sep + "a" + ix + ".swapRemove(0)"
        i = i + 1
    }
    out = out + "                    let mut n = 0\n                    if VyrnRd_enterArray(p) {\n                        while true {\n"
    out = out + "                            " + reads + "{\n                                VyrnRd_skipValue(p)\n                            }\n"
    out = out + "                            n = n + 1\n                            if VyrnRd_nextItem(p) == false {\n                                break\n                            }\n                        }\n                    }\n"
    out = out + "                    if n != " + arity + " {\n"
    out = out + "                        VyrnRd_pushType(late, c, \"array of length " + arity + "\", \"array of length \" + n.toString())\n"
    out = out + "                    } else {\n                        VyrnRd_putIssues(late, el, 0, el.length)\n"
    out = out + "                        if " + guards + " {\n                            got.push(" + m.name + "(" + binds + "))\n                        }\n"
    return out + "                    }\n                }\n"
}

/// A scalar. A sized integer decodes through an `Int64` or `UInt64` helper
/// that refuses every value outside the type's bounds, so the narrowing
/// conversion cannot wrap.
gen fn jsonScalarBody(n: TypeNode) -> String {
    let k = n.kind
    let whole = if k == "Int64" {
        "VyrnRd_dInt64(p, path, seg, idx, iss)"
    } else if k == "UInt64" {
        "VyrnRd_dUIntMax(p, path, seg, idx, iss, 18446744073709551615)"
    } else if k == "Float64" {
        "VyrnRd_dFloat64(p, path, seg, idx, iss)"
    } else if k == "Float32" {
        "VyrnRd_dFloat32(p, path, seg, idx, iss)"
    } else if k == "Bool" {
        "VyrnRd_dBool(p, path, seg, idx, iss)"
    } else if k == "String" {
        "VyrnRd_dStr(p, path, seg, idx, iss)"
    } else {
        ""
    }
    if whole != "" {
        return "    return " + whole + "\n"
    }
    // Any other kind writes no `return`, and the check of the written code
    // refuses it.
    let narrow = if k == "Int8" {
        "VyrnRd_dIntRange(p, path, seg, idx, iss, 0 - 128, 127)"
    } else if k == "Int16" {
        "VyrnRd_dIntRange(p, path, seg, idx, iss, 0 - 32768, 32767)"
    } else if k == "Int32" {
        "VyrnRd_dIntRange(p, path, seg, idx, iss, 0 - 2147483648, 2147483647)"
    } else if k == "UInt8" {
        "VyrnRd_dUIntMax(p, path, seg, idx, iss, 255)"
    } else if k == "UInt16" {
        "VyrnRd_dUIntMax(p, path, seg, idx, iss, 65535)"
    } else if k == "UInt32" {
        "VyrnRd_dUIntMax(p, path, seg, idx, iss, 4294967295)"
    } else {
        ""
    }
    if narrow == "" {
        return ""
    }
    let out = "    let mut out: Array<" + n.spelling + "> = []\n    for n in " + narrow + " {\n"
    return out + "        out.push(" + n.spelling + "(n))\n    }\n    return out\n"
}

test "a decode result is zero or one element" {
    let mut iss: Array<Issue> = []
    let mut p = openDoc("42")
    assertEq(dInt64(p, "", "", 0 - 2, iss).length, 1)
    let mut q = openDoc("1.5")
    assertEq(dInt64(q, "", "", 0 - 2, iss).length, 0)
    assertEq(iss.length, 1)
    assertEq(iss[0].key, "json.type")
    assertEq(iss[0].message, "expected integer, found number")
}

test "integers decode exactly, never through a Float64" {
    let mut iss: Array<Issue> = []
    let mut p = openDoc("9007199254740993")
    assertEq(dInt64(p, "", "", 0 - 2, iss)[0], 9007199254740993)
    let mut q = openDoc("18446744073709551615")
    assertEq(dUIntMax(q, "", "", 0 - 2, iss, 18446744073709551615)[0], 18446744073709551615)
    assertEq(iss.length, 0)
}

test "a sized integer out of range is a type issue, not a wrap" {
    let mut iss: Array<Issue> = []
    let mut p = openDoc("128")
    assertEq(dIntRange(p, "i8v", "", 0 - 2, iss, 0 - 128, 127).length, 0)
    let mut q = openDoc("-1")
    assertEq(dUIntMax(q, "u32v", "", 0 - 2, iss, 4294967295).length, 0)
    assertEq(iss.length, 2)
    assertEq(iss[0].path, "i8v")
    assertEq(iss[1].path, "u32v")
}

test "a wrong kind is a type issue, and the value is read past" {
    let mut iss: Array<Issue> = []
    let mut p = openDoc("{\"a\":[1]} ")
    assertEq(dStr(p, "s", "", 0 - 2, iss).length, 0)
    assertEq(iss[0].message, "expected string, found object")
    assertEq(closeDoc(p).length, 0)
}

test "paths compose the canonical way" {
    assertEq(fieldPath("", "sur"), "sur")
    assertEq(fieldPath("kids[1]", "name"), "kids[1].name")
    assertEq(indexPath("kids", 1), "kids[1]")
}

test "a parse error is one issue, keyed json.parse, worded line/col" {
    let mut p = openDoc("{ bad")
    skipValue(p)
    let bad = closeDoc(p)
    assertEq(bad.length, 1)
    assertEq(bad[0].key, "json.parse")
    assertEq(bad[0].path, "")
    assertEq(bad[0].message, "line 1, col 3: expected a string key")
}

test "a string's content is its tag" {
    assertEq(tagOf(JStr("Dot")), "Dot")
    assertEq(tagOf(JObj([])), "")
}
