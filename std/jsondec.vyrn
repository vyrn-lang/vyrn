/// std/jsondec: the untyped half of `fromJson`, and the generator of the
/// typed half.
///
/// `jsonDecoders` writes the typed half per target type; what it writes
/// calls this module for kind names, `Issue`s, paths, tree accessors and
/// scalar decoders. Decoding accumulates: a decoder records its
/// failure and returns, and a composite constructs only when every part
/// succeeded. So every decoder returns an `Array<T>` of zero or one element;
/// empty means the issue is already recorded. `Option<T>` cannot serve: with
/// `T = Option<U>` it has no wire form. Every message is the canonical wording,
/// byte for byte.

import { Json, JsonField, copyJson, copyJsonArray, copyJsonFields } from "std/json"
import { parseJson } from "std/jsonread"
import { parseInt64, parseUInt64, parseFloat64, parseFloat32 } from "std/num"

/// The JSON kind name used in `expected <X>, found <kind>`.
export fn kindName(v: Json) -> String {
    return match v {
        JNull => "null",
        JBool(b) => "boolean",
        JNum(t) => "number",
        JStr(s) => "string",
        JArr(a) => "array",
        JObj(f) => "object",
    }
}

/// True for `null`, the wire form of an absent `Option`.
export fn isNull(v: Json) -> Bool {
    return match v {
        JNull => true,
        JBool(b) => false,
        JNum(t) => false,
        JStr(s) => false,
        JArr(a) => false,
        JObj(f) => false,
    }
}

/// An object's fields in document order, or `[]` for anything else.
export fn fieldsOf(v: Json) -> Array<JsonField> {
    return match v {
        JObj(fs) => copyJsonFields(fs),
        JNull => [],
        JBool(b) => [],
        JNum(t) => [],
        JStr(s) => [],
        JArr(a) => [],
    }
}

/// An array's items, or `[]` for anything else.
export fn itemsOf(v: Json) -> Array<Json> {
    return match v {
        JArr(items) => copyJsonArray(items),
        JNull => [],
        JBool(b) => [],
        JNum(t) => [],
        JStr(s) => [],
        JObj(f) => [],
    }
}

/// A number's raw source text, or `""` for anything else.
export fn numText(v: Json) -> String {
    return match v {
        JNum(t) => t.copy(),
        JNull => "",
        JBool(b) => "",
        JStr(s) => "",
        JArr(a) => "",
        JObj(f) => "",
    }
}

/// Whether an object carries `key` at all (a present `null` is still present).
export fn hasField(fs: Array<JsonField>, key: String) -> Bool {
    for f in fs {
        if f.key == key {
            return true
        }
    }
    return false
}

/// The value of `key`, or `JNull` when absent.
export fn fieldAt(fs: Array<JsonField>, key: String) -> Json {
    for f in fs {
        if f.key == key {
            return copyJson(f.value)
        }
    }
    return JNull
}

/// Element `i`, or `JNull` when the index is past the end.
export fn elemAt(items: Array<Json>, i: Int64) -> Json {
    if i < 0 || i >= items.length {
        return JNull
    }
    return copyJson(items[i])
}

/// A bare string's content (a nullary enum variant's wire form), or `""`. No
/// variant can be named `""`, so the sentinel cannot collide with a real tag.
export fn tagOf(v: Json) -> String {
    return match v {
        JStr(s) => s.copy(),
        JNull => "",
        JBool(b) => "",
        JNum(t) => "",
        JArr(a) => "",
        JObj(f) => "",
    }
}

/// The single key of a one-member object (a payload variant's wire form), or
/// `""` for anything else. Reads the fields in place: `fieldsOf` would copy
/// the whole object.
export fn keyOf(v: Json) -> String {
    return match v {
        JObj(fs) => if fs.length == 1 { fs[0].key.copy() } else { "" },
        JNull => "",
        JBool(b) => "",
        JNum(t) => "",
        JStr(s) => "",
        JArr(a) => "",
    }
}

/// The single value of a one-member object, or `JNull`. Reads in place, as
/// `keyOf` does.
export fn valOf(v: Json) -> Json {
    return match v {
        JObj(fs) => if fs.length == 1 { fs[0].value.copy() } else { JNull },
        JNull => JNull,
        JBool(b) => JNull,
        JNum(t) => JNull,
        JStr(s) => JNull,
        JArr(a) => JNull,
    }
}

/// `json.type`: `expected <what>, found <kind>`.
export fn pushType(iss: modify Array<Issue>, path: String, expected: String, found: String) -> Unit {
    iss.push(Issue {
        key: "json.type",
        path: path.copy(),
        message: "expected " + expected + ", found " + found,
    })
}

/// ``json.missing``: ``missing required field `name` ``.
export fn pushMissing(iss: modify Array<Issue>, path: String, field: String) -> Unit {
    iss.push(Issue {
        key: "json.missing",
        path: path.copy(),
        message: "missing required field `" + field + "`",
    })
}

/// `validate`: a refined type's `where` clause did not hold. The caller passes
/// the compiler's validation message, so the trap and this path word it the
/// same.
export fn pushValidate(iss: modify Array<Issue>, path: String, message: String) -> Unit {
    iss.push(Issue { key: "validate", path: path.copy(), message: message.copy() })
}

/// A dotted path extended by a record field (or an enum tag).
export fn fieldPath(parent: String, field: String) -> String {
    if parent == "" {
        return field.copy()
    }
    return parent + "." + field
}

/// A path extended by an array index.
export fn indexPath(parent: String, i: Int64) -> String {
    return parent + "[" + i.toString() + "]"
}

/// Parse `src` into a one-element array, or record one `json.parse` Issue and
/// return `[]`.
export fn readDoc(src: String, iss: modify Array<Issue>) -> Array<Json> {
    // `push`, not the literal `[j]`: the textual emitter lowers a one-element
    // literal to `[1 x T]`, and clang refuses to phi it against the heap triple.
    let mut out: Array<Json> = []
    return match parseJson(src) {
        Ok(j) => out.push(j),
        Err(e) => pushParse(iss, e),
    }
}

fn pushParse(iss: modify Array<Issue>, e: consume String) -> Array<Json> {
    // `consume`: the Issue takes the string whole. The other arm's
    // `out.push(j)` moves the scrutinee, so the match releases nothing and a
    // copied read parameter would leak.
    iss.push(Issue { key: "json.parse", path: "", message: e })
    return []
}

export fn dStr(v: Json, path: String, iss: modify Array<Issue>) -> Array<String> {
    let mut out: Array<String> = []
    let k = kindName(v)
    if k != "string" {
        pushType(iss, path, "string", k)
        return out
    }
    out.push(tagOf(v))
    return out
}

export fn dBool(v: Json, path: String, iss: modify Array<Issue>) -> Array<Bool> {
    let mut out: Array<Bool> = []
    let k = kindName(v)
    if k != "boolean" {
        pushType(iss, path, "boolean", k)
        return out
    }
    out.push(boolOf(v))
    return out
}

/// A boolean's value, or `false` for anything else; callers check the kind first.
fn boolOf(v: Json) -> Bool {
    return match v {
        JBool(b) => b,
        JNull => false,
        JNum(t) => false,
        JStr(s) => false,
        JArr(a) => false,
        JObj(f) => false,
    }
}

/// A JSON integer-syntax number as an exact `Int64`. A fraction, an exponent or
/// a magnitude outside `Int64` is `expected integer`, never a rounded value.
export fn dInt64(v: Json, path: String, iss: modify Array<Issue>) -> Array<Int64> {
    let mut out: Array<Int64> = []
    let k = kindName(v)
    if k != "number" {
        pushType(iss, path, "integer", k)
        return out
    }
    if let Some(n) = parseInt64(numText(v)) {
        out.push(n)
        return out
    }
    pushType(iss, path, "integer", "number")
    return out
}

/// An object key read as an `Int64`, the wire form of `Map<Int64, V>`. Only
/// the canonical text (`n.toString()`) passes: `"007"` and `"+7"` would
/// otherwise collapse into the key `"7"` with no Issue.
export fn dIntKey(key: String, path: String, iss: modify Array<Issue>) -> Array<Int64> {
    let mut out: Array<Int64> = []
    if let Some(n) = parseInt64(key) {
        if n.toString() == key {
            out.push(n)
            return out
        }
    }
    pushType(iss, path, "an integer key", "\"" + key + "\"")
    return out
}

/// `dInt64` restricted to `[lo, hi]`, for the sized signed integers.
export fn dIntRange(
    v: Json,
    path: String,
    iss: modify Array<Issue>,
    lo: Int64,
    hi: Int64,
) -> Array<Int64> {
    let mut out: Array<Int64> = []
    let k = kindName(v)
    if k != "number" {
        pushType(iss, path, "integer", k)
        return out
    }
    if let Some(n) = parseInt64(numText(v)) {
        if n >= lo && n <= hi {
            out.push(n)
            return out
        }
    }
    pushType(iss, path, "integer", "number")
    return out
}

/// A JSON integer-syntax number as an exact `UInt64` in `[0, hi]`.
/// `parseInt64` cannot serve: it has no room above `Int64.max`.
export fn dUIntMax(
    v: Json,
    path: String,
    iss: modify Array<Issue>,
    hi: UInt64,
) -> Array<UInt64> {
    let mut out: Array<UInt64> = []
    let k = kindName(v)
    if k != "number" {
        pushType(iss, path, "integer", k)
        return out
    }
    if let Some(n) = parseUInt64(numText(v)) {
        if n <= hi {
            out.push(n)
            return out
        }
    }
    pushType(iss, path, "integer", "number")
    return out
}

/// A JSON number as a `Float64`, correctly rounded (`std/num`). Integer syntax is
/// accepted: `1` decodes into a `Float64` target as `1.0`.
export fn dFloat64(v: Json, path: String, iss: modify Array<Issue>) -> Array<Float64> {
    let mut out: Array<Float64> = []
    let k = kindName(v)
    if k != "number" {
        pushType(iss, path, "number", k)
        return out
    }
    if let Some(f) = parseFloat64(numText(v)) {
        out.push(f)
        return out
    }
    pushType(iss, path, "number", "number")
    return out
}

/// A JSON number as a `Float32`, rounded once: decimal -> `Float64` ->
/// `Float32` rounds twice and is wrong near a `Float32` tie.
export fn dFloat32(v: Json, path: String, iss: modify Array<Issue>) -> Array<Float32> {
    let mut out: Array<Float32> = []
    let k = kindName(v)
    if k != "number" {
        pushType(iss, path, "number", k)
        return out
    }
    if let Some(f) = parseFloat32(numText(v)) {
        out.push(f)
        return out
    }
    pushType(iss, path, "number", "number")
    return out
}

// The typed half is generated; its tests live in `examples/jsondecbytes.vyrn`.

/// Writes the decoders `fromJson` calls: for each root, the entry that reads a
/// document into `Validation<T>`, and for each node, the function that decodes
/// a `Json` tree into zero or one value. Generated source cannot spell reserved
/// names, so it writes `VyrnRt_` for `std/json`'s, `VyrnRd_` for this module's
/// and `VyrnWp_` for a `where` type's predicate.
export gen fn jsonDecoders(t: TypeArg) -> String {
    let mut out = ""
    for r in t.roots {
        let n = t.nodes[r]
        // `consume` walks: a borrowed walk leaks the doc buffer and the decoded
        // snapshot on every call.
        out = out + "fn " + n.name + "(src: String) -> Validation<" + n.spelling + "> {\n"
        out = out + "    let mut iss: Array<Issue> = []\n    let doc = VyrnRd_readDoc(src, iss)\n"
        out = out + "    let mut val: Array<" + n.spelling + "> = []\n"
        out = out + "    for j in consume doc {\n        val = d" + n.name + "(j, \"\", iss)\n    }\n"
        out = out + "    if iss.length > 0 {\n        return Invalid(consume iss)\n    }\n"
        out = out + "    for x in consume val {\n        return Valid(x)\n    }\n    return Invalid(consume iss)\n}\n"
    }
    for n in t.nodes {
        out = out + "fn d" + n.name + "(v: VyrnRt_Json, path: String, iss: modify Array<Issue>) -> Array<" + n.spelling + "> {\n"
        out = out + jsonDecoderBody(t, n) + "}\n"
        // `{ c: 1 }` is not an expression, so a record without a name gets an
        // alias for its literal.
        if n.kind == "record" && !isName(n.spelling) {
            let mut fs = ""
            for m in n.members {
                fs = fs + (if fs == "" { "" } else { ", " }) + m.name + ": " + t.nodes[m.args[0]].spelling
            }
            out = out + "type r" + n.name + " = { " + fs + " }\n"
        }
    }
    return out
}

gen fn isName(s: String) -> Bool {
    for b in bytes(s) {
        let word = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
        if !word {
            return false
        }
    }
    return true
}

/// A decoder's body. A composite constructs only when every part produced a
/// value; each part's issues are already recorded.
gen fn jsonDecoderBody(t: TypeArg, n: TypeNode) -> String {
    let out = "    let mut out: Array<" + n.spelling + "> = []\n"
    let object = "    let k = VyrnRd_kindName(v)\n    if k != \"object\" {\n        VyrnRd_pushType(iss, path, \"object\", k)\n        return out\n    }\n"
    // Decode the base, then run the declaration's predicate. The push into
    // `Array<T>` is the construction, and it holds for a record base too.
    if n.kind == "where" {
        let mut binds = ""
        for m in n.members {
            binds = binds + (if binds == "" { "" } else { ", " }) + "b." + m.name
        }
        let args = if binds == "" { "b" } else { binds }
        let base = "    for b in d" + t.nodes[n.args[0]].name + "(v, path, iss) {\n"
        let test = "        if VyrnWp_" + n.spelling + "(" + args + ") {\n            out.push(b)\n"
        let fail = "        } else {\n            VyrnRd_pushValidate(iss, path, \"" + n.predicate + "\")\n        }\n    }\n"
        return out + base + test + fail + "    return out\n"
    }
    if n.kind == "record" {
        return out + object + jsonRecordBody(t, n)
    }
    // Each element decodes at `path[i]`; a bad element is an issue, not a
    // missing array.
    if n.kind == "array" {
        let e = t.nodes[n.args[0]]
        let head = "    let k = VyrnRd_kindName(v)\n    if k != \"array\" {\n        VyrnRd_pushType(iss, path, \"array\", k)\n        return out\n    }\n"
        let walk = "    let items = VyrnRd_itemsOf(v)\n    let mut acc: Array<" + e.spelling + "> = []\n    let mut i = 0\n    while i < items.length {\n"
        let each = "        for e in d" + e.name + "(VyrnRd_elemAt(items, i), VyrnRd_indexPath(path, i), iss) {\n            acc.push(e)\n        }\n        i = i + 1\n    }\n"
        return out + head + walk + each + "    out.push(acc)\n    return out\n"
    }
    // Document order becomes insertion order; `std/jsonread` refuses repeated
    // keys. The key is copied: `f` belongs to the snapshot `fieldsOf` returns.
    // An `Int64` key must be canonical decimal text.
    if n.kind == "map" {
        let val = t.nodes[n.args[1]]
        let dv = "let dv = d" + val.name + "(f.value, VyrnRd_fieldPath(path, f.key), iss)\n"
        if t.nodes[n.args[0]].kind == "String" {
            let m = "    let mut m: Map<String, " + val.spelling + "> = [:]\n    for f in VyrnRd_fieldsOf(v) {\n        " + dv
            let put = "        if m.has(f.key) == false {\n            for x in consume dv {\n                m[f.key.copy()] = x\n            }\n        }\n    }\n"
            return out + object + m + put + "    out.push(m)\n    return out\n"
        }
        let m = "    let mut m: Map<Int64, " + val.spelling + "> = [:]\n    for f in VyrnRd_fieldsOf(v) {\n"
        let key = "        for kn in VyrnRd_dIntKey(f.key, VyrnRd_fieldPath(path, f.key), iss) {\n            " + dv
        let put = "            if m.has(kn) == false {\n                for x in consume dv {\n                    m[kn] = x\n                }\n            }\n        }\n    }\n"
        return out + object + m + key + put + "    out.push(m)\n    return out\n"
    }
    if n.kind == "option" {
        let none = "    if VyrnRd_isNull(v) {\n        out.push(None)\n        return out\n    }\n"
        let some = "    for x in d" + t.nodes[n.args[0]].name + "(v, path, iss) {\n        out.push(Some(x))\n    }\n"
        return out + none + some + "    return out\n"
    }
    if n.kind == "enum" {
        return out + jsonVariantsBody(t, n)
    }
    return jsonScalarBody(n)
}

/// A record: each field decodes into its own staging array, and the record is
/// built once every required field has a value. An `Option<T>` field is
/// inlined: absent or `null` is `None`, and a failed inner decode leaves `None`
/// with its issue recorded.
gen fn jsonRecordBody(t: TypeArg, n: TypeNode) -> String {
    let mut out = "    let fs = VyrnRd_fieldsOf(v)\n"
    let mut guards = ""
    let mut inits = ""
    let mut i = 0
    for m in n.members {
        let f = t.nodes[m.args[0]]
        let ix = i.toString()
        let name = "\"" + m.name + "\""
        out = out + "    let p" + ix + " = VyrnRd_fieldPath(path, " + name + ")\n"
        inits = inits + (if i == 0 { "" } else { ", " }) + m.name + ": f" + ix
        if f.kind == "option" {
            let inner = t.nodes[f.args[0]]
            out = out + "    let mut f" + ix + ": Option<" + inner.spelling + "> = None\n    let j" + ix + " = VyrnRd_fieldAt(fs, " + name + ")\n"
            out = out + "    if VyrnRd_isNull(j" + ix + ") == false {\n        for x in d" + inner.name + "(j" + ix + ", p" + ix + ", iss) {\n"
            out = out + "            f" + ix + " = Some(x)\n        }\n    }\n"
        } else {
            out = out + "    let mut f" + ix + ": Array<" + f.spelling + "> = []\n    if VyrnRd_hasField(fs, " + name + ") {\n"
            out = out + "        f" + ix + " = d" + f.name + "(VyrnRd_fieldAt(fs, " + name + "), p" + ix + ", iss)\n"
            out = out + "    } else {\n        VyrnRd_pushMissing(iss, p" + ix + ", " + name + ")\n    }\n"
            guards = guards + (if guards == "" { "" } else { " && " }) + "f" + ix + ".length == 1"
            // Take the value out of its one-element carrier: an element read
            // borrows its container.
            inits = inits + ".swapRemove(0)"
        }
        i = i + 1
    }
    let lit = (if isName(n.spelling) { n.spelling.copy() } else { "r" + n.name }) + " { " + inits + " }"
    if guards == "" {
        return out + "    out.push(" + lit + ")\n    return out\n"
    }
    return out + "    if " + guards + " {\n        out.push(" + lit + ")\n    }\n    return out\n"
}

/// A sum in wire form: a bare string is a nullary variant, and a one-key
/// object `{"Tag":..}` a payload variant, a tuple payload as an array. Any
/// other form is a `json.type` issue that names every variant.
gen fn jsonVariantsBody(t: TypeArg, n: TypeNode) -> String {
    let mut out = ""
    let mut expected = ""
    let mut tags = ""
    let mut keys = ""
    for m in n.members {
        expected = expected + (if expected == "" { "one of `" } else { ", `" }) + m.name + "`"
        if m.args.length == 0 {
            tags = tags + "    if tag == \"" + m.name + "\" {\n        out.push(" + m.name + ")\n        return out\n    }\n"
        } else {
            keys = keys + "    if key == \"" + m.name + "\" {\n" + jsonPayloadArm(t, m) + "        return out\n    }\n"
        }
    }
    if tags != "" {
        out = out + "    let tag = VyrnRd_tagOf(v)\n" + tags
    }
    if keys != "" {
        out = out + "    let key = VyrnRd_keyOf(v)\n" + keys
    }
    return out + "    VyrnRd_pushType(iss, path, \"" + expected + "\", VyrnRd_kindName(v))\n    return out\n"
}

/// One payload variant's arm, decoding at `path.Tag` and a tuple's members at
/// `path.Tag[i]`. The arity is checked first: a short array would otherwise
/// decode `Option` members from `elemAt`'s out-of-range `JNull` as `None`, a
/// shape nothing encodes.
gen fn jsonPayloadArm(t: TypeArg, m: TypeMember) -> String {
    let c = "        let c = VyrnRd_fieldPath(path, \"" + m.name + "\")\n"
    if m.args.length == 1 {
        let each = "        for a0 in d" + t.nodes[m.args[0]].name + "(VyrnRd_valOf(v), c, iss) {\n"
        return c + each + "            out.push(" + m.name + "(a0))\n        }\n"
    }
    let arity = m.args.length.toString()
    let mut out = c + "        let pv = VyrnRd_valOf(v)\n        let pk = VyrnRd_kindName(pv)\n        if pk != \"array\" {\n"
    out = out + "            VyrnRd_pushType(iss, c, \"array\", pk)\n            return out\n        }\n"
    out = out + "        let items = VyrnRd_itemsOf(pv)\n        if items.length != " + arity + " {\n"
    out = out + "            VyrnRd_pushType(iss, c, \"array of length " + arity + "\", \"array of length \" + items.length.toString())\n"
    out = out + "            return out\n        }\n"
    let mut guards = ""
    let mut binds = ""
    let mut i = 0
    for a in m.args {
        let ix = i.toString()
        let sep = if i == 0 { "" } else { ", " }
        out = out + "        let mut a" + ix + " = d" + t.nodes[a].name + "(VyrnRd_elemAt(items, " + ix + "), VyrnRd_indexPath(c, " + ix + "), iss)\n"
        guards = guards + (if i == 0 { "" } else { " && " }) + "a" + ix + ".length == 1"
        binds = binds + sep + "a" + ix + ".swapRemove(0)"
        i = i + 1
    }
    return out + "        if " + guards + " {\n            out.push(" + m.name + "(" + binds + "))\n        }\n"
}

/// A scalar. A sized integer decodes through an `Int64` or `UInt64` helper
/// that refuses every value outside the type's bounds, so the narrowing
/// conversion cannot wrap.
gen fn jsonScalarBody(n: TypeNode) -> String {
    let k = n.kind
    let whole = if k == "Int64" {
        "VyrnRd_dInt64(v, path, iss)"
    } else if k == "UInt64" {
        "VyrnRd_dUIntMax(v, path, iss, 18446744073709551615)"
    } else if k == "Float64" {
        "VyrnRd_dFloat64(v, path, iss)"
    } else if k == "Float32" {
        "VyrnRd_dFloat32(v, path, iss)"
    } else if k == "Bool" {
        "VyrnRd_dBool(v, path, iss)"
    } else if k == "String" {
        "VyrnRd_dStr(v, path, iss)"
    } else {
        ""
    }
    if whole != "" {
        return "    return " + whole + "\n"
    }
    // Any other kind writes no `return`, and the check of the written code
    // refuses it.
    let narrow = if k == "Int8" {
        "VyrnRd_dIntRange(v, path, iss, 0 - 128, 127)"
    } else if k == "Int16" {
        "VyrnRd_dIntRange(v, path, iss, 0 - 32768, 32767)"
    } else if k == "Int32" {
        "VyrnRd_dIntRange(v, path, iss, 0 - 2147483648, 2147483647)"
    } else if k == "UInt8" {
        "VyrnRd_dUIntMax(v, path, iss, 255)"
    } else if k == "UInt16" {
        "VyrnRd_dUIntMax(v, path, iss, 65535)"
    } else if k == "UInt32" {
        "VyrnRd_dUIntMax(v, path, iss, 4294967295)"
    } else {
        ""
    }
    if narrow == "" {
        return ""
    }
    let out = "    let mut out: Array<" + n.spelling + "> = []\n    for n in " + narrow + " {\n"
    return out + "        out.push(" + n.spelling + "(n))\n    }\n    return out\n"
}

test "kind names are the canonical ones" {
    assertEq(kindName(JNull), "null")
    assertEq(kindName(JBool(true)), "boolean")
    assertEq(kindName(JNum("1")), "number")
    assertEq(kindName(JStr("a")), "string")
    assertEq(kindName(JArr([])), "array")
    assertEq(kindName(JObj([])), "object")
}

test "a decode result is zero or one element" {
    let mut iss: Array<Issue> = []
    assertEq(dInt64(JNum("42"), "", iss).length, 1)
    assertEq(dInt64(JNum("1.5"), "", iss).length, 0)
    assertEq(iss.length, 1)
    assertEq(iss[0].key, "json.type")
    assertEq(iss[0].message, "expected integer, found number")
}

test "integers decode exactly, never through a Float64" {
    let mut iss: Array<Issue> = []
    assertEq(dInt64(JNum("9007199254740993"), "", iss)[0], 9007199254740993)
    assertEq(dUIntMax(JNum("18446744073709551615"), "", iss, 18446744073709551615)[0], 18446744073709551615)
    assertEq(iss.length, 0)
}

test "a sized integer out of range is a type issue, not a wrap" {
    let mut iss: Array<Issue> = []
    assertEq(dIntRange(JNum("128"), "i8v", iss, 0 - 128, 127).length, 0)
    assertEq(dUIntMax(JNum("-1"), "u32v", iss, 4294967295).length, 0)
    assertEq(iss.length, 2)
    assertEq(iss[0].path, "i8v")
    assertEq(iss[1].path, "u32v")
}

test "paths compose the canonical way" {
    assertEq(fieldPath("", "sur"), "sur")
    assertEq(fieldPath("kids[1]", "name"), "kids[1].name")
    assertEq(indexPath("kids", 1), "kids[1]")
}

test "a parse error is one issue, keyed json.parse, worded line/col" {
    let mut iss: Array<Issue> = []
    assertEq(readDoc("{ bad", iss).length, 0)
    assertEq(iss.length, 1)
    assertEq(iss[0].key, "json.parse")
    assertEq(iss[0].path, "")
    assertEq(iss[0].message, "line 1, col 3: expected a string key")
}

test "the one-wire-form-per-value accessors" {
    // A one-member object names a payload variant; anything else is ""; a bare
    // string names a nullary one.
    assertEq(keyOf(JObj([JsonField { key: "Circle", value: JNum("3") }])), "Circle")
    assertEq(keyOf(JObj([])), "")
    assertEq(
        keyOf(JObj([
            JsonField { key: "a", value: JNull },
            JsonField { key: "b", value: JNull },
        ])),
        "",
    )
    assertEq(tagOf(JStr("Dot")), "Dot")
    assertEq(tagOf(JObj([])), "")
}
