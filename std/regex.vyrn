/// A regular expression that searches, counts and replaces.
///
/// `=~` only answers whether a whole string matches a constant pattern. The walk
/// is Vyrn, not a builtin, so every engine runs one source and agrees on offsets
/// and counts.
///
/// The language is `std/regex.syntax`, the one `=~` reads, and a pattern means what
/// it means there: `.` is any character but `\n` and `\r`. `\d`, `\w`, `\s` and `\h`
/// are shorthands, their capitals negate them, and `\N` is any character but `\n`. `\t`,
/// `\n`, `\r`, `\f`, `\v`, `\a`, `\e` and `\cX` are control characters, and `\xHH`,
/// `\x{H..}`, `\uHHHH`, `\u{H..}` and `\o{O..}` are code points. `\R` is a line
/// break, `\Q` quotes the text up to `\E` or the end, and a backslash before ASCII
/// punctuation makes it literal. Every other escape is refused. `{m,n}` repeats a
/// term `m` to `n` times, each count at most 255, and a `?` after a repeat or a
/// count makes it lazy. `(?:..)` groups without a name, `(?<n>..)`, `(?P<n>..)`
/// and `(?'n'..)` name a group, and `(?#..)` is a comment.
/// The flags `i` (ASCII case folding), `s` (`.` takes `\n` and `\r`) and `m` hold
/// for the rest of a group after `(?ims-ims)`, or inside `(?ims-ims:..)`, and the
/// empty pattern matches the empty string. A pattern with no backreference is a
/// Thompson NFA with no backtracking, so the time is linear in the pattern size times
/// the input. A search runs it as two lazy DFAs, one forward to a match's end and one
/// back to its start: one table read per byte.
///
/// `\1` to `\99`, `\gN` and `\g{N}` refer to a group by number, `\g{-N}` to the Nth
/// group opened before it, and `\k<n>`, `\k'n'`, `\k{n}` and `(?P=n)` by name. A
/// backreference matches the text its group spans, or the empty string where the
/// group has not closed or took no part; under `i` it folds ASCII case. A reference
/// to a group the pattern does not have is refused. `(?>..)` is an atomic group,
/// which keeps the first way its body matches, and a `+` after a repeat or a count
/// makes it possessive, an atomic group around it. A search of a pattern with a
/// backreference, an atomic group or a possessive repeat backtracks from each
/// offset in turn, which takes time exponential in the pattern in the worst case,
/// so one call of `find`, `countMatches`, `replaceAll` or `captures` takes at most
/// 1000000 steps and 1000 more per byte of the haystack, and past them it traps
/// with `a backtracking pattern ran past its step budget of N steps`. A repeat
/// that comes back to its loop at the offset it left it ends there, as a thread
/// the NFA drops.
///
/// `(?=..)`, `(?!..)`, `(?<=..)` and `(?<!..)` look ahead and behind, nested to any
/// depth, and see the whole text, before `from` too. `^` and `$` are the text's ends,
/// or a line's under `m`; `\A` and `\z` are the text's ends, and `\Z` is the end
/// or a final `\n`. `\b` is a word boundary and `\B` any other position, `\<` and
/// `\b{start}` a word's start, `\>` and `\b{end}` its end, and `\b{start-half}` and
/// `\b{end-half}` the side of each that is no word character. A search of a pattern
/// with an assertion first runs one pass per lookaround body over the text, and then
/// the NFA, not the lazy DFAs: the time stays linear. A capturing group inside a
/// lookaround is refused.
///
/// `captures` gives a match's groups, numbered from 1 in the order of their `(`;
/// `(?:..)` and `(?i:..)` do not count. `capture` and `named` read one.
///
/// Leftmost-first, as Perl, PCRE and RE2 match: of the matches that start
/// leftmost, the one the pattern prefers, so an earlier alternative wins, a greedy
/// repeat takes as much as it can and a lazy one as little. `a|ab` against `ab`
/// matches `a`.
///
/// A class is a set of code points: it unites its members, ranges, POSIX classes
/// such as `[:alpha:]` and nested classes, and `&&`, `--` and `~~` intersect,
/// subtract and take the symmetric difference of the unions beside them. A literal,
/// a class and `.` each match one whole character, so offsets are bytes and every
/// match starts and ends on a character boundary.

import { substring } from "std/strings"
import { catalogue } from "std/i18n"
import { syntax } from "std/syntax"
// Each by a namespace: a written module's names, such as `Row`, are program-wide.
import * as rx from syntax("./regex.syntax")
import * as say from catalogue("./regex.errors")

// A Thompson NFA as four parallel arrays: one instruction is one index into
// `op`/`a`/`b`/`cls`.

/// `op[i]` is a byte-class test: `cls[i]` is the class, `b[i]` the next pc.
let opClass = 0

/// `op[i]` is a fork: `a[i]` and `b[i]` are both next pcs, tried as one set.
let opSplit = 1

/// `op[i]` accepts.
let opMatch = 2

/// `op[i]` notes the offset in slot `a[i]` of a thread's group spans, and goes on
/// to `b[i]`. Every other walk passes it as an empty edge.
let opSave = 3

/// `op[i]` goes on to `b[i]` where lookaround body `a[i] / 2` holds at the offset,
/// or where it does not for an odd `a[i]` ([`holds`]).
let opAssert = 4

/// `op[i]` goes on to `b[i]` past the text group `a[i] / 2` spans, where the text
/// holds it again, ASCII case folded for an odd `a[i]` ([`refLength`]). Only the
/// backtracking search reads it.
let opBackref = 5

/// `op[i]` opens an atomic group whose close is pc `a[i]`, or closes one for an
/// `a[i]` of -1, and goes on to `b[i]`. At the close the backtracking search drops
/// every choice the group left, so the group keeps the first way its body matched.
/// Only the backtracking search reads it.
let opAtomic = 6

/// A set of bytes: byte `c` is in it when bit `c % 64` of word `c / 64` is set.
///
/// Four words and not an array, so a membership test reads no array and has no
/// bounds to check; and one per instruction, so the class of instruction `pc`
/// is `cls[pc]`, in bounds wherever `op[pc]` is.
type ByteSet = { w0: UInt64, w1: UInt64, w2: UInt64, w3: UInt64 }

/// A compiled pattern: `fwd` is the pattern after a loop over any byte, so a forward
/// pass finds where the leftmost match ends, and `rev`, its reverse, reads that match
/// back to its start. A pattern with a backreference is searched by backtracking
/// over `fwd`, and its `rev` serves only its regular lookahead bodies.
export type Regex = {
    fwd: Program,
    rev: Program,
    // The name of group `k` at `k - 1`, or "" for a group with none.
    names: Array<String>,
    // Each lookaround body, inner ones before the bodies that hold them.
    looks: Array<Look>,
    // Whether the pattern holds a backreference, an atomic group or a possessive
    // repeat.
    backtrack: Bool,
}

/// A lookaround body: whether it looks `behind`, where its pcs start in `fwd`, and
/// where its reverse starts in `rev`, which a lookahead's pass reads. A body with no
/// backreference, atomic group or possessive repeat is `regular`, and a pass gives
/// its bits; the backtracking search runs any other body where it asserts it.
type Look = { behind: Bool, fwd: Int64, rev: Int64, regular: Bool }

type Program = {
    op: Array<Int64>,
    a: Array<Int64>,
    b: Array<Int64>,
    cls: Array<ByteSet>,
    start: Int64,
    // `classOf[c]` is byte `c`'s class, 0 to `classCount - 1`: two bytes in one
    // class take the same step from every set of pcs. The class of `c` is at
    // most `c`, so a `UInt8` holds it.
    classOf: Array<UInt8>,
    classCount: Int64,
    // The lookaround bodies of the pattern, which an assertion's bit indexes.
    looks: Int64,
}

/// One match: a half-open byte range of the haystack.
export type Match = { at: Int64, end: Int64 }

fn noBytes() -> ByteSet {
    return ByteSet { w0: 0, w1: 0, w2: 0, w3: 0 }
}

/// `c` is a byte, 0 to 255.
fn addByte(s: modify ByteSet, c: Int64) {
    let bit = UInt64(1) << UInt64(c & 63)
    if c < 64 {
        s.w0 = s.w0 | bit
    } else if c < 128 {
        s.w1 = s.w1 | bit
    } else if c < 192 {
        s.w2 = s.w2 | bit
    } else {
        s.w3 = s.w3 | bit
    }
}

/// `c` is a byte, 0 to 255.
fn hasByte(s: ByteSet, c: Int64) -> Bool {
    let w = if c < 64 { s.w0 } else if c < 128 { s.w1 } else if c < 192 { s.w2 } else { s.w3 }
    return ((w >> UInt64(c & 63)) & 1) != 0
}

// A walk of the tree that emits as it goes. Each level answers a fragment: its
// start pc and the operand slots that still need an exit patched in. A hole is
// `pc * 2 + which`, `which` being 0 for `a` and 1 for `b`.

type Frag = { start: Int64, holes: Array<Int64> }

type Builder = {
    op: Array<Int64>,
    a: Array<Int64>,
    b: Array<Int64>,
    cls: Array<ByteSet>,
    err: Option<rx.Row>,
    // The terms counted repetition has copied, against `countBudget`.
    expanded: Int64,
    // The flags of the group being walked: `fold` is `i`, which folds ASCII case,
    // `dotAll` is `s`, which lets `.` take `\n` and `\r`, and `lines` is `m`, which
    // makes `^` and `$` a line's ends.
    fold: Bool,
    dotAll: Bool,
    lines: Bool,
    // The offset of each capturing group's `(`, by number from 1, and its name or
    // "" in `names`: a count walks a group once per copy, and a name names one
    // group.
    groupAt: Array<Int64>,
    names: Array<String>,
    // The lookarounds around the term being walked.
    lookDepth: Int64,
    // Each lookaround body by its key, whether it looks behind, its first pc and its
    // match pc. A count walks a lookaround once per copy, and the key finds its body.
    lookKeys: Array<String>,
    lookBehind: Array<Bool>,
    lookStart: Array<Int64>,
    lookEnd: Array<Int64>,
    lookRegular: Array<Bool>,
    // Each backreference's pc, and the name it refers by or "" for a number: the
    // walk's end resolves them, once every group has its number.
    refPc: Array<Int64>,
    refName: Array<String>,
    // The backreferences, atomic groups and possessive repeats walked, which only
    // the backtracking search matches.
    irregular: Int64,
}

/// The terms counted repetition may copy in one pattern. Nested counts multiply,
/// so `(a{99}){99}` copies about 10^4.
let countBudget = 16384

/// The sentence of `row`, the one place a refusal is said.
fn regexSay(row: rx.Row) -> String {
    return match row {
        Backwards => say.tBackwards__En(),
        ClassBackslash => say.tClassBackslash__En(),
        ClassUnclosed => say.tClassUnclosed__En(),
        CountBudget => say.tCountBudget__En(),
        CountForm => say.tCountForm__En(),
        CountLarge => say.tCountLarge__En(),
        CountNumber => say.tCountNumber__En(),
        CountOrder => say.tCountOrder__En(),
        CountUnclosed => say.tCountUnclosed__En(),
        EmptyClass => say.tEmptyClass__En(),
        Expected(token) => say.tExpected__En(token),
        GroupUnclosed => say.tGroupUnclosed__En(),
        NoCountTerm => say.tNoCountTerm__En(),
        NoTerm => say.tNoTerm__En(),
        PatternBackslash => say.tPatternBackslash__En(),
        StrayBrace => say.tStrayBrace__En(),
        StrayParen => say.tStrayParen__En(),
        TooDeep => say.tTooDeep__En(),
        AssertionRepeat => say.tAssertionRepeat__En(),
        LookCapture => say.tLookCapture__En(),
        ClassAnchor(c) => say.tClassAnchor__En(c),
        ClassRange => say.tClassRange__En(),
        CodepointRange => say.tCodepointRange__En(),
        ControlLetter => say.tControlLetter__En(),
        HexDigits(e) => say.tHexDigits__En(e),
        NulEscape => say.tNulEscape__En(),
        OctalEscape => say.tOctalEscape__En(),
        PcreControl(form) => say.tPcreControl__En(form),
        PosixName => say.tPosixName__En(),
        PropertyClass(form) => say.tPropertyClass__En(form),
        SetOperand => say.tSetOperand__En(),
        UnknownEscape(c) => say.tUnknownEscape__En(c),
        FlagUnknown(f) => say.tFlagUnknown__En(f),
        GroupForm => say.tGroupForm__En(),
        GroupName => say.tGroupName__En(),
        NameTwice => say.tNameTwice__En(),
        BackrefMissing => say.tBackrefMissing__En(),
    }
}

/// Records `row` unless the walk has refused already, so a pattern answers with its
/// first refusal.
fn refuse(bd: modify Builder, row: consume rx.Row) {
    match bd.err {
        Some(first) => {}
        None => {
            bd.err = Some(row)
        }
    }
}

/// Whether the walk has refused.
fn refused(bd: Builder) -> Bool {
    return match bd.err {
        Some(first) => true,
        None => false,
    }
}

fn emit(bd: modify Builder, o: Int64, x: Int64, y: Int64, s: ByteSet) -> Int64 {
    let pc = bd.op.length
    bd.op.push(o)
    bd.a.push(x)
    bd.b.push(y)
    bd.cls.push(s)
    return pc
}

fn patch(bd: modify Builder, holes: Array<Int64>, target: Int64) {
    let mut i = 0
    while i < holes.length {
        let pc = holes[i] / 2
        if holes[i] % 2 == 0 {
            bd.a[pc] = target
        } else {
            bd.b[pc] = target
        }
        i = i + 1
    }
}

fn joinHoles(x: Array<Int64>, y: Array<Int64>) -> Array<Int64> {
    let mut out: Array<Int64> = []
    let mut i = 0
    while i < x.length {
        out.push(x[i])
        i = i + 1
    }
    let mut j = 0
    while j < y.length {
        out.push(y[j])
        j = j + 1
    }
    return out
}

/// Adds the bytes from `lo` to `hi`.
fn addRange(k: modify ByteSet, lo: Int64, hi: Int64) {
    let mut x = lo
    while x <= hi {
        addByte(k, x)
        x = x + 1
    }
}

// A set of code points is `[lo, hi, lo, hi, ..]`: sorted inclusive ranges of scalar
// values, apart and not adjacent, so no range holds a surrogate. The compiler's
// builder states the same sets, `regex::Chars`.

/// The last scalar value.
let maxChar = 1114111

/// The set of the code points the pairs `ranges` hold, less the surrogates.
fn charsOf(ranges: Array<Int64>) -> Array<Int64> {
    // An insertion sort by `lo`: a class holds few ranges.
    let mut v: Array<Int64> = []
    let mut i = 0
    while i + 1 < ranges.length {
        let lo = ranges[i]
        let hi = ranges[i + 1]
        v.push(lo)
        v.push(hi)
        let mut j = v.length - 2
        while j >= 2 && v[j - 2] > lo {
            v[j] = v[j - 2]
            v[j + 1] = v[j - 1]
            j = j - 2
        }
        v[j] = lo
        v[j + 1] = hi
        i = i + 2
    }
    let mut merged: Array<Int64> = []
    let mut k = 0
    while k + 1 < v.length {
        let n = merged.length
        if n >= 2 && v[k] <= merged[n - 1] + 1 {
            if v[k + 1] > merged[n - 1] {
                merged[n - 1] = v[k + 1]
            }
        } else {
            merged.push(v[k])
            merged.push(v[k + 1])
        }
        k = k + 2
    }
    let mut out: Array<Int64> = []
    let mut m = 0
    while m + 1 < merged.length {
        let lo = merged[m]
        let hi = merged[m + 1]
        let below = if hi < 55295 { hi } else { 55295 }
        if lo <= below {
            out.push(lo)
            out.push(below)
        }
        let above = if lo > 57344 { lo } else { 57344 }
        if above <= hi {
            out.push(above)
            out.push(hi)
        }
        m = m + 2
    }
    return out
}

fn charsNot(set: Array<Int64>) -> Array<Int64> {
    let mut out: Array<Int64> = []
    let mut next = 0
    let mut i = 0
    while i + 1 < set.length {
        if set[i] > next {
            out.push(next)
            out.push(set[i] - 1)
        }
        next = set[i + 1] + 1
        i = i + 2
    }
    if next <= maxChar {
        out.push(next)
        out.push(maxChar)
    }
    return charsOf(out)
}

fn charsOr(x: Array<Int64>, y: Array<Int64>) -> Array<Int64> {
    return charsOf(joinHoles(x, y))
}

fn charsAnd(x: Array<Int64>, y: Array<Int64>) -> Array<Int64> {
    return charsNot(charsOr(charsNot(x), charsNot(y)))
}

fn charsLess(x: Array<Int64>, y: Array<Int64>) -> Array<Int64> {
    return charsAnd(x, charsNot(y))
}

/// The byte ranges of the members of `set` from 0x80 up, as `[lo, hi, ..]`, one
/// pair per byte: a sequence for each run of code points that encode with one prefix
/// shape, split as Rust regex-syntax's `Utf8Sequences` splits them.
fn utf8Seqs(set: Array<Int64>) -> Array<Array<Int64>> {
    let mut out: Array<Array<Int64>> = []
    // Pairs `s, e` still to split, the next on top.
    let mut todo: Array<Int64> = []
    let mut i = set.length - 2
    while i >= 0 {
        if set[i + 1] >= 128 {
            todo.push(if set[i] < 128 { 128 } else { set[i] })
            todo.push(set[i + 1])
        }
        i = i - 2
    }
    // Each split leaves a shorter `s, e` and pushes the rest, so the walk ends.
    while todo.length >= 2 {
        let e = todo[todo.length - 1]
        let s = todo[todo.length - 2]
        todo.pop()
        todo.pop()
        let mut mid = 0 - 1
        if s <= 2047 && 2047 < e {
            mid = 2047
        } else if s <= 65535 && 65535 < e {
            mid = 65535
        }
        let mut k = 1
        while mid < 0 && k < 4 {
            let m = (1 << (6 * k)) - 1
            if s - (s & m) != e - (e & m) {
                if (s & m) != 0 {
                    mid = s | m
                } else if (e & m) != m {
                    mid = e - (e & m) - 1
                }
            }
            k = k + 1
        }
        if mid >= 0 {
            todo.push(mid + 1)
            todo.push(e)
            todo.push(s)
            todo.push(mid)
        } else {
            let a = utf8(s)
            let b = utf8(e)
            let mut seq: Array<Int64> = []
            let mut j = 0
            while j < a.length && j < b.length {
                seq.push(a[j])
                seq.push(b[j])
                j = j + 1
            }
            out.push(seq)
        }
    }
    return out
}

/// The terms of `set`'s fragment, as the compiler's builder counts them: one for
/// its ASCII class, one per byte range of each sequence from 0x80 up.
fn charsSize(set: Array<Int64>) -> Int64 {
    let mut n = if set.length == 0 || set[0] < 128 { 1 } else { 0 }
    let seqs = utf8Seqs(set)
    let mut i = 0
    while i < seqs.length {
        n = n + seqs[i].length / 2
        i = i + 1
    }
    return n
}

/// The fragment of one character of `set`: a class test of its ASCII members, then
/// for each sequence a test per byte, each an alternative.
fn fragChars(bd: modify Builder, set: Array<Int64>) -> Frag {
    let mut f = Frag { start: 0 - 1, holes: [] }
    if set.length == 0 || set[0] < 128 {
        let mut k = noBytes()
        let mut i = 0
        while i + 1 < set.length && set[i] < 128 {
            addRange(k, set[i], if set[i + 1] < 127 { set[i + 1] } else { 127 })
            i = i + 2
        }
        f = fragSet(bd, k)
    }
    let seqs = utf8Seqs(set)
    let mut s = 0
    while s < seqs.length {
        let mut g = fragRange(bd, seqs[s][0], seqs[s][1])
        let mut j = 2
        while j + 1 < seqs[s].length {
            let h = fragRange(bd, seqs[s][j], seqs[s][j + 1])
            patch(bd, g.holes, h.start)
            g = Frag { start: g.start, holes: consume h.holes }
            j = j + 2
        }
        if f.start < 0 {
            f = g
        } else {
            let sp = emit(bd, opSplit, f.start, g.start, noBytes())
            f = Frag { start: sp, holes: joinHoles(f.holes, g.holes) }
        }
        s = s + 1
    }
    return f
}

/// Whether the escape `\c` is a shorthand: `\d`, `\w`, `\s`, `\h`, their capitals,
/// which negate, and `\N`, any character but `\n`.
fn isShorthand(c: UInt8) -> Bool {
    return c == 'd' || c == 'D' || c == 'w' || c == 'W' || c == 's' || c == 'S' || c == 'h' || c == 'H' || c == 'N'
}

/// The set of the shorthand `\c`.
fn shorthandChars(c: UInt8) -> Array<Int64> {
    if c >= 'A' && c <= 'Z' && c != 'N' {
        return charsNot(shorthandChars(c + 32))
    }
    if c == 'd' {
        return [48, 57]
    }
    if c == 'w' {
        return [48, 57, 65, 90, 95, 95, 97, 122]
    }
    if c == 's' {
        return [9, 13, 32, 32]
    }
    if c == 'h' {
        return [9, 9, 32, 32]
    }
    return charsNot([10, 10])
}

/// Whether `pattern` holds `word` at `at`.
fn holdsAt(pattern: String, at: Int64, word: String) -> Bool {
    let mut i = 0
    while i < word.byteLength {
        if at + i >= pattern.byteLength || pattern[at + i] != word[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// The set of the POSIX class named at `at`, a name the grammar admits.
fn posixNamed(pattern: String, at: Int64) -> Array<Int64> {
    if holdsAt(pattern, at, "alnum") {
        return [48, 57, 65, 90, 97, 122]
    }
    if holdsAt(pattern, at, "alpha") {
        return [65, 90, 97, 122]
    }
    if holdsAt(pattern, at, "blank") {
        return [9, 9, 32, 32]
    }
    if holdsAt(pattern, at, "cntrl") {
        return [0, 31, 127, 127]
    }
    if holdsAt(pattern, at, "digit") {
        return [48, 57]
    }
    if holdsAt(pattern, at, "graph") {
        return [33, 126]
    }
    if holdsAt(pattern, at, "lower") {
        return [97, 122]
    }
    if holdsAt(pattern, at, "print") {
        return [32, 126]
    }
    if holdsAt(pattern, at, "punct") {
        return [33, 47, 58, 64, 91, 96, 123, 126]
    }
    if holdsAt(pattern, at, "space") {
        return [9, 13, 32, 32]
    }
    if holdsAt(pattern, at, "upper") {
        return [65, 90]
    }
    return [48, 57, 65, 70, 97, 102]
}

/// The set of the POSIX class at `start`, `[:name:]` or `[:^name:]`.
fn posixChars(pattern: String, start: Int64) -> Array<Int64> {
    if pattern[start + 2] == '^' {
        return charsNot(posixNamed(pattern, start + 3))
    }
    return posixNamed(pattern, start + 2)
}

/// The code point of the UTF-8 text of `pattern` at `at`.
fn charAt(pattern: String, at: Int64) -> Int64 {
    let b = Int64(pattern[at])
    if b < 128 {
        return b
    }
    let n = if b >= 240 { 3 } else if b >= 224 { 2 } else { 1 }
    let mut c = b & (63 >> n)
    let mut i = 1
    while i <= n {
        c = (c << 6) | (Int64(pattern[at + i]) & 63)
        i = i + 1
    }
    return c
}

/// The code point of the escape from `from`, the byte after its backslash, up to
/// `to`: a control, a code point escape or ASCII punctuation, or -1 for a code point
/// above 10FFFF or in the surrogates. `\b` reaches here only from a class, where it
/// is backspace.
fn codeOf(pattern: String, from: Int64, to: Int64) -> Int64 {
    let c = pattern[from]
    if c == 'c' {
        return Int64(pattern[from + 1]) & 31
    }
    if c != 'x' && c != 'u' && c != 'o' {
        return if c == 't' { 9 } else if c == 'n' { 10 } else if c == 'v' { 11 } else if c == 'f' { 12 } else if c == 'r' { 13 } else if c == 'a' { 7 } else if c == 'e' { 27 } else if c == 'b' { 8 } else { Int64(c) }
    }
    let radix = if c == 'o' { 8 } else { 16 }
    let mut i = from + 1
    let mut end = to
    if pattern[i] == '{' {
        i = i + 1
        end = to - 1
    }
    let mut v = 0
    while i < end {
        let d = Int64(pattern[i])
        v = v * radix + if d <= '9' { d - '0' } else if d <= 'F' { d - 'A' + 10 } else { d - 'a' + 10 }
        if v > maxChar {
            return 0 - 1
        }
        i = i + 1
    }
    return if v >= 55296 && v <= 57343 { 0 - 1 } else { v }
}

/// The code point of the escape from `from` up to `to`, as `codeOf` states it; one
/// out of range is refused and stands as 0.
fn escapeChar(bd: modify Builder, pattern: String, from: Int64, to: Int64) -> Int64 {
    let c = codeOf(pattern, from, to)
    if c < 0 {
        refuse(bd, CodepointRange)
        return 0
    }
    return c
}

/// The UTF-8 bytes of the code point `c`.
fn utf8(c: Int64) -> Array<Int64> {
    if c < 128 {
        return [c]
    }
    if c < 2048 {
        return [192 | (c >> 6), 128 | (c & 63)]
    }
    if c < 65536 {
        return [224 | (c >> 12), 128 | ((c >> 6) & 63), 128 | (c & 63)]
    }
    return [240 | (c >> 18), 128 | ((c >> 12) & 63), 128 | ((c >> 6) & 63), 128 | (c & 63)]
}

/// The offset after the text of the quote `\Q..\E` at `start`, which ends at `end`:
/// `end` less its `\E`, or `end` when the pattern ends first.
fn quoteEnd(pattern: String, start: Int64, end: Int64) -> Int64 {
    if end - start >= 4 && pattern[end - 2] == '\\' && pattern[end - 1] == 'E' {
        return end - 2
    }
    return end
}

/// The offset of the last character of the text of `pattern` before `end`.
fn lastChar(pattern: String, end: Int64) -> Int64 {
    let mut i = end - 1
    while i > 0 && pattern[i] >= 128 && pattern[i] < 192 {
        i = i - 1
    }
    return i
}

/// The code point of the class bound `b`.
fn boundChar(bd: modify Builder, pattern: String, b: rx.RegexBound) -> Int64 {
    return match b {
        RegexBoundRegexEscapeInClass(e) => escapeChar(bd, pattern, e.start + 1, e.end),
        RegexBoundRegexSingle(s) => charAt(pattern, s.start),
    }
}

/// The set of the class item `item`. A range runs between the code points of its
/// bounds.
fn itemChars(bd: modify Builder, pattern: String, item: rx.RegexItem) -> Array<Int64> {
    return match item {
        RegexItemRegexClassPosix(p) => posixChars(pattern, p.start),
        RegexItemRegexClass(c) => classChars(bd, pattern, c),
        RegexItemRegexMember(m) => memberChars(bd, pattern, m),
    }
}

fn memberChars(bd: modify Builder, pattern: String, m: rx.RegexMember) -> Array<Int64> {
    match m.lo {
        RegexBoundRegexEscapeInClass(e) => {
            if isShorthand(pattern[e.start + 1]) {
                return shorthandChars(pattern[e.start + 1])
            }
        }
        RegexBoundRegexSingle(s) => {}
    }
    let lo = boundChar(bd, pattern, m.lo)
    if let Some(r) = m.range {
        if let Some(h) = r.hi {
            let hi = boundChar(bd, pattern, h)
            if hi < lo {
                refuse(bd, Backwards)
            }
            return charsOf([lo, hi])
        }
    }
    return [lo, lo]
}

/// The set a class states: each union of items, combined left to right by the
/// operators between them, and negated after.
fn classChars(bd: modify Builder, pattern: String, c: rx.RegexClass) -> Array<Int64> {
    let mut acc: Array<Int64> = []
    let mut i = 0
    while i < c.sets.length {
        let mut u: Array<Int64> = []
        let mut j = 0
        while j < c.sets[i].items.length {
            u = charsOr(u, itemChars(bd, pattern, c.sets[i].items[j]))
            j = j + 1
        }
        if i == 0 {
            acc = u
        } else {
            let op = c.ops[i - 1].text
            acc = if op == "&&" { charsAnd(acc, u) } else if op == "--" { charsLess(acc, u) } else { charsOr(charsLess(acc, u), charsLess(u, acc)) }
        }
        i = i + 1
    }
    let folded = if bd.fold { foldChars(acc) } else { acc }
    if let Some(n) = c.negate {
        return charsNot(folded)
    }
    return folded
}

/// The set of `.`: every character but `\n` and `\r`, or every one under `s`.
fn dotChars(bd: Builder) -> Array<Int64> {
    return if bd.dotAll { charsNot([]) } else { charsNot([10, 10, 13, 13]) }
}

/// `set` with the members from `lo` to `hi` moved by `by`.
fn charsMoved(set: Array<Int64>, lo: Int64, hi: Int64, by: Int64) -> Array<Int64> {
    let part = charsAnd(set, [lo, hi])
    let mut out: Array<Int64> = []
    let mut i = 0
    while i < part.length {
        out.push(part[i] + by)
        i = i + 1
    }
    return out
}

/// `set` with the other case of each ASCII letter it holds.
fn foldChars(set: Array<Int64>) -> Array<Int64> {
    return charsOr(set, charsOr(charsMoved(set, 97, 122, 0 - 32), charsMoved(set, 65, 90, 32)))
}

/// The fragment of the code point `c`, both cases of an ASCII letter under `i`.
fn fragChar(bd: modify Builder, c: Int64) -> Frag {
    if bd.fold && ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {
        return fragChars(bd, foldChars([c, c]))
    }
    return fragBytes(bd, utf8(c))
}

/// Sets `bd`'s flags by the letters of `pattern` from `from` up to `to`, a flag
/// list of `(?ims-ims`.
fn setFlags(bd: modify Builder, pattern: String, from: Int64, to: Int64) {
    let mut on = true
    let mut i = from
    while i < to {
        if pattern[i] == '-' {
            on = false
        } else if pattern[i] == 'i' {
            bd.fold = on
        } else if pattern[i] == 's' {
            bd.dotAll = on
        } else if pattern[i] == 'm' {
            bd.lines = on
        }
        i = i + 1
    }
}

/// The group `g` under its own flags, which end at its `)`. A name names one group.
fn fragGroup(bd: modify Builder, pattern: String, g: rx.RegexSubpattern) -> Frag {
    let fold = bd.fold
    let dotAll = bd.dotAll
    let lines = bd.lines
    let open = g.open.text
    let named = open.byteLength > 2 && (open[2] == 'P' || open[2] == '<' || open[2] == '\'')
    if open == "(?>" {
        let f = fragAlt(bd, pattern, g.alt)
        bd.fold = fold
        bd.dotAll = dotAll
        bd.lines = lines
        return fragAtomic(bd, f)
    }
    if !named && open.byteLength > 2 {
        setFlags(bd, open, 2, open.byteLength - 1)
        let f = fragAlt(bd, pattern, g.alt)
        bd.fold = fold
        bd.dotAll = dotAll
        bd.lines = lines
        return f
    }
    if bd.lookDepth > 0 {
        refuse(bd, LookCapture)
    }
    let name = if named { substring(open, if open[2] == 'P' { 4 } else { 3 }, open.byteLength - 1) } else { "" }
    let k = groupNumber(bd, g.start, name)
    let first = emit(bd, opSave, 2 * k - 2, 0, noBytes())
    let f = fragAlt(bd, pattern, g.alt)
    let last = emit(bd, opSave, 2 * k - 1, 0, noBytes())
    patch(bd, [first * 2 + 1], f.start)
    patch(bd, f.holes, last)
    bd.fold = fold
    bd.dotAll = dotAll
    bd.lines = lines
    return Frag { start: first, holes: [last * 2 + 1] }
}

/// The flags of `bd` as a key's prefix: two bodies of one text are one body only
/// under the same flags.
fn flagKey(bd: Builder) -> String {
    return (if bd.fold { "i" } else { "" }) + (if bd.dotAll { "s" } else { "" }) + (if bd.lines { "m" } else { "" }) + ":"
}

/// The lookaround body of `key`, or -1 for one not built.
fn lookOf(bd: Builder, key: String) -> Int64 {
    let mut k = 0
    while k < bd.lookKeys.length {
        if bd.lookKeys[k] == key {
            return k
        }
        k = k + 1
    }
    return 0 - 1
}

/// Adds the body `f` of `key` with its own match, and answers its number.
fn addLook(bd: modify Builder, key: String, behind: Bool, f: consume Frag, regular: Bool) -> Int64 {
    let m = emit(bd, opMatch, 0, 0, noBytes())
    patch(bd, f.holes, m)
    bd.lookKeys.push(key.copy())
    bd.lookBehind.push(behind)
    bd.lookStart.push(f.start)
    bd.lookEnd.push(m)
    bd.lookRegular.push(regular)
    return bd.lookKeys.length - 1
}

/// The test that body `k` holds here, or does not when `negate`.
fn fragAssert(bd: modify Builder, k: Int64, negate: Bool) -> Frag {
    let pc = emit(bd, opAssert, 2 * k + (if negate { 1 } else { 0 }), 0, noBytes())
    return Frag { start: pc, holes: [pc * 2 + 1] }
}

/// The lookaround `l`. Its flags end at its `)`, as a group's do.
fn fragLookaround(bd: modify Builder, pattern: String, l: rx.RegexLook) -> Frag {
    let open = l.open.text
    let behind = open[2] == '<'
    let negate = open[open.byteLength - 1] == '!'
    let key = (if behind { "<" } else { ">" }) + flagKey(bd) + substring(pattern, l.alt.start, l.alt.end)
    let mut k = lookOf(bd, key)
    if k < 0 {
        let fold = bd.fold
        let dotAll = bd.dotAll
        let lines = bd.lines
        let irregular = bd.irregular
        bd.lookDepth = bd.lookDepth + 1
        let f = fragAlt(bd, pattern, l.alt)
        bd.lookDepth = bd.lookDepth - 1
        bd.fold = fold
        bd.dotAll = dotAll
        bd.lines = lines
        k = addLook(bd, key, behind, f, bd.irregular == irregular)
    }
    return fragAssert(bd, k, negate)
}

/// The body of one byte of `set` under `key`, built once.
fn lookSet(bd: modify Builder, key: String, behind: Bool, set: ByteSet) -> Int64 {
    let k = lookOf(bd, key)
    if k >= 0 {
        return k
    }
    return addLook(bd, key, behind, fragSet(bd, set), true)
}

/// `f` then `g`.
fn fragThen(bd: modify Builder, f: consume Frag, g: consume Frag) -> Frag {
    patch(bd, f.holes, g.start)
    return Frag { start: f.start, holes: consume g.holes }
}

/// `f` or `g`.
fn fragEither(bd: modify Builder, f: consume Frag, g: consume Frag) -> Frag {
    let sp = emit(bd, opSplit, f.start, g.start, noBytes())
    return Frag { start: sp, holes: joinHoles(f.holes, g.holes) }
}

/// Whether the text before is a word character, unless `notBefore`, and the text
/// after is one, unless `notAfter`.
fn fragWords(bd: modify Builder, notBefore: Bool, notAfter: Bool) -> Frag {
    let before = fragAssert(bd, lookSet(bd, "<w", true, wordBytes()), notBefore)
    let after = fragAssert(bd, lookSet(bd, ">w", false, wordBytes()), notAfter)
    return fragThen(bd, before, after)
}

/// The bytes of `\w`.
fn wordBytes() -> ByteSet {
    let mut w = noBytes()
    addRange(w, 48, 57)
    addRange(w, 65, 90)
    addRange(w, 95, 95)
    addRange(w, 97, 122)
    return w
}

/// The assertion `a`: `^` or `$`, or the text after the backslash of `\b`, `\B`,
/// `\A`, `\z`, `\Z`, `\<`, `\>` or a `\b{..}`. Each is a lookaround over one byte,
/// which is a character's own byte for `\n` and the ASCII of `\w`, as the compiler's
/// builder states them (`regex::anchor`).
fn fragAnchor(bd: modify Builder, a: String) -> Frag {
    let mut edge = allBytes()
    if bd.lines {
        edge.w0 = edge.w0 ^ 1024
    }
    let side = if bd.lines { "nl" } else { "any" }
    if a == "^" {
        return fragAssert(bd, lookSet(bd, "<" + side, true, edge), true)
    }
    if a == "$" {
        return fragAssert(bd, lookSet(bd, ">" + side, false, edge), true)
    }
    if a == "A" {
        return fragAssert(bd, lookSet(bd, "<any", true, allBytes()), true)
    }
    if a == "z" {
        return fragAssert(bd, lookSet(bd, ">any", false, allBytes()), true)
    }
    if a == "Z" {
        let mut k = lookOf(bd, ">Z")
        if k < 0 {
            let nl = fragOp(bd, fragRange(bd, 10, 10), "?", false)
            let end = fragAssert(bd, lookSet(bd, ">any", false, allBytes()), true)
            k = addLook(bd, ">Z", false, fragThen(bd, nl, end), true)
        }
        return fragAssert(bd, k, false)
    }
    if a == "b{start-half}" {
        return fragAssert(bd, lookSet(bd, "<w", true, wordBytes()), true)
    }
    if a == "b{end-half}" {
        return fragAssert(bd, lookSet(bd, ">w", false, wordBytes()), true)
    }
    if a == "<" || a == "b{start}" {
        return fragWords(bd, true, false)
    }
    if a == ">" || a == "b{end}" {
        return fragWords(bd, false, true)
    }
    if a == "b" {
        let end = fragWords(bd, false, true)
        return fragEither(bd, end, fragWords(bd, true, false))
    }
    let inside = fragWords(bd, false, false)
    return fragEither(bd, inside, fragWords(bd, true, true))
}

/// The assertion `a` matches, without its backslash.
fn anchorText(pattern: String, a: rx.RegexAnchor) -> String {
    return substring(pattern, if pattern[a.start] == '\\' { a.start + 1 } else { a.start }, a.end)
}

/// The terms of the assertion `a`, as the compiler's builder counts them: a
/// lookaround is one, so `\b` and `\B` are two pairs and `\<` and `\>` one.
fn anchorSize(a: String) -> Int64 {
    return if a == "b" || a == "B" { 4 } else if a == "<" || a == ">" || a == "b{start}" || a == "b{end}" { 2 } else { 1 }
}

/// The number of the capturing group whose `(` is at `at`, from 1, numbered on its
/// first walk. A name names one group.
fn groupNumber(bd: modify Builder, at: Int64, name: String) -> Int64 {
    let mut i = 0
    while i < bd.groupAt.length {
        if bd.groupAt[i] == at {
            return i + 1
        }
        if name != "" && bd.names[i] == name {
            refuse(bd, NameTwice)
        }
        i = i + 1
    }
    bd.groupAt.push(at)
    bd.names.push(name.copy())
    return bd.groupAt.length
}

/// The groups whose `(` comes before offset `at`.
fn groupsBefore(bd: Builder, at: Int64) -> Int64 {
    let mut n = 0
    let mut i = 0
    while i < bd.groupAt.length {
        if bd.groupAt[i] < at {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

/// The number the digits of `pattern` from `from` state, held at 100000 above it.
fn numberAt(pattern: String, from: Int64) -> Int64 {
    let mut n = 0
    let mut i = from
    while i < pattern.byteLength && pattern[i] >= '0' && pattern[i] <= '9' {
        if n < 100000 {
            n = n * 10 + Int64(pattern[i]) - 48
        }
        i = i + 1
    }
    return n
}

/// The backreference from `start` up to `end`. A name or a number waits for the
/// walk's end, which numbers every group; a relative number counts the groups
/// opened before it.
fn fragBackref(bd: modify Builder, pattern: String, start: Int64, end: Int64) -> Frag {
    let c = pattern[start + 1]
    let braced = c == 'g' && pattern[start + 2] == '{'
    let mut name = ""
    let mut k = 0
    if c == '?' || c == 'k' {
        name = substring(pattern, if c == '?' { start + 4 } else { start + 3 }, end - 1)
    } else if braced && pattern[start + 3] == '-' {
        k = groupsBefore(bd, start) + 1 - numberAt(pattern, start + 4)
    } else {
        k = numberAt(pattern, if braced { start + 3 } else if c == 'g' { start + 2 } else { start + 1 })
    }
    let pc = emit(bd, opBackref, 2 * k + (if bd.fold { 1 } else { 0 }), 0, noBytes())
    bd.refPc.push(pc)
    bd.refName.push(name)
    bd.irregular = bd.irregular + 1
    return Frag { start: pc, holes: [pc * 2 + 1] }
}

/// `f` as an atomic group: its open, its body and its close.
fn fragAtomic(bd: modify Builder, f: consume Frag) -> Frag {
    let open = emit(bd, opAtomic, 0, f.start, noBytes())
    let close = emit(bd, opAtomic, 0 - 1, 0, noBytes())
    bd.a[open] = close
    patch(bd, f.holes, close)
    bd.irregular = bd.irregular + 1
    return Frag { start: open, holes: [close * 2 + 1] }
}

/// Gives each backreference the number of its group, or refuses one whose group
/// the pattern does not have.
fn resolveRefs(bd: modify Builder) {
    let mut r = 0
    while r < bd.refPc.length {
        let pc = bd.refPc[r]
        let mut k = bd.a[pc] / 2
        if bd.refName[r] != "" {
            k = 0
            let mut g = 0
            while g < bd.names.length {
                if bd.names[g] == bd.refName[r] {
                    k = g + 1
                }
                g = g + 1
            }
        }
        if k < 1 || k > bd.groupAt.length {
            refuse(bd, BackrefMissing)
        }
        bd.a[pc] = 2 * k + bd.a[pc] % 2
        r = r + 1
    }
}

/// One class test, as a fragment.
fn fragSet(bd: modify Builder, k: ByteSet) -> Frag {
    let pc = emit(bd, opClass, 0 - 1, 0, k)
    return Frag { start: pc, holes: [pc * 2 + 1] }
}

/// The fragment of the bytes from `lo` to `hi`.
fn fragRange(bd: modify Builder, lo: Int64, hi: Int64) -> Frag {
    let mut k = noBytes()
    addRange(k, lo, hi)
    return fragSet(bd, k)
}

/// The fragment of the bytes `bs`, one after another.
fn fragBytes(bd: modify Builder, bs: Array<Int64>) -> Frag {
    let mut f = fragRange(bd, bs[0], bs[0])
    let mut i = 1
    while i < bs.length {
        let g = fragRange(bd, bs[i], bs[i])
        patch(bd, f.holes, g.start)
        f = Frag { start: f.start, holes: consume g.holes }
        i = i + 1
    }
    return f
}

/// The term of the escape from `start`, its backslash, up to `end`. A quote's last
/// character is its term, as in PCRE, and `fragPiece` emits the bytes before it.
/// `\R` is a line break: CR LF, or one of LF, VT, FF and CR.
fn fragEscape(bd: modify Builder, pattern: String, start: Int64, end: Int64) -> Frag {
    let c = pattern[start + 1]
    if c == 'Q' {
        let to = quoteEnd(pattern, start, end)
        return if to == start + 2 { fragEmpty(bd) } else { fragChar(bd, charAt(pattern, lastChar(pattern, to))) }
    }
    if c == 'R' {
        let crlf = fragBytes(bd, [13, 10])
        let one = fragChars(bd, [10, 13])
        let sp = emit(bd, opSplit, crlf.start, one.start, noBytes())
        return Frag { start: sp, holes: joinHoles(crlf.holes, one.holes) }
    }
    if isShorthand(c) {
        return fragChars(bd, shorthandChars(c))
    }
    return fragChar(bd, escapeChar(bd, pattern, start + 1, end))
}

/// The terms of the escape from `start` up to `end`, as the compiler's builder
/// counts them: a set's, a byte each for a code point or a quote's last character,
/// three for `\R` and one for an empty quote.
fn escapeSize(pattern: String, start: Int64, end: Int64) -> Int64 {
    let c = pattern[start + 1]
    if c == 'R' {
        return 3
    }
    if c == 'Q' {
        let to = quoteEnd(pattern, start, end)
        return if to == start + 2 { 1 } else { to - lastChar(pattern, to) }
    }
    if isShorthand(c) {
        return charsSize(shorthandChars(c))
    }
    let code = codeOf(pattern, start + 1, end)
    return utf8(if code < 0 { 0 } else { code }).length
}

/// The empty string: a split with both edges dangling.
fn fragEmpty(bd: modify Builder) -> Frag {
    let sp = emit(bd, opSplit, 0, 0, noBytes())
    return Frag { start: sp, holes: [sp * 2, sp * 2 + 1] }
}

/// `f` under the repeat `op`: `*`, `+` or `?`, greedy or `lazy`.
fn fragOp(bd: modify Builder, f: consume Frag, op: String, lazy: Bool) -> Frag {
    // The split's first operand is the one a search prefers: the body for a greedy
    // repeat, the way out for a lazy one. The body loops back to the split.
    let sp = if lazy { emit(bd, opSplit, 0, f.start, noBytes()) } else { emit(bd, opSplit, f.start, 0, noBytes()) }
    let out = if lazy { sp * 2 } else { sp * 2 + 1 }
    if op == "?" {
        return Frag { start: sp, holes: joinHoles(f.holes, [out]) }
    }
    patch(bd, f.holes, sp)
    return Frag { start: if op == "*" { sp } else { f.start }, holes: [out] }
}

/// The term of `atom` a repeat applies to: the whole atom, or a quote's last
/// character, whose other bytes `fragPiece` emits before it.
fn fragTerm(bd: modify Builder, pattern: String, atom: rx.RegexAtom) -> Frag {
    match atom {
        RegexAtomRegexFlags(f) => {
            setFlags(bd, pattern, f.start + 2, f.end - 1)
            return fragEmpty(bd)
        }
        RegexAtomRegexComment(c) => {
            return fragEmpty(bd)
        }
        RegexAtomRegexSubpattern(g) => {
            return fragGroup(bd, pattern, g)
        }
        RegexAtomRegexClass(c) => {
            return fragChars(bd, classChars(bd, pattern, c))
        }
        RegexAtomRegexEscape(e) => {
            return fragEscape(bd, pattern, e.start, e.end)
        }
        RegexAtomRegexClassDot(d) => {
            return fragChars(bd, dotChars(bd))
        }
        RegexAtomRegexLiteral(l) => {
            return fragChar(bd, charAt(pattern, l.start))
        }
        RegexAtomRegexLook(l) => {
            return fragLookaround(bd, pattern, l)
        }
        RegexAtomRegexAnchor(a) => {
            return fragAnchor(bd, anchorText(pattern, a))
        }
        RegexAtomRegexBackref(r) => {
            return fragBackref(bd, pattern, r.start, r.end)
        }
    }
}

/// The offset after the digits of `pattern` that start at `from`.
fn digitsEnd(pattern: String, from: Int64) -> Int64 {
    let mut i = from
    while i < pattern.byteLength && pattern[i] >= '0' && pattern[i] <= '9' {
        i = i + 1
    }
    return i
}

/// The number the digits of `pattern` from `from` up to `to` state, or 256 for any
/// number above 255.
fn countValue(pattern: String, from: Int64, to: Int64) -> Int64 {
    let mut v = 0
    let mut i = from
    while i < to {
        v = v * 10 + Int64(pattern[i]) - 48
        if v > 255 {
            return 256
        }
        i = i + 1
    }
    return v
}

/// The bounds of a count: `{min}`, `{min,}` or `{min,max}`. An open count has
/// `max` equal to `min`.
type Bounds = { min: Int64, max: Int64, open: Bool }

/// The bounds of `c`, whose text the grammar states: `{`, digits, then `}`, `,}` or
/// `,`, digits and `}`.
fn boundsOf(pattern: String, c: rx.RegexQuantifierCount) -> Bounds {
    let comma = digitsEnd(pattern, c.start + 1)
    let min = countValue(pattern, c.start + 1, comma)
    if pattern[comma] != ',' {
        return Bounds { min: min, max: min, open: false }
    }
    if comma + 2 == c.end {
        return Bounds { min: min, max: min, open: true }
    }
    return Bounds { min: min, max: countValue(pattern, comma + 1, c.end - 1), open: false }
}

/// The copies of its term a count of bounds `n` makes.
fn copiesOf(n: Bounds) -> Int64 {
    return if n.open { n.min + 1 } else { n.max }
}

/// The terms of `piece` once its counts are expanded, as the compiler's builder
/// counts them: a byte range and the empty string are one term each.
fn pieceSize(bd: modify Builder, pattern: String, piece: rx.RegexPiece) -> Int64 {
    let term = termSize(bd, pattern, piece.atom)
    let mut prefix = 0
    match piece.atom {
        RegexAtomRegexFlags(f) => {}
        RegexAtomRegexComment(c) => {}
        RegexAtomRegexSubpattern(g) => {}
        RegexAtomRegexClass(c) => {}
        RegexAtomRegexEscape(e) => {
            let q = quoteEnd(pattern, e.start, e.end)
            if pattern[e.start + 1] == 'Q' && q > e.start + 2 {
                prefix = lastChar(pattern, q) - e.start - 2
            }
        }
        RegexAtomRegexClassDot(d) => {}
        RegexAtomRegexLiteral(l) => {}
        RegexAtomRegexLook(l) => {}
        RegexAtomRegexAnchor(a) => {}
        RegexAtomRegexBackref(r) => {}
    }
    if let Some(c) = piece.count {
        let copies = copiesOf(boundsOf(pattern, c))
        return prefix + if copies == 0 { 1 } else { copies * term }
    }
    return prefix + term
}

/// The terms of `alt` once its counts are expanded.
fn altSize(bd: modify Builder, pattern: String, alt: rx.RegexAlt) -> Int64 {
    let mut n = 0
    let mut i = 0
    while i < alt.branches.length {
        if alt.branches[i].pieces.length == 0 {
            n = n + 1
        }
        let mut j = 0
        while j < alt.branches[i].pieces.length {
            n = n + pieceSize(bd, pattern, alt.branches[i].pieces[j])
            j = j + 1
        }
        i = i + 1
    }
    return n
}

/// The terms of `atom`, the term a repeat applies to. A refusal it finds is one the
/// walk would raise building the atom.
fn termSize(bd: modify Builder, pattern: String, atom: rx.RegexAtom) -> Int64 {
    return match atom {
        RegexAtomRegexFlags(f) => 1,
        RegexAtomRegexComment(c) => 1,
        RegexAtomRegexSubpattern(g) => altSize(bd, pattern, g.alt),
        RegexAtomRegexClass(c) => charsSize(classChars(bd, pattern, c)),
        RegexAtomRegexEscape(e) => escapeSize(pattern, e.start, e.end),
        RegexAtomRegexClassDot(d) => charsSize(dotChars(bd)),
        RegexAtomRegexLiteral(l) => l.end - l.start,
        RegexAtomRegexLook(l) => 1,
        RegexAtomRegexAnchor(a) => anchorSize(anchorText(pattern, a)),
        RegexAtomRegexBackref(r) => 1,
    }
}

/// One copy of the term of `atom` a count makes: as it is, or else under `*` for
/// an open count and under `?` for a closed one.
fn fragCopy(bd: modify Builder, pattern: String, atom: rx.RegexAtom, optional: Bool, n: Bounds, lazy: Bool) -> Frag {
    let f = fragTerm(bd, pattern, atom)
    if !optional {
        return f
    }
    return fragOp(bd, f, if n.open { "*" } else { "?" }, lazy)
}

/// The term of `piece` under its repeat or its count, as an atomic group when the
/// repeat is possessive.
fn fragRepeat(bd: modify Builder, pattern: String, piece: rx.RegexPiece) -> Frag {
    let mut lazy = false
    if let Some(m) = piece.mode {
        if m.text == "+" {
            return fragAtomic(bd, fragQuantified(bd, pattern, piece, false))
        }
        lazy = true
    }
    return fragQuantified(bd, pattern, piece, lazy)
}

/// The term of `piece` under its repeat or its count, greedy or `lazy`.
fn fragQuantified(bd: modify Builder, pattern: String, piece: rx.RegexPiece, lazy: Bool) -> Frag {
    if let Some(op) = piece.op {
        return fragOp(bd, fragTerm(bd, pattern, piece.atom), op.text, lazy)
    }
    if let Some(c) = piece.count {
        return fragCount(bd, pattern, piece.atom, boundsOf(pattern, c), lazy)
    }
    return fragTerm(bd, pattern, piece.atom)
}

/// The term of `atom` under a count of bounds `n`: `{m,n}` is `m` copies of the
/// term and then `n - m` optional copies, and `{m,}` is `m` copies and a starred
/// one.
fn fragCount(bd: modify Builder, pattern: String, atom: rx.RegexAtom, n: Bounds, lazy: Bool) -> Frag {
    let copies = copiesOf(n)
    let cost = copies * termSize(bd, pattern, atom)
    if n.min > 255 || n.max > 255 {
        refuse(bd, CountLarge)
    } else if n.max < n.min {
        refuse(bd, CountOrder)
    } else if bd.expanded + cost > countBudget {
        refuse(bd, CountBudget)
    }
    if copies == 0 && !refused(bd) {
        // The term is walked once all the same, so its groups have their numbers
        // and its refusals are raised; nothing reaches its pcs.
        let _ = fragTerm(bd, pattern, atom)
    }
    if copies == 0 || refused(bd) {
        return fragEmpty(bd)
    }
    bd.expanded = bd.expanded + cost
    let mut f = fragCopy(bd, pattern, atom, n.min == 0, n, lazy)
    let mut i = 1
    while i < copies {
        let g = fragCopy(bd, pattern, atom, i >= n.min, n, lazy)
        patch(bd, f.holes, g.start)
        f = Frag { start: f.start, holes: consume g.holes }
        i = i + 1
    }
    return f
}

fn fragPiece(bd: modify Builder, pattern: String, piece: rx.RegexPiece) -> Frag {
    // A quote's characters before its last are terms of their own: a repeat takes
    // the last.
    let mut from = 0
    let mut to = 0
    match piece.atom {
        RegexAtomRegexFlags(f) => {}
        RegexAtomRegexComment(c) => {}
        RegexAtomRegexSubpattern(g) => {}
        RegexAtomRegexClass(c) => {}
        RegexAtomRegexEscape(e) => {
            let q = quoteEnd(pattern, e.start, e.end)
            if pattern[e.start + 1] == 'Q' && q > e.start + 2 {
                from = e.start + 2
                to = lastChar(pattern, q)
            }
        }
        RegexAtomRegexClassDot(d) => {}
        RegexAtomRegexLiteral(l) => {}
        RegexAtomRegexLook(l) => {}
        RegexAtomRegexAnchor(a) => {}
        RegexAtomRegexBackref(r) => {}
    }
    let mut f = fragRepeat(bd, pattern, piece)
    let mut i = to - 1
    while i >= from {
        let b = Int64(pattern[i])
        let g = if b < 128 { fragChar(bd, b) } else { fragRange(bd, b, b) }
        patch(bd, g.holes, f.start)
        f = Frag { start: g.start, holes: consume f.holes }
        i = i - 1
    }
    return f
}

fn fragBranch(bd: modify Builder, pattern: String, branch: rx.RegexBranch) -> Frag {
    if branch.pieces.length == 0 {
        // The empty branch, as in `(a|)`.
        return fragEmpty(bd)
    }
    let mut f = fragPiece(bd, pattern, branch.pieces[0])
    let mut i = 1
    while i < branch.pieces.length {
        let g = fragPiece(bd, pattern, branch.pieces[i])
        patch(bd, f.holes, g.start)
        f = Frag { start: f.start, holes: consume g.holes }
        i = i + 1
    }
    return f
}

fn fragAlt(bd: modify Builder, pattern: String, alt: rx.RegexAlt) -> Frag {
    let mut f = fragBranch(bd, pattern, alt.branches[0])
    let mut i = 1
    while i < alt.branches.length {
        let g = fragBranch(bd, pattern, alt.branches[i])
        let sp = emit(bd, opSplit, f.start, g.start, noBytes())
        f = Frag { start: sp, holes: joinHoles(f.holes, g.holes) }
        i = i + 1
    }
    return f
}

/// Each byte's class: a class is a run of bytes that no instruction's class cuts.
/// Byte `c` is cut when it and `c - 1` differ in some class, a bit of `s ^ (s << 1)`
/// with the shift carried across the words.
fn byteClasses(bd: Builder) -> Array<UInt8> {
    let mut cuts = noBytes()
    let mut pc = 0
    while pc < bd.cls.length {
        let s = bd.cls[pc]
        cuts = ByteSet {
            w0: cuts.w0 | (s.w0 ^ (s.w0 << 1)),
            w1: cuts.w1 | (s.w1 ^ ((s.w1 << 1) | (s.w0 >> 63))),
            w2: cuts.w2 | (s.w2 ^ ((s.w2 << 1) | (s.w1 >> 63))),
            w3: cuts.w3 | (s.w3 ^ ((s.w3 << 1) | (s.w2 >> 63))),
        }
        pc = pc + 1
    }
    let mut of: Array<UInt8> = [0]
    let mut c = 1
    while c < 256 {
        of.push(if hasByte(cuts, c) { of[c - 1] + 1 } else { of[c - 1] })
        c = c + 1
    }
    return of
}

/// Compiles `pattern`, or says what is wrong with it. Compile once and search
/// often: the whole cost of a pattern is paid here.
export fn compile(pattern: String) -> Result<Regex, String> {
    return match rx.parseRegexPattern(pattern) {
        Ok(tree) => build(pattern, tree),
        Err(errors) => Err(regexSay(errors[0].row)),
    }
}

/// A builder with nothing emitted.
fn newBuilder() -> Builder {
    return Builder { op: [], a: [], b: [], cls: [], err: None, expanded: 0, fold: false, dotAll: false, lines: false, groupAt: [], names: [], lookDepth: 0, lookKeys: [], lookBehind: [], lookStart: [], lookEnd: [], lookRegular: [], refPc: [], refName: [], irregular: 0 }
}

fn build(pattern: String, tree: rx.RegexAlt) -> Result<Regex, String> {
    let mut bd = newBuilder()
    let f = fragAlt(bd, pattern, tree)
    resolveRefs(bd)
    if let Some(row) = bd.err {
        return Err(regexSay(row))
    }
    let m = emit(bd, opMatch, 0, 0, noBytes())
    patch(bd, f.holes, m)
    let classOf = byteClasses(bd)
    let classCount = Int64(classOf[255]) + 1
    // The reverse starts at each match: the pattern's, then each body's.
    let mut starts = joinHoles([m], bd.lookEnd)
    let rev = reverse(bd, f.start, bd.lookStart, starts, classOf.copy(), classCount)
    let mut looks: Array<Look> = []
    let mut k = 0
    while k < bd.lookKeys.length && k + 1 < starts.length {
        looks.push(Look { behind: bd.lookBehind[k], fwd: bd.lookStart[k], rev: starts[k + 1], regular: bd.lookRegular[k] })
        k = k + 1
    }
    // The loop is the split's second operand, so a match that starts earlier wins.
    // Its class holds every byte, so it cuts no class.
    let start = emit(bd, opSplit, f.start, 0, noBytes())
    bd.b[start] = emit(bd, opClass, 0 - 1, start, allBytes())
    let backtrack = bd.irregular > 0
    let fwd = Program {
        op: consume bd.op,
        a: consume bd.a,
        b: consume bd.b,
        cls: consume bd.cls,
        start: start,
        classCount: classCount,
        classOf: classOf,
        looks: looks.length,
    }
    return Ok(Regex { fwd: fwd, rev: rev, names: consume bd.names, looks: consume looks, backtrack: backtrack })
}

fn allBytes() -> ByteSet {
    let all: UInt64 = 18446744073709551615
    return ByteSet { w0: all, w1: all, w2: all, w3: all }
}

/// The reverse of the program in `p`, whose starts are `first`, the pattern's, and
/// `bodies`, each lookaround body's. Each pc `r` of `p` is a state that leads to every pc that
/// leads to `r` in `p`: a class pc or an assertion of `p` is that test on that edge,
/// a split pc an empty edge, and each start the match. A state is a chain of splits,
/// one per edge, each operand `a` an edge; its tests follow the chain. Two passes:
/// the first lays out each state's pcs. The tests are `p`'s, so the reverse keeps
/// `classOf`. Each pc of `p` in `ends` becomes the state it is in the reverse, and
/// the first is the reverse's start.
fn reverse(p: Builder, first: Int64, bodies: Array<Int64>, ends: modify Array<Int64>, classOf: consume Array<UInt8>, classCount: Int64) -> Program {
    let n = p.op.length
    // The pcs of `p` that lead to each pc, as lists through `nextFrom`.
    let mut firstFrom: Array<Int64> = []
    while firstFrom.length < n {
        firstFrom.push(0 - 1)
    }
    let mut from: Array<Int64> = []
    let mut nextFrom: Array<Int64> = []
    let mut q = 0
    while q < n {
        let mut k = 0
        while k < 2 {
            let to = if k == 0 { p.b[q] } else { p.a[q] }
            if p.op[q] != opMatch && (k == 0 || p.op[q] == opSplit) && to >= 0 && to < n {
                from.push(q)
                nextFrom.push(firstFrom[to])
                firstFrom[to] = from.length - 1
            }
            k = k + 1
        }
        q = q + 1
    }
    // pc 0 never matches and pc 1 matches; each state's chain then its tests.
    let mut entry: Array<Int64> = []
    let mut size = 2
    let mut r = 0
    while r < n {
        entry.push(size)
        let mut e = firstFrom[r]
        let mut links = if r == first || bodies.length > 0 && holdsPc(bodies, r) { 1 } else { 0 }
        let mut tests = 0
        while e >= 0 {
            links = links + 1
            if p.op[from[e]] == opClass || p.op[from[e]] == opAssert {
                tests = tests + 1
            }
            e = nextFrom[e]
        }
        size = size + tests + if links == 0 { 1 } else { links }
        r = r + 1
    }
    let mut out = newBuilder()
    emit(out, opClass, 0 - 1, 0, noBytes())
    emit(out, opMatch, 0, 0, noBytes())
    let mut s = 0
    while s < n {
        let start = s == first || bodies.length > 0 && holdsPc(bodies, s)
        let mut links = if start { 1 } else { 0 }
        let mut f = firstFrom[s]
        while f >= 0 {
            links = links + 1
            f = nextFrom[f]
        }
        let test = entry[s] + if links == 0 { 1 } else { links }
        // The chain's operands: the match, then each edge in list order.
        let mut targets: Array<Int64> = []
        if start {
            targets.push(1)
        }
        let mut e = firstFrom[s]
        let mut tests: Array<Int64> = []
        while e >= 0 {
            let q = from[e]
            if p.op[q] == opClass || p.op[q] == opAssert {
                targets.push(test + tests.length)
                tests.push(q)
            } else {
                targets.push(entry[q])
            }
            e = nextFrom[e]
        }
        if targets.length == 0 {
            emit(out, opSplit, 0, 0, noBytes())
        }
        let mut i = 0
        while i < targets.length {
            let after = if i + 1 < targets.length { out.op.length + 1 } else { 0 }
            emit(out, opSplit, targets[i], after, noBytes())
            i = i + 1
        }
        let mut j = 0
        while j < tests.length {
            let q = tests[j]
            if p.op[q] == opAssert {
                emit(out, opAssert, p.a[q], entry[q], noBytes())
            } else {
                emit(out, opClass, 0 - 1, entry[q], p.cls[q])
            }
            j = j + 1
        }
        s = s + 1
    }
    let mut i = 0
    while i < ends.length {
        ends[i] = entry[ends[i]]
        i = i + 1
    }
    return Program {
        op: consume out.op,
        a: consume out.a,
        b: consume out.b,
        cls: consume out.cls,
        start: ends[0],
        classCount: classCount,
        classOf: classOf,
        looks: p.lookKeys.length,
    }
}

/// Whether `pcs` holds `pc`.
fn holdsPc(pcs: Array<Int64>, pc: Int64) -> Bool {
    let mut i = 0
    while i < pcs.length {
        if pcs[i] == pc {
            return true
        }
        i = i + 1
    }
    return false
}

// A Thompson simulation: one list of live pcs in the order a search prefers them,
// stepped one input byte at a time. The lazy DFA below caches those lists as
// states, and falls back to the simulation when its table is full.

/// The pc after instruction `pc` takes byte `c`, or -1 when it is not a class
/// that holds `c`.
fn follow(re: Program, pc: Int64, c: Int64) -> Int64 {
    if re.op[pc] != opClass || !hasByte(re.cls[pc], c) {
        return 0 - 1
    }
    return re.b[pc]
}

/// Whether the assertion at `pc` holds at offset `at`: bit `a / 2` of the offset in
/// `bits`, or its negation for an odd `a` ([`lookBits`]).
fn holds(re: Program, pc: Int64, bits: Array<Bool>, at: Int64) -> Bool {
    let k = re.a[pc]
    return bits[at * re.looks + k / 2] != (k % 2 == 1)
}

/// Adds `pc` and everything reachable from it without consuming at offset `sc.at`,
/// marking each with `sc.gen`.
fn addThread(re: Program, list: modify Array<Int64>, sc: modify Scan, pc: Int64) {
    let mut stack: Array<Int64> = [pc]
    while stack.length > 0 {
        let p = stack[stack.length - 1]
        stack.pop()
        if p < 0 || p >= re.op.length || p >= sc.mark.length {
            continue
        }
        if sc.mark[p] == sc.gen {
            continue
        }
        sc.mark[p] = sc.gen
        // A class or a match pc takes two tests, a save three and an assertion four. A
        // backreference ends the thread: only the backtracking search reads it.
        if re.op[p] == opSplit {
            // `b` first so `a` pops first: `a` is the operand a search prefers.
            stack.push(re.b[p])
            stack.push(re.a[p])
        } else if re.op[p] < opSave {
            list.push(p)
        } else if re.op[p] == opSave {
            stack.push(re.b[p])
        } else if re.op[p] == opAssert && holds(re, p, sc.bits, sc.at) {
            stack.push(re.b[p])
        }
    }
}

/// The class and match pcs after the pcs `list` take byte `c` into offset `sc.at`,
/// in order; a leftmost-first scan drops each pc after the first match.
fn stepList(re: Program, list: Array<Int64>, c: Int64, sc: modify Scan) -> Array<Int64> {
    let mut next: Array<Int64> = []
    sc.gen = sc.gen + 1
    let mut j = 0
    while j < list.length {
        addThread(re, next, sc, follow(re, list[j], c))
        j = j + 1
    }
    if sc.first {
        dropAfterMatch(re, next)
    }
    return next
}

/// Drops each pc of `list` after its first match: the leftmost-first rule.
fn dropAfterMatch(re: Program, list: modify Array<Int64>) {
    let mut k = 0
    while k < list.length && re.op[list[k]] != opMatch {
        k = k + 1
    }
    while list.length > k + 1 {
        list.pop()
    }
}

/// Whether the pcs `list` hold a match.
fn listAccepts(re: Program, list: Array<Int64>) -> Bool {
    let mut k = 0
    while k < list.length {
        if re.op[list[k]] == opMatch {
            return true
        }
        k = k + 1
    }
    return false
}

/// Table entries one search may add beyond its first two states: 2 MB.
let dfaCap = 262144

/// One search's lazy DFA, and the marks both engines build pc sets with.
///
/// A state is the offset of its row in `next`: the start state's row is at 0.
/// A row holds `classCount` entries, and the table holds 256 entries past
/// every row's offset, so a byte's class reads its row with no check.
type Scan = {
    // `sets[off / classCount]` holds the class and match pcs of the state at
    // `off`, in the order a search prefers them.
    sets: Array<Array<Int64>>,
    ids: Map<String, Int64>,
    // `next[off + k]` is the state after a byte of class `k`, or -256 until a
    // search first takes that edge. Every entry, -256 too, is at most the
    // length less 256.
    next: Array<Int64>,
    // `accepts[off]` says whether the state at `off` accepts; as long as
    // `next`.
    accepts: Array<Bool>,
    // The state of the empty set, where every match has ended.
    dead: Int64,
    cap: Int64,
    mark: Array<Int64>,
    gen: Int64,
    // Whether a state drops each pc after its first match, the forward pass's
    // leftmost-first rule. The backward pass keeps them all, to reach the start.
    first: Bool,
    // Each lookaround body's bit at each offset ([`lookBits`]), and the offset a
    // closure adds pcs at. A pattern with no lookaround has no bits and builds
    // states, whose closures read none.
    bits: Array<Bool>,
    at: Int64,
}

/// The state of the class and match pcs `list`, added if it is new, or -1 when a new
/// state would pass the cap.
fn intern(re: Program, list: Array<Int64>, sc: modify Scan) -> Int64 {
    let mut set: Array<Int64> = []
    let mut key = ""
    let mut accepts = false
    let mut k = 0
    while k < list.length && !(accepts && sc.first) {
        let pc = list[k]
        set.push(pc)
        key = key + "\{pc},"
        accepts = accepts || pc >= 0 && pc < re.op.length && re.op[pc] == opMatch
        k = k + 1
    }
    if let Some(off) = sc.ids[key] {
        return off
    }
    if sc.next.length + re.classCount > sc.cap {
        return 0 - 1
    }
    // The new row starts where the last 256 entries do.
    let off = sc.next.length - 256
    sc.ids[key] = off
    sc.sets.push(set)
    let mut j = 0
    while j < re.classCount {
        sc.next.push(0 - 256)
        sc.accepts.push(false)
        j = j + 1
    }
    sc.accepts[off] = accepts
    return off
}

/// A search with no edges built, which may add `cap` table entries, under the
/// leftmost-first rule when `first`, its assertions reading `bits`.
fn newScan(re: Program, cap: Int64, first: Bool, bits: consume Array<Bool>) -> Scan {
    let mut mark: Array<Int64> = []
    let mut i = 0
    while i < re.op.length {
        mark.push(0)
        i = i + 1
    }
    let mut sc = Scan { sets: [], ids: [:], next: [], accepts: [], dead: 0, cap: 256 + 2 * re.classCount + cap, mark: mark, gen: 1, first: first, bits: bits, at: 0 }
    // The 256 entries past the start state's row, which `intern` makes first.
    while sc.next.length < 256 {
        sc.next.push(0 - 256)
        sc.accepts.push(false)
    }
    let mut start: Array<Int64> = []
    addThread(re, start, sc, re.start)
    intern(re, start, sc)
    sc.dead = intern(re, [], sc)
    return sc
}

/// The state after the state `s` takes byte `c`, built on first use, or -1 when the
/// table is full. A walk reads a built edge itself and calls this on a miss.
fn stepState(re: Program, s: Int64, c: Int64, sc: modify Scan) -> Int64 {
    let edge = s + Int64(re.classOf[c])
    let t = sc.next[edge]
    if t >= 0 {
        return t
    }
    sc.gen = sc.gen + 1
    let mut scratch: Array<Int64> = []
    let set = s / re.classCount
    let mut j = 0
    while j < sc.sets[set].length {
        addThread(re, scratch, sc, follow(re, sc.sets[set][j], c))
        j = j + 1
    }
    let u = intern(re, scratch, sc)
    // A state is 256 entries before the table's end; the walk cannot see that
    // through `ids`, so the test states it.
    if u < 0 || u > sc.next.length - 256 {
        return 0 - 1
    }
    sc.next[edge] = u
    return u
}

/// The end of the leftmost-first match that starts at or after `from`, or -1 for
/// none: the pass stops where the match can grow no more.
fn matchEnd(re: Program, hay: Array<UInt8>, from: Int64 where value >= 0, sc: modify Scan) -> Int64 {
    let dead = sc.dead
    let mut s = 0
    let mut end = if sc.accepts[0] { from } else { 0 - 1 }
    let mut i = from
    while i < hay.length {
        let c = Int64(hay[i])
        let mut t = sc.next[s + Int64(re.classOf[c])]
        if t < 0 {
            t = stepState(re, s, c, sc)
            if t < 0 || t > sc.next.length - 256 {
                // The table is full: step the state's pcs from here on.
                return listEnd(re, hay, i, joinHoles(sc.sets[s / re.classCount], []), sc, end)
            }
        }
        if t == dead {
            return end
        }
        s = t
        i = i + 1
        if sc.accepts[s] {
            end = i
        }
    }
    return end
}

/// The start of the match that ends at `end`: the least offset down to `from` that
/// a backward pass of `rev` from `end` accepts at. The pass accepts at the start of
/// that match, so `end` stands only for an empty one.
fn matchStart(rev: Program, hay: Array<UInt8>, from: Int64 where value >= 0, end: Int64, sc: modify Scan) -> Int64 {
    let dead = sc.dead
    let mut s = 0
    let mut at = end
    let mut i = end
    while i > from && i <= hay.length {
        let c = Int64(hay[i - 1])
        let mut t = sc.next[s + Int64(rev.classOf[c])]
        if t < 0 {
            t = stepState(rev, s, c, sc)
            if t < 0 || t > sc.next.length - 256 {
                return listStart(rev, hay, from, i, joinHoles(sc.sets[s / rev.classCount], []), sc, at)
            }
        }
        if t == dead {
            return at
        }
        s = t
        i = i - 1
        if sc.accepts[s] {
            at = i
        }
    }
    return at
}

/// The end of the match the pcs `list` at offset `from` reach, stepping them to the
/// end of `hay` or until none is left: the latest offset a pc matches at, or `end`.
fn listEnd(re: Program, hay: Array<UInt8>, from: Int64, list: consume Array<Int64>, sc: modify Scan, end: Int64) -> Int64 {
    let mut pcs = list
    let mut last = end
    let mut i = from
    while i >= 0 && i < hay.length && pcs.length > 0 {
        sc.at = i + 1
        pcs = stepList(re, pcs, Int64(hay[i]), sc)
        i = i + 1
        if listAccepts(re, pcs) {
            last = i
        }
    }
    return last
}

/// The start of the match the reverse pcs `list` at offset `from` reach, stepping them
/// back down to `to` or until none is left: the least offset a pc matches at, or `at`.
fn listStart(rev: Program, hay: Array<UInt8>, to: Int64, from: Int64, list: consume Array<Int64>, sc: modify Scan, at: Int64) -> Int64 {
    let mut pcs = list
    let mut least = at
    let mut i = from
    while i > to && i <= hay.length && pcs.length > 0 {
        sc.at = i - 1
        pcs = stepList(rev, pcs, Int64(hay[i - 1]), sc)
        i = i - 1
        if listAccepts(rev, pcs) {
            least = i
        }
    }
    return least
}

/// The pcs `list` after byte `c`, or none before the first byte when `c` is -1, and
/// a thread from `start` at offset `at`: one step of a pass that starts a body at
/// every offset.
fn passStep(re: Program, list: Array<Int64>, c: Int64, start: Int64, sc: modify Scan, at: Int64) -> Array<Int64> {
    let mut next: Array<Int64> = []
    sc.at = at
    if c < 0 {
        sc.gen = sc.gen + 1
    } else {
        next = stepList(re, list, c, sc)
    }
    addThread(re, next, sc, start)
    return next
}

/// Each lookaround body's bit at each offset of `hay`, at `i * looks + k`: whether
/// body `k` matches a span that ends at offset `i` for a lookbehind, or one that
/// starts there for a lookahead. A lookbehind's pass runs forward and a lookahead's
/// backward over its reverse, each a body from every offset. A body's assertions are
/// of bodies before it, whose bits are set when its pass reads them.
fn lookBits(re: Regex, hay: Array<UInt8>) -> Array<Bool> {
    let n = re.looks.length
    let mut bits: Array<Bool> = []
    while bits.length < n * (hay.length + 1) {
        bits.push(false)
    }
    if n == 0 {
        return bits
    }
    // Each pass's scan holds the bits it reads, and each bit goes to both.
    let mut sf = newScan(re.fwd, 0, false, bits.copy())
    let mut sr = newScan(re.rev, 0, false, consume bits)
    let mut k = 0
    while k < n {
        let look = re.looks[k]
        let mut list: Array<Int64> = []
        let mut j = if look.regular { 0 } else { hay.length + 1 }
        while j <= hay.length {
            let i = if look.behind { j } else { hay.length - j }
            let mut found = false
            if look.behind {
                list = passStep(re.fwd, list, if j == 0 { 0 - 1 } else { Int64(hay[j - 1]) }, look.fwd, sf, i)
                found = listAccepts(re.fwd, list)
            } else {
                list = passStep(re.rev, list, if j == 0 { 0 - 1 } else { Int64(hay[i]) }, look.rev, sr, i)
                found = listAccepts(re.rev, list)
            }
            sf.bits[i * n + k] = found
            sr.bits[i * n + k] = found
            j = j + 1
        }
        k = k + 1
    }
    return consume sr.bits
}

/// [`nextMatch`] for a pattern with a lookaround: both passes step pcs, not states,
/// and each closure reads the bits at its offset.
fn lookMatch(re: Regex, hay: Array<UInt8>, from: Int64, se: modify Search) -> Option<Match> {
    if from > hay.length {
        return None
    }
    let mut list: Array<Int64> = []
    se.fwd.gen = se.fwd.gen + 1
    se.fwd.at = from
    addThread(re.fwd, list, se.fwd, re.fwd.start)
    dropAfterMatch(re.fwd, list)
    let first = if listAccepts(re.fwd, list) { from } else { 0 - 1 }
    let end = listEnd(re.fwd, hay, from, list, se.fwd, first)
    if end < 0 {
        return None
    }
    let mut back: Array<Int64> = []
    se.rev.gen = se.rev.gen + 1
    se.rev.at = end
    addThread(re.rev, back, se.rev, re.rev.start)
    return Some(Match { at: listStart(re.rev, hay, from, end, back, se.rev, end), end: end })
}

/// One search over one haystack: the forward and the backward lazy DFA, and for a
/// pattern with a backreference the backtracking search, which alone runs.
type Search = { fwd: Scan, rev: Scan, back: Back }

/// A search of `hay`, whose lookaround bits it reads first.
fn newSearch(re: Regex, hay: Array<UInt8>, cap: Int64) -> Search {
    let bits = lookBits(re, hay)
    let back = newBack(re, hay, if re.backtrack { bits.copy() } else { [] })
    return Search { fwd: newScan(re.fwd, cap, true, bits.copy()), rev: newScan(re.rev, cap, false, consume bits), back: back }
}

/// The steps one call of a backtracking search may take, and the steps it adds per
/// byte of the haystack.
let stepBase = 1000000
let stepPerByte = 1000

/// One backtracking search of a haystack: its steps against its budget, the group
/// spans and split marks of the path it walks, and the trail that undoes them.
type Back = {
    steps: Int64,
    budget: Int64,
    // `caps[2 * k - 2]` and `caps[2 * k - 1]` are where group `k` starts and ends on
    // the path, or -1.
    caps: Array<Int64>,
    // `mark[pc]` is the offset split `pc` is on the path at, or -1. A path that meets
    // a split again at that offset has looped without a byte, and fails, as the NFA
    // drops a pc it holds.
    mark: Array<Int64>,
    // The trail, a stack in three parallel arrays: a choice to resume at pc `x` and
    // offset `y`, the value `y` that slot `x` of `caps` or of `mark` held before the
    // path wrote it, or an atomic group's open.
    kind: Array<Int64>,
    x: Array<Int64>,
    y: Array<Int64>,
    // The bits of the regular lookaround bodies ([`lookBits`]).
    bits: Array<Bool>,
}

/// A trail entry: a choice to resume, the old value of a mark or of a span, or the
/// open of an atomic group, which bounds the choices its close drops.
let trailChoice = 0
let trailMark = 1
let trailCap = 2
let trailAtom = 3

/// A backtracking search of `hay` with no step taken, its assertions reading `bits`.
fn newBack(re: Regex, hay: Array<UInt8>, bits: consume Array<Bool>) -> Back {
    let mut mark: Array<Int64> = []
    let mut caps: Array<Int64> = []
    if re.backtrack {
        while mark.length < re.fwd.op.length {
            mark.push(0 - 1)
        }
        while caps.length < 2 * re.names.length {
            caps.push(0 - 1)
        }
    }
    return Back { steps: 0, budget: stepBase + stepPerByte * hay.length, caps: caps, mark: mark, kind: [], x: [], y: [], bits: bits }
}

fn trail(bt: modify Back, kind: Int64, x: Int64, y: Int64) {
    bt.kind.push(kind)
    bt.x.push(x)
    bt.y.push(y)
}

/// The length of the text group `a / 2` spans on the path, where `hay` holds that
/// text again from `i`, before `stop` unless it is -1, ASCII case folded for an odd
/// `a` of the backreference at `pc`; 0 for a group that has not closed or took no
/// part, and -1 where the text differs.
fn refLength(p: Program, pc: Int64, hay: Array<UInt8>, i: Int64, stop: Int64, caps: Array<Int64>) -> Int64 {
    let k = p.a[pc] / 2
    let fold = p.a[pc] % 2 == 1
    let s = caps[2 * k - 2]
    let e = caps[2 * k - 1]
    if s < 0 || e < s {
        return 0
    }
    let n = e - s
    if i + n > hay.length || stop >= 0 && i + n > stop {
        return 0 - 1
    }
    let mut j = 0
    while j < n {
        let x = Int64(hay[s + j])
        let y = Int64(hay[i + j])
        if x != y && !(fold && lowerAscii(x) == lowerAscii(y)) {
            return 0 - 1
        }
        j = j + 1
    }
    return n
}

/// The byte `c`, an ASCII capital as its small letter.
fn lowerAscii(c: Int64) -> Int64 {
    return if c >= 65 && c <= 90 { c + 32 } else { c }
}

/// Whether the assertion at `pc` holds at offset `i`: a regular body's bit, or else a
/// backtracking run of the body, from `i` for a lookahead and for a lookbehind from
/// each offset up to `i` that ends at `i`.
fn backHolds(re: Regex, pc: Int64, hay: Array<UInt8>, i: Int64, bt: modify Back) -> Bool {
    let k = re.fwd.a[pc]
    let look = re.looks[k / 2]
    let negate = k % 2 == 1
    if look.regular {
        return holds(re.fwd, pc, bt.bits, i)
    }
    if !look.behind {
        return (backRun(re, look.fwd, hay, i, 0 - 1, bt) >= 0) != negate
    }
    let mut j = i
    while j >= 0 {
        if backRun(re, look.fwd, hay, j, i, bt) >= 0 {
            return !negate
        }
        j = j - 1
    }
    return negate
}

/// The end of the first path from `pc0` at `at` that reaches a match, at `stop`
/// unless it is -1, in a backtracking search's order: operand `a` of a split before
/// `b`. Answers -1 where no path does or the steps pass the budget, which
/// `bt.steps` tells apart. After a match `bt.caps` holds the path's spans, and
/// otherwise the spans it had.
fn backRun(re: Regex, pc0: Int64, hay: Array<UInt8>, at: Int64, stop: Int64, bt: modify Back) -> Int64 {
    let p = re.fwd
    let base = bt.kind.length
    let mut pc = pc0
    let mut i = at
    let mut found = 0 - 1
    while bt.steps <= bt.budget {
        bt.steps = bt.steps + 1
        let op = p.op[pc]
        let mut on = true
        if op == opClass {
            on = i < hay.length && (stop < 0 || i < stop) && hasByte(p.cls[pc], Int64(hay[i]))
            pc = p.b[pc]
            i = i + 1
        } else if op == opSplit {
            on = bt.mark[pc] != i
            if on {
                trail(bt, trailMark, pc, bt.mark[pc])
                bt.mark[pc] = i
                trail(bt, trailChoice, p.b[pc], i)
                pc = p.a[pc]
            }
        } else if op == opSave {
            let slot = p.a[pc]
            trail(bt, trailCap, slot, bt.caps[slot])
            bt.caps[slot] = i
            pc = p.b[pc]
        } else if op == opAssert {
            on = backHolds(re, pc, hay, i, bt)
            pc = p.b[pc]
        } else if op == opBackref {
            let n = refLength(p, pc, hay, i, stop, bt.caps)
            on = n >= 0
            pc = p.b[pc]
            i = i + n
        } else if op == opAtomic {
            if p.a[pc] >= 0 {
                trail(bt, trailAtom, pc, i)
            } else {
                dropChoices(bt)
            }
            pc = p.b[pc]
        } else if stop < 0 || i == stop {
            found = i
            break
        } else {
            on = false
        }
        // A failed path goes back to its last choice, undoing what it wrote since.
        // `length > 0` repeats what `base >= 0` gives, which the traced walk of
        // `why --proofs` loses at the loop head: keep it, or whyproofs fails.
        while !on && bt.kind.length > 0 && bt.kind.length > base {
            let top = bt.kind.length - 1
            if bt.kind[top] == trailChoice {
                pc = bt.x[top]
                i = bt.y[top]
                on = true
            } else if bt.kind[top] == trailMark {
                bt.mark[bt.x[top]] = bt.y[top]
            } else if bt.kind[top] == trailCap {
                bt.caps[bt.x[top]] = bt.y[top]
            }
            bt.kind.pop()
            bt.x.pop()
            bt.y.pop()
        }
        if !on {
            break
        }
    }
    // The marks go back as they were; the spans of a match stay. `length > 0` as
    // above.
    while bt.kind.length > 0 && bt.kind.length > base {
        let top = bt.kind.length - 1
        if bt.kind[top] == trailMark {
            bt.mark[bt.x[top]] = bt.y[top]
        }
        bt.kind.pop()
        bt.x.pop()
        bt.y.pop()
    }
    return found
}

/// Drops the choices above the open of the innermost atomic group, and the open,
/// and keeps the marks and spans to undo. The run that reaches a close went through
/// its open, and backtracking past the open leaves the path through the close, so
/// the trail holds the open.
fn dropChoices(bt: modify Back) {
    let mut j = bt.kind.length - 1
    while j >= 0 && bt.kind[j] != trailAtom {
        j = j - 1
    }
    let mut to = if j < 0 { bt.kind.length } else { j }
    let mut k = to + 1
    while k < bt.kind.length {
        if bt.kind[k] != trailChoice {
            bt.kind[to] = bt.kind[k]
            bt.x[to] = bt.x[k]
            bt.y[to] = bt.y[k]
            to = to + 1
        }
        k = k + 1
    }
    while bt.kind.length > to {
        bt.kind.pop()
        bt.x.pop()
        bt.y.pop()
    }
}

/// [`nextMatch`] for a pattern the NFA cannot match: a backtracking run from each
/// offset in turn, the first that matches. It traps once the search's steps pass
/// its budget.
fn backMatch(re: Regex, hay: Array<UInt8>, from: Int64, bt: modify Back) -> Option<Match> {
    let start = patternStart(re)
    let mut k = 0
    while k < bt.caps.length {
        bt.caps[k] = 0 - 1
        k = k + 1
    }
    let mut at = from
    while at <= hay.length {
        let end = backRun(re, start, hay, at, 0 - 1, bt)
        if end >= 0 {
            return Some(Match { at: at, end: end })
        }
        trapPastBudget(bt)
        at = at + 1
    }
    return None
}

/// Traps once the steps of `bt` pass its budget.
fn trapPastBudget(bt: Back) {
    if bt.steps > bt.budget {
        panic("a backtracking pattern ran past its step budget of \{bt.budget} steps")
    }
}

/// Whether all of `hay` matches `pattern`, which the compiler has checked: `=~`
/// over a pattern only the backtracking search matches calls it. It traps past the
/// step budget, as a search does.
///
/// ponytail: compiles the pattern on every call. A memo in module state costs
/// every search of this module 22% more fuel (regexredux, 2026-11-28); a memo the
/// emitter owns, one slot per pattern, if a program matches often.
export fn matchesWhole(hay: String, pattern: String) -> Bool {
    let re = match compile(pattern) {
        Ok(r) => r,
        Err(why) => panic("`\{pattern}`: \{why}"),
    }
    let raw = bytes(hay)
    let mut bt = newBack(re, raw, lookBits(re, raw))
    let end = backRun(re, patternStart(re), raw, 0, raw.length, bt)
    trapPastBudget(bt)
    return end == raw.length
}

/// The leftmost-first match that starts at or after `from`, or `None`. A forward
/// pass finds its end and a backward pass its start.
fn nextMatch(re: Regex, hay: Array<UInt8>, from: Int64 where value >= 0, se: modify Search) -> Option<Match> {
    if re.backtrack {
        return backMatch(re, hay, from, se.back)
    }
    if re.fwd.looks > 0 {
        return lookMatch(re, hay, from, se)
    }
    let end = if from > hay.length { 0 - 1 } else { matchEnd(re.fwd, hay, from, se.fwd) }
    if end < 0 {
        return None
    }
    return Some(Match { at: matchStart(re.rev, hay, from, end, se.rev), end: end })
}

/// The first match at or after `from`, or `None`. It reads `hay` from `from` to the
/// match's end, and back to its start.
export fn find(re: Regex, hay: String, from: Int64) -> Option<Match> {
    let raw = bytes(hay)
    let mut se = newSearch(re, raw, dfaCap)
    return nextMatch(re, raw, from, se)
}
/// How many non-overlapping matches `re` has in `hay`: `aa` in `aaa` is one. An
/// empty match advances by one byte.
export fn countMatches(re: Regex, hay: String) -> Int64 {
    let raw = bytes(hay)
    let mut se = newSearch(re, raw, dfaCap)
    let mut n = 0
    let mut i = 0
    while let Some(m) = nextMatch(re, raw, i, se) {
        n = n + 1
        i = if m.end > m.at { m.end } else { m.at + 1 }
    }
    return n
}

/// `hay` with every non-overlapping match replaced by `with`, taken literally:
/// `$1` is two characters, not a group.
export fn replaceAll(re: Regex, hay: String, with: String) -> String {
    let raw = bytes(hay)
    let mut se = newSearch(re, raw, dfaCap)
    let mut out = ""
    let mut kept = 0
    let mut i = 0
    while let Some(m) = nextMatch(re, raw, i, se) {
        out = out + substring(hay, kept, m.at) + with
        kept = m.end
        i = if m.end > m.at { m.end } else { m.at + 1 }
    }
    return out + substring(hay, kept, raw.length)
}

/// A match and the span of each group of its pattern that took part in it.
export type Captures = {
    whole: Match,
    // The offsets group `k` starts and ends at, at `2 * k - 2` and `2 * k - 1`, or
    // -1 for a group that took no part. A group in a repeat spans its last turn.
    spans: Array<Int64>,
}

/// The first match at or after `from` and its groups, or `None`. The groups cost a
/// Thompson simulation over the match alone; a backtracking search has them.
export fn captures(re: Regex, hay: String, from: Int64) -> Option<Captures> {
    let raw = bytes(hay)
    let mut se = newSearch(re, raw, dfaCap)
    if let Some(m) = nextMatch(re, raw, from, se) {
        let spans = if re.backtrack { se.back.caps.copy() } else { spansOf(re, raw, m, se.fwd.bits) }
        return Some(Captures { whole: m, spans: spans })
    }
    return None
}

/// Group `k` of `c`: the whole match for 0, or `None` for a group that took no part
/// or that the pattern does not have.
export fn capture(c: Captures, k: Int64) -> Option<Match> {
    if k == 0 {
        return Some(c.whole)
    }
    if k < 1 || 2 * k > c.spans.length {
        return None
    }
    let at = c.spans[2 * k - 2]
    let end = c.spans[2 * k - 1]
    if at < 0 || end < 0 {
        return None
    }
    return Some(Match { at: at, end: end })
}

/// The group of `c` that `re` names `name`, or `None`.
export fn named(re: Regex, c: Captures, name: String) -> Option<Match> {
    let mut k = 0
    while k < re.names.length {
        if name != "" && re.names[k] == name {
            return capture(c, k + 1)
        }
        k = k + 1
    }
    return None
}

/// The pattern's own start: operand `a` of the split of the loop `build` puts first.
fn patternStart(re: Regex) -> Int64 {
    let p = re.fwd
    return if p.start >= 0 && p.start < p.a.length { p.a[p.start] } else { 0 - 1 }
}

/// The group spans of the match `m` of `re`: a Thompson simulation from its start
/// to its end whose threads carry their spans, in the order a search prefers them.
/// A thread that matches drops every thread after it.
fn spansOf(re: Regex, hay: Array<UInt8>, m: Match, bits: Array<Bool>) -> Array<Int64> {
    let p = re.fwd
    let mut none: Array<Int64> = []
    while none.length < 2 * re.names.length {
        none.push(0 - 1)
    }
    let mut mark: Array<Int64> = []
    while mark.length < p.op.length {
        mark.push(0)
    }
    let mut gen = 1
    let mut pcs: Array<Int64> = []
    let mut spans: Array<Array<Int64>> = []
    addSpans(p, pcs, spans, mark, gen, patternStart(re), none, m.at, bits)
    let mut best = joinHoles(none, [])
    let mut i = m.at
    while pcs.length > 0 {
        let mut k = 0
        while k < pcs.length && p.op[pcs[k]] != opMatch {
            k = k + 1
        }
        if k < pcs.length {
            best = joinHoles(spans[k], [])
            while pcs.length > k {
                pcs.pop()
                spans.pop()
            }
        }
        if i >= m.end || i >= hay.length {
            return best
        }
        gen = gen + 1
        let mut nextPcs: Array<Int64> = []
        let mut nextSpans: Array<Array<Int64>> = []
        let mut j = 0
        while j < pcs.length {
            let t = follow(p, pcs[j], Int64(hay[i]))
            if t >= 0 {
                addSpans(p, nextPcs, nextSpans, mark, gen, t, spans[j], i + 1, bits)
            }
            j = j + 1
        }
        pcs = nextPcs
        spans = nextSpans
        i = i + 1
    }
    return best
}

/// Adds `pc` at offset `i` and everything reachable from it without consuming, each
/// class or match pc with the spans `held` and the saves on its way.
fn addSpans(p: Program, pcs: modify Array<Int64>, spans: modify Array<Array<Int64>>, mark: modify Array<Int64>, gen: Int64, pc: Int64, held: Array<Int64>, i: Int64, bits: Array<Bool>) {
    let mut todo: Array<Int64> = [pc]
    let mut with: Array<Array<Int64>> = [joinHoles(held, [])]
    while todo.length > 0 && with.length > 0 {
        let q = todo[todo.length - 1]
        let mut sp = joinHoles(with[with.length - 1], [])
        todo.pop()
        with.pop()
        if q < 0 || q >= p.op.length || q >= mark.length || mark[q] == gen {
            continue
        }
        mark[q] = gen
        if p.op[q] == opSplit {
            todo.push(p.b[q])
            with.push(joinHoles(sp, []))
            todo.push(p.a[q])
            with.push(sp)
        } else if p.op[q] == opSave {
            let slot = p.a[q]
            if slot >= 0 && slot < sp.length {
                sp[slot] = i
            }
            todo.push(p.b[q])
            with.push(sp)
        } else if p.op[q] == opAssert {
            if holds(p, q, bits, i) {
                todo.push(p.b[q])
                with.push(sp)
            }
        } else {
            pcs.push(q)
            spans.push(sp)
        }
    }
}

test "a literal is found, counted and replaced" {
    let re = match compile("abc") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "abcabc"), 2)
    assertEq(countMatches(re, "xxabcyy"), 1)
    assertEq(countMatches(re, "ab"), 0)
    assertEq(replaceAll(re, "xabcy", "-"), "x-y")
    assertEq(replaceAll(re, "abcabc", ""), "")
}

test "alternation takes the first branch that matches" {
    let re = match compile("a|ab") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(re, "ab", "<>"), "<>b")
    let later = match compile("b|ab") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    // A match that starts earlier wins over an earlier branch.
    assertEq(replaceAll(later, "ab", "<>"), "<>")
}

test "a lazy repeat takes as little as it can" {
    let tag = match compile("<.*?>") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(tag, "<a><b>", "|"), "||")
    let plus = match compile("a+?") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(plus, "aaa"), 3)
    let opt = match compile("a??b") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(opt, "ab", "_"), "_")
    let count = match compile("a{2,3}?") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(count, "aaaa"), 2)
}

test "a class matches its members and a negated one everything else" {
    let re = match compile("[cgt]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "acgta"), 3)
    let neg = match compile("[^>]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(neg, "a>b>c"), 3)
    let range = match compile("[a-f]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(range, "abcxyzf"), 4)
}

test "a dot and a negated class match a whole character" {
    let dot = match compile(".") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(dot, "\u{e9}", "x"), "x")
    assertEq(countMatches(dot, "a\u{e9}\u{20ac}\u{1f600}"), 4)
    let neg = match compile("[^a]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(neg, "a\u{e9}b", "_"), "a__")
}

test "the three repeats" {
    let star = match compile("ab*c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(star, "ac"), 1)
    assertEq(countMatches(star, "abbbc"), 1)
    let plus = match compile("ab+c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(plus, "ac"), 0)
    assertEq(countMatches(plus, "abc"), 1)
    let opt = match compile("ab?c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(opt, "ac"), 1)
    assertEq(countMatches(opt, "abc"), 1)
    assertEq(countMatches(opt, "abbc"), 0)
}

test "a star is greedy" {
    let re = match compile("<[^>]*>") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(re, "a<bcd>e", "|"), "a|e")
    assertEq(replaceAll(re, "<>", "|"), "|")
    // Two tags, not one run across both, because `[^>]` cannot cross a `>`.
    assertEq(replaceAll(re, "<a><b>", "|"), "||")
}

test "a shorthand, a control escape and a dot mean what they mean after =~" {
    let re = match compile("\\d+|\\s|\\W|\\t|.") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "ab 42\r"), 5)
}

test "an escape is the byte after it, not the metacharacter" {
    let re = match compile("\\|[^|][^|]*\\|") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(re, "x|ab|y", "-"), "x-y")
}

test "an escape is a control, a code point, a line break or a quote" {
    let re = match compile("\\x41\\u{e9}\\cJ\\o{102}") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "xA\u{e9}\nBA\u{e9}\nB"), 2)
    let breaks = match compile("\\R") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(breaks, "a\r\nb\nc\rd"), 3)
    let quote = match compile("\\Q.*\\E+") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(quote, "a.**b.x", "-"), "a-b.x")
    let cls = match compile("[\\x{e9}\\h\\b]+") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(cls, "a\u{e9} \tb", "-"), "a-b")
}

test "an escape with no meaning is refused" {
    match compile("\\y") {
        Ok(r) => panic("an unknown escape compiled"),
        Err(w) => assert(w == "the escape `\\y` means nothing: a backslash makes only ASCII punctuation literal"),
    }
    match compile("\\b*") {
        Ok(r) => panic("a repeated boundary compiled"),
        Err(w) => assert(w == "a repeat after an assertion, which matches no character"),
    }
    match compile("(?=(a))") {
        Ok(r) => panic("a capture in a lookaround compiled"),
        Err(w) => assert(w == "a capturing group inside a lookaround: write `(?:..)`"),
    }
    match compile("\\x{110000}") {
        Ok(r) => panic("a code point past 10FFFF compiled"),
        Err(w) => assert(w == "a code point escape above `10FFFF` or in the surrogates `D800` to `DFFF`"),
    }
    match compile("[\\1]") {
        Ok(r) => panic("a backreference in a class compiled"),
        Err(w) => assert(w == "an anchor or a backreference (`\\1`) cannot stand inside a character class"),
    }
}

test "a class is a set of code points" {
    let vowels = match compile("[a-z&&[^aeiou]]+") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(vowels, "street", "-"), "-ee-")
    let posix = match compile("[[:upper:][:digit:]]+") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(posix, "aB1cD"), 2)
    let wide = match compile("[\\u{e0}-\\u{ff}]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(wide, "caf\u{e9}\u{20ac}", "_"), "caf_\u{20ac}")
    let rest = match compile("[\\w--\\d]+|[a-c~~b-d]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(rest, "ab12d", "."), ".12.")
}

test "a group names, folds or comments" {
    let date = match compile("(?<y>\\d{4})-(?:\\d\\d)(?#day follows)-(?P<d>\\d\\d)") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(date, "on 2026-11-27.", "D"), "on D.")
    let fold = match compile("a(?i)b|c|(?-i:d)") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(fold, "aB C D d"), 3)
    let dot = match compile("(?s:a.b)|a.c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(dot, "a\nb a\nc"), 1)
    match compile("(?<n>a)(?<n>b)") {
        Ok(r) => panic("a name twice compiled"),
        Err(w) => assert(w == "a group name that names two groups"),
    }
    let twice = match compile("(?<n>a){2}") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(twice, "aaa"), 1)
}

test "the patterns regex-redux counts" {
    let dna = "agggtaaacccagggtaaacttttaccctgg"
    let re = match compile("agggtaaa|tttaccct") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, dna), 3)
    let cls = match compile("agggtaa[cgt]|[acg]ttaccct") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(cls, "agggtaacXXcttaccct"), 2)
}

test "a group is a term the repeats apply to" {
    let re = match compile("(ab)+c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "ababc"), 1)
    assertEq(countMatches(re, "c"), 0)
    let alt = match compile("(a|b)c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(alt, "ac bc"), 2)
}

test "find says where, and searching from there finds the next" {
    let re = match compile("aa") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    if let Some(m) = find(re, "xxaayyaa", 0) {
        assertEq(m.at, 2)
        assertEq(m.end, 4)
    } else {
        panic("the first match is at 2")
    }
    if let Some(m) = find(re, "xxaayyaa", 4) {
        assertEq(m.at, 6)
    } else {
        panic("the second match is at 6")
    }
    if let Some(m) = find(re, "xxaayyaa", 7) {
        panic("there is no third match, got \{m.at}")
    }
}

test "a count repeats its term" {
    let re = match compile("a{2,3}") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "a"), 0)
    assertEq(countMatches(re, "aaaaa"), 2)
    let pair = match compile("(ab){2}x{0}y{1,}") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    if let Some(m) = find(pair, "ababyyy", 0) {
        assertEq(m.end, 7)
    } else {
        panic("no match")
    }
    assertEq(countMatches(pair, "abyy"), 0)
}

test "an escaped anchor is literal and the empty pattern matches the empty string" {
    let escaped = match compile("\\^a\\$") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(escaped, "a ^a$"), 1)
    let empty = match compile("") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(empty, "ab"), 3)
}

test "what it refuses, it refuses by name" {
    match compile("a(b") {
        Ok(r) => panic("an unbalanced group compiled"),
        Err(w) => assert(w == "a group with no closing `)`"),
    }
    match compile("[abc") {
        Ok(r) => panic("an unterminated class compiled"),
        Err(w) => assert(w == "a character class with no closing `]`"),
    }
    match compile("[]") {
        Ok(r) => panic("an empty class compiled"),
        Err(w) => assert(w == "a character class with no members"),
    }
    match compile("a{3,2}") {
        Ok(r) => panic("a count below its minimum compiled"),
        Err(w) => assert(w == "a counted repetition whose maximum is below its minimum"),
    }
    match compile("a{256}") {
        Ok(r) => panic("a count above 255 compiled"),
        Err(w) => assert(w == "a repetition count above 255"),
    }
    match compile("((a{99}){99}){2}") {
        Ok(r) => panic("a count past the budget compiled"),
        Err(w) => assert(w == "counted repetition that expands the pattern past 16384 terms"),
    }
    match compile("a*??") {
        Ok(r) => panic("a second lazy mark compiled"),
        Err(w) => assert(w == "a repeat (`*`, `+` or `?`) with no term before it"),
    }
    match compile("[z-a]") {
        Ok(r) => panic("a backwards range compiled"),
        Err(w) => assert(w == "a character range that runs backwards"),
    }
}

test "an anchor holds at the text's ends, or a line's under m" {
    let ends = match compile("^a|a$") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(ends, "aba\na", "_"), "_ba\n_")
    let lines = match compile("(?m)^a|a$") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(lines, "aba\na", "_"), "_b_\n_")
    let last = match compile("a\\Z") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(last, "a\na\n"), 1)
    // `^` is the text's start, so a search from an offset past it finds none.
    assertEq(spanText(find(ends, "ba", 1)), "1..2")
    let start = match compile("^b") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(spanText(find(start, "ab", 1)), "none")
}

test "a word boundary holds between a word character and another" {
    let word = match compile("\\bfoo\\b") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(word, "foo foobar (foo)"), 2)
    let inside = match compile("\\Bo") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(inside, "oo o", "0"), "o0 o")
    let starts = match compile("\\<\\w") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(starts, "ab cd-ef"), 3)
}

test "a lookaround tests the text beside a position and sees before from" {
    let behind = match compile("(?<=a)b") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(behind, "abcb", "x"), "axcb")
    assertEq(spanText(find(behind, "ab", 1)), "1..2")
    let ahead = match compile("\\w+(?=;)") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(spanText(find(ahead, "ab cd;", 0)), "3..5")
    let not = match compile("(?<!\\.)\\b[a-z]+(?!\\()") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(not, "a.b c(", "_"), "_.b c(")
    // A lookbehind whose body grows and holds a lookahead.
    let nested = match compile("(?<=^a+(?=b))b") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(spanText(find(nested, "aab", 0)), "2..3")
    assertEq(spanText(find(nested, "acb", 0)), "none")
    let group = match compile("(a)(?=b)") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    match captures(group, "ab", 0) {
        Some(c) => assertEq(spanText(capture(c, 1)), "0..1"),
        None => panic("no match"),
    }
}

/// `o` as `at..end`, or `none`.
fn spanText(o: Option<Match>) -> String {
    return match o {
        Some(m) => "\{m.at}..\{m.end}",
        None => "none",
    }
}

test "captures give each group's span, by number or by name" {
    let re = match compile("(?<key>[a-z]+)=(\\d+)(?:;(x))?") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    match captures(re, " ab=12 ", 0) {
        Some(c) => {
            assertEq(spanText(capture(c, 0)), "1..6")
            assertEq(spanText(capture(c, 1)), "1..3")
            assertEq(spanText(named(re, c, "key")), "1..3")
            assertEq(spanText(capture(c, 2)), "4..6")
            assertEq(spanText(capture(c, 3)), "none")
            assertEq(spanText(capture(c, 4)), "none")
            assertEq(spanText(named(re, c, "value")), "none")
        }
        None => panic("no match"),
    }
    match captures(re, "k=1;x", 0) {
        Some(c) => assertEq(spanText(capture(c, 3)), "4..5"),
        None => panic("no match"),
    }
}

test "a group in a repeat spans its last turn" {
    let re = match compile("(a|b)+(c){2}") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    match captures(re, "abcc", 0) {
        Some(c) => {
            assertEq(spanText(capture(c, 1)), "1..2")
            assertEq(spanText(capture(c, 2)), "3..4")
        }
        None => panic("no match"),
    }
    let lazy = match compile("(a+?)(a*)") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    match captures(lazy, "aaa", 0) {
        Some(c) => {
            assertEq(spanText(capture(c, 1)), "0..1")
            assertEq(spanText(capture(c, 2)), "1..3")
        }
        None => panic("no match"),
    }
}

/// A draw below `n` from the generator state `seed`, which it advances.
fn draw(seed: modify Int64, n: Int64) -> Int64 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    return (seed / 65536) % n
}

/// A pattern `compile` accepts, over the atoms the engines treat differently and the
/// assertions. Inside a lookaround, `look`, a group does not capture.
fn genPattern(seed: modify Int64, depth: Int64, look: Bool) -> String {
    let atoms = ["a", "b", "c", ".", "[ab]", "[^a]", "[a-c]", "\\|", "(\u{e9})", "(\u{20ac})"]
    let asserts = ["^", "$", "\\b", "\\B", "(?m)^", "(?m)$", "\\Z"]
    let opens = ["(?=", "(?!", "(?<=", "(?<!"]
    let suffixes = ["", "", "*", "+", "?", "*?", "+?", "??"]
    let mut out = ""
    let branches = 1 + draw(seed, 2)
    let mut b = 0
    while b < branches {
        if b > 0 {
            out = out + "|"
        }
        let terms = 1 + draw(seed, 3)
        let mut t = 0
        while t < terms {
            let pick = draw(seed, atoms.length + 3)
            if pick == atoms.length && depth > 0 {
                out = out + (if look { "(?:" } else { "(" }) + genPattern(seed, depth - 1, look) + ")" + suffixes[draw(seed, suffixes.length)]
            } else if pick == atoms.length + 1 && depth > 0 {
                out = out + opens[draw(seed, opens.length)] + genPattern(seed, depth - 1, true) + ")"
            } else if pick > atoms.length {
                out = out + asserts[draw(seed, asserts.length)]
            } else {
                out = out + atoms[pick % (if look { 8 } else { atoms.length })] + suffixes[draw(seed, suffixes.length)]
            }
            t = t + 1
        }
        b = b + 1
    }
    return out
}

/// Whether a walk of `re.fwd` from `pc` at `at` reaches a match, at `stop` unless it
/// is -1, deciding each assertion by [`lookAt`]: the oracle's own lookaround.
fn reaches(re: Regex, pc: Int64, hay: Array<UInt8>, at: Int64, stop: Int64) -> Bool {
    let p = re.fwd
    let width = hay.length + 1
    let mut seen: Array<Bool> = []
    while seen.length < p.op.length * width {
        seen.push(false)
    }
    let mut pcs: Array<Int64> = [pc]
    let mut ats: Array<Int64> = [at]
    while pcs.length > 0 {
        let q = pcs[pcs.length - 1]
        let i = ats[ats.length - 1]
        pcs.pop()
        ats.pop()
        if q < 0 || q >= p.op.length || i < 0 || i > hay.length || seen[q * width + i] {
            continue
        }
        seen[q * width + i] = true
        if p.op[q] == opMatch {
            if stop < 0 || i == stop {
                return true
            }
        } else if p.op[q] == opSplit {
            pcs.push(p.b[q])
            ats.push(i)
            pcs.push(p.a[q])
            ats.push(i)
        } else if p.op[q] == opSave {
            pcs.push(p.b[q])
            ats.push(i)
        } else if p.op[q] == opAssert {
            if lookAt(re, p.a[q] / 2, hay, i) != (p.a[q] % 2 == 1) {
                pcs.push(p.b[q])
                ats.push(i)
            }
        } else if i < hay.length && hasByte(p.cls[q], Int64(hay[i])) {
            pcs.push(p.b[q])
            ats.push(i + 1)
        }
    }
    return false
}

/// Whether lookaround body `k` of `re` holds at `at`: it matches from `at` on, or
/// for a lookbehind it matches a span from some offset up to `at`.
fn lookAt(re: Regex, k: Int64, hay: Array<UInt8>, at: Int64) -> Bool {
    let look = re.looks[k]
    if !look.behind {
        return reaches(re, look.fwd, hay, at, 0 - 1)
    }
    let mut j = 0
    while j <= at {
        if reaches(re, look.fwd, hay, j, at) {
            return true
        }
        j = j + 1
    }
    return false
}

/// The end of the match a backtracking search of `p` from the pc `pc` at `at`
/// prefers, or -1: operand `a` of a split before `b`. A pc it left at an offset
/// failed there, so it never returns to one.
fn backtrackAt(re: Regex, pc: Int64, hay: Array<UInt8>, at: Int64) -> Int64 {
    let p = re.fwd
    let width = hay.length + 1
    let mut seen: Array<Bool> = []
    while seen.length < p.op.length * width {
        seen.push(false)
    }
    let mut pcs: Array<Int64> = [pc]
    let mut ats: Array<Int64> = [at]
    while pcs.length > 0 {
        let q = pcs[pcs.length - 1]
        let i = ats[ats.length - 1]
        pcs.pop()
        ats.pop()
        if q < 0 || q >= p.op.length || i < 0 || i > hay.length || seen[q * width + i] {
            continue
        }
        seen[q * width + i] = true
        if p.op[q] == opMatch {
            return i
        }
        if p.op[q] == opSplit {
            pcs.push(p.b[q])
            ats.push(i)
            pcs.push(p.a[q])
            ats.push(i)
        } else if p.op[q] == opSave {
            pcs.push(p.b[q])
            ats.push(i)
        } else if p.op[q] == opAssert {
            if lookAt(re, p.a[q] / 2, hay, i) != (p.a[q] % 2 == 1) {
                pcs.push(p.b[q])
                ats.push(i)
            }
        } else if i < hay.length && hasByte(p.cls[q], Int64(hay[i])) {
            pcs.push(p.b[q])
            ats.push(i + 1)
        }
    }
    return 0 - 1
}

test "a search finds the match a backtracking search finds from each offset" {
    let pieces = ["a", "b", "c", "\u{e9}", "\u{e8}", "\u{20ac}", "|", "\n"]
    let mut seed = 7
    let mut round = 0
    while round < 300 {
        let pattern = genPattern(seed, 2, false)
        let re = match compile(pattern) {
            Ok(r) => r,
            Err(w) => panic("`\{pattern}`: \{w}"),
        }
        let mut hay = ""
        let len = draw(seed, 16)
        while hay.byteLength < len {
            hay = hay + pieces[draw(seed, pieces.length)]
        }
        let raw = bytes(hay)
        let first = patternStart(re)
        let mut ends: Array<Int64> = []
        let mut i = 0
        while i <= raw.length {
            ends.push(backtrackAt(re, first, raw, i))
            i = i + 1
        }
        // The whole table, the two fixed states alone, and one state more: the
        // last two fall back part way through a walk.
        let caps = [dfaCap, 0, re.fwd.classCount]
        let mut k = 0
        while k < caps.length {
            let mut sc = newSearch(re, raw, caps[k])
            let mut from = 0
            while from <= raw.length {
                let mut at = from
                while at <= raw.length && ends[at] < 0 {
                    at = at + 1
                }
                if let Some(m) = nextMatch(re, raw, from, sc) {
                    if at > raw.length || m.at != at || m.end != ends[at] {
                        panic("`\{pattern}` on `\{hay}` from \{from}: found \{m.at}..\{m.end}")
                    }
                } else {
                    if at <= raw.length {
                        panic("`\{pattern}` on `\{hay}` from \{from}: missed \{at}")
                    }
                }
                from = from + 1
            }
            k = k + 1
        }
        round = round + 1
    }
}

/// The offsets `spans` holds, joined by commas.
fn spansText(spans: Array<Int64>) -> String {
    let mut out = ""
    let mut i = 0
    while i < spans.length {
        out = out + "\{spans[i]},"
        i = i + 1
    }
    return out
}

/// The first match of `pattern` in `hay` from 0, as `at..end`, or "none".
fn firstMatch(pattern: String, hay: String) -> String {
    return match compile(pattern) {
        Ok(re) => spanText(find(re, hay, 0)),
        Err(w) => "refused: \{w}",
    }
}

test "a backreference matches its group's text again" {
    assertEq(firstMatch("(a|b)\\1", "xabbx"), "2..4")
    assertEq(firstMatch("(\\w+) \\1", "hello hello world"), "0..11")
    assertEq(firstMatch("(?<q>['\"]).*?\\k<q>", "say \"hi\" 'x'"), "4..8")
    assertEq(firstMatch("(?<q>a)\\k'q'\\k{q}(?P=q)", "aaaa"), "0..4")
    assertEq(firstMatch("(a)(b)\\g{-1}\\g1\\g{2}", "abbab"), "0..5")
    assertEq(firstMatch("(?i)(a)\\1", "aA"), "0..2")
    assertEq(firstMatch("(a)\\1", "aA"), "none")
    assertEq(firstMatch("\\2(a)(b)", "ab"), "0..2")
    assertEq(firstMatch("(a)|\\1b", "b"), "0..1")
    assertEq(firstMatch("(a\\1)", "a"), "0..1")
    assertEq(firstMatch("(a)(?=\\1)", "aa"), "0..1")
    assertEq(firstMatch("(\\w)(?!\\1)", "aab"), "1..2")
    assertEq(firstMatch("(a)b(?<=\\1b)", "ab"), "0..2")
    assertEq(firstMatch("(a)\\1", ""), "none")
    assertEq(firstMatch("(a)\\1", "a"), "none")
    assertEq(firstMatch("(a?)\\1", "a"), "0..0")
    assertEq(firstMatch("()\\1", ""), "0..0")
    assertEq(firstMatch("(a){0}\\1b", "b"), "0..1")
    assertEq(firstMatch("\\1", "a"), "refused: a backreference to a group the pattern does not have")
    assertEq(firstMatch("(a)\\k<n>", "a"), "refused: a backreference to a group the pattern does not have")
    assertEq(firstMatch("(a)\\g{-2}", "a"), "refused: a backreference to a group the pattern does not have")
    let re = match compile("(.)\\1") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "aabbcd"), 2)
    assertEq(replaceAll(re, "aabbcd", "-"), "--cd")
    let groups = match compile("(a+)(b)\\1") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    match captures(groups, "aaba", 0) {
        Some(c) => {
            assertEq(spanText(capture(c, 0)), "1..4")
            assertEq(spanText(capture(c, 1)), "1..2")
            assertEq(spanText(capture(c, 2)), "2..3")
        }
        None => panic("no match"),
    }
}

test "a backtracking search runs out of steps, not of time" {
    let raw = bytes("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    let regular = match compile("(a|a)*b") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assert(!regular.backtrack)
    assertEq(spanText(find(regular, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0)), "none")
    let re = match compile("(a|a)*b\\1") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assert(re.backtrack)
    let mut bt = newBack(re, raw, lookBits(re, raw))
    assertEq(bt.budget, stepBase + stepPerByte * 30)
    assertEq(backRun(re, patternStart(re), raw, 0, 0 - 1, bt), 0 - 1)
    assert(bt.steps > bt.budget)
}

/// The oracle's backtracking search: the end of the first path from `pc` at `i`
/// that matches, at `stop` unless it is -1, or that reaches the close `until` of an
/// atomic group unless it is -1; -1 for none. It recurses, with the spans `caps` and
/// the splits `path` met at `i` since the last byte, which a path that ends keeps
/// and a failed one restores. It reads every assertion by a run of its body.
fn oracleRun(re: Regex, pc: Int64, hay: Array<UInt8>, i: Int64, stop: Int64, until: Int64, caps: modify Array<Int64>, path: modify Array<Int64>) -> Int64 {
    let p = re.fwd
    let op = p.op[pc]
    if pc == until {
        return i
    }
    let caps0 = caps.copy()
    let path0 = path.copy()
    let mut r = 0 - 1
    if op == opClass {
        if i < hay.length && (stop < 0 || i < stop) && hasByte(p.cls[pc], Int64(hay[i])) {
            path = []
            r = oracleRun(re, p.b[pc], hay, i + 1, stop, until, caps, path)
        }
    } else if op == opSplit {
        if !holdsPc(path, pc) {
            path.push(pc)
            r = oracleRun(re, p.a[pc], hay, i, stop, until, caps, path)
            if r < 0 {
                caps = caps0.copy()
                path = path0.copy()
                path.push(pc)
                r = oracleRun(re, p.b[pc], hay, i, stop, until, caps, path)
            }
        }
    } else if op == opSave {
        caps[p.a[pc]] = i
        r = oracleRun(re, p.b[pc], hay, i, stop, until, caps, path)
    } else if op == opAssert {
        let look = re.looks[p.a[pc] / 2]
        let mut found = false
        let mut j = i
        while !found && j >= (if look.behind { 0 } else { i }) {
            let mut c = caps.copy()
            let mut seen: Array<Int64> = []
            found = oracleRun(re, look.fwd, hay, j, if look.behind { i } else { 0 - 1 }, 0 - 1, c, seen) >= 0
            j = j - 1
        }
        if found != (p.a[pc] % 2 == 1) {
            r = oracleRun(re, p.b[pc], hay, i, stop, until, caps, path)
        }
    } else if op == opBackref {
        let k = p.a[pc] / 2
        let s = caps[2 * k - 2]
        let e = caps[2 * k - 1]
        let n = if s < 0 || e < s { 0 } else { e - s }
        let end = if stop < 0 { hay.length } else { stop }
        let mut same = i + n <= end
        let mut j = 0
        while same && j < n {
            let x = Int64(hay[s + j])
            let y = Int64(hay[i + j])
            let folded = p.a[pc] % 2 == 1 && (x | 32) == (y | 32) && (x | 32) >= 97 && (x | 32) <= 122
            same = x == y || folded
            j = j + 1
        }
        if same {
            if n > 0 {
                path = []
            }
            r = oracleRun(re, p.b[pc], hay, i + n, stop, until, caps, path)
        }
    } else if op == opAtomic {
        // The body's first way to its close, and the rest from there with no other.
        let at = oracleRun(re, p.b[pc], hay, i, stop, p.a[pc], caps, path)
        if at >= 0 {
            r = oracleRun(re, p.b[p.a[pc]], hay, at, stop, until, caps, path)
        }
    } else if stop < 0 || i == stop {
        r = i
    }
    if r < 0 {
        caps = caps0
        path = path0
    }
    return r
}

/// A pattern with a backreference to a group of [`genPattern`], before it, after
/// it, repeated, folded, relative, or inside a lookaround.
fn genBackPattern(seed: modify Int64) -> String {
    let refs = ["\\1", "\\1*", "(?:\\1|b)", "(?=\\1)", "(?!\\1)", "(?<=\\1)", "(?<!\\1.)", "(?i:\\1)", "\\g{-1}", "\\1+?"]
    let group = "(" + genPattern(seed, 2, false) + ")"
    let r = refs[draw(seed, refs.length)]
    let tail = genPattern(seed, 1, false)
    return if draw(seed, 4) == 0 { refs[draw(seed, 8)] + group + tail } else { group + tail + r }
}

/// A pattern with an atomic group or a possessive repeat over [`genPattern`]'s
/// terms, in a lookaround, or around a backreference.
fn genAtomPattern(seed: modify Int64) -> String {
    let marks = ["*+", "++", "?+", "{1,2}+", "{2,}+"]
    let head = genPattern(seed, 1, false)
    let body = genPattern(seed, 2, false)
    let tail = genPattern(seed, 1, false)
    let pick = draw(seed, 4)
    if pick == 0 {
        return head + "(?>" + body + ")" + tail
    }
    if pick == 1 {
        return head + "(" + body + ")" + marks[draw(seed, marks.length)] + tail
    }
    if pick == 2 {
        return head + "(?" + (if draw(seed, 2) == 0 { "=" } else { "<!" }) + "(?>" + genPattern(seed, 1, true) + ")a*+)" + tail
    }
    return "(" + body + ")" + "(?>\\1|" + tail + ")+"
}

/// The match of `re` from each offset of `hay` with its groups' spans, as the
/// oracle finds it and as the backtracking search finds it, in turn.
fn backVerdicts(re: Regex, hay: String) -> Array<String> {
    let raw = bytes(hay)
    let mut bt = newBack(re, raw, lookBits(re, raw))
    let mut out: Array<String> = []
    let mut from = 0
    while from <= raw.length {
        let mut want = "none"
        let mut at = from
        while at <= raw.length && want == "none" {
            let mut caps: Array<Int64> = []
            while caps.length < 2 * re.names.length {
                caps.push(0 - 1)
            }
            let mut seen: Array<Int64> = []
            let end = oracleRun(re, patternStart(re), raw, at, 0 - 1, 0 - 1, caps, seen)
            if end >= 0 {
                want = "\{at}..\{end} \{spansText(caps)}"
            }
            at = at + 1
        }
        let got = match backMatch(re, raw, from, bt) {
            Some(m) => "\{m.at}..\{m.end} \{spansText(bt.caps)}",
            None => "none",
        }
        out.push(want)
        out.push(got)
        from = from + 1
    }
    return out
}

test "a whole match backtracks where the pattern needs it" {
    assert(matchesWhole("ab-ab", "(\\w+)-\\1"))
    assert(!matchesWhole("ab-abc", "(\\w+)-\\1"))
    assert(!matchesWhole("ab", "(?>a|ab)"))
    assert(matchesWhole("", "(a?)\\1"))
    assert(matchesWhole("aa", "(a?)\\1"))
    assert(!matchesWhole("a", "(a)\\1"))
}

test "an atomic group and a possessive repeat keep what they took" {
    assertEq(firstMatch("a*+a", "aaa"), "none")
    assertEq(firstMatch("a*a", "aaa"), "0..3")
    assertEq(firstMatch("(?>a+)b", "aaab"), "0..4")
    assertEq(firstMatch("(?>a|ab)c", "abc"), "none")
    assertEq(firstMatch("(?:a|ab)c", "abc"), "0..3")
    assertEq(firstMatch("a++b", "aab"), "0..3")
    assertEq(firstMatch("a?+a", "a"), "none")
    assertEq(firstMatch("a{1,3}+a", "aaaa"), "0..4")
    assertEq(firstMatch("a{1,3}+a", "aaa"), "none")
    assertEq(firstMatch("x(?=a*+b)", "xaab"), "0..1")
    assertEq(firstMatch("x(?=a*+a)", "xaa"), "none")
    assertEq(firstMatch("(?>)", ""), "0..0")
    assertEq(firstMatch("(?>(a))\\1", "aa"), "0..2")
    let re = match compile("[a-z]++,") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assert(re.backtrack)
    assertEq(countMatches(re, "ab,c,d"), 2)
}

test "a backtracking search finds the match a recursive oracle finds" {
    let pieces = ["a", "b", "ab", "A", "\u{e9}", "|", "\n"]
    let mut seed = 11
    let mut round = 0
    let mut verdicts = 0
    while round < 600 {
        let pattern = if round % 2 == 0 { genBackPattern(seed) } else { genAtomPattern(seed) }
        let re = match compile(pattern) {
            Ok(r) => r,
            Err(w) => panic("`\{pattern}`: \{w}"),
        }
        assert(re.backtrack)
        let mut hay = ""
        let len = draw(seed, 10)
        while hay.byteLength < len {
            hay = hay + pieces[draw(seed, pieces.length)]
        }
        let v = backVerdicts(re, hay)
        let mut k = 0
        while k + 1 < v.length {
            if v[k] != v[k + 1] {
                panic("`\{pattern}` on `\{hay}` from \{k / 2}: oracle \{v[k]}, search \{v[k + 1]}")
            }
            verdicts = verdicts + 1
            k = k + 2
        }
        round = round + 1
    }
    assert(verdicts > 3000)
}

test "a backtracking search of a regular pattern finds what the NFA finds" {
    let pieces = ["a", "b", "c", "\u{e9}", "\u{20ac}", "|", "\n"]
    let mut seed = 5
    let mut round = 0
    while round < 300 {
        let pattern = genPattern(seed, 2, false)
        let re = match compile(pattern) {
            Ok(r) => r,
            Err(w) => panic("`\{pattern}`: \{w}"),
        }
        let back = Regex { fwd: re.fwd.copy(), rev: re.rev.copy(), names: re.names.copy(), looks: re.looks.copy(), backtrack: true }
        let mut hay = ""
        let len = draw(seed, 14)
        while hay.byteLength < len {
            hay = hay + pieces[draw(seed, pieces.length)]
        }
        let mut from = 0
        while from <= hay.byteLength {
            let want = match captures(re, hay, from) {
                Some(c) => "\{c.whole.at}..\{c.whole.end} \{spansText(c.spans)}",
                None => "none",
            }
            let got = match captures(back, hay, from) {
                Some(c) => "\{c.whole.at}..\{c.whole.end} \{spansText(c.spans)}",
                None => "none",
            }
            if want != got {
                panic("`\{pattern}` on `\{hay}` from \{from}: NFA \{want}, backtracking \{got}")
            }
            from = from + 1
        }
        round = round + 1
    }
}
