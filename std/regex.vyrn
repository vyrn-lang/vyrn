/// std/regex: a regular expression that searches, counts and replaces.
///
/// `=~` only answers whether a whole string matches a constant pattern. The walk
/// is Vyrn, not a builtin, so every engine runs one source and agrees on offsets
/// and counts.
///
/// Supports literals, `.`, classes (`[abc]`, `[a-z]`, `[^>]`), alternation,
/// grouping, `*` `+` `?`, and `\` escapes. A Thompson NFA with no backtracking,
/// so the time is linear in the pattern size times the input for every pattern.
/// A search runs it as a lazy DFA: one table read per byte.
/// Refuses anchors, non-greedy repeats and counted repetition. It has no
/// backreferences or lookaround: `\1` is the byte `1`.
///
/// Leftmost-longest (POSIX): `a|ab` against `ab` matches `ab`, where a
/// backtracking engine answers `a`.
///
/// Offsets are bytes, and every match starts and ends on a character boundary:
/// `.` and a negated class match one whole UTF-8 character. A class that lists
/// a non-ASCII character is a set of its bytes.

import { substring } from "std/strings"

// A Thompson NFA as four parallel arrays: one instruction is one index into
// `op`/`a`/`b`/`cls`.

/// `op[i]` is a byte-class test: `cls[i]` is the class, `b[i]` the next pc.
/// `a[i]` is the next pc after a UTF-8 lead byte (0xC0 and up), or -1 when a
/// lead byte goes to `b[i]` too.
let opClass = 0

/// `op[i]` is a fork: `a[i]` and `b[i]` are both next pcs, tried as one set.
let opSplit = 1

/// `op[i]` accepts.
let opMatch = 2

/// A set of bytes: byte `c` is in it when bit `c % 64` of word `c / 64` is set.
///
/// Four words and not an array, so a membership test reads no array and has no
/// bounds to check; and one per instruction, so the class of instruction `pc`
/// is `cls[pc]`, in bounds wherever `op[pc]` is.
type ByteSet = { w0: UInt64, w1: UInt64, w2: UInt64, w3: UInt64 }

export type Regex = {
    op: Array<Int64>,
    a: Array<Int64>,
    b: Array<Int64>,
    cls: Array<ByteSet>,
    start: Int64,
    // `classOf[c]` is byte `c`'s class, 0 to `classCount - 1`: two bytes in one
    // class take the same step from every set of pcs. The class of `c` is at
    // most `c`, so a `UInt8` holds it.
    classOf: Array<UInt8>,
    classCount: Int64,
}

/// One match: a half-open byte range of the haystack.
export type Match = { at: Int64, end: Int64 }

fn noBytes() -> ByteSet {
    return ByteSet { w0: 0, w1: 0, w2: 0, w3: 0 }
}

/// `c` is a byte, 0 to 255.
fn addByte(s: modify ByteSet, c: Int64) {
    let bit = UInt64(1) << UInt64(c & 63)
    if c < 64 {
        s.w0 = s.w0 | bit
    } else if c < 128 {
        s.w1 = s.w1 | bit
    } else if c < 192 {
        s.w2 = s.w2 | bit
    } else {
        s.w3 = s.w3 | bit
    }
}

/// `c` is a byte, 0 to 255.
fn hasByte(s: ByteSet, c: Int64) -> Bool {
    let w = if c < 64 { s.w0 } else if c < 128 { s.w1 } else if c < 192 { s.w2 } else { s.w3 }
    return ((w >> UInt64(c & 63)) & 1) != 0
}

// Recursive descent that emits as it goes. Each level answers a fragment: its
// start pc and the operand slots that still need an exit patched in. A hole is
// `pc * 2 + which`, `which` being 0 for `a` and 1 for `b`.

type Frag = { start: Int64, holes: Array<Int64> }

type Builder = {
    op: Array<Int64>,
    a: Array<Int64>,
    b: Array<Int64>,
    cls: Array<ByteSet>,
    pat: Array<UInt8>,
    at: Int64,
    err: String,
}

fn emit(bd: modify Builder, o: Int64, x: Int64, y: Int64, s: ByteSet) -> Int64 {
    let pc = bd.op.length
    bd.op.push(o)
    bd.a.push(x)
    bd.b.push(y)
    bd.cls.push(s)
    return pc
}

fn patch(bd: modify Builder, holes: Array<Int64>, target: Int64) {
    let mut i = 0
    while i < holes.length {
        let pc = holes[i] / 2
        if holes[i] % 2 == 0 {
            bd.a[pc] = target
        } else {
            bd.b[pc] = target
        }
        i = i + 1
    }
}

fn joinHoles(x: Array<Int64>, y: Array<Int64>) -> Array<Int64> {
    let mut out: Array<Int64> = []
    let mut i = 0
    while i < x.length {
        out.push(x[i])
        i = i + 1
    }
    let mut j = 0
    while j < y.length {
        out.push(y[j])
        j = j + 1
    }
    return out
}

fn peek(bd: Builder) -> Int64 {
    if bd.at >= bd.pat.length {
        return 0 - 1
    }
    return Int64(bd.pat[bd.at])
}

/// `[...]`, with the `[` consumed.
fn bracketClass(bd: modify Builder) -> ByteSet {
    let mut k = noBytes()
    let mut negate = false
    if peek(bd) == '^' {
        negate = true
        bd.at = bd.at + 1
    }
    let mut any = false
    // A `]` first is a literal `]`.
    while bd.at < bd.pat.length {
        let c = Int64(bd.pat[bd.at])
        if c == ']' && any {
            bd.at = bd.at + 1
            if negate {
                return ByteSet { w0: ~k.w0, w1: ~k.w1, w2: ~k.w2, w3: ~k.w3 }
            }
            return k
        }
        bd.at = bd.at + 1
        let mut lo = c
        if c == 92 {
            if bd.at >= bd.pat.length {
                bd.err = "a backslash at the end of a character class"
                return k
            }
            lo = Int64(bd.pat[bd.at])
            bd.at = bd.at + 1
        }
        // `a-z`, but a `-` last in the class is a literal `-`.
        if peek(bd) == '-' && bd.at + 1 < bd.pat.length && Int64(bd.pat[bd.at + 1]) != ']' {
            bd.at = bd.at + 1
            let mut hi = Int64(bd.pat[bd.at])
            bd.at = bd.at + 1
            if hi == 92 && bd.at < bd.pat.length {
                hi = Int64(bd.pat[bd.at])
                bd.at = bd.at + 1
            }
            if hi < lo {
                bd.err = "a character range that runs backwards"
                return k
            }
            let mut x = lo
            while x <= hi {
                addByte(k, x)
                x = x + 1
            }
        } else {
            addByte(k, lo)
        }
        any = true
    }
    bd.err = "a character class with no closing `]`"
    return k
}

fn parseAtom(bd: modify Builder) -> Frag {
    let c = peek(bd)
    if c < 0 {
        bd.err = "a pattern that ends where a term was expected"
        return Frag { start: 0, holes: [] }
    }
    if c == '(' {
        bd.at = bd.at + 1
        let inner = parseAlt(bd)
        if peek(bd) != ')' {
            bd.err = "a group with no closing `)`"
            return inner
        }
        bd.at = bd.at + 1
        return inner
    }
    if c == '^' || c == '$' {
        bd.err = "anchors (`^` and `$`) are not supported"
        bd.at = bd.at + 1
        return Frag { start: 0, holes: [] }
    }
    bd.at = bd.at + 1
    let all: UInt64 = 18446744073709551615
    let mut k = noBytes()
    if c == '[' {
        k = bracketClass(bd)
    } else if c == '.' {
        // Every byte but `\n`.
        k = ByteSet { w0: ~(UInt64(1) << 10), w1: all, w2: all, w3: all }
    } else if c == 92 {
        if bd.at >= bd.pat.length {
            bd.err = "a backslash at the end of the pattern"
            return Frag { start: 0, holes: [] }
        }
        addByte(k, Int64(bd.pat[bd.at]))
        bd.at = bd.at + 1
    } else {
        addByte(k, c)
    }
    let pc = emit(bd, opClass, 0 - 1, 0, k)
    // `.` and a negated class hold every byte from 0x80 up, and they match a
    // whole character: a byte of the class below 0x80, or a lead byte and then
    // every continuation byte after it. A `String` is valid UTF-8, so the
    // longest match takes exactly the character's bytes. A byte alone would
    // let a match end inside a character, and cutting there traps.
    if k.w2 != all || k.w3 != all {
        return Frag { start: pc, holes: [pc * 2 + 1] }
    }
    let mut lead = ByteSet { w0: k.w0, w1: k.w1, w2: 0, w3: 0 }
    let mut x = 194
    while x <= 244 {
        addByte(lead, x)
        x = x + 1
    }
    bd.cls[pc] = lead
    let cont = emit(bd, opClass, 0 - 1, 0, ByteSet { w0: 0, w1: 0, w2: all, w3: 0 })
    let sp = emit(bd, opSplit, cont, 0, noBytes())
    bd.a[pc] = cont
    bd.b[cont] = sp
    return Frag { start: pc, holes: [pc * 2 + 1, sp * 2 + 1] }
}

fn parseRepeat(bd: modify Builder) -> Frag {
    let mut f = parseAtom(bd)
    while bd.err.byteLength == 0 {
        let c = peek(bd)
        if c == '*' {
            bd.at = bd.at + 1
            if peek(bd) == '?' {
                bd.err = "non-greedy repetition (`*?`) is not supported"
                return f
            }
            // Greedy: the split's first operand enters the body, which loops
            // back to the split.
            let sp = emit(bd, opSplit, f.start, 0, noBytes())
            patch(bd, f.holes, sp)
            f = Frag { start: sp, holes: [sp * 2 + 1] }
        } else if c == '+' {
            bd.at = bd.at + 1
            if peek(bd) == '?' {
                bd.err = "non-greedy repetition (`+?`) is not supported"
                return f
            }
            let sp = emit(bd, opSplit, f.start, 0, noBytes())
            patch(bd, f.holes, sp)
            f = Frag { start: f.start, holes: [sp * 2 + 1] }
        } else if c == '?' {
            bd.at = bd.at + 1
            let sp = emit(bd, opSplit, f.start, 0, noBytes())
            f = Frag { start: sp, holes: joinHoles(f.holes, [sp * 2 + 1]) }
        } else if c == '{' {
            bd.err = "counted repetition (`{m,n}`) is not supported"
            return f
        } else {
            return f
        }
    }
    return f
}

fn parseConcat(bd: modify Builder) -> Frag {
    let c = peek(bd)
    if c < 0 || c == '|' || c == ')' {
        // The empty branch, as in `(a|)`: a split with both edges dangling.
        let sp = emit(bd, opSplit, 0, 0, noBytes())
        return Frag { start: sp, holes: [sp * 2, sp * 2 + 1] }
    }
    let mut f = parseRepeat(bd)
    while bd.err.byteLength == 0 {
        let n = peek(bd)
        if n < 0 || n == '|' || n == ')' {
            return f
        }
        let g = parseRepeat(bd)
        patch(bd, f.holes, g.start)
        f = Frag { start: f.start, holes: consume g.holes }
    }
    return f
}

fn parseAlt(bd: modify Builder) -> Frag {
    let mut f = parseConcat(bd)
    while bd.err.byteLength == 0 && peek(bd) == '|' {
        bd.at = bd.at + 1
        let g = parseConcat(bd)
        let sp = emit(bd, opSplit, f.start, g.start, noBytes())
        f = Frag { start: sp, holes: joinHoles(f.holes, g.holes) }
    }
    return f
}

/// Each byte's class: a class is a run of bytes that no instruction's class cuts.
///
/// A lead-byte edge needs no cut of its own at 192: its class holds only bytes
/// below 0x80 and 194 to 244, so every run it holds lies on one side of 192.
fn byteClasses(bd: Builder) -> Array<UInt8> {
    let mut of: Array<UInt8> = [0]
    let mut c = 1
    while c < 256 {
        let mut cut = false
        let mut pc = 0
        while pc < bd.cls.length && !cut {
            cut = hasByte(bd.cls[pc], c) != hasByte(bd.cls[pc], c - 1)
            pc = pc + 1
        }
        of.push(if cut { of[c - 1] + 1 } else { of[c - 1] })
        c = c + 1
    }
    return of
}

/// Compiles `pattern`, or says what is wrong with it. Compile once and search
/// often: the whole cost of a pattern is paid here.
export fn compile(pattern: String) -> Result<Regex, String> {
    let mut bd = Builder {
        op: [],
        a: [],
        b: [],
        cls: [],
        pat: bytes(pattern),
        at: 0,
        err: "",
    }
    if bd.pat.length == 0 {
        return Err("an empty pattern")
    }
    let f = parseAlt(bd)
    if bd.err.byteLength > 0 {
        return Err(bd.err.copy())
    }
    if bd.at < bd.pat.length {
        // The only way out of `parseAlt` with input left is an unbalanced `)`.
        return Err("a `)` with no `(` before it")
    }
    let m = emit(bd, opMatch, 0, 0, noBytes())
    patch(bd, f.holes, m)
    // Read the classes before the builder gives its arrays up, so nothing is
    // copied.
    let classOf = byteClasses(bd)
    return Ok(Regex {
        op: consume bd.op,
        a: consume bd.a,
        b: consume bd.b,
        cls: consume bd.cls,
        start: f.start,
        classCount: Int64(classOf[255]) + 1,
        classOf: classOf,
    })
}

// A Thompson simulation: one set of live pcs, stepped one input byte at a time.
// The lazy DFA below caches those sets as states, and falls back to the
// simulation when its table is full.

/// The pc after instruction `pc` takes byte `c`, or -1 when it is not a class
/// that holds `c`.
fn follow(re: Regex, pc: Int64, c: Int64) -> Int64 {
    if re.op[pc] != opClass || !hasByte(re.cls[pc], c) {
        return 0 - 1
    }
    return if c >= 192 && re.a[pc] >= 0 { re.a[pc] } else { re.b[pc] }
}

/// Adds `pc` and everything reachable from it without consuming, marking each
/// with `sc.gen`.
fn addThread(re: Regex, list: modify Array<Int64>, sc: modify Scan, pc: Int64) {
    let mut stack: Array<Int64> = [pc]
    while stack.length > 0 {
        let p = stack[stack.length - 1]
        stack.pop()
        if p < 0 || p >= re.op.length {
            continue
        }
        if sc.mark[p] == sc.gen {
            continue
        }
        sc.mark[p] = sc.gen
        if re.op[p] == opSplit {
            // `b` first so `a` pops first: that makes `*` greedy.
            stack.push(re.b[p])
            stack.push(re.a[p])
        } else {
            list.push(p)
        }
    }
}

/// The end of the longest match that starts exactly at `at`, or -1 for no match.
fn nfaMatchAt(re: Regex, hay: Array<UInt8>, at: Int64, sc: modify Scan) -> Int64 {
    let mut clist: Array<Int64> = []
    sc.gen = sc.gen + 1
    addThread(re, clist, sc, re.start)
    let mut best = 0 - 1
    let mut i = at
    while clist.length > 0 {
        // An accept here is a candidate; leftmost-longest keeps looking.
        let mut k = 0
        while k < clist.length {
            if re.op[clist[k]] == opMatch {
                best = i
                k = clist.length
            } else {
                k = k + 1
            }
        }
        if i >= hay.length {
            return best
        }
        let c = Int64(hay[i])
        let mut nlist: Array<Int64> = []
        sc.gen = sc.gen + 1
        let mut j = 0
        while j < clist.length {
            addThread(re, nlist, sc, follow(re, clist[j], c))
            j = j + 1
        }
        clist = nlist
        i = i + 1
    }
    return best
}

/// Table entries one search may add beyond its first two states: 2 MB.
let dfaCap = 262144

/// One search's lazy DFA, and the marks both engines build pc sets with.
type Scan = {
    // `sets[s]` holds state `s`'s class and match pcs, ascending. State 0 is
    // the empty set, where every match has ended; state 1 is the start.
    sets: Array<Array<Int64>>,
    ids: Map<String, Int64>,
    accepts: Array<Bool>,
    // `next[s * classCount + k]` is the state after a byte of class `k`, or -1
    // until a search first takes that edge.
    next: Array<Int64>,
    cap: Int64,
    mark: Array<Int64>,
    gen: Int64,
}

/// The state of the class and match pcs marked with `sc.gen`, added if it is
/// new, or -1 when a new state would pass the cap.
fn intern(re: Regex, sc: modify Scan) -> Int64 {
    let mut set: Array<Int64> = []
    let mut key = ""
    let mut accepts = false
    let mut pc = 0
    while pc < re.op.length {
        if sc.mark[pc] == sc.gen && re.op[pc] != opSplit {
            set.push(pc)
            key = key + "\{pc},"
            accepts = accepts || re.op[pc] == opMatch
        }
        pc = pc + 1
    }
    if let Some(id) = sc.ids[key] {
        return id
    }
    if sc.next.length + re.classCount > sc.cap {
        return 0 - 1
    }
    let id = sc.sets.length
    sc.ids[key] = id
    sc.sets.push(set)
    if id < sc.accepts.length {
        sc.accepts[id] = accepts
    } else {
        sc.accepts.push(accepts)
    }
    let mut k = 0
    while k < re.classCount {
        sc.next.push(0 - 1)
        k = k + 1
    }
    return id
}

/// A search with no edges built, which may add `cap` table entries.
fn newScan(re: Regex, cap: Int64) -> Scan {
    let mut mark: Array<Int64> = []
    let mut i = 0
    while i < re.op.length {
        mark.push(0)
        i = i + 1
    }
    // `accepts` holds the slots of states 0 and 1 before `intern` fills
    // them, so a search reads the start state's with no check.
    let mut sc = Scan { sets: [], ids: [:], accepts: [false, false], next: [], cap: 2 * re.classCount + cap, mark: mark, gen: 1 }
    intern(re, sc)
    let mut scratch: Array<Int64> = []
    sc.gen = 2
    addThread(re, scratch, sc, re.start)
    intern(re, sc)
    return sc
}

/// The leftmost-longest match that starts at or after `from`, or `None`.
fn nextMatch(re: Regex, hay: Array<UInt8>, from: Int64, sc: modify Scan) -> Option<Match> {
    let mut at = from
    while at <= hay.length {
        let mut s = 1
        let mut best = if sc.accepts[1] { at } else { 0 - 1 }
        let mut i = at
        while i < hay.length {
            let c = Int64(hay[i])
            let edge = s * re.classCount + Int64(re.classOf[c])
            let mut t = sc.next[edge]
            if t < 0 {
                sc.gen = sc.gen + 1
                let mut scratch: Array<Int64> = []
                let mut j = 0
                while j < sc.sets[s].length {
                    let next = follow(re, sc.sets[s][j], c)
                    addThread(re, scratch, sc, next)
                    j = j + 1
                }
                t = intern(re, sc)
                if t < 0 {
                    best = nfaMatchAt(re, hay, at, sc)
                    break
                }
                sc.next[edge] = t
            }
            if t == 0 {
                break
            }
            s = t
            i = i + 1
            if sc.accepts[s] {
                best = i
            }
        }
        if best >= 0 {
            return Some(Match { at: at, end: best })
        }
        at = at + 1
    }
    return None
}

/// The first match at or after `from`, or `None`.
export fn find(re: Regex, hay: String, from: Int64) -> Option<Match> {
    let mut sc = newScan(re, dfaCap)
    return nextMatch(re, bytes(hay), from, sc)
}

/// How many non-overlapping matches `re` has in `hay`: `aa` in `aaa` is one. An
/// empty match advances by one byte.
export fn countMatches(re: Regex, hay: String) -> Int64 {
    let raw = bytes(hay)
    let mut sc = newScan(re, dfaCap)
    let mut n = 0
    let mut i = 0
    while let Some(m) = nextMatch(re, raw, i, sc) {
        n = n + 1
        i = if m.end > m.at { m.end } else { m.at + 1 }
    }
    return n
}

/// `hay` with every non-overlapping match replaced by `with`, taken literally:
/// there are no captures, so no `$1`.
export fn replaceAll(re: Regex, hay: String, with: String) -> String {
    let raw = bytes(hay)
    let mut sc = newScan(re, dfaCap)
    let mut out = ""
    let mut kept = 0
    let mut i = 0
    while let Some(m) = nextMatch(re, raw, i, sc) {
        out = out + substring(hay, kept, m.at) + with
        kept = m.end
        i = if m.end > m.at { m.end } else { m.at + 1 }
    }
    return out + substring(hay, kept, raw.length)
}

test "a literal is found, counted and replaced" {
    let re = match compile("abc") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "abcabc"), 2)
    assertEq(countMatches(re, "xxabcyy"), 1)
    assertEq(countMatches(re, "ab"), 0)
    assertEq(replaceAll(re, "xabcy", "-"), "x-y")
    assertEq(replaceAll(re, "abcabc", ""), "")
}

test "alternation takes the longest branch, which is POSIX's rule" {
    let re = match compile("a|ab") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    // A backtracking engine answers `a` here.
    assertEq(replaceAll(re, "ab", "<>"), "<>")
}

test "a class matches its members and a negated one everything else" {
    let re = match compile("[cgt]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "acgta"), 3)
    let neg = match compile("[^>]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(neg, "a>b>c"), 3)
    let range = match compile("[a-f]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(range, "abcxyzf"), 4)
}

test "a dot and a negated class match a whole character" {
    let dot = match compile(".") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(dot, "é", "x"), "x")
    assertEq(countMatches(dot, "aé€😀"), 4)
    let neg = match compile("[^a]") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(neg, "aéb", "_"), "a__")
}

test "the three repeats" {
    let star = match compile("ab*c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(star, "ac"), 1)
    assertEq(countMatches(star, "abbbc"), 1)
    let plus = match compile("ab+c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(plus, "ac"), 0)
    assertEq(countMatches(plus, "abc"), 1)
    let opt = match compile("ab?c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(opt, "ac"), 1)
    assertEq(countMatches(opt, "abc"), 1)
    assertEq(countMatches(opt, "abbc"), 0)
}

test "a star is greedy" {
    let re = match compile("<[^>]*>") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(re, "a<bcd>e", "|"), "a|e")
    assertEq(replaceAll(re, "<>", "|"), "|")
    // Two tags, not one run across both, because `[^>]` cannot cross a `>`.
    assertEq(replaceAll(re, "<a><b>", "|"), "||")
}

test "an escape is the byte after it, not the metacharacter" {
    let re = match compile("\\|[^|][^|]*\\|") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(replaceAll(re, "x|ab|y", "-"), "x-y")
}

test "the patterns regex-redux counts" {
    let dna = "agggtaaacccagggtaaacttttaccctgg"
    let re = match compile("agggtaaa|tttaccct") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, dna), 3)
    let cls = match compile("agggtaa[cgt]|[acg]ttaccct") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(cls, "agggtaacXXcttaccct"), 2)
}

test "a group is a term the repeats apply to" {
    let re = match compile("(ab)+c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(re, "ababc"), 1)
    assertEq(countMatches(re, "c"), 0)
    let alt = match compile("(a|b)c") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    assertEq(countMatches(alt, "ac bc"), 2)
}

test "find says where, and searching from there finds the next" {
    let re = match compile("aa") {
        Ok(r) => r,
        Err(w) => panic("compile: \{w}"),
    }
    if let Some(m) = find(re, "xxaayyaa", 0) {
        assertEq(m.at, 2)
        assertEq(m.end, 4)
    } else {
        panic("the first match is at 2")
    }
    if let Some(m) = find(re, "xxaayyaa", 4) {
        assertEq(m.at, 6)
    } else {
        panic("the second match is at 6")
    }
    if let Some(m) = find(re, "xxaayyaa", 7) {
        panic("there is no third match, got \{m.at}")
    }
}

test "what it refuses, it refuses by name" {
    match compile("a(b") {
        Ok(r) => panic("an unbalanced group compiled"),
        Err(w) => assert(w == "a group with no closing `)`"),
    }
    match compile("[abc") {
        Ok(r) => panic("an unterminated class compiled"),
        Err(w) => assert(w == "a character class with no closing `]`"),
    }
    match compile("^a") {
        Ok(r) => panic("an anchor compiled"),
        Err(w) => assert(w == "anchors (`^` and `$`) are not supported"),
    }
    match compile("a{2,3}") {
        Ok(r) => panic("counted repetition compiled"),
        Err(w) => assert(w == "counted repetition (`{m,n}`) is not supported"),
    }
    match compile("a*?") {
        Ok(r) => panic("a non-greedy repeat compiled"),
        Err(w) => assert(w == "non-greedy repetition (`*?`) is not supported"),
    }
    match compile("[z-a]") {
        Ok(r) => panic("a backwards range compiled"),
        Err(w) => assert(w == "a character range that runs backwards"),
    }
    match compile("") {
        Ok(r) => panic("an empty pattern compiled"),
        Err(w) => assert(w == "an empty pattern"),
    }
}

/// A draw below `n` from the generator state `seed`, which it advances.
fn draw(seed: modify Int64, n: Int64) -> Int64 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    return (seed / 65536) % n
}

/// A pattern `compile` accepts, over the atoms the engines treat differently.
fn genPattern(seed: modify Int64, depth: Int64) -> String {
    let atoms = ["a", "b", "c", ".", "[ab]", "[^a]", "[a-c]", "(é)", "\\|", "(€)"]
    let suffixes = ["", "", "*", "+", "?"]
    let mut out = ""
    let branches = 1 + draw(seed, 2)
    let mut b = 0
    while b < branches {
        if b > 0 {
            out = out + "|"
        }
        let terms = 1 + draw(seed, 3)
        let mut t = 0
        while t < terms {
            let pick = draw(seed, atoms.length + 1)
            if pick == atoms.length && depth > 0 {
                out = out + "(" + genPattern(seed, depth - 1) + ")"
            } else {
                out = out + atoms[pick % atoms.length]
            }
            out = out + suffixes[draw(seed, suffixes.length)]
            t = t + 1
        }
        b = b + 1
    }
    return out
}

test "the lazy DFA finds every match the Thompson simulation finds" {
    let pieces = ["a", "b", "c", "é", "è", "€", "|", "\n"]
    let mut seed = 7
    let mut round = 0
    while round < 300 {
        let pattern = genPattern(seed, 2)
        let re = match compile(pattern) {
            Ok(r) => r,
            Err(w) => panic("`\{pattern}`: \{w}"),
        }
        let mut hay = ""
        let len = draw(seed, 16)
        while hay.byteLength < len {
            hay = hay + pieces[draw(seed, pieces.length)]
        }
        let raw = bytes(hay)
        let mut oracle = newScan(re, 0)
        let mut ends: Array<Int64> = []
        let mut i = 0
        while i <= raw.length {
            ends.push(nfaMatchAt(re, raw, i, oracle))
            i = i + 1
        }
        // The whole table, the two fixed states alone, and one state more: the
        // last two fall back part way through a walk.
        let caps = [dfaCap, 0, re.classCount]
        let mut k = 0
        while k < caps.length {
            let mut sc = newScan(re, caps[k])
            let mut from = 0
            while from <= raw.length {
                let mut at = from
                while at <= raw.length && ends[at] < 0 {
                    at = at + 1
                }
                if let Some(m) = nextMatch(re, raw, from, sc) {
                    if at > raw.length || m.at != at || m.end != ends[at] {
                        panic("`\{pattern}` on `\{hay}` from \{from}: found \{m.at}..\{m.end}")
                    }
                } else {
                    if at <= raw.length {
                        panic("`\{pattern}` on `\{hay}` from \{from}: missed \{at}")
                    }
                }
                from = from + 1
            }
            k = k + 1
        }
        round = round + 1
    }
}
