/// Connect wire compatibility as a library, built on
/// generator imports. `connectServer` emits the `connectHandle` router
/// and `connectClient` the in-Vyrn caller, for Connect's unary JSON flavor over
/// HTTP/1 only: no gRPC, streaming, GET flavor or compression.
///
///   POST /<Service>.<Procedure>
///   content-type: application/json
///   errors: {"code": "...", "message": "...", "details": [...]}
///
/// Wire semantics:
///   - success: 200, body `toJson(result)`;
///   - a `fromJson` failure: 400, `code: "invalid_argument"`, every Issue in `details`;
///   - an unknown procedure under the service prefix: 501 `unimplemented`;
///   - a known procedure with a non-POST method: 405, as `std/rpc` does;
///   - an `Err` from a `Result` procedure: 200 with the encoded value.

// The `connect`-prefixed copies of `std/rpc`'s helpers keep this generator
// self-contained.
import { fromBytesOr } from "std/strings"
import { importBlock, procImports } from "std/imports"
import { endsWith, startsWith } from "std/strpred"

import { reportHere, Severity } from "std/diag"

/// Uppercases the first ASCII byte: `getBook` gives `onGetBook` and `connectDoneGetBook`.
fn connectCapFirst(s: String) -> String {
    let raw = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in raw {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

fn connectIsNamedType(spelling: String, iface: ModuleInterface) -> Bool {
    for t in iface.types {
        if t.name == spelling {
            return true
        }
    }
    return false
}

/// The contract specifier's last segment without `.vyrn`: the `<service>` in `/<service>.<Proc>`.
fn connectServiceName(contract: String) -> String {
    let ba = bytes(contract)
    let mut start = 0
    let mut i = 0
    while i < ba.length {
        if ba[i] == '/' {
            start = i + 1
        }
        i = i + 1
    }
    let mut seg: Array<UInt8> = []
    let mut j = start
    while j < ba.length {
        seg.push(ba[j])
        j = j + 1
    }
    let name = fromBytesOr(seg, contract)
    if name.endsWith(".vyrn") {
        let nb = bytes(name)
        let mut trimmed: Array<UInt8> = []
        let mut k = 0
        while k < nb.length - 5 {
            trimmed.push(nb[k])
            k = k + 1
        }
        return fromBytesOr(trimmed, name)
    }
    return name
}

/// Reports, through `std/diag`, a procedure with more than one parameter or with
/// one that is not an exported named type; `None` for a clean contract.
/// `reportHere` anchors it, since reflection gives no declaration line.
gen fn connectValidateContract(iface: ModuleInterface) -> Option<Code> {
    for f in iface.functions {
        if f.params.length > 1 {
            return Some(reportHere(
                Error,
                "procedure `\{f.name}` takes \{f.params.length.toString()} parameters — a Connect procedure takes at most one; gather them into one exported record type",
            ))
        }
        if f.params.length == 1 {
            if connectIsNamedType(f.params[0].spelling, iface) == false {
                return Some(reportHere(
                    Error,
                    "procedure `\{f.name}` takes `\{f.params[0].spelling}`, which this contract does not export as a named type — a Connect parameter must be an exported named type so the generated module can decode it",
                ))
            }
        }
    }
    return None
}

/// One procedure's dispatcher: decode, call, encode. A decode failure is a 400
/// `invalid_argument`; a `Unit` return is a 200 `{}`.
gen fn connectDispatchFn(f: FnCode) -> Code {
    let cap = connectCapFirst(f.info.name)
    let handler = name("connectDispatch" + cap)
    let run = name("connectRun" + cap)
    let call = name(f.info.name)
    if f.params.length == 1 {
        let req = f.params[0].ty
        return match f.ret {
            Some(_) => vyrn"""
                fn \{handler}(body: String) -> Response {
                    return match fromJson<\{req}>(body) {
                        Valid(input) => Response { status: 200, contentType: "application/json", body: toJson(\{call}(input)), vary: "", headers: [:] },
                        Invalid(issues) => connectFail400(issues),
                    }
                }

                """,
            None => vyrn"""
                fn \{handler}(body: String) -> Response {
                    return match fromJson<\{req}>(body) {
                        Valid(input) => \{run}(input),
                        Invalid(issues) => connectFail400(issues),
                    }
                }
                fn \{run}(input: \{req}) -> Response {
                    \{call}(input)
                    return Response { status: 200, contentType: "application/json", body: "{}", vary: "", headers: [:] }
                }

                """,
        }
    }
    return match f.ret {
        Some(_) => vyrn"""
            fn \{handler}(body: String) -> Response {
                return Response { status: 200, contentType: "application/json", body: toJson(\{call}()), vary: "", headers: [:] }
            }

            """,
        None => vyrn"""
            fn \{handler}(body: String) -> Response {
                \{call}()
                return Response { status: 200, contentType: "application/json", body: "{}", vary: "", headers: [:] }
            }

            """,
    }
}

/// The exported router. It answers `None` outside the service prefix, so it
/// mounts beside `rpcHandle`.
gen fn connectRouterFn(m: ModuleCode, service: String) -> Code {
    let prefix = "/" + service + "."
    let mut body = vyrn""
    for f in m.functions {
        let dispatch = name("connectDispatch" + connectCapFirst(f.info.name))
        body = body + vyrn"""
            if req.path == \{prefix + f.info.name} {
                if req.method != "POST" {
                    return Some(Response { status: 405, contentType: "text/plain", body: "method not allowed", vary: "", headers: [:] })
                }
                return Some(\{dispatch}(req.body))
            }

            """
    }
    body = body + vyrn"""
        if req.path.startsWith(\{prefix}) {
            return Some(connectCodeErr(501, "unimplemented"))
        }
        return None
        """
    return vyrn"""
        export fn connectHandle(req: Request) -> Option<Response> {
            \{body}
        }

        """
}

/// Emits a module exposing `connectHandle(req: Request) -> Option<Response>`.
/// The generator and its module link into one flat namespace, so the generator
/// cannot itself be named `connectHandle` (as `rpcServer` emits `rpcHandle`).
export gen fn connectServer(contract: String) -> Code {
    let m = moduleCode(contract)
    return match connectValidateContract(m.iface) {
        Some(err) => err,
        None => connectServerModule(m, contract),
    }
}

gen fn connectServerModule(m: ModuleCode, contract: String) -> Code {
    let mut out = vyrn"""
        /// Generated by std/connect `connectServer` — do not edit.
        import { startsWith } from "std/strpred"

        """
    out = out + importBlock(m.iface, contract, procImports(m.iface, false)) + vyrn"""

        type ConnectError = { code: String, message: String, details: Array<Issue> }
        fn connectFail400(issues: Array<Issue>) -> Response {
            return Response { status: 400, contentType: "application/json", body: toJson(ConnectError { code: "invalid_argument", message: "request validation failed", details: issues.copy() }), vary: "", headers: [:] }
        }
        fn connectCodeErr(status: Int64, code: String) -> Response {
            return Response { status: status, contentType: "application/json", body: "{\\\"code\\\":\\\"" + code + "\\\"}", vary: "", headers: [:] }
        }

        """
    for f in m.functions {
        out = out + connectDispatchFn(f)
    }
    return out + connectRouterFn(m, connectServiceName(contract))
}

/// Unifies a reply: 200 decodes the body (`Valid(true)` for `Unit`), 400 surfaces
/// the Connect error's `details`, anything else is one `connect.transport` Issue
/// (status 0 = unreachable).
gen fn connectUnifyFn(f: FnCode) -> Code {
    let unify = name("connectUnify" + connectCapFirst(f.info.name))
    let ok = match f.ret {
        Some(r) => vyrn"return fromJson<\{r}>(body)",
        None => vyrn"return Valid(true)",
    }
    let unreachable = "procedure `" + f.info.name + "` is unreachable"
    let failed = "procedure `" + f.info.name + "` failed with status "
    return vyrn"""
        fn \{unify}(status: Int64, body: String) -> Validation<\{f.ret ?? vyrn"Bool"}> {
            if status == 200 { \{ok} }
            if status == 400 {
                return match fromJson<ConnectError>(body) {
                    Valid(err) => Invalid(err.details),
                    Invalid(issues) => Invalid(issues),
                }
            }
            if status == 0 {
                return Invalid([Issue { key: "connect.transport", path: "", message: \{unreachable} }])
            }
            return Invalid([Issue { key: "connect.transport", path: "", message: \{failed} + status.toString() }])
        }

        """
}

/// One procedure's client: the stub that calls the shared transport extern, and
/// the `export extern fn` completion the host calls, which hands the unified
/// reply to the user's `on<Proc>` handler.
gen fn connectProcFns(f: FnCode, service: String) -> Code {
    let cap = connectCapFirst(f.info.name)
    let path = "/" + service + "." + f.info.name
    let stub = if f.params.length == 1 {
        vyrn"""
            export fn \{name(f.info.name)}(req: \{f.params[0].ty}) {
                vyrnConnectCall(\{path}, toJson(req))
            }

            """
    } else {
        vyrn"""
            export fn \{name(f.info.name)}() {
                vyrnConnectCall(\{path}, "{}")
            }

            """
    }
    return connectUnifyFn(f) + stub + vyrn"""
        export extern fn \{name("connectDone" + cap)}(id: Int64, status: Int64, body: String) {
            \{name("on" + cap)}(id, \{name("connectUnify" + cap)}(status, body))
        }

        """
}

/// Emits the client: the contract's type declarations, one stub per procedure
/// over one `vyrnConnectCall` extern, and one completion per procedure. The user
/// writes only `fn onGetBook(id: Int64, res: Validation<T>)`.
export gen fn connectClient(contract: String) -> Code {
    let m = moduleCode(contract)
    return match connectValidateContract(m.iface) {
        Some(err) => err,
        None => connectClientModule(m, contract),
    }
}

gen fn connectClientModule(m: ModuleCode, contract: String) -> Code {
    let mut out = vyrn"""
        /// Generated by std/connect `connectClient` — do not edit.

        """
    for t in m.types {
        out = out + t.decl + vyrn"\n"
    }
    out = out + vyrn"""
        type ConnectError = { code: String, message: String, details: Array<Issue> }
        extern fn vyrnConnectCall(path: String, body: String) -> Int64

        """
    let service = connectServiceName(contract)
    for f in m.functions {
        out = out + connectProcFns(f, service)
    }
    return out
}

test "connectServiceName strips the path and the .vyrn suffix" {
    assertEq(connectServiceName("./contract"), "contract")
    assertEq(connectServiceName("std/shelf.vyrn"), "shelf")
    assertEq(connectServiceName("wire"), "wire")
}

test "connectCapFirst uppercases only the first ASCII byte" {
    assertEq(connectCapFirst("getBook"), "GetBook")
    assertEq(connectCapFirst("tagCounts"), "TagCounts")
}
