/// The strict JSON reader: `parseJson`, and the cursor `fromJson` reads with.
///
///   import { parseJson } from "std/jsonread"
///   import { Json, JsonField, emit } from "std/json"
///
/// The reader imports the writer's tree, never the reverse, so a caller that
/// only serializes links `std/json` alone. The name is `parseJson` because
/// `parse` is a reserved builtin. Commas are required, trailing commas and
/// duplicate keys are refused, every escape is decoded (a lone surrogate is an
/// error), and object fields keep source order. Offsets are bytes; every error
/// starts with `line N, col M:`.
///
/// The grammar lives in the `JsonReader` functions: `parseJson` builds a tree
/// with them, and a `fromJson` decoder writes straight into its record. Each
/// value reader expects the cursor on the value's first byte and leaves it on
/// the byte after the value. The first refusal is the document's error; it
/// moves the cursor to the end, so every later reader sees the end of input,
/// refuses nothing more, and returns.

import { Json, JsonField, JsonReader, emit, emitPretty, jsonEq } from "std/json"
import { fnv1aStr } from "std/hash"

/// The deepest nesting the reader accepts. Past the engine's call cap the
/// recursion traps, which no `Err` arm catches. Each level costs about two
/// frames here and two in `emit`, so 128 levels leave room for a re-emit, a
/// `fromJson` decode and the caller's stack.
fn maxDepth() -> Int64 {
    return 128
}

/// A reader over `s`, its cursor on the first byte that is not whitespace.
export fn jsonReader(s: String) -> JsonReader {
    let mut p = JsonReader { src: s.copy(), n: s.byteLength, pos: 0, depth: 0, err: "" }
    skipWs(p)
    return p
}

/// The byte at the cursor, or `-1` at the end of input.
fn peek(p: JsonReader) -> Int64 {
    if p.pos >= p.n {
        return -1
    }
    return Int64(p.src[p.pos])
}

/// The byte `k` ahead, or `-1` past the end.
fn ahead(p: JsonReader, k: Int64) -> Int64 {
    let i = p.pos + k
    if i < 0 || i >= p.n {
        return -1
    }
    return Int64(p.src[i])
}

fn step(p: modify JsonReader) -> Unit {
    if p.pos < p.n {
        p.pos = p.pos + 1
    }
}

/// `msg` prefixed with the cursor's 1-based `line N, col M:` position. A line
/// ends at an LF.
fn errAt(p: JsonReader, msg: String) -> String {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < p.pos {
        if Int64(p.src[i]) == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return "line " + line.toString() + ", col " + col.toString() + ": " + msg
}

/// Records `msg` at the cursor, unless the document is already refused, and
/// moves the cursor to the end.
fn refuse(p: modify JsonReader, msg: String) -> Unit {
    if p.err.byteLength == 0 {
        p.err = errAt(p, msg)
    }
    p.pos = p.n
}

/// Whether the document is refused; `p.err` holds the message.
export fn jsonRefused(p: JsonReader) -> Bool {
    return p.err.byteLength > 0
}

/// Skips JSON whitespace: space, tab, CR and LF only.
fn skipWs(p: modify JsonReader) -> Unit {
    while true {
        let b = peek(p)
        if b == ' ' || b == '\t' || b == '\r' || b == '\n' {
            step(p)
        } else {
            return
        }
    }
}

/// Refuses content after the document's one value.
export fn finishJson(p: modify JsonReader) -> Unit {
    skipWs(p)
    if p.pos < p.n {
        refuse(p, "trailing content after the JSON value")
    }
}

/// The kind of the value at the cursor, named by a byte that starts it: `{`,
/// `[`, `"`, `t` for a boolean, `n` for `null` and `0` for a number. `-1`
/// where no value can start, which a read then refuses.
export fn jsonKindAt(p: JsonReader) -> Int64 {
    let b = peek(p)
    if b == 'f' {
        return 't'
    }
    if b == '-' || (b >= '1' && b <= '9') {
        return '0'
    }
    if b == '{' || b == '[' || b == '"' || b == 't' || b == 'n' || b == '0' {
        return b
    }
    return -1
}

/// A `jsonKindAt` kind as `expected <X>, found <kind>` words it; `""` for `-1`.
export fn jsonKindName(k: Int64) -> String {
    if k == '{' {
        return "object"
    }
    if k == '[' {
        return "array"
    }
    if k == '"' {
        return "string"
    }
    if k == 't' {
        return "boolean"
    }
    if k == 'n' {
        return "null"
    }
    if k == '0' {
        return "number"
    }
    return ""
}

fn isHex(b: Int64) -> Bool {
    return (b >= '0' && b <= '9') || (b >= 'a' && b <= 'f') || (b >= 'A' && b <= 'F')
}

/// The value of one ASCII hex digit (0..15); assumes `isHex(b)`.
fn hexVal(b: Int64) -> Int64 {
    if b >= '0' && b <= '9' {
        return b - '0'
    }
    if b >= 'a' && b <= 'f' {
        return b - 'a' + 10
    }
    return b - 'A' + 10
}

fn pushUtf8(out: modify Array<UInt8>, cp: Int64) -> Unit {
    if cp < 128 {
        out.push(UInt8(cp))
    } else if cp < 2048 {
        out.push(UInt8(192 + (cp / 64)))
        out.push(UInt8(128 + (cp % 64)))
    } else if cp < 65536 {
        out.push(UInt8(224 + (cp / 4096)))
        out.push(UInt8(128 + ((cp / 64) % 64)))
        out.push(UInt8(128 + (cp % 64)))
    } else {
        out.push(UInt8(240 + (cp / 262144)))
        out.push(UInt8(128 + ((cp / 4096) % 64)))
        out.push(UInt8(128 + ((cp / 64) % 64)))
        out.push(UInt8(128 + (cp % 64)))
    }
}

/// Reads the 4 hex digits of a `\uXXXX` escape, the cursor just past the `u`;
/// `-1` when refused.
fn readHex4(p: modify JsonReader) -> Int64 {
    let mut v = 0
    let mut i = 0
    while i < 4 {
        let b = peek(p)
        if isHex(b) == false {
            refuse(p, "invalid \\u escape: expected 4 hex digits")
            return -1
        }
        v = v * 16 + hexVal(b)
        step(p)
        i = i + 1
    }
    return v
}

/// Reads a JSON string, the cursor on the opening `"`, and decodes every
/// escape to UTF-8. Refused, it answers `""`.
export fn readJsonString(p: modify JsonReader) -> String {
    step(p) // opening "
    let start = p.pos
    while p.pos < p.n {
        let c = Int64(p.src[p.pos])
        if c == '"' || c == '\\' || c < 32 {
            break
        }
        p.pos = p.pos + 1
    }
    // A string with no escape is one run of the source, copied in one call.
    // Otherwise the run starts the decoded bytes, and the loop below reads on
    // from the first byte the run stopped at.
    let mut out = bytes(p.src, start, p.pos)
    while true {
        let b = peek(p)
        if b < 0 {
            refuse(p, "unterminated string")
            return ""
        }
        if b == '"' {
            step(p) // closing "
            return match stringFromBytes(out) {
                Ok(v) => v,
                Err(e) => refusedString(p, "string is not valid UTF-8"),
            }
        }
        if b == '\\' {
            step(p) // backslash
            let e = peek(p)
            if e == '"' {
                out.push('"')
                step(p)
            } else if e == '\\' {
                out.push('\\')
                step(p)
            } else if e == '/' {
                out.push('/')
                step(p)
            } else if e == 'b' {
                out.push('\x08')
                step(p)
            } else if e == 'f' {
                out.push('\x0c')
                step(p)
            } else if e == 'n' {
                out.push('\n')
                step(p)
            } else if e == 'r' {
                out.push('\r')
                step(p)
            } else if e == 't' {
                out.push('\t')
                step(p)
            } else if e == 'u' {
                step(p) // u
                let hi = readHex4(p)
                if hi < 0 {
                    return ""
                }
                if hi >= 55296 && hi <= 56319 {
                    // A low surrogate `\uDC00..DFFF` must follow.
                    if peek(p) != '\\' || ahead(p, 1) != 'u' {
                        return refusedString(p, "unpaired high surrogate in \\u escape")
                    }
                    step(p) // backslash
                    step(p) // u
                    let lo = readHex4(p)
                    if lo < 0 {
                        return ""
                    }
                    if lo < 56320 || lo > 57343 {
                        return refusedString(p, "unpaired high surrogate in \\u escape")
                    }
                    let cp = 65536 + (hi - 55296) * 1024 + (lo - 56320)
                    pushUtf8(out, cp)
                } else if hi >= 56320 && hi <= 57343 {
                    return refusedString(p, "unexpected low surrogate in \\u escape")
                } else {
                    pushUtf8(out, hi)
                }
            } else if e < 0 {
                return refusedString(p, "unterminated string")
            } else {
                return refusedString(p, "invalid escape in string")
            }
        } else if b < 32 {
            return refusedString(p, "control character in string (must be escaped)")
        } else {
            out.push(UInt8(b))
            step(p)
        }
    }
    return refusedString(p, "unterminated string")
}

fn refusedString(p: modify JsonReader, msg: String) -> String {
    refuse(p, msg)
    return ""
}

/// Reads a JSON number, the cursor on `-` or a digit, and returns its raw text.
/// Grammar: `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?`. Refused, it
/// answers `""`.
export fn readJsonNumber(p: modify JsonReader) -> String {
    let start = p.pos
    if peek(p) == '-' {
        step(p)
    }
    let d = peek(p)
    if d == '0' {
        step(p)
    } else if d >= '1' && d <= '9' {
        skipDigits(p)
    } else {
        return refusedString(p, "invalid number: expected a digit")
    }
    if peek(p) == '.' {
        step(p)
        if isDigit(peek(p)) == false {
            return refusedString(p, "invalid number: expected a digit after '.'")
        }
        skipDigits(p)
    }
    if peek(p) == 'e' || peek(p) == 'E' {
        step(p)
        if peek(p) == '+' || peek(p) == '-' {
            step(p)
        }
        if isDigit(peek(p)) == false {
            return refusedString(p, "invalid number: expected a digit in the exponent")
        }
        skipDigits(p)
    }
    return match stringFromBytes(bytes(p.src, start, p.pos)) {
        Ok(v) => v,
        Err(e) => refusedString(p, "invalid number"),
    }
}

fn isDigit(b: Int64) -> Bool {
    return b >= '0' && b <= '9'
}

fn skipDigits(p: modify JsonReader) -> Unit {
    while p.pos < p.n && isDigit(Int64(p.src[p.pos])) {
        p.pos = p.pos + 1
    }
}

/// Reads the keyword `true`, `false` or `null`, the cursor on its first byte,
/// and answers whether it is `true`.
export fn readJsonKeyword(p: modify JsonReader) -> Bool {
    let b = peek(p)
    let word = if b == 't' { "true" } else if b == 'f' { "false" } else { "null" }
    let mut i = 0
    while i < word.byteLength {
        if peek(p) != Int64(word[i]) {
            refuse(p, "invalid literal: expected `" + word + "`")
            return false
        }
        step(p)
        i = i + 1
    }
    return b == 't'
}

/// Opens the array or object at the cursor and answers whether it has a first
/// member, the cursor on it. An empty one is read whole.
fn enter(p: modify JsonReader, close: Int64) -> Bool {
    if p.depth >= maxDepth() {
        refuse(p, "nesting deeper than " + maxDepth().toString() + " levels")
        return false
    }
    p.depth = p.depth + 1
    step(p)
    skipWs(p)
    if peek(p) == close {
        return leave(p)
    }
    return true
}

/// Closes the array or object whose last byte is at the cursor; answers
/// `false`, the end of its members.
fn leave(p: modify JsonReader) -> Bool {
    p.depth = p.depth - 1
    step(p)
    return false
}

/// `enter` for the object at the cursor.
export fn enterJsonObject(p: modify JsonReader) -> Bool {
    return enter(p, '}')
}

/// `enter` for the array at the cursor.
export fn enterJsonArray(p: modify JsonReader) -> Bool {
    return enter(p, ']')
}

/// Reads the key of an object member, the cursor on it. Refused, it answers
/// `""`. The caller checks the key for a duplicate before `readJsonColon`, so
/// a duplicate is refused just past the key.
export fn readJsonKey(p: modify JsonReader) -> String {
    if peek(p) != '"' {
        return refusedString(p, "expected a string key")
    }
    return readJsonString(p)
}

/// Reads the key at the cursor and answers `true` if it is `name` spelled with
/// no escape. Otherwise it moves nothing and answers `false`, and `readJsonKey`
/// reads the key. It allocates nothing.
export fn readJsonKeyIf(p: modify JsonReader, name: String) -> Bool {
    let close = p.pos + name.byteLength + 1
    if close >= p.n || Int64(p.src[p.pos]) != '"' || Int64(p.src[close]) != '"' {
        return false
    }
    let mut i = 0
    while i < name.byteLength {
        if p.src[p.pos + 1 + i] != name[i] {
            return false
        }
        i = i + 1
    }
    p.pos = close + 1
    return true
}

/// Reads the `:` after an object key, the cursor then on the value.
export fn readJsonColon(p: modify JsonReader) -> Unit {
    skipWs(p)
    if peek(p) != ':' {
        refuse(p, "expected ':' after object key")
        return
    }
    step(p)
    skipWs(p)
}

/// Reads what follows an object member's value and answers whether another
/// member follows, the cursor on its key.
export fn nextJsonMember(p: modify JsonReader) -> Bool {
    return next(p, '}', "trailing comma before '}'", "unterminated object", "expected ',' or '}' in object")
}

/// Reads what follows an array element and answers whether another element
/// follows, the cursor on it.
export fn nextJsonItem(p: modify JsonReader) -> Bool {
    return next(p, ']', "trailing comma before ']'", "unterminated array", "expected ',' or ']' in array")
}

fn next(p: modify JsonReader, close: Int64, trailing: String, open: String, other: String) -> Bool {
    skipWs(p)
    let b = peek(p)
    if b == ',' {
        step(p)
        skipWs(p)
        if peek(p) == close {
            refuse(p, trailing)
            return false
        }
        return true
    }
    if b == close {
        return leave(p)
    }
    if b < 0 {
        refuse(p, open)
    } else {
        refuse(p, other)
    }
    return false
}

/// The keys one object has shown: linear probing over FNV-1a-64, capacity a
/// power of two (`mask = cap - 1`), grown at 70% load. A scan per member would
/// make an N-key object O(N^2), which one wide untrusted body could exploit.
/// Empty, it holds no slots, so a set no key reaches allocates nothing.
export type JsonKeySet = { keys: Array<String>, slots: Array<Int64>, mask: Int64 }

export fn jsonKeySet() -> JsonKeySet {
    return JsonKeySet { keys: [], slots: [], mask: 0 }
}

/// The slot holding `key`, or -1 when absent. `slots[i]` stores the key's
/// index in `keys` plus one, so 0 marks an empty slot.
fn ksFind(s: JsonKeySet, key: String) -> Int64 {
    if s.keys.length == 0 {
        return -1
    }
    let mut i = Int64(fnv1aStr(key)) & s.mask
    while true {
        if s.slots[i] == 0 {
            return -1
        }
        if s.keys[s.slots[i] - 1] == key {
            return i
        }
        i = (i + 1) & s.mask
    }
    return -1
}

/// Places key index `ki` at the first empty slot from its key's hash `h`.
fn ksPlace(s: modify JsonKeySet, h: UInt64, ki: Int64) -> Unit {
    let mut i = Int64(h) & s.mask
    while s.slots[i] != 0 {
        i = (i + 1) & s.mask
    }
    s.slots[i] = ki + 1
}

/// Records `key`. If the new entry pushes load past 70%, grows first and
/// rehashes every key, the new one included, so a probe always finds an empty
/// slot.
fn ksAdd(s: modify JsonKeySet, key: String) -> Unit {
    s.keys.push(key.copy())
    let cap = s.slots.length
    if s.keys.length * 10 > cap * 7 {
        let mut slots: Array<Int64> = []
        let newCap = if cap == 0 { 8 } else { cap * 2 }
        let mut n = 0
        while n < newCap {
            slots.push(0)
            n = n + 1
        }
        s.mask = newCap - 1
        s.slots = slots
        let mut ki = 0
        while ki < s.keys.length {
            let h = fnv1aStr(s.keys[ki])
            ksPlace(s, h, ki)
            ki = ki + 1
        }
        return
    }
    let last = s.keys.length - 1
    ksPlace(s, fnv1aStr(key), last)
}

/// Records `key` in `seen` and answers `true`, or refuses it as a duplicate
/// and answers `false`.
export fn admitJsonKey(p: modify JsonReader, seen: modify JsonKeySet, key: String) -> Bool {
    if ksFind(seen, key) != -1 {
        refuseJsonDuplicate(p, key)
        return false
    }
    ksAdd(seen, key)
    return true
}

/// Refuses `key` as a repeat of a key its object already holds.
export fn refuseJsonDuplicate(p: modify JsonReader, key: String) -> Unit {
    refuse(p, "duplicate object key: " + key)
}

/// Reads one value into a tree. `depth` is checked in `enter`, the one place.
fn parseValue(p: modify JsonReader) -> Json {
    let k = jsonKindAt(p)
    if k == '{' {
        return parseObject(p)
    }
    if k == '[' {
        return parseArray(p)
    }
    if k == '"' {
        return JStr(readJsonString(p))
    }
    if k == 't' {
        return JBool(readJsonKeyword(p))
    }
    if k == 'n' {
        readJsonKeyword(p)
        return JNull
    }
    if k == '0' {
        return JNum(readJsonNumber(p))
    }
    let end = peek(p) < 0
    refuse(p, if end { "unexpected end of input" } else { "unexpected character" })
    return JNull
}

/// Reads and drops one value, refusing what `parseJson` refuses.
export fn skipJsonValue(p: modify JsonReader) -> Unit {
    let v = parseValue(p)
    drop v
}

/// Reads an array, the cursor on `[`. A refused array holds what was read.
fn parseArray(p: modify JsonReader) -> Json {
    let mut items: Array<Json> = []
    if enterJsonArray(p) {
        while true {
            items.push(parseValue(p))
            if nextJsonItem(p) == false {
                break
            }
        }
    }
    return JArr(items)
}

/// Reads an object, the cursor on `{`. A refused object holds what was read.
fn parseObject(p: modify JsonReader) -> Json {
    let mut fields: Array<JsonField> = []
    if enterJsonObject(p) {
        let mut seen = jsonKeySet()
        while true {
            let key = readJsonKey(p)
            if admitJsonKey(p, seen, key) == false {
                break
            }
            readJsonColon(p)
            fields.push(JsonField { key: key, value: parseValue(p) })
            if nextJsonMember(p) == false {
                break
            }
        }
    }
    return JObj(fields)
}

/// Parses a whole JSON document, or returns a `line N, col M: <reason>` error.
/// Numbers are validated and stored as raw text; nesting past [`maxDepth`] is
/// an `Err`.
export fn parseJson(src: String) -> Result<Json, String> {
    let mut p = jsonReader(src)
    let v = parseValue(p)
    finishJson(p)
    if jsonRefused(p) {
        // `Json` declares its release, and only an explicit `drop` releases a
        // partial tree on every engine.
        drop v
        return Err(p.err.copy())
    }
    return Ok(v)
}

/// The parsed tree, or a `JStr` carrying the error.
fn parseOr(src: String) -> Json {
    return match parseJson(src) {
        Ok(v) => v,
        Err(e) => JStr("ERR:" + e),
    }
}

/// The parse error, or "" if the parse succeeded.
fn parseErr(src: String) -> String {
    return match parseJson(src) {
        Ok(v) => "",
        Err(e) => e,
    }
}

test "parses scalars, arrays, and objects" {
    assert(jsonEq(parseOr("null"), JNull))
    assert(jsonEq(parseOr("true"), JBool(true)))
    assert(jsonEq(parseOr("false"), JBool(false)))
    assert(jsonEq(parseOr("42"), JNum("42")))
    assert(jsonEq(parseOr("-3.14e2"), JNum("-3.14e2")))
    assert(jsonEq(parseOr("\"hi\""), JStr("hi")))
    assert(jsonEq(parseOr("[1,2,3]"), JArr([JNum("1"), JNum("2"), JNum("3")])))
}

test "object field order is preserved in source order" {
    // emit preserves field order, so a compact re-emit witnesses the ordering.
    assertEq(emit(parseOr("{ \"b\": 1, \"a\": 2, \"c\": 3 }")), "{\"b\":1,\"a\":2,\"c\":3}")
}

test "decodes the full escape set" {
    assert(jsonEq(parseOr("\"a\\nb\""), JStr("a\nb")))
    assert(jsonEq(parseOr("\"tab\\there\""), JStr("tab\there")))
    assert(jsonEq(parseOr("\"q\\\"q\""), JStr("q\"q")))
    assert(jsonEq(parseOr("\"slash\\/slash\""), JStr("slash/slash")))
    assert(jsonEq(parseOr("\"\\u0041\""), JStr("A")))
}

test "decodes a surrogate pair to UTF-8" {
    // U+1F600 is the bytes F0 9F 98 80.
    let grin = match stringFromBytes(['\xf0', '\x9f', '\x98', '\x80']) {
        Ok(v) => v,
        Err(e) => "",
    }
    assert(jsonEq(parseOr("\"\\uD83D\\uDE00\""), JStr(grin)))
}

test "rejects a lone high surrogate" {
    assertEq(parseErr("\"\\uD83D\""), "line 1, col 8: unpaired high surrogate in \\u escape")
}

test "rejects a lone low surrogate" {
    assertEq(parseErr("\"\\uDE00\""), "line 1, col 8: unexpected low surrogate in \\u escape")
}

test "rejects a trailing comma in an array" {
    assertEq(parseErr("[1, 2, ]"), "line 1, col 8: trailing comma before ']'")
}

test "rejects a trailing comma in an object" {
    assertEq(parseErr("{ \"a\": 1, }"), "line 1, col 11: trailing comma before '}'")
}

test "rejects a missing comma between members" {
    assertEq(parseErr("[1 2]"), "line 1, col 4: expected ',' or ']' in array")
}

test "rejects a duplicate object key, naming it" {
    assertEq(parseErr("{ \"a\": 1, \"a\": 2 }"), "line 1, col 14: duplicate object key: a")
}

test "rejects an invalid number" {
    assertEq(parseErr("01"), "line 1, col 2: trailing content after the JSON value")
    assertEq(parseErr("1."), "line 1, col 3: invalid number: expected a digit after '.'")
}

test "reports line and column across newlines" {
    assertEq(parseErr("[\n  1,\n  @\n]"), "line 3, col 3: unexpected character")
}

test "round-trip law: parse(emit(j)) is structurally j" {
    let j = JObj([
        JsonField { key: "name", value: JStr("vyrn") },
        JsonField { key: "nums", value: JArr([JNum("1"), JNum("-2.5"), JNum("3e4")]) },
        JsonField { key: "nested", value: JObj([JsonField { key: "ok", value: JBool(true) }]) },
        JsonField { key: "nothing", value: JNull },
    ])
    let round = match parseJson(emit(j)) {
        Ok(v) => v,
        Err(e) => JStr("ERR:" + e),
    }
    assert(jsonEq(round, j))
    // The writer is byte-stable through a parse.
    assertEq(emit(round), emit(j))
}

test "the round-trip law holds for the awkward keys and values too" {
    // Keys holding JSON punctuation, a quote, a backslash and a control byte;
    // two keys that differ only by case; a character above the BMP; empty
    // containers; and each number form `JNum` may carry.
    let ctrl = match stringFromBytes(['k', '\x01', 'v']) {
        Ok(v) => v,
        Err(e) => "",
    }
    let j = JObj([
        JsonField { key: "a\"quoted\": {key}, [here]", value: JStr("}\",") },
        JsonField { key: "back\\slash", value: JStr("\\") },
        JsonField { key: ctrl, value: JStr("\n\t") },
        JsonField { key: "Case", value: JNum("0") },
        JsonField { key: "case", value: JNum("-0") },
        JsonField { key: "𝄞 above the BMP", value: JStr("𝄞") },
        JsonField { key: "", value: JArr([]) },
        JsonField { key: "empty", value: JObj([]) },
        JsonField {
            key: "nums",
            value: JArr([JNum("1e-9"), JNum("-2.5"), JNum("1E+30"), JNum("9007199254740993")]),
        },
    ])
    let round = match parseJson(emit(j)) {
        Ok(v) => v,
        Err(e) => JStr("ERR:" + e),
    }
    assert(jsonEq(round, j))
    assertEq(emit(round), emit(j))
    // The same tree through the pretty writer reads back as the same tree.
    let pretty = match parseJson(emitPretty(j, 2)) {
        Ok(v) => v,
        Err(e) => JStr("ERR:" + e),
    }
    assert(jsonEq(pretty, j))
}

/// A document nested exactly `n` deep: `open` n times, `core`, `close` n times.
fn nest(open: String, core: String, close: String, n: Int64) -> String {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + open
        i = i + 1
    }
    out = out + core
    i = 0
    while i < n {
        out = out + close
        i = i + 1
    }
    return out
}

test "nesting past maxDepth is an Err, not a trap" {
    assertEq(parseErr(nest("[", "", "]", 129)), "line 1, col 129: nesting deeper than 128 levels")
    assertEq(parseErr(nest("[", "", "]", 4000)), "line 1, col 129: nesting deeper than 128 levels")
    // The object form refuses at the 129th `{`, five columns a level.
    assertEq(
        parseErr(nest("{\"a\":", "1", "}", 400)),
        "line 1, col 641: nesting deeper than 128 levels",
    )
}

test "nesting at maxDepth parses, and re-emits" {
    // 128 itself parses, and `emit` can walk the result.
    assertEq(parseErr(nest("[", "", "]", 128)), "")
    assertEq(emit(parseOr(nest("[", "", "]", 128))), nest("[", "", "]", 128))
    assertEq(parseErr(nest("{\"a\":", "1", "}", 128)), "")
}
