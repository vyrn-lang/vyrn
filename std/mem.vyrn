/// `vyrn_gen.read(path, mode) -> (status << 32) | len`: the resource at
/// `path` resolved, mediated, recorded and stashed by the generator host.
/// The status is 0 ok, 1 io, 3 an embedded NUL.
export fn genRead(path: Int32, mode: Int32) -> Int64 {
    noBody()
    return 0
}

/// `vyrn_gen.fetch(buf)`: the stash of the last `genRead` copied into `buf`,
/// which the module allocated itself; the host never allocates in it.
export fn genFetch(buf: Int32) {
    noBody()
}
