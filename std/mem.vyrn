/// std/mem — the primitives the runtime module stands on: raw memory
/// (RFC-0125 §2.4, PLAN-0125-runtime §2.1), the host imports (§2.2) and the
/// trap (§2.3).
///
/// Every function here is a declaration. The emitter never reads a body: it
/// maps each call to one wasm instruction (`load8` is `i32.load8_u`, `copy` is
/// `memory.copy`, `grow` is `memory.grow`) or to one `call` of a host import
/// (`fdWrite` is `wasi_snapshot_preview1.fd_write`). The bodies below exist so
/// the module parses and checks like any other; an engine that reaches one —
/// the interpreter, which has no linear memory — stops with the message.
///
/// The audience of this module is `std/runtime` and nothing else. The loader
/// declares that audience itself (PLAN-0125-runtime §3.2), so no `vyrn.json`
/// can widen it: a user import of `std/mem` is refused with a diagnostic, and
/// the safe surface over these instructions is what `std/runtime` exports.
///
/// An address is an `Int32` because the route is wasm32 (RFC-0125 §2.8). The
/// runtime module is the only reader of addresses, so there is no `Ptr<T>`.

fn noBody() {
    panic("std/mem: a primitive has no body; the emitter lowers it to one instruction")
}

/// `i32.load8_u`: the byte at `addr`.
export fn load8(addr: Int32) -> UInt8 {
    noBody()
    return 0
}

/// `i32.load16_u`.
export fn load16(addr: Int32) -> UInt16 {
    noBody()
    return 0
}

/// `i32.load`.
export fn load32(addr: Int32) -> UInt32 {
    noBody()
    return 0
}

/// `i64.load`.
export fn load64(addr: Int32) -> UInt64 {
    noBody()
    return 0
}

/// `f32.load`.
export fn loadF32(addr: Int32) -> Float32 {
    noBody()
    return 0.0
}

/// `f64.load`.
export fn loadF64(addr: Int32) -> Float64 {
    noBody()
    return 0.0
}

/// `i32.store8`.
export fn store8(addr: Int32, v: UInt8) {
    noBody()
}

/// `i32.store16`.
export fn store16(addr: Int32, v: UInt16) {
    noBody()
}

/// `i32.store`.
export fn store32(addr: Int32, v: UInt32) {
    noBody()
}

/// `i64.store`.
export fn store64(addr: Int32, v: UInt64) {
    noBody()
}

/// `f32.store`.
export fn storeF32(addr: Int32, v: Float32) {
    noBody()
}

/// `f64.store`.
export fn storeF64(addr: Int32, v: Float64) {
    noBody()
}

/// `memory.copy`: `n` bytes from `src` to `dst`. The ranges may overlap.
export fn copy(dst: Int32, src: Int32, n: Int32) {
    noBody()
}

/// `memory.fill`: `n` bytes of `byte` at `dst`.
export fn fill(dst: Int32, byte: UInt8, n: Int32) {
    noBody()
}

/// `memory.size`: the memory's size in 64 KiB pages.
export fn memorySize() -> Int32 {
    noBody()
    return 0
}

/// `memory.grow`: add `delta` pages. The old size in pages, or -1 when the
/// engine refuses.
export fn grow(delta: Int32) -> Int32 {
    noBody()
    return 0
}

/// The `HEAP_BASE` global: where the data segment ends and the heap begins.
export fn heapBase() -> Int32 {
    noBody()
    return 0
}

/// The trap primitive (PLAN-0125-runtime §2.3): `len` bytes at `msg` to
/// descriptor 2, then `proc_exit(1)`. It does not return.
export fn trap(msg: Int32, len: Int32) {
    noBody()
}

// ---------------------------------------------------------------------------
// The host imports (PLAN-0125-runtime §2.2)
// ---------------------------------------------------------------------------
//
// Each is one `wasi_snapshot_preview1` import, with the signature the witx
// gives it: an `Int32` for every `i32` and an `Int64` for every `i64`, a
// pointer being an `Int32` address in the module's own memory. The emitter
// declares the fifteen once, before any body, and `Module::sweep` drops the
// ones no export reaches, so a program pays only for the imports it calls.
// Each is an effect under RFC-0125 §2.2's judgment, which is what a host
// import is by that section's definition; the atoms of the lattice stay the
// builtin names a program spells (`readFile`, `print`, ..), because those are
// what the judgment sees in a user body, and the runtime functions behind
// them are reached through no other name.
//
// The two `vyrn_gen` imports at the end are the generator host's (RFC-0076
// M7): a generator reads through the loader's resolver, not through
// `path_open`. An ordinary build has no generator host, so the emitter lowers
// a call to either as `unreachable`; the runtime functions that call them
// (`readFileGen`, `listDirGen`) are reached only under a generation, and the
// sweep removes them from every other module.

/// `fd_write(fd, iovs, iovsLen, nwritten) -> errno`.
export fn fdWrite(fd: Int32, iovs: Int32, iovsLen: Int32, nwritten: Int32) -> Int32 {
    noBody()
    return 0
}

/// `fd_read(fd, iovs, iovsLen, nread) -> errno`.
export fn fdRead(fd: Int32, iovs: Int32, iovsLen: Int32, nread: Int32) -> Int32 {
    noBody()
    return 0
}

/// `fd_close(fd) -> errno`.
export fn fdClose(fd: Int32) -> Int32 {
    noBody()
    return 0
}

/// `proc_exit(code)`. It does not return; `trap` above is the one caller.
export fn procExit(code: Int32) {
    noBody()
}

