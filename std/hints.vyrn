/// Policy for checking libraries: per-project rule levels and per-line waivers.
///
/// A rule is a `code`, a string this module never interprets; an input file is
/// text with lines. `std/vyx-hints` uses only this public surface.
///
/// A library's rules record [`Finding`]s as data; [`reports`] applies the
/// project's levels and waivers once and returns the reports:
///
/// ```vyrn
/// import { Finding, noPolicy, reports } from "std/hints"
/// import { Severity } from "std/diag"
///
/// export gen fn myHints(path: String) -> Code {
///     let src = match readFile(path) { Ok(t) => t, Err(e) => "" }
///     let mut found: Array<Finding> = []
///     // ... find something at line 4, column 9 ...
///     found.push(Finding { code: "my/rule", dflt: Warning, line: 4, col: 9, message: "say what is wrong" })
///     return reports(noPolicy(), src, path, found)
/// }
/// ```
///
/// A project sets levels with a JSON object under the library's own top-level
/// key, in any JSON file passed to the generator as a constant path:
///
/// ```json
/// { "hints": { "a11y/img-alt": "error", "perf/img-size": "off" } }
/// ```
///
/// [`policyOf`] refuses a config that does not parse or names an unknown level:
/// a swallowed fault would report rules on while they are off.
///
/// `vyrn-ignore <code>` on the reported line, or on the line above it, drops
/// that one report. The marker is plain text inside the input's own comment:
///
/// ```text
/// <!-- vyrn-ignore a11y/tabindex-positive: the tour sets the order -->
/// <div tabindex="2">Start here</div>
/// ```

import { report, Severity } from "std/diag"
import { Json, copyJson, emit } from "std/json"
import { parseJson } from "std/jsonread"
import { fieldsOf, tagOf } from "std/jsondec"
import { contains } from "std/strpred"
import { substring } from "std/strings"

/// Per-code severity overrides, as parallel arrays (a code and its level word).
export type HintPolicy = { codes: Array<String>, levels: Array<String> }

/// One rule's finding in an input file: the rule's `code`, its severity when
/// the project sets none, the 1-based `line` and `col` it anchors at, and what
/// is wrong.
export type Finding = { code: String, dflt: Severity, line: Int64, col: Int64, message: String }

/// The empty policy: no override, every rule at its default severity.
export fn noPolicy() -> HintPolicy {
    return HintPolicy { codes: [], levels: [] }
}

/// Reads a policy from the top-level `key` of `configText`.
///
/// `Ok(noPolicy())` when the key is absent. `Err` when the document does not
/// parse, the key is not an object of strings, or a level is not `off`,
/// `warning` or `error`.
export fn policyOf(configText: String, key: String) -> Result<HintPolicy, String> {
    let doc = parseJson(configText)?
    let mut found = false
    let mut section = JNull
    let top = fieldsOf(doc)
    for f in top {
        if f.key == key {
            found = true
            section = copyJson(f.value)
        }
    }
    if found == false {
        return Ok(noPolicy())
    }
    if isObject(section) == false {
        return Err("`\{key}` is not an object of rule levels")
    }
    let mut codes: Array<String> = []
    let mut levels: Array<String> = []
    let rules = fieldsOf(section)
    for r in rules {
        let word = tagOf(r.value)
        if word == "off" || word == "warning" || word == "error" {
            codes.push(r.key.copy())
            levels.push(word.copy())
        } else {
            return Err(
                "`\{key}.\{r.key}` is \{emit(r.value)} — a level is `off`, `warning` or `error`",
            )
        }
    }
    return Ok(HintPolicy { codes: codes, levels: levels })
}

/// The level `code` runs at under `p`: its configured word, or the word for
/// `dflt` when the project said nothing about it.
export fn levelOf(p: HintPolicy, code: String, dflt: Severity) -> String {
    let mut i = 0
    while i < p.codes.length {
        if p.codes[i] == code {
            return p.levels[i].copy()
        }
        i = i + 1
    }
    return match dflt {
        Warning => "warning",
        Error => "error",
    }
}

/// The reports `findings` earn in `file` under `p`, in order: a finding whose
/// rule is off, or whose line `src` waives, earns none. `src` is the text of
/// `file`; the waiver markers are read from it.
export gen fn reports(p: HintPolicy, src: String, file: String, findings: Array<Finding>) -> Code {
    let mut out = vyrn""
    for f in findings {
        let level = levelOf(p, f.code, f.dflt)
        if level != "off" && waived(src, f.line, f.code) == false {
            let severity = if level == "error" { Error } else { Warning }
            out = out + report(severity, file, f.line, f.col, "\{f.code}: \{f.message}")
        }
    }
    return out
}

/// Whether `code` is waived at `line` of `src`: a `vyrn-ignore <code>` marker
/// on that line or on the one above it.
export fn waived(src: String, line: Int64, code: String) -> Bool {
    // One walk that keeps the previous line's bounds. The cost is O(bytes) per
    // hint; only a line index hoisted by the caller removes it, an API change.
    let n = src.byteLength
    let mut at = 1
    let mut start = 0
    let mut prevStart = 0
    let mut prevEnd = 0
    let mut havePrev = false
    let mut i = 0
    while i < n {
        if src[i] == '\n' {
            if at == line {
                if waivesLine(substring(src, start, i), code) {
                    return true
                }
                if havePrev {
                    return waivesLine(substring(src, prevStart, prevEnd), code)
                }
                return false
            }
            prevStart = start
            prevEnd = i
            havePrev = true
            at = at + 1
            start = i + 1
        }
        i = i + 1
    }
    if at == line {
        if waivesLine(substring(src, start, n), code) {
            return true
        }
        if havePrev {
            return waivesLine(substring(src, prevStart, prevEnd), code)
        }
        return false
    }
    // `line` is one past a final line with no trailing newline. That final line
    // is the line above, so its waiver covers `line`.
    if line > 1 && at == line - 1 {
        return waivesLine(substring(src, start, n), code)
    }
    return false
}

/// Whether `line` holds `vyrn-ignore <code>` with the code ending there: at end
/// of line or at a byte no code continues with. So `vyrn-ignore lint/x/y`
/// does not waive `lint/x`.
fn waivesLine(line: String, code: String) -> Bool {
    let marker = "vyrn-ignore \{code}"
    let n = line.byteLength
    let m = marker.byteLength
    if m == 0 || n < m {
        return false
    }
    let mb = bytes(marker)
    let mut i = 0
    while i + m <= n {
        let mut j = 0
        while j < m && line[i + j] == mb[j] {
            j = j + 1
        }
        if j == m && continuesCode(line, i + m) == false {
            return true
        }
        i = i + 1
    }
    return false
}

/// A `hint/unused-waiver` finding for every `vyrn-ignore` marker in `src` that
/// waives nothing: a marker at line L is used when a finding of its code whose
/// rule `p` does not turn off sits at L or L + 1. [`reports`] judges these
/// findings like any other, so the rule is configured and waived by the same
/// policy.
export fn unusedWaivers(p: HintPolicy, src: String, findings: Array<Finding>) -> Array<Finding> {
    let mut out: Array<Finding> = []
    let n = src.byteLength
    let mut lineNo = 1
    let mut start = 0
    let mut i = 0
    while i <= n {
        if i == n || src[i] == '\n' {
            let code = waiverCode(substring(src, start, i))
            if code != "" && covers(p, findings, code, lineNo) == false {
                out.push(Finding {
                    code: "hint/unused-waiver",
                    dflt: Warning,
                    line: lineNo,
                    col: 0,
                    message: "`vyrn-ignore \{code}` waives nothing here — the finding it covered is gone, so the marker now misleads; delete it",
                })
            }
            lineNo = lineNo + 1
            start = i + 1
        }
        i = i + 1
    }
    return out
}

/// Whether a finding of `code` that `p` does not turn off sits at `line` or the
/// line below it, the lines a marker at `line` waives.
fn covers(p: HintPolicy, findings: Array<Finding>, code: String, line: Int64) -> Bool {
    for f in findings {
        if f.code == code && (f.line == line || f.line == line + 1) && levelOf(p, code, f.dflt) != "off" {
            return true
        }
    }
    return false
}

/// The code of the first `vyrn-ignore <code>` marker on `line`, or `""`.
fn waiverCode(line: String) -> String {
    let marker = "vyrn-ignore "
    let n = line.byteLength
    let m = marker.byteLength
    let mb = bytes(marker)
    let mut i = 0
    while i + m <= n {
        let mut j = 0
        while j < m && line[i + j] == mb[j] {
            j = j + 1
        }
        if j == m {
            let mut e = i + m
            while continuesCode(line, e) {
                e = e + 1
            }
            if e > i + m {
                return substring(line, i + m, e)
            }
        }
        i = i + 1
    }
    return ""
}

/// Whether the byte at `at` could continue a rule code.
fn continuesCode(line: String, at: Int64) -> Bool {
    if at >= line.byteLength {
        return false
    }
    let b = line[at]
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9')
    || b == '/' || b == '-' || b == '_'
}

/// The text of 1-based `line` in `src`, or `""` past the end. The bounds come
/// from a newline walk, so the slice cannot split a character.
fn lineText(src: String, line: Int64) -> String {
    if line < 1 {
        return ""
    }
    let n = src.byteLength
    let mut at = 1
    let mut start = 0
    let mut i = 0
    while i < n {
        if src[i] == '\n' {
            if at == line {
                return substring(src, start, i)
            }
            at = at + 1
            start = i + 1
        }
        i = i + 1
    }
    if at == line {
        return substring(src, start, n)
    }
    return ""
}

fn isObject(j: Json) -> Bool {
    return match j {
        JObj(fs) => true,
        JArr(xs) => false,
        JStr(s) => false,
        JNum(s) => false,
        JBool(b) => false,
        JNull => false,
    }
}

/// The policy in `text` under `"hints"`, or the empty one (the `Err` arms are
/// asserted on separately).
fn policyOr(text: String) -> HintPolicy {
    return match policyOf(text, "hints") {
        Ok(v) => v,
        Err(e) => noPolicy(),
    }
}

/// The refusal `text` earns, or `"PARSED"` if it earns none.
fn refusal(text: String) -> String {
    return match policyOf(text, "hints") {
        Ok(v) => "PARSED",
        Err(e) => e,
    }
}

test "an absent key is the empty policy, not a fault" {
    assertEq(refusal("{\"other\": {}}"), "PARSED")
    assertEq(policyOr("{\"other\": {}}").codes.length, 0)
    assertEq(policyOr("{}").codes.length, 0)
}

test "a configured level wins over the rule's default" {
    let p = policyOr("{\"hints\": {\"a/b\": \"error\", \"c/d\": \"off\"}}")
    assertEq(levelOf(p, "a/b", Warning), "error")
    assertEq(levelOf(p, "c/d", Warning), "off")
    assertEq(levelOf(p, "e/f", Warning), "warning")
    assertEq(levelOf(p, "e/f", Error), "error")
}

test "a malformed config is refused, never a silent no-op" {
    assert(contains(refusal("{\"hints\": {,}}"), "line 1"))
    assert(contains(refusal("{\"hints\": {\"a/b\": \"loud\"}}"), "`hints.a/b` is \"loud\""))
    assert(contains(refusal("{\"hints\": {\"a/b\": 1}}"), "a level is `off`"))
    assert(contains(refusal("{\"hints\": [1]}"), "not an object of rule levels"))
}

/// The text of the one report `p` lets `code` at `line`, `col` earn in `src`,
/// which a test can read.
gen fn reportText(p: HintPolicy, src: String, code: String, line: Int64, col: Int64) -> String {
    let found: Array<Finding> = [Finding { code: code.copy(), dflt: Warning, line: line, col: col, message: "say why" }]
    return render(reports(p, src, "f.vyx", found))
}

test "an off rule emits nothing" {
    let p = policyOr("{\"hints\": {\"a/b\": \"off\"}}")
    assertEq(reportText(p, "x\n", "a/b", 1, 1), "")
    assert(reportText(p, "x\n", "a/z", 1, 1) != "")
}

test "a report carries its code, its anchor and its severity" {
    assertEq(reportText(noPolicy(), "x\n", "a/b", 3, 7), "//@diag warning f.vyx:3:7 a/b: say why\n")
    assertEq(
        reportText(policyOr("{\"hints\": {\"a/b\": \"error\"}}"), "x\n", "a/b", 3, 7),
        "//@diag error f.vyx:3:7 a/b: say why\n",
    )
}

test "a marker is unused unless a finding of its code that is on sits on its line or the next" {
    let src = "<!-- vyrn-ignore a/b -->\n<img>\n"
    let at: Array<Finding> = [Finding { code: "a/b", dflt: Warning, line: 2, col: 1, message: "m" }]
    assertEq(unusedWaivers(noPolicy(), src, at).length, 0)
    let off = policyOr("{\"hints\": {\"a/b\": \"off\"}}")
    assertEq(unusedWaivers(off, src, at)[0].line, 1)
    let elsewhere: Array<Finding> = [Finding { code: "a/b", dflt: Warning, line: 3, col: 1, message: "m" }]
    assertEq(unusedWaivers(noPolicy(), src, elsewhere)[0].code, "hint/unused-waiver")
}

test "a waiver on the line, or the line above, drops that one report" {
    let src = "one\n<!-- vyrn-ignore a/b -->\n<img>\n<img>\n"
    assert(waived(src, 3, "a/b"))
    assert(waived(src, 2, "a/b"))
    assert(waived(src, 4, "a/b") == false)
    assert(waived(src, 3, "c/d") == false)
    assertEq(reportText(noPolicy(), src, "a/b", 3, 1), "")
    assert(reportText(noPolicy(), src, "a/b", 4, 1) != "")
}

test "a waiver names its code exactly — prefixes do not leak" {
    // lint/x's marker is a prefix of lint/x/y's; only the full code waives.
    let deep = "<!-- vyrn-ignore lint/x/y -->\n<img>\n"
    assert(waived(deep, 2, "lint/x") == false)
    assert(waived(deep, 2, "lint/x/y"))
    // A prefix cut mid-code never matches even where the text occurs.
    assert(waived("<!-- vyrn-ignore a/b -->", 1, "a") == false)
    assert(waived("<!-- vyrn-ignore a/b -->", 1, "a/b/c") == false)
    // Prose after the code is fine: anything but a code byte ends it.
    assert(waived("<!-- vyrn-ignore lint/x: sanitized upstream -->", 1, "lint/x"))
}

test "line text is 1-based and ends at the newline" {
    assertEq(lineText("a\nbb\nccc", 2), "bb")
    assertEq(lineText("a\nbb\nccc", 3), "ccc")
    assertEq(lineText("a\r\nbb\r\n", 1), "a\r")
    assertEq(lineText("a\nbb", 3), "")
    assertEq(lineText("a\nbb", 0), "")
}

test "a waiver is honoured on its own line and on the line below it" {
    // The reported line, the line above, the first line, and a last line with
    // no trailing newline.
    let src = "a\nb // vyrn-ignore x/y\nc\nd // vyrn-ignore x/y"
    assertEq(waived(src, 2, "x/y"), true)
    assertEq(waived(src, 3, "x/y"), true)
    assertEq(waived(src, 1, "x/y"), false)
    assertEq(waived(src, 4, "x/y"), true)
    assertEq(waived(src, 2, "other"), false)
}

test "a waiver on line one has no line above to consult" {
    let src = "a // vyrn-ignore x/y\nb"
    assertEq(waived(src, 1, "x/y"), true)
    assertEq(waived(src, 2, "x/y"), true)
}

test "a waiver on a final line with no newline covers the line past the end" {
    // Line 2 of a one-line source: the line does not exist, but the waiver on
    // the line above still applies.
    assertEq(waived("// vyrn-ignore p/q", 2, "p/q"), true)
    assertEq(waived("// vyrn-ignore p/q", 3, "p/q"), false)
    assertEq(waived("a\n// vyrn-ignore p/q", 3, "p/q"), true)
    assertEq(waived("plain text", 2, "p/q"), false)
}
