/// The import block of a generated module.
///
/// A generator that emits code over a module's types and procedures writes one
/// `import` line per declaring module, so each type keeps its identity. A
/// re-emitted copy would collide in the flat namespace.
///
/// ```vyrn
/// import { importBlock, procImports } from "std/imports"
///
/// export gen fn server(contract: String) -> Code {
///     let iface = moduleInterface(contract)
///     return importBlock(iface, contract, procImports(iface, false)) + vyrn"..."
/// }
/// ```

import { includes } from "std/arrays"
import { join } from "std/code"

/// Returns the names `iface`'s procedures import under: each as is, or with
/// `procAlias` as `<name> as <name>__real`.
export gen fn procImports(iface: ModuleInterface, procAlias: Bool) -> Array<Code> {
    let mut names: Array<Code> = []
    for f in iface.functions {
        if procAlias {
            names.push(vyrn"\{name(f.name)} as \{name(f.name + "__real")}")
        } else {
            names.push(vyrn"\{name(f.name)}")
        }
    }
    return names
}

/// Returns one `import { ... } from "<module>"` line for each module that
/// declares a type of `iface.types`, in first-use order. The module named
/// `contract` comes first and also imports `procs`. An empty `contract` with
/// no `procs` imports the types alone.
export gen fn importBlock(iface: ModuleInterface, contract: String, procs: Array<Code>) -> Code {
    let mut specs: Array<String> = [contract.copy()]
    for t in iface.types {
        if includes(specs, t.module) == false {
            specs.push(t.module.copy())
        }
    }
    let mut lines: Array<Code> = []
    for spec in specs {
        let mut names: Array<Code> = []
        if spec == contract {
            for p in procs {
                names.push(p)
            }
        }
        for t in iface.types {
            if t.module == spec {
                names.push(vyrn"\{name(t.name)}")
            }
        }
        if names.length > 0 {
            lines.push(vyrn"import { \{join(names, vyrn", ")} } from \{spec}")
        }
    }
    return join(lines, vyrn"\n")
}
