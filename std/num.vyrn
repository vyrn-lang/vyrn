/// std/num — text -> number, written in Vyrn (RFC-0078 M4a).
///
/// The language could already turn a number into text on every engine. It could
/// not turn text into a number at all beyond `parse`'s `String -> Option<Int64>`:
/// `Float64("1.5")` is a check error, and there is no expression that builds a
/// `Float64` from anything but another number. That is the wall RFC-0078 M3 hit,
/// and this module is the answer to it.
///
/// **Why a library and not a builtin.** A `parseFloat` builtin would need three
/// implementations, and the third one is the problem: the direct wasm backend has
/// no `strtod` to call, so it would have to grow a correctly-rounded
/// decimal-to-binary conversion in hand-emitted wasm, next to the ~300 lines
/// RFC-0077 M2h already wrote for the other direction. Written here it is written
/// once and every engine gets it, which is RFC-0078's whole thesis. The price is
/// two genuinely irreducible primitives — `floatBits` and `floatFromBits`, the
/// IEEE-754 bit views, one instruction each — and this file.
///
/// **Correctly rounded, and how.** The conversion is exact, not floating point:
/// the decimal is kept as a digit array and scaled by powers of two until it lies
/// in `[1/2, 1)`, at which point the mantissa bits fall out of repeated doubling
/// and the leftover fraction decides the rounding — greater than a half rounds up,
/// less rounds down, exactly a half goes to even. Nothing here computes with a
/// `Float64` except the very last step, which assembles one from its bits. That is
/// the same shape RFC-0077 M2h used to print `%f`'s six places exactly, run
/// backwards.
///
/// Subnormals and overflow are not special cases bolted on: the number of
/// mantissa bits to extract is `min(mantissa width, exponent - the smallest)`, so
/// a subnormal simply asks for fewer bits and rounds the same way, and a value too
/// large for the format falls out as an exponent field past its maximum.
///
/// **The digit cap.** At most 800 significant digits are kept; anything dropped
/// sets a sticky flag which turns an exact tie into a round-up, because a
/// truncated tail means the true value is strictly greater than what was kept.
/// Beyond 800 digits no further digit can change a rounding decision except at a
/// tie, and the flag covers that.

/// A decimal significand and its exponent: the value is
/// `0.d[0]d[1]…d[n-1] × 10^dp`, sign carried separately. `trunc` records that
/// digits were dropped, so the true value is strictly greater than these digits.
type Dec = { d: Array<Int64>, dp: Int64, trunc: Bool }

/// A scanned literal, with `ok` false when the text is not a number at all.
type Scanned = { ok: Bool, neg: Bool, d: Array<Int64>, dp: Int64, trunc: Bool }

/// Significant digits kept. Past this a digit can only matter at an exact tie,
/// which the `trunc` flag resolves.
fn maxDigits() -> Int64 {
    return 800
}

/// Drop trailing zeros (they are exact and only cost work), then enforce the
/// digit cap — setting `trunc` only when a NON-zero digit is dropped, since an
/// over-eager flag would round a real tie the wrong way.
fn tidy(d: Array<Int64>, dp: Int64, trunc: Bool) -> Dec {
    let mut t = trunc
    let mut keep = d.length
    if keep > maxDigits() {
        let mut i = maxDigits()
        while i < keep {
            if d[i] != 0 {
                t = true
            }
            i = i + 1
        }
        keep = maxDigits()
    }
    while keep > 0 && d[keep - 1] == 0 {
        keep = keep - 1
    }
    let mut out: Array<Int64> = []
    let mut j = 0
    while j < keep {
        out.push(d[j])
        j = j + 1
    }
    return Dec { d: out, dp: dp, trunc: t }
}

/// Divide a decimal by `m`, a power of two no larger than 2^32.
///
/// Ordinary long division, left to right, with the running remainder below `m`
/// — so `r * 10 + digit` stays under `10 * m`, which keeps every intermediate
/// inside an `Int64` and every quotient digit a single decimal digit. Dividing by
/// a WHOLE 32 bits at a time rather than by two is what makes this usable: 10^308
/// needs 1024 halvings and 32 of these, and the difference measured on the
/// interpreter is 0.8 seconds against 0.05.
///
/// The quotient starts with as many leading zeros as the division shifted the
/// point by, which is why they are stripped into the exponent rather than kept.
fn halveBy(x: Dec, m: Int64) -> Dec {
    let mut out: Array<Int64> = []
    let mut r = 0
    let mut i = 0
    while i < x.d.length {
        let t = r * 10 + x.d[i]
        out.push(t / m)
        r = t % m
        i = i + 1
    }
    // The remainder becomes further fractional digits; dividing by 2^k is exact
    // but adds up to k of them, so it stops at the cap and says so.
    while r > 0 && out.length <= maxDigits() {
        let t = r * 10
        out.push(t / m)
        r = t % m
    }
    let mut tr = x.trunc
    if r > 0 {
        tr = true
    }
    let mut lead = 0
    while lead < out.length && out[lead] == 0 {
        lead = lead + 1
    }
    let mut o2: Array<Int64> = []
    let mut j = lead
    while j < out.length {
        o2.push(out[j])
        j = j + 1
    }
    return tidy(o2, x.dp - lead, tr)
}

/// Multiply a decimal by `m`, a power of two no larger than 2^32. Right to left
/// with a carry that can exceed a digit, so the digits come out least-significant
/// first and are reversed at the end; whatever the carry leaves over becomes new
/// leading digits and moves the exponent.
fn twiceBy(x: Dec, m: Int64) -> Dec {
    let mut rev: Array<Int64> = []
    let mut carry = 0
    let mut j = x.d.length - 1
    while j >= 0 {
        let t = x.d[j] * m + carry
        rev.push(t % 10)
        carry = t / 10
        j = j - 1
    }
    let mut extra = 0
    while carry > 0 {
        rev.push(carry % 10)
        carry = carry / 10
        extra = extra + 1
    }
    let mut out: Array<Int64> = []
    let mut i = rev.length - 1
    while i >= 0 {
        out.push(rev[i])
        i = i - 1
    }
    return tidy(out, x.dp + extra, x.trunc)
}

/// Scan `[+-]? digits [. digits] [(e|E) [+-]? digits]` — a superset of JSON's
/// number grammar, and nothing else. All of the text must be consumed, so
/// `"1 "`, `"1x"` and `""` are refusals rather than partial reads.
fn scan(s: String) -> Scanned {
    let b = bytes(s)
    let n = b.length
    let empty: Array<Int64> = []
    let mut i = 0
    let mut neg = false
    if i < n && (b[i] == '+' || b[i] == '-') {
        neg = b[i] == '-'
        i = i + 1
    }
    let mut d: Array<Int64> = []
    let mut dp = 0
    let mut sawDigit = false
    let mut sawDot = false
    let mut leading = true
    let mut trunc = false
    while i < n && (b[i] == '.' || (b[i] >= '0' && b[i] <= '9')) {
        if b[i] == '.' {
            if sawDot {
                return Scanned { ok: false, neg: false, d: empty, dp: 0, trunc: false }
            }
            sawDot = true
        } else {
            sawDigit = true
            if b[i] == '0' && leading {
                // A leading zero carries no information, but one after the point
                // pushes the first significant digit further down.
                if sawDot {
                    dp = dp - 1
                }
            } else {
                leading = false
                if d.length < maxDigits() {
                    d.push(Int64(b[i]) - 48)
                } else {
                    if b[i] != '0' {
                        trunc = true
                    }
                }
                if !sawDot {
                    dp = dp + 1
                }
            }
        }
        i = i + 1
    }
    if !sawDigit {
        return Scanned { ok: false, neg: false, d: empty, dp: 0, trunc: false }
    }
    if i < n && (b[i] == 'e' || b[i] == 'E') {
        i = i + 1
        let mut esign = 1
        if i < n && (b[i] == '+' || b[i] == '-') {
            if b[i] == '-' {
                esign = 0 - 1
            }
            i = i + 1
        }
        if i >= n || b[i] < '0' || b[i] > '9' {
            return Scanned { ok: false, neg: false, d: empty, dp: 0, trunc: false }
        }
        let mut ev = 0
        while i < n && b[i] >= '0' && b[i] <= '9' {
            // Clamped: an exponent past this is already infinity or zero, and an
            // unclamped accumulation would overflow into a plausible-looking one.
            if ev < 100000 {
                ev = ev * 10 + (Int64(b[i]) - 48)
            }
            i = i + 1
        }
        dp = dp + esign * ev
    }
    if i != n {
        return Scanned { ok: false, neg: false, d: empty, dp: 0, trunc: false }
    }
    let t = tidy(d, dp, trunc)
    return Scanned { ok: true, neg: neg, d: t.d, dp: t.dp, trunc: t.trunc }
}

/// `m × 2^ex` as a `Float64`, exactly, for any `m < 2^53` and `ex >= -1074`.
/// This is the only place a `Float64` is built, and it is built from its bits
/// rather than computed — normalize the mantissa until bit 52 is set (or the
/// exponent bottoms out, which is what a subnormal is), then lay out sign,
/// exponent field and fraction.
fn ldexp(neg: Bool, mIn: Int64, exIn: Int64) -> Float64 {
    let mut m = mIn
    let mut ex = exIn
    if m == 0 {
        if neg {
            return floatFromBits(9223372036854775808)
        }
        return 0.0
    }
    // A rounding carry out of the top mantissa bit leaves `m` at 2^53 — one bit
    // wider than the field holds — and the encoding below would then spill that
    // bit into the exponent with an `|` where a carry needs a `+`. An `|` is
    // idempotent, so it worked for an EVEN biased exponent and silently halved the
    // answer for an odd one: `parseFloat64("1.9999999999999999999")` was `1.0` and
    // `parseFloat64("9223372036854775807")` was 2^62. Normalizing here instead is
    // exact, because a carry cannot take `m` past 2^53.
    if m >= 9007199254740992 {
        m = m / 2
        ex = ex + 1
    }
    while m < 4503599627370496 && ex > 0 - 1074 {
        m = m * 2
        ex = ex - 1
    }
    let mut e = 0
    let mut frac = m
    if m >= 4503599627370496 {
        e = ex + 1075
        frac = m - 4503599627370496
    }
    if e > 2046 {
        // Past the largest finite double: the exponent field saturates and the
        // fraction clears, which is exactly the encoding of infinity.
        e = 2047
        frac = 0
    }
    let mut bits: UInt64 = (UInt64(e) << 52) | UInt64(frac)
    if neg {
        bits = bits | (UInt64(1) << 63)
    }
    return floatFromBits(bits)
}

/// The core conversion: a scanned decimal, correctly rounded to a binary format
/// of `mantBits` significand bits whose smallest exponent is `minExp`.
///
/// `Float64` is `(53, -1074)` and `Float32` is `(24, -149)`. A `Float32` result
/// is exactly representable as a `Float64`, so the caller narrows without a
/// second rounding.
fn toFloat(sc: Scanned, mantBits: Int64, minExp: Int64) -> Float64 {
    if sc.d.length == 0 {
        return ldexp(sc.neg, 0, 0)
    }
    // Coarse guards, so the scaling loop below cannot be handed an exponent that
    // would make it run for a million iterations to reach an answer it already
    // knows. Both bounds are far outside every format's range.
    if sc.dp > 400 {
        return ldexp(sc.neg, 9007199254740991, 4000)
    }
    if sc.dp < 0 - 400 {
        return ldexp(sc.neg, 0, 0)
    }
    // Scale into [1/2, 1). `dp > 0` means the value is at least 1; `dp < 0`, or
    // `dp == 0` with a leading digit below 5, means it is below a half.
    let mut x = Dec { d: sc.d, dp: sc.dp, trunc: sc.trunc }
    let mut e2 = 0
    // Coarse first, 32 bits at a time — each pass moves the decimal exponent by
    // between nine and ten, so this lands within ten of the target and cannot
    // overshoot past the other threshold. Then one bit at a time, at most about
    // thirty-five steps.
    let wide: Int64 = 4294967296
    while x.dp > 10 {
        x = halveBy(x, wide)
        e2 = e2 + 32
    }
    while x.dp < 0 - 10 {
        x = twiceBy(x, wide)
        e2 = e2 - 32
    }
    while x.dp > 0 {
        x = halveBy(x, 2)
        e2 = e2 + 1
    }
    while x.dp < 0 || (x.dp == 0 && x.d.length > 0 && x.d[0] < 5) {
        x = twiceBy(x, 2)
        e2 = e2 - 1
    }
    // How many bits this format has room for at this exponent. Fewer than the
    // full width is a subnormal; fewer than none is below half the smallest one.
    let mut nbits = mantBits
    if e2 - mantBits < minExp {
        nbits = e2 - minExp
    }
    if nbits < 0 {
        return ldexp(sc.neg, 0, 0)
    }
    // Repeated doubling of a pure fraction: the carry out of the leading digit is
    // the next mantissa bit, and the digits left behind are the residual. Nothing
    // grows, because the carry is consumed rather than prepended.
    let mut f = x.d
    let mut m = 0
    let mut i = 0
    while i < nbits {
        let mut carry = 0
        let mut j = f.length - 1
        while j >= 0 {
            let t = f[j] * 2 + carry
            f[j] = t % 10
            carry = t / 10
            j = j - 1
        }
        m = m * 2 + carry
        i = i + 1
    }
    // The residual against a half: greater rounds up, less rounds down, exactly a
    // half goes to even — unless digits were dropped, in which case the true
    // residual is strictly greater and it rounds up.
    let mut cmp = 0 - 1
    if f.length > 0 {
        if f[0] > 5 {
            cmp = 1
        } else if f[0] == 5 {
            let mut j = 1
            while j < f.length {
                if f[j] != 0 {
                    cmp = 1
                    j = f.length
                } else {
                    j = j + 1
                }
            }
            if cmp < 0 {
                cmp = 0
            }
        }
    }
    if cmp == 0 && x.trunc {
        cmp = 1
    }
    if cmp > 0 || (cmp == 0 && m % 2 == 1) {
        m = m + 1
    }
    return ldexp(sc.neg, m, e2 - nbits)
}

/// Decimal text as a `Float64`, correctly rounded — `None` when the text is not a
/// number. Accepts an optional sign, digits with an optional fraction and an
/// optional `e` exponent; the whole string must be consumed.
///
/// A value too large for the format is `inf` rather than a refusal, and one too
/// small is zero with its sign, which is what every other IEEE-754 text
/// conversion does.
export fn parseFloat64(s: String) -> Option<Float64> {
    let sc = scan(s)
    if !sc.ok {
        return None
    }
    return Some(toFloat(sc, 53, 0 - 1074))
}

/// The same, rounded to single precision directly rather than through a
/// `Float64` — decimal to `Float64` to `Float32` rounds twice and is wrong for
/// values that sit near a `Float32` tie.
export fn parseFloat32(s: String) -> Option<Float32> {
    let sc = scan(s)
    if !sc.ok {
        return None
    }
    return Some(Float32(toFloat(sc, 24, 0 - 149)))
}

/// Decimal text as an exact `Int64` — `None` when the text is not an integer or
/// does not fit. Unlike the `parse` builtin, which wraps on overflow, this
/// refuses: `"9223372036854775808"` is `None` rather than `Int64.min`.
export fn parseInt64(s: String) -> Option<Int64> {
    let b = bytes(s)
    if b.length == 0 {
        return None
    }
    let mut i = 0
    let mut neg = false
    if b[0] == '-' || b[0] == '+' {
        neg = b[0] == '-'
        i = 1
    }
    if i >= b.length {
        return None
    }
    // Accumulated in `UInt64` so the check is a magnitude comparison rather than
    // an overflow that has already happened. `Int64.min`'s magnitude is one more
    // than `Int64.max`'s, which is the row a sign-last implementation gets wrong.
    let mut acc: UInt64 = 0
    let limit: UInt64 = if neg { 9223372036854775808 } else { 9223372036854775807 }
    while i < b.length {
        if b[i] < '0' || b[i] > '9' {
            return None
        }
        let dig: UInt64 = UInt64(Int64(b[i]) - 48)
        if acc > 1844674407370955161 {
            return None
        }
        acc = acc * 10
        if acc > limit - dig {
            return None
        }
        acc = acc + dig
        i = i + 1
    }
    if neg {
        // `Int64.min` has no positive counterpart, so it is negated through the
        // bit pattern rather than through `0 - x`.
        return Some(0 - Int64(acc - 1) - 1)
    }
    return Some(Int64(acc))
}

/// Decimal text as an exact `UInt64` — the case `parse` cannot serve at all,
/// since its `Option<Int64>` has no room for a value above `Int64.max`. No sign
/// is accepted, not even `+`.
export fn parseUInt64(s: String) -> Option<UInt64> {
    let b = bytes(s)
    if b.length == 0 {
        return None
    }
    let umax: UInt64 = 18446744073709551615
    let mut acc: UInt64 = 0
    let mut i = 0
    while i < b.length {
        if b[i] < '0' || b[i] > '9' {
            return None
        }
        let dig: UInt64 = UInt64(Int64(b[i]) - 48)
        if acc > 1844674407370955161 {
            return None
        }
        acc = acc * 10
        if acc > umax - dig {
            return None
        }
        acc = acc + dig
        i = i + 1
    }
    return Some(acc)
}

test "integers round-trip exactly, and refuse what does not fit" {
    assertEq(match parseInt64("0") { Some(v) => v.toString(), None => "None" }, "0")
    assertEq(match parseInt64("-42") { Some(v) => v.toString(), None => "None" }, "-42")
    assertEq(
        match parseInt64("9223372036854775807") { Some(v) => v.toString(), None => "None" },
        "9223372036854775807",
    )
    assertEq(
        match parseInt64("-9223372036854775808") { Some(v) => v.toString(), None => "None" },
        "-9223372036854775808",
    )
    // The rows `parse` gets wrong: it wraps these to `Some(..)`.
    assertEq(
        match parseInt64("9223372036854775808") { Some(v) => v.toString(), None => "None" },
        "None",
    )
    assertEq(
        match parseInt64("18446744073709551615") { Some(v) => v.toString(), None => "None" },
        "None",
    )
    assertEq(match parseInt64("") { Some(v) => v.toString(), None => "None" }, "None")
    assertEq(match parseInt64("-") { Some(v) => v.toString(), None => "None" }, "None")
    assertEq(match parseInt64("1.5") { Some(v) => v.toString(), None => "None" }, "None")
    assertEq(match parseInt64(" 1") { Some(v) => v.toString(), None => "None" }, "None")
}

test "the exact UInt64 above Int64.max comes back whole" {
    assertEq(
        match parseUInt64("18446744073709551615") { Some(v) => v.toString(), None => "None" },
        "18446744073709551615",
    )
    assertEq(
        match parseUInt64("9223372036854775808") { Some(v) => v.toString(), None => "None" },
        "9223372036854775808",
    )
    assertEq(
        match parseUInt64("18446744073709551616") { Some(v) => v.toString(), None => "None" },
        "None",
    )
    assertEq(match parseUInt64("-1") { Some(v) => v.toString(), None => "None" }, "None")
}

test "floats round to the nearest double, ties to even" {
    assertEq(match parseFloat64("1.5") { Some(v) => v.toString(), None => "None" }, "1.500000")
    assertEq(match parseFloat64("-0.5") { Some(v) => v.toString(), None => "None" }, "-0.500000")
    assertEq(match parseFloat64("0") { Some(v) => v.toString(), None => "None" }, "0.000000")
    assertEq(match parseFloat64("-0") { Some(v) => v.toString(), None => "None" }, "-0.000000")
    // Neither of these is exact in binary, so the bits are the rounded ones and
    // `%f` shows the six places of THAT double rather than of the text.
    assertEq(match parseFloat64("0.1") { Some(v) => v.toString(), None => "None" }, "0.100000")
    assertEq(
        match parseFloat64("123456789.123456789") { Some(v) => v.toString(), None => "None" },
        "123456789.123457",
    )
    assertEq(
        match parseFloat64("1e3") { Some(v) => v.toString(), None => "None" },
        "1000.000000",
    )
    assertEq(
        match parseFloat64("-2.5E-1") { Some(v) => v.toString(), None => "None" },
        "-0.250000",
    )
    assertEq(match parseFloat64("1e400") { Some(v) => v.toString(), None => "None" }, "inf")
    assertEq(match parseFloat64("-1e400") { Some(v) => v.toString(), None => "None" }, "-inf")
    assertEq(match parseFloat64("1e-400") { Some(v) => v.toString(), None => "None" }, "0.000000")
    assertEq(match parseFloat64("x") { Some(v) => v.toString(), None => "None" }, "None")
    assertEq(match parseFloat64("") { Some(v) => v.toString(), None => "None" }, "None")
    assertEq(match parseFloat64("1.2.3") { Some(v) => v.toString(), None => "None" }, "None")
    assertEq(match parseFloat64("1e") { Some(v) => v.toString(), None => "None" }, "None")
}

/// The bit patterns, which is where a rounding bug actually shows: `%f`'s six
/// places hide everything below the sixth decimal, and every interesting
/// disagreement is in the last mantissa bit.
test "the mantissa bits are the correctly rounded ones" {
    // `0.1` is the canonical inexact decimal.
    assertEq(
        match parseFloat64("0.1") { Some(v) => floatBits(v).toString(), None => "None" },
        "4591870180066957722",
    )
    // A halfway case between two doubles: exactly representable in decimal, so
    // ties-to-even decides it and a naive round-half-up gets the last bit wrong.
    assertEq(
        match parseFloat64("9007199254740993") { Some(v) => floatBits(v).toString(), None => "None" },
        "4845873199050653696",
    )
    assertEq(
        match parseFloat64("9007199254740995") { Some(v) => floatBits(v).toString(), None => "None" },
        "4845873199050653698",
    )
    // The smallest subnormal, and half of it — which rounds to zero rather than
    // up, because a tie goes to even.
    assertEq(
        match parseFloat64("5e-324") { Some(v) => floatBits(v).toString(), None => "None" },
        "1",
    )
    assertEq(
        match parseFloat64("2.4703282292062327e-324") {
            Some(v) => floatBits(v).toString(),
            None => "None",
        },
        "0",
    )
    // The largest finite double, and the first value that rounds past it.
    assertEq(
        match parseFloat64("1.7976931348623157e308") {
            Some(v) => floatBits(v).toString(),
            None => "None",
        },
        "9218868437227405311",
    )
    assertEq(
        match parseFloat64("1.8e308") { Some(v) => floatBits(v).toString(), None => "None" },
        "9218868437227405312",
    )
}

test "single precision rounds once, not twice" {
    assertEq(match parseFloat32("0.1") { Some(v) => v.toString(), None => "None" }, "0.100000")
    assertEq(match parseFloat32("1e40") { Some(v) => v.toString(), None => "None" }, "inf")
    assertEq(match parseFloat32("1e-50") { Some(v) => v.toString(), None => "None" }, "0.000000")
}
