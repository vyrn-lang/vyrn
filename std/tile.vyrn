/// FNV-1a over the bits of `d`, in order.
fn tileHash(d: read Array<Int32, 256>) -> UInt64 {
    let mut h: UInt64 = 14695981039346656037
    for x in d {
        h = (h ^ UInt64(UInt32(x))) * 1099511628211
    }
    return h
}

/// `xs` with every element `v`.
fn filled8(xs: Array<Int8, 512>, v: Int8) -> Array<Int8, 512> {
    let mut out = xs
    let mut i = 0
    while i < 512 {
        out[i] = v
        i = i + 1
    }
    return out
}

/// `xs` with every element `v`.
fn filled32(xs: Array<Int32, 256>, v: Int32) -> Array<Int32, 256> {
    let mut out = xs
    let mut i = 0
    while i < 256 {
        out[i] = v
        i = i + 1
    }
    return out
}

test "a hand tile adds its two products where they meet" {
    let mut a = filled8(probeInt8A(), 0)
    let mut b = filled8(probeInt8B(), 0)
    a[0] = 2
    a[1] = 3
    b[0] = 5
    b[16] = 7
    b[19] = -4
    let d = mmaInt8(a, b, filled32(probeInt8C(), 10))
    assertEq(d[0], 41)
    assertEq(d[3], -2)
    assertEq(d[1], 10)
    assertEq(d[16], 10)
}

test "a sum wraps at both Int32 limits" {
    let ones = filled8(probeInt8A(), 1)
    let up = mmaInt8(ones, ones, filled32(probeInt8C(), 2147483647))
    assertEq(up[0], -2147483617)
    assertEq(up[255], -2147483617)
    let down = mmaInt8(ones, filled8(probeInt8B(), -1), filled32(probeInt8C(), -2147483648))
    assertEq(down[0], 2147483616)
    assertEq(down[255], 2147483616)
}

test "all-127 and all -128 tiles reach the largest sums" {
    let zero = filled32(probeInt8C(), 0)
    assertEq(mmaInt8(filled8(probeInt8A(), 127), filled8(probeInt8B(), 127), zero)[17], 516128)
    assertEq(mmaInt8(filled8(probeInt8A(), -128), filled8(probeInt8B(), -128), zero)[17], 524288)
    assertEq(mmaInt8(filled8(probeInt8A(), 127), filled8(probeInt8B(), -128), zero)[17], -520192)
    let mut a = probeUInt8A()
    let mut i = 0
    while i < 512 {
        a[i] = 255
        i = i + 1
    }
    assertEq(mmaUInt8(a, a, zero)[17], 2080800)
}

test "the probe's tiles give the bits NVIDIA's tensor cores gave" {
    assertEq(tileHash(mmaInt8(probeInt8A(), probeInt8B(), probeInt8C())), 11702607943763062848)
    assertEq(tileHash(mmaUInt8(probeUInt8A(), probeUInt8B(), probeUInt8C())), 9286561021062133952)
}
