/// Integer matrix tiles: `mmaInt8` and `mmaUInt8`, the CPU oracle a GPU tile
/// must equal bit for bit.
///
/// Each adds a 16 by 32 A tile of 8-bit integers times a 32 by 16 B tile to a
/// 16 by 16 `Int32` accumulator. Every tile is row-major, and the sums wrap as
/// `Int32` arithmetic does, never saturating, so integer addition modulo 2^32
/// leaves no order to differ in.

/// `acc` plus `a` times `b`, each element widened by `wide`: element (i, j) is
/// `acc[16i + j]` plus the sum over k below 32 of `a[32i + k] * b[16k + j]`.
fn mmaWith<T>(a: read Array<T, 512>, b: read Array<T, 512>, acc: Array<Int32, 256>, wide: fn(T) -> Int32) -> Array<Int32, 256> {
    let mut d = acc
    let mut i = 0
    while i < 16 {
        let mut j = 0
        while j < 16 {
            let mut s = d[16 * i + j]
            let mut k = 0
            while k < 32 {
                s = s + wide(a[32 * i + k]) * wide(b[16 * k + j])
                k = k + 1
            }
            d[16 * i + j] = s
            j = j + 1
        }
        i = i + 1
    }
    return d
}

/// `acc` plus `a` times `b` for `Int8` tiles: A is 16 by 32, B 32 by 16 and
/// `acc` 16 by 16, row-major. The sums wrap.
export fn mmaInt8(a: read Array<Int8, 512>, b: read Array<Int8, 512>, acc: Array<Int32, 256>) -> Array<Int32, 256> {
    return mmaWith(a, b, acc, x -> Int32(x))
}

/// `acc` plus `a` times `b` for `UInt8` tiles, shaped as for `mmaInt8`. The
/// sums wrap.
export fn mmaUInt8(a: read Array<UInt8, 512>, b: read Array<UInt8, 512>, acc: Array<Int32, 256>) -> Array<Int32, 256> {
    return mmaWith(a, b, acc, x -> Int32(x))
}

