/// std/graphql — the contract as a GraphQL SDL document (RFC-0038), a library
/// entirely on RFC-0021 generator imports. One `gen fn`, `sdl(contract)`,
/// reflects the contract with `moduleInterface` and RETURNS a synthesized module
/// exporting `sdlText() -> String`. The compiler knows nothing about GraphQL:
/// everything below is comptime-pure Vyrn string building over the reflected
/// type SOURCES and procedure signatures — the SDL is BAKED as a deterministic
/// constant at generation time (no runtime calls).
///
///   import { sdl } from "std/graphql"
///   import { sdlText } from sdl("./contract")
///   // sdlText() -> String : a deterministic GraphQL SDL document
///
/// Mapping rules (documented and DUMB on purpose — RFC-0038):
///   - a wire RECORD becomes a `type`/`input` PAIR (`Book` and `BookInput`);
///     GraphQL separates output objects from input objects, and both derive from
///     one Vyrn record. A record field's type maps by the scalar table below; a
///     non-`Option` field is non-null (`!`).
///   - SCALARS map honestly: `Int64` and the sized ints => `Int`, `Float64`/
///     `Float32` => `Float`, `String` => `String`, `Bool` => `Boolean`.
///   - a VALIDATED scalar (e.g. `BookId = Int64 where value >= 0`) becomes a
///     named custom `scalar` whose description documents its base and constraint
///     (the `@constraint`-style doc comment). Fields keep the name, so the type
///     graph stays legible and the constraint is documented once.
///   - `Map<String, V>` has no SDL type, so it maps to a documented custom
///     `scalar JSON` (a JSON object on the wire); a NAMED map alias becomes its
///     own documented `scalar`.
///   - a PAYLOAD enum (any variant carries data — including `Result<A, B>` and
///     `Circle(Int64)`) maps to a "tagged" object `type` with one NULLABLE field
///     per variant (nullary => `Boolean`, single payload => that type, multi
///     payload => `JSON`): exactly one field is non-null at a time. A nullary-only
///     enum maps to a real GraphQL `enum`.
///   - PROCEDURES become `Query`/`Mutation` fields: a `mut fn` is a Mutation,
///     everything else a Query. The split is the author's DECLARATION, read off
///     `FnInfo.mutates` (RFC-0074 M4a) — nothing here guesses from a name, so
///     renaming a procedure cannot silently move it between roots. A
///     1-parameter procedure takes `(input: <Req>Input)`; the return maps by the
///     table above. An empty `Mutation` is omitted.
///   - an OBJECT with no fields gets a `_placeholder: Boolean` field, wherever it
///     comes from — an empty query root, or a zero-field record (`type Empty =
///     {}`). GraphQL requires an object type to define at least one field, so
///     `type Empty {}` is a syntax error that poisons every field referencing it.
///     The executor bakes the same field into its graph and its resolver table,
///     so the field the document invents is one the endpoint answers.
///   - a NAME the document would define twice (a contract type called `Query`,
///     `Mutation` or `JSON`; a record `Foo` beside a type `FooInput`), or one
///     beginning with the introspection-reserved `__`, is REPORTED (RFC-0099)
///     and not repaired: these names are the wire surface, and renaming one is
///     the author's decision.
///   - `///` docs on TYPES become SDL descriptions. Procedure/param/module docs
///     are NOT in `moduleInterface` reflection, so operation descriptions are
///     absent (gap recorded in RFC-0038).
///
/// The EXECUTOR (RFC-0085 M1–M3) lives at the bottom of this file:
/// `graphqlServer` emits a `graphqlHandle(req) -> Option<Response>` answering
/// `POST /graphql` over the SAME `iface.functions` walk the SDL reads, so a field
/// the schema declares and a field the executor dispatches are one list. It bakes
/// the SDL's TYPE GRAPH beside the resolver table, out of the same `gqlMembers`
/// reading of each declaration the `type` definitions above are emitted from —
/// so an object type's fields are one set, not two that agree. The graph carries
/// each field's full type REFERENCE, `!` markers included, because those are what
/// say how far a `null` climbs when something faults under them (M3).
///
/// Inspect the synthesized module with:  vyrn emit-gen <file>

// ===========================================================================
// Byte / string helpers — comptime-pure, so legal in a `gen fn` and its callees.
// ===========================================================================

// The shared infallible-decode home (RFC-0059): every buffer decoded here is an
// ASCII transform / ASCII-boundary rebuild of already-valid UTF-8, so the `Err`
// arm is unreachable — routed through the one shared `fromBytesOr`.
import { fromBytesOr } from "std/strings"

// The executor's half (RFC-0085 M1). The value tree is what a projection is
// written over — see `gqlProject` — and the shared cursor is what the query
// language is parsed with (RFC-0054).
import { Json, JsonField, copyJson, copyJsonArray, emit } from "std/json"
import { parseJson } from "std/jsonread"
import { Scanner, scanner, skipWs, ident, peek, advance, atEnd, quotedString } from "std/scan"

// THE serializability rule (RFC-0072 M2), shared rather than restated — the
// executor calls `toJson` on a procedure's return exactly as `std/rpc` and
// `std/http` do, so it is governed by the same predicate they are. `std/http`
// imports it for the same reason.
import { validateContract } from "std/rpc"
import { contains, endsWith, slice, startsWith } from "std/strpred"

// A name the document would define twice, or an introspection-reserved name, is
// reported rather than repaired (RFC-0099) — see `gqlDefine`.
import { reportHere, Severity } from "std/diag"

/// The bytes `ba[s..e)` as a String ("" on the impossible non-UTF-8 slice).
fn gqlSlice(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut out: Array<UInt8> = []
    let mut i = s
    while i < e {
        out.push(ba[i])
        i = i + 1
    }
    return fromBytesOr(out, "")
}

/// True for an ASCII space, tab, CR, or LF.
fn gqlIsWs(b: UInt8) -> Bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

/// `s` with leading and trailing ASCII whitespace removed.
fn gqlTrim(s: String) -> String {
    let ba = bytes(s)
    let mut lo = 0
    let mut hi = ba.length
    while lo < hi && gqlIsWs(ba[lo]) {
        lo = lo + 1
    }
    while hi > lo && gqlIsWs(ba[hi - 1]) {
        hi = hi - 1
    }
    return gqlSlice(ba, lo, hi)
}

/// `s` without a trailing `!` (a GraphQL non-null marker) — used to make a
/// tagged-union field nullable.
fn gqlStripBang(s: String) -> String {
    if s.endsWith("!") {
        let ba = bytes(s)
        return gqlSlice(ba, 0, ba.length - 1)
    }
    return s.copy()
}

/// The inner text between the FIRST `<` and the LAST `>` of `s` (`Array<Tag>` =>
/// `Tag`, `Map<String, Int64>` => `String, Int64`). "" when there is no `<`.
fn gqlBetweenAngles(s: String) -> String {
    let ba = bytes(s)
    let mut lo = -1
    let mut hi = -1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '<' && lo < 0 {
            lo = i
        }
        if ba[i] == '>' {
            hi = i
        }
        i = i + 1
    }
    if lo < 0 || hi < 0 || hi <= lo {
        return ""
    }
    return gqlSlice(ba, lo + 1, hi)
}

/// Split `s` on the top-level occurrences of the separator byte `sep`, tracking
/// `<`/`(`/`[`/`{` nesting so a separator inside `Map<String, V>` or `C(A, B)`
/// does not split. STRING-LITERAL AWARE: a `"…"` run (as in an inline `where value
/// =~ "a,b}c"` predicate) is opaque — its bytes never open/close a bracket nor act
/// as a separator, and `\"` inside it is an escaped quote, not a delimiter. Bracket
/// depth is clamped at 0 so a stray closer inside malformed input can never drive
/// it negative and fabricate a phantom split. Empty parts are dropped; each result
/// is trimmed.
fn gqlSplitTop(s: String, sep: UInt8) -> Array<String> {
    let ba = bytes(s)
    let mut out: Array<String> = []
    let mut depth = 0
    let mut start = 0
    let mut inStr = false
    let mut i = 0
    while i < ba.length {
        let b = ba[i]
        if inStr {
            if b == '\\' {
                // A backslash escapes the next byte (e.g. `\"`); skip both.
                i = i + 2
            } else {
                if b == '"' {
                    inStr = false
                }
                i = i + 1
            }
        } else if b == '"' {
            inStr = true
            i = i + 1
        } else if b == '<' || b == '(' || b == '[' || b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '>' || b == ')' || b == ']' || b == '}' {
            if depth > 0 {
                depth = depth - 1
            }
            i = i + 1
        } else if b == sep && depth == 0 {
            let part = gqlTrim(gqlSlice(ba, start, i))
            if part.byteLength > 0 {
                out.push(part)
            }
            start = i + 1
            i = i + 1
        } else {
            i = i + 1
        }
    }
    let last = gqlTrim(gqlSlice(ba, start, ba.length))
    if last.byteLength > 0 {
        out.push(last)
    }
    return out
}

/// The index of the first `needle` byte in `ba` at or after `from`, or -1.
fn gqlIndexOf(ba: Array<UInt8>, needle: UInt8, from: Int64) -> Int64 {
    let mut i = from
    while i < ba.length {
        if ba[i] == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

// ===========================================================================
// Type-declaration parsing — pull (name, rhs) out of a `TypeInfo.source`, and
// classify / extract fields and variants. The source is canonical (RFC-0021
// `render_type_decl`): `export type Name = <rhs>`.
// ===========================================================================

/// A split declaration: its name and its right-hand side.
type GqlDecl = { name: String, rhs: String }

/// Split `export type Name = RHS` into its name and RHS (both trimmed). A generic
/// `Name<..>` keeps only the head `Name` (monomorphic wire types are assumed;
/// a parameterized type falls back to a scalar downstream).
fn gqlSplitDecl(source: String) -> GqlDecl {
    let s = gqlTrim(source)
    let ba = bytes(s)
    // Skip a leading `export `.
    let mut i = 0
    if s.startsWith("export ") {
        i = 7
    }
    // Skip `type `.
    i = i + 5
    // Find the ` = ` separator (the first top-level `=`).
    let eq = gqlIndexOf(ba, '=', i)
    if eq < 0 {
        return GqlDecl { name: gqlTrim(gqlSlice(ba, i, ba.length)), rhs: "" }
    }
    let head = gqlTrim(gqlSlice(ba, i, eq))
    // Strip any generic parameter list from the head.
    let lt = gqlIndexOf(bytes(head), '<', 0)
    let name = if lt < 0 { head } else { gqlSlice(bytes(head), 0, lt) }
    let rhs = gqlTrim(gqlSlice(ba, eq + 1, ba.length))
    return GqlDecl { name: name, rhs: rhs }
}

/// The `TypeInfo.source` of the named type, or "" when absent.
fn gqlSourceOf(name: String, iface: ModuleInterface) -> String {
    for t in iface.types {
        if t.name == name {
            return t.source.copy()
        }
    }
    return ""
}

/// Whether the named type is a RECORD (its RHS opens with `{`) — a record is the
/// one kind that needs an `Input` twin, so field references in input position add
/// the `Input` suffix.
fn gqlIsRecord(name: String, iface: ModuleInterface) -> Bool {
    let src = gqlSourceOf(name, iface)
    if src == "" {
        return false
    }
    return gqlSplitDecl(src).rhs.startsWith("{")
}

// ===========================================================================
// Scalar mapping — the honest table.
// ===========================================================================

/// The GraphQL scalar for a Vyrn primitive spelling, or "" when not a primitive.
fn gqlPrim(spelling: String) -> String {
    let s = gqlTrim(spelling)
    if s == "Int64" || s == "Int8" || s == "Int16" || s == "Int32" || s == "UInt8" || s == "UInt16" || s == "UInt32" || s == "UInt64" {
        return "Int"
    }
    if s == "Float64" || s == "Float32" || s == "Float" {
        return "Float"
    }
    if s == "String" {
        return "String"
    }
    if s == "Bool" {
        return "Boolean"
    }
    return ""
}

/// A GraphQL type REFERENCE (including non-null markers) for a Vyrn type
/// spelling, in output (`inputCtx == false`) or input (`inputCtx == true`)
/// position. `Option<T>` is the one nullable form; everything else is non-null.
fn gqlRef(spelling: String, inputCtx: Bool, iface: ModuleInterface) -> String {
    let s = gqlTrim(spelling)
    if s.startsWith("Option<") {
        return gqlStripBang(gqlRef(gqlBetweenAngles(s), inputCtx, iface))
    }
    if s.startsWith("Array<") {
        return "[" + gqlRef(gqlBetweenAngles(s), inputCtx, iface) + "]!"
    }
    if s.startsWith("Map<") {
        return "JSON!"
    }
    if s.startsWith("Result<") {
        return "JSON!"
    }
    let p = gqlPrim(s)
    if p != "" {
        return p + "!"
    }
    if inputCtx && gqlIsRecord(s, iface) {
        return s + "Input!"
    }
    return s + "!"
}

// ===========================================================================
// Descriptions — a type's `///` doc becomes an SDL block-string description.
// ===========================================================================

/// The raw (unwrapped, whitespace-folded) `///` doc text of a type, or "".
fn gqlRawDoc(name: String, iface: ModuleInterface) -> String {
    for t in iface.types {
        if t.name == name {
            return match t.schema.doc {
                Some(d) => gqlFoldWs(d),
                None => "",
            }
        }
    }
    return ""
}

/// The SDL description line for a type's doc (from `TypeInfo.schema.doc`), or "".
/// Emitted on its own line above the definition; newlines in the doc are folded
/// to spaces so it stays a single-line block string (dumb, safe).
fn gqlDocOf(name: String, iface: ModuleInterface) -> String {
    let raw = gqlRawDoc(name, iface)
    if raw == "" {
        return ""
    }
    return gqlDescBlock(raw)
}

/// A description text `body` as a well-formed GraphQL block-string description,
/// terminated with a newline. Sanitizes any bytes that would corrupt the `"""`
/// block per the GraphQL spec:
///   - an interior `"""` triple-quote is escaped as `\"""` (the ONLY block-string
///     escape the spec defines); a lone or double quote needs no escaping.
///   - a body that ENDS in `"` would abut the closing delimiter to make `""""`
///     (three-close-plus-stray), so such a body is emitted on its OWN line
///     (`"""\n<body>\n"""`) — the reference-`printBlockString` shape — which keeps
///     the trailing quote away from the delimiter while preserving the text.
///   - a body that ENDS in `\` is the SAME hazard read from the other side: the
///     closing `"""` would complete `\"""`, the one escape the spec defines, so
///     the block never closes and swallows every definition after it. The
///     trailing backslash gets the own-line treatment too, which puts a newline
///     between it and the delimiter. Only the LAST byte can do this — an interior
///     `\` before an escaped `"""` emits `\\"""`, which re-lexes as a literal
///     backslash then the escape, so it round-trips.
/// A body with neither a trailing quote nor a trailing backslash (the common
/// case) stays a single-line `"""<body>"""`, so an existing plain description is
/// byte-identical.
fn gqlDescBlock(body: String) -> String {
    let esc = gqlEscTripleQuote(body)
    if esc.endsWith("\"") || esc.endsWith("\\") {
        return "\"\"\"\n" + esc + "\n\"\"\"\n"
    }
    return "\"\"\"" + esc + "\"\"\"\n"
}

/// `s` with every `"""` run escaped as `\"""` (GraphQL block-string escaping). A
/// single or double quote is left as-is (legal block-string content).
fn gqlEscTripleQuote(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < ba.length {
        if i + 2 < ba.length && ba[i] == '"' && ba[i + 1] == '"' && ba[i + 2] == '"' {
            out.push('\\')
            out.push('"')
            out.push('"')
            out.push('"')
            i = i + 3
        } else {
            out.push(ba[i])
            i = i + 1
        }
    }
    return fromBytesOr(out, "")
}

/// `s` with every run of whitespace folded to a single space, trimmed — so a
/// multi-line `///` doc rides one SDL block-string line.
fn gqlFoldWs(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut prevWs = false
    for b in ba {
        if gqlIsWs(b) {
            if prevWs == false {
                out.push(' ')
            }
            prevWs = true
        } else {
            out.push(b)
            prevWs = false
        }
    }
    return gqlTrim(fromBytesOr(out, ""))
}

// ===========================================================================
// Type emission.
// ===========================================================================

/// One member of a GraphQL OBJECT type: its name and the type reference it maps
/// to, in output and in input position.
type GqlMember = { name: String, ref: String, inputRef: String }

/// The OBJECT members of a type declaration, and NONE when the declaration maps
/// to a leaf (a scalar, a validated alias, a `Map`, a nullary `enum`).
///
/// One reading of the RHS, and the only one. The SDL's object definitions below
/// and the executor's baked type graph (RFC-0085 M2) are both emitted from this,
/// so "which types have subfields, and which" is a single answer. Two walks that
/// happened to agree would be a query the document accepts and the executor
/// refuses, waiting on the first declaration shape they read differently.
///
/// Three shapes have members: a RECORD's fields; a PAYLOAD enum's variants, as
/// the tagged object one nullable field per variant (nullary => `Boolean`, single
/// payload => that type, multi => `JSON`); and a `Result<A, B>` alias's `Ok`/`Err`.
fn gqlMembers(decl: GqlDecl, iface: ModuleInterface) -> Array<GqlMember> {
    let rhs = gqlTrim(decl.rhs)
    if rhs.startsWith("{") {
        return gqlRecordMembers(rhs, iface)
    }
    if rhs.startsWith("|") {
        return gqlVariantMembers(rhs, iface)
    }
    if rhs.startsWith("Result<") {
        let parts = gqlSplitTop(gqlBetweenAngles(rhs), 44)
        let okT = if parts.length >= 1 { parts[0] } else { "Bool" }
        let errT = if parts.length >= 2 { parts[1] } else { "String" }
        return [gqlNullableMember("Ok", okT, iface), gqlNullableMember("Err", errT, iface)]
    }
    return []
}

/// A member whose GraphQL type is nullable — a tagged union's arm, of which
/// exactly one is non-null at a time.
fn gqlNullableMember(name: String, spelling: String, iface: ModuleInterface) -> GqlMember {
    return GqlMember {
        name: name.copy(),
        ref: gqlStripBang(gqlRef(spelling, false, iface)),
        inputRef: gqlStripBang(gqlRef(spelling, true, iface)),
    }
}

/// A record RHS's fields. A non-`Option` field is non-null; an inline ` where `
/// refinement is stripped, since the validated base is what maps to GraphQL.
fn gqlRecordMembers(rhs: String, iface: ModuleInterface) -> Array<GqlMember> {
    let mut out: Array<GqlMember> = []
    for f in gqlSplitTop(gqlBetweenBraces(rhs), 44) {
        let colon = gqlIndexOf(bytes(f), ':', 0)
        if colon >= 0 {
            let fname = gqlTrim(gqlSlice(bytes(f), 0, colon))
            let ftypeRaw = gqlTrim(gqlSlice(bytes(f), colon + 1, bytes(f).length))
            let ftype = gqlStripWhere(ftypeRaw)
            out.push(GqlMember {
                    name: fname,
                    ref: gqlRef(ftype, false, iface),
                    inputRef: gqlRef(ftype, true, iface),
                })
        }
    }
    return out
}

/// A payload enum RHS's variants as tagged-object members; NONE when every
/// variant is nullary, because that maps to a real GraphQL `enum` and an enum
/// value has no subfields.
fn gqlVariantMembers(rhs: String, iface: ModuleInterface) -> Array<GqlMember> {
    let variants = gqlVariantsOf(rhs)
    let mut anyPayload = false
    for v in variants {
        if v.contains("(") {
            anyPayload = true
        }
    }
    if anyPayload == false {
        return []
    }
    let mut out: Array<GqlMember> = []
    for v in variants {
        let paren = gqlIndexOf(bytes(v), '(', 0)
        if paren < 0 {
            out.push(GqlMember { name: gqlTrim(v), ref: "Boolean", inputRef: "Boolean" })
        } else {
            let vname = gqlTrim(gqlSlice(bytes(v), 0, paren))
            let parts = gqlSplitTop(gqlBetweenParens(v), 44)
            if parts.length == 1 {
                out.push(gqlNullableMember(vname, parts[0], iface))
            } else {
                out.push(GqlMember { name: vname, ref: "JSON", inputRef: "JSON" })
            }
        }
    }
    return out
}

/// The variants of an enum RHS (`| A | B(T)`), leading `|` dropped.
fn gqlVariantsOf(rhs: String) -> Array<String> {
    let body = gqlTrim(rhs)
    let stripped = if body.startsWith("|") {
        gqlTrim(gqlSlice(bytes(body), 1, bytes(body).length))
    } else {
        body
    }
    return gqlSplitTop(stripped, 124)
}

/// The `{ … }` BODY of an object or input definition, from its field lines.
///
/// The one place a member block is written, because there is one rule: GraphQL
/// requires an object type to define at least one field, so an empty body is a
/// syntax error (`Expected Name, found }`) that poisons the whole document —
/// every field referencing the type becomes unresolvable too. An empty body
/// therefore gets the `_placeholder: Boolean` field the query root has always
/// emitted for exactly this reason, and it gets it here rather than at the root,
/// so a zero-field RECORD (`type Empty = {}`) is answered the same way.
///
/// The repair is silent because the emitted document says what happened: the
/// placeholder field is visible in the SDL, and naming the type in a diagnostic
/// would need a SECOND reading of "which declarations are objects", which is the
/// divergence `gqlMembers` exists to prevent.
fn gqlBlock(fields: String) -> String {
    if fields == "" {
        return "{\n  _placeholder: Boolean\n}\n"
    }
    return "{\n" + fields + "}\n"
}

/// An object `type Name { .. }` definition from its members.
fn gqlObjectSdl(name: String, doc: String, ms: Array<GqlMember>) -> String {
    let mut fields = ""
    for m in ms {
        fields = fields + "  " + m.name + ": " + m.ref + "\n"
    }
    return doc + "type " + name + " " + gqlBlock(fields)
}

/// The SDL for a RECORD: the `type Name { .. }` object and the `input NameInput
/// { .. }` twin — GraphQL separates output objects from input objects, and both
/// derive from the one member list.
fn gqlRecord(decl: GqlDecl, doc: String, ms: Array<GqlMember>) -> String {
    let mut fields = ""
    for m in ms {
        fields = fields + "  " + m.name + ": " + m.inputRef + "\n"
    }
    return gqlObjectSdl(decl.name, doc, ms) + "input " + decl.name + "Input " + gqlBlock(fields)
}

/// The inner text between the outer `{` and `}` of a record RHS.
fn gqlBetweenBraces(s: String) -> String {
    let ba = bytes(s)
    let mut lo = -1
    let mut hi = -1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '{' && lo < 0 {
            lo = i
        }
        if ba[i] == '}' {
            hi = i
        }
        i = i + 1
    }
    if lo < 0 || hi <= lo {
        return ""
    }
    return gqlSlice(ba, lo + 1, hi)
}

/// A field type with any inline ` where <pred>` refinement stripped (the
/// validated base is what maps to GraphQL).
fn gqlStripWhere(s: String) -> String {
    if s.contains(" where ") {
        let ba = bytes(s)
        // Find " where " and cut before it.
        let mut i = 0
        while i + 7 <= ba.length {
            if gqlSlice(ba, i, i + 7) == " where " {
                return gqlTrim(gqlSlice(ba, 0, i))
            }
            i = i + 1
        }
    }
    return s.copy()
}

/// The SDL for a NULLARY enum RHS (`| A | B`): a real GraphQL `enum`. A payload
/// enum is an object type and goes through `gqlObjectSdl` instead, on the members
/// `gqlMembers` reads.
fn gqlEnum(decl: GqlDecl, doc: String) -> String {
    let mut out = doc + "enum " + decl.name + " {\n"
    for v in gqlVariantsOf(decl.rhs) {
        out = out + "  " + gqlTrim(v) + "\n"
    }
    return out + "}\n"
}

/// The inner text between the first `(` and last `)` of `s`.
fn gqlBetweenParens(s: String) -> String {
    let ba = bytes(s)
    let mut lo = -1
    let mut hi = -1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '(' && lo < 0 {
            lo = i
        }
        if ba[i] == ')' {
            hi = i
        }
        i = i + 1
    }
    if lo < 0 || hi <= lo {
        return ""
    }
    return gqlSlice(ba, lo + 1, hi)
}

/// The SDL for a LEAF declaration: a `Map<..>` alias, a validated scalar
/// (`Base where ..`), or a bare-primitive alias => a documented custom `scalar`.
/// The description carries the `///` doc AND the underlying base/constraint (the
/// `@constraint`-style doc comment), so a validated type is documented "as its
/// base + constraint". Named aliases keep their name.
fn gqlScalar(decl: GqlDecl, iface: ModuleInterface) -> String {
    let raw = gqlRawDoc(decl.name, iface)
    let folded = gqlFoldWs(gqlTrim(decl.rhs))
    let body = if raw != "" { raw + " — " + folded } else { folded }
    return gqlDescBlock(body) + "scalar " + decl.name + "\n"
}

/// The SDL for one type declaration. A record is an object plus its `input`
/// twin; anything else `gqlMembers` finds members for is an object (a payload
/// enum, a `Result` alias); a nullary enum is an `enum`; everything left is a
/// leaf, and a leaf is exactly what has no subfields to select.
fn gqlTypeSdl(t: TypeInfo, iface: ModuleInterface) -> String {
    let decl = gqlSplitDecl(t.source)
    let doc = gqlDocOf(decl.name, iface)
    let ms = gqlMembers(decl, iface)
    if decl.rhs.startsWith("{") {
        return gqlRecord(decl, doc, ms)
    }
    if ms.length > 0 {
        return gqlObjectSdl(decl.name, doc, ms)
    }
    if decl.rhs.startsWith("|") {
        return gqlEnum(decl, doc)
    }
    return gqlScalar(decl, iface)
}

// ===========================================================================
// The names one document defines.
// ===========================================================================

/// One definition the document makes: the NAME it defines, and the route that
/// defined it — a route is what a collision message has to name, because which
/// of the two an author meant is exactly what the generator does not know.
type GqlDef = { name: String, from: String }

/// The names one type declaration defines: its own, and — for a RECORD — the
/// `Input` twin. Split by the SAME `decl.rhs.startsWith("{")` verdict
/// `gqlTypeSdl` emits by, so the list of names defined and the definitions
/// emitted are one answer.
fn gqlDeclNames(t: TypeInfo) -> Array<String> {
    let decl = gqlSplitDecl(t.source)
    if decl.rhs.startsWith("{") {
        return [decl.name.copy(), decl.name + "Input"]
    }
    return [decl.name.copy()]
}

/// The route already holding `name`, or `""` — the linear scan a document's
/// handful of type names deserves.
fn gqlDefinedBy(defs: Array<GqlDef>, name: String) -> String {
    for d in defs {
        if d.name == name {
            return d.from.copy()
        }
    }
    return ""
}

/// Register one definition, and REPORT (RFC-0099) rather than repair when the
/// name is already taken: a GraphQL document may not define one name twice, and
/// the second definition is rejected by every parser.
///
/// An `Error`, not a rename: these names are the contract's WIRE surface, and a
/// generator that quietly renames a type an author declared changes what every
/// client queries. Which of the two colliding definitions gives way is the
/// author's decision — the same reading `std/ui` records for two routes that
/// reach one helper name.
fn gqlDefine(defs: modify Array<GqlDef>, name: String, from: String) -> String {
    let taken = gqlDefinedBy(defs, name)
    if taken != "" {
        return reportHere(
            Error,
            "the GraphQL document would define `\{name}` twice — \{taken}, and \{from}; a document may not define one name twice, so rename the contract's type",
        )
    }
    defs.push(GqlDef { name: name.copy(), from: from.copy() })
    return ""
}

/// A contract type name GraphQL reserves: `__` is the introspection prefix, and
/// a name carrying it is refused by a parser. Checked once per DECLARATION, not
/// once per definition — the `Input` twin's name is the declaration's, so one
/// mistake gets one diagnostic.
fn gqlReservedName(name: String) -> String {
    if name.startsWith("__") {
        return reportHere(
            Error,
            "the GraphQL document would define `\{name}` — a name beginning with `__` is reserved for introspection, so rename the contract's type",
        )
    }
    return ""
}

// ===========================================================================
// Root fields.
// ===========================================================================

/// The ROOT a procedure's field belongs under, lowercase as a GraphQL operation
/// type is spelled: `"mutation"` for a `mut fn`, `"query"` for everything else.
///
/// The author's DECLARATION, read off `FnInfo.mutates` (RFC-0074 M4a) — and read
/// in ONE place, because the SDL emitter below and the executor's resolver table
/// (RFC-0085 M1) both need it. Two copies of this two-line rule is exactly the
/// divergence where a field is declared under one root and answered under the
/// other.
fn gqlRootOf(f: FnInfo) -> String {
    if f.mutates {
        return "mutation"
    }
    return "query"
}

/// The GraphQL root TYPE name for an operation type (`query` => `Query`).
export fn gqlRootType(root: String) -> String {
    if root == "mutation" {
        return "Mutation"
    }
    return "Query"
}

/// One root field for a procedure: `name(input: <Req>Input): <Ret>` (or no args
/// for a zero-parameter procedure). A `Unit` return maps to `Boolean`, and the
/// resolver honors it: the procedure runs, then the field resolves `true` —
/// the same verdict Connect's client gives a Unit procedure (`gqlResolverTable`).
fn gqlRootField(f: FnInfo, iface: ModuleInterface) -> String {
    let ret = if f.ret == "" { "Boolean" } else { gqlStripBang(gqlRef(f.ret, false, iface)) }
    if f.params.length == 1 {
        let arg = gqlRef(f.params[0].spelling, true, iface)
        return "  " + f.name + "(input: " + arg + "): " + ret + "\n"
    }
    return "  " + f.name + ": " + ret + "\n"
}

/// The NAMED type inside a GraphQL type reference (`[Book]!` => `Book`): what a
/// selection descends INTO, once the list and non-null wrappers are off. The
/// projector walks a list transparently, so a list of `Book` and a `Book` ask the
/// type graph the same question.
fn gqlNamed(r: String) -> String {
    let ba = bytes(r)
    let mut out: Array<UInt8> = []
    for b in ba {
        if b != '[' && b != ']' && b != '!' {
            out.push(b)
        }
    }
    return fromBytesOr(out, r)
}

/// A root type's members: one per procedure under `root`, naming the type its
/// result is projected against. Split by the SAME `gqlRootOf` verdict
/// `gqlRootField` reads, so `type Query` and the graph's `Query` list one set of
/// fields.
fn gqlRootMembers(iface: ModuleInterface, root: String) -> Array<GqlMember> {
    let mut out: Array<GqlMember> = []
    for f in iface.functions {
        if gqlRootOf(f) == root {
            let ret = if f.ret == "" { "Bool" } else { f.ret }
            out.push(gqlNullableMember(f.name, ret, iface))
        }
    }
    return out
}

/// The stand-in member `gqlBlock` writes into an otherwise empty object body:
/// the SDL's `_placeholder: Boolean`. The executor bakes the same member into
/// the type graph (and, at an empty query root, into the resolver table), so
/// the field the document invents to stay parseable is one the endpoint
/// answers rather than one it refuses.
fn gqlPlaceholderMember() -> GqlMember {
    return GqlMember { name: "_placeholder", ref: "Boolean", inputRef: "Boolean" }
}

// ===========================================================================
// The generator.
// ===========================================================================

/// `sdl(contract)` — emit a module exporting `sdlText() -> String`, a GraphQL SDL
/// document for the contract. The document is baked as a deterministic constant.
export gen fn sdl(contract: String) -> String {
    let iface = moduleInterface(contract)
    let mut doc = "# GraphQL SDL generated by std/graphql `sdl` (RFC-0038).\n"
    doc = doc + "# Records => type/input pairs; validated scalars => custom scalars\n"
    doc = doc + "# (base + constraint in the description); Map => the JSON scalar;\n"
    doc = doc + "# payload enums (incl. Result) => tagged objects (one nullable\n"
    doc = doc + "# field per variant); a `mut fn` => Mutation, else Query.\n"
    // The JSON scalar (documented) — the honest stand-in for `Map<String, V>`.
    doc = doc + "\"\"\"An arbitrary JSON value — the wire form of a Vyrn Map<String, V>.\"\"\"\n"
    doc = doc + "scalar JSON\n"

    // Every name the document defines, and the route that defined it — a repeat
    // is refused rather than emitted (`gqlDefine`).
    let mut defs: Array<GqlDef> = []
    let mut diags = gqlDefine(defs, "JSON", "the built-in JSON scalar")

    // Types, in the reflection's deterministic order.
    for t in iface.types {
        doc = doc + gqlTypeSdl(t, iface)
        let dname = gqlSplitDecl(t.source).name
        diags = diags + gqlReservedName(dname)
        for n in gqlDeclNames(t) {
            let from = if n == dname {
                "the contract's type `\{dname}`"
            } else {
                "the input twin of the contract's record `\{dname}`"
            }
            diags = diags + gqlDefine(defs, n, from)
        }
    }

    // Query / Mutation roots.
    let mut queries = ""
    let mut mutations = ""
    for f in iface.functions {
        if gqlRootOf(f) == "mutation" {
            mutations = mutations + gqlRootField(f, iface)
        } else {
            queries = queries + gqlRootField(f, iface)
        }
    }
    doc = doc + "type Query " + gqlBlock(queries)
    diags = diags + gqlDefine(defs, "Query", "the generated query root")
    if mutations != "" {
        doc = doc + "type Mutation " + gqlBlock(mutations)
        diags = diags + gqlDefine(defs, "Mutation", "the generated mutation root")
    }

    // Bake the whole SDL string into the emitted module via a `vyrn"…"` code
    // quote (RFC-0054). The `\{doc}` splice is in EXPRESSION position, so `doc`
    // becomes an escaped Vyrn string LITERAL by construction — the compiler's own
    // escaping replaces the hand-rolled `gqlEscBody` byte loop, so a mis-escape
    // (an unescaped `"`/`\`/newline corrupting the baked SDL) is unrepresentable.
    //
    // Any `//@diag` the name registry produced rides in FRONT of the module, so
    // a document that cannot be defined fails the build with the generator's own
    // wording rather than reaching a parser as a duplicate definition.
    return diags + render(vyrn"""/// Generated by std/graphql `sdl` (RFC-0038) — do not edit.
/// The contract's GraphQL SDL document (deterministic, byte-stable).
export fn sdlText() -> String {
    return \{doc}
}
""")
}

// ===========================================================================
// The executor (RFC-0085 M1) — RUNTIME code, not generation.
//
// Everything above this line runs at comptime and bakes a document. Everything
// below runs in the served process: it parses one request's query, projects the
// value a procedure returned, and writes the reply. It lives in this file so the
// generated module is nothing but an import block and a resolver table — the
// same division `std/ui` draws when its generated pages import `PageError` back
// from `std/ui`.
// ===========================================================================

/// One selected field: the RESPONSE KEY the answer arrives under (the alias when
/// one was written, else the field name), the field it names, its arguments as
/// the value tree `fromJson` reads, and whatever it selects in turn.
///
/// The key is stored rather than the alias, because every consumer wants the key
/// and nothing wants to ask whether one was written.
export type GqlSel = {
    key: String,
    name: String,
    args: Array<JsonField>,
    subs: Array<GqlSel>,
}

/// A selection owns what it selects, and says so — RFC-0096.
///
/// `GqlSel` reaches itself through `subs`, so the structural release walk has no
/// bottom and every parsed selection stayed allocated for the life of the
/// process. A declared release IS the bottom: the walk emits a call here, and
/// this function makes the recursion the walk cannot. `drop subs` releases each
/// element by calling this again, one level down.
///
/// The shape is `std/slots`'s. Each line TAKES its field (RFC-0093 M1) rather
/// than reading it, because a release moves the buffer out and gives it back,
/// and dropping a field READ would hand one buffer back twice.
///
/// `args` gives back its buffer alone. `JsonField` reaches `Json`, which
/// declares nothing, so its elements are the leak `std/json` still carries.
impl Owned for GqlSel {
    fn release(consume self) {
        let key = consume self.key
        drop key
        let name = consume self.name
        drop name
        let args = consume self.args
        drop args
        let subs = consume self.subs
        drop subs
    }
}

/// A parsed selection set, or the reason it would not parse (`err != ""`).
type GqlSet = { sels: Array<GqlSel>, err: String }

/// A parsed operation: its root (`"query"` / `"mutation"`), its selected fields,
/// and the reason it would not parse (`err != ""`).
export type GqlQuery = { root: String, sels: Array<GqlSel>, err: String }

/// The GraphQL flavor of the shared cursor (RFC-0054): `#` line comments, `"`
/// strings with `\` escapes, no block comments — the query language's own
/// lexical rules, so a `{` inside a string argument is never read as structure.
fn gqlScanner(src: String) -> Scanner {
    return scanner(src, "#", "", "", 34, -1, 92)
}

/// Whether the cursor sits on byte `b`.
fn gqlAt(sc: Scanner, b: UInt8) -> Bool {
    return peek(sc) == Int64(b)
}

/// A failed parse carrying `why`.
fn gqlSetErr(why: String) -> GqlSet {
    return GqlSet { sels: [], err: why.copy() }
}

// ---- argument values -------------------------------------------------------

/// A parsed argument value, or the reason it would not parse (`err != ""`).
type GqlVal = { value: Json, err: String }

/// A parsed argument list, or the reason it would not parse (`err != ""`).
type GqlArgs = { args: Array<JsonField>, err: String }

/// A failed value parse carrying `why`.
fn gqlValErr(why: String) -> GqlVal {
    return GqlVal { value: JNull, err: why.copy() }
}

/// Whether `b` can appear inside a GraphQL number token.
fn gqlIsNumByte(b: Int64) -> Bool {
    return (b >= 48 && b <= 57) || b == 45 || b == 43 || b == 46 || b == 101 || b == 69
}

/// Parse one GraphQL input value into the JSON value tree.
///
/// GraphQL's argument syntax is NOT JSON — an input-object key is unquoted and an
/// enum value is a bare word — but what an argument MEANS is a JSON value, and
/// that is the form `fromJson` already decodes into a procedure's input record.
/// So the structure is read here and the two forms with a lexical definition
/// worth getting exactly right are not: a string literal and a number token are
/// handed to `std/json`'s own reader over their source span, rather than a second
/// escape decoder and a second number grammar that could disagree with the ones
/// every other value in this system goes through.
fn gqlValue(sc: modify Scanner, depth: Int64) -> GqlVal {
    skipWs(sc)
    if atEnd(sc) {
        return gqlValErr("expected a value")
    }
    if gqlAt(sc, '$') {
        advance(sc)
        return gqlValErr("variable `$" + ident(sc) + "`: variables are not supported")
    }
    if gqlAt(sc, '"') {
        let start = sc.pos
        let _ = quotedString(sc)
        let lit = slice(sc.src, start, sc.pos) ?? ""
        return match parseJson(lit) {
            Ok(v) => GqlVal { value: v, err: "" },
            Err(e) => gqlValErr("malformed string value: " + e),
        }
    }
    if gqlAt(sc, '[') || gqlAt(sc, '{') {
        if depth >= gqlMaxDepth() {
            return gqlValErr(gqlTooDeep())
        }
    }
    if gqlAt(sc, '[') {
        return gqlListValue(sc, depth + 1)
    }
    if gqlAt(sc, '{') {
        return gqlObjectValue(sc, depth + 1)
    }
    let b = peek(sc)
    if b == 45 || (b >= 48 && b <= 57) {
        return gqlNumberValue(sc)
    }
    let word = ident(sc)
    if word == "" {
        return gqlValErr("expected a value")
    }
    if word == "true" {
        return GqlVal { value: JBool(true), err: "" }
    }
    if word == "false" {
        return GqlVal { value: JBool(false), err: "" }
    }
    if word == "null" {
        return GqlVal { value: JNull, err: "" }
    }
    // Anything else is an enum value, which is its own name on the wire.
    return GqlVal { value: JStr(word), err: "" }
}

/// The deepest nesting `gqlParseQuery` accepts — 128 enclosing selection sets,
/// list values or input objects.
///
/// A query arrives from a client, and this parser descends per level with no
/// budget of its own: `{a{a{a…}}}` reaches the engine's 1000-frame call cap and
/// TRAPS, which takes the serving process down rather than answering the `err`
/// this parser reports every other malformed query through. The same limit and
/// the same reasoning as `std/jsonread`'s `maxDepth`, which the value parser
/// already leans on for numbers and strings. A real query nests a handful of
/// levels deep.
fn gqlMaxDepth() -> Int64 {
    return 128
}

/// The one wording for the one rule, so a selection set and an argument value
/// refuse alike.
fn gqlTooDeep() -> String {
    return "nesting deeper than " + gqlMaxDepth().toString() + " levels"
}

/// A number token, validated by the same reader that validates one in a body.
fn gqlNumberValue(sc: modify Scanner) -> GqlVal {
    let start = sc.pos
    while atEnd(sc) == false && gqlIsNumByte(peek(sc)) {
        advance(sc)
    }
    let tok = slice(sc.src, start, sc.pos) ?? ""
    return match parseJson(tok) {
        Ok(v) => GqlVal { value: v, err: "" },
        Err(e) => gqlValErr("malformed number `" + tok + "`"),
    }
}

/// A list value `[a, b]`. Commas are insignificant, as everywhere else.
fn gqlListValue(sc: modify Scanner, depth: Int64) -> GqlVal {
    advance(sc)
    let mut items: Array<Json> = []
    skipWs(sc)
    while atEnd(sc) == false && gqlAt(sc, ']') == false {
        if gqlAt(sc, ',') {
            advance(sc)
            skipWs(sc)
            continue
        }
        let v = gqlValue(sc, depth)
        if v.err != "" {
            return v
        }
        items.push(consume v.value)
        skipWs(sc)
    }
    if gqlAt(sc, ']') == false {
        return gqlValErr("unterminated list value: expected `]`")
    }
    advance(sc)
    return GqlVal { value: JArr(items), err: "" }
}

/// An input-object value `{ a: 1, b: "x" }` — the shape a procedure's input
/// record arrives as. The keys are unquoted here and quoted on the wire, which is
/// the whole of the difference `emit` then removes.
fn gqlObjectValue(sc: modify Scanner, depth: Int64) -> GqlVal {
    advance(sc)
    let mut fields: Array<JsonField> = []
    skipWs(sc)
    while atEnd(sc) == false && gqlAt(sc, '}') == false {
        if gqlAt(sc, ',') {
            advance(sc)
            skipWs(sc)
            continue
        }
        let key = ident(sc)
        if key == "" {
            return gqlValErr("expected a field name in an input object")
        }
        skipWs(sc)
        if gqlAt(sc, ':') == false {
            return gqlValErr("input object field `" + key + "`: expected `:`")
        }
        advance(sc)
        let v = gqlValue(sc, depth)
        if v.err != "" {
            return v
        }
        fields.push(JsonField { key: key, value: consume v.value })
        skipWs(sc)
    }
    if gqlAt(sc, '}') == false {
        return gqlValErr("unterminated input object: expected `}`")
    }
    advance(sc)
    return GqlVal { value: JObj(fields), err: "" }
}

/// Parse an argument list, the cursor sitting on its opening `(`.
///
/// It returns the `{ args, err }` pair. The caller writes `consume parsed.args`
/// to move the list out of it (RFC-0093). RFC-0092 M1 had to make it an
/// out-parameter, because reading `parsed.args` was a projection and
/// `Array<JsonField>` reaches `Json`, which refers to itself and has no
/// structural copy.
fn gqlArgList(sc: modify Scanner, depth: Int64) -> GqlArgs {
    advance(sc)
    let mut out: Array<JsonField> = []
    // A Map, not a list: the duplicate test runs once per argument, and a
    // linear scan made the whole list O(k²) — the census's graphql row 7,
    // closed the day the hashed lookup existed (RFC-0116).
    let mut names: Map<String, Bool> = [:]
    skipWs(sc)
    while atEnd(sc) == false && gqlAt(sc, ')') == false {
        if gqlAt(sc, ',') {
            advance(sc)
            skipWs(sc)
            continue
        }
        let name = ident(sc)
        if name == "" {
            return GqlArgs { args: [], err: "expected an argument name" }
        }
        if let Some(_) = names[name] {
            return GqlArgs { args: [], err: "duplicate argument `" + name + "`" }
        }
        names[name.copy()] = true
        skipWs(sc)
        if gqlAt(sc, ':') == false {
            return GqlArgs { args: [], err: "argument `" + name + "`: expected `:`" }
        }
        advance(sc)
        let v = gqlValue(sc, depth)
        if v.err != "" {
            return GqlArgs { args: [], err: consume v.err }
        }
        out.push(JsonField { key: name, value: consume v.value })
        skipWs(sc)
    }
    if gqlAt(sc, ')') == false {
        return GqlArgs { args: [], err: "unterminated argument list: expected `)`" }
    }
    advance(sc)
    return GqlArgs { args: out, err: "" }
}

/// Parse a selection set, the cursor sitting on its opening `{`.
///
/// Commas are insignificant in GraphQL — the spec lists them with whitespace —
/// so they are skipped rather than required.
fn gqlSelSet(sc: modify Scanner, depth: Int64) -> GqlSet {
    if gqlAt(sc, '{') == false {
        return gqlSetErr("expected `{` to open a selection set")
    }
    advance(sc)
    let mut out: Array<GqlSel> = []
    // Same shape, same reason as `gqlArgList`'s `names`: one hashed lookup
    // per response key instead of a scan over every earlier sibling.
    let mut keys: Map<String, Bool> = [:]
    skipWs(sc)
    while atEnd(sc) == false && gqlAt(sc, '}') == false {
        if gqlAt(sc, ',') {
            advance(sc)
            skipWs(sc)
            continue
        }
        let first = ident(sc)
        if first == "" {
            return gqlSetErr("expected a field name in a selection set")
        }
        skipWs(sc)
        // `key: field` — the alias renames the answer and nothing else; the field
        // it names is what the resolver table and the type graph are asked about.
        let mut name = first.copy()
        if gqlAt(sc, ':') {
            advance(sc)
            skipWs(sc)
            name = ident(sc)
            if name == "" {
                return gqlSetErr("alias `" + first + "`: expected the field it renames")
            }
            skipWs(sc)
        }
        // One response key, once: the reply is JSON keyed by these, and a key
        // written twice (`{ x: a x: b }`) would put `x` in the reply twice —
        // GraphQL refuses a duplicated response name instead.
        if let Some(_) = keys[first] {
            return gqlSetErr("duplicate response key `" + first + "` in a selection set")
        }
        keys[first.copy()] = true
        let mut args: Array<JsonField> = []
        if gqlAt(sc, '(') {
            let parsed = gqlArgList(sc, depth)
            if parsed.err != "" {
                return gqlSetErr("field `" + name + "`: " + parsed.err)
            }
            args = consume parsed.args
            skipWs(sc)
        }
        let mut subs: Array<GqlSel> = []
        if gqlAt(sc, '{') {
            if depth >= gqlMaxDepth() {
                return gqlSetErr(gqlTooDeep())
            }
            let inner = gqlSelSet(sc, depth + 1)
            if inner.err != "" {
                return inner
            }
            subs = consume inner.sels
        }
        out.push(GqlSel { key: first, name: name, args: args, subs: subs })
        skipWs(sc)
    }
    if gqlAt(sc, '}') == false {
        return gqlSetErr("unterminated selection set: expected `}`")
    }
    advance(sc)
    if out.length == 0 {
        return gqlSetErr("a selection set must select at least one field")
    }
    return GqlSet { sels: out, err: "" }
}

/// Parse one executable operation: an optional `query`/`mutation` keyword and
/// operation name, then a selection set. Anything past it is a second operation,
/// which needs `operationName` to choose between — RFC-0085 M2.
export fn gqlParseQuery(src: String) -> GqlQuery {
    let mut sc = gqlScanner(src)
    skipWs(sc)
    let mut root = "query"
    if gqlAt(sc, '{') == false {
        let kw = ident(sc)
        if kw == "" {
            return GqlQuery { root: root, sels: [], err: "the request carried no query" }
        }
        if kw != "query" && kw != "mutation" {
            return GqlQuery {
                root: root,
                sels: [],
                err: "expected `{`, `query` or `mutation`, found `" + kw + "`",
            }
        }
        root = kw
        skipWs(sc)
        // The operation NAME, which nothing selects between at M1.
        let _ = ident(sc)
        skipWs(sc)
        // A variable definition list. An argument is a literal here — nothing
        // substitutes the envelope's `variables` into one — so `($id: Int)` is
        // refused where it is written rather than silently ignored, which would
        // leave every use of `$id` a bare enum value.
        if gqlAt(sc, '(') {
            return GqlQuery { root: root, sels: [], err: "variable definitions are not supported" }
        }
    }
    let set = gqlSelSet(sc, 1)
    if set.err != "" {
        return GqlQuery { root: root, sels: [], err: consume set.err }
    }
    skipWs(sc)
    if atEnd(sc) == false {
        return GqlQuery {
            root: root,
            sels: [],
            err: "a document with more than one operation is not supported",
        }
    }
    return GqlQuery { root: root, sels: consume set.sels, err: "" }
}

// ---- projection ------------------------------------------------------------

/// The index of `key` among `fields`, or -1. The projection reads the member
/// IN PLACE through it — `gqlMemberOf` answered a `copyJson` of the whole
/// remaining subtree per object level (a return is owned), which was the
/// census's graphql row 12, O(bytes × depth) for a walk that only reads.
fn gqlFieldIndex(fields: Array<JsonField>, key: String) -> Int64 {
    let mut i = 0
    while i < fields.length {
        if fields[i].key == key {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// "" when `field` — declared on `owner`, of named type `ty` — may be selected
/// as written, else the GraphQL error refusing it.
///
/// This is the whole of what the TYPE GRAPH answers and the value cannot. M1's
/// projector held only the value, and `toJson` OMITS an `Option` field that is
/// `None`, so absence-in-the-value and absence-from-the-schema were one
/// observation: an undeclared member had to answer `null`, and a selection on a
/// scalar had to be let through. `schema` separates them — `schema(owner, field)`
/// is "" only when the schema does not declare the field, and `schema(ty, "")` is
/// "" only when `ty` has no subfields to select.
fn gqlCheckSel(
    owner: String,
    field: String,
    ty: String,
    hasSubs: Bool,
    schema: fn(String, String) -> String,
) -> String {
    if ty == "" {
        return "Cannot query field `" + field + "` on type `" + owner + "`."
    }
    if hasSubs && schema(ty, "") == "" {
        return "Field `" + field + "` must not have a selection since type `" + ty
        + "` has no subfields."
    }
    return ""
}

/// One GraphQL error: its message and the RESPONSE PATH it happened at — the
/// response keys and list indices from the root down to the position that
/// faulted (RFC-0085 M3), which is how a client finds it inside a partial `data`.
///
/// A path element is a NAME or an INDEX in ONE array, and the value tree says
/// that directly: a `JStr` and a `JNum` in a single `JArr`. Nothing had to be
/// invented for the mixed array and no index is stringified to fit.
export type GqlErr = { message: String, path: Array<Json> }

/// A completed field position: its value, every error found at or below it, and
/// whether the `null` is still CLIMBING (`failed`) — which is what a NON-NULL
/// position does with a fault, because `null` may not sit there.
export type GqlOut = { value: Json, errs: Array<GqlErr>, failed: Bool }

/// A position that completed with nothing wrong.
fn gqlOk(v: consume Json) -> GqlOut {
    return GqlOut { value: v, errs: [], failed: false }
}

/// A fault AT one position: `null` here, and it starts climbing when `tref` says
/// this position may not hold one. Where a climb STOPS is `gqlProject`'s single
/// decision; this is only where one begins.
fn gqlFaultAt(message: String, at: Array<Json>, tref: String) -> GqlOut {
    let mut path: Array<Json> = []
    for p in at {
        path.push(copyJson(p))
    }
    return GqlOut {
        value: JNull,
        errs: [GqlErr { message: message.copy(), path: path }],
        failed: tref.endsWith("!"),
    }
}

/// A `GqlErr` that shares nothing with its source. `Json` refers to itself, so
/// `copy` refuses it (RFC-0089 M1b) and `std/json`'s `copyJson` is the worked
/// answer; this is the same answer one level up.
fn gqlCopyErr(e: GqlErr) -> GqlErr {
    let mut path: Array<Json> = []
    for p in e.path {
        path.push(copyJson(p))
    }
    return GqlErr { message: e.message.copy(), path: path }
}

/// `gqlCopyErr` over a list. `errs.copy()` cannot be written: the structural
/// copy reaches `Json`, which refers to itself.
fn copyGqlErrs(es: Array<GqlErr>) -> Array<GqlErr> {
    let mut out: Array<GqlErr> = []
    for e in es {
        out.push(gqlCopyErr(e))
    }
    return out
}

/// `path` with one more step — a response key or a list index.
fn gqlStep(path: Array<Json>, step: Json) -> Array<Json> {
    let mut out: Array<Json> = []
    for p in path {
        out.push(copyJson(p))
    }
    out.push(copyJson(step))
    return out
}

/// The ELEMENT reference of a list reference (`[Book!]` => `Book!`), else `r`.
fn gqlElemRef(r: String) -> String {
    if r.startsWith("[") && r.endsWith("]") {
        let ba = bytes(r)
        return gqlSlice(ba, 1, ba.length - 1)
    }
    return r.copy()
}

/// Complete one field position: project `sels` out of `v` at response `path`,
/// against `tref` — the field's GraphQL type REFERENCE, list and non-null
/// wrappers included.
///
/// **Field selection is a projection over a value the procedure ALREADY
/// returned, not a fetch plan.** `v` arrives here fully computed — every field of
/// it, selected or not, was produced by the procedure and encoded before this
/// function saw it. So at a leaf this OMITS; it does not avoid computing. Nothing
/// below is lazy and a reader must not read it as if it were.
///
/// That distinction is the one RFC-0074 M4b's `.lazy(field, resolver)` later has
/// to break: a lazy field is the single case where omission must ALSO mean the
/// work was never done. Stated here because if it is only stated then, `.lazy(..)`
/// is an optimisation nobody can observe and there is nothing to point at.
///
/// **Null-bubbling (RFC-0085 M3).** A fault does not fail the request: it becomes
/// a `null` at the position it happened, and the SDL's own `!` markers say how far
/// that `null` has to climb. This function is the ONE place a climb stops — when
/// the position it is passing through may hold a `null`. Everything below just
/// reports `failed` upward, so the rule is read in one place rather than
/// re-decided at each shape.
///
/// An empty selection set means "this field is a leaf" — take the value whole.
export fn gqlProject(
    v: Json,
    sels: Array<GqlSel>,
    tref: String,
    path: Array<Json>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    let r = gqlProjectCore(v, sels, gqlStripBang(tref), path, schema)
    if r.failed && tref.endsWith("!") == false {
        // Nullable: the climb stops here and this position is the `null`.
        return GqlOut { value: JNull, errs: copyGqlErrs(r.errs), failed: false }
    }
    return r
}

/// The shape-driven half of a position, with the outer non-null wrapper already
/// off: a list walks its elements, an object picks its members, a leaf answers
/// itself.
/// `gqlPick` over the NAMED form of `core` — bound here so the stripped
/// name is a binding with a release, not an inline temporary (exit-residue
/// round twelve's probe site).
fn gqlPickNamed(
    fields: Array<JsonField>,
    sels: Array<GqlSel>,
    core: String,
    path: Array<Json>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    let named = gqlNamed(core)
    return gqlPick(fields, sels, named, path, schema)
}

fn gqlProjectCore(
    v: Json,
    sels: Array<GqlSel>,
    core: String,
    path: Array<Json>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    if sels.length == 0 {
        // A leaf position answers itself, and `v` is the caller's — `gqlOk` takes
        // what it is handed, so the value that goes in must be this frame's. A
        // `Json` refers to itself and has no `.copy()`, which is why the
        // hand-written deep copy is the one on this line too.
        return gqlOk(copyJson(v))
    }
    return match v {
        JArr(items) => gqlProjectEach(items, sels, gqlElemRef(core), path, schema),
        JObj(fields) => gqlPickNamed(fields, sels, core, path, schema),
        // `null` with a selection on it is an ordinary nullable object field that
        // came back absent, and it stays `null`. The other three cannot be reached
        // with a selection: `gqlCheckSel` refused it against the type before the
        // walk descended here. They answer themselves rather than trapping,
        // because a total match on the value tree is what this is.
        // The String payloads COPY, exactly as the leaf position above
        // does with `copyJson`: `s` is a borrow of the caller's `v`, and an
        // answered value outlives it. Re-wrapping the borrow handed the
        // response a pointer the caller's release then freed — visible the
        // moment the caller's conservative no-release marking narrowed
        // (exit-residue round seven: the wasm run printed `{"data":{:` where
        // the key had been).
        JNull => gqlOk(JNull),
        JBool(b) => gqlOk(JBool(b)),
        JNum(n) => gqlOk(JNum(n.copy())),
        JStr(s) => gqlOk(JStr(s.copy())),
    }
}

/// Project the same selection out of every element of a list, each under its own
/// INDEX in the path — the element of the path that is a number.
///
/// A faulting element takes the whole list with it, because a list's elements are
/// `[Book!]` far more often than `[Book]` and a non-null element that could not
/// be completed is exactly the climb. Every element is still walked, so a fault
/// that repeats down a list is reported at each index rather than once.
fn gqlProjectEach(
    items: Array<Json>,
    sels: Array<GqlSel>,
    elem: String,
    path: Array<Json>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    let mut out: Array<Json> = []
    let mut errs: Array<GqlErr> = []
    let mut failed = false
    let mut i = 0
    for it in items {
        let r = gqlProject(it, sels, elem, gqlStep(path, JNum(i.toString())), schema)
        for e in r.errs {
            errs.push(gqlCopyErr(e))
        }
        if r.failed {
            failed = true
        }
        out.push(consume r.value)
        i = i + 1
    }
    let v = if failed { JNull } else { JArr(out) }
    return GqlOut { value: v, errs: errs, failed: failed }
}

/// Keep exactly the selected members, in the order the QUERY asked for them —
/// GraphQL's response order is the selection's, not the record's — under the
/// response KEY, which is the alias when the query wrote one.
///
/// A member the SCHEMA declares and the value lacks answers `null`, because a
/// `None` `Option` is exactly that and a client indexes the reply by the names it
/// wrote. A member the schema does NOT declare is an error naming it, at that
/// member's own path; a member with no declared type has nothing saying `null`
/// may not sit there, so the `null` sits there and a SIBLING still answers. That
/// is the partial-data case, and it is why an undeclared field does not take the
/// whole reply with it.
fn gqlPick(
    fields: Array<JsonField>,
    sels: Array<GqlSel>,
    ty: String,
    path: Array<Json>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    let mut out: Array<JsonField> = []
    let mut errs: Array<GqlErr> = []
    let mut failed = false
    for s in sels {
        let fref = schema(ty, s.name)
        let at = gqlStep(path, JStr(s.key.copy()))
        let bad = gqlFieldFault(ty, s, fref, schema)
        let mi = gqlFieldIndex(fields, s.name)
        let r = if bad != "" {
            gqlFaultAt(bad, at, fref)
        } else {
            if mi < 0 {
                // A member the value lacks answers `null`, as it always has.
                gqlProject(JNull, s.subs, fref, at, schema)
            } else {
                // The member flows down as the place it is (RFC-0120): the
                // callee reads it, and only the leaves it keeps are copied.
                gqlProject(fields[mi].value, s.subs, fref, at, schema)
            }
        }
        for e in r.errs {
            // `r` owns its errors, so the element is a borrow (RFC-0089 rule 2)
            // and this array needs one of its own. `copy` refuses a `GqlErr`
            // because it holds a `Json`, which refers to itself — hence the
            // hand-written copy above.
            errs.push(gqlCopyErr(e))
        }
        if r.failed {
            failed = true
        } else {
            // `r` owns its value; take it, as `gqlProjectEach` always has —
            // the `.copy()` here was the same subtree paid a second time on
            // the way up.
            out.push(JsonField { key: s.key.copy(), value: consume r.value })
        }
    }
    let v = if failed { JNull } else { JObj(out) }
    return GqlOut { value: v, errs: errs, failed: failed }
}

/// "" when `s` may be selected on `owner` as written, else the GraphQL error
/// refusing it. Only a root field takes arguments — the SDL declares none
/// anywhere else — so an argument written at depth names something that is not
/// there.
fn gqlFieldFault(
    owner: String,
    s: GqlSel,
    tref: String,
    schema: fn(String, String) -> String,
) -> String {
    let stray = gqlNoArgs(s.name, s.args)
    if stray != "" {
        return stray
    }
    return gqlCheckSel(owner, s.name, gqlNamed(tref), s.subs.length > 0, schema)
}

// ---- the request and the reply ---------------------------------------------

/// The query text of a request body: the `query` member of a GraphQL-over-HTTP
/// JSON envelope, or — when the body is not such an envelope — the body itself,
/// which is what an `application/graphql` request sends. A GraphQL document is
/// not valid JSON, so the two cannot be confused.
export fn gqlQueryText(body: String) -> String {
    return match parseJson(body) {
        Ok(doc) => gqlEnvelopeQuery(doc, body),
        Err(e) => body.copy(),
    }
}

/// The `query` string of a parsed envelope, or `fallback`.
fn gqlEnvelopeQuery(doc: Json, fallback: String) -> String {
    return match doc {
        JObj(fields) => gqlQueryMember(fields, fallback),
        JNull => fallback.copy(),
        JBool(b) => fallback.copy(),
        JNum(n) => fallback.copy(),
        JStr(s) => fallback.copy(),
        JArr(xs) => fallback.copy(),
    }
}

/// The envelope's `query` member read in place, or `fallback` — only the
/// string that answers is copied, never the member.
fn gqlQueryMember(fields: Array<JsonField>, fallback: String) -> String {
    let qi = gqlFieldIndex(fields, "query")
    if qi < 0 {
        return fallback.copy()
    }
    return gqlStrOr(fields[qi].value, fallback)
}

/// A JSON string's text, or `fallback` for any other value.
fn gqlStrOr(j: Json, fallback: String) -> String {
    return match j {
        JStr(s) => s.copy(),
        JNull => fallback.copy(),
        JBool(b) => fallback.copy(),
        JNum(n) => fallback.copy(),
        JArr(xs) => fallback.copy(),
        JObj(o) => fallback.copy(),
    }
}

/// `{"errors":[{"message":"…"}]}` — a REQUEST fault, and the only reply with no
/// `data` entry at all.
///
/// A GraphQL client reads the `errors` array, not the status line, so the reply
/// stays a 200 `application/json`. This shape is for the faults that land BEFORE
/// execution — an unparseable document, a second operation — where no field was
/// ever reached, so there is no position to attribute and no partial `data` to
/// carry. Everything reached during execution goes through `gqlExecBody`.
export fn gqlErrorBody(message: String) -> String {
    let one: Array<JsonField> = [JsonField { key: "message", value: JStr(message.copy()) }]
    return emit(JObj([JsonField { key: "errors", value: JArr([JObj(one)]) }]))
}

/// The reply body for an EXECUTED operation: whatever the root fields produced,
/// beside the errors any position faulted with (RFC-0085 M3).
///
/// `errors` is written first — the reader wants to know whether anything faulted
/// before reading a `data` that may be partial, and it is the order the reference
/// implementation writes. `data` is always present here, `null` only when a fault
/// climbed past every root field.
fn gqlExecBody(data: consume Json, errs: Array<GqlErr>) -> String {
    let mut top: Array<JsonField> = []
    if errs.length > 0 {
        top.push(JsonField { key: "errors", value: gqlErrJson(errs) })
    }
    top.push(JsonField { key: "data", value: data })
    return emit(JObj(top))
}

/// The `errors` array as the value tree: each error's message, then the path it
/// happened at.
fn gqlErrJson(errs: Array<GqlErr>) -> Json {
    let mut out: Array<Json> = []
    for e in errs {
        out.push(JObj([
                    JsonField { key: "message", value: JStr(e.message.copy()) },
                    JsonField { key: "path", value: JArr(copyJsonArray(e.path)) },
                ]))
    }
    return JArr(out)
}

/// A GraphQL reply carrying `body`.
fn gqlReply(body: String) -> Response {
    return Response { status: 200, contentType: "application/json", body: body.copy(), vary: "", headers: [:] }
}

// ---- arguments, at the resolver ---------------------------------------------

/// One argument's value as the JSON text `fromJson` reads, or why it is not
/// there (`err != ""`).
export type GqlArg = { json: String, err: String }

/// The `want` argument of `field`, emitted as the JSON text a procedure's input
/// record is decoded from.
///
/// **The same decode path the RPC surface uses.** `std/rpc`'s generated handler
/// runs a POSTed body through `fromJson(<ReqType>, body)`; the arm this feeds
/// runs `fromJson(<ReqType>, ..)` over the text this returns. An argument and a
/// request body reach the same record by one route and are validated by one rule,
/// so a `Title` too long is refused identically over both wires — there is no
/// second decoder here to be lenient where the first is strict.
///
/// The SDL spells a procedure's single argument `input` (`gqlRootField`), so an
/// argument by any other name is one the field does not declare.
export fn gqlArgOf(field: String, args: Array<JsonField>, want: String) -> GqlArg {
    let stray = gqlNoArgs(field, gqlArgsBesides(args, want))
    if stray != "" {
        return GqlArg { json: "", err: stray }
    }
    for a in args {
        if a.key == want {
            return GqlArg { json: emit(a.value), err: "" }
        }
    }
    return GqlArg {
        json: "",
        err: "Field `" + field + "` argument `" + want + "` is required, but it was not provided.",
    }
}

/// The arguments other than `want` — the ones the field does not declare.
fn gqlArgsBesides(args: Array<JsonField>, want: String) -> Array<JsonField> {
    let mut out: Array<JsonField> = []
    for a in args {
        if a.key != want {
            out.push(JsonField { key: a.key.copy(), value: copyJson(a.value) })
        }
    }
    return out
}

/// "" when `field` takes no arguments and got none, else the GraphQL error
/// naming the first one it does not declare.
export fn gqlNoArgs(field: String, args: Array<JsonField>) -> String {
    if args.length > 0 {
        return "Unknown argument `" + args[0].key + "` on field `" + field + "`."
    }
    return ""
}

/// The GraphQL error for an argument the input record refuses: the accumulated
/// `Issue`s `fromJson` produced (RFC-0009) — the same ones a 422 carries over
/// RPC, since it is the same decode.
export fn gqlArgError(field: String, issues: Array<Issue>) -> String {
    let mut out = "Field `" + field + "` got an invalid argument"
    for i in issues {
        out = out + "; " + if i.path == "" { i.message } else { i.path + ": " + i.message }
    }
    return out + "."
}

// ---- the answer ------------------------------------------------------------

/// Answer one GraphQL request body against the two tables the generator bakes
/// from the contract's reflection: `resolve` (`(root, field, args) -> the encoded
/// value, or why not`) and `schema`, the type graph the projection is checked
/// against.
///
/// **Every root field the operation selects** (RFC-0085 M3). Each is resolved and
/// completed on its own, so one of them faulting leaves the others in `data` and
/// puts its own message in `errors` at its own path. `data` goes `null` only when
/// a fault climbs past a NON-NULL root field — which this generator's own SDL
/// never declares, since a root field is nullable by construction precisely so a
/// sibling's answer survives.
///
/// **Validation executes nothing** (GraphQL's own order, made explicit): the
/// whole selection tree is checked against the type graph FIRST, recursively,
/// so a document that selects what no procedure declares — a typo'd subfield
/// of a `mut fn`, say — is refused before ANY procedure runs. The eager
/// resolve this once preceded made `{ deleteUser { typo } }` perform the
/// deletion and only then report the typo. A document that fails validation
/// never executes, so its reply is the request-fault shape: `errors` alone,
/// no `data`. Argument DECODE faults stay where they were — they need the
/// generated `fromJson`, so they still surface per field, at their own path,
/// beside whatever siblings answered.

/// One selection position validated against the type graph, recursively — the
/// subfields too, so a whole tree is known sound before anything runs.
///
/// `rootArgsOk` marks the one position whose arguments are the resolver's
/// business (the SDL declares them there and nowhere else); everywhere below,
/// an argument names something no field declares.
fn gqlValidateSel(
    owner: String,
    s: GqlSel,
    rootArgsOk: Bool,
    schema: fn(String, String) -> String,
) -> String {
    let tref = schema(owner, s.name)
    let bad = gqlCheckSel(owner, s.name, gqlNamed(tref), s.subs.length > 0, schema)
    if bad != "" {
        return bad
    }
    if rootArgsOk == false {
        let stray = gqlNoArgs(s.name, s.args)
        if stray != "" {
            return stray
        }
    }
    let ty = gqlNamed(tref)
    for sub in s.subs {
        let inner = gqlValidateSel(ty, sub, false, schema)
        if inner != "" {
            return inner
        }
    }
    return ""
}

/// Every root selection validated, or the FIRST fault found — the message a
/// request-fault reply carries.
fn gqlValidate(rootType: String, sels: Array<GqlSel>, schema: fn(String, String) -> String) -> String {
    for s in sels {
        let bad = gqlValidateSel(rootType, s, true, schema)
        if bad != "" {
            return bad
        }
    }
    return ""
}

export fn gqlAnswer(
    body: String,
    resolve: fn(String, String, Array<JsonField>) -> Result<Json, String>,
    schema: fn(String, String) -> String,
) -> Response {
    let q = gqlParseQuery(gqlQueryText(body))
    if q.err != "" {
        return gqlReply(gqlErrorBody(q.err))
    }
    let rootType = gqlRootType(q.root)
    // Validate BEFORE executing: nothing below runs unless the whole tree is
    // sound (`gqlValidateSel`).
    let bad = gqlValidate(rootType, q.sels, schema)
    if bad != "" {
        return gqlReply(gqlErrorBody(bad))
    }
    let mut out: Array<JsonField> = []
    let mut errs: Array<GqlErr> = []
    let mut dataNull = false
    for sel in q.sels {
        let key = sel.key
        let r = gqlAnswerOne(rootType, sel, resolve(q.root, sel.name, sel.args), schema)
        for e in r.errs {
            errs.push(gqlCopyErr(e))
        }
        if r.failed {
            dataNull = true
        } else {
            out.push(JsonField { key: key.copy(), value: r.value.copy() })
        }
    }
    let data = if dataNull { JNull } else { JObj(out) }
    return gqlReply(gqlExecBody(data, errs))
}

/// Complete one root field at its own path.
///
/// A resolver's refusal — an argument that fails `fromJson` — is a fault AT
/// this position like any other, so it is attributed and bubbled by the same
/// rule rather than ending the request. An UNDECLARED field never gets here at
/// all: `gqlValidate` refused the document before anything ran. A resolver's
/// `Err` VALUE is a different thing entirely and never reaches here:
/// `Result<A, B>` is a modelled outcome the schema declared, and it projects
/// into `data` as the tagged object it is.
fn gqlAnswerOne(
    rootType: String,
    sel: GqlSel,
    resolved: Result<Json, String>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    let tref = schema(rootType, sel.name)
    // `.copy()`: the path element must OWN its key. The literal held a
    // borrow of `sel.key` through the constructor position, and releasing
    // `at` then freed the selection key under `q.sels` — invisible while
    // the old conservative return-marking pinned `at` forever, and visible
    // the round it stopped (exit-residue round seven: the wasm run printed
    // `{"data":{:` where the key had been).
    let at: Array<Json> = [JStr(sel.key.copy())]
    return match resolved {
        Err(why) => gqlFaultAt(why, at, tref),
        Ok(v) => gqlAnswerValue(rootType, sel, v, tref, at, schema),
    }
}

/// Check the selection against the root type, then project what resolved. A root
/// field's ARGUMENTS are the resolver's business (the SDL declares them there and
/// nowhere else), so nothing refuses them here.
fn gqlAnswerValue(
    rootType: String,
    sel: GqlSel,
    v: Json,
    tref: String,
    at: Array<Json>,
    schema: fn(String, String) -> String,
) -> GqlOut {
    let named = gqlNamed(tref)
    let bad = gqlCheckSel(rootType, sel.name, named, sel.subs.length > 0, schema)
    if bad != "" {
        return gqlFaultAt(bad, at, tref)
    }
    return gqlProject(v, sel.subs, tref, at, schema)
}

// ---- the generator ---------------------------------------------------------

/// The import block the emitted module needs (RFC-0031): the contract's
/// procedures from the contract itself, each type from the module that DECLARES
/// it, so a type reached across an import keeps one identity.
fn gqlImportBlock(iface: ModuleInterface, contract: String) -> String {
    let mut specs: Array<String> = [contract.copy()]
    for t in iface.types {
        if gqlHas(specs, t.module) == false {
            specs.push(t.module.copy())
        }
    }
    let mut out = ""
    for spec in specs {
        let mut names: Array<String> = []
        if spec == contract {
            for f in iface.functions {
                names.push(f.name.copy())
            }
        }
        for t in iface.types {
            if t.module == spec {
                names.push(t.name.copy())
            }
        }
        if names.length > 0 {
            out = out + "import { " + gqlJoin(names, ", ") + " } from \"" + spec + "\"\n"
        }
    }
    return out
}

/// Whether `items` already contains `needle`.
fn gqlHas(items: Array<String>, needle: String) -> Bool {
    for it in items {
        if it == needle {
            return true
        }
    }
    return false
}

/// Join `parts` with `sep` between them.
fn gqlJoin(parts: Array<String>, sep: String) -> String {
    let mut out = ""
    let mut i = 0
    for p in parts {
        if i > 0 {
            out = out + sep
        }
        out = out + p
        i = i + 1
    }
    return out
}

/// The resolver table: one arm per procedure, over the SAME `iface.functions`
/// walk `sdl` emits root fields from and the same `gqlRootOf` verdict, so the
/// schema and the executor cannot disagree about which fields exist or which root
/// answers them. A field no arm claims is GraphQL's own "Cannot query field" —
/// an error naming it, not a trap and not a 500.
///
/// A procedure that takes an argument decodes it through `fromJson` — the SAME
/// call `std/rpc`'s handler makes on a POSTed body, over the same input record.
/// The generator knows that record's type here (`ParamInfo.spelling`), so the
/// decode is emitted as source text and nothing has to carry a type at runtime.
fn gqlResolverTable(iface: ModuleInterface) -> String {
    let mut out = "/// Decode the procedure's encoded result into the value tree a projection is\n"
    out = out + "/// written over. The procedure has ALREADY run when this is reached.\n"
    out = out + "fn gqlValueOf(encoded: String) -> Json {\n"
    out = out + "    return match parseJson(encoded) {\n"
    out = out + "        Ok(v) => v,\n"
    out = out + "        Err(e) => JNull,\n"
    out = out + "    }\n}\n"
    // A Unit-returning procedure still publishes as a `Boolean` root field
    // (`gqlRootField`), so the resolver must answer it — a document selecting
    // the field is schema-valid and may not deterministically fault. Each one
    // gets a runner that invokes the procedure, discards the (empty) result,
    // and resolves `true`, the same verdict Connect's client gives a Unit
    // procedure (`connectUnify*` => `Valid(true)`).
    for f in iface.functions {
        if f.ret == "" {
            if f.params.length == 1 {
                out = out + "/// Runs `" + f.name + "` for its Boolean root field: the procedure returns\n"
                out = out + "/// nothing, so the field resolves to `true` once it has run.\n"
                out = out + "fn gqlRun_" + f.name + "(input: " + f.params[0].spelling + ") -> Result<Json, String> {\n"
                out = out + "    " + f.name + "(input)\n"
            } else {
                out = out + "/// Runs `" + f.name + "` for its Boolean root field: the procedure returns\n"
                out = out + "/// nothing, so the field resolves to `true` once it has run.\n"
                out = out + "fn gqlRun_" + f.name + "() -> Result<Json, String> {\n"
                out = out + "    " + f.name + "()\n"
            }
            out = out + "    return Ok(JBool(true))\n}\n"
        }
    }
    out = out + "/// The resolver table, generated from the contract's reflection.\n"
    out = out + "fn gqlResolve(root: String, field: String, args: Array<JsonField>) -> Result<Json, String> {\n"
    // An empty query root's `_placeholder` (`gqlBlock` repairs its SDL body):
    // the graph arm baked below answers the field, so the resolver must too,
    // or the document would accept what the executor refuses.
    let roots = gqlRootMembers(iface, "query")
    if roots.length == 0 {
        out = out + "    if root == \"Query\" && field == \"_placeholder\" {\n"
        out = out + "        return Ok(JNull)\n"
        out = out + "    }\n"
    }
    for f in iface.functions {
        let want = gqlRootOf(f)
        out = out + "    if field == \"" + f.name + "\" {\n"
        out = out + "        if root != \"" + want + "\" {\n"
        out = out + "            return Err(\"Cannot query field `" + f.name + "` on type `\" + gqlRootType(root) + \"`.\")\n"
        out = out + "        }\n"
        out = out + gqlResolverArm(f)
        out = out + "    }\n"
    }
    out = out + "    return Err(\"Cannot query field `\" + field + \"` on type `\" + gqlRootType(root) + \"`.\")\n}\n"
    return out
}

/// The body of one resolver arm: check the arguments, decode the one the field
/// declares, call the procedure, encode.
fn gqlResolverArm(f: FnInfo) -> String {
    if f.ret == "" {
        if f.params.length == 0 {
            let mut out = "        let stray = gqlNoArgs(\"" + f.name + "\", args)\n"
            out = out + "        if stray != \"\" {\n            return Err(stray)\n        }\n"
            return out + "        return gqlRun_" + f.name + "()\n"
        }
        let reqType = f.params[0].spelling
        let mut out = "        let arg = gqlArgOf(\"" + f.name + "\", args, \"input\")\n"
        out = out + "        if arg.err != \"\" {\n            return Err(consume arg.err)\n        }\n"
        out = out + "        return match fromJson(" + reqType + ", arg.json) {\n"
        out = out + "            Valid(input) => gqlRun_" + f.name + "(input),\n"
        out = out + "            Invalid(issues) => Err(gqlArgError(\"" + f.name + "\", issues)),\n"
        out = out + "        }\n"
        return out
    }
    if f.params.length == 0 {
        let mut out = "        let stray = gqlNoArgs(\"" + f.name + "\", args)\n"
        out = out + "        if stray != \"\" {\n            return Err(stray)\n        }\n"
        return out + "        return Ok(gqlValueOf(toJson(" + f.name + "())))\n"
    }
    let reqType = f.params[0].spelling
    let mut out = "        let arg = gqlArgOf(\"" + f.name + "\", args, \"input\")\n"
    out = out + "        if arg.err != \"\" {\n            return Err(consume arg.err)\n        }\n"
    out = out + "        return match fromJson(" + reqType + ", arg.json) {\n"
    out = out + "            Valid(input) => Ok(gqlValueOf(toJson(" + f.name + "(input)))),\n"
    out = out + "            Invalid(issues) => Err(gqlArgError(\"" + f.name + "\", issues)),\n"
    out = out + "        }\n"
    return out
}

/// The SDL's type graph, baked as one lookup the executor can ask at runtime.
///
/// `gqlSchema(t, field)` is the GraphQL type REFERENCE of `t`'s `field` —
/// `[Book!]!`, wrappers and all — and "" when `t` declares no such field;
/// `gqlSchema(t, "")` is `t` itself when `t` is an OBJECT type and "" when it is
/// a leaf. Two questions and one table, because they are the same lookup and a
/// selection asks both.
///
/// **The reference, not the name** (RFC-0085 M3). M2 baked `gqlNamed(m.ref)` and
/// threw the `!` markers away at exactly the point the projector needs them: they
/// are what says how far a `null` climbs. The information was already generated —
/// `gqlRef` writes it and the SDL document publishes it — so carrying it is one
/// call less, and the projector strips to the name where it wants the name.
///
/// Emitted from the SAME `gqlMembers` reading of each declaration the `type`
/// definitions are emitted from, and the same `gqlRootOf` split the roots are:
/// a field the document declares and a field the projector will descend into are
/// one set. Only object types get an arm — a leaf is the ABSENCE of one, which is
/// exactly the answer "has no subfields". An object whose members are EMPTY keeps
/// an arm carrying `_placeholder` — the same repair `gqlBlock` writes into the
/// SDL — so the document and this graph answer a field with one voice.
fn gqlSchemaTable(iface: ModuleInterface) -> String {
    let mut out = "/// The schema's type graph: `gqlSchema(t, field)` is the GraphQL type reference\n"
    out = out + "/// of `t`'s `field`, non-null markers included (\"\" when it declares none), and\n"
    out = out + "/// `gqlSchema(t, \"\")` is `t` itself when `t` is an object type (\"\" when it is a\n"
    out = out + "/// leaf, which has no subfields). The `!` markers are what say how far a `null`\n"
    out = out + "/// climbs (RFC-0085 M3).\n"
    out = out + "fn gqlSchema(t: String, field: String) -> String {\n"
    // An empty query root bakes the `_placeholder` arm its SDL body carries
    // (`gqlBlock`). An empty MUTATION bakes none: the SDL omits `type Mutation`
    // altogether when no `mut fn` exists, so there is nothing to agree with.
    let mut queries = gqlRootMembers(iface, "query")
    if queries.length == 0 {
        queries.push(gqlPlaceholderMember())
    }
    out = out + gqlSchemaArm("Query", queries)
    out = out + gqlSchemaArm("Mutation", gqlRootMembers(iface, "mutation"))
    for t in iface.types {
        let decl = gqlSplitDecl(t.source)
        let ms = gqlMembers(decl, iface)
        // A zero-field RECORD is an object whose SDL body IS the `_placeholder`
        // repair (`gqlBlock`), so it bakes an arm too; a leaf — a nullary enum,
        // a scalar — stays the ABSENCE of an arm, which is exactly the answer
        // "has no subfields".
        if ms.length > 0 || decl.rhs.startsWith("{") {
            let mut members = ms
            if members.length == 0 {
                members.push(gqlPlaceholderMember())
            }
            out = out + gqlSchemaArm(decl.name, members)
        }
    }
    return out + "    return \"\"\n}\n"
}

/// One object type's arm of the lookup.
fn gqlSchemaArm(name: String, ms: Array<GqlMember>) -> String {
    let mut out = "    if t == \"" + name + "\" {\n"
    out = out + "        if field == \"\" {\n            return t.copy()\n        }\n"
    for m in ms {
        out = out + "        if field == \"" + m.name + "\" {\n"
        out = out + "            return \"" + m.ref + "\"\n"
        out = out + "        }\n"
    }
    return out + "        return \"\"\n    }\n"
}

/// `graphqlServer(contract)` — emit a module exposing
/// `graphqlHandle(req: Request) -> Option<Response>`, answering `POST /graphql`
/// against the same contract `sdl(contract)` documents (RFC-0085 M1).
///
/// It mounts beside `rpcHandle` and `connectHandle` on one `serve` root: a
/// GraphQL request is an ordinary route over the same procedures and the same
/// `toJson`, not a second wire. The generator is `graphqlServer` (not
/// `graphqlHandle`) for the reason `std/rpc` and `std/connect` already record — a
/// `gen fn` and the module it emits are both linked, and the flat namespace
/// forbids the clash.
export gen fn graphqlServer(contract: String) -> String {
    let iface = moduleInterface(contract)
    // The SAME `Api` + serializability rule the RPC and REST surfaces apply. The
    // SDL only reads type SPELLINGS and needs no such check; this generator emits
    // a `toJson` call per procedure, which is precisely what the rule governs.
    let err = validateContract(iface)
    if err != "" {
        return err
    }
    let mut out = "/// Generated by std/graphql `graphqlServer` (RFC-0085) — do not edit.\n"
    out = out + gqlImportBlock(iface, contract)
    out = out + "import { Json, JsonField } from \"std/json\"\n"
    out = out + "import { parseJson } from \"std/jsonread\"\n"
    out = out + "import { gqlAnswer, gqlRootType, gqlArgOf, gqlNoArgs, gqlArgError } from \"std/graphql\"\n"
    out = out + gqlResolverTable(iface)
    out = out + gqlSchemaTable(iface)
    out = out + "/// `POST /graphql`. `None` (not our path) for everything else, so this mounts\n"
    out = out + "/// beside the other projections of the same procedures.\n"
    out = out + "export fn graphqlHandle(req: Request) -> Option<Response> {\n"
    out = out + "    if req.path != \"/graphql\" {\n"
    out = out + "        return None\n"
    out = out + "    }\n"
    out = out + "    if req.method != \"POST\" {\n"
    out = out + "        return Some(Response { status: 405, contentType: \"text/plain\", body: \"method not allowed\", vary: \"\", headers: [:] })\n"
    out = out + "    }\n"
    out = out + "    return Some(gqlAnswer(req.body, gqlResolve, gqlSchema))\n}\n"
    return out
}

// ===========================================================================
// Tests — the pure mapping helpers (the whole SDL is golden-pinned in Rust).
// ===========================================================================

test "gqlPrim maps the honest scalar table" {
    assertEq(gqlPrim("Int64"), "Int")
    assertEq(gqlPrim("UInt8"), "Int")
    assertEq(gqlPrim("Float64"), "Float")
    assertEq(gqlPrim("String"), "String")
    assertEq(gqlPrim("Bool"), "Boolean")
    assertEq(gqlPrim("Book"), "")
}

test "gqlSplitDecl splits name and rhs" {
    let d = gqlSplitDecl("export type BookId = Int64 where value >= 0")
    assertEq(d.name, "BookId")
    assertEq(d.rhs, "Int64 where value >= 0")
}

test "gqlBetweenAngles and gqlStripWhere" {
    assertEq(gqlBetweenAngles("Array<Tag>"), "Tag")
    assertEq(gqlBetweenAngles("Map<String, Int64>"), "String, Int64")
    assertEq(gqlStripWhere("String where value.byteLength >= 1"), "String")
}

test "gqlSplitTop respects angle and paren nesting" {
    let parts = gqlSplitTop("id: BookId, tags: Array<Tag>, m: Map<String, Int64>", 44)
    assertEq(parts.length, 3)
    assertEq(parts[2], "m: Map<String, Int64>")
}

test "gqlSplitTop is string-literal aware — a predicate string never splits" {
    // A record field carrying an inline `where` predicate whose regex string holds
    // a comma, a brace, and an escaped quote must stay ONE field.
    let parts = gqlSplitTop("a: String, b: String where value =~ \"x,y}z\\\"w\"", 44)
    assertEq(parts.length, 2)
    assertEq(parts[0], "a: String")
    assertEq(parts[1], "b: String where value =~ \"x,y}z\\\"w\"")
}

test "gqlSplitTop clamps bracket depth at zero" {
    // A stray closer must never drive depth negative and fabricate a split.
    let parts = gqlSplitTop("a}, b", 44)
    assertEq(parts.length, 2)
}

test "gqlEscTripleQuote escapes only triple quotes" {
    assertEq(gqlEscTripleQuote("a \"b\" c"), "a \"b\" c")
    assertEq(gqlEscTripleQuote("x\"\"\"y"), "x\\\"\"\"y")
}

test "gqlDescBlock keeps a quote-free body single-line, pads a quote-ending body" {
    assertEq(gqlDescBlock("A stored user."), "\"\"\"A stored user.\"\"\"\n")
    // A body ending in a quote goes on its own line so `..." \"\"\"` cannot form
    // four consecutive quotes.
    assertEq(gqlDescBlock("re \"x\""), "\"\"\"\nre \"x\"\n\"\"\"\n")
}

test "gqlDescBlock keeps a trailing backslash away from the closing delimiter" {
    // `"""Ends with \"""` reads its last four bytes as the `\"""` escape, so the
    // block string never closes and swallows the definitions after it.
    assertEq(gqlDescBlock("Ends with \\"), "\"\"\"\nEnds with \\\n\"\"\"\n")
    assertEq(gqlDescBlock("\\"), "\"\"\"\n\\\n\"\"\"\n")
    // An INTERIOR backslash is not the hazard: `\` + an escaped `"""` emits
    // `\\"""`, which re-lexes as a literal backslash then the escape.
    assertEq(gqlDescBlock("a\\b"), "\"\"\"a\\b\"\"\"\n")
    assertEq(gqlDescBlock("a\\\"\"\"b"), "\"\"\"a\\\\\"\"\"b\"\"\"\n")
    assertEq(gqlDescBlock(""), "\"\"\"\"\"\"\n")
}

// ---- the executor (RFC-0085 M1/M2) -----------------------------------------

/// The shape a shelf `browse` returns, as the value tree a projection sees. The
/// `rating` its type DECLARES is absent from the value, which is what a `None`
/// `Option` looks like after `toJson`.
fn gqlTestValue() -> Json {
    let book: Array<JsonField> = [
        JsonField { key: "id", value: JNum("0") },
        JsonField { key: "title", value: JStr("SICP") },
        JsonField { key: "url", value: JStr("https://example.com") },
    ]
    return JObj([JsonField { key: "books", value: JArr([JObj(book)]) }])
}

/// A stand-in type graph over that shape, in the shape `gqlSchemaTable` bakes —
/// type REFERENCES, `!` markers included, because those are what the bubbling
/// rule reads. `books` is `[Book!]!` exactly as `Array<Book>` maps, and `rating`
/// is the one nullable field, so a climb has somewhere to stop short.
fn gqlTestSchema(t: String, field: String) -> String {
    if t == "BookList" {
        if field == "" {
            return t.copy()
        }
        if field == "books" {
            return "[Book!]!"
        }
        return ""
    }
    if t == "Book" {
        if field == "" {
            return t.copy()
        }
        if field == "id" {
            return "BookId!"
        }
        if field == "title" {
            return "Title!"
        }
        if field == "url" {
            return "Url!"
        }
        if field == "rating" {
            return "Stars"
        }
        return ""
    }
    return ""
}

/// One root field's completion as a single string: the value it produced beside
/// the errors it collected, which since M3 is one outcome and not two.
fn gqlTestProject(query: String) -> String {
    let sels = gqlParseQuery(query).sels
    let r = gqlProject(gqlTestValue(), sels[0].subs, "BookList!", [], gqlTestSchema)
    return emit(JObj([
                JsonField { key: "value", value: consume r.value },
                JsonField { key: "errors", value: gqlErrJson(r.errs) },
                JsonField { key: "climbing", value: JBool(r.failed) },
            ]))
}

test "gqlParseQuery reads a nested selection set" {
    let q = gqlParseQuery("{ browse { books { title } } }")
    assertEq(q.err, "")
    assertEq(q.root, "query")
    assertEq(q.sels.length, 1)
    assertEq(q.sels[0].name, "browse")
    assertEq(q.sels[0].subs[0].name, "books")
    assertEq(q.sels[0].subs[0].subs[0].name, "title")
}

test "gqlParseQuery takes an operation type and treats commas as whitespace" {
    let q = gqlParseQuery("mutation Add { a, b }")
    assertEq(q.err, "")
    assertEq(q.root, "mutation")
    assertEq(q.sels.length, 2)
    assertEq(q.sels[1].name, "b")
}

test "gqlParseQuery reads an alias as the response key, not as the field" {
    let q = gqlParseQuery("{ recent: browse { books { title } } }")
    assertEq(q.err, "")
    assertEq(q.sels[0].key, "recent")
    assertEq(q.sels[0].name, "browse")
    // An unaliased field is its own key, so nothing has to ask which it was.
    assertEq(q.sels[0].subs[0].key, "books")
}

test "gqlParseQuery reads arguments as the JSON tree fromJson decodes" {
    let q = gqlParseQuery("{ byId(input: { id: 7, tags: [\"a\"], ok: true }) { title } }")
    assertEq(q.err, "")
    assertEq(q.sels[0].args.length, 1)
    assertEq(q.sels[0].args[0].key, "input")
    // The unquoted GraphQL keys reach `fromJson` as the quoted JSON ones.
    assertEq(emit(q.sels[0].args[0].value), "{\"id\":7,\"tags\":[\"a\"],\"ok\":true}")
}

/// `{ a { a { … } } }` nested `n` deep, and a list value nested `n` deep — the two
/// places this parser descends, both written by whoever sent the query.
fn gqlNestedSel(n: Int64) -> String {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + "{ a "
        i = i + 1
    }
    i = 0
    while i < n {
        out = out + "}"
        i = i + 1
    }
    return out
}

test "a query nested past gqlMaxDepth is an err, not a trap" {
    // The parser reports every other malformed query through `err`; an unbounded
    // descent answers this one by taking the serving process down instead.
    assertEq(gqlParseQuery(gqlNestedSel(129)).err, "nesting deeper than 128 levels")
    assertEq(gqlParseQuery(gqlNestedSel(2000)).err, "nesting deeper than 128 levels")
    // At the limit it still parses.
    assertEq(gqlParseQuery(gqlNestedSel(128)).err, "")
    // An argument VALUE descends on the same budget, so a deep list refuses too.
    assert(gqlParseQuery("{ a(input: " + gqlListNest(200) + ") { b } }").err.contains("nesting deeper than 128 levels"))
}

/// `[` repeated `n` times then `]` repeated `n` times — a list value nested `n`
/// deep, the argument-side twin of [`gqlNestedSel`].
fn gqlListNest(n: Int64) -> String {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + "["
        i = i + 1
    }
    i = 0
    while i < n {
        out = out + "]"
        i = i + 1
    }
    return out
}

test "gqlParseQuery refuses what it cannot mean rather than dropping it" {
    assert(gqlParseQuery("{ byId(input: $x) { title } }").err.contains("variable `$x`"))
    assert(gqlParseQuery("query Q($id: Int) { byId { title } }").err.contains("variable definitions"))
    assert(gqlParseQuery("{ byId(input: {id: 1) }").err.contains("expected a field name in an input object"))
    assert(gqlParseQuery("{ byId(input: {id: 1").err.contains("unterminated input object"))
    assert(gqlParseQuery("{ browse { title }").err.contains("unterminated selection set"))
    assert(gqlParseQuery("").err.contains("no query"))
}

test "gqlProject omits what was not selected" {
    // The whole point: `url` and `id` were computed and encoded, and the
    // projection leaves them out. Assert the ABSENCE — a projection that returned
    // the record whole would pass a test that only looked for `title`.
    let out = gqlTestProject("{ browse { books { title } } }")
    assertEq(out, "{\"value\":{\"books\":[{\"title\":\"SICP\"}]},\"errors\":[],\"climbing\":false}")
    assert(out.contains("url") == false)
    assert(out.contains("\"id\"") == false)
}

test "gqlProject answers under the alias the query wrote" {
    assertEq(
        gqlTestProject("{ browse { shelf: books { name: title } } }"),
        "{\"value\":{\"shelf\":[{\"name\":\"SICP\"}]},\"errors\":[],\"climbing\":false}",
    )
}

test "gqlProject takes a leaf whole and answers null for a DECLARED member the value lacks" {
    assert(gqlTestProject("{ browse { books } }").contains("\"url\""))
    // `rating` is on `Book` and absent from this value — a `None` `Option`, which
    // is `null` and not an error.
    assertEq(
        gqlTestProject("{ browse { books { rating } } }"),
        "{\"value\":{\"books\":[{\"rating\":null}]},\"errors\":[],\"climbing\":false}",
    )
}

test "gqlProject reports a member the schema does not declare — M1's first hole" {
    // At M1 this answered `{"books":[{"shelved":null}]}`, because `toJson` omits a
    // `None` and the projector held only the value. The type graph tells them apart.
    // M3 adds the PATH and keeps the reply: the schema declares no type for
    // `shelved`, so nothing says `null` may not sit there and the fault stays put.
    assertEq(
        gqlTestProject("{ browse { books { shelved } } }"),
        "{\"value\":{\"books\":[{\"shelved\":null}]},\"errors\":[{\"message\":"
        + "\"Cannot query field `shelved` on type `Book`.\",\"path\":[\"books\",0,\"shelved\"]}],"
        + "\"climbing\":false}",
    )
}

test "gqlProject refuses a selection on a scalar — M1's second hole" {
    // `title` is `Title!`, so the `null` may NOT sit there: it climbs to the
    // `Book!` element, which takes the `[Book!]!` list with it, which takes
    // `BookList!` — and this stand-in root is non-null, so it is still climbing
    // when it runs out of positions. That is the `"data": null` case.
    assertEq(
        gqlTestProject("{ browse { books { title { nope } } } }"),
        "{\"value\":null,\"errors\":[{\"message\":\"Field `title` must not have a selection "
        + "since type `Title` has no subfields.\",\"path\":[\"books\",0,\"title\"]}],"
        + "\"climbing\":true}",
    )
}

test "a null stops at the nearest NULLABLE ancestor and the siblings survive" {
    // The same fault one field over. `rating` is `Stars` — nullable — so the climb
    // ends at the position it started on, and `title` beside it still answers.
    assertEq(
        gqlTestProject("{ browse { books { title, rating { nope } } } }"),
        "{\"value\":{\"books\":[{\"title\":\"SICP\",\"rating\":null}]},\"errors\":[{\"message\":"
        + "\"Field `rating` must not have a selection since type `Stars` has no subfields.\","
        + "\"path\":[\"books\",0,\"rating\"]}],\"climbing\":false}",
    )
}

test "gqlProject refuses an argument written where the schema declares none" {
    assertEq(
        gqlTestProject("{ browse { books(first: 2) { title } } }"),
        "{\"value\":null,\"errors\":[{\"message\":\"Unknown argument `first` on field `books`.\","
        + "\"path\":[\"books\"]}],\"climbing\":true}",
    )
}

test "gqlArgOf takes the declared argument and names any other" {
    let args = gqlParseQuery("{ byId(input: {id: 1}) }").sels[0].args
    assertEq(gqlArgOf("byId", args, "input").json, "{\"id\":1}")
    let wrong = gqlParseQuery("{ byId(id: 1) }").sels[0].args
    assertEq(gqlArgOf("byId", wrong, "input").err, "Unknown argument `id` on field `byId`.")
    assertEq(
        gqlArgOf("byId", [], "input").err,
        "Field `byId` argument `input` is required, but it was not provided.",
    )
    assertEq(gqlNoArgs("browse", wrong), "Unknown argument `id` on field `browse`.")
}

test "gqlQueryText reads an envelope or a bare document" {
    assertEq(gqlQueryText("{\"query\":\"{ browse }\"}"), "{ browse }")
    assertEq(gqlQueryText("{ browse }"), "{ browse }")
}

test "gqlErrorBody is the shape a client reads" {
    assertEq(gqlErrorBody("nope"), "{\"errors\":[{\"message\":\"nope\"}]}")
    assertEq(gqlRootType("mutation"), "Mutation")
    assertEq(gqlRootType("query"), "Query")
}

// ---- validate-before-execute (RFC-0085, the executor's order) --------------

/// A resolver that announces itself: any execution carries this message into
/// the reply, so a test asserting its absence proves the procedure never ran.
fn gqlSpyResolve(root: String, field: String, args: Array<JsonField>) -> Result<Json, String> {
    return Err("the resolver for `" + field + "` RAN")
}

/// A graph over that spy: a query root and a mutation root over the BookList /
/// Book shapes [`gqlTestSchema`] draws — the two tables one contract bakes.
fn gqlExecTestSchema(t: String, field: String) -> String {
    if t == "Query" {
        if field == "" {
            return t.copy()
        }
        if field == "browse" {
            return "BookList!"
        }
        return ""
    }
    if t == "Mutation" {
        if field == "" {
            return t.copy()
        }
        if field == "dropAll" {
            return "Boolean"
        }
        return ""
    }
    return gqlTestSchema(t, field)
}

test "a typo'd subfield of a mut fn is refused BEFORE the procedure runs" {
    // The eager resolve this once preceded performed the mutation and only then
    // reported the typo. The spy fails loudly whenever it is invoked, so the
    // reply must carry the validation fault and never the spy's message — and
    // a document that fails validation executes nothing, so there is no `data`.
    let r = gqlAnswer("mutation { dropAll { typo } }", gqlSpyResolve, gqlExecTestSchema)
    assert(r.body.contains("must not have a selection"))
    assert(r.body.contains("RAN") == false)
    assert(r.body.contains("\"data\"") == false)
}

test "validation descends: a typo two levels down refuses before any resolver runs" {
    let r = gqlAnswer("{ browse { books { nope } } }", gqlSpyResolve, gqlExecTestSchema)
    assert(r.body.contains("Cannot query field `nope` on type `Book`."))
    assert(r.body.contains("RAN") == false)
    // An argument written where no field declares one is refused the same way,
    // before anything runs.
    let deep = gqlAnswer("{ browse { books(first: 2) { title } } }", gqlSpyResolve, gqlExecTestSchema)
    assert(deep.body.contains("Unknown argument `first` on field `books`."))
    assert(deep.body.contains("RAN") == false)
}
test "a valid operation still reaches its resolvers" {
    // The same spy, a well-formed mutation: the fault IS the spy's, attributed
    // at the field's own path — proof the execute pass runs what validation
    // passed, and that only validation moved, not execution.
    let r = gqlAnswer("mutation { dropAll }", gqlSpyResolve, gqlExecTestSchema)
    assert(r.body.contains("the resolver for `dropAll` RAN"))
}

test "a response key may be selected once" {
    assert(gqlParseQuery("{ a a }").err.contains("duplicate response key `a`"))
    assert(gqlParseQuery("{ x: a x: b }").err.contains("duplicate response key `x`"))
    // Different keys over one field are ordinary aliases and stay legal.
    assertEq(gqlParseQuery("{ a b: a }").err, "")
}

test "an argument may be written once" {
    assert(gqlParseQuery("{ f(a: 1, a: 2) { b } }").err.contains("duplicate argument `a`"))
    assertEq(gqlParseQuery("{ f(a: 1) { b } }").err, "")
}

// ---- the `_placeholder` repair, document and endpoint together -------------

/// The graph a contract with NO query procedures bakes (`gqlSchemaTable`): an
/// empty Query arm whose one field is the `_placeholder` its SDL body carries.
fn gqlEmptyRootSchema(t: String, field: String) -> String {
    if t == "Query" {
        if field == "" {
            return t.copy()
        }
        if field == "_placeholder" {
            return "Boolean"
        }
    }
    return ""
}

fn gqlNullResolve(root: String, field: String, args: Array<JsonField>) -> Result<Json, String> {
    return Ok(JNull)
}

test "{ _placeholder } on an empty query root is answered, not refused" {
    // `gqlBlock` repairs an empty SDL body with `_placeholder: Boolean`; the
    // baked graph and the resolver table bake the same field, so the one field
    // the document can select is one the endpoint answers.
    let r = gqlAnswer("{ _placeholder }", gqlNullResolve, gqlEmptyRootSchema)
    assertEq(r.body, "{\"data\":{\"_placeholder\":null}}")
}
