/// std/graphql — the contract as a GraphQL SDL document (RFC-0038), a library
/// entirely on RFC-0021 generator imports. One `gen fn`, `sdl(contract)`,
/// reflects the contract with `moduleInterface` and RETURNS a synthesized module
/// exporting `sdlText() -> String`. The compiler knows nothing about GraphQL:
/// everything below is comptime-pure Vyrn string building over the reflected
/// type SOURCES and procedure signatures — the SDL is BAKED as a deterministic
/// constant at generation time (no runtime calls).
///
///   import { sdl } from "std/graphql"
///   import { sdlText } from sdl("./contract")
///   // sdlText() -> String : a deterministic GraphQL SDL document
///
/// Mapping rules (documented and DUMB on purpose — RFC-0038):
///   - a wire RECORD becomes a `type`/`input` PAIR (`Book` and `BookInput`);
///     GraphQL separates output objects from input objects, and both derive from
///     one Vyrn record. A record field's type maps by the scalar table below; a
///     non-`Option` field is non-null (`!`).
///   - SCALARS map honestly: `Int64` and the sized ints => `Int`, `Float64`/
///     `Float32` => `Float`, `String` => `String`, `Bool` => `Boolean`.
///   - a VALIDATED scalar (e.g. `BookId = Int64 where value >= 0`) becomes a
///     named custom `scalar` whose description documents its base and constraint
///     (the `@constraint`-style doc comment). Fields keep the name, so the type
///     graph stays legible and the constraint is documented once.
///   - `Map<String, V>` has no SDL type, so it maps to a documented custom
///     `scalar JSON` (a JSON object on the wire); a NAMED map alias becomes its
///     own documented `scalar`.
///   - a PAYLOAD enum (any variant carries data — including `Result<A, B>` and
///     `Circle(Int64)`) maps to a "tagged" object `type` with one NULLABLE field
///     per variant (nullary => `Boolean`, single payload => that type, multi
///     payload => `JSON`): exactly one field is non-null at a time. A nullary-only
///     enum maps to a real GraphQL `enum`.
///   - PROCEDURES become `Query`/`Mutation` fields: a `mut fn` is a Mutation,
///     everything else a Query. The split is the author's DECLARATION, read off
///     `FnInfo.mutates` (RFC-0074 M4a) — nothing here guesses from a name, so
///     renaming a procedure cannot silently move it between roots. A
///     1-parameter procedure takes `(input: <Req>Input)`; the return maps by the
///     table above. An empty `Query` gets a `_placeholder` field (GraphQL needs a
///     non-empty query root); an empty `Mutation` is omitted.
///   - `///` docs on TYPES become SDL descriptions. Procedure/param/module docs
///     are NOT in `moduleInterface` reflection, so operation descriptions are
///     absent (gap recorded in RFC-0038).
///
/// The EXECUTOR (RFC-0085 M1) lives at the bottom of this file: `graphqlServer`
/// emits a `graphqlHandle(req) -> Option<Response>` answering `POST /graphql`
/// over the SAME `iface.functions` walk the SDL reads, so a field the schema
/// declares and a field the executor dispatches are one list.
///
/// Inspect the synthesized module with:  vyrn emit-gen <file>

// ===========================================================================
// Byte / string helpers — comptime-pure, so legal in a `gen fn` and its callees.
// ===========================================================================

// The shared infallible-decode home (RFC-0059): every buffer decoded here is an
// ASCII transform / ASCII-boundary rebuild of already-valid UTF-8, so the `Err`
// arm is unreachable — routed through the one shared `fromBytesOr`.
import { fromBytesOr } from "std/strings"

// The executor's half (RFC-0085 M1). The value tree is what a projection is
// written over — see `gqlProject` — and the shared cursor is what the query
// language is parsed with (RFC-0054).
import { Json, JsonField, emit } from "std/json"
import { parseJson } from "std/jsonread"
import { Scanner, scanner, skipWs, ident, peek, advance, atEnd } from "std/scan"

// THE serializability rule (RFC-0072 M2), shared rather than restated — the
// executor calls `toJson` on a procedure's return exactly as `std/rpc` and
// `std/http` do, so it is governed by the same predicate they are. `std/http`
// imports it for the same reason.
import { validateContract } from "std/rpc"

/// The bytes `ba[s..e)` as a String ("" on the impossible non-UTF-8 slice).
fn gqlSlice(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut out: Array<UInt8> = []
    let mut i = s
    while i < e {
        out.push(ba[i])
        i = i + 1
    }
    return fromBytesOr(out, "")
}

/// True for an ASCII space, tab, CR, or LF.
fn gqlIsWs(b: UInt8) -> Bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

/// `s` with leading and trailing ASCII whitespace removed.
fn gqlTrim(s: String) -> String {
    let ba = bytes(s)
    let mut lo = 0
    let mut hi = ba.length
    while lo < hi && gqlIsWs(ba[lo]) {
        lo = lo + 1
    }
    while hi > lo && gqlIsWs(ba[hi - 1]) {
        hi = hi - 1
    }
    return gqlSlice(ba, lo, hi)
}

/// `s` without a trailing `!` (a GraphQL non-null marker) — used to make a
/// tagged-union field nullable.
fn gqlStripBang(s: String) -> String {
    if s.endsWith("!") {
        let ba = bytes(s)
        return gqlSlice(ba, 0, ba.length - 1)
    }
    return s
}

/// The inner text between the FIRST `<` and the LAST `>` of `s` (`Array<Tag>` =>
/// `Tag`, `Map<String, Int64>` => `String, Int64`). "" when there is no `<`.
fn gqlBetweenAngles(s: String) -> String {
    let ba = bytes(s)
    let mut lo = -1
    let mut hi = -1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '<' && lo < 0 {
            lo = i
        }
        if ba[i] == '>' {
            hi = i
        }
        i = i + 1
    }
    if lo < 0 || hi < 0 || hi <= lo {
        return ""
    }
    return gqlSlice(ba, lo + 1, hi)
}

/// Split `s` on the top-level occurrences of the separator byte `sep`, tracking
/// `<`/`(`/`[`/`{` nesting so a separator inside `Map<String, V>` or `C(A, B)`
/// does not split. STRING-LITERAL AWARE: a `"…"` run (as in an inline `where value
/// =~ "a,b}c"` predicate) is opaque — its bytes never open/close a bracket nor act
/// as a separator, and `\"` inside it is an escaped quote, not a delimiter. Bracket
/// depth is clamped at 0 so a stray closer inside malformed input can never drive
/// it negative and fabricate a phantom split. Empty parts are dropped; each result
/// is trimmed.
fn gqlSplitTop(s: String, sep: UInt8) -> Array<String> {
    let ba = bytes(s)
    let mut out: Array<String> = []
    let mut depth = 0
    let mut start = 0
    let mut inStr = false
    let mut i = 0
    while i < ba.length {
        let b = ba[i]
        if inStr {
            if b == '\\' {
                // A backslash escapes the next byte (e.g. `\"`); skip both.
                i = i + 2
            } else {
                if b == '"' {
                    inStr = false
                }
                i = i + 1
            }
        } else if b == '"' {
            inStr = true
            i = i + 1
        } else if b == '<' || b == '(' || b == '[' || b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '>' || b == ')' || b == ']' || b == '}' {
            if depth > 0 {
                depth = depth - 1
            }
            i = i + 1
        } else if b == sep && depth == 0 {
            let part = gqlTrim(gqlSlice(ba, start, i))
            if part.byteLength > 0 {
                out.push(part)
            }
            start = i + 1
            i = i + 1
        } else {
            i = i + 1
        }
    }
    let last = gqlTrim(gqlSlice(ba, start, ba.length))
    if last.byteLength > 0 {
        out.push(last)
    }
    return out
}

/// The index of the first `needle` byte in `ba` at or after `from`, or -1.
fn gqlIndexOf(ba: Array<UInt8>, needle: UInt8, from: Int64) -> Int64 {
    let mut i = from
    while i < ba.length {
        if ba[i] == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

// ===========================================================================
// Type-declaration parsing — pull (name, rhs) out of a `TypeInfo.source`, and
// classify / extract fields and variants. The source is canonical (RFC-0021
// `render_type_decl`): `export type Name = <rhs>`.
// ===========================================================================

/// A split declaration: its name and its right-hand side.
type GqlDecl = { name: String, rhs: String }

/// Split `export type Name = RHS` into its name and RHS (both trimmed). A generic
/// `Name<..>` keeps only the head `Name` (monomorphic wire types are assumed;
/// a parameterized type falls back to a scalar downstream).
fn gqlSplitDecl(source: String) -> GqlDecl {
    let s = gqlTrim(source)
    let ba = bytes(s)
    // Skip a leading `export `.
    let mut i = 0
    if s.startsWith("export ") {
        i = 7
    }
    // Skip `type `.
    i = i + 5
    // Find the ` = ` separator (the first top-level `=`).
    let eq = gqlIndexOf(ba, '=', i)
    if eq < 0 {
        return GqlDecl { name: gqlTrim(gqlSlice(ba, i, ba.length)), rhs: "" }
    }
    let head = gqlTrim(gqlSlice(ba, i, eq))
    // Strip any generic parameter list from the head.
    let lt = gqlIndexOf(bytes(head), '<', 0)
    let name = if lt < 0 { head } else { gqlSlice(bytes(head), 0, lt) }
    let rhs = gqlTrim(gqlSlice(ba, eq + 1, ba.length))
    return GqlDecl { name: name, rhs: rhs }
}

/// The `TypeInfo.source` of the named type, or "" when absent.
fn gqlSourceOf(name: String, iface: ModuleInterface) -> String {
    for t in iface.types {
        if t.name == name {
            return t.source
        }
    }
    return ""
}

/// Whether the named type is a RECORD (its RHS opens with `{`) — a record is the
/// one kind that needs an `Input` twin, so field references in input position add
/// the `Input` suffix.
fn gqlIsRecord(name: String, iface: ModuleInterface) -> Bool {
    let src = gqlSourceOf(name, iface)
    if src == "" {
        return false
    }
    return gqlSplitDecl(src).rhs.startsWith("{")
}

// ===========================================================================
// Scalar mapping — the honest table.
// ===========================================================================

/// The GraphQL scalar for a Vyrn primitive spelling, or "" when not a primitive.
fn gqlPrim(spelling: String) -> String {
    let s = gqlTrim(spelling)
    if s == "Int64" || s == "Int8" || s == "Int16" || s == "Int32" || s == "UInt8" || s == "UInt16" || s == "UInt32" || s == "UInt64" {
        return "Int"
    }
    if s == "Float64" || s == "Float32" || s == "Float" {
        return "Float"
    }
    if s == "String" {
        return "String"
    }
    if s == "Bool" {
        return "Boolean"
    }
    return ""
}

/// A GraphQL type REFERENCE (including non-null markers) for a Vyrn type
/// spelling, in output (`inputCtx == false`) or input (`inputCtx == true`)
/// position. `Option<T>` is the one nullable form; everything else is non-null.
fn gqlRef(spelling: String, inputCtx: Bool, iface: ModuleInterface) -> String {
    let s = gqlTrim(spelling)
    if s.startsWith("Option<") {
        return gqlStripBang(gqlRef(gqlBetweenAngles(s), inputCtx, iface))
    }
    if s.startsWith("Array<") {
        return "[" + gqlRef(gqlBetweenAngles(s), inputCtx, iface) + "]!"
    }
    if s.startsWith("Map<") {
        return "JSON!"
    }
    if s.startsWith("Result<") {
        return "JSON!"
    }
    let p = gqlPrim(s)
    if p != "" {
        return p + "!"
    }
    if inputCtx && gqlIsRecord(s, iface) {
        return s + "Input!"
    }
    return s + "!"
}

// ===========================================================================
// Descriptions — a type's `///` doc becomes an SDL block-string description.
// ===========================================================================

/// The raw (unwrapped, whitespace-folded) `///` doc text of a type, or "".
fn gqlRawDoc(name: String, iface: ModuleInterface) -> String {
    for t in iface.types {
        if t.name == name {
            return match t.schema.doc {
                Some(d) => gqlFoldWs(d),
                None => "",
            }
        }
    }
    return ""
}

/// The SDL description line for a type's doc (from `TypeInfo.schema.doc`), or "".
/// Emitted on its own line above the definition; newlines in the doc are folded
/// to spaces so it stays a single-line block string (dumb, safe).
fn gqlDocOf(name: String, iface: ModuleInterface) -> String {
    let raw = gqlRawDoc(name, iface)
    if raw == "" {
        return ""
    }
    return gqlDescBlock(raw)
}

/// A description text `body` as a well-formed GraphQL block-string description,
/// terminated with a newline. Sanitizes any bytes that would corrupt the `"""`
/// block per the GraphQL spec:
///   - an interior `"""` triple-quote is escaped as `\"""` (the ONLY block-string
///     escape the spec defines); a lone or double quote needs no escaping.
///   - a body that ENDS in `"` would abut the closing delimiter to make `""""`
///     (three-close-plus-stray), so such a body is emitted on its OWN line
///     (`"""\n<body>\n"""`) — the reference-`printBlockString` shape — which keeps
///     the trailing quote away from the delimiter while preserving the text.
/// A quote-free body (the common case) stays a single-line `"""<body>"""`, so an
/// existing description without quotes is byte-identical.
fn gqlDescBlock(body: String) -> String {
    let esc = gqlEscTripleQuote(body)
    if esc.endsWith("\"") {
        return "\"\"\"\n" + esc + "\n\"\"\"\n"
    }
    return "\"\"\"" + esc + "\"\"\"\n"
}

/// `s` with every `"""` run escaped as `\"""` (GraphQL block-string escaping). A
/// single or double quote is left as-is (legal block-string content).
fn gqlEscTripleQuote(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < ba.length {
        if i + 2 < ba.length && ba[i] == '"' && ba[i + 1] == '"' && ba[i + 2] == '"' {
            out.push('\\')
            out.push('"')
            out.push('"')
            out.push('"')
            i = i + 3
        } else {
            out.push(ba[i])
            i = i + 1
        }
    }
    return fromBytesOr(out, "")
}

/// `s` with every run of whitespace folded to a single space, trimmed — so a
/// multi-line `///` doc rides one SDL block-string line.
fn gqlFoldWs(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut prevWs = false
    for b in ba {
        if gqlIsWs(b) {
            if prevWs == false {
                out.push(' ')
            }
            prevWs = true
        } else {
            out.push(b)
            prevWs = false
        }
    }
    return gqlTrim(fromBytesOr(out, ""))
}

// ===========================================================================
// Type emission.
// ===========================================================================

/// The SDL for a RECORD: the `type Name { .. }` object and the `input NameInput
/// { .. }` twin. Each field maps by the scalar table; a non-`Option` field is
/// non-null.
fn gqlRecord(decl: GqlDecl, iface: ModuleInterface) -> String {
    let inner = gqlBetweenBraces(decl.rhs)
    let fields = gqlSplitTop(inner, 44)
    let doc = gqlDocOf(decl.name, iface)
    let mut obj = doc + "type " + decl.name + " {\n"
    let mut inp = "input " + decl.name + "Input {\n"
    for f in fields {
        let colon = gqlIndexOf(bytes(f), ':', 0)
        if colon >= 0 {
            let fname = gqlTrim(gqlSlice(bytes(f), 0, colon))
            let ftypeRaw = gqlTrim(gqlSlice(bytes(f), colon + 1, bytes(f).length))
            let ftype = gqlStripWhere(ftypeRaw)
            obj = obj + "  " + fname + ": " + gqlRef(ftype, false, iface) + "\n"
            inp = inp + "  " + fname + ": " + gqlRef(ftype, true, iface) + "\n"
        }
    }
    obj = obj + "}\n"
    inp = inp + "}\n"
    return obj + inp
}

/// The inner text between the outer `{` and `}` of a record RHS.
fn gqlBetweenBraces(s: String) -> String {
    let ba = bytes(s)
    let mut lo = -1
    let mut hi = -1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '{' && lo < 0 {
            lo = i
        }
        if ba[i] == '}' {
            hi = i
        }
        i = i + 1
    }
    if lo < 0 || hi <= lo {
        return ""
    }
    return gqlSlice(ba, lo + 1, hi)
}

/// A field type with any inline ` where <pred>` refinement stripped (the
/// validated base is what maps to GraphQL).
fn gqlStripWhere(s: String) -> String {
    if s.contains(" where ") {
        let ba = bytes(s)
        // Find " where " and cut before it.
        let mut i = 0
        while i + 7 <= ba.length {
            if gqlSlice(ba, i, i + 7) == " where " {
                return gqlTrim(gqlSlice(ba, 0, i))
            }
            i = i + 1
        }
    }
    return s
}

/// The SDL for an ENUM RHS (`| A | B(T) | C(T, U)`): a real `enum` when every
/// variant is nullary, else a tagged object `type` (one nullable field per
/// variant).
fn gqlEnum(decl: GqlDecl, iface: ModuleInterface) -> String {
    let body = gqlTrim(decl.rhs)
    // Drop a leading `|` then split the variants on top-level `|`.
    let stripped = if body.startsWith("|") {
        gqlTrim(gqlSlice(bytes(body), 1, bytes(body).length))
    } else {
        body
    }
    let variants = gqlSplitTop(stripped, 124)
    let mut anyPayload = false
    for v in variants {
        if v.contains("(") {
            anyPayload = true
        }
    }
    let doc = gqlDocOf(decl.name, iface)
    if anyPayload == false {
        let mut out = doc + "enum " + decl.name + " {\n"
        for v in variants {
            out = out + "  " + gqlTrim(v) + "\n"
        }
        return out + "}\n"
    }
    return doc + gqlTaggedType(decl.name, variants, iface)
}

/// A tagged object `type` for a payload sum: one nullable field per variant
/// (nullary => `Boolean`, single payload => that type, multi payload => `JSON`).
fn gqlTaggedType(name: String, variants: Array<String>, iface: ModuleInterface) -> String {
    let mut out = "type " + name + " {\n"
    for v in variants {
        let paren = gqlIndexOf(bytes(v), '(', 0)
        if paren < 0 {
            out = out + "  " + gqlTrim(v) + ": Boolean\n"
        } else {
            let vname = gqlTrim(gqlSlice(bytes(v), 0, paren))
            let payload = gqlBetweenParens(v)
            let parts = gqlSplitTop(payload, 44)
            if parts.length == 1 {
                out = out + "  " + vname + ": " + gqlStripBang(gqlRef(parts[0], false, iface)) + "\n"
            } else {
                out = out + "  " + vname + ": JSON\n"
            }
        }
    }
    return out + "}\n"
}

/// The inner text between the first `(` and last `)` of `s`.
fn gqlBetweenParens(s: String) -> String {
    let ba = bytes(s)
    let mut lo = -1
    let mut hi = -1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '(' && lo < 0 {
            lo = i
        }
        if ba[i] == ')' {
            hi = i
        }
        i = i + 1
    }
    if lo < 0 || hi <= lo {
        return ""
    }
    return gqlSlice(ba, lo + 1, hi)
}

/// The SDL for a scalar-shaped alias RHS: a `Result<..>` tagged type, a `Map<..>`
/// / validated / bare-primitive custom `scalar`. Named aliases keep their name.
fn gqlAlias(decl: GqlDecl, iface: ModuleInterface) -> String {
    let rhs = gqlTrim(decl.rhs)
    let doc = gqlDocOf(decl.name, iface)
    if rhs.startsWith("Result<") {
        let inner = gqlBetweenAngles(rhs)
        let parts = gqlSplitTop(inner, 44)
        let okT = if parts.length >= 1 { parts[0] } else { "Bool" }
        let errT = if parts.length >= 2 { parts[1] } else { "String" }
        let mut out = doc + "type " + decl.name + " {\n"
        out = out + "  Ok: " + gqlStripBang(gqlRef(okT, false, iface)) + "\n"
        out = out + "  Err: " + gqlStripBang(gqlRef(errT, false, iface)) + "\n"
        return out + "}\n"
    }
    // A `Map<..>` alias, a validated scalar (`Base where ..`), or a bare
    // primitive alias => a documented custom scalar. The description carries the
    // `///` doc AND the underlying base/constraint (the `@constraint`-style doc
    // comment), so a validated type is documented "as its base + constraint".
    let raw = gqlRawDoc(decl.name, iface)
    let body = if raw != "" { raw + " — " + gqlFoldWs(rhs) } else { gqlFoldWs(rhs) }
    return gqlDescBlock(body) + "scalar " + decl.name + "\n"
}

/// The SDL for one type declaration (record / enum / alias).
fn gqlTypeSdl(t: TypeInfo, iface: ModuleInterface) -> String {
    let decl = gqlSplitDecl(t.source)
    if decl.rhs.startsWith("{") {
        return gqlRecord(decl, iface)
    }
    if decl.rhs.startsWith("|") {
        return gqlEnum(decl, iface)
    }
    return gqlAlias(decl, iface)
}

// ===========================================================================
// Root fields.
// ===========================================================================

/// The ROOT a procedure's field belongs under, lowercase as a GraphQL operation
/// type is spelled: `"mutation"` for a `mut fn`, `"query"` for everything else.
///
/// The author's DECLARATION, read off `FnInfo.mutates` (RFC-0074 M4a) — and read
/// in ONE place, because the SDL emitter below and the executor's resolver table
/// (RFC-0085 M1) both need it. Two copies of this two-line rule is exactly the
/// divergence where a field is declared under one root and answered under the
/// other.
fn gqlRootOf(f: FnInfo) -> String {
    if f.mutates {
        return "mutation"
    }
    return "query"
}

/// The GraphQL root TYPE name for an operation type (`query` => `Query`).
export fn gqlRootType(root: String) -> String {
    if root == "mutation" {
        return "Mutation"
    }
    return "Query"
}

/// One root field for a procedure: `name(input: <Req>Input): <Ret>` (or no args
/// for a zero-parameter procedure). A `Unit` return maps to `Boolean`.
fn gqlRootField(f: FnInfo, iface: ModuleInterface) -> String {
    let ret = if f.ret == "" { "Boolean" } else { gqlStripBang(gqlRef(f.ret, false, iface)) }
    if f.params.length == 1 {
        let arg = gqlRef(f.params[0].spelling, true, iface)
        return "  " + f.name + "(input: " + arg + "): " + ret + "\n"
    }
    return "  " + f.name + ": " + ret + "\n"
}

// ===========================================================================
// The generator.
// ===========================================================================

/// `sdl(contract)` — emit a module exporting `sdlText() -> String`, a GraphQL SDL
/// document for the contract. The document is baked as a deterministic constant.
export gen fn sdl(contract: String) -> String {
    let iface = moduleInterface(contract)
    let mut doc = "# GraphQL SDL generated by std/graphql `sdl` (RFC-0038).\n"
    doc = doc + "# Records => type/input pairs; validated scalars => custom scalars\n"
    doc = doc + "# (base + constraint in the description); Map => the JSON scalar;\n"
    doc = doc + "# payload enums (incl. Result) => tagged objects (one nullable\n"
    doc = doc + "# field per variant); a `mut fn` => Mutation, else Query.\n"
    // The JSON scalar (documented) — the honest stand-in for `Map<String, V>`.
    doc = doc + "\"\"\"An arbitrary JSON value — the wire form of a Vyrn Map<String, V>.\"\"\"\n"
    doc = doc + "scalar JSON\n"

    // Types, in the reflection's deterministic order.
    for t in iface.types {
        doc = doc + gqlTypeSdl(t, iface)
    }

    // Query / Mutation roots.
    let mut queries = ""
    let mut mutations = ""
    for f in iface.functions {
        if gqlRootOf(f) == "mutation" {
            mutations = mutations + gqlRootField(f, iface)
        } else {
            queries = queries + gqlRootField(f, iface)
        }
    }
    doc = doc + "type Query {\n"
    if queries == "" {
        doc = doc + "  _placeholder: Boolean\n"
    } else {
        doc = doc + queries
    }
    doc = doc + "}\n"
    if mutations != "" {
        doc = doc + "type Mutation {\n" + mutations + "}\n"
    }

    // Bake the whole SDL string into the emitted module via a `vyrn"…"` code
    // quote (RFC-0054). The `\{doc}` splice is in EXPRESSION position, so `doc`
    // becomes an escaped Vyrn string LITERAL by construction — the compiler's own
    // escaping replaces the hand-rolled `gqlEscBody` byte loop, so a mis-escape
    // (an unescaped `"`/`\`/newline corrupting the baked SDL) is unrepresentable.
    return render(vyrn"""/// Generated by std/graphql `sdl` (RFC-0038) — do not edit.
/// The contract's GraphQL SDL document (deterministic, byte-stable).
export fn sdlText() -> String {
    return \{doc}
}
""")
}

// ===========================================================================
// The executor (RFC-0085 M1) — RUNTIME code, not generation.
//
// Everything above this line runs at comptime and bakes a document. Everything
// below runs in the served process: it parses one request's query, projects the
// value a procedure returned, and writes the reply. It lives in this file so the
// generated module is nothing but an import block and a resolver table — the
// same division `std/ui` draws when its generated pages import `PageError` back
// from `std/ui`.
// ===========================================================================

/// One selected field: its name and whatever it selects in turn.
///
/// No alias and no arguments — both are RFC-0085 M2, and the parser REFUSES them
/// by name rather than dropping them, so a query that means something this
/// milestone cannot do is never answered as if it meant something else.
export type GqlSel = { name: String, subs: Array<GqlSel> }

/// A parsed selection set, or the reason it would not parse (`err != ""`).
type GqlSet = { sels: Array<GqlSel>, err: String }

/// A parsed operation: its root (`"query"` / `"mutation"`), its selected fields,
/// and the reason it would not parse (`err != ""`).
export type GqlQuery = { root: String, sels: Array<GqlSel>, err: String }

/// The GraphQL flavor of the shared cursor (RFC-0054): `#` line comments, `"`
/// strings with `\` escapes, no block comments — the query language's own
/// lexical rules, so a `{` inside a string argument is never read as structure.
fn gqlScanner(src: String) -> Scanner {
    return scanner(src, "#", "", "", 34, -1, 92)
}

/// Whether the cursor sits on byte `b`.
fn gqlAt(sc: Scanner, b: UInt8) -> Bool {
    return peek(sc) == Int64(b)
}

/// A failed parse carrying `why`.
fn gqlSetErr(why: String) -> GqlSet {
    return GqlSet { sels: [], err: why }
}

/// Parse a selection set, the cursor sitting on its opening `{`.
///
/// Commas are insignificant in GraphQL — the spec lists them with whitespace —
/// so they are skipped rather than required.
fn gqlSelSet(sc: modify Scanner) -> GqlSet {
    if gqlAt(sc, '{') == false {
        return gqlSetErr("expected `{` to open a selection set")
    }
    advance(sc)
    let mut out: Array<GqlSel> = []
    skipWs(sc)
    while atEnd(sc) == false && gqlAt(sc, '}') == false {
        if gqlAt(sc, ',') {
            advance(sc)
            skipWs(sc)
            continue
        }
        let name = ident(sc)
        if name == "" {
            return gqlSetErr("expected a field name in a selection set")
        }
        skipWs(sc)
        if gqlAt(sc, ':') {
            return gqlSetErr("field `" + name + "`: aliases are not supported yet (RFC-0085 M2)")
        }
        if gqlAt(sc, '(') {
            return gqlSetErr("field `" + name + "`: field arguments are not supported yet (RFC-0085 M2)")
        }
        let mut subs: Array<GqlSel> = []
        if gqlAt(sc, '{') {
            let inner = gqlSelSet(sc)
            if inner.err != "" {
                return inner
            }
            subs = inner.sels
        }
        out.push(GqlSel { name: name, subs: subs })
        skipWs(sc)
    }
    if gqlAt(sc, '}') == false {
        return gqlSetErr("unterminated selection set: expected `}`")
    }
    advance(sc)
    if out.length == 0 {
        return gqlSetErr("a selection set must select at least one field")
    }
    return GqlSet { sels: out, err: "" }
}

/// Parse one executable operation: an optional `query`/`mutation` keyword and
/// operation name, then a selection set. Anything past it is a second operation,
/// which needs `operationName` to choose between — RFC-0085 M2.
export fn gqlParseQuery(src: String) -> GqlQuery {
    let mut sc = gqlScanner(src)
    skipWs(sc)
    let mut root = "query"
    if gqlAt(sc, '{') == false {
        let kw = ident(sc)
        if kw == "" {
            return GqlQuery { root: root, sels: [], err: "the request carried no query" }
        }
        if kw != "query" && kw != "mutation" {
            return GqlQuery {
                root: root,
                sels: [],
                err: "expected `{`, `query` or `mutation`, found `" + kw + "`",
            }
        }
        root = kw
        skipWs(sc)
        // The operation NAME, which nothing selects between at M1. Variable
        // definitions ride arguments, so they are refused with them.
        let _ = ident(sc)
        skipWs(sc)
    }
    let set = gqlSelSet(sc)
    if set.err != "" {
        return GqlQuery { root: root, sels: [], err: set.err }
    }
    skipWs(sc)
    if atEnd(sc) == false {
        return GqlQuery {
            root: root,
            sels: [],
            err: "a document with more than one operation is not supported yet (RFC-0085 M2)",
        }
    }
    return GqlQuery { root: root, sels: set.sels, err: "" }
}

// ---- projection ------------------------------------------------------------

/// The value of `key` among `fields`, or `JNull`.
fn gqlMemberOf(fields: Array<JsonField>, key: String) -> Json {
    for f in fields {
        if f.key == key {
            return f.value
        }
    }
    return JNull
}

/// Project `sels` out of `v`.
///
/// **Field selection is a projection over a value the procedure ALREADY
/// returned, not a fetch plan.** `v` arrives here fully computed — every field of
/// it, selected or not, was produced by the procedure and encoded before this
/// function saw it. So at a leaf this OMITS; it does not avoid computing. Nothing
/// below is lazy and a reader must not read it as if it were.
///
/// That distinction is the one RFC-0074 M4b's `.lazy(field, resolver)` later has
/// to break: a lazy field is the single case where omission must ALSO mean the
/// work was never done. Stated here because if it is only stated then, `.lazy(..)`
/// is an optimisation nobody can observe and there is nothing to point at.
///
/// An empty selection set means "this field is a leaf" — take the value whole.
export fn gqlProject(v: Json, sels: Array<GqlSel>) -> Json {
    if sels.length == 0 {
        return v
    }
    return match v {
        JArr(items) => JArr(gqlProjectEach(items, sels)),
        JObj(fields) => JObj(gqlPick(fields, sels)),
        // A selection on a scalar is a schema error GraphQL names ("field must
        // not have a selection since type String has no subfields"). Reporting it
        // needs the type graph rather than the value, so it belongs with the rest
        // of the error model — RFC-0085 M3. Until then the scalar answers itself.
        JNull => JNull,
        JBool(b) => JBool(b),
        JNum(n) => JNum(n),
        JStr(s) => JStr(s),
    }
}

/// Project the same selection out of every element of a list.
fn gqlProjectEach(items: Array<Json>, sels: Array<GqlSel>) -> Array<Json> {
    let mut out: Array<Json> = []
    for it in items {
        out.push(gqlProject(it, sels))
    }
    return out
}

/// Keep exactly the selected members, in the order the QUERY asked for them —
/// GraphQL's response order is the selection's, not the record's.
///
/// A selected member the value does not carry answers `null` rather than
/// vanishing, because a client indexes the reply by the names it wrote. It cannot
/// be reported as undeclared from here: `toJson` OMITS an `Option` field that is
/// `None`, so absence in the value and absence from the schema look identical at
/// this level. The schema is consulted where it is known — the resolver table
/// below answers for root fields — and carrying the type graph deeper is what
/// nested validation costs (RFC-0085 M2/M3).
fn gqlPick(fields: Array<JsonField>, sels: Array<GqlSel>) -> Array<JsonField> {
    let mut out: Array<JsonField> = []
    for s in sels {
        out.push(JsonField { key: s.name, value: gqlProject(gqlMemberOf(fields, s.name), s.subs) })
    }
    return out
}

// ---- the request and the reply ---------------------------------------------

/// The query text of a request body: the `query` member of a GraphQL-over-HTTP
/// JSON envelope, or — when the body is not such an envelope — the body itself,
/// which is what an `application/graphql` request sends. A GraphQL document is
/// not valid JSON, so the two cannot be confused.
export fn gqlQueryText(body: String) -> String {
    return match parseJson(body) {
        Ok(doc) => gqlEnvelopeQuery(doc, body),
        Err(e) => body,
    }
}

/// The `query` string of a parsed envelope, or `fallback`.
fn gqlEnvelopeQuery(doc: Json, fallback: String) -> String {
    return match doc {
        JObj(fields) => gqlStrOr(gqlMemberOf(fields, "query"), fallback),
        JNull => fallback,
        JBool(b) => fallback,
        JNum(n) => fallback,
        JStr(s) => fallback,
        JArr(xs) => fallback,
    }
}

/// A JSON string's text, or `fallback` for any other value.
fn gqlStrOr(j: Json, fallback: String) -> String {
    return match j {
        JStr(s) => s,
        JNull => fallback,
        JBool(b) => fallback,
        JNum(n) => fallback,
        JArr(xs) => fallback,
        JObj(o) => fallback,
    }
}

/// `{"data":{"<field>":…}}` — the answer.
export fn gqlDataBody(field: String, value: Json) -> String {
    let one: Array<JsonField> = [JsonField { key: field, value: value }]
    return emit(JObj([JsonField { key: "data", value: JObj(one) }]))
}

/// `{"errors":[{"message":"…"}]}` — an error a GraphQL client can read.
///
/// A GraphQL client reads the `errors` array, not the status line, so the reply
/// stays a 200 `application/json`. Path attribution and partial `data` beside a
/// populated `errors` are RFC-0085 M3.
export fn gqlErrorBody(message: String) -> String {
    let one: Array<JsonField> = [JsonField { key: "message", value: JStr(message) }]
    return emit(JObj([JsonField { key: "errors", value: JArr([JObj(one)]) }]))
}

/// A GraphQL reply carrying `body`.
fn gqlReply(body: String) -> Response {
    return Response { status: 200, contentType: "application/json", body: body, vary: "", headers: [:] }
}

/// Answer one GraphQL request body against `resolve`, the generated resolver
/// table (`(root, field) -> the encoded value, or why not`).
///
/// One root field per request: a second one immediately raises partial `data`
/// beside a populated `errors` when only one of them resolves, which is the whole
/// of RFC-0085 M3 and is not worth half-building here.
export fn gqlAnswer(body: String, resolve: fn(String, String) -> Result<Json, String>) -> Response {
    let q = gqlParseQuery(gqlQueryText(body))
    if q.err != "" {
        return gqlReply(gqlErrorBody(q.err))
    }
    if q.sels.length != 1 {
        return gqlReply(gqlErrorBody(
                "one root field per request (RFC-0085 M1); this operation selects "
                + q.sels.length.toString()
            ))
    }
    let sel = q.sels[0]
    return match resolve(q.root, sel.name) {
        Ok(v) => gqlReply(gqlDataBody(sel.name, gqlProject(v, sel.subs))),
        Err(why) => gqlReply(gqlErrorBody(why)),
    }
}

// ---- the generator ---------------------------------------------------------

/// The import block the emitted module needs (RFC-0031): the contract's
/// procedures from the contract itself, each type from the module that DECLARES
/// it, so a type reached across an import keeps one identity.
fn gqlImportBlock(iface: ModuleInterface, contract: String) -> String {
    let mut specs: Array<String> = [contract]
    for t in iface.types {
        if gqlHas(specs, t.module) == false {
            specs.push(t.module)
        }
    }
    let mut out = ""
    for spec in specs {
        let mut names: Array<String> = []
        if spec == contract {
            for f in iface.functions {
                names.push(f.name)
            }
        }
        for t in iface.types {
            if t.module == spec {
                names.push(t.name)
            }
        }
        if names.length > 0 {
            out = out + "import { " + gqlJoin(names, ", ") + " } from \"" + spec + "\"\n"
        }
    }
    return out
}

/// Whether `items` already contains `needle`.
fn gqlHas(items: Array<String>, needle: String) -> Bool {
    for it in items {
        if it == needle {
            return true
        }
    }
    return false
}

/// Join `parts` with `sep` between them.
fn gqlJoin(parts: Array<String>, sep: String) -> String {
    let mut out = ""
    let mut i = 0
    for p in parts {
        if i > 0 {
            out = out + sep
        }
        out = out + p
        i = i + 1
    }
    return out
}

/// The resolver table: one arm per procedure, over the SAME `iface.functions`
/// walk `sdl` emits root fields from and the same `gqlRootOf` verdict, so the
/// schema and the executor cannot disagree about which fields exist or which root
/// answers them. A field no arm claims is GraphQL's own "Cannot query field" —
/// an error naming it, not a trap and not a 500.
///
/// A procedure that takes an argument is in the table and refuses BY NAME:
/// decoding a field's arguments into its input record is RFC-0085 M2, and a
/// declared field silently missing from the executor is the divergence this whole
/// shape exists to prevent.
fn gqlResolverTable(iface: ModuleInterface) -> String {
    let mut out = "/// Decode the procedure's encoded result into the value tree a projection is\n"
    out = out + "/// written over. The procedure has ALREADY run when this is reached.\n"
    out = out + "fn gqlValueOf(encoded: String) -> Json {\n"
    out = out + "    return match parseJson(encoded) {\n"
    out = out + "        Ok(v) => v,\n"
    out = out + "        Err(e) => JNull,\n"
    out = out + "    }\n}\n"
    out = out + "/// The resolver table, generated from the contract's reflection.\n"
    out = out + "fn gqlResolve(root: String, field: String) -> Result<Json, String> {\n"
    for f in iface.functions {
        let want = gqlRootOf(f)
        out = out + "    if field == \"" + f.name + "\" {\n"
        out = out + "        if root != \"" + want + "\" {\n"
        out = out + "            return Err(\"Cannot query field `" + f.name + "` on type `\" + gqlRootType(root) + \"`.\")\n"
        out = out + "        }\n"
        if f.params.length > 0 {
            out = out + "        return Err(\"Field `" + f.name + "` takes arguments, which are not supported yet (RFC-0085 M2).\")\n"
        } else if f.ret == "" {
            out = out + "        return Err(\"Field `" + f.name + "` returns nothing, so there is no value to select from.\")\n"
        } else {
            out = out + "        return Ok(gqlValueOf(toJson(" + f.name + "())))\n"
        }
        out = out + "    }\n"
    }
    out = out + "    return Err(\"Cannot query field `\" + field + \"` on type `\" + gqlRootType(root) + \"`.\")\n}\n"
    return out
}

/// `graphqlServer(contract)` — emit a module exposing
/// `graphqlHandle(req: Request) -> Option<Response>`, answering `POST /graphql`
/// against the same contract `sdl(contract)` documents (RFC-0085 M1).
///
/// It mounts beside `rpcHandle` and `connectHandle` on one `serve` root: a
/// GraphQL request is an ordinary route over the same procedures and the same
/// `toJson`, not a second wire. The generator is `graphqlServer` (not
/// `graphqlHandle`) for the reason `std/rpc` and `std/connect` already record — a
/// `gen fn` and the module it emits are both linked, and the flat namespace
/// forbids the clash.
export gen fn graphqlServer(contract: String) -> String {
    let iface = moduleInterface(contract)
    // The SAME `Api` + serializability rule the RPC and REST surfaces apply. The
    // SDL only reads type SPELLINGS and needs no such check; this generator emits
    // a `toJson` call per procedure, which is precisely what the rule governs.
    let err = validateContract(iface)
    if err != "" {
        return err
    }
    let mut out = "/// Generated by std/graphql `graphqlServer` (RFC-0085) — do not edit.\n"
    out = out + gqlImportBlock(iface, contract)
    out = out + "import { Json } from \"std/json\"\n"
    out = out + "import { parseJson } from \"std/jsonread\"\n"
    out = out + "import { gqlAnswer, gqlRootType } from \"std/graphql\"\n"
    out = out + gqlResolverTable(iface)
    out = out + "/// `POST /graphql`. `None` (not our path) for everything else, so this mounts\n"
    out = out + "/// beside the other projections of the same procedures.\n"
    out = out + "export fn graphqlHandle(req: Request) -> Option<Response> {\n"
    out = out + "    if req.path != \"/graphql\" {\n"
    out = out + "        return None\n"
    out = out + "    }\n"
    out = out + "    if req.method != \"POST\" {\n"
    out = out + "        return Some(Response { status: 405, contentType: \"text/plain\", body: \"method not allowed\", vary: \"\", headers: [:] })\n"
    out = out + "    }\n"
    out = out + "    return Some(gqlAnswer(req.body, gqlResolve))\n}\n"
    return out
}

// ===========================================================================
// Tests — the pure mapping helpers (the whole SDL is golden-pinned in Rust).
// ===========================================================================

test "gqlPrim maps the honest scalar table" {
    assertEq(gqlPrim("Int64"), "Int")
    assertEq(gqlPrim("UInt8"), "Int")
    assertEq(gqlPrim("Float64"), "Float")
    assertEq(gqlPrim("String"), "String")
    assertEq(gqlPrim("Bool"), "Boolean")
    assertEq(gqlPrim("Book"), "")
}

test "gqlSplitDecl splits name and rhs" {
    let d = gqlSplitDecl("export type BookId = Int64 where value >= 0")
    assertEq(d.name, "BookId")
    assertEq(d.rhs, "Int64 where value >= 0")
}

test "gqlBetweenAngles and gqlStripWhere" {
    assertEq(gqlBetweenAngles("Array<Tag>"), "Tag")
    assertEq(gqlBetweenAngles("Map<String, Int64>"), "String, Int64")
    assertEq(gqlStripWhere("String where value.byteLength >= 1"), "String")
}

test "gqlSplitTop respects angle and paren nesting" {
    let parts = gqlSplitTop("id: BookId, tags: Array<Tag>, m: Map<String, Int64>", 44)
    assertEq(parts.length, 3)
    assertEq(parts[2], "m: Map<String, Int64>")
}

test "gqlSplitTop is string-literal aware — a predicate string never splits" {
    // A record field carrying an inline `where` predicate whose regex string holds
    // a comma, a brace, and an escaped quote must stay ONE field.
    let parts = gqlSplitTop("a: String, b: String where value =~ \"x,y}z\\\"w\"", 44)
    assertEq(parts.length, 2)
    assertEq(parts[0], "a: String")
    assertEq(parts[1], "b: String where value =~ \"x,y}z\\\"w\"")
}

test "gqlSplitTop clamps bracket depth at zero" {
    // A stray closer must never drive depth negative and fabricate a split.
    let parts = gqlSplitTop("a}, b", 44)
    assertEq(parts.length, 2)
}

test "gqlEscTripleQuote escapes only triple quotes" {
    assertEq(gqlEscTripleQuote("a \"b\" c"), "a \"b\" c")
    assertEq(gqlEscTripleQuote("x\"\"\"y"), "x\\\"\"\"y")
}

test "gqlDescBlock keeps a quote-free body single-line, pads a quote-ending body" {
    assertEq(gqlDescBlock("A stored user."), "\"\"\"A stored user.\"\"\"\n")
    // A body ending in a quote goes on its own line so `..." \"\"\"` cannot form
    // four consecutive quotes.
    assertEq(gqlDescBlock("re \"x\""), "\"\"\"\nre \"x\"\n\"\"\"\n")
}

// ---- the executor (RFC-0085 M1) -------------------------------------------

/// The shape a shelf `browse` returns, as the value tree a projection sees.
fn gqlTestValue() -> Json {
    let book: Array<JsonField> = [
        JsonField { key: "id", value: JNum("0") },
        JsonField { key: "title", value: JStr("SICP") },
        JsonField { key: "url", value: JStr("https://example.com") },
    ]
    return JObj([JsonField { key: "books", value: JArr([JObj(book)]) }])
}

test "gqlParseQuery reads a nested selection set" {
    let q = gqlParseQuery("{ browse { books { title } } }")
    assertEq(q.err, "")
    assertEq(q.root, "query")
    assertEq(q.sels.length, 1)
    assertEq(q.sels[0].name, "browse")
    assertEq(q.sels[0].subs[0].name, "books")
    assertEq(q.sels[0].subs[0].subs[0].name, "title")
}

test "gqlParseQuery takes an operation type and treats commas as whitespace" {
    let q = gqlParseQuery("mutation Add { a, b }")
    assertEq(q.err, "")
    assertEq(q.root, "mutation")
    assertEq(q.sels.length, 2)
    assertEq(q.sels[1].name, "b")
}

test "gqlParseQuery refuses M2's syntax by name rather than dropping it" {
    assert(gqlParseQuery("{ byId(id: 1) { title } }").err.contains("arguments"))
    assert(gqlParseQuery("{ one: browse { title } }").err.contains("aliases"))
    assert(gqlParseQuery("{ browse { title }").err.contains("unterminated"))
    assert(gqlParseQuery("").err.contains("no query"))
}

test "gqlProject omits what was not selected" {
    // The whole point: `url` and `id` were computed and encoded, and the
    // projection leaves them out. Assert the ABSENCE — a projection that returned
    // the record whole would pass a test that only looked for `title`.
    let sels = gqlParseQuery("{ browse { books { title } } }").sels
    let out = emit(gqlProject(gqlTestValue(), sels[0].subs))
    assertEq(out, "{\"books\":[{\"title\":\"SICP\"}]}")
    assert(out.contains("url") == false)
    assert(out.contains("id") == false)
}

test "gqlProject takes a leaf whole and answers null for a member the value lacks" {
    let sels = gqlParseQuery("{ browse { books } }").sels
    assertEq(emit(gqlProject(gqlTestValue(), sels[0].subs)).contains("\"url\""), true)
    let missing = gqlParseQuery("{ browse { shelved } }").sels
    assertEq(emit(gqlProject(gqlTestValue(), missing[0].subs)), "{\"shelved\":null}")
}

test "gqlQueryText reads an envelope or a bare document" {
    assertEq(gqlQueryText("{\"query\":\"{ browse }\"}"), "{ browse }")
    assertEq(gqlQueryText("{ browse }"), "{ browse }")
}

test "gqlErrorBody is the shape a client reads" {
    assertEq(gqlErrorBody("nope"), "{\"errors\":[{\"message\":\"nope\"}]}")
    assertEq(gqlRootType("mutation"), "Mutation")
    assertEq(gqlRootType("query"), "Query")
}
