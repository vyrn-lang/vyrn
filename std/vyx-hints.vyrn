/// The complete allowed-attribute tables — the census's last open row of
/// table two, blocked until now on a source with the COMPLETE per-element
/// sets (`html5.ts` lists only constrained attributes). Read from
/// `wooorm/html-element-attributes` master, `index.js`, on 2026-08-29 —
/// spec-derived and maintained: 31 global attributes, and 413 (element,
/// attribute) rows across 77 elements, grouped by attribute name. `role`
/// and `aria-*` are the ARIA space, exempted where the rule fires; `data-*`
/// is custom by definition; `v-*` is the template's own vocabulary.
fn vhGlobalAttr(name: String) -> Bool {
    if name.byteLength == 0 {
        return false
    }
    let lead = bytes(name)[0]
    if lead == 'a' {
        return name == "accesskey" || name == "autocapitalize" || name == "autocorrect" || name == "autofocus"
    }
    if lead == 'c' {
        return name == "class" || name == "contenteditable"
    }
    if lead == 'd' {
        return name == "dir" || name == "draggable"
    }
    if lead == 'e' {
        return name == "enterkeyhint" || name == "exportparts"
    }
    if lead == 'h' {
        return name == "hidden"
    }
    if lead == 'i' {
        return name == "id" || name == "inert" || name == "inputmode" || name == "is" || name == "itemid" || name == "itemprop" || name == "itemref" || name == "itemscope" || name == "itemtype"
    }
    if lead == 'l' {
        return name == "lang"
    }
    if lead == 'n' {
        return name == "nonce"
    }
    if lead == 'p' {
        return name == "part" || name == "popover"
    }
    if lead == 's' {
        return name == "slot" || name == "spellcheck" || name == "style"
    }
    if lead == 't' {
        return name == "tabindex" || name == "title" || name == "translate"
    }
    if lead == 'w' {
        return name == "writingsuggestions"
    }
    return false
}

