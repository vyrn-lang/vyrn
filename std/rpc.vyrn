/// Typed RPC as a library, built on generator imports.
/// A procedure is an exported function of a procedure module with at
/// most one parameter and both ends serializable (the `Api` contract plus
/// `rpcWhyNotSerializable`); anything else fails the load at the generator call.
///
/// - Directory forms: `rpc(dir)` mounts every module under an api
///   directory at a path derived from the module path and the export name;
///   `client(dir)` and `clientInProcess(dir)` emit the calling side.
/// - Single-module forms: `rpcServer`, `rpcClient` and `rpcInProcess`.
///
/// Inspect a generated module with `vyrn emit-gen <file>`, the derived table
/// with `vyrn routes <file>`.

import { fromBytesOr, joinWith } from "std/strings"
import { includes } from "std/arrays"
import { importBlock, procImports } from "std/imports"
import { join } from "std/code"
import { checkContract } from "std/contract"
import { report, reportHere, Severity } from "std/diag"

// `rpc` and `client` bake a `symbolMap()` into the module they emit, so the
// content-hash cache invalidates the map with the code it describes.
import { Symbol, symbol, strField, symbolMapFn } from "std/symbolmap"
import { contains, endsWith, slice, startsWith } from "std/strpred"

/// What a procedure module may export. Open: procedure names are the
/// application's vocabulary. The rule constrains only the return, and the rest
/// (one parameter, both ends serializable) is a property of the types that the
/// contract grammar cannot spell, so `rpcWhyNotSerializable` checks it.
export contract Api {
    /// A procedure: at most one serializable parameter in, a serializable value
    /// (or nothing) out.
    fn *(..) -> R
}

/// Uppercases the first ASCII byte: `getUser` gives `vyrnRpcDoneGetUser` and `rpcPendingGetUser`.
fn capFirst(s: String) -> String {
    let raw = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in raw {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// Whether `spelling` names one of the contract's exported types.
fn isNamedType(spelling: String, iface: ModuleInterface) -> Bool {
    for t in iface.types {
        if t.name == spelling {
            return true
        }
    }
    return false
}

/// The serializability rule, stated once: "" when a value of `spelling` can
/// cross the wire, else the clause saying why. `uncodable` is the reflected
/// verdict for the end asked about (`ParamInfo.uncodable` or `FnInfo.retUncodable`).
/// A `Unit` return (spelled "") sends nothing: the server's 204.
///
/// Three refusals, in order:
/// - A `Stream`, by name: a procedure answers all at once, and a feed belongs to
///   `sse`/`ws` in a dotted projection module.
/// - Not codable: the compiler's own `toJson`/`fromJson` rule, carried by
///   reflection, so a record with a `fn` field is refused here and not inside the
///   generated module.
/// - Not nameable: `fromJson<Type>` and `jsonSchema<Type>` are emitted as source
///   text, so a bare `Int64` or `Array<Paste>` must be wrapped in a record.
fn rpcWhyNotSerializable(spelling: String, uncodable: String, iface: ModuleInterface) -> String {
    if spelling == "" {
        return ""
    }
    if spelling.startsWith("Stream<") {
        return "a procedure answers all at once, and a stream is still producing — publish a feed with `sse` or `ws` from a dotted projection module beside the procedures"
    }
    if uncodable != "" {
        return "`\{uncodable}` cannot cross a JSON wire"
    }
    if isNamedType(spelling, iface) == false {
        return "it must be a type the contract exports by name — wrap it in a record, which is what keeps the wire an object and the payload versionable"
    }
    return ""
}

/// The first objection to `iface` as a procedure module, or `None`: the `Api`
/// contract, then serializability. A `gen fn`, because `contractOf` has no
/// runtime lowering. Exported for `std/http`'s REST projection and
/// `std/graphql`'s executor, which publish the same procedures under the same rule.
export gen fn validateContract(iface: ModuleInterface) -> Option<Code> {
    for iss in checkContract(iface, contractOf(Api)) {
        return Some(reportHere(Error, iss.message))
    }
    for f in iface.functions {
        if f.params.length > 1 {
            return Some(reportHere(
                Error,
                "procedure `\{f.name}` takes \{f.params.length.toString()} parameters — a procedure takes at most one; gather them into one exported record type",
            ))
        }
        if f.params.length == 1 {
            let why = rpcWhyNotSerializable(f.params[0].spelling, f.params[0].uncodable, iface)
            if why != "" {
                return Some(reportHere(
                    Error,
                    "procedure `\{f.name}` takes `\{f.params[0].spelling}`, which cannot cross the wire: \{why}",
                ))
            }
        }
        let whyRet = rpcWhyNotSerializable(f.ret, f.retUncodable, iface)
        if whyRet != "" {
            return Some(reportHere(
                Error,
                "procedure `\{f.name}` returns `\{f.ret}`, which cannot cross the wire: \{whyRet}",
            ))
        }
    }
    return None
}

/// The reply surface every client flavor exports: `RpcIssue`,
/// `RpcReply<T>`, and `rpcIssuesFrom`, which maps client-side `fromJson` issues
/// to the shape a server 422 yields. The wire client and the in-process mirror
/// emit it identically, so their stubs are interchangeable.
///
/// The 422 arm is `Rejected`, not `Invalid`: variant constructors
/// share one global table, and the prelude `Validation` owns `Invalid`.
gen fn rpcReplyTypes() -> Code {
    return vyrn"""
        export type RpcIssue = { key: String, path: String, message: String }
        export type RpcReply<T> = enum {
            Done(T),
            Rejected(Array<RpcIssue>),
            Failed(String) }
        /// Map validation `Issue`s (a client-side `fromJson` prevalidation) into the
        /// same `RpcIssue` shape a server 422 yields, so both rejection sides render one shape.
        export fn rpcIssuesFrom(from: Array<Issue>) -> Array<RpcIssue> {
            let mut out: Array<RpcIssue> = []
            for i in from {
                out.push(RpcIssue { key: i.key.copy(), path: i.path.copy(), message: i.message.copy() })
            }
            return out
        }

        """
}

/// One procedure's handler, `rpcHandle<cap>`: decode, call `real`, encode. A
/// decode failure is a 422 with the issues; a `Unit` return is a 204.
gen fn rpcHandlerFn(f: FnCode, cap: String, real: Code) -> Code {
    let handler = name("rpcHandle" + cap)
    let run = name("rpcRun" + cap)
    if f.params.length == 1 {
        let req = f.params[0].ty
        return match f.ret {
            Some(_) => vyrn"""
                fn \{handler}(body: String) -> Response {
                    return match fromJson<\{req}>(body) {
                        Valid(input) => Response { status: 200, contentType: "application/json", body: toJson(\{real}(input)), vary: "", headers: [:] },
                        Invalid(issues) => Response { status: 422, contentType: "application/json", body: toJson(RpcIssues { issues: issues }), vary: "", headers: [:] },
                    }
                }

                """,
            None => vyrn"""
                fn \{handler}(body: String) -> Response {
                    return match fromJson<\{req}>(body) {
                        Valid(input) => \{run}(input),
                        Invalid(issues) => Response { status: 422, contentType: "application/json", body: toJson(RpcIssues { issues: issues }), vary: "", headers: [:] },
                    }
                }
                fn \{run}(input: \{req}) -> Response {
                    \{real}(input)
                    return Response { status: 204, contentType: "application/json", body: "", vary: "", headers: [:] }
                }

                """,
        }
    }
    return match f.ret {
        Some(_) => vyrn"""
            fn \{handler}(body: String) -> Response {
                return Response { status: 200, contentType: "application/json", body: toJson(\{real}()), vary: "", headers: [:] }
            }

            """,
        None => vyrn"""
            fn \{handler}(body: String) -> Response {
                \{real}()
                return Response { status: 204, contentType: "application/json", body: "", vary: "", headers: [:] }
            }

            """,
    }
}

/// One procedure's entry in the `$schema` registry: `head` opens it, then the
/// request and response JSON Schema, or `null` when the end is not a named type.
gen fn rpcSchemaEntry(head: String, f: FnCode, iface: ModuleInterface) -> Code {
    let nullSchema = vyrn"""
        acc = acc + "null"
        """
    let request = if f.params.length == 1 && isNamedType(f.params[0].info.spelling, iface) {
        vyrn"acc = acc + jsonSchema<\{f.params[0].ty}>()"
    } else {
        nullSchema
    }
    let response = match f.ret {
        Some(r) => if isNamedType(f.info.ret, iface) {
            vyrn"acc = acc + jsonSchema<\{r}>()"
        } else {
            nullSchema
        },
        None => nullSchema,
    }
    let between = ",\"response\":"
    return vyrn"""
        acc = acc + \{head}
        \{request}
        acc = acc + \{between}
        \{response}
        acc = acc + "}"

        """
}

/// The `GET <prefix>/$schema` registry over `entries`, built once per process:
/// every piece is constant, and the caller serves it per HTTP request.
gen fn rpcSchemaFn(entries: Code) -> Code {
    let open = "{\"procedures\":["
    let close = vyrn"""
        acc = acc + "]}"
        rpcSchemaCache = acc
        return rpcSchemaCache.copy()
        """
    return vyrn"""
        let mut rpcSchemaCache: String = ""
        fn rpcSchema() -> String {
            if rpcSchemaCache.byteLength > 0 {
                return rpcSchemaCache.copy()
            }
            let mut acc = \{open}
            \{entries + close}
        }

        """
}

/// The exported router over `arms`: 405 on the wrong method, 404 on an unknown
/// procedure under `prefix`, and `None` for any other path.
gen fn rpcRouterFn(prefix: String, arms: Code) -> Code {
    let tail = vyrn"""
        if req.path.startsWith(\{prefix + "/"}) {
            return Some(Response { status: 404, contentType: "text/plain", body: "no such procedure", vary: "", headers: [:] })
        }
        return None
        """
    return vyrn"""
        export fn rpcHandle(req: Request) -> Option<Response> {
            if req.path == \{prefix + "/$schema"} {
                if req.method == "GET" {
                    return Some(Response { status: 200, contentType: "application/json", body: rpcSchema(), vary: "", headers: [:] })
                }
                return Some(Response { status: 405, contentType: "text/plain", body: "method not allowed", vary: "", headers: [:] })
            }
            \{arms + tail}
        }

        """
}

/// One router arm: POST `path` dispatches to `rpcHandle<cap>`.
gen fn rpcRouterArm(path: String, cap: String) -> Code {
    return vyrn"""
        if req.path == \{path} {
            if req.method != "POST" {
                return Some(Response { status: 405, contentType: "text/plain", body: "method not allowed", vary: "", headers: [:] })
            }
            return Some(\{name("rpcHandle" + cap)}(req.body))
        }

        """
}

/// Emits a module that imports the contract's procedures and exposes
/// `rpcHandle(req: Request) -> Option<Response>`.
export gen fn rpcServer(contract: String) -> Code {
    let m = moduleCode(contract)
    return match validateContract(m.iface) {
        Some(err) => err,
        None => rpcServerModule(m, contract),
    }
}

gen fn rpcServerModule(m: ModuleCode, contract: String) -> Code {
    let mut out = vyrn"""
        /// Generated by std/rpc `rpcServer` — do not edit.
        import { startsWith } from "std/strpred"

        """
    out = out + importBlock(m.iface, contract, procImports(m.iface, false)) + vyrn"""

        type RpcIssues = { issues: Array<Issue> }

        """
    let mut entries = vyrn""
    let mut arms = vyrn""
    let mut i = 0
    for f in m.functions {
        let cap = capFirst(f.info.name)
        out = out + rpcHandlerFn(f, cap, vyrn"\{name(f.info.name)}")
        let lead = if i > 0 { "," } else { "" }
        entries = entries + rpcSchemaEntry(lead + "{\"name\":\"" + f.info.name + "\",\"request\":", f, m.iface)
        arms = arms + rpcRouterArm("/rpc/" + f.info.name, cap)
        i = i + 1
    }
    return out + rpcSchemaFn(entries) + rpcRouterFn("/rpc", arms)
}

/// Unifies a reply in `rpcUnify<cap>`: 200 decodes into `Done` (an undecodable
/// body is `Failed`); 204 on a `Unit` procedure is `Done(true)`; 422 is
/// `Rejected` with the server's issues; anything else is `Failed` (status 0 =
/// unreachable). `label` names the procedure in each failure.
gen fn rpcUnifyFn(f: FnCode, cap: String, label: String) -> Code {
    let malformed = "procedure `" + label + "` returned a malformed reply"
    let ok = match f.ret {
        Some(r) => vyrn"""
            if status == 200 {
                return match fromJson<\{r}>(body) {
                    Valid(v) => Done(v),
                    Invalid(iss) => Failed(\{malformed}),
                }
            }
            """,
        None => vyrn"""
            if status == 200 { return Done(true) }
            if status == 204 { return Done(true) }
            """,
    }
    let unparseable = "procedure `" + label + "` sent an unparseable 422 body"
    let unreachable = "procedure `" + label + "` is unreachable"
    let failed = "procedure `" + label + "` failed with status "
    return vyrn"""
        fn \{name("rpcUnify" + cap)}(status: Int64, body: String) -> RpcReply<\{f.ret ?? vyrn"Bool"}> {
            \{ok}
            if status == 422 {
                return match fromJson<RpcIssues>(body) {
                    Valid(bag) => Rejected(consume bag.issues),
                    Invalid(iss) => Failed(\{unparseable}),
                }
            }
            if status == 0 {
                return Failed(\{unreachable})
            }
            return Failed(\{failed} + status.toString())
        }

        """
}

/// A procedure's callback type; a `Unit` return is `RpcReply<Bool>`.
gen fn rpcCbType(f: FnCode) -> Code {
    let r = f.ret ?? vyrn"Bool"
    return vyrn"fn(RpcReply<\{r}>)"
}

/// One procedure's client under `label`: a pending-callback map keyed by call
/// id, the stub `label(req, cb)` that hands `label`, the wire `path` when it
/// has one, and the encoded request to the shared transport, a deliver helper,
/// and the `export extern fn` completion the host calls.
gen fn rpcClientFns(f: FnCode, cap: String, label: String, path: Option<String>) -> Code {
    let cb = rpcCbType(f)
    let pending = name("rpcPending" + cap)
    let deliver = name("rpcDeliver" + cap)
    let empty = ""
    let payload = if f.params.length == 1 { vyrn"toJson(req)" } else { vyrn"\{empty}" }
    let call = match path {
        Some(p) => vyrn"vyrnRpcCall(\{label}, \{p}, \{payload})",
        None => vyrn"vyrnRpcCall(\{label}, \{payload})",
    }
    let stub = if f.params.length == 1 {
        vyrn"""
            export fn \{name(label)}(req: \{f.params[0].ty}, cb: \{cb}) {
                let id = \{call}
                \{pending}[id.toString()] = cb.copy()
            }

            """
    } else {
        vyrn"""
            export fn \{name(label)}(cb: \{cb}) {
                let id = \{call}
                \{pending}[id.toString()] = cb.copy()
            }

            """
    }
    // Drops the pending callback, then calls it: a fetched callback must be bound
    // to a parameter before it is called. A reply with no pending callback is
    // ignored.
    return rpcUnifyFn(f, cap, label) + vyrn"""
        let mut \{pending}: Map<String, \{cb}> = [:]

        """ + stub + vyrn"""
        fn \{deliver}(key: String, cb: \{cb}, res: RpcReply<\{f.ret ?? vyrn"Bool"}>) {
            \{pending}.remove(key)
            cb(res)
        }
        export extern fn \{name("vyrnRpcDone" + cap)}(id: Int64, status: Int64, body: String) {
            let key = id.toString()
            match \{pending}[key] {
                Some(cb) => \{deliver}(key, cb.copy(), \{name("rpcUnify" + cap)}(status, body)),
                None => rpcIgnoreReply(),
            }
        }

        """
}

/// The client's shared prelude: the reply surface, the issues bag, the
/// transport extern `transport` declares, and the reply sink.
gen fn rpcClientPrelude(transport: Code) -> Code {
    return rpcReplyTypes() + vyrn"""
        type RpcIssues = { issues: Array<RpcIssue> }
        \{transport}
        fn rpcIgnoreReply() {
        }

        """
}

/// Emits the client: the contract's type declarations, one stub per procedure
/// over one `vyrnRpcCall` extern, and one completion per procedure. The caller
/// passes the callback inline: `createPaste(req, |res| match res { .. })`.
export gen fn rpcClient(contract: String) -> Code {
    let m = moduleCode(contract)
    return match validateContract(m.iface) {
        Some(err) => err,
        None => rpcClientModule(m),
    }
}

gen fn rpcClientModule(m: ModuleCode) -> Code {
    let mut out = vyrn"""
        /// Generated by std/rpc `rpcClient` — do not edit.

        """
    for t in m.types {
        out = out + t.decl + vyrn"\n"
    }
    out = out + rpcClientPrelude(vyrn"extern fn vyrnRpcCall(name: String, body: String) -> Int64")
    for f in m.functions {
        out = out + rpcClientFns(f, capFirst(f.info.name), f.info.name, None)
    }
    return out
}

/// One in-process stub under `exported`, calling `real` and `cb`
/// synchronously. Only `Done` is produced: `Rejected` and `Failed` come from
/// decoding an untrusted payload, which in-process never does.
gen fn rpcInProcStub(f: FnCode, exported: Name, real: Code) -> Code {
    let cb = rpcCbType(f)
    if f.params.length == 1 {
        let req = f.params[0].ty
        return match f.ret {
            Some(_) => vyrn"""
                export fn \{exported}(req: \{req}, cb: \{cb}) {
                    cb(Done(\{real}(req)))
                }

                """,
            None => vyrn"""
                export fn \{exported}(req: \{req}, cb: \{cb}) {
                    \{real}(req)
                    cb(Done(true))
                }

                """,
        }
    }
    return match f.ret {
        Some(_) => vyrn"""
            export fn \{exported}(cb: \{cb}) {
                cb(Done(\{real}()))
            }

            """,
        None => vyrn"""
            export fn \{exported}(cb: \{cb}) {
                \{real}()
                cb(Done(true))
            }

            """,
    }
}

/// Emits the deterministic test and SSR flavor: a stub per procedure under the
/// same name the wire client exposes, running the real procedure synchronously
/// through its `__real` import alias.
export gen fn rpcInProcess(contract: String) -> Code {
    let m = moduleCode(contract)
    return match validateContract(m.iface) {
        Some(err) => err,
        None => rpcInProcessModule(m, contract),
    }
}

gen fn rpcInProcessModule(m: ModuleCode, contract: String) -> Code {
    let head = vyrn"""
        /// Generated by std/rpc `rpcInProcess` — do not edit.

        """
    // Shared with the wire client, so the stubs stay interchangeable.
    let mut out = head + importBlock(m.iface, contract, procImports(m.iface, true)) + vyrn"\n" + rpcReplyTypes()
    for f in m.functions {
        let real = name(f.info.name + "__real")
        out = out + rpcInProcStub(f, name(f.info.name), vyrn"\{real}")
    }
    return out
}

// Directory forms. Every module under an api directory is a
// procedure module, and a procedure's wire path derives from the module path and
// the export name. `client(dir)` reads interfaces and never imports an api
// module, so no procedure body reaches a client bundle.
import { Json, JsonField } from "std/json"
import { parseJson } from "std/jsonread"
import { fieldAt, fieldsOf, tagOf } from "std/jsondec"
import { replace, split } from "std/strings"

/// One procedure module: the path a generator reflects
/// (`./server/api/orders/refund`) and the api-relative `{module}` (`orders/refund`).
type RpcModule = { modPath: String, rel: String }

/// The path rule for one api directory. The pins are parallel arrays, which keep
/// declaration order for `vyrn routes`.
type RpcConfig = { prefix: String, path: String, pinKeys: Array<String>, pinPaths: Array<String> }

type RpcRoute = { path: String, key: String }

fn rpcStem(name: String) -> String {
    let b = bytes(name)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length - 5 {
        out.push(b[i])
        i = i + 1
    }
    return fromBytesOr(out, name)
}

/// Every procedure module under `dir`, with the api-relative prefix so far.
/// `module.vyrn` is the directory's own slot, and a dotted stem such as
/// `pastes.http.vyrn` is a protocol projection over its neighbours;
/// neither is mounted.
gen fn rpcScan(dir: String, prefix: String) -> Array<RpcModule> {
    // `listDirKinds` marks a subdirectory with a trailing `/`.
    let entries = match listDirKinds(dir) {
        Ok(ns) => ns,
        Err(err) => [],
    }
    let mut out: Array<RpcModule> = []
    for name in entries {
        if name.endsWith("/") {
            let bare = slice(name, 0, name.byteLength - 1) ?? panic("rpcScan: the cut is at the listing's own ASCII `/`")
            let deeper = if prefix == "" { bare.copy() } else { prefix + "/" + bare }
            for m in rpcScan(dir + "/" + bare, deeper) {
                out.push(m)
            }
        } else if name.endsWith(".vyrn") {
            let st = rpcStem(name)
            if st != "module" && st.contains(".") == false {
                let rel = if prefix == "" { st.copy() } else { prefix + "/" + st }
                out.push(RpcModule { modPath: dir + "/" + st, rel: rel })
            }
        }
    }
    return out
}

/// `path` parsed as JSON, or `JNull` when it is absent or malformed; a missing config is normal.
gen fn rpcReadJson(path: String) -> Json {
    let text = match readFile(path) {
        Ok(t) => t,
        Err(e) => "",
    }
    if text == "" {
        return JNull
    }
    return match parseJson(text) {
        Ok(j) => j,
        Err(e) => JNull,
    }
}

fn rpcApplyConfig(cfg: RpcConfig, doc: Json) -> RpcConfig {
    let p = tagOf(fieldAt(fieldsOf(doc), "prefix"))
    let t = tagOf(fieldAt(fieldsOf(doc), "path"))
    let mut keys = cfg.pinKeys.copy()
    let mut paths = cfg.pinPaths.copy()
    for f in fieldsOf(fieldAt(fieldsOf(doc), "pin")) {
        let v = tagOf(f.value)
        if v != "" {
            keys.push(consume f.key)
            paths.push(v)
        }
    }
    return RpcConfig {
        prefix: if p == "" { cfg.prefix.copy() } else { p },
        path: if t == "" { cfg.path.copy() } else { t },
        pinKeys: keys.copy(),
        pinPaths: paths.copy(),
    }
}

/// The path rule for `dir`: `/_` and `{module}/{name}`, overridden by an
/// `rpc.json` in `dir`, which may also pin procedures by `{module}/{name}`. Both
/// the flat form and a `{"rpc": {...}}` wrapper are read. It is not `vyrn.json`:
/// a generator may read only the paths it was given.
gen fn rpcConfig(dir: String) -> RpcConfig {
    let cfg = RpcConfig { prefix: "/_", path: "{module}/{name}", pinKeys: [], pinPaths: [] }
    let doc = rpcReadJson(dir + "/rpc.json")
    let nested = fieldAt(fieldsOf(doc), "rpc")
    let applied = rpcApplyConfig(cfg, doc)
    return rpcApplyConfig(applied, nested)
}

fn rpcTemplatePath(cfg: RpcConfig, rel: String, name: String) -> String {
    return cfg.prefix + "/" + replace(replace(cfg.path, "{module}", rel), "{name}", name)
}

/// The wire path of one procedure: its last matching pin, else the template.
fn rpcPathFor(cfg: RpcConfig, rel: String, name: String) -> String {
    let key = rel + "/" + name
    let mut pinned = ""
    let mut i = 0
    while i < cfg.pinKeys.length {
        if cfg.pinKeys[i] == key {
            pinned = cfg.pinPaths[i].copy()
        }
        i = i + 1
    }
    if pinned != "" {
        return pinned
    }
    return rpcTemplatePath(cfg, rel, name)
}

gen fn rpcRoutesOf(mods: Array<RpcModule>, cfg: RpcConfig) -> Array<RpcRoute> {
    let mut out: Array<RpcRoute> = []
    for m in mods {
        let iface = moduleInterface(m.modPath)
        for f in iface.functions {
            out.push(RpcRoute { path: rpcPathFor(cfg, m.rel, f.name), key: m.rel + "/" + f.name })
        }
    }
    return out
}

/// The first two routes deriving one path, reported naming both, or `None`.
/// Pins and a `{name}`-only template can collide, and only the author can
/// settle it.
gen fn rpcCollision(routes: Array<RpcRoute>) -> Option<Code> {
    let mut i = 0
    while i < routes.length {
        let mut j = i + 1
        while j < routes.length {
            if routes[i].path == routes[j].path {
                return Some(reportHere(
                    Error,
                    "procedures `\{routes[i].key}` and `\{routes[j].key}` both answer `\{routes[i].path}` — two procedures may not derive one path, so repin one of them",
                ))
            }
            j = j + 1
        }
        i = i + 1
    }
    return None
}

/// The first objection in the directory: each module against `Api` and
/// serializability, then type and flat-name collisions; `None` when clean.
gen fn rpcValidateAll(mods: Array<RpcModule>) -> Option<Code> {
    for m in mods {
        let err = validateContract(moduleInterface(m.modPath))
        match err {
            Some(_) => {
                return err
            },
            None => {},
        }
    }
    let typeClash = rpcTypeCollision(mods)
    return match typeClash {
        Some(_) => typeClash,
        None => rpcQualifiedCollision(mods),
    }
}

/// One type name the directory defines, its canonical declaration, and the declaring file.
type RpcDef = { name: String, source: String, from: String }

/// The declaration registered under `name`, or one with an empty `name`.
gen fn rpcDefinedAs(defs: Array<RpcDef>, name: String) -> RpcDef {
    for d in defs {
        if d.name == name {
            return RpcDef { name: d.name.copy(), source: d.source.copy(), from: d.from.copy() }
        }
    }
    return RpcDef { name: "", source: "", from: "" }
}

/// Refuses two different declarations of one type name across the directory.
/// Every flavor builds one flat module, so `client` would silently keep the first
/// and `rpc` would emit two imports of one name. `TypeInfo.source` is the
/// canonical rendering, so identical declarations (a shared module's type seen
/// from two api modules) are not a collision.
gen fn rpcTypeCollision(mods: Array<RpcModule>) -> Option<Code> {
    let mut defs: Array<RpcDef> = []
    for m in mods {
        let iface = moduleInterface(m.modPath)
        for t in iface.types {
            let prior = rpcDefinedAs(defs, t.name)
            if prior.name == "" {
                defs.push(RpcDef { name: t.name.copy(), source: t.source.copy(), from: t.origin.file.copy() })
            } else if prior.source != t.source {
                return Some(report(
                    Error,
                    t.origin.file,
                    t.origin.line,
                    t.origin.col,
                    "`\{t.name}` is declared here as `\{t.source}`, and in `\{prior.from}` as `\{prior.source}` — one api directory derives one module, so one name may carry only one shape; rename one of them, or declare it once in a module both import",
                ))
            }
        }
    }
    return None
}

/// The flat name of a directory-derived procedure: module path and export name,
/// camel-joined (`orders/refund` + `run` -> `ordersRefundRun`). `import * as`
/// binds one level only, so `api.orders.refund.run` is not available.
fn rpcQualified(rel: String, name: String) -> String {
    let mut out = ""
    for seg in split(rel, "/") {
        if out == "" {
            out = seg
        } else {
            out = out + capFirst(seg)
        }
    }
    return out + capFirst(name)
}

/// The first two procedures whose flat names collide, reported naming both, or `None`.
/// Camel joining is not injective (`a/b` + `c` and `a` + `bC` both give `aBC`),
/// and a duplicate would break the generated module far from either cause.
gen fn rpcQualifiedCollision(mods: Array<RpcModule>) -> Option<Code> {
    let mut quals: Array<String> = []
    let mut keys: Array<String> = []
    for m in mods {
        let iface = moduleInterface(m.modPath)
        for f in iface.functions {
            quals.push(rpcQualified(m.rel, f.name))
            keys.push(m.rel + "/" + f.name)
        }
    }
    return rpcQualClash(quals, keys)
}

/// Reports the first two equal flat names, or `None`.
gen fn rpcQualClash(quals: Array<String>, keys: Array<String>) -> Option<Code> {
    let msg = rpcQualClashMessage(quals, keys)
    if msg == "" {
        return None
    }
    return Some(reportHere(Error, msg))
}

/// The pairwise scan, apart so the wording is testable without an interface:
/// the message naming the first two equal flat names, or "".
fn rpcQualClashMessage(quals: Array<String>, keys: Array<String>) -> String {
    let mut i = 0
    while i < quals.length {
        let mut j = i + 1
        while j < quals.length {
            if quals[i] == quals[j] {
                return "procedures `\{keys[i]}` and `\{keys[j]}` both derive the flat name `\{quals[i]}` — camel-joining a module path and an export name is not unique, so rename one of them"
            }
            j = j + 1
        }
        i = i + 1
    }
    return ""
}

/// A procedure's derived wire facts for its symbol map entry: the row `vyrn
/// routes` prints, with `key` its `{module}/{name}`.
fn rpcDerived(path: String, key: String, pinned: Bool) -> Array<JsonField> {
    return [
        strField("kind", "rpc"),
        strField("method", "POST"),
        strField("path", path),
        strField("key", key),
        strField("source", if pinned { "override" } else { "convention" }),
    ]
}

/// A procedure's symbol map entry under the generator's name for it (`client`
/// exports `pastesList`, `rpc` dispatches to `rpcHandlePastesList`).
fn rpcProcSymbol(name: String, f: FnInfo, cfg: RpcConfig, rel: String) -> Symbol {
    let path = rpcPathFor(cfg, rel, f.name)
    let pinned = path != rpcTemplatePath(cfg, rel, f.name)
    return symbol(name, f.origin, rpcDerived(path, rel + "/" + f.name, pinned))
}

/// The namespace a procedure module is reached through: `rpcM0`, `rpcM1`. Only
/// `import * as` keeps exports out of the flat namespace, and two api modules
/// both exporting `get` is the normal shape.
fn rpcNs(i: Int64) -> String {
    return "rpcM" + i.toString()
}

/// The server's imports: one namespace per procedure module, and each reachable
/// type once, from the module that declares it.
gen fn rpcDirImports(mods: Array<RpcModule>) -> Code {
    let mut out = vyrn""
    let mut typeMods: Array<String> = []
    let mut typeNames: Array<String> = []
    let mut mi = 0
    for m in mods {
        let iface = moduleInterface(m.modPath)
        if iface.functions.length > 0 {
            out = out + vyrn"""
                import * as \{name(rpcNs(mi))} from \{m.modPath}

                """
        }
        mi = mi + 1
        for t in iface.types {
            if rpcHasPair(typeMods, typeNames, t.module, t.name) == false {
                typeMods.push(t.module.copy())
                typeNames.push(t.name.copy())
            }
        }
    }
    let mut specs: Array<String> = []
    for s in typeMods {
        if includes(specs, s) == false {
            specs.push(s.copy())
        }
    }
    for spec in specs {
        let mut names: Array<Code> = []
        let mut i = 0
        while i < typeMods.length {
            if typeMods[i] == spec {
                names.push(vyrn"\{name(typeNames[i])}")
            }
            i = i + 1
        }
        if names.length > 0 {
            out = out + vyrn"""
                import { \{join(names, vyrn", ")} } from \{spec}

                """
        }
    }
    return out
}

fn rpcHasPair(mods: Array<String>, names: Array<String>, spec: String, name: String) -> Bool {
    let mut i = 0
    while i < mods.length {
        if mods[i] == spec && names[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

/// A directory form after its checks: each module against `Api`, then the
/// config's routes against each other. `client` picks the calling side.
gen fn rpcDirForm(dir: String, client: Bool) -> Code {
    let mods = rpcScan(dir, "")
    return match rpcValidateAll(mods) {
        Some(err) => err,
        None => rpcDirRouted(dir, mods, client),
    }
}

gen fn rpcDirRouted(dir: String, mods: Array<RpcModule>, client: Bool) -> Code {
    let cfg = rpcConfig(dir)
    return match rpcCollision(rpcRoutesOf(mods, cfg)) {
        Some(clash) => clash,
        None => if client { rpcDirClient(dir, mods, cfg) } else { rpcDirServer(dir, mods, cfg) },
    }
}

/// Mounts every procedure module under `dir` at its derived path. Two procedures
/// deriving one path fail the build naming both.
export gen fn rpc(dir: String) -> Code {
    return rpcDirForm(dir, false)
}

gen fn rpcDirServer(dir: String, mods: Array<RpcModule>, cfg: RpcConfig) -> Code {
    let mut out = vyrn"""
        /// Generated by std/rpc `rpc` — do not edit.
        import { startsWith } from "std/strpred"

        """
    out = out + rpcDirImports(mods) + vyrn"""
        type RpcIssues = { issues: Array<Issue> }

        """
    let mut syms: Array<Symbol> = []
    let mut entries = vyrn""
    let mut arms = vyrn""
    let mut i = 0
    let mut mi = 0
    for m in mods {
        let mc = moduleCode(m.modPath)
        let ns = name(rpcNs(mi))
        for f in mc.functions {
            let qual = rpcQualified(m.rel, f.info.name)
            let cap = capFirst(qual)
            let path = rpcPathFor(cfg, m.rel, f.info.name)
            out = out + rpcHandlerFn(f, cap, vyrn"\{ns}.\{name(f.info.name)}")
            syms.push(rpcProcSymbol("rpcHandle" + cap, f.info, cfg, m.rel))
            let lead = if i > 0 { "," } else { "" }
            entries = entries + rpcSchemaEntry(lead + "{\"path\":\"" + path + "\",\"name\":\"" + m.rel + "/" + f.info.name + "\",\"request\":", f, mc.iface)
            arms = arms + rpcRouterArm(path, cap)
            i = i + 1
        }
        mi = mi + 1
    }
    // The registry is once per process, as the contract form's; only one of the
    // two reaches a generated module, so the name is shared.
    return out + rpcSchemaFn(entries) + rpcRouterFn(cfg.prefix, arms) + symbolMapFn("rpc(" + dir + ")", syms)
}

/// The calling side of an api directory. It reads interfaces, re-emits types and
/// never imports an api module, so no procedure body reaches a client bundle.
export gen fn client(dir: String) -> Code {
    return rpcDirForm(dir, true)
}

/// Every distinct type declaration in the directory is re-emitted once, with
/// its symbol. Re-emitted, not imported, so no api module enters the client
/// build; the symbol map keeps where each came from. The dedupe is by name,
/// which is safe only because `rpcValidateAll` has refused two shapes under one
/// name.
gen fn rpcDirClient(dir: String, mods: Array<RpcModule>, cfg: RpcConfig) -> Code {
    let mut out = vyrn"""
        /// Generated by std/rpc `client` — do not edit.

        """
    let mut seen: Array<String> = []
    let mut syms: Array<Symbol> = []
    for m in mods {
        let mc = moduleCode(m.modPath)
        for t in mc.types {
            if includes(seen, t.info.name) == false {
                seen.push(t.info.name.copy())
                out = out + t.decl + vyrn"\n"
                syms.push(symbol(t.info.name, t.info.origin, []))
            }
        }
    }
    out = out + rpcClientPrelude(vyrn"extern fn vyrnRpcCall(proc: String, path: String, body: String) -> Int64")
    for m in mods {
        let mc = moduleCode(m.modPath)
        for f in mc.functions {
            let qual = rpcQualified(m.rel, f.info.name)
            out = out + rpcClientFns(f, capFirst(qual), qual, Some(rpcPathFor(cfg, m.rel, f.info.name)))
            syms.push(rpcProcSymbol(qual, f.info, cfg, m.rel))
        }
    }
    return out + symbolMapFn("client(" + dir + ")", syms)
}

/// `client(dir)` with direct dispatch. A separate generator, because a generator
/// cannot see its importer's audience; the stubs share names, so a composition
/// root swaps one import line.
export gen fn clientInProcess(dir: String) -> Code {
    let mods = rpcScan(dir, "")
    return match rpcValidateAll(mods) {
        Some(err) => err,
        None => rpcDirInProcess(mods),
    }
}

gen fn rpcDirInProcess(mods: Array<RpcModule>) -> Code {
    let mut out = vyrn"""
        /// Generated by std/rpc `clientInProcess` — do not edit.

        """
    out = out + rpcDirImports(mods) + rpcReplyTypes()
    let mut mi = 0
    for m in mods {
        let mc = moduleCode(m.modPath)
        let ns = name(rpcNs(mi))
        for f in mc.functions {
            out = out + rpcInProcStub(f, name(rpcQualified(m.rel, f.info.name)), vyrn"\{ns}.\{name(f.info.name)}")
        }
        mi = mi + 1
    }
    return out
}

test "rpcQualified camel-joins the relative path and the export name" {
    assertEq(rpcQualified("orders/refund", "run"), "ordersRefundRun")
    assertEq(rpcQualified("pastes", "list"), "pastesList")
}

test "distinct module/export pairs can derive one qualified name" {
    // Both camel-join to `aBC`; rpcValidateAll reports it.
    assertEq(rpcQualified("a/b", "c"), "aBC")
    assertEq(rpcQualified("a", "bC"), "aBC")
}

test "rpcQualClashMessage names both sources of one derived name" {
    let msg = rpcQualClashMessage(["aBC", "aBC"], ["a/b/c", "a/bC"])
    assert(msg.contains("`a/b/c` and `a/bC`"))
    assert(msg.contains("both derive the flat name `aBC`"))
    assertEq(rpcQualClashMessage(["aB", "aC"], ["a/b", "a/c"]), "")
}
