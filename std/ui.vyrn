/// std/ui — the pages generator (RFC-0026 M3), file-based routing as a library
/// on RFC-0021 generator imports. One `gen fn`, `pages(dir)`, scans a directory
/// of ORDINARY `.vyrn` page modules at compile time (sandboxed, deterministic,
/// cached) and synthesizes a router module. The compiler knows nothing about
/// routing — everything below is plain, comptime-pure Vyrn over `listDir`,
/// `moduleInterface` (RFC-0021), `std/html` (RFC-0026 M1), the `Request`/
/// `Response` server surface (RFC-0016), `fromJson` (RFC-0018), and the
/// regex-validated string types (RFC-0020).
///
///   import { pages } from "std/ui"
///   import { route } from pages("./pages")
///   fn handle(req: Request) -> Response { return route(req) }
///
/// Directory conventions (v1):
///   pages/index.vyrn        → GET /
///   pages/items/index.vyrn  → GET /items
///   pages/items/[id].vyrn   → GET /items/:id     (single-segment dynamic param)
///
/// A page module EXPORTS:
///   - `fn page(p: Params) -> Html`  — or `fn page() -> Html` for a page with no
///     dynamic segments and no loader.
///   - `type Params = { id: Int64, … }` when it has `[bracket]` segments — the
///     field NAMES must match the segments exactly (checked via `moduleInterface`
///     at generation time). v1 supports `Int64` params only.
///   - optionally `fn data() -> ParamQuery<Params, Validation<Data>>` (the `data`
///     member of the `Page` contract below, RFC-0071) and then
///     `fn page(p: Params, d: Data) -> Html`. On `Invalid` the synthesized router
///     renders an error page (422) built with `std/html`, listing the issues.
///
/// The synthesized module EXPORTS `route(req: Request) -> Response`: it matches
/// the path, parses+validates each dynamic segment against its declared type (an
/// `Int64` segment that is not an integer 404s, never reaching user code), runs
/// `load`, renders the page through `document(…)`, and returns the `Response`. An
/// unknown path is a 404 page. It also emits `type RoutePath` — a regex-validated
/// string of the whole route language — plus a `href<Route>(…)` helper per dynamic
/// route and a `<route>Path()` helper per static route (typed URLs).
///
/// Generation failures — a Params/segment mismatch, an unsupported param type, or
/// a route collision — fail the load with a `std/diag` report (RFC-0099) in this
/// generator's own wording, anchored at the page module that broke the rule.
///
/// Inspect the synthesized module with:  vyrn emit-gen <file>

// `.vyx` pages (RFC-0039 §4) reuse std/vyx's exposed pure compiler core: `pages`
// learns a `.vyx` page's routing shape from `vyxPageShape`, and the synthesized
// router imports each `.vyx` page through a nested `vyxPage(…)` generator import.
// (std↔std pure-fn imports are legal — verified; the loader does not fight them.)
import { vyxPageShape, vyxPageInterface, vyxQueryDataType, vyxDataRunner, vyxDataFormHasParams, vyxDataFormIsLazy } from "std/vyx"
// Shared string / array helpers (RFC-0046/0059) — the former private uiJoinList,
// uiContainsStr, uiTrimStr copies now live once in std; the infallible-decode
// swallows route through the shared `fromBytesOr`.
import { joinWith, trim, fromBytesOr, indexOf, toLower } from "std/strings"
import { includes } from "std/arrays"
// The `Head` value a page's `head()` returns renders through `std/html` here
// (RFC-0071 M2) rather than as generated source, because its includes are now
// runtime arrays rather than literal block entries.
import { el, empty, Html, Attr } from "std/html"
// RFC-0071: a page's exports are checked against the `Page` contract declared
// below, instead of hunted for by name.
import { checkContract, matchedMember } from "std/contract"
import { endsWith, startsWith } from "std/strpred"
// RFC-0099: every objection this generator raises is a diagnostic in its own
// wording, at a severity it chooses — a page whose surface does not fit its
// route, two routes landing on one helper name — instead of a module that fails
// to parse or exports one name twice.
import { report, reportHere, Severity } from "std/diag"

// ===========================================================================
// PageError (RFC-0041 §3) — the failure a page's `data` may carry. `data ->
// Query<Result<Data, PageError>>`: an `Err` renders the nearest `error.vyx` at
// the carried status (a `Validation<Data>` query's `Invalid` folds into a 422
// PageError instead). A page imports this to build its `Err(…)`.
// ===========================================================================

/// A page-load failure: an HTTP status and a human message. The router renders
/// the nearest `error.vyx` (or a built-in error body) at `status`.
export type PageError = { status: Int64, message: String }

/// A `PageError` with an explicit status.
export fn pageError(status: Int64, message: String) -> PageError {
    return PageError { status: status, message: message.copy() }
}

/// A 404 `PageError`.
export fn notFound(message: String) -> PageError {
    return PageError { status: 404, message: message.copy() }
}

/// A 400 `PageError`.
export fn badRequest(message: String) -> PageError {
    return PageError { status: 400, message: message.copy() }
}

// ===========================================================================
// PageData (RFC-0070) — the lazy-mode wrapper a `Lazy`/`ParamLazy` page's VIEW
// receives. Defined ONCE here (the constructors `Loading`/`Ready` register in
// the global constructor table exactly once — never redefined per page module,
// which would collide) and imported by every generated lazy page module, server
// and client alike. On a client soft nav a lazy page renders `Loading` instantly
// (the shell + a skeleton), then re-renders `Ready(data)` once the payload
// arrives. SSR always has data, so the server only ever renders `Ready` — the
// `Loading` arm is a client-navigation-only state.
// ===========================================================================

/// The data a lazy page's view is rendered over: `Loading` before the data has
/// arrived (client nav only), `Ready(T)` once it has (always, server-side).
export type PageData<T> = | Loading | Ready(T)

// ===========================================================================
// The `Page` contract (RFC-0071 M2) — the two exports a page module may have,
// declared instead of scanned. `head { … }` was parsed out of a `.vyx`
// `<script>` by reading source text, and `load` was found by matching the name
// literally, so `fn laod()` compiled clean and rendered a page with no data.
// Both are now members of a declaration: completed, hovered, type-checked, and
// loud on a typo.
//
// Members are FUNCTIONS because RFC-0029 makes every top-level `let`
// module-private — a page satisfies the contract with the accessor pattern that
// rule already prescribes. `data` wants to be a function regardless: a
// module-level binding runs at module-init, and page data is per-request.
// ===========================================================================

/// One `<meta name=… content=…>` a page contributes to the document head.
export type Meta = { name: String, content: String }

/// What a page contributes to the document head.
///
/// Exactly what the `head { … }` block could express — a title, stylesheet
/// links, module and classic script includes — plus `meta`, which the block
/// could not. Build one from `noHead()` and the `with*` combinators:
///
///     export fn head() -> Head {
///         return withModule(noHead(), "/app.js")
///     }
///
/// Elements are emitted stylesheets-then-modules-then-scripts-then-meta, each
/// group in the order it was added.
export type Head = {
    title: Option<String>,
    stylesheets: Array<String>,
    modules: Array<String>,
    scripts: Array<String>,
    meta: Array<Meta>,
}

/// The empty head — no title, no includes. The default for a page that declares
/// no `head`, and the base every `with*` combinator builds on.
export fn noHead() -> Head {
    return Head { title: None, stylesheets: [], modules: [], scripts: [], meta: [] }
}

/// `h` with the document title set. The page's title wins over its layouts'.
export fn withTitle(h: Head, title: String) -> Head {
    return Head { title: Some(title), stylesheets: h.stylesheets.copy(), modules: h.modules.copy(), scripts: h.scripts.copy(), meta: h.meta.copy() }
}

/// `h` with a `<link rel="stylesheet" href=…>` appended.
export fn withStylesheet(h: Head, href: String) -> Head {
    let mut ss = h.stylesheets
    ss.push(href.copy())
    return Head { title: h.title.copy(), stylesheets: ss.copy(), modules: h.modules.copy(), scripts: h.scripts.copy(), meta: h.meta.copy() }
}

/// `h` with a `<script type="module" src=…>` appended.
export fn withModule(h: Head, src: String) -> Head {
    let mut ms = h.modules
    ms.push(src.copy())
    return Head { title: h.title.copy(), stylesheets: h.stylesheets.copy(), modules: ms.copy(), scripts: h.scripts.copy(), meta: h.meta.copy() }
}

/// `h` with a classic `<script src=…>` appended.
export fn withScript(h: Head, src: String) -> Head {
    let mut sc = h.scripts
    sc.push(src.copy())
    return Head { title: h.title.copy(), stylesheets: h.stylesheets.copy(), modules: h.modules.copy(), scripts: sc.copy(), meta: h.meta.copy() }
}

/// `h` with a `<meta name=… content=…>` appended.
export fn withMeta(h: Head, name: String, content: String) -> Head {
    let mut mt = h.meta
    mt.push(Meta { name: name.copy(), content: content.copy() })
    return Head { title: h.title.copy(), stylesheets: h.stylesheets.copy(), modules: h.modules.copy(), scripts: h.scripts.copy(), meta: mt.copy() }
}

/// A head's elements, in the document order `document(title, head, body)` emits.
/// Byte-identical to what the `head { … }` block compiled to, element for
/// element — which is what keeps a migrated page's SSR bytes unchanged.
export fn headHtml(h: Head) -> Array<Html> {
    let mut out: Array<Html> = []
    for href in h.stylesheets {
        out.push(el("link", [A("rel", "stylesheet"), A("href", href)], []))
    }
    for src in h.modules {
        out.push(el("script", [A("type", "module"), A("src", src)], []))
    }
    for src in h.scripts {
        out.push(el("script", [A("src", src)], []))
    }
    for m in h.meta {
        out.push(el("meta", [A("name", m.name), A("content", m.content)], []))
    }
    return out
}

/// A head's document title, or "" when it declares none — the spelling
/// `uiFirst` composes through the layout chain.
export fn headTitleOf(h: Head) -> String {
    return match h.title {
        Some(t) => t.copy(),
        None => "",
    }
}

/// A page's data: the call that produces it, deferred until the router asks.
///
///     export fn data() -> Query<Array<Paste>> {
///         return query(|| listPastes().pastes)
///     }
///
/// The page BLOCKS on this — the document is not sent until the data lands. For
/// render-then-fill, return a [`Lazy`] instead.
export type Query<T> = { run: fn() -> T }

/// A page's data when the page renders LAZILY (RFC-0070): the shell paints
/// instantly on a client soft nav and the data region fills in when the payload
/// lands.
///
///     export fn data() -> Lazy<Array<Paste>> {
///         return lazy(query(|| listPastes().pastes))
///     }
///
/// This is a DISTINCT TYPE rather than a flag on `Query`, and that is the whole
/// point (RFC-0071 M2b). Laziness decides the *view's* type (`PageData<T>` versus
/// `T`), so the generator has to know it at generation time; a runtime `lazy`
/// field meant reading the `lazy(…)` call out of `data`'s body — a source scan,
/// which is the practice this RFC exists to end. As a type it is reflection.
export type Lazy<T> = { run: fn() -> T }

/// A page's data when it depends on the route parameters: the deferred call
/// receives the page's own `Params`.
///
///     export fn data() -> ParamQuery<Params, Result<Paste, PageError>> {
///         return paramQuery(|p: Params| fetch(p.id))
///     }
///
/// `Params` is declared per page, in the page's own module, which is exactly why
/// `std/ui` cannot name it — so it is an open member type parameter, resolved at
/// the use site (RFC-0071 M2b).
export type ParamQuery<P, T> = { run: fn(P) -> T }

/// [`ParamQuery`] rendered lazily — the params-taking counterpart of [`Lazy`].
export type ParamLazy<P, T> = { run: fn(P) -> T }

/// A query over `run`, resolved before the page renders.
export fn query<T>(run: consume fn() -> T) -> Query<T> {
    return Query { run: run }
}

/// `q` marked lazy: the page renders its shell and a skeleton first, then fills
/// the data region in. The server always has the data, so SSR is unaffected.
export fn lazy<T>(q: consume Query<T>) -> Lazy<T> {
    return Lazy { run: consume q.run }
}

/// A query whose deferred call receives the page's route parameters.
export fn paramQuery<P, T>(run: consume fn(P) -> T) -> ParamQuery<P, T> {
    return ParamQuery { run: run }
}

/// `q` marked lazy — the params-taking counterpart of [`lazy`].
export fn paramLazy<P, T>(q: consume ParamQuery<P, T>) -> ParamLazy<P, T> {
    return ParamLazy { run: consume q.run }
}

/// Run a query, producing the page's data.
export fn runQuery<T>(q: Query<T>) -> T {
    let f = q.run
    return f()
}

/// Run a lazy query. Identical to [`runQuery`] — laziness is about how the
/// document is delivered, never about whether the data is fetched.
export fn runLazy<T>(q: Lazy<T>) -> T {
    let f = q.run
    return f()
}

/// Run a params-taking query over this request's parameters.
export fn runParamQuery<P, T>(q: ParamQuery<P, T>, p: P) -> T {
    let f = q.run
    return f(p)
}

/// Run a lazy params-taking query.
export fn runParamLazy<P, T>(q: ParamLazy<P, T>, p: P) -> T {
    let f = q.run
    return f(p)
}

/// The absent query — the default for a page that declares no `data`, and the
/// value a generator substitutes when it finds none. A page with no data has
/// nothing to produce, which is what `Query<Unit>` says.
export fn noQuery() -> Query<Unit> {
    return query(uiNoData)
}

/// The `noQuery()` call: a page with no `data` produces nothing.
fn uiNoData() -> Unit {
}

/// What a page module may export (RFC-0071).
///
/// CLOSED — `head` and `data` are the only names, so any other export is
/// reported and a near-miss gets a did-you-mean. That is what makes typo
/// detection total: `fn laod()` is an error naming `data`, where it used to be a
/// page that silently rendered with no data.
///
/// A page needs local helpers; they are simply not exported, and the closed rule
/// applies to the module's public surface only. Two independent fetches need one
/// `data` returning a record, not two exports — one closure, one round trip.
///
/// Both members are declared at SEVERAL SHAPES (RFC-0071 M2b). Page shapes
/// genuinely vary, and one signature per member left a real page — the one whose
/// `<title>` is its loaded data's title — unable to write `head` at all.
export contract Page {
    /// Document head contributions for this page.
    ///
    /// The house rule is that **head takes what the view takes**: nothing, the
    /// loaded data, the route params, or both. `head { title: pasteTitle(data) }`
    /// is a real capability of the block form this replaces, so the member has to
    /// be declarable at the shape that expresses it.
    fn head() -> Head = noHead()
    fn head(d: T) -> Head
    fn head(p: P) -> Head
    fn head(p: P, d: T) -> Head

    /// This page's data, resolved before render.
    ///
    /// The return TYPE decides both questions the router needs answered:
    /// `Query`/`Lazy` says whether the page blocks or renders-then-fills, and the
    /// `Param*` pair says whether the deferred call sees the route parameters.
    /// Neither is read out of the body.
    fn data() -> Query<T> = noQuery()
    fn data() -> Lazy<T>
    fn data() -> ParamQuery<P, T>
    fn data() -> ParamLazy<P, T>

    /// This page's view, rendered into the document.
    ///
    /// Takes what the page has: nothing, the loaded data, the route params, or
    /// both — the same house rule `head` follows, because it is the same
    /// question asked of the same page.
    fn page() -> Html = uiNoView()
    fn page(d: T) -> Html
    fn page(p: P) -> Html
    fn page(p: P, d: T) -> Html

    /// This page's raw response, for the routes that are not documents.
    ///
    /// The alternative to `page`, not an addition to it: a page exports one or
    /// the other, and `respond` gets full control of status and content type
    /// (RFC-0039 §5). Which of the two a page must have is the ROUTER's rule and
    /// stays in `uiInspectPage`; what a page MAY export is this contract's, and
    /// that is why both are optional here.
    fn respond() -> Response = uiNoRespond()
    fn respond(d: T) -> Response
    fn respond(p: P) -> Response
    fn respond(p: P, d: T) -> Response
}

/// The absent view — the default that makes `page` an optional member. A page
/// exports `page` or `respond`, never both and never neither, so neither default
/// is ever substituted; they exist so that a page writing one is not reported
/// for omitting the other.
export fn uiNoView() -> Html {
    return empty()
}

/// The absent raw response. See [`uiNoView`].
export fn uiNoRespond() -> Response {
    return Response { status: 404, contentType: "text/plain", body: "", vary: "", headers: [:] }
}

/// The `data` member's alternative-signature indices, as `matchedMember` reports
/// them — named once here so the generator never spells a bare 2 (RFC-0071 M2b).
/// Declaration order in `contract Page` is the contract; these four functions are
/// the only thing that has to move if it changes.
export fn uiDataQuery() -> Int64 {
    return 0
}

/// `fn data() -> Lazy<T>` — no params, render-then-fill.
export fn uiDataLazy() -> Int64 {
    return 1
}

/// `fn data() -> ParamQuery<P, T>` — params, blocking.
export fn uiDataParamQuery() -> Int64 {
    return 2
}

/// `fn data() -> ParamLazy<P, T>` — params, render-then-fill.
export fn uiDataParamLazy() -> Int64 {
    return 3
}

// ===========================================================================
// The data-payload runtime (RFC-0069 §2, RFC-0072 M4) — RUNTIME helpers (not
// `gen`) the synthesized router imports to answer a soft-nav DATA request with
// `{page, title, props[, params]}` JSON. Kept here as ordinary Vyrn (so the JSON
// string building uses normal `"\""` literals, not a code quote) and shared by
// every generated router rather than re-emitted per module.
//
// A page has TWO representations at ONE URL, told apart by `Accept`. That is
// content negotiation — the technique's own name, understood by every HTTP client
// in every language, and naming no language or framework on the wire. It replaces
// RFC-0069's `?__vyrn=data` query marker, which existed only because `Request`
// carried no headers; it does now.
// ===========================================================================

/// Whether `accept` names the media type `ty`. A substring test over the
/// already-lowercased field value: only the PRESENCE of the type matters here,
/// never where it appeared.
fn uiAcceptNames(accept: String, ty: String) -> Bool {
    return match indexOf(accept, ty) {
        Some(at) => true,
        None => false,
    }
}

/// Whether `req` asked for a page's DATA representation rather than its document
/// (RFC-0072 M4).
///
/// The rule: JSON wins only when the client NAMED `application/json` and did not
/// also name `text/html`. The document is the DEFAULT representation, so a browser
/// navigation (`text/html,application/xhtml+xml,…,*/*;q=0.8`), a bare `*/*`, and a
/// missing `Accept` all get HTML — which is also what keeps an ordinary `GET`
/// byte-identical to what it answered before this milestone.
///
/// Full q-value ranking is deliberately not implemented. It would be a second
/// content-negotiation engine to keep honest against the first, and no client that
/// reaches this router separates these two types by weight alone: a document
/// navigation never names `application/json`, and `vyrn-nav` sends it alone.
export fn uiWantsData(req: Request) -> Bool {
    let accept = match req.headers["accept"] {
        Some(v) => toLower(v),
        None => "",
    }
    return uiAcceptNames(accept, "application/json") && uiAcceptNames(accept, "text/html") == false
}

/// Assemble a page data payload. `props`/`params` are already JSON (a `toJson`
/// result, or the literal `null`); `page`/`title` are JSON-encoded here.
export fn uiPayload(page: String, title: String, props: String, params: String) -> String {
    return "{\"page\":" + toJson(page) + ",\"title\":" + toJson(title) + ",\"props\":" + props + ",\"params\":" + params + "}"
}

/// The `@error` data payload — the page the client renders on a load miss. Carries
/// a `title` so vyrn-nav v3 sets `document.title` on a client-rendered error.
export fn uiErrorPayload(status: Int64, props: String) -> String {
    return "{\"page\":\"@error\",\"status\":" + status.toString() + ",\"title\":\"Error\",\"props\":" + props + "}"
}

/// Wrap a payload body in a `200 application/json` `Response`. A negotiated request
/// is a DATA fetch: it always answers 200 (the payload's `page`/`status` describe
/// what to render), while the DOCUMENT channel still returns a real 404 etc.
///
/// `vary: "Accept"` is what makes one URL with two representations safe to cache:
/// without it a shared cache would store whichever came first and hand a page's
/// JSON to a browser asking for its HTML.
export fn uiDataResponse(body: String) -> Response {
    return Response { status: 200, contentType: "application/json", body: body.copy(), vary: "Accept", headers: [:] }
}

/// The data response for a true miss (no route matched): the themed error page's
/// payload at 404.
export fn uiDataMiss() -> Response {
    return uiDataResponse(uiErrorPayload(404, "{\"status\":404,\"message\":\"Not Found\"}"))
}

/// The `@error` data response for a load failure. Takes the `PageError` as a TYPED
/// parameter so `toJson`/field access see its concrete type — a `PageError` bound
/// directly from a `Result` match arm (`Err(e)`) otherwise loses its type for
/// `toJson` (RFC-0069 §2), the same reason the loaded data goes through the page's
/// own `encodeProps`.
export fn uiErrorResponseOf(e: PageError) -> Response {
    return uiDataResponse(uiErrorPayload(e.status, toJson(e)))
}

// ===========================================================================
// Byte / string helpers — all comptime-pure (plain string building), so they are
// legal in a `gen fn` and its transitive callees.
// ===========================================================================

/// The bytes `ba[s..e)` as a String ("" on the impossible non-UTF-8 slice of
/// validated input).
gen fn uiSliceStr(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut out: Array<UInt8> = []
    let mut i = s
    while i < e {
        out.push(ba[i])
        i = i + 1
    }
    return fromBytesOr(out, "")
}

/// Uppercase the first ASCII byte of `s`.
gen fn uiUpperFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// `arr` with `s` appended (value semantics — the input is unchanged). Kept as a
/// private helper: it is a COPY-append (siblings in `uiScanAll`'s recursion keep
/// the original prefix), and Vyrn has no byte-identical single-expression copy-
/// append idiom (`arr + [s]` is not array concatenation), so a bare in-place
/// `arr.push(s)` would wrongly mutate the shared prefix.
gen fn uiAppendStr(arr: Array<String>, s: String) -> Array<String> {
    let mut out = arr.copy()
    out.push(s.copy())
    return out
}

/// The interpolation-hole source fragment for `name` — the two chars `\` `{`,
/// then the name, then `}`. Built from a lone backslash literal so the lexer
/// never mistakes it for an escape inside THIS module.
gen fn uiHole(name: String) -> String {
    return "\\" + "{" + name + "}"
}

// ---- emitting Vyrn source: bake a raw string as a `"…"` literal (RFC-0054) ---

/// `raw` baked as a complete Vyrn string literal (surrounding quotes included),
/// through an RFC-0054 code quote: `\{raw}` sits in EXPRESSION position, so the
/// compiler's OWN string escaping produces the literal — data, never code. This is
/// the single Vyrn-emission escape choke point for this module; it replaces the
/// hand-rolled `uiEscSecond`/byte-loop, so a mis-escape (or injection of Vyrn code
/// through a page path, url pattern, or static route segment) is unrepresentable.
/// `gen fn` so the quote sits in a generation context (RFC-0054 risk 2).
gen fn uiStrLit(raw: String) -> String {
    return render(vyrn"\{raw}")
}

/// A regex-safe rendering of a literal static segment for a `value =~ "…"`
/// alternative: each regex metacharacter is backslash-escaped, and because the
/// result is emitted INTO a Vyrn string literal (re-lexed by the compiler) a
/// single output backslash must appear as two.
gen fn uiRegexEscapeLit(seg: String) -> String {
    let ba = bytes(seg)
    let mut out: Array<UInt8> = []
    for b in ba {
        if b == '.' || b == '\\' || b == '(' || b == ')' || b == '[' || b == ']'
        || b == '{' || b == '}' || b == '|' || b == '*' || b == '+' || b == '?'
        || b == '^' || b == '$' {
            out.push('\\')
            out.push('\\')
            out.push(b)
        } else {
            out.push(b)
        }
    }
    return fromBytesOr(out, seg)
}

// ===========================================================================
// Path / route segment helpers.
// ===========================================================================

/// A `.vyrn` file name with the extension stripped (`[id].vyrn` → `[id]`).
gen fn uiStem(name: String) -> String {
    let ba = bytes(name)
    return uiSliceStr(ba, 0, ba.length - 5)
}

/// Whether a route segment token is dynamic (`[name]`).
gen fn uiIsDynSeg(s: String) -> Bool {
    return s.startsWith("[") && s.endsWith("]")
}

/// The parameter name inside a dynamic segment token (`[id]` → `id`).
gen fn uiDynName(s: String) -> String {
    let ba = bytes(s)
    return uiSliceStr(ba, 1, ba.length - 1)
}

/// The route segment tokens for a file `st` under `prefix`: `index` contributes
/// nothing (the directory's own route), `[id]` a dynamic token, anything else a
/// static token.
gen fn uiRouteSegsFor(prefix: Array<String>, st: String) -> Array<String> {
    if st == "index" {
        return prefix.copy()
    }
    return uiAppendStr(prefix, st)
}

/// The dynamic parameter names of a segment list, in order.
gen fn uiDynNamesOf(segs: Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    for s in segs {
        if uiIsDynSeg(s) {
            out.push(uiDynName(s))
        }
    }
    return out
}

/// A collision key: static tokens verbatim, every dynamic token as `:`. Two
/// pages with the same key claim the same route.
gen fn uiCollisionKey(segs: Array<String>) -> String {
    let mut parts: Array<String> = []
    for s in segs {
        if uiIsDynSeg(s) {
            parts.push(":")
        } else {
            parts.push(s.copy())
        }
    }
    return "/" + joinWith(parts, "/")
}

/// The human display pattern (`/users/:id`) used for titles and diagnostics.
gen fn uiUrlPatternOf(segs: Array<String>) -> String {
    if segs.length == 0 {
        return "/"
    }
    let mut parts: Array<String> = []
    for s in segs {
        if uiIsDynSeg(s) {
            parts.push(":" + uiDynName(s))
        } else {
            parts.push(s.copy())
        }
    }
    return "/" + joinWith(parts, "/")
}

/// The WIRE pattern of a route (`/users/{id}`) — `std/http`'s placeholder
/// spelling. The display pattern above is for titles and diagnostics; this one is
/// what `mount` matches on and what `vyrn routes` prints.
///
/// It is the WHOLE path and not a tree-relative fragment, because a page router
/// matches `req.path` entire: `uiRouteSegments` splits the request path and
/// compares it to the tree's own segments, so a page tree cannot be re-hung
/// somewhere else and its pattern is already absolute.
gen fn uiWirePatternOf(segs: Array<String>) -> String {
    if segs.length == 0 {
        return "/"
    }
    let mut parts: Array<String> = []
    for s in segs {
        if uiIsDynSeg(s) {
            parts.push("{" + uiDynName(s) + "}")
        } else {
            parts.push(s.copy())
        }
    }
    return "/" + joinWith(parts, "/")
}

/// What a page route calls itself in the `procedure` column: its place in the
/// tree (`index`, `p/[id]`), which is the only name a page has — there is no
/// declaration to point at, the file IS the route.
gen fn uiPageKeyOf(segs: Array<String>) -> String {
    if segs.length == 0 {
        return "index"
    }
    return joinWith(segs, "/")
}

/// The regex branch for a route (static tokens literal; an `Int64` param as its
/// integer-spelling regex). The root route is the bare `/`.
gen fn uiRoutePathBranch(segs: Array<String>, dynTypes: Array<String>) -> String {
    if segs.length == 0 {
        return "/"
    }
    let mut parts: Array<String> = []
    let mut k = 0
    for s in segs {
        if uiIsDynSeg(s) {
            let ty = if k < dynTypes.length { dynTypes[k] } else { "Int64" }
            parts.push(uiSegRegex(ty))
            k = k + 1
        } else {
            parts.push(uiRegexEscapeLit(s))
        }
    }
    return "/" + joinWith(parts, "/")
}

/// One URL slug as an identifier fragment.
///
/// THE RULE: a URL slug and a Vyrn identifier are DIFFERENT ALPHABETS, so the
/// conversion is deliberate and total, never a copy. Every run of bytes that is
/// not ASCII alphanumeric is a word break and disappears; every word after the
/// first is capitalised, which is this project's lowerCamelCase convention:
///
///     about-us -> aboutUs      sign-in  -> signIn      a.b -> aB
///     terms_of_service -> termsOfService              2fa -> 2fa
///
/// The conversion is MANY-TO-ONE (`about-us` and `aboutUs` share a fragment), and
/// it cannot fix a digit-leading fragment. Neither is papered over here:
/// `uiHelperCollisions` reports the first, and `uiIdentLead` handles the second at
/// the one place a fragment becomes a whole name.
gen fn uiSegIdent(s: String) -> String {
    let mut out: Array<UInt8> = []
    let mut atWordStart = false
    for b in bytes(s) {
        if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') {
            if atWordStart && b >= 'a' && b <= 'z' {
                out.push(b - 32)
            } else {
                out.push(b)
            }
            atWordStart = false
        } else {
            atWordStart = true
        }
    }
    return fromBytesOr(out, "")
}

/// `name` made legal to START an identifier. A slug may begin with a digit
/// (`/2fa`), and no capitalisation rule can rescue that, so a leading `_` does —
/// `2faPath` becomes `_2faPath`. A RESERVED WORD needs no handling: every name
/// this module builds carries a mandatory affix (`href…`, `…Path`), so it can
/// never come out equal to a keyword.
gen fn uiIdentLead(name: String) -> String {
    let ba = bytes(name)
    if ba.length > 0 && ba[0] >= '0' && ba[0] <= '9' {
        return "_" + name
    }
    return name.copy()
}

/// The camelCase name of a static route's typed-URL helper (`/items/sub` →
/// `itemsSubPath`; `/about-us` → `aboutUsPath`; `/` → `rootPath`).
gen fn uiStaticHelperName(segs: Array<String>) -> String {
    if segs.length == 0 {
        return "rootPath"
    }
    let mut out = ""
    let mut i = 0
    for s in segs {
        if i == 0 {
            out = out + uiSegIdent(s)
        } else {
            out = out + uiUpperFirst(uiSegIdent(s))
        }
        i = i + 1
    }
    return uiIdentLead(out + "Path")
}

/// The name of a dynamic route's typed-URL helper: `href` + PascalCase of its
/// STATIC segments (`/users/[id]` → `hrefUsers`; `/sign-in/[t]` → `hrefSignIn`).
gen fn uiDynHelperName(segs: Array<String>) -> String {
    let mut out = "href"
    for s in segs {
        if uiIsDynSeg(s) == false {
            out = out + uiUpperFirst(uiSegIdent(s))
        }
    }
    return out
}

/// The one name a page's typed-URL helper is exported under — the single place
/// that decides, so the emitter and the collision check can never disagree.
gen fn uiHelperNameOf(p: UiPageInfo) -> String {
    if p.dynNames.length > 0 {
        return uiDynHelperName(p.segs)
    }
    return uiStaticHelperName(p.segs)
}

/// The typed-URL body of a dynamic helper: a Vyrn string literal with a uiHole per
/// dynamic segment (`/users/[id]` → `"/users/\{id}"`).
///
/// A `String` parameter goes through `urlEncode` (`/tags/[name]` →
/// `"/tags/\{urlEncode(name)}"`), because a VALUE and a path SEGMENT are different
/// alphabets: the helper writes the segment, so the helper does the conversion.
/// The rule is RFC 3986 §2.3 — the unreserved set passes, every other byte is
/// `%XX` — which is stricter than the segment grammar allows and is what makes
/// `urlDecode` its exact inverse. `/` in a value becomes `%2F` and is no longer
/// the separator the template writes between segments.
///
/// An `Int64` parameter is left alone: its decimal spelling is digits and `-`,
/// all unreserved, so encoding it would be a no-op and every existing integer
/// route's helper is emitted byte-for-byte as before.
gen fn uiDynHelperBody(segs: Array<String>, dynTypes: Array<String>) -> String {
    let mut parts: Array<String> = []
    let mut k = 0
    for s in segs {
        if uiIsDynSeg(s) {
            let ty = if k < dynTypes.length { dynTypes[k] } else { "Int64" }
            let name = uiDynName(s)
            parts.push(uiHole(if ty == "String" { "urlEncode(" + name + ")" } else { name }))
            k = k + 1
        } else {
            parts.push(s.copy())
        }
    }
    return "\"/" + joinWith(parts, "/") + "\""
}

// ===========================================================================
// Record-field parsing — pull field names + type spellings out of a Params (or
// Data) type's canonical `moduleInterface` source text.
// ===========================================================================

/// Parallel field name / type arrays parsed from a record type declaration.
type UiFields = { names: Array<String>, types: Array<String> }

/// The record body between the first `{` and the last `}` of `source`.
gen fn uiRecordBody(source: String) -> String {
    let ba = bytes(source)
    let mut open = 0 - 1
    let mut close = 0 - 1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '{' && open < 0 {
            open = i
        }
        if ba[i] == '}' {
            close = i
        }
        i = i + 1
    }
    if open < 0 || close <= open {
        return ""
    }
    return uiSliceStr(ba, open + 1, close)
}

/// Split a record body on commas at generic (`<>`) AND nested-record (`{}`) depth
/// 0, so `Array<A, B>` and `meta: { x: Int64, y: Int64 }` each stay whole.
gen fn uiSplitFields(body: String) -> Array<String> {
    let ba = bytes(body)
    let mut parts: Array<String> = []
    let mut depth = 0
    let mut start = 0
    let mut i = 0
    while i < ba.length {
        let b = ba[i]
        if b == '<' || b == '{' {
            depth = depth + 1
        } else if b == '>' || b == '}' {
            depth = depth - 1
        } else if b == ',' && depth == 0 {
            parts.push(uiSliceStr(ba, start, i))
            start = i + 1
        }
        i = i + 1
    }
    parts.push(uiSliceStr(ba, start, ba.length))
    return parts
}

/// Parse a record type's fields from its declaration source.
gen fn uiParseFields(source: String) -> UiFields {
    let body = uiRecordBody(source)
    let mut names: Array<String> = []
    let mut types: Array<String> = []
    for part in uiSplitFields(body) {
        let trimmed = trim(part)
        if trimmed.byteLength > 0 {
            let pb = bytes(trimmed)
            let mut colon = 0 - 1
            let mut i = 0
            while i < pb.length && colon < 0 {
                if pb[i] == ':' {
                    colon = i
                }
                i = i + 1
            }
            if colon >= 0 {
                names.push(trim(uiSliceStr(pb, 0, colon)))
                types.push(trim(uiSliceStr(pb, colon + 1, pb.length)))
            }
        }
    }
    return UiFields { names: names, types: types }
}

/// The declared type spelling of field `name`, or "" when absent.
gen fn uiFieldType(f: UiFields, name: String) -> String {
    let mut i = 0
    while i < f.names.length {
        if f.names[i] == name {
            return f.types[i].copy()
        }
        i = i + 1
    }
    return ""
}

/// Whether a param type spelling is supported as a dynamic segment. `Int64`
/// matches an integer spelling; `String` (RFC-0039 §5) matches any non-empty
/// percent-encoded segment.
gen fn uiSupportedParamType(spelling: String) -> Bool {
    return spelling == "Int64" || spelling == "String"
}

/// The regex fragment a dynamic segment of type `spelling` contributes to the
/// `RoutePath` language: an integer for `Int64`, a non-empty run of unreserved
/// bytes and `%XX` escapes for `String`.
///
/// That is exactly `urlEncode`'s output alphabet (RFC 3986 §2.3), so the typed-URL
/// helper's own result always validates — and a `RoutePath` written by hand with a
/// raw space, a raw `/`, or a stray `%` no longer does. `RoutePath` says what a
/// URL is; before the helper encoded, it said what a value was.
gen fn uiSegRegex(spelling: String) -> String {
    if spelling == "String" {
        return "([A-Za-z0-9._~-]|%[0-9A-Fa-f][0-9A-Fa-f])+"
    }
    return "(0|-?[1-9][0-9]*)"
}

// ===========================================================================
// moduleInterface queries.
// ===========================================================================

gen fn uiHasFn(iface: ModuleInterface, name: String) -> Bool {
    for f in iface.functions {
        if f.name == name {
            return true
        }
    }
    return false
}

/// The parameter count of exported function `name`, or -1 when it is absent.
gen fn uiFnArity(iface: ModuleInterface, name: String) -> Int64 {
    for f in iface.functions {
        if f.name == name {
            return f.params.length
        }
    }
    return 0 - 1
}

/// The return-type spelling of exported function `name` ("" when absent).
gen fn uiFnRet(iface: ModuleInterface, name: String) -> String {
    for f in iface.functions {
        if f.name == name {
            return f.ret.copy()
        }
    }
    return ""
}

gen fn uiHasType(iface: ModuleInterface, name: String) -> Bool {
    for t in iface.types {
        if t.name == name {
            return true
        }
    }
    return false
}

gen fn uiTypeSource(iface: ModuleInterface, name: String) -> String {
    for t in iface.types {
        if t.name == name {
            return t.source.copy()
        }
    }
    return ""
}

/// The declaring-module specifier of type `name` ("" when absent) — RFC-0031:
/// a closure type may be declared in a module the reflected one imports.
gen fn uiTypeModule(iface: ModuleInterface, name: String) -> String {
    for t in iface.types {
        if t.name == name {
            return t.module.copy()
        }
    }
    return ""
}

// ===========================================================================
// Page inspection — one collected route per page module.
// ===========================================================================

/// One discovered page and everything the emitter needs about it. `err` is ""
/// for a clean page, else one or more reports anchored at the page module.
type UiPageInfo = {
    modPath: String,
    segs: Array<String>,
    urlPattern: String,
    dynNames: Array<String>,
    // dynTypes: the declared type spelling of each dynamic segment, parallel to
    // dynNames (`Int64` or `String`, RFC-0039 §5).
    dynTypes: Array<String>,
    // hasLoad: the page has data to load at all. For a `.vyrn` page this is
    // exactly `hasData`; for a `.vyx` page it is the `data` accessor its
    // `<script>` declared, which `vyxBuildPageModule` wraps into the `load()` the
    // router calls.
    hasLoad: Bool,
    // hasData: the page module itself supplies the `data` member of the
    // `std/ui:Page` contract (`export fn data() -> Query<T>`, RFC-0071), so the
    // router runs the query directly. False for a `.vyx` page, whose synthesized
    // module presents the already-wrapped `load()` instead.
    hasData: Bool,
    // dataRunner: the `std/ui` runner that turns this page's declared query type
    // into the loaded value — `runQuery` / `runLazy` / `runParamQuery` /
    // `runParamLazy` (RFC-0071 M2b). Chosen by which of `data`'s four alternative
    // signatures the page matched, so laziness and params-ness are read from the
    // TYPE and never from the body. "" when the page has no `data`.
    dataRunner: String,
    // loadHasParams: the deferred call takes a `Params` argument (a `ParamQuery`
    // or `ParamLazy`) — false for a params-free `Query`/`Lazy` (RFC-0069 §0) and
    // for a page with no `data`.
    loadHasParams: Bool,
    // loadLazy: the query is lazy (RFC-0070) — the view is over
    // `PageData<T>` and a client soft nav renders the skeleton instantly, then
    // fills in the data. Only a `.vyx` page can be lazy; a `.vyrn` page is never.
    loadLazy: Bool,
    // hasRespond: the page exports `fn respond(p: Params) -> Response` INSTEAD of
    // `page` — full content-type/status control, dispatched directly (RFC-0039 §5).
    hasRespond: Bool,
    // isVyx: a `.vyx` page (RFC-0039 §4) — imported through a nested `vyxPage(…)`
    // generator import rather than a plain module specifier.
    isVyx: Bool,
    pageArity: Int64,
    // paramsModule: the declaring-module specifier of the page's `Params` type
    // when it is IMPORTED from another module (RFC-0031); "" when `Params` is the
    // page's own declaration (or absent). A foreign `Params` cannot be reached as
    // `p<idx>.Params` (namespaces reach a module's own exports only), so the
    // router imports it under a `uiParams<idx>` alias from this specifier.
    paramsModule: String,
    // dirPrefix: the route segments of the page's DIRECTORY (its `prefix` during
    // the scan), for matching the nearest-ancestor layout/error (RFC-0041 §1/§3).
    dirPrefix: Array<String>,
    // loadKind: "validation" (`load -> Validation<Data>`), "result"
    // (`load -> Result<Data, PageError>`, RFC-0041 §3), "plain" (`load -> T`, an
    // unwrapped data type with no failure path, RFC-0069 §0), or "" (no loader).
    loadKind: String,
    // layoutNone: the page opted out of layout wrapping with `layout="none"`
    // (RFC-0041 §1); only `.vyx` pages can.
    layoutNone: Bool,
    err: String,
}

/// A page diagnostic (RFC-0099), anchored at the page module it is about.
/// Line 1, column 1: reflection hands over a module's SURFACE, not the line a
/// declaration sits on, so the file is the finest anchor this generator can give
/// correctly.
gen fn uiPageErrAt(path: String, message: String) -> String {
    return report(Error, path, 1, 1, message)
}

/// The page's contract issues as load diagnostics. `checkContract` decides what
/// is wrong (in `std/contract`, over the declaration in this module); this only
/// decides how it reads on the way out.
///
/// Every issue applies. RFC-0071 M2c closed the window that exempted `load`, so
/// a page still exporting it is now an unknown export like any other, not a
/// deprecated one.
gen fn uiContractErrs(iface: ModuleInterface, path: String) -> String {
    let mut out = ""
    for iss in checkContract(iface, contractOf(Page)) {
        out = out + uiPageErrAt(path, iss.message)
    }
    return out
}

/// Reflect a page module and validate its exported surface against its route
/// segments, returning the collected `UiPageInfo` (with `err` set on any violation).
/// A `gen fn` because it calls `moduleInterface` (generation-only, RFC-0021), so
/// its body is never lowered into a shipped binary.
gen fn uiInspectPage(modPath: String, segs: Array<String>, dirPrefix: Array<String>) -> UiPageInfo {
    // `modPath` is an import specifier; a diagnostic anchor is a file.
    let srcPath = modPath + ".vyrn"
    let dyns = uiDynNamesOf(segs)
    let iface = moduleInterface(modPath)
    let mut err = ""

    // A page exports EITHER `page` (rendered through document()) or `respond`
    // (a raw Response, full content-type/status control, RFC-0039 §5).
    let hasPage = uiHasFn(iface, "page")
    let hasRespond = uiHasFn(iface, "respond")
    if hasPage == false && hasRespond == false {
        err = err
        + uiPageErrAt(
            srcPath,
            "this page exports neither `page` nor `respond` — a page renders through `fn page(…) -> Html`, or takes over the whole reply with `fn respond(…) -> Response`",
        )
        return uiPageErr(modPath, segs, dirPrefix, dyns, err)
    }
    let entry = if hasRespond { "respond" } else { "page" }
    let arity = uiFnArity(iface, entry)
    // RFC-0071: `data` is a declared member of the `Page` contract, so its
    // presence is a contract question — `matchedMember` answers it with the
    // member's shape behind it, where `uiHasFn(iface, "load")` was a bare string.
    //
    // RFC-0072 M2: the CLOSED rule now applies here too. It could not before,
    // because a `.vyrn` page's surface carries `page`/`respond` and the contract
    // did not name them — an omission twice recorded as an open question and
    // twice deferred. It names them now, so a typo in a `.vyrn` page's exports is
    // as loud as a typo in a `.vyx` one, which was the point of declaring a
    // contract at all.
    err = err + uiContractErrs(iface, srcPath)
    let dataForm = matchedMember(iface, contractOf(Page), "data")
    let hasData = dataForm >= 0
    let hasLoad = hasData
    // RFC-0071 M2b: WHICH alternative the page matched decides how the router
    // runs it. `Param*` means the deferred call takes the route params, so the
    // router hands them over exactly as it would to a `fn load(p: Params)`.
    let dataRunner = if hasData { vyxDataRunner(dataForm) } else { "" }
    // RFC-0069 §0: a zero-parameter `data` (`Query`/`Lazy`) needs no `Params`; a
    // `ParamQuery`/`ParamLazy` does. A page with no `data` relies on its dynamic
    // segments alone.
    let loadHasParams = hasData && vyxDataFormHasParams(dataForm)
    // A `.vyrn` page's view is a plain `fn page(…) -> Html`, not a `PageData<T>`
    // match, so it has no `Loading` arm to render. Declaring a lazy query there
    // would render-then-fill into a view that cannot express "not yet" — so it is
    // named, not quietly downgraded to a blocking load.
    if hasData && vyxDataFormIsLazy(dataForm) {
        err = err
        + uiPageErrAt(
            srcPath,
            "this page declares a lazy `data`, and a `.vyrn` page's view is a plain `fn page(…) -> Html` with no `Loading` arm to render — write the page as `.vyx`, or drop `lazy`",
        )
    }
    let needParams = dyns.length > 0 || loadHasParams

    // dynTypes: each dynamic segment's declared type, parallel to `dyns`.
    let mut dynTypes: Array<String> = []
    for d in dyns {
        dynTypes.push("Int64")
    }

    // Params: field names must match the dynamic segments exactly, and every
    // param type must be supported.
    if needParams {
        if uiHasType(iface, "Params") == false {
            err = err
            + uiPageErrAt(
                srcPath,
                "route `\{uiUrlPatternOf(segs)}` binds parameters, and this page declares no `Params` type — declare `type Params = { … }` with one field per dynamic segment",
            )
        } else {
            let f = uiParseFields(uiTypeSource(iface, "Params"))
            for d in dyns {
                if includes(f.names, d) == false {
                    err = err
                    + uiPageErrAt(
                        srcPath,
                        "route segment `[\{d}]` has no field `\{d}` in `Params` — every dynamic segment binds to a field of the same name",
                    )
                }
            }
            // Resolve each dynamic segment's declared type (default Int64).
            let mut di = 0
            while di < dyns.length {
                let t = uiFieldType(f, dyns[di])
                if t.byteLength > 0 {
                    dynTypes[di] = t
                }
                di = di + 1
            }
            let mut i = 0
            while i < f.names.length {
                let fn2 = f.names[i]
                if includes(dyns, fn2) == false {
                    err = err
                    + uiPageErrAt(
                        srcPath,
                        "`Params` declares `\{fn2}`, and route `\{uiUrlPatternOf(segs)}` has no `[\{fn2}]` segment — a `Params` field binds a dynamic segment, so add the segment or drop the field",
                    )
                }
                if uiSupportedParamType(f.types[i]) == false {
                    err = err
                    + uiPageErrAt(
                        srcPath,
                        "`Params` field `\{fn2}` is `\{f.types[i]}`, which a URL segment cannot carry — a route parameter is `Int64` or `String`",
                    )
                }
                i = i + 1
            }
        }
    }

    // Signature / loader agreement.
    if hasRespond {
        // A raw-response page owns rendering entirely: no loader, `respond(p)` for
        // a dynamic route or `respond()` for a static one, returning `Response`.
        if hasLoad {
            err = err
            + uiPageErrAt(
                srcPath,
                "this page exports both `respond` and `data` — a `respond` page owns the whole reply, so it loads whatever it needs itself; drop one of the two",
            )
        }
        if dyns.length > 0 && arity != 1 {
            err = err
            + uiPageErrAt(
                srcPath,
                "route `\{uiUrlPatternOf(segs)}` is dynamic, so its entry must be `fn respond(p: Params) -> Response`",
            )
        }
        if dyns.length == 0 && arity != 0 {
            err = err
            + uiPageErrAt(
                srcPath,
                "route `\{uiUrlPatternOf(segs)}` binds nothing, so its entry must be `fn respond() -> Response`",
            )
        }
        if uiFnRet(iface, "respond") != "Response" {
            err = err
            + uiPageErrAt(
                srcPath,
                "`respond` returns `\{uiFnRet(iface, "respond")}` — a `respond` page owns the whole reply, so it must return `Response`",
            )
        }
    } else if hasLoad {
        // A `load(p: Params)` pairs with `page(p, d)` (arity 2); a zero-parameter
        // static `load()` (RFC-0069 §0) pairs with `page(d)` (arity 1).
        if loadHasParams {
            if arity != 2 {
                err = err
                + uiPageErrAt(
                    srcPath,
                    "this page's `data` takes the route params, so its view must be `fn page(p: Params, d: Data) -> Html`",
                )
            }
        } else {
            if arity != 1 {
                err = err
                + uiPageErrAt(
                    srcPath,
                    "this page's `data` takes no params, so its view must be `fn page(d: Data) -> Html`",
                )
            }
            if dyns.length > 0 {
                err = err
                + uiPageErrAt(
                    srcPath,
                    "route `\{uiUrlPatternOf(segs)}` is dynamic, and this page's `data` takes no params — its segments would have nowhere to bind, so declare `data` over `Params`",
                )
            }
        }
        // A loader returns `Validation<Data>` (Invalid → 422 error page),
        // `Result<Data, PageError>` (Err → the carried-status error page, §3), or an
        // unwrapped plain data type (RFC-0069 §0 — no failure path).
    } else {
        if dyns.length > 0 && arity != 1 {
            err = err
            + uiPageErrAt(
                srcPath,
                "route `\{uiUrlPatternOf(segs)}` is dynamic and this page has no `data`, so its view must be `fn page(p: Params) -> Html`",
            )
        }
        if dyns.length == 0 && arity != 0 {
            err = err
            + uiPageErrAt(
                srcPath,
                "route `\{uiUrlPatternOf(segs)}` binds nothing and this page has no `data`, so its view must be `fn page() -> Html`",
            )
        }
    }

    // Where `Params` is declared (RFC-0031): its own page keeps the namespace
    // path (`p<idx>.Params` — byte-identical to before); a foreign declaring
    // module means the router must import it directly.
    let mut paramsModule = ""
    if needParams {
        let declared = uiTypeModule(iface, "Params")
        if declared != modPath {
            paramsModule = declared
        }
    }

    // Loader kind: "" (none), "result" (Result<Data, PageError>), "validation"
    // (Validation<Data>), or "plain" (an unwrapped data type, RFC-0069 §0). The
    // data type is the one `data`'s declared query type carries; everything
    // downstream reads only this.
    let loadRet = if hasData { vyxQueryDataType(uiFnRet(iface, "data")) } else { "" }
    let loadKind = if hasLoad {
        if loadRet.startsWith("Result<") { "result" } else if loadRet.startsWith("Validation<") { "validation" } else { "plain" }
    } else {
        ""
    }

    return UiPageInfo {
        modPath: modPath.copy(),
        segs: segs.copy(),
        urlPattern: uiUrlPatternOf(segs),
        dynNames: dyns,
        dynTypes: dynTypes,
        hasLoad: hasLoad,
        hasData: hasData,
        dataRunner: dataRunner,
        loadHasParams: loadHasParams,
        loadLazy: false,
        hasRespond: hasRespond,
        isVyx: false,
        pageArity: arity,
        paramsModule: paramsModule,
        dirPrefix: dirPrefix.copy(),
        loadKind: loadKind,
        layoutNone: false,
        err: err,
    }
}

/// A file's source plus the OS reason when it could not be read — a match arm
/// is one expression, so the error travels instead of becoming "" (which made
/// an unreadable `.vyx` reflect as a page with no params and no loader).
type UiFileRead = { src: String, err: String }

gen fn uiReadVyx(path: String) -> UiFileRead {
    return match readFile(path) {
        Ok(v) => UiFileRead { src: v, err: "" },
        Err(e) => UiFileRead { src: "", err: e },
    }
}

/// A directory listing plus the OS reason when it failed (same trick).
type UiDirRead = { entries: Array<String>, err: String }

gen fn uiReadDirOf(dir: String) -> UiDirRead {
    return match listDir(dir) {
        Ok(ns) => UiDirRead { entries: ns, err: "" },
        Err(err) => UiDirRead { entries: [], err: err },
    }
}

/// Reflect a `.vyx` PAGE (RFC-0039 §4): read the file, learn its `params`/loader
/// shape via std/vyx's `vyxPageShape`, and validate it against the route segments
/// exactly as `uiInspectPage` does for a `.vyrn` page. A `gen fn` (it `readFile`s
/// the `.vyx`). `modPath` is the file path without the `.vyx` extension.
gen fn uiInspectVyxPage(modPath: String, segs: Array<String>, dirPrefix: Array<String>) -> UiPageInfo {
    // `modPath` is the `.vyx` path with the extension stripped; put it back for
    // the diagnostic anchor.
    let srcPath = modPath + ".vyx"
    let dyns = uiDynNamesOf(segs)
    let read = uiReadVyx(srcPath)
    if read.err != "" {
        // A read failure is its own diagnostic: compiling "" here made the page
        // reflect as having no params and no loader, and the build failed later
        // on a missing `page` export.
        return uiPageErr(modPath, segs, dirPrefix, dyns, uiPageErrAt(srcPath, "std/ui cannot read `\{srcPath}`: \{read.err}"))
    }
    let src = read.src
    let shape = vyxPageShape(src)
    // RFC-0071: the page's PUBLIC surface — its `export fn` declarations —
    // checked against the `Page` contract. A `.vyx` file is not a module, so the
    // surface is read from source (`vyxPageInterface`) rather than reflected;
    // everything after that is the same `checkContract` every other consumer
    // runs, over the same declaration. This is what turns `export fn laod()`
    // from a page that silently rendered empty into an error naming `data`.
    let mut err = shape.err + uiContractErrs(vyxPageInterface(src), srcPath)
    let hasLoad = shape.hasLoad
    // RFC-0070: a `lazy fn load()` view is over `PageData<T>` and gets the instant-
    // skeleton client nav. Only a loader page can be lazy.
    let loadLazy = hasLoad && shape.loadLazy
    // RFC-0069 §0: a zero-parameter static `load()` needs no `params` block.
    let loadHasParams = hasLoad && shape.loadHasParams
    // Loader kind from the declared return-type spelling: "result", "validation"
    // (RFC-0041 §3), or "plain" (an unwrapped data type, RFC-0069 §0).
    let loadKind = if hasLoad {
        if shape.loadRet.startsWith("Result<") { "result" } else if shape.loadRet.startsWith("Validation<") { "validation" } else { "plain" }
    } else {
        ""
    }
    // dynTypes + Params/segment agreement (mirrors uiInspectPage).
    let mut dynTypes: Array<String> = []
    for d in dyns {
        dynTypes.push("Int64")
    }
    // A dynamic route whose loader takes no params is a mismatch (its segment has
    // nowhere to bind, RFC-0069 §0).
    if hasLoad && loadHasParams == false && dyns.length > 0 {
        err = err
        + uiPageErrAt(
            srcPath,
            "route `\{uiUrlPatternOf(segs)}` is dynamic, and this page's `data` takes no params — its segments would have nowhere to bind, so declare `data` over `params`",
        )
    }
    let needParams = dyns.length > 0 || loadHasParams
    if needParams {
        for d in dyns {
            if includes(shape.paramNames, d) == false {
                err = err
                + uiPageErrAt(
                    srcPath,
                    "route segment `[\{d}]` has no field `\{d}` in this page's `params` — every dynamic segment binds to a field of the same name",
                )
            }
        }
        let mut di = 0
        while di < dyns.length {
            let mut ti = 0
            while ti < shape.paramNames.length {
                if shape.paramNames[ti] == dyns[di] {
                    dynTypes[di] = shape.paramTypes[ti].copy()
                }
                ti = ti + 1
            }
            di = di + 1
        }
        let mut i = 0
        while i < shape.paramNames.length {
            let nm = shape.paramNames[i]
            if includes(dyns, nm) == false {
                err = err
                + uiPageErrAt(
                    srcPath,
                    "`params` declares `\{nm}`, and route `\{uiUrlPatternOf(segs)}` has no `[\{nm}]` segment — a `params` field binds a dynamic segment, so add the segment or drop the field",
                )
            }
            if uiSupportedParamType(shape.paramTypes[i]) == false {
                err = err
                + uiPageErrAt(
                    srcPath,
                    "`params` field `\{nm}` is `\{shape.paramTypes[i]}`, which a URL segment cannot carry — a route parameter is `Int64` or `String`",
                )
            }
            i = i + 1
        }
    }

    // page arity: a param loader → page(p, d) = 2; a zero-param loader → page(d) =
    // 1 (RFC-0069 §0); a params-only page → page(p) = 1; a static page → page() = 0.
    let arity = if hasLoad {
        if loadHasParams { 2 } else { 1 }
    } else {
        if dyns.length > 0 { 1 } else { 0 }
    }
    return UiPageInfo {
        modPath: modPath.copy(),
        segs: segs.copy(),
        urlPattern: uiUrlPatternOf(segs),
        dynNames: dyns,
        dynTypes: dynTypes,
        hasLoad: hasLoad,
        hasData: false,
        dataRunner: "",
        loadHasParams: loadHasParams,
        loadLazy: loadLazy,
        hasRespond: false,
        isVyx: true,
        pageArity: arity,
        paramsModule: "",
        dirPrefix: dirPrefix.copy(),
        loadKind: loadKind,
        layoutNone: shape.layoutNone,
        err: err,
    }
}

/// A `UiPageInfo` carrying only an error (the entry export is missing).
gen fn uiPageErr(modPath: String, segs: Array<String>, dirPrefix: Array<String>, dyns: Array<String>, err: String) -> UiPageInfo {
    let mut dynTypes: Array<String> = []
    for d in dyns {
        dynTypes.push("Int64")
    }
    return UiPageInfo {
        modPath: modPath.copy(),
        segs: segs.copy(),
        urlPattern: uiUrlPatternOf(segs),
        dynNames: dyns.copy(),
        dynTypes: dynTypes,
        hasLoad: false,
        hasData: false,
        dataRunner: "",
        loadHasParams: false,
        loadLazy: false,
        hasRespond: false,
        isVyx: false,
        pageArity: 0,
        paramsModule: "",
        dirPrefix: dirPrefix.copy(),
        loadKind: "",
        layoutNone: false,
        err: err.copy(),
    }
}

/// Whether `path` is a directory (a `listDir` that succeeds), used to recurse
/// into nested static route directories. A regular file lists as an error. A
/// `gen fn` (calls `listDir`, generation-only) so codegen never lowers it.
gen fn uiIsDir(path: String) -> Bool {
    return match listDir(path) {
        Ok(ns) => true,
        Err(err) => false,
    }
}

/// A layout or error `.vyx` discovered during the scan: its module path and the
/// route segments of its DIRECTORY (for nearest-ancestor matching, RFC-0041).
type UiChrome = { modPath: String, dirPrefix: Array<String> }

/// The result of a directory scan: route pages plus the `layout.vyx` / `error.vyx`
/// chrome files (which are NOT routes). `err` carries the OS reason when a
/// directory could not be listed — swallowing it into an empty scan made an
/// unreadable tree report `no page modules under …`, pointing at the wrong fix.
type UiScan = { pages: Array<UiPageInfo>, layouts: Array<UiChrome>, errors: Array<UiChrome>, err: String }

/// Recursively scan `dir` (accumulating the route-segment `prefix`) into the pages
/// AND chrome (`layout.vyx`/`error.vyx`) it and its subdirectories contain. A
/// `gen fn` (calls `listDir` + the inspectors, all generation-only) so codegen
/// never lowers it. `layout`/`error` `.vyx` files are chrome, not routes.
gen fn uiScanAll(dir: String, prefix: Array<String>) -> UiScan {
    let listed = uiReadDirOf(dir)
    let mut scanErr = listed.err
    let mut pages: Array<UiPageInfo> = []
    let mut layouts: Array<UiChrome> = []
    let mut errors: Array<UiChrome> = []
    for name in listed.entries {
        if name.endsWith(".vyrn") {
            let st = uiStem(name)
            let modPath = dir + "/" + st
            pages.push(uiInspectPage(modPath, uiRouteSegsFor(prefix, st), prefix))
        } else if name.endsWith(".vyx") {
            let nb = bytes(name)
            let st = uiSliceStr(nb, 0, nb.length - 4)
            let modPath = dir + "/" + st
            if st == "layout" {
                layouts.push(UiChrome { modPath: modPath, dirPrefix: prefix.copy() })
            } else if st == "error" {
                errors.push(UiChrome { modPath: modPath, dirPrefix: prefix.copy() })
            } else {
                pages.push(uiInspectVyxPage(modPath, uiRouteSegsFor(prefix, st), prefix))
            }
        } else {
            let sub = dir + "/" + name
            if uiIsDir(sub) {
                let kid = uiScanAll(sub, uiAppendStr(prefix, name))
                scanErr = scanErr + kid.err
                for p in kid.pages {
                    pages.push(p.copy())
                }
                for l in kid.layouts {
                    layouts.push(l.copy())
                }
                for e in kid.errors {
                    errors.push(e.copy())
                }
            }
        }
    }
    return UiScan { pages: pages, layouts: layouts, errors: errors, err: scanErr }
}

/// Whether `a` is a (non-strict) prefix of `b` — the ancestor test for chrome.
gen fn uiIsPrefixOf(a: Array<String>, b: Array<String>) -> Bool {
    if a.length > b.length {
        return false
    }
    let mut i = 0
    while i < a.length {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// The global layout indices wrapping a page, OUTER-first (shortest dirPrefix
/// first), so composing right-to-left nests outermost-last (RFC-0041 §1). Empty
/// when the page opted out (`layout="none"`) or no ancestor layout exists.
gen fn uiLayoutChain(p: UiPageInfo, layouts: Array<UiChrome>) -> Array<Int64> {
    let mut idxs: Array<Int64> = []
    if p.layoutNone {
        return idxs
    }
    // Longest ancestor-prefix length wins ties are impossible (one layout per
    // dir); collect every ancestor, then order by dirPrefix length ascending.
    let mut maxLen = 0
    for l in layouts {
        if uiIsPrefixOf(l.dirPrefix, p.dirPrefix) && l.dirPrefix.length > maxLen {
            maxLen = l.dirPrefix.length
        }
    }
    let mut want = 0
    while want <= maxLen {
        let mut i = 0
        while i < layouts.length {
            if uiIsPrefixOf(layouts[i].dirPrefix, p.dirPrefix) && layouts[i].dirPrefix.length == want {
                idxs.push(i)
            }
            i = i + 1
        }
        want = want + 1
    }
    return idxs
}

/// The global index of the nearest-ancestor `error.vyx` for a page (longest
/// matching dirPrefix), or -1 when none exists.
gen fn uiErrorIndex(p: UiPageInfo, errors: Array<UiChrome>) -> Int64 {
    let mut best = 0 - 1
    let mut bestLen = 0 - 1
    let mut i = 0
    while i < errors.length {
        if uiIsPrefixOf(errors[i].dirPrefix, p.dirPrefix) && errors[i].dirPrefix.length > bestLen {
            best = i
            bestLen = errors[i].dirPrefix.length
        }
        i = i + 1
    }
    return best
}

/// Detect two pages claiming the same route. One diagnostic line per collision,
/// naming both files. Two pages that claim DIFFERENT routes but one helper NAME
/// are caught here too, by `uiHelperCollisions`.
gen fn uiCollisionErrors(pages: Array<UiPageInfo>) -> String {
    let mut err = ""
    let mut i = 0
    while i < pages.length {
        let mut j = i + 1
        while j < pages.length {
            if uiCollisionKey(pages[i].segs) == uiCollisionKey(pages[j].segs) {
                err = err
                + reportHere(
                    Error,
                    "pages `\{pages[i].modPath}` and `\{pages[j].modPath}` both claim route `\{uiUrlPatternOf(pages[i].segs)}` — one URL reaches one page, so move or rename one of them",
                )
            }
            j = j + 1
        }
        i = i + 1
    }
    return err + uiHelperCollisions(pages)
}

/// Two DISTINCT routes whose typed-URL helpers would carry ONE name — `/about-us`
/// and `/aboutUs` both reach `aboutUsPath`. Slug-to-identifier is many-to-one, so
/// this is reported (RFC-0099) rather than resolved: which of the two routes gets
/// renamed is the author's decision, not the generator's. `reportHere` is the
/// right anchor — the fault is a contradiction BETWEEN two input files, not a
/// position inside either one. Same-route pairs are left to
/// `uiCollisionErrors` above, so one mistake gets one diagnostic.
gen fn uiHelperCollisions(pages: Array<UiPageInfo>) -> String {
    let mut out = ""
    let mut i = 0
    while i < pages.length {
        let mut j = i + 1
        while j < pages.length {
            let sameName = uiHelperNameOf(pages[i]) == uiHelperNameOf(pages[j])
            let sameRoute = uiCollisionKey(pages[i].segs) == uiCollisionKey(pages[j].segs)
            if sameName && sameRoute == false {
                out = out
                + reportHere(
                    Error,
                    "routes `\{uiUrlPatternOf(pages[i].segs)}` and `\{uiUrlPatternOf(pages[j].segs)}` both name the typed-URL helper `\{uiHelperNameOf(pages[i])}` — a URL slug and a Vyrn identifier are different alphabets, and these two slugs convert to one identifier; rename one route",
                )
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// ===========================================================================
// Emitting the synthesized router module.
// ===========================================================================

/// The fixed runtime block shared by every generated router: the segment
/// splitter, the Option probe, the 404 page, and the error page. Prefixed
/// (`uiRoute…`) so it never clashes with page or app names.
gen fn uiFixedRuntime() -> String {
    // RFC-0054 M4a: the whole fixed runtime is now a hole-less `vyrn"""…"""` code
    // quote — static Vyrn validated when THIS generator is compiled (a typo here is
    // a diagnostic in std/ui, not a re-lex failure at generation time). Notes on the
    // emitted code: `uiRouteSegments` strips the query and collapses slashes.
    // Percent-decoding is NOT here — it is `std/codecs:urlDecode`, called at the one
    // place a segment becomes a value (`uiEmitDynMatch`), so its `None` is the 404
    // the router already has.
    return render(vyrn"""fn uiRouteSlice(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut acc: Array<UInt8> = []
    let mut i = s
    while i < e {
        acc.push(ba[i])
        i = i + 1
    }
    return match stringFromBytes(acc) {
        Ok(v) => v,
        Err(err) => "",
    }
}
fn uiRouteSegments(path: String) -> Array<String> {
    let ba = bytes(path)
    let mut segs: Array<String> = []
    let mut start = 0
    let mut i = 0
    let mut stop = ba.length
    while i < ba.length {
        if ba[i] == '?' {
            stop = i
            i = ba.length
        } else {
            i = i + 1
        }
    }
    i = 0
    while i < stop {
        if ba[i] == '/' {
            if i > start {
                segs.push(uiRouteSlice(ba, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if stop > start {
        segs.push(uiRouteSlice(ba, start, stop))
    }
    return segs
}
fn uiRouteNone(o: Option<Response>) -> Bool {
    return match o {
        Some(r) => false,
        None => true,
    }
}
fn uiRouteNotFound() -> Response {
    return Response { status: 404, contentType: "text/html", body: document("Not Found", [], el("main", [], [el("h1", [], [text("404 — Not Found")])])), vary: "", headers: [:] }
}
fn uiRouteIssue(iss: Issue) -> Html {
    return el("li", [], [text(iss.path + ": " + iss.message)])
}
fn uiRouteError(issues: Array<Issue>) -> Html {
    let mut items: Array<Html> = []
    for iss in issues {
        items.push(uiRouteIssue(iss))
    }
    return el("main", [], [el("h1", [], [text("Unable to load this page")]), el("ul", [], items)])
}
""")
}

/// The head/layout threading helpers (RFC-0041 §1/§2), emitted only when some page
/// threads a head: `uiFirst` (title precedence) and `uiHeadJoin2` (head concat).
gen fn uiHeadRuntime() -> String {
    return render(vyrn"""fn uiFirst(a: String, b: String) -> String {
    if a.byteLength > 0 {
        return a.copy()
    }
    return b.copy()
}
fn uiHeadJoin2(a: consume Array<Html>, b: consume Array<Html>) -> Array<Html> {
    let mut out: Array<Html> = []
    for x in consume a {
        out.push(x)
    }
    for x in consume b {
        out.push(x)
    }
    return out
}
""")
}

/// The error-page helpers (RFC-0041 §3), emitted only when some page dispatches a
/// `PageError`: `uiRoutePageError` (the built-in error body when no `error.vyx`)
/// and `uiIssuesToError` (folding a `Validation` failure into a 422 `PageError`).
gen fn uiErrorRuntime() -> String {
    return render(vyrn"""fn uiRoutePageError(e: PageError) -> Html {
    return el("main", [], [el("h1", [], [text(e.status.toString() + " — " + e.message)])])
}
fn uiIssuesToError(issues: Array<Issue>) -> PageError {
    let mut msg = ""
    let mut i = 0
    for iss in issues {
        if i > 0 {
            msg = msg + "; "
        }
        msg = msg + iss.path + ": " + iss.message
        i = i + 1
    }
    return PageError { status: 422, message: msg }
}
""")
}

/// The `try`/`render` pair for one page, indexed `n` (its import-alias suffix).
/// The whole block is bracketed by an RFC-0033 origin directive pointing at the
/// page module, so a type error in the generated dispatch glue (e.g. a `page`
/// whose return type isn't `Html`) is reported against the page file, not the
/// synthesized router. Region-level (`1:1`): this is derived, not verbatim, code.
///
/// RFC-0054 note: `rawAt` deliberately NOT used here. `rawAt` carries the origin of
/// USER-AUTHORED text spliced as code (a `.vyx` template expression — the std/vyx
/// story). This block is entirely DERIVED router glue; the origin exists only to
/// attribute a check error to the page file, so a region-level directive is exactly
/// right and column-exact origins (risk 1) would be meaningless for generated code.
gen fn uiEmitRoute(p: UiPageInfo, n: Int64, layoutIdxs: Array<Int64>, errorIdx: Int64) -> String {
    let idx = n.toString()
    let mut out = "//@origin " + p.modPath + ".vyrn:1:1\n"

    // uiTry<n>: structural match + dynamic-segment parse → Some(uiRender<n>(args)).
    out = out + uiEmitTryFn(p, idx, "uiTry", "uiRender")
    // uiRender<n>: build Params, run load (if any), render through document().
    out = out + uiEmitRender(p, idx, layoutIdxs, errorIdx)
    out = out + "//@origin end\n"
    return out
}

/// The data-channel counterpart of `uiEmitRoute` (RFC-0069 §2): `uiTryData<n>`
/// (same structural match) → `uiRenderData<n>`, which runs `load` exactly as SSR
/// would but answers with the `{page, title, props[, params]}` JSON payload. Emitted
/// only for client-renderable `.vyx` pages.
gen fn uiEmitDataRoute(p: UiPageInfo, n: Int64, layoutIdxs: Array<Int64>, errorIdx: Int64) -> String {
    let idx = n.toString()
    let mut out = "//@origin " + p.modPath + ".vyrn:1:1\n"
    out = out + uiEmitTryFn(p, idx, "uiTryData", "uiRenderData")
    out = out + uiEmitDataRender(p, idx, layoutIdxs, errorIdx)
    out = out + "//@origin end\n"
    return out
}

/// Emit a structural-match `try` fn named `<tryName><idx>` that, on a match, calls
/// `<renderName><idx>(args)`. Shared by the HTML (`uiTry`/`uiRender`) and data
/// (`uiTryData`/`uiRenderData`) channels — identical routing, different renderer.
gen fn uiEmitTryFn(p: UiPageInfo, idx: String, tryName: String, renderName: String) -> String {
    let segCount = p.segs.length.toString()
    let mut out = "fn " + tryName + idx + "(segs: Array<String>) -> Option<Response> {\n"
    out = out + "    if segs.length != " + segCount + " {\n        return None\n    }\n"
    let mut i = 0
    for s in p.segs {
        if uiIsDynSeg(s) == false {
            out = out + "    if segs[" + i.toString() + "] != " + uiStrLit(s) + " {\n        return None\n    }\n"
        }
        i = i + 1
    }
    // Both dynamic types parse left-to-right into one nested match that 404s
    // without reaching user code: an `Int64` segment that is not an integer, and a
    // `String` segment that is not percent-encoded text.
    out = out + "    return " + uiEmitDynMatch(p, 0, idx, renderName) + "\n}\n"
    return out
}

/// The nested parse over the dynamic segments (position `k` in `dynNames`),
/// ending in `Some(<renderName><idx>(args))`.
///
/// A segment arrives in the WIRE alphabet and a `Params` field holds a VALUE, so
/// each `String` segment is `urlDecode`d here — the inverse of the `urlEncode`
/// the typed-URL helper writes, at the one place the conversion belongs. A
/// segment that is not percent-encoded text (`%zz`, a truncated `%4`, a `%00`) is
/// `None`, which is the same 404 a non-integer `Int64` segment gets: no request
/// reaches user code carrying wire bytes, and none aborts the program either.
gen fn uiEmitDynMatch(p: UiPageInfo, k: Int64, idx: String, renderName: String) -> String {
    if k >= p.dynNames.length {
        return "Some(" + renderName + idx + "(" + joinWith(uiDynArgs(p.dynNames), ", ") + "))"
    }
    // Find the segment index of the k-th dynamic segment.
    let segIdx = uiDynSegIndex(p.segs, k)
    let vv = "v" + k.toString()
    if p.dynTypes[k] == "String" {
        let mut out = "match urlDecode(segs[" + segIdx.toString() + "]) {\n"
        out = out + "        Some(" + vv + ") => " + uiEmitDynMatch(p, k + 1, idx, renderName) + ",\n"
        out = out + "        None => None,\n"
        out = out + "    }"
        return out
    }
    let mut out = "match fromJson(UiRouteInt, segs[" + segIdx.toString() + "]) {\n"
    out = out + "        Valid(" + vv + ") => " + uiEmitDynMatch(p, k + 1, idx, renderName) + ",\n"
    out = out + "        Invalid(issues) => None,\n"
    out = out + "    }"
    return out
}

/// The forwarded argument names `v0, v1, …` for a page's dynamic segments.
gen fn uiDynArgs(dynNames: Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    let mut i = 0
    while i < dynNames.length {
        out.push("v" + i.toString())
        i = i + 1
    }
    return out
}

/// The index into `segs` of the `k`-th dynamic segment.
gen fn uiDynSegIndex(segs: Array<String>, k: Int64) -> Int64 {
    let mut seen = 0
    let mut i = 0
    while i < segs.length {
        if uiIsDynSeg(segs[i]) {
            if seen == k {
                return i
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return 0
}

// ---- RFC-0041 layout / head / error expression builders ---------------------

/// The page-call argument shape (matching `page`/`head`/`headTitle`): "p, d" for
/// a loader page, "p" for a params-only page, "" for a static page.
gen fn uiPageCallArgs(p: UiPageInfo) -> String {
    if p.hasLoad {
        // A zero-parameter static loader renders `page(d)`; a param loader
        // `page(p, d)` (RFC-0069 §0).
        if p.loadHasParams {
            return "p, d"
        }
        return "d"
    }
    if p.dynNames.length > 0 {
        return "p"
    }
    return ""
}

/// The page body view call for a successful render.
gen fn uiBodyCall(p: UiPageInfo, idx: String) -> String {
    return "p" + idx + ".page(" + uiPageCallArgs(p) + ")"
}

/// Whether the page needs head/layout threading (an ancestor layout, or a `.vyx`
/// page whose own `head` block may contribute). Otherwise the byte-identical
/// no-shell `document(title, [], body)` form is kept (`.vyrn` page, no layout).
gen fn uiNeedsThreading(p: UiPageInfo, layoutIdxs: Array<Int64>) -> Bool {
    return layoutIdxs.length > 0 || p.isVyx
}

/// Wrap `bodyExpr` in the layout chain (`layoutIdxs` outer→inner), composing
/// outermost-last: the innermost layout wraps the body, the outermost wraps last.
gen fn uiWrapLayout(bodyExpr: String, layoutIdxs: Array<Int64>) -> String {
    let mut out = bodyExpr.copy()
    let mut i = layoutIdxs.length - 1
    while i >= 0 {
        out = "uiLay" + layoutIdxs[i].toString() + ".layout([" + out + "])"
        i = i - 1
    }
    return out
}

/// The `Array<Html>` head expression: layout heads outer→inner, then the page
/// head (`pageHeadCall`, "" for a `.vyrn` page or the error path). "[]" for none.
gen fn uiHeadExpr(layoutIdxs: Array<Int64>, pageHeadCall: String) -> String {
    let mut out = if pageHeadCall.byteLength > 0 { pageHeadCall } else { "[]" }
    let mut i = layoutIdxs.length - 1
    while i >= 0 {
        out = "uiHeadJoin2(uiLay" + layoutIdxs[i].toString() + ".head(), " + out + ")"
        i = i - 1
    }
    return out
}

/// The document-title expression, precedence page > innermost layout > … >
/// outermost layout > `dflt`. `pageTitleCall` is "" for a `.vyrn`/error render.
gen fn uiTitleExpr(layoutIdxs: Array<Int64>, pageTitleCall: String, dflt: String) -> String {
    let mut out = uiStrLit(dflt)
    let mut i = 0
    while i < layoutIdxs.length {
        out = "uiFirst(uiLay" + layoutIdxs[i].toString() + ".headTitle(), " + out + ")"
        i = i + 1
    }
    if pageTitleCall.byteLength > 0 {
        out = "uiFirst(" + pageTitleCall + ", " + out + ")"
    }
    return out
}

/// The full 200 `Response` expression for a successful render (a match arm or a
/// plain return). `d` must be in scope when the page has a loader.
gen fn uiSuccessResponse(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>) -> String {
    let bodyExpr = uiWrapLayout(uiBodyCall(p, idx), layoutIdxs)
    if uiNeedsThreading(p, layoutIdxs) == false {
        return "Response { status: 200, contentType: \"text/html\", body: document(" + uiStrLit(p.urlPattern) + ", [], " + bodyExpr + "), vary: \"\", headers: [:] }"
    }
    let args = uiPageCallArgs(p)
    let pageHeadCall = if p.isVyx { "p" + idx + ".head(" + args + ")" } else { "" }
    let pageTitleCall = if p.isVyx { "p" + idx + ".headTitle(" + args + ")" } else { "" }
    let headE = uiHeadExpr(layoutIdxs, pageHeadCall)
    let titleE = uiTitleExpr(layoutIdxs, pageTitleCall, p.urlPattern)
    return "Response { status: 200, contentType: \"text/html\", body: document(" + titleE + ", " + headE + ", " + bodyExpr + "), vary: \"\", headers: [:] }"
}

/// Whether the page dispatches a failure through `uiErrDoc` (a `Result` loader, or
/// a `Validation` loader with a nearest `error.vyx`).
gen fn uiUsesErrDoc(p: UiPageInfo, errorIdx: Int64) -> Bool {
    // A plain loader (RFC-0069 §0) has no failure path, so it never renders an
    // error document.
    if p.loadKind == "plain" {
        return false
    }
    return p.hasLoad && (p.loadKind == "result" || errorIdx >= 0)
}

/// The per-page `uiErrDoc<idx>` function: render a `PageError` through the nearest
/// `error.vyx` (or a built-in body), wrapped in the same layout/head, at the
/// carried status.
gen fn uiEmitErrDoc(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>, errorIdx: Int64) -> String {
    let inner = if errorIdx >= 0 { "uiErrPg" + errorIdx.toString() + ".errorPage(uiPe)" } else { "uiRoutePageError(uiPe)" }
    let bodyExpr = uiWrapLayout(inner, layoutIdxs)
    let headE = uiHeadExpr(layoutIdxs, "")
    let titleE = uiTitleExpr(layoutIdxs, "", "Error")
    let mut out = "fn uiErrDoc" + idx + "(uiPe: PageError) -> Response {\n"
    out = out + "    return Response { status: uiPe.status, contentType: \"text/html\", body: document(" + titleE + ", " + headE + ", " + bodyExpr + "), vary: \"\", headers: [:] }\n}\n"
    return out
}

/// The loader dispatch for a page: run `loadCall` (`p<idx>.load()` or
/// `.load(p)`) and render its outcome. A plain loader (RFC-0069 §0) binds the data
/// and renders (no failure path); a `Result`/`Validation` loader matches its arms,
/// routing a failure to the nearest error page (RFC-0041 §3).
/// The call that produces a page's data: `<runner>(p<idx>.data()[, p])` for a
/// `.vyrn` page, whose `data` member the router runs itself, and `p<idx>.load(…)`
/// for a `.vyx` page, whose synthesized module already wrapped its `data`
/// accessor in exactly that runner call. Both bind the same `d`.
///
/// WHICH runner comes from `data`'s declared return type (RFC-0071 M2b) — the
/// `dataRunner` the contract check resolved — and a `Param*` query is handed the
/// route params, which is why both paths route identically.
gen fn uiLoadCall(p: UiPageInfo, idx: String, args: String) -> String {
    if p.hasData {
        let extra = if p.loadHasParams { ", " + args } else { "" }
        return p.dataRunner + "(p" + idx + ".data()" + extra + ")"
    }
    return "p" + idx + ".load(" + args + ")"
}

gen fn uiEmitLoadDispatch(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>, errorIdx: Int64, loadCall: String) -> String {
    if p.loadKind == "plain" {
        return "    let d = " + loadCall + "\n    return " + uiSuccessResponse(p, idx, layoutIdxs) + "\n}\n"
    }
    let okVar = if p.loadKind == "result" { "Ok" } else { "Valid" }
    let mut out = "    return match " + loadCall + " {\n"
    out = out + "        " + okVar + "(d) => " + uiSuccessResponse(p, idx, layoutIdxs) + ",\n"
    if p.loadKind == "result" {
        out = out + "        Err(uiPe) => uiErrDoc" + idx + "(uiPe),\n"
    } else if errorIdx >= 0 {
        out = out + "        Invalid(issues) => uiErrDoc" + idx + "(uiIssuesToError(issues)),\n"
    } else {
        out = out + "        Invalid(issues) => Response { status: 422, contentType: \"text/html\", body: document(\"Error\", [], uiRouteError(issues)), vary: \"\", headers: [:] },\n"
    }
    out = out + "    }\n}\n"
    return out
}

/// The `uiRender<idx>` function: build `Params`, optionally `load`, then render
/// (wrapping the body in the nearest layout and threading the head, RFC-0041).
gen fn uiEmitRender(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>, errorIdx: Int64) -> String {
    // Parameter list `(v0: <type>, v1: <type>)` matching the dynamic segments.
    let mut params: Array<String> = []
    let mut ai = 0
    while ai < p.dynNames.length {
        params.push("v" + ai.toString() + ": " + p.dynTypes[ai])
        ai = ai + 1
    }
    let mut out = "fn uiRender" + idx + "(" + joinWith(params, ", ") + ") -> Response {\n"

    // Static page (no dynamic segments, no loader): render or respond directly.
    if p.dynNames.length == 0 && p.hasLoad == false {
        if p.hasRespond {
            out = out + "    return p" + idx + ".respond()\n}\n"
        } else {
            out = out + "    return " + uiSuccessResponse(p, idx, layoutIdxs) + "\n}\n"
        }
        return out
    }

    // Static loader page (no dynamic segments, a zero-parameter `load()`,
    // RFC-0069 §0): no `Params`, dispatch the loader directly.
    if p.dynNames.length == 0 && p.hasLoad {
        out = out + uiEmitLoadDispatch(p, idx, layoutIdxs, errorIdx, uiLoadCall(p, idx, ""))
        if uiUsesErrDoc(p, errorIdx) {
            out = out + uiEmitErrDoc(p, idx, layoutIdxs, errorIdx)
        }
        return out
    }

    // A Params value, its fields named by the dynamic segments. A foreign
    // `Params` (RFC-0031) is constructed through its `uiParams<idx>` import
    // alias; a page's own through the `p<idx>` namespace, exactly as before.
    let paramsCtor = if p.paramsModule != "" { "uiParams" + idx } else { "p" + idx + ".Params" }
    out = out + "    let p = " + paramsCtor + " { " + uiParamFieldInits(p.segs) + " }\n"
    if p.hasRespond {
        // A raw-response page owns the whole Response (content-type, status).
        out = out + "    return p" + idx + ".respond(p)\n}\n"
        return out
    }
    if p.hasLoad {
        out = out + uiEmitLoadDispatch(p, idx, layoutIdxs, errorIdx, uiLoadCall(p, idx, "p"))
        if uiUsesErrDoc(p, errorIdx) {
            out = out + uiEmitErrDoc(p, idx, layoutIdxs, errorIdx)
        }
        return out
    }
    // No loader, has params.
    out = out + "    return " + uiSuccessResponse(p, idx, layoutIdxs) + "\n}\n"
    return out
}

// ---- RFC-0069 §2: the data-channel renderers -------------------------------

/// The success data payload expression for a page: `uiDataResponse(uiPayload(id,
/// title, props, params))`, where `title` is the SAME threaded title as SSR, `props`
/// is `toJson(d)` (or `null` with no loader), and `params` is `toJson(p)` for a
/// dynamic route (or `null`). `d`/`p` must be in scope where this is spliced.
gen fn uiDataSuccessBody(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>) -> String {
    let args = uiPageCallArgs(p)
    let pageTitleCall = if p.isVyx { "p" + idx + ".headTitle(" + args + ")" } else { "" }
    let titleE = uiTitleExpr(layoutIdxs, pageTitleCall, p.urlPattern)
    // Props serialize through the page's typed `encodeProps` (RFC-0069 §2) so a
    // match-bound loader result keeps its concrete type for `toJson`.
    let propsE = if p.hasLoad { "p" + idx + ".encodeProps(d)" } else { "\"null\"" }
    let paramsE = if p.dynNames.length > 0 { "toJson(p)" } else { "\"null\"" }
    return "uiDataResponse(uiPayload(" + uiStrLit(uiPageId(p)) + ", " + titleE + ", " + propsE + ", " + paramsE + "))"
}

/// The data-channel loader dispatch: run `loadCall`, answer the success payload, and
/// on failure answer the `@error` payload (a `Result` carries its status; a
/// `Validation` folds to 422). A plain loader has no failure path (RFC-0069 §0).
gen fn uiEmitDataLoadDispatch(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>, loadCall: String) -> String {
    if p.loadKind == "plain" {
        return "    let d = " + loadCall + "\n    return " + uiDataSuccessBody(p, idx, layoutIdxs) + "\n}\n"
    }
    let okVar = if p.loadKind == "result" { "Ok" } else { "Valid" }
    let mut out = "    return match " + loadCall + " {\n"
    out = out + "        " + okVar + "(d) => " + uiDataSuccessBody(p, idx, layoutIdxs) + ",\n"
    if p.loadKind == "result" {
        out = out + "        Err(uiPe) => uiErrorResponseOf(uiPe),\n"
    } else {
        // A `Validation` failure folds to a self-contained 422 error payload (the
        // detailed issue list stays on the SSR/document channel).
        out = out + "        Invalid(issues) => uiDataResponse(uiErrorPayload(422, \"{\\\"status\\\":422,\\\"message\\\":\\\"Unable to load this page\\\"}\")),\n"
    }
    out = out + "    }\n}\n"
    return out
}

/// The `uiRenderData<idx>` function (RFC-0069 §2): build `Params`, run `load` exactly
/// as SSR would, and answer the `{page, title, props[, params]}` JSON payload.
/// Emitted only for client-renderable `.vyx` pages (never a raw-`respond` page).
gen fn uiEmitDataRender(p: UiPageInfo, idx: String, layoutIdxs: Array<Int64>, errorIdx: Int64) -> String {
    let mut params: Array<String> = []
    let mut ai = 0
    while ai < p.dynNames.length {
        params.push("v" + ai.toString() + ": " + p.dynTypes[ai])
        ai = ai + 1
    }
    let mut out = "fn uiRenderData" + idx + "(" + joinWith(params, ", ") + ") -> Response {\n"

    // Static page, no loader: the payload carries an empty props.
    if p.dynNames.length == 0 && p.hasLoad == false {
        out = out + "    return " + uiDataSuccessBody(p, idx, layoutIdxs) + "\n}\n"
        return out
    }
    // Static loader (zero-parameter `load()`, RFC-0069 §0).
    if p.dynNames.length == 0 && p.hasLoad {
        out = out + uiEmitDataLoadDispatch(p, idx, layoutIdxs, uiLoadCall(p, idx, ""))
        return out
    }
    // Dynamic route: build the Params value (its fields the dynamic segments).
    let paramsCtor = if p.paramsModule != "" { "uiParams" + idx } else { "p" + idx + ".Params" }
    out = out + "    let p = " + paramsCtor + " { " + uiParamFieldInits(p.segs) + " }\n"
    if p.hasLoad {
        out = out + uiEmitDataLoadDispatch(p, idx, layoutIdxs, uiLoadCall(p, idx, "p"))
        return out
    }
    // Dynamic, no loader: the payload carries the params only.
    out = out + "    return " + uiDataSuccessBody(p, idx, layoutIdxs) + "\n}\n"
    return out
}

/// The Params record-literal field inits (`id: v0, slug: v1`) for a page's
/// dynamic segments.
gen fn uiParamFieldInits(segs: Array<String>) -> String {
    let mut parts: Array<String> = []
    let mut k = 0
    for s in segs {
        if uiIsDynSeg(s) {
            // The route segment is the render function's to observe, not to keep:
            // a scalar copies to itself (RFC-0089 M1b), so this is free for an
            // `Int64` segment and one `strdup` for a `String` one.
            parts.push(uiDynName(s) + ": v" + k.toString() + ".copy()")
            k = k + 1
        }
    }
    return joinWith(parts, ", ")
}

/// The import line for one page: a namespace import (RFC-0027) binding `p<idx>`.
/// Because none of a page's exports enter the flat namespace, many pages that all
/// export `page`/`Params`/`load`/`Data` coexist with no collision and no aliasing
/// — the namespace replaces the RFC-0022 co-naming dummies this generator used to
/// emit. Each export is reached below as `p<idx>.page`, `p<idx>.Params`, etc.
gen fn uiEmitImport(p: UiPageInfo, idx: String, themed: Bool, theme: String) -> String {
    if p.isVyx {
        // A `.vyx` page (RFC-0039 §4) is synthesized on the fly through a nested
        // `vyxPage`/`vyxPageThemed` generator import; the router reaches its
        // `page`/`Params`/`load`/`Data` through the `p<idx>` namespace exactly as
        // for a `.vyrn` page.
        if themed {
            return "import * as p" + idx + " from vyxPageThemed(" + uiStrLit(p.modPath + ".vyx") + ", " + uiStrLit(theme) + ")\n"
        }
        return "import * as p" + idx + " from vyxPage(" + uiStrLit(p.modPath + ".vyx") + ")\n"
    }
    let mut out = "import * as p" + idx + " from " + uiStrLit(p.modPath) + "\n"
    // A foreign `Params` (declared in a module the page imports, RFC-0031) is not
    // reachable as `p<idx>.Params`; import it directly under a per-page alias.
    if p.paramsModule != "" {
        out = out + "import { Params as uiParams" + idx + " } from " + uiStrLit(p.paramsModule) + "\n"
    }
    return out
}

/// The typed-URL helper for one route: a `href<Route>(…)` for a dynamic route, a
/// `<route>Path()` for a static one. Both return the validated `RoutePath`.
gen fn uiEmitTypedUrl(p: UiPageInfo) -> String {
    if p.dynNames.length > 0 {
        let mut params: Array<String> = []
        let mut k = 0
        for s in p.segs {
            if uiIsDynSeg(s) {
                params.push(uiDynName(s) + ": " + p.dynTypes[k])
                k = k + 1
            }
        }
        return "export fn " + uiHelperNameOf(p) + "(" + joinWith(params, ", ") + ") -> RoutePath {\n    return " + uiDynHelperBody(p.segs, p.dynTypes) + "\n}\n"
    }
    return "export fn " + uiHelperNameOf(p) + "() -> RoutePath {\n    return " + uiStrLit(uiUrlPatternOf(p.segs)) + "\n}\n"
}

/// Whether any page in the set has a `String` dynamic segment — the one thing
/// that puts the URL codec on both sides of the router (`urlEncode` in the helper,
/// `urlDecode` in the try fn).
gen fn uiAnyStrSeg(pages: Array<UiPageInfo>) -> Bool {
    for p in pages {
        for t in p.dynTypes {
            if t == "String" {
                return true
            }
        }
    }
    return false
}

/// Whether any page in the set is a `.vyx` page (so the router imports the
/// `.vyx`-page generator from std/vyx).
gen fn uiAnyVyx(pages: Array<UiPageInfo>) -> Bool {
    for p in pages {
        if p.isVyx {
            return true
        }
    }
    return false
}

/// The comma-joined `std/vyx` generator import list a router needs: the page
/// generator when any `.vyx` page exists, plus the layout/error generators when
/// there is chrome. "" when the router imports no `std/vyx` generator.
gen fn uiVyxGenImports(pages: Array<UiPageInfo>, layouts: Array<UiChrome>, errors: Array<UiChrome>, themed: Bool) -> String {
    let mut gens: Array<String> = []
    if uiAnyVyx(pages) {
        gens.push(if themed { "vyxPageThemed" } else { "vyxPage" })
    }
    if layouts.length > 0 {
        gens.push(if themed { "vyxLayoutThemed" } else { "vyxLayout" })
    }
    if errors.length > 0 {
        gens.push(if themed { "vyxErrorThemed" } else { "vyxError" })
    }
    if gens.length == 0 {
        return ""
    }
    return "import { " + joinWith(gens, ", ") + " } from \"std/vyx\"\n"
}

/// The nested chrome import for one layout/error `.vyx` (bound `uiLay<n>` /
/// `uiErrPg<n>`), themed or not.
gen fn uiEmitChromeImport(alias: String, modPath: String, gen: String, themed: Bool, theme: String) -> String {
    let arg = uiStrLit(modPath + ".vyx")
    if themed {
        return "import * as " + alias + " from " + gen + "(" + arg + ", " + uiStrLit(theme) + ")\n"
    }
    return "import * as " + alias + " from " + gen + "(" + arg + ")\n"
}

/// Assemble the whole synthesized router module from the collected pages and
/// chrome (`layout.vyx`/`error.vyx`, RFC-0041). When `themed` (RFC-0036/0039 §4),
/// `.vyx` pages/layouts/errors compile their classes against `theme`.
gen fn uiBuildModule(pages: Array<UiPageInfo>, layouts: Array<UiChrome>, errors: Array<UiChrome>, themed: Bool, theme: String) -> String {
    let mut out = "/// Generated by std/ui `pages` (RFC-0026 M3, RFC-0039 §4, RFC-0041) — do not edit.\n"
    out = out + "import { el, text, empty, document, toHtmlString, Html, Attr } from \"std/html\"\n"
    out = out + "import { Route, httpRoute, GET } from \"std/http\"\n"
    out = out + uiVyxGenImports(pages, layouts, errors, themed)

    // Per-page namespace imports (RFC-0027): each page module is bound as
    // `p<idx>`, so same-named exports across pages never collide in the flat
    // namespace and no co-naming dummies are needed.
    let mut i = 0
    while i < pages.length {
        out = out + uiEmitImport(pages[i], i.toString(), themed, theme)
        i = i + 1
    }
    // Chrome imports (RFC-0041): layouts as `uiLay<n>`, error pages as `uiErrPg<n>`.
    let layGen = if themed { "vyxLayoutThemed" } else { "vyxLayout" }
    let errGen = if themed { "vyxErrorThemed" } else { "vyxError" }
    let mut li = 0
    while li < layouts.length {
        out = out + uiEmitChromeImport("uiLay" + li.toString(), layouts[li].modPath, layGen, themed, theme)
        li = li + 1
    }
    let mut ei = 0
    while ei < errors.length {
        out = out + uiEmitChromeImport("uiErrPg" + ei.toString(), errors[ei].modPath, errGen, themed, theme)
        ei = ei + 1
    }

    // Whether the router threads a head/layout (any page needs it) and whether any
    // page dispatches through `uiErrDoc` (gating the shared error/head helpers +
    // the `PageError` import so a router without them stays minimal).
    let mut anyThreading = false
    let mut anyErrDoc = false
    // RFC-0069 §2: whether any page is client-renderable (a `.vyx` page), gating the
    // whole data channel. A router of only `.vyrn`/`respond` pages emits exactly the
    // pre-RFC module (byte-identical), so nothing without client pages is disturbed.
    let mut anyClientPage = false
    // RFC-0071: whether any page supplies the `data` member directly, so the
    // router runs its query. A router of only `.vyx` pages (whose modules present
    // an already-wrapped `load()`) imports no runners at all.
    let mut anyQuery = false
    // The distinct runners the routed pages need, in first-use order — a router
    // imports exactly the ones its pages' declared query types name (RFC-0071 M2b).
    let mut runners: Array<String> = []
    i = 0
    while i < pages.length {
        let lidx = uiLayoutChain(pages[i], layouts)
        let eidx = uiErrorIndex(pages[i], errors)
        if uiNeedsThreading(pages[i], lidx) {
            anyThreading = true
        }
        if uiUsesErrDoc(pages[i], eidx) {
            anyErrDoc = true
        }
        if uiClientRenderable(pages[i]) {
            anyClientPage = true
        }
        if pages[i].hasData {
            anyQuery = true
            if includes(runners, pages[i].dataRunner) == false {
                runners.push(pages[i].dataRunner.copy())
            }
        }
        i = i + 1
    }
    if anyErrDoc {
        out = out + "import { PageError } from \"std/ui\"\n"
    }
    if anyQuery {
        out = out + "import { " + joinWith(runners, ", ") + " } from \"std/ui\"\n"
    }
    if anyClientPage {
        out = out + "import { uiWantsData, uiPayload, uiErrorPayload, uiDataResponse, uiDataMiss, uiErrorResponseOf } from \"std/ui\"\n"
    }
    // The URL boundary's two halves, imported only where a `String` segment makes
    // them reachable: `urlEncode` in the typed-URL helper, `urlDecode` in the try
    // fn. A router of only static and `Int64` routes converts nothing (an integer's
    // spelling is already unreserved) and is emitted exactly as it was before.
    if uiAnyStrSeg(pages) {
        out = out + "import { urlDecode, urlEncode } from \"std/codecs\"\n"
    }

    // Segment parsing for `Int64` dynamic params.
    out = out + "type UiRouteInt = Int64\n"

    // RoutePath — the regex-validated string of the whole route language.
    out = out + "export type RoutePath = String where value =~ \"("
    i = 0
    while i < pages.length {
        if i > 0 {
            out = out + "|"
        }
        out = out + uiRoutePathBranch(pages[i].segs, pages[i].dynTypes)
        i = i + 1
    }
    out = out + ")\"\n"

    // Typed-URL helpers.
    i = 0
    while i < pages.length {
        out = out + uiEmitTypedUrl(pages[i])
        i = i + 1
    }

    // The fixed runtime + the RFC-0041 conditional helpers.
    out = out + uiFixedRuntime()
    if anyThreading {
        out = out + uiHeadRuntime()
    }
    if anyErrDoc {
        out = out + uiErrorRuntime()
    }
    // Per-page try/render pairs, each with its nearest layout chain + error page.
    i = 0
    while i < pages.length {
        let lidx = uiLayoutChain(pages[i], layouts)
        let eidx = uiErrorIndex(pages[i], errors)
        out = out + uiEmitRoute(pages[i], i, lidx, eidx)
        i = i + 1
    }
    // Data-channel try/render pairs (RFC-0069 §2), for client-renderable pages only.
    if anyClientPage {
        i = 0
        while i < pages.length {
            if uiClientRenderable(pages[i]) {
                let lidx = uiLayoutChain(pages[i], layouts)
                let eidx = uiErrorIndex(pages[i], errors)
                out = out + uiEmitDataRoute(pages[i], i, lidx, eidx)
            }
            i = i + 1
        }
    }

    // route(): static routes first, then dynamic, first hit wins. The normal HTML
    // dispatch (`hit`) runs identically whichever representation was asked for; only
    // a request that NEGOTIATED JSON (RFC-0072 M4) additionally consults the data
    // channel and, when it renders a client page, answers JSON instead — a document
    // request is byte-identical to what it was before negotiation existed.
    out = out + "export fn route(req: Request) -> Response {\n"
    out = out + "    let segs = uiRouteSegments(req.path)\n"
    out = out + "    let mut hit: Option<Response> = None\n"
    for order in uiDispatchOrder(pages) {
        out = out + "    if uiRouteNone(hit) {\n        hit = uiTry" + order.toString() + "(segs)\n    }\n"
    }
    if anyClientPage {
        out = out + "    if uiWantsData(req) {\n"
        out = out + "        let mut dhit: Option<Response> = None\n"
        for order in uiDispatchOrder(pages) {
            if uiClientRenderable(pages[order]) {
                out = out + "        if uiRouteNone(dhit) {\n            dhit = uiTryData" + order.toString() + "(segs)\n        }\n"
            }
        }
        // A client page → JSON payload. A valid non-client route (a `.vyrn`/respond
        // page) → its real Response (non-JSON, so the client hard-navs). A true miss
        // → the `@error` payload (client renders the themed error page).
        out = out + "        return match consume dhit {\n            Some(r) => r,\n            None => match consume hit {\n                Some(r) => r,\n                None => uiDataMiss(),\n            },\n        }\n    }\n"
    }
    out = out + "    return match consume hit {\n        Some(r) => r,\n        None => uiRouteNotFound(),\n    }\n}\n"
    return out + uiEmitMountable(pages)
}

/// The page tree as something `mount` can take (RFC-0074's composition root), and
/// as rows in `vyrn routes`.
///
/// A page router was left out of both for one stated reason: it "always answers",
/// so it could only ever be a bare prefix — and a prefix is the one row the table
/// skips, because a prefix stands for a subsystem something else enumerates. For
/// pages nothing did. This enumerates them.
///
/// What always answers is the tree's 404, not its pages. Split the two and a page
/// is an ordinary route: it matches one pattern and declines everything else, so
/// it obeys `mount`'s ordering rules and `httpCheckMount` can finally see a page
/// path shadowing an API path (or the reverse). The 404 stays where it already
/// was — the composition root's `None` arm, which is what a fallback IS.
///
/// Every route delegates to `route` rather than to its own `uiTry<n>`: the
/// enumeration is for matching and for the table, and the dispatch — content
/// negotiation, the layout chain, the error page — stays in the one place that
/// has it. They are emitted in `uiDispatchOrder` so `mount`'s first-match and
/// `route`'s internal static-before-dynamic order cannot disagree.
///
/// The `//@route` directives beside them are the SAME channel `std/rpc` emits on,
/// and carry the same assumption: `std/rpc` says `POST /_/pastes/create` because
/// the root mounts it at `/_`, and this says `GET /p/{id}` because a page tree is
/// mounted whole or not at all. `source` is `convention` because the file tree
/// derived the path — nobody wrote it down.
gen fn uiEmitMountable(pages: Array<UiPageInfo>) -> String {
    let mut out = ""
    for order in uiDispatchOrder(pages) {
        out = out + "//@route GET " + uiWirePatternOf(pages[order].segs) + " " + uiPageKeyOf(pages[order].segs) + " convention\n"
    }
    out = out + render(vyrn"""fn uiPageRun(req: Request, ps: Map<String, String>) -> Option<Response> {
    return Some(route(req))
}
""")
    out = out + "export fn routes() -> Array<Route> {\n    return [\n"
    for order in uiDispatchOrder(pages) {
        let pat = uiStrLit(uiWirePatternOf(pages[order].segs))
        out = out + "        GET(httpRoute(" + pat + ", uiPageRun, " + uiStrLit(uiPageKeyOf(pages[order].segs)) + ")),\n"
    }
    return out + "    ]\n}\n"
}

/// The page indices ordered for dispatch: fewer dynamic segments first, so a
/// fully-static route always wins over a dynamic one at the same depth. Pure (no
/// comptime builtins), so the client/server parity test below can walk it.
fn uiDispatchOrder(pages: Array<UiPageInfo>) -> Array<Int64> {
    let mut order: Array<Int64> = []
    let mut want = 0
    let mut maxDyn = 0
    for p in pages {
        if p.dynNames.length > maxDyn {
            maxDyn = p.dynNames.length
        }
    }
    while want <= maxDyn {
        let mut i = 0
        while i < pages.length {
            if pages[i].dynNames.length == want {
                order.push(i)
            }
            i = i + 1
        }
        want = want + 1
    }
    return order
}

// ===========================================================================
// The generator.
// ===========================================================================

/// `pages(dir)` — scan `dir` for page modules (`.vyrn` and, RFC-0039 §4, `.vyx`)
/// and synthesize the router module.
export gen fn pages(dir: String) -> String {
    let scan = uiScanAll(dir, [])
    let infos = scan.pages
    if infos.length == 0 {
        if scan.err != "" {
            return reportHere(Error, "std/ui cannot read `\{dir}`: \{scan.err}")
        }
        return reportHere(
            Error,
            "no page modules under `\{dir}` — a page is a `.vyrn` or `.vyx` file in that directory, and its path is its route",
        )
    }
    let mut err = scan.err
    for p in infos {
        err = err + p.err
    }
    err = err + uiCollisionErrors(infos)
    if err != "" {
        return err
    }
    return uiBuildModule(infos, scan.layouts, scan.errors, false, "")
}

/// `pagesThemed(dir, theme)` (RFC-0036/0039 §4) — like `pages`, but every `.vyx`
/// page in `dir` compiles its template classes against `theme` (a static class is
/// proven `⊆ Tw` at compile time, a dynamic one coerces at runtime). `.vyrn` pages
/// are unaffected. `theme` resolves relative to the importing module, like `dir`.
export gen fn pagesThemed(dir: String, theme: String) -> String {
    let scan = uiScanAll(dir, [])
    let infos = scan.pages
    if infos.length == 0 {
        if scan.err != "" {
            return reportHere(Error, "std/ui cannot read `\{dir}`: \{scan.err}")
        }
        return reportHere(
            Error,
            "no page modules under `\{dir}` — a page is a `.vyrn` or `.vyx` file in that directory, and its path is its route",
        )
    }
    let mut err = scan.err
    for p in infos {
        err = err + p.err
    }
    err = err + uiCollisionErrors(infos)
    if err != "" {
        return err
    }
    return uiBuildModule(infos, scan.layouts, scan.errors, true, theme)
}

// ===========================================================================
// The client page bundle (RFC-0069 §1) — the CLIENT counterpart of `pages`. It
// scans the SAME `routes/` tree and synthesizes a module the wasm client bundle
// imports: one client page module per `.vyx` page (the view fn + `clientRender`
// host entry, `load` and its dead imports stripped by `vyxPageClient(Themed)`), a
// route table keyed by url pattern, and `renderPage(payloadJson) -> String`. On a
// soft nav the host fetches `{page, title, props}` (plus `params` for a dynamic
// route), and `renderPage` dispatches on `page`, hands the props/params JSON to the
// matching page's `clientRender`, and returns the `std/html` tree as JSON for
// `vyrn-dom`. An unknown page — or any decode miss — returns the sentinel
// `"__vyrn_fallback__"`, so the host degrades to the v2 HTML swap. The LAYOUT is not
// bundled (the shell's DOM persists; nav swaps `<main>` only).
// ===========================================================================

/// A page's stable client id — its url pattern (`/`, `/about`, `/p/:id`). The
/// server's payload marks each response with the same id (M2), so client and server
/// agree without a separate registry.
gen fn uiPageId(p: UiPageInfo) -> String {
    return p.urlPattern.copy()
}

/// Whether a page is client-renderable: a `.vyx` page rendered through `page` (a
/// `.vyrn` page or a raw-`respond` page is not in the client bundle — a soft nav to
/// it falls back to the v2 HTML swap).
gen fn uiClientRenderable(p: UiPageInfo) -> Bool {
    return p.isVyx && p.hasRespond == false
}

/// The client page import for one page (bound `p<idx>`), themed or not.
gen fn uiClientPageImport(p: UiPageInfo, idx: String, themed: Bool, theme: String) -> String {
    if themed {
        return "import * as p" + idx + " from vyxPageClientThemed(" + uiStrLit(p.modPath + ".vyx") + ", " + uiStrLit(theme) + ")\n"
    }
    return "import * as p" + idx + " from vyxPageClient(" + uiStrLit(p.modPath + ".vyx") + ")\n"
}

/// The fixed JSON-field runtime shared by every client bundle: pull a named field
/// out of a parsed payload object, and read one as a String.
gen fn uiClientRuntime() -> String {
    return render(vyrn"""fn uiClientFieldIn(fs: Array<JsonField>, key: String) -> Json {
    for f in fs {
        if f.key == key {
            return copyJson(f.value)
        }
    }
    return JNull
}
fn uiClientField(j: Json, key: String) -> Json {
    return match j {
        JObj(fs) => uiClientFieldIn(fs, key),
        JNull => JNull,
        JBool(uiB) => JNull,
        JNum(uiN) => JNull,
        JStr(uiS) => JNull,
        JArr(uiA) => JNull,
    }
}
fn uiClientStr(j: Json, key: String) -> String {
    return match uiClientField(j, key) {
        JStr(uiS) => uiS,
        JNull => "",
        JBool(uiB) => "",
        JNum(uiN) => "",
        JArr(uiA) => "",
        JObj(uiO) => "",
    }
}
fn uiClientSlice(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut acc: Array<UInt8> = []
    let mut i = s
    while i < e {
        acc.push(ba[i])
        i = i + 1
    }
    return match stringFromBytes(acc) {
        Ok(v) => v,
        Err(err) => "",
    }
}
fn uiClientSegments(path: String) -> Array<String> {
    let ba = bytes(path)
    let mut segs: Array<String> = []
    let mut start = 0
    let mut i = 0
    let mut stop = ba.length
    while i < ba.length {
        if ba[i] == '?' {
            stop = i
            i = ba.length
        } else {
            i = i + 1
        }
    }
    i = 0
    while i < stop {
        if ba[i] == '/' {
            if i > start {
                segs.push(uiClientSlice(ba, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if stop > start {
        segs.push(uiClientSlice(ba, start, stop))
    }
    return segs
}
type UiResolved = { found: Bool, hasData: Bool, lazy: Bool, page: String, title: String }
fn uiResolveHit(hasData: Bool, lazy: Bool, page: String, title: String) -> String {
    return toJson(UiResolved { found: true, hasData: hasData, lazy: lazy, page: page.copy(), title: title.copy() })
}
fn uiResolveMiss() -> String {
    return toJson(UiResolved { found: false, hasData: false, lazy: false, page: "", title: "" })
}
fn uiClientBool(j: Json, key: String) -> Bool {
    return match uiClientField(j, key) {
        JBool(uiB) => uiB,
        JNull => false,
        JNum(uiN) => false,
        JStr(uiS) => false,
        JArr(uiA) => false,
        JObj(uiO) => false,
    }
}
fn uiClientIsLoading(uiJ: Json) -> Bool {
    return uiClientBool(uiClientField(uiJ, "props"), "__loading__")
}
""")
}

/// The per-page path matcher `uiClientMatch<idx>(segs) -> Bool` (RFC-0069 M4): the
/// segment count plus every literal segment, mirroring the server's `uiTryData`
/// routing. Dynamic segments accept any non-empty value (the client bundle only
/// decides found/hasData; a data page's marker fetch re-runs the server's exact
/// Int-parse routing, and a static dataless page has no dynamic segment to disagree
/// on), so no per-type parse is duplicated here.
gen fn uiClientMatchFn(p: UiPageInfo, idx: String) -> String {
    let mut out = "fn uiClientMatch" + idx + "(segs: Array<String>) -> Bool {\n"
    out = out + "    if segs.length != " + p.segs.length.toString() + " {\n        return false\n    }\n"
    let mut i = 0
    for s in p.segs {
        if uiIsDynSeg(s) == false {
            out = out + "    if segs[" + i.toString() + "] != " + uiStrLit(s) + " {\n        return false\n    }\n"
        }
        i = i + 1
    }
    out = out + "    return true\n}\n"
    return out
}

/// The client-side title expression for `resolvePage` (RFC-0069 M4). A loader page's
/// title depends on the loaded data and travels in the payload the client fetches, so
/// it resolves to "" (unused). A STATIC dataless page reads its own `headTitle()` (""
/// when it declares no title block, so the host keeps the layout default rather than
/// the url-pattern placeholder). A dynamic dataless page would need its Params built
/// from the path first, so it also resolves to "" (its render falls back if needed).
gen fn uiResolveTitleExpr(p: UiPageInfo, idx: String) -> String {
    if p.hasLoad == false && p.dynNames.length == 0 {
        return "p" + idx + ".headTitle()"
    }
    return "\"\""
}

/// The `resolvePage(path) -> String` export (RFC-0069 M4): match `path` against the
/// client route table WITHOUT a network round-trip, answering
/// `{found, hasData, page, title}` JSON. The host uses `hasData` to decide the nav:
/// a dataless page renders immediately (zero fetch), a data page fetches its payload,
/// an unmatched path falls through to the v2 HTML swap.
gen fn uiEmitResolvePage(pages: Array<UiPageInfo>) -> String {
    let mut out = ""
    let mut i = 0
    while i < pages.length {
        if uiClientRenderable(pages[i]) {
            out = out + uiClientMatchFn(pages[i], i.toString())
        }
        i = i + 1
    }
    out = out + "export fn resolvePage(path: String) -> String {\n"
    out = out + "    let segs = uiClientSegments(path)\n"
    // The server dispatches static-before-dynamic (`route` walks
    // `uiDispatchOrder`); the client match chain walks the SAME order, or a
    // catch-all `[slug].vyx` listed before `about.vyx` would answer a soft nav
    // to /about while the server renders the static page.
    for order in uiDispatchOrder(pages) {
        if uiClientRenderable(pages[order]) {
            let idx = order.toString()
            let hd = if pages[order].hasLoad { "true" } else { "false" }
            // RFC-0070: `lazy` tells the navigator to paint the skeleton instantly
            // (then fetch + fill), vs a blocking data fetch for a non-lazy data page.
            let lz = if pages[order].loadLazy { "true" } else { "false" }
            out = out + "    if uiClientMatch" + idx + "(segs) {\n        return uiResolveHit(" + hd + ", " + lz + ", " + uiStrLit(uiPageId(pages[order])) + ", " + uiResolveTitleExpr(pages[order], idx) + ")\n    }\n"
        }
    }
    out = out + "    return uiResolveMiss()\n}\n"
    return out
}

/// Assemble the client bundle module from the scanned pages + error chrome.
gen fn uiBuildClientModule(pages: Array<UiPageInfo>, errors: Array<UiChrome>, themed: Bool, theme: String) -> String {
    let mut out = "/// Generated by std/ui `pagesClient` (RFC-0069 §1) — do not edit.\n"
    out = out + "import { emit, Json, JsonField, copyJson } from \"std/json\"\n"
    out = out + "import { parseJson } from \"std/jsonread\"\n"
    out = out + "import { " + (if themed { "vyxPageClientThemed" } else { "vyxPageClient" }) + " } from \"std/vyx\"\n"
    let hasErr = errors.length > 0
    if hasErr {
        out = out + "import { " + (if themed { "vyxErrorThemed" } else { "vyxError" }) + " } from \"std/vyx\"\n"
        out = out + "import { PageError } from \"std/ui\"\n"
    }

    // Per-page client imports (renderable pages only).
    let mut i = 0
    while i < pages.length {
        if uiClientRenderable(pages[i]) {
            out = out + uiClientPageImport(pages[i], i.toString(), themed, theme)
        }
        i = i + 1
    }
    // The error page (RFC-0041 §3) — reused directly (it is a pure `.vyx`, no
    // loader/imports to strip). bin has one; a nested error tree would need the
    // payload to name which error page (out of scope — the root error is used).
    if hasErr {
        out = out + uiEmitChromeImport("uiErrPg0", errors[0].modPath, if themed { "vyxErrorThemed" } else { "vyxError" }, themed, theme)
    }

    out = out + uiClientRuntime()

    // renderPage: parse the payload, dispatch on `page`.
    out = out + "export fn renderPage(payloadJson: String) -> String {\n"
    out = out + "    return match parseJson(payloadJson) {\n        Ok(uiJ) => uiClientDispatch(uiJ),\n        Err(uiE) => \"__vyrn_fallback__\",\n    }\n}\n"
    out = out + "fn uiClientDispatch(uiJ: Json) -> String {\n"
    out = out + "    let uiPage = uiClientStr(uiJ, \"page\")\n"
    out = out + "    let uiProps = emit(uiClientField(uiJ, \"props\"))\n"
    out = out + "    let uiPrms = emit(uiClientField(uiJ, \"params\"))\n"
    if hasErr {
        out = out + "    if uiPage == \"@error\" {\n"
        out = out + "        return match fromJson(PageError, uiProps) {\n            Valid(uiPe) => toJson(uiErrPg0.errorPage(uiPe)),\n            Invalid(uiI) => \"__vyrn_fallback__\",\n        }\n    }\n"
    }
    i = 0
    while i < pages.length {
        if uiClientRenderable(pages[i]) {
            let pidx = i.toString()
            out = out + "    if uiPage == " + uiStrLit(uiPageId(pages[i])) + " {\n"
            // RFC-0070: a lazy page's payload may carry the `{"__loading__":true}`
            // props sentinel (the host's instant skeleton paint) — render the
            // `Loading` view; a real props object renders `Ready(props)`.
            if pages[i].loadLazy {
                out = out + "        if uiClientIsLoading(uiJ) {\n            return p" + pidx + ".clientRenderLoading(uiPrms)\n        }\n"
            }
            out = out + "        return p" + pidx + ".clientRender(uiProps, uiPrms)\n    }\n"
        }
        i = i + 1
    }
    out = out + "    return \"__vyrn_fallback__\"\n}\n"

    // RFC-0069 M4: the host resolves a nav target against the bundle FIRST (found /
    // hasData / title), so a dataless page navigates with ZERO fetch.
    out = out + uiEmitResolvePage(pages)
    return out
}

/// `pagesClient(dir)` — synthesize the CLIENT page bundle from `dir` (RFC-0069 §1).
export gen fn pagesClient(dir: String) -> String {
    let scan = uiScanAll(dir, [])
    let infos = scan.pages
    if infos.length == 0 {
        if scan.err != "" {
            return reportHere(Error, "std/ui cannot read `\{dir}`: \{scan.err}")
        }
        return reportHere(
            Error,
            "no page modules under `\{dir}` — a page is a `.vyrn` or `.vyx` file in that directory, and its path is its route",
        )
    }
    let mut err = scan.err
    for p in infos {
        err = err + p.err
    }
    err = err + uiCollisionErrors(infos)
    if err != "" {
        return err
    }
    return uiBuildClientModule(infos, scan.errors, false, "")
}

/// `pagesClientThemed(dir, theme)` — the themed client bundle (RFC-0069 §1); the
/// server side uses `pagesThemed`, this its client counterpart.
export gen fn pagesClientThemed(dir: String, theme: String) -> String {
    let scan = uiScanAll(dir, [])
    let infos = scan.pages
    if infos.length == 0 {
        if scan.err != "" {
            return reportHere(Error, "std/ui cannot read `\{dir}`: \{scan.err}")
        }
        return reportHere(
            Error,
            "no page modules under `\{dir}` — a page is a `.vyrn` or `.vyx` file in that directory, and its path is its route",
        )
    }
    let mut err = scan.err
    for p in infos {
        err = err + p.err
    }
    err = err + uiCollisionErrors(infos)
    if err != "" {
        return err
    }
    return uiBuildClientModule(infos, scan.errors, true, theme)
}

// ===========================================================================
// Tests — the pure helpers are covered without file I/O by feeding them strings.
// ===========================================================================

test "route segments and dynamic detection" {
    assertEq(uiUrlPatternOf(["users", "[id]"]), "/users/:id")
    assertEq(uiCollisionKey(["users", "[id]"]), "/users/:")
    assert(uiIsDynSeg("[id]"))
    assertEq(uiDynName("[id]"), "id")
    assertEq(uiRoutePathBranch(["users", "[id]"], ["Int64"]), "/users/(0|-?[1-9][0-9]*)")
    assertEq(uiRoutePathBranch(["p", "[id]"], ["String"]), "/p/([A-Za-z0-9._~-]|%[0-9A-Fa-f][0-9A-Fa-f])+")
    assertEq(uiRoutePathBranch([], []), "/")
    // The mounted spelling: `std/http` placeholders, whole path, and the page's
    // own place in the tree as the name the wire table prints for it.
    assertEq(uiWirePatternOf(["users", "[id]"]), "/users/{id}")
    assertEq(uiWirePatternOf(["raw", "[id]"]), "/raw/{id}")
    assertEq(uiWirePatternOf([]), "/")
    assertEq(uiPageKeyOf(["p", "[id]"]), "p/[id]")
    assertEq(uiPageKeyOf([]), "index")
}

test "String param types are supported and shape their segment regex" {
    assert(uiSupportedParamType("String"))
    assert(uiSupportedParamType("Int64"))
    assertEq(uiSupportedParamType("Float64"), false)
    // The `String` language is `urlEncode`'s output alphabet, not "any byte but a
    // slash": a raw space or a bare `%` is not a URL and no longer type-checks as
    // one.
    assertEq(uiSegRegex("String"), "([A-Za-z0-9._~-]|%[0-9A-Fa-f][0-9A-Fa-f])+")
    assertEq(uiSegRegex("Int64"), "(0|-?[1-9][0-9]*)")
}

test "uiSplitFields is brace-aware for nested-record field types" {
    let f = uiParseFields("type Params = { id: String, meta: { x: Int64, y: Int64 } }")
    assertEq(f.names.length, 2)
    assertEq(f.names[0], "id")
    assertEq(f.names[1], "meta")
    assertEq(f.types[1], "{ x: Int64, y: Int64 }")
}

test "typed-URL helper names and bodies" {
    assertEq(uiStaticHelperName([]), "rootPath")
    assertEq(uiStaticHelperName(["items"]), "itemsPath")
    assertEq(uiDynHelperName(["users", "[id]"]), "hrefUsers")
    // An `Int64` hole is the bare parameter; a `String` hole is the parameter
    // through `urlEncode`, because the helper writes a path segment and the caller
    // hands it a value.
    assertEq(uiDynHelperBody(["users", "[id]"], ["Int64"]), "\"/users/" + uiHole("id") + "\"")
    assertEq(uiDynHelperBody(["tags", "[name]"], ["String"]), "\"/tags/" + uiHole("urlEncode(name)") + "\"")
}

test "a slug converts to an identifier, and an alphanumeric slug is unchanged" {
    // The conversion: non-alphanumeric runs are word breaks, later words capitalise.
    assertEq(uiSegIdent("about-us"), "aboutUs")
    assertEq(uiSegIdent("sign-in"), "signIn")
    assertEq(uiSegIdent("terms-of-service"), "termsOfService")
    assertEq(uiSegIdent("a.b"), "aB")
    assertEq(uiSegIdent("2fa"), "2fa")
    // An already-alphanumeric slug passes through byte for byte, so no existing
    // route's helper name moves.
    assertEq(uiSegIdent("items"), "items")
    assertEq(uiSegIdent("philosophy"), "philosophy")
    assertEq(uiSegIdent("guide"), "guide")
}

test "an awkward slug still makes a legal helper name" {
    assertEq(uiStaticHelperName(["about-us"]), "aboutUsPath")
    assertEq(uiStaticHelperName(["items", "sub-page"]), "itemsSubPagePath")
    // A digit-leading name is impossible to capitalise out of, so it takes a `_`.
    assertEq(uiStaticHelperName(["2fa"]), "_2faPath")
    // A reserved word needs no handling: the mandatory affix means the name can
    // never come out equal to a keyword.
    assertEq(uiStaticHelperName(["return"]), "returnPath")
    assertEq(uiDynHelperName(["sign-in", "[token]"]), "hrefSignIn")
}

test "two slugs may reach one helper name — that is the collision to report" {
    assertEq(uiStaticHelperName(["about-us"]), uiStaticHelperName(["aboutUs"]))
}

test "record-field parsing pulls names and types" {
    let f = uiParseFields("export type Params = { id: Int64, slug: String }")
    assertEq(f.names.length, 2)
    assertEq(f.names[0], "id")
    assertEq(f.types[0], "Int64")
    assertEq(f.names[1], "slug")
    assertEq(f.types[1], "String")
    assert(uiSupportedParamType("Int64"))
    assert(uiSupportedParamType("String"))
    assertEq(uiSupportedParamType("Float64"), false)
}

test "uiStem and route mapping" {
    assertEq(uiStem("index.vyrn"), "index")
    assertEq(uiStem("[id].vyrn"), "[id]")
    assertEq(uiRouteSegsFor(["items"], "index").length, 1)
    assertEq(uiRouteSegsFor(["items"], "[id]").length, 2)
}

test "dispatch order answers a static route before a catch-all at the same depth" {
    // The server router (`route`), the wire table (`routes()`) and — since the
    // client bundle learned the same rule — the `resolvePage` match chain all
    // walk this ONE order. `[slug].vyx` typically lists before `about.vyx`, so
    // raw listDir order would let the catch-all shadow /about on a soft nav
    // while the server renders the static page.
    let about = UiPageInfo { modPath: "routes/about", segs: ["about"], urlPattern: "/about", dynNames: [], dynTypes: [], hasLoad: false, hasData: false, dataRunner: "", loadHasParams: false, loadLazy: false, hasRespond: false, isVyx: true, pageArity: 0, paramsModule: "", dirPrefix: [], loadKind: "", layoutNone: false, err: "" }
    let catchAll = UiPageInfo { modPath: "routes/[slug]", segs: ["[slug]"], urlPattern: "/:slug", dynNames: ["slug"], dynTypes: ["String"], hasLoad: false, hasData: false, dataRunner: "", loadHasParams: false, loadLazy: false, hasRespond: false, isVyx: true, pageArity: 0, paramsModule: "", dirPrefix: [], loadKind: "", layoutNone: false, err: "" }
    let order = uiDispatchOrder([catchAll, about])
    assertEq(order.length, 2)
    assertEq(order[0], 1)
    assertEq(order[1], 0)
}
