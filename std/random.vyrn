/// std/random: deterministic pseudo-randomness with a host-seeded escape.
///
/// The generator is a value (`Rng`): each draw returns the value and the
/// advanced `Rng`, so a seeded run reproduces on every engine. There is no
/// ambient `random()`; `randomSeed` is the one host effect. The algorithm is
/// SplitMix64. It is not cryptographic: use it for shuffles, sampling and
/// tests, not for secrets.

/// PRNG state. Copy it to fork a reproducible stream.
export type Rng = { state: UInt64 }

/// One draw: the value and the advanced generator.
export type Draw = { value: Int64, rng: Rng }

/// The host CSPRNG; honours `VYRN_FIXED_SEED` under the parity harness.
extern fn hostRandomSeed() -> Int64

/// An unpredictable seed from the host CSPRNG. A host effect, so generators and
/// comptime code cannot call it.
export fn randomSeed() -> Int64 {
    return hostRandomSeed()
}

/// A generator seeded by any `Int64`. SplitMix64 has no bad states, so the
/// seed's bit pattern is the initial state.
export fn seededRng(seed: Int64) -> Rng {
    return Rng { state: UInt64(seed) }
}

/// Advances the generator once: `value` covers the full `Int64` range. Pure, so
/// generators and comptime code can call it.
export fn nextInt(rng: Rng) -> Draw {
    // Each constant exceeds `Int64`'s maximum, so it needs an explicit `UInt64`
    // binding.
    let gamma: UInt64 = 11400714819323198485 // 0x9E3779B97F4A7C15
    let c1: UInt64 = 13787848793156543929 // 0xBF58476D1CE4E5B9
    let c2: UInt64 = 10723151780598845931 // 0x94D049BB133111EB
    let s = rng.state + gamma
    let mut z: UInt64 = s
    z = (z ^ (z >> 30)) * c1
    z = (z ^ (z >> 27)) * c2
    z = z ^ (z >> 31)
    return Draw { value: Int64(z), rng: Rng { state: s } }
}

/// A draw in the inclusive range `[lo, hi]`, or `lo` if the range is empty.
/// Modulo reduction, so a very wide range has a slight low bias.
///
/// The span is `UInt64` because `hi - lo + 1` reaches 2^64. That wraps to 0,
/// which means the full range: every draw lands inside it and the reduction is
/// skipped.
export fn nextInRange(rng: Rng, lo: Int64, hi: Int64) -> Draw {
    if hi <= lo {
        return Draw { value: lo, rng: rng }
    }
    let span: UInt64 = (UInt64(hi) - UInt64(lo)) + 1
    let d = nextInt(rng)
    // The offset add may wrap: for the full range `lo + u` crosses the sign
    // boundary as the value it names does.
    let u: UInt64 = if span == 0 { UInt64(d.value) } else { UInt64(d.value) % span }
    return Draw { value: lo + Int64(u), rng: d.rng }
}

/// `Int64`'s minimum, through its `UInt64` bit pattern.
fn int64Min() -> Int64 {
    // 2^63 is one past what an `Int64` literal can name.
    let bits: UInt64 = 9223372036854775808
    return Int64(bits)
}

test "nextInRange covers the full Int64 range without trapping" {
    // span = 2^64, which neither Int64 nor UInt64 can hold.
    let d = nextInRange(seededRng(42), int64Min(), 9223372036854775807)
    assertEq(d.value, 4456085495900499605)
    assertEq(d.rng.state, 11400714819323198527)
}

test "nextInRange stays deterministic and in range on wide spans" {
    // A span past Int64's positive range but not the full one, pinned.
    assertEq(
        nextInRange(seededRng(7), int64Min(), 9223372036854775806).value,
        0 - 2032282435962401321,
    )
    // A small range: the modulo path the wide spans share.
    assertEq(nextInRange(seededRng(42), 1, 6).value, 2)
    let mut d = nextInRange(seededRng(1), 0 - 1000000, 1000000)
    let mut i = 0
    while i < 32 {
        assert(d.value >= 0 - 1000000 && d.value <= 1000000)
        d = nextInRange(d.rng, 0 - 1000000, 1000000)
        i = i + 1
    }
}
