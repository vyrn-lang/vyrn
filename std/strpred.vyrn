/// std/strpred: the string predicates and `slice`, written on the byte view
/// (`bytes`, `s[i]`, `stringFromBytes`).
///
/// Offsets and lengths are bytes. A byte-wise scan is safe on UTF-8: a valid
/// needle starts with an ASCII or a lead byte, so it cannot match at a
/// continuation byte. The functions read the `byteLength` field, never
/// `byteLengthV`: the field is O(1) and folds at compile time, while
/// `byteLengthV` copies the string (4.5 ns against 72.5 ns on 47 bytes).

/// The `s.byteLength` field as a function.
export fn byteLengthV(s: String) -> Int64 {
    // Bind the copy: a binding owns it and releases it at block exit, while a
    // bare receiver would leak it.
    let b = bytes(s)
    return b.length
}

/// Does `s` begin with `needle`? An empty needle is a prefix of everything.
export fn startsWith(s: String, needle: String) -> Bool {
    let nl = needle.byteLength
    if nl > s.byteLength {
        return false
    }
    let mut j = 0
    while j < nl {
        if s[j] != needle[j] {
            return false
        }
        j = j + 1
    }
    return true
}

/// Does `s` end with `needle`? An empty needle is a suffix of everything.
export fn endsWith(s: String, needle: String) -> Bool {
    let off = s.byteLength - needle.byteLength
    if off < 0 {
        return false
    }
    let nl = needle.byteLength
    let mut j = 0
    while j < nl {
        if s[off + j] != needle[j] {
            return false
        }
        j = j + 1
    }
    return true
}

/// Boyer-Moore-Horspool's bad-character table for `needle`: for each byte, how
/// far a window may jump when it ends on that byte. A plain `Array`, not a
/// record: a field read per byte costs the interpreter measurably, and an
/// array argument is shared copy-on-write.
export fn skipTable(needle: String, haystackBytes: Int64) -> Array<UInt32> {
    // A jump past `UInt32`'s range is clamped, not wrapped: a shorter jump
    // stays correct, and a wrapped one could be 0 and never advance.
    let nl = needle.byteLength
    let top = if nl > 4294967295 { 4294967295 } else { nl }
    let mut skip: Array<UInt32> = []
    let mut k = 0
    while k < 256 {
        skip.push(UInt32(top))
        k = k + 1
    }
    let mut j = 0
    while j < nl - 1 {
        let d = nl - 1 - j
        skip[Int64(needle[j])] = UInt32(if d < top { d } else { top })
        j = j + 1
    }
    return skip
}

/// The first occurrence of `needle` at or after `from`, or -1. O(n*m).
export fn findPlain(s: String, needle: String, from: Int64 where value >= 0) -> Int64 {
    let n = s.byteLength
    let nl = needle.byteLength
    if nl == 0 {
        return from
    }
    let mut i = from
    while i <= n - nl {
        let mut j = 0
        while j < nl && s[i + j] == needle[j] {
            j = j + 1
        }
        if j == nl {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// Whether a table for `needle` pays over a haystack of that size. Callers ask
/// before building the table: `std/vyx` calls `contains` on short strings
/// millions of times, and an allocation per call cost it about 10%.
export fn worthPreparing(needle: String, haystackBytes: Int64) -> Bool {
    return needle.byteLength >= 2 && haystackBytes >= 512
}

/// [`findPlain`] with a table from [`skipTable`]: it compares from the end of
/// the window and, on a mismatch, skips by the table entry for the window's
/// last byte, so it visits about `n / m` positions.
export fn findSkipping(s: String, needle: String, from: Int64 where value >= 0, skip: Array<UInt32> where value.length >= 256) -> Int64 {
    let n = s.byteLength
    let nl = needle.byteLength
    if nl == 0 {
        return from
    }
    let mut i = from
    while i <= n - nl {
        let mut q = nl - 1
        while q >= 0 && s[i + q] == needle[q] {
            q = q - 1
        }
        if q < 0 {
            return i
        }
        i = i + Int64(skip[Int64(s[i + nl - 1])])
    }
    return 0 - 1
}

/// Whether `needle` occurs in `s`; an empty needle occurs everywhere.
export fn contains(s: String, needle: String) -> Bool {
    let n = s.byteLength
    if needle.byteLength > n {
        return false
    }
    if worthPreparing(needle, n) {
        return findSkipping(s, needle, 0, skipTable(needle, n)) >= 0
    }
    // Inline, not a call to `findPlain`: this is the hottest scan in the library,
    // and one more frame cost 2.7% of the generator phase.
    let nl = needle.byteLength
    let mut i = 0
    while i <= n - nl {
        let mut j = 0
        while j < nl && s[i + j] == needle[j] {
            j = j + 1
        }
        if j == nl {
            return true
        }
        i = i + 1
    }
    return false
}

/// The two ways a byte range fails to name a substring, each carrying the
/// offset that failed.
export type SliceError = | OutOfRange(Int64) | SplitsCharacter(Int64)

/// The bytes of `s` from `start` up to `end`, both byte offsets on UTF-8
/// character boundaries.
///
/// `OutOfRange(start)` when `start < 0`; `OutOfRange(end)` when
/// `end > s.byteLength` or `start > end`. `SplitsCharacter(i)` when cut point
/// `i` lands on a continuation byte. The range is checked before the boundary,
/// as `examples/strpredbytes.vyrn` pins. A string that holds NUL, which no
/// program can construct, returns `SplitsCharacter(start)`.
///
/// It reads `s[i]` and `s.byteLength`, never `bytes(s)`: `std/scan` slices once
/// per token, so a whole-string copy per call would be quadratic.
export fn slice(s: String, start: Int64, end: Int64) -> Result<String, SliceError> {
    let n = s.byteLength
    if start < 0 {
        return Err(OutOfRange(start))
    }
    if end > n || start > end {
        return Err(OutOfRange(end))
    }
    if start < n && (Int64(s[start]) & 192) == 128 {
        return Err(SplitsCharacter(start))
    }
    if end < n && (Int64(s[end]) & 192) == 128 {
        return Err(SplitsCharacter(end))
    }
    // The whole string, as `trimStart`, `trimEnd` and `substring(s, 0, n)` ask.
    if start == 0 && end == n {
        return Ok(s.copy())
    }
    if start == end {
        return Ok("")
    }
    // One copy call; a byte-push loop was 19 times slower. `bytes`
    // checks only that the range exists; the bounds and boundaries ran above.
    return match stringFromBytes(bytes(s, start, end)) {
        Ok(v) => Ok(v),
        Err(e) => Err(SplitsCharacter(start)),
    }
}

test "the predicates answer the same on ASCII and on multi-byte text" {
    // A needle matches only at a character boundary, so a byte-wise scan never
    // lands mid-character.
    assertEq(startsWith("café au lait", "café"), true)
    assertEq(endsWith("café au lait", "lait"), true)
    assertEq(contains("café au lait", "é a"), true)
    assertEq(contains("日本語テキスト", "語テ"), true)
    assertEq(contains("日本語テキスト", "zz"), false)
    // An empty needle is a prefix, a suffix, and a substring of everything.
    assertEq(startsWith("", ""), true)
    assertEq(endsWith("", ""), true)
    assertEq(contains("", ""), true)
    // A needle longer than the haystack is refused rather than read past.
    assertEq(startsWith("ab", "abc"), false)
    assertEq(endsWith("ab", "abc"), false)
    assertEq(contains("ab", "abc"), false)
}

test "contains finds an overlapping repeat and a match at the very end" {
    // The skip path: a match that overlaps an earlier partial match, and one
    // ending on the haystack's last byte.
    assertEq(contains("aaaaaaaaab", "aaab"), true)
    assertEq(contains("the lazy dog", "dog"), true)
    assertEq(contains("abcabc", "cab"), true)
}
