/// std/text: UTF-8 decoding and byte-offset line and column, in Vyrn.
///
/// The engines route `s.charCount()` to `charCountV`, `lineAt` to `lineAtV` and
/// `colAt` to `colAtV`; `chars` is an ordinary export. `utf8Width` is the one
/// statement of what UTF-8 admits, and `decodeUtf8` and `stringFault` both ask it,
/// so `tests/text.rs` checks them against Rust's `std::str::from_utf8`, not against
/// each other.
///
/// `decodeUtf8` accepts `0x00` and `stringFromBytes` refuses it: a `String` is
/// NUL-terminated, so the two differ in what a `String` can hold, not in
/// what UTF-8 means.

/// The Unicode scalar values of `b`, or `None` if `b` is not valid UTF-8 as Rust's
/// `String::from_utf8` defines it.
export fn decodeUtf8(b: Array<UInt8>) -> Option<Array<UInt32>> {
    let n = b.length
    let mut out: Array<UInt32> = []
    let mut i = 0
    while i < n {
        let b0 = UInt32(b[i])
        let w = utf8Width(b, i)
        if w == 0 {
            return None
        }
        // A lead byte carries 7, 5, 4 or 3 payload bits, a continuation byte 6.
        if w == 1 {
            out.push(b0)
        } else if w == 2 {
            out.push(((b0 & 31) << 6) | (UInt32(b[i + 1]) & 63))
        } else if w == 3 {
            out.push(((b0 & 15) << 12) | ((UInt32(b[i + 1]) & 63) << 6) | (UInt32(b[i + 2]) & 63))
        } else {
            out.push(
                ((b0 & 7) << 18) | ((UInt32(b[i + 1]) & 63) << 12) | ((UInt32(b[i + 2]) & 63) << 6)
                    | (UInt32(b[i + 3]) & 63),
            )
        }
        i = i + w
    }
    return Some(out)
}

/// The width of the UTF-8 sequence that starts at `i` in `b`, or 0 when the
/// bytes there start none.
///
/// `lo`/`hi` bound the first continuation byte, and they carry every overlong and
/// out-of-range rule: 0xE0 needs 0xA0+, 0xED stops at 0x9F (surrogates), 0xF0
/// needs 0x90+ and 0xF4 stops at 0x8F (past U+10FFFF).
export fn utf8Width(b: Array<UInt8>, i: Int64 where value >= 0 && value < b.length) -> Int64 {
    let b0 = Int64(b[i])
    if b0 < 128 {
        return 1
    }
    let mut w = 0
    let mut lo = 128
    let mut hi = 191
    if b0 >= 194 && b0 <= 223 {
        w = 2
    } else if b0 == 224 {
        w = 3
        lo = 160
    } else if b0 == 237 {
        w = 3
        hi = 159
    } else if (b0 >= 225 && b0 <= 236) || b0 == 238 || b0 == 239 {
        w = 3
    } else if b0 == 240 {
        w = 4
        lo = 144
    } else if b0 == 244 {
        w = 4
        hi = 143
    } else if b0 >= 241 && b0 <= 243 {
        w = 4
    }
    if w == 0 || i + w > b.length {
        return 0
    }
    let c1 = Int64(b[i + 1])
    if c1 < lo || c1 > hi {
        return 0
    }
    let mut k = 2
    while k < w {
        let c = Int64(b[i + k])
        if c < 128 || c > 191 {
            return 0
        }
        k = k + 1
    }
    return w
}

/// What is wrong with `b` if it were made into a `String`: 0 nothing, 1 a NUL
/// byte, 2 not UTF-8.
///
/// Every engine calls this as the check half of `stringFromBytes` and keeps only
/// the build. The NUL scan covers the whole array first, so
/// `[0xFF, 0x00]` is a NUL error. ASCII steps inline so the digits `intStr` hands
/// in cost no call.
export fn stringFault(b: Array<UInt8>) -> Int64 {
    let n = b.length
    let mut i = 0
    while i < n {
        if b[i] == 0 {
            return 1
        }
        i = i + 1
    }
    i = 0
    while i < n {
        if b[i] < 128 {
            i = i + 1
        } else {
            let w = utf8Width(b, i)
            if w == 0 {
                return 2
            }
            i = i + w
        }
    }
    return 0
}

/// The codepoints of `s`.
///
/// The `None` arm is unreachable: every boundary that builds a `String` validates
/// its UTF-8.
export fn chars(s: String) -> Array<UInt32> {
    return match decodeUtf8(bytes(s)) {
        Some(cs) => cs,
        None => [],
    }
}

/// The number of Unicode scalar values in `s`: a byte scan that counts every byte
/// that is not a continuation (`0b10xxxxxx`), with no allocation.
export fn charCountV(s: String) -> Int64 {
    let n = s.byteLength
    let mut count = 0
    let mut i = 0
    while i < n {
        if (Int64(s[i]) & 192) != 128 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

/// The 1-based line of byte offset `off` in `b`: one more than the LF bytes before
/// `off`. An offset past the end reads as the end, a negative one as 0. O(off).
export fn lineAtV(b: Array<UInt8>, off: Int64) -> Int64 {
    let mut end = off
    if end > b.length {
        end = b.length
    }
    let mut line = 1
    let mut i = 0
    while i < end {
        if b[i] == 10 {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

/// The 1-based column of byte offset `off` in `b`, in bytes, not codepoints: the
/// byte after a two-byte codepoint on an otherwise empty line is column 3.
export fn colAtV(b: Array<UInt8>, off: Int64) -> Int64 {
    let mut i = off
    if i > b.length {
        i = b.length
    }
    let mut col = 1
    while i > 0 && b[i - 1] != 10 {
        col = col + 1
        i = i - 1
    }
    return col
}

/// The codepoints as comma-separated decimals, so a test compares exact scalar
/// values.
export fn showCps(a: Array<UInt32>) -> String {
    let mut out = ""
    let mut first = true
    for c in a {
        if first {
            out = out + c.toString()
        } else {
            out = out + "," + c.toString()
        }
        first = false
    }
    return out
}

test "ascii and the three multi-byte widths decode to the builtin's codepoints" {
    assertEq(showCps(chars("hi")), "104,105")
    // 2-byte (U+00E9), 3-byte (U+20AC), 4-byte (U+1F600, astral).
    assertEq(showCps(chars("é")), "233")
    assertEq(showCps(chars("€")), "8364")
    assertEq(showCps(chars("😀")), "128512")
    assertEq(showCps(chars("a€😀é")), "97,8364,128512,233")
    assertEq(showCps(chars("")), "")
    // U+FFFF and U+10000, the boundary between three bytes and four.
    assertEq(showCps(chars("\u{ffff}\u{10000}")), "65535,65536")
}

test "every malformed shape the validator distinguishes is refused" {
    assertEq(match decodeUtf8(['\xc0', '\xaf']) { Some(cs) => "?", None => "reject" }, "reject")
    assertEq(match decodeUtf8(['\x80']) { Some(cs) => "?", None => "reject" }, "reject")
    assertEq(
        match decodeUtf8(['\xed', '\xa0', '\x80']) { Some(cs) => "?", None => "reject" },
        "reject",
    )
    assertEq(
        match decodeUtf8(['\xf5', '\x80', '\x80', '\x80']) { Some(cs) => "?", None => "reject" },
        "reject",
    )
    assertEq(match decodeUtf8(['\xe2', '\x82']) { Some(cs) => "?", None => "reject" }, "reject")
    // The last legal codepoint, and the first illegal one one above it.
    assertEq(
        match decodeUtf8(['\xf4', '\x8f', '\xbf', '\xbf']) {
            Some(cs) => showCps(cs),
            None => "reject",
        },
        "1114111",
    )
    assertEq(
        match decodeUtf8(['\xf4', '\x90', '\x80', '\x80']) { Some(cs) => "?", None => "reject" },
        "reject",
    )
    // NUL is valid UTF-8, and `stringFromBytes` refuses it.
    assertEq(
        match decodeUtf8(['h', '\x00', 'i']) { Some(cs) => showCps(cs), None => "reject" },
        "104,0,105",
    )
    assertEq(
        match stringFromBytes(['h', '\x00', 'i']) { Ok(s) => "ok", Err(e) => e },
        "bytes contain a NUL byte",
    )
}

test "a scalar count is not a byte count, except on ASCII" {
    assertEq(charCountV("").toString() + "/" + "".byteLength.toString(), "0/0")
    assertEq(charCountV("hello").toString() + "/" + "hello".byteLength.toString(), "5/5")
    assertEq(charCountV("héllo").toString() + "/" + "héllo".byteLength.toString(), "5/6")
    assertEq(charCountV("☕").toString() + "/" + "☕".byteLength.toString(), "1/3")
    assertEq(charCountV("😀").toString() + "/" + "😀".byteLength.toString(), "1/4")
    // All four widths in one string, to catch a scan that mishandles the
    // transition between sequences: 4 scalars, 1 + 2 + 3 + 4 = 10 bytes.
    assertEq(charCountV("aé€😀").toString() + "/" + "aé€😀".byteLength.toString(), "4/10")
    // A byte scan against a full decode.
    assertEq(charCountV("aé€😀"), chars("aé€😀").length)
}

test "line and column are 1-based, and the column counts bytes" {
    let b = bytes("ab\ncd\n\nx")
    assertEq(lineAtV(b, 0).toString() + ":" + colAtV(b, 0).toString(), "1:1")
    assertEq(lineAtV(b, 3).toString() + ":" + colAtV(b, 3).toString(), "2:1")
    assertEq(lineAtV(b, 7).toString() + ":" + colAtV(b, 7).toString(), "4:1")
    // Past the end reads as the end.
    assertEq(lineAtV(b, 99).toString() + ":" + colAtV(b, 99).toString(), "4:2")
    // No newline at all: one line, columns straight across.
    let flat = bytes("abcd")
    assertEq(lineAtV(flat, 3).toString() + ":" + colAtV(flat, 3).toString(), "1:4")
    // `\r\n` is one line break, and the CR occupies a column of its own.
    let crlf = bytes("ab\r\ncd")
    assertEq(lineAtV(crlf, 2).toString() + ":" + colAtV(crlf, 2).toString(), "1:3")
    assertEq(lineAtV(crlf, 4).toString() + ":" + colAtV(crlf, 4).toString(), "2:1")
    // A multi-byte codepoint spans two columns: U+00E9 is bytes 0..2, so the byte
    // after it is column 3 and the codepoint after it is the second character.
    let acc = bytes("éx")
    assertEq(colAtV(acc, 2).toString(), "3")
    assertEq(colAtV(acc, 2), colAt(acc, 2))
}
