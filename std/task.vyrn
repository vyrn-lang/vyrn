/// Waiting for the host: `sleep`, the one host wait, and the run queue.
///
/// A function that reaches a wait waits itself, and each call of it is
/// marked `await` (language.md, Waiting).

import { arenaSwap, regionExit, free } from "std/runtime"

/// Waits `ms` milliseconds while the host runs other tasks.
export fn sleep(ms: Int64) {
    await hostSleep(ms)
}

/// The results of the two branches of a `both`, in argument order.
export type Both<A, B> = { first: A, second: B }

/// The branch of a `race` that finished first, and its result.
export type Race<A, B> = enum { First(A), Second(B) }

/// Runs two calls at once and waits for both: `await both(f(a), g(b))`.
///
/// Each argument is a call, and the two are one call's arguments, so a
/// `modify` or `consume` argument of one may not be named by the other.
/// `both` starts the first, runs it to its first wait, then starts the
/// second. If one is cancelled, `both` cancels the other and is cancelled.
/// Without `await`, no branch waits, and the calls run in order.
export fn both<A, B>(first: consume A, second: consume B) -> Both<A, B> {
    return Both { first: first, second: second }
}

/// Runs two calls at once and returns the first to finish, cancelling the
/// other where it waits: `await race(f(a), sleep(500))`.
///
/// `race` starts both as `both` does. The first branch, in argument order,
/// that has finished when the starts end wins; after that, the first to
/// finish. A finished loser's result is released. Without `await`, no branch
/// waits, and the first wins.
export fn race<A, B>(first: consume A, second: consume B) -> Race<A, B> {
    return First(first)
}

/// Calls `f` on every element of `xs` at once and waits for every call: the
/// results, in index order. The calls start in index order, each to its first
/// wait. If one is cancelled, the others are, and `each` is cancelled.
export fn each<T, R>(xs: Array<T>, f: fn(T) -> R) -> Array<R> {
    return await eachUpTo(xs, xs.length, f)
}

/// `each` over the first `n` elements of `xs`.
fn eachUpTo<T, R>(xs: Array<T>, n: Int64, f: fn(T) -> R) -> Array<R> {
    if n == 0 {
        return []
    }
    let r = await both(eachUpTo(xs, n - 1, f), f(xs[n - 1]))
    let mut out = consume r.first
    out.push(consume r.second)
    return out
}

/// Waits for `f()` at most `ms` milliseconds: `Some` of its result, or `None`
/// when the time ran out first, and `f` was cancelled where it waited.
export fn timeout<T>(ms: Int64, f: fn() -> T) -> Option<T> {
    return match await race(f(), sleep(ms)) {
        First(v) => Some(v),
        Second(_) => None,
    }
}

// The run queue. The host owns the event loop and delivers each completion
// through `wake`, which the emitter exports as `__vyrn_wake`; the module runs
// the woken tasks in wake order, so the same deliveries print the same bytes
// on every engine. The emitter calls the functions below by name: `_start`
// and a waiting export start a task, a host wait waits on its operation's id.

/// A task the host started by calling `main` or an export that waits: its
/// number from 1 in start order, the emitter's number of the root that started
/// it, and the root's frame while it waits.
type Task = { id: Int64, root: Int32, frame: Int32 }

/// A host operation a task waits on: its id, the task, and what the wake
/// delivered: a status, 2 until it came, 0 completed and 1 cancelled, and a
/// payload. A task waits on one operation per branch that waits.
type Wait = { id: Int64, task: Int64, status: Int32, payload: Int64 }

/// The tasks that run or wait.
let mut tasks: Array<Task> = []

/// The operations the tasks wait on, until each wait reads its delivery.
let mut waits: Array<Wait> = []

/// The woken tasks' ids from `readyAt`, in wake order.
let mut ready: Array<Int64> = []

let mut readyAt: Int64 = 0

/// The running task's id, 0 between steps.
let mut running: Int64 = 0

let mut started: Int64 = 0

/// How many cancellations run: while one does, every wait a poll reaches is
/// cancelled.
let mut cancelling: Int64 = 0

/// The position of task `id` in `tasks`, or the length when it has ended.
fn taskAt(id: Int64) -> Int64 {
    let mut i: Int64 = 0
    while i < tasks.length && tasks[i].id != id {
        i = i + 1
    }
    return i
}

/// The position of the wait on operation `id` in `waits`, or the length when
/// no task waits on it.
fn waitAt(id: Int64) -> Int64 {
    let mut i: Int64 = 0
    while i < waits.length && waits[i].id != id {
        i = i + 1
    }
    return i
}

/// Removes task `id`, which has ended.
fn taskEnd(id: Int64) {
    let i = taskAt(id)
    if i < tasks.length {
        tasks.swapRemove(i)
    }
}

/// A task for the root the host is starting, which runs from here.
fn taskBegin(root: Int32) -> Int64 {
    started = started + 1
    tasks.push(Task { id: started, root: root, frame: 0 })
    running = started
    return started
}

/// Ends the first step of task `id`, whose root answered `st`: 0 or 1 when it
/// ended, else the frame it waits in.
fn taskSettle(id: Int64, st: Int32) {
    running = 0
    if UInt32(st) < 2 {
        taskEnd(id)
        return
    }
    let i = taskAt(id)
    if i < tasks.length {
        tasks[i].frame = st
    }
}

/// The running task ended: `main`'s end calls it before the exit. After a
/// first step's `taskSettle`, no task runs.
fn taskFinish() {
    if running != 0 {
        taskEnd(running)
        running = 0
    }
}

/// The running task waits on the host's operation `id`.
fn waitOn(id: Int64) {
    waits.push(Wait { id: id, task: running, status: 2, payload: 0 })
}

/// The wait on `id`: 2 until its wake came, then the status the wake
/// delivered, and the wait ends. While a cancellation runs, a wait that has
/// not come ends cancelled, 1, and the host drops its operation.
fn delivery(id: Int64) -> Int32 {
    let i = waitAt(id)
    if i == waits.length {
        return 2
    }
    let mut st = waits[i].status
    if st == 2 && cancelling > 0 {
        hostCancel(id)
        st = 1
    }
    if st != 2 {
        waits.swapRemove(i)
    }
    return st
}

/// A `both` or `race` cancels a branch by polling it between `cancelBegin`
/// and `cancelEnd`: every wait the poll reaches is cancelled, so each frame
/// on the branch takes its cancellation edge.
fn cancelBegin() {
    cancelling = cancelling + 1
}

fn cancelEnd() {
    cancelling = cancelling - 1
}

/// `__vyrn_wake`: the host's operation `id` ended with `status`, 0 completed
/// or 1 cancelled, and `payload`. The task that waits on it joins the ready
/// queue, once, and the ready tasks run in wake order until none is ready.
/// Returns how many tasks still wait. A wake that names no pending wait
/// changes nothing.
fn wake(id: Int64, status: Int32, payload: Int64) -> Int32 {
    let i = waitAt(id)
    if i < waits.length && waits[i].status == 2 {
        waits[i].status = status
        waits[i].payload = payload
        let t = waits[i].task
        let mut j = readyAt
        while j < ready.length && ready[j] != t {
            j = j + 1
        }
        if j == ready.length {
            ready.push(t)
        }
    }
    while readyAt < ready.length {
        let t = ready[readyAt]
        readyAt = readyAt + 1
        let k = taskAt(t)
        if k < tasks.length {
            running = t
            let st = hostResume(tasks[k].root, tasks[k].frame)
            if UInt32(st) < 2 {
                taskEnd(t)
            }
            running = 0
        }
    }
    ready = []
    readyAt = 0
    return Int32(tasks.length)
}

// A `region` that holds an `await` has an arena of its own, so tasks and fork
// branches that wait inside regions never bump or free one arena out of
// order. The emitter keeps the arena outside such a region in a local of the
// frame and calls these by name: `regionSwap(0)` where the region opens,
// `regionSwap` at each suspension and each resume inside it, `regionClose` at
// its closing brace, a `break`, a `continue` and a cancellation, and
// `regionCarry` at a `return`.

/// Makes `other` the arena and returns the arena it replaced.
fn regionSwap(other: Int64) -> Int64 {
    return arenaSwap(other, false)
}

/// Frees the region's arena and makes `outer` the arena again: `regionExit(0)`
/// frees every chunk but the oldest, which the swap hands back to `free`.
fn regionClose(outer: Int64) {
    regionExit(0)
    free(Int32(arenaSwap(outer, false)))
}

/// Hands the region's chunks to `outer`, whose region frees them: a `return`
/// carries a value out that may live in them.
fn regionCarry(outer: Int64) {
    let mine = arenaSwap(outer, false)
    if mine != 0 {
        arenaSwap(mine, true)
    }
}
