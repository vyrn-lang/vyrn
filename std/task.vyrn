/// Waiting for the host: `sleep`, the host's timer, and the run queue.
///
/// A function that reaches a wait waits itself, and each call of it is
/// marked `await` (language.md, Waiting).

import { arenaSwap, regionExit, free } from "std/runtime"

/// Waits while the host runs other tasks, until `ms` milliseconds after the
/// deadline of the wake this task runs in, or after the start of the program
/// or of the request: the time the task computes before it counts against it.
export fn sleep(ms: Int64) {
    await hostSleep(ms)
}

/// The results of the two tasks of a `both`, in argument order.
export type Both<A, B> = { first: A, second: B }

/// The task of a `race` that returned first, and its result.
export type Race<A, B> = enum { First(A), Second(B) }

/// What `joinOr` answers: the task's result, or its handle when the caller was
/// cancelled while it waited.
export type Joined<T> = enum { Done(T), Cancelled(Task<T>) }

/// Waits for `t` to end and returns its result. If `t` is cancelled, the
/// caller is cancelled where it waits.
export fn join<T>(t: consume Task<T>) -> T {
    let id = taskId(t)
    if stateOf(id) == 2 {
        let op = newOp()
        watch(id, op)
        await taskWait(op)
    }
    if stateOf(id) == 1 {
        await cancelled()
    }
    forget(id)
    return taskTake(t)
}

/// Waits for `t` as `join` does, but a cancellation of the caller while it
/// waits here answers `Cancelled(t)`, and the caller runs on: it decides to
/// cancel, keep or hand on `t`, and returns. Any other wait the caller reaches
/// after that ends it there. If `t` is cancelled, the caller is cancelled
/// where it waits.
export fn joinOr<T>(t: consume Task<T>) -> Joined<T> {
    let id = taskId(t)
    if stateOf(id) == 2 {
        let op = newOp()
        watch(id, op)
        if await waitAware(op) {
            return Cancelled(t)
        }
    }
    if stateOf(id) == 1 {
        await cancelled()
    }
    forget(id)
    return Done(taskTake(t))
}

/// Ends `t` where it waits, releasing what it holds, or releases its result
/// when it returned. Does not wait.
export fn cancel<T>(t: consume Task<T>) {
    stop(taskId(t))
    release(t)
}

/// The release of a handle: gives up the right to `t`'s result. A task that
/// runs goes on without an owner, and its root frees its block when it ends; a
/// task that ended is forgotten, with its result.
fn release<T>(t: consume Task<T>) {
    let id = taskId(t)
    let i = taskAt(id)
    if i < runs.length && runs[i].state == 2 {
        runs[i].owned = false
        taskLeave(t)
        return
    }
    let returned = stateOf(id) == 0
    forget(id)
    taskFree(t, returned)
}

/// Waits for both tasks: their results, in argument order. If one is
/// cancelled, `both` cancels the other and is cancelled. If the caller is
/// cancelled while it waits here, `both` cancels both tasks.
export fn both<A, B>(first: consume Task<A>, second: consume Task<B>) -> Both<A, B> {
    let a = taskId(first)
    let b = taskId(second)
    while (stateOf(a) == 2 || stateOf(b) == 2) && stateOf(a) != 1 && stateOf(b) != 1 {
        let op = newOp()
        watch(a, op)
        watch(b, op)
        if await waitAware(op) {
            stop(a)
            stop(b)
        }
    }
    if stateOf(a) == 1 || stateOf(b) == 1 {
        stop(a)
        stop(b)
    }
    let f = await join(first)
    let s = await join(second)
    return Both { first: f, second: s }
}

/// The first task to return, in argument order once both started, and its
/// result: `await race(fork f(a), fork sleep(500))`. The other is cancelled
/// where it waits, or released if it returned. If the first to end was
/// cancelled, `race` is cancelled. If the caller is cancelled while it waits
/// here, `race` cancels both tasks.
export fn race<A, B>(first: consume Task<A>, second: consume Task<B>) -> Race<A, B> {
    let a = taskId(first)
    let b = taskId(second)
    if stateOf(a) == 2 && stateOf(b) == 2 {
        let op = newOp()
        watch(a, op)
        watch(b, op)
        if await waitAware(op) {
            stop(a)
            stop(b)
        }
    }
    if stateOf(a) == 0 || stateOf(b) == 2 {
        cancel(second)
        return First(await join(first))
    }
    cancel(first)
    return Second(await join(second))
}

/// `Some` of `t`'s result if it returns within `ms` milliseconds, else `None`,
/// and `t` is cancelled where it waits.
export fn timeout<T>(ms: Int64, t: consume Task<T>) -> Option<T> {
    return match await race(t, fork sleep(ms)) {
        First(v) => Some(v),
        Second(_) => None,
    }
}

/// Waits for every task: the results, in index order. If one is cancelled,
/// or the caller is cancelled while it waits here, `joinAll` cancels the rest
/// and is cancelled.
export fn joinAll<T>(ts: consume Array<Task<T>>) -> Array<T> {
    let mut ids: Array<Int64> = []
    for t in ts {
        ids.push(taskId(t))
    }
    return await joinTasks(ts, ids)
}

/// Tasks of one result type, at most `limit` of them running at once, joined
/// or cancelled together; `ids` holds their run queue ids in the same order.
export type Group<T> = { tasks: Array<Task<T>>, ids: Array<Int64>, limit: Int64 }

/// An empty group whose tasks run at most `limit` at once. A limit below 1
/// traps at the call, because `room` would wait forever.
export fn group<T>(limit: Int64 where value >= 1) -> Group<T> {
    return Group { tasks: [], ids: [], limit: limit }
}

/// Waits until fewer than the limit of `g`'s tasks run: call it before each
/// `fork` the group will hold. If one was cancelled, or the caller is
/// cancelled while it waits here, `room` cancels the group's tasks and is
/// cancelled.
export fn room<T>(g: modify Group<T>) {
    await settle(g.ids, g.limit)
}

/// Waits while at least `limit` of the tasks `ids` names run and none was
/// cancelled. If one was, or the caller is cancelled while it waits here,
/// cancels them all, and the caller is cancelled.
fn settle(ids: Array<Int64>, limit: Int64) {
    while live(ids) >= limit && !anyCancelled(ids) {
        let op = newOp()
        for id in ids {
            watch(id, op)
        }
        if await waitAware(op) {
            stopAll(ids)
        }
    }
    if anyCancelled(ids) {
        stopAll(ids)
        await cancelled()
    }
}

/// Adds `t` to `g`.
export fn add<T>(g: modify Group<T>, t: consume Task<T>) {
    g.ids.push(taskId(t))
    g.tasks.push(t)
}

/// Waits for every task of `g`: the results, in the order they were added.
export fn joinGroup<T>(g: consume Group<T>) -> Array<T> {
    return await joinTasks(consume g.tasks, consume g.ids)
}

/// Waits until none of `ts`, whose run queue ids are `ids`, runs, and returns
/// their results in index order.
fn joinTasks<T>(ts: consume Array<Task<T>>, ids: consume Array<Int64>) -> Array<T> {
    await settle(ids, 1)
    drop ids
    let mut out: Array<T> = []
    for t in consume ts {
        out.push(await join(t))
    }
    return out
}

/// Cancels every task of `g` where it waits.
export fn cancelGroup<T>(g: consume Group<T>) {
    let ts = consume g.tasks
    for t in consume ts {
        cancel(t)
    }
}

/// Cancels each of the tasks `ids` names where it waits.
fn stopAll(ids: Array<Int64>) {
    for id in ids {
        stop(id)
    }
}

/// How many of the tasks `ids` names run.
fn live(ids: Array<Int64>) -> Int64 {
    let mut n: Int64 = 0
    for id in ids {
        if stateOf(id) == 2 {
            n = n + 1
        }
    }
    return n
}

/// Whether one of the tasks `ids` names was cancelled.
fn anyCancelled(ids: Array<Int64>) -> Bool {
    for id in ids {
        if stateOf(id) == 1 {
            return true
        }
    }
    return false
}

// The run queue. The host owns the event loop and delivers each completion
// through `wake`, which the emitter exports as `__vyrn_wake`; the module runs
// the woken tasks in wake order, so the same deliveries print the same bytes
// on every engine. The emitter calls the functions below by name: `_start`
// and a waiting export start a task, `fork` starts one, and a wait waits on
// its operation's id. A host's operation ids count up from 1 and the run
// queue's own count down from -1, so one table serves both.

/// A task: its number from 1 in start order, the emitter's number of the root
/// that started it, the root's frame while it waits (a forked task's block),
/// the host's id for it (0 for `main` and a forked task, which no host names),
/// the root's result once it returned, whether a handle owns it, its state, 2
/// while it runs, 0 returned and 1 cancelled, and the operation its end
/// delivers to its owner, 0 for none. An owned task stays until its owner
/// takes or frees it; `release` makes a running one unowned.
type Run = {
    id: Int64,
    root: Int32,
    frame: Int32,
    host: Int64,
    result: Int64,
    owned: Bool,
    state: Int32,
    watch: Int64,
}

/// An operation a task waits on: its id, the task, what the wake delivered (a
/// status, 2 until it came, 0 completed and 1 cancelled, and a payload), and
/// whether a cancellation of the task completes the wait instead of ending the
/// task there. A task waits on one operation at a time.
type Wait = { id: Int64, task: Int64, status: Int32, payload: Int64, aware: Bool }

/// The tasks that run or wait.
let mut runs: Array<Run> = []

/// The operations the tasks wait on, until each wait reads its delivery.
let mut waits: Array<Wait> = []

/// The woken tasks' ids from `readyAt`, in wake order.
let mut ready: Array<Int64> = []

let mut readyAt: Int64 = 0

/// The running task's id, 0 between steps.
let mut running: Int64 = 0

let mut started: Int64 = 0

/// The last of the run queue's own operation ids.
let mut ops: Int64 = 0

/// How many cancellations run: while one does, every wait a poll reaches is
/// cancelled.
let mut cancelling: Int64 = 0

/// The position of task `id` in `runs`, or the length when it has ended.
fn taskAt(id: Int64) -> Int64 {
    let mut i: Int64 = 0
    while i < runs.length && runs[i].id != id {
        i = i + 1
    }
    return i
}

/// The position of the wait on operation `id` in `waits`, or the length when
/// no task waits on it.
fn waitAt(id: Int64) -> Int64 {
    let mut i: Int64 = 0
    while i < waits.length && waits[i].id != id {
        i = i + 1
    }
    return i
}

/// Task `id` ended with status `st`, 0 returned or 1 cancelled. An owned
/// task keeps its row, and its end completes its owner's watch, so the owner
/// wakes and reads the state: a released handle cancels nothing. Any
/// other leaves, and a host that named it learns its end, with the result of a
/// task that returned.
fn taskEnd(id: Int64, st: Int32) {
    let i = taskAt(id)
    if i < runs.length {
        if runs[i].owned {
            runs[i].state = st
            deliver(runs[i].watch, 0, 0)
            return
        }
        if runs[i].host != 0 {
            hostDone(runs[i].host, st, runs[i].result)
        }
        runs.swapRemove(i)
    }
}

/// A task for the root the host is starting as `host`, which runs from here.
fn taskBegin(root: Int32, host: Int64) -> Int64 {
    started = started + 1
    runs.push(Run {
        id: started,
        root: root,
        frame: 0,
        host: host,
        result: 0,
        owned: false,
        state: 2,
        watch: 0,
    })
    running = started
    return started
}

/// A task `fork` starts with its root `root` over its block `block`, which
/// runs from here to its first wait: the root calls this before the call's
/// first step, and `taskForked` after it. Returns the task that ran before.
fn taskFork(root: Int32, block: Int32) -> Int64 {
    let was = running
    started = started + 1
    runs.push(Run {
        id: started,
        root: root,
        frame: block,
        host: 0,
        result: 0,
        owned: true,
        state: 2,
        watch: 0,
    })
    running = started
    return was
}

/// The first step of the running forked task answered `st`, and `was` runs
/// again. Returns the forked task's id.
fn taskForked(was: Int64, st: Int32) -> Int64 {
    let id = running
    running = was
    if UInt32(st) < 2 {
        taskEnd(id, st)
    }
    return id
}

/// A fresh operation id of the run queue's own.
fn newOp() -> Int64 {
    ops = ops - 1
    return ops
}

/// The state of task `id`: 2 while it runs, 0 returned, 1 cancelled.
fn stateOf(id: Int64) -> Int32 {
    let i = taskAt(id)
    if i == runs.length {
        return 1
    }
    return runs[i].state
}

/// Delivers task `id`'s end to `op`.
fn watch(id: Int64, op: Int64) {
    let i = taskAt(id)
    if i < runs.length {
        runs[i].watch = op
    }
}

/// Forgets task `id` once its owner took or freed it.
fn forget(id: Int64) {
    let i = taskAt(id)
    if i < runs.length {
        runs.swapRemove(i)
    }
}

/// Runs task `id` down its cancellation edges in this step: every wait it
/// reaches answers cancelled. A task that ended is left as it is.
fn stop(id: Int64) {
    let i = taskAt(id)
    if i == runs.length || runs[i].state != 2 {
        return
    }
    let was = running
    running = id
    cancelBegin()
    let st = hostResume(runs[i].root, runs[i].frame)
    cancelEnd()
    running = was
    taskEnd(id, st)
}

/// The start of `taskWait(op)`: the running task waits on `op` unless a
/// delivery came first. Answers as `delivery` does.
fn waitFor(op: Int64) -> Int32 {
    if waitAt(op) == waits.length {
        waitOn(op)
    }
    return delivery(op)
}

/// Cancels the running task where it waits here.
fn cancelled() {
    let op = newOp()
    waits.push(Wait { id: op, task: running, status: 1, payload: 0, aware: false })
    await taskWait(op)
}

/// Waits on the run queue's operation `op`, and answers whether the running
/// task was cancelled: a cancellation completes this wait, where it ends the
/// task at any other.
fn waitAware(op: Int64) -> Bool {
    if cancelling == 0 {
        waits.push(Wait { id: op, task: running, status: 2, payload: 0, aware: true })
        await taskWait(op)
    }
    return cancelling > 0
}

/// The running task's root returned `result`, one word, as `hostDone` passes
/// it: the emitter calls this before the task ends.
fn taskResult(result: Int64) {
    let i = taskAt(running)
    if i < runs.length {
        runs[i].result = result
    }
}

/// Ends the first step of task `id`, whose root answered `st`: 0 or 1 when it
/// ended, else the frame it waits in.
fn taskSettle(id: Int64, st: Int32) {
    running = 0
    if UInt32(st) < 2 {
        taskEnd(id, st)
        return
    }
    let i = taskAt(id)
    if i < runs.length {
        runs[i].frame = st
    }
}

/// The running task ended: `main`'s end calls it before the exit. After a
/// first step's `taskSettle`, no task runs.
fn taskFinish() {
    if running != 0 {
        taskEnd(running, 0)
        running = 0
    }
}

/// The running task waits on the host's operation `id`.
fn waitOn(id: Int64) {
    waits.push(Wait { id: id, task: running, status: 2, payload: 0, aware: false })
}

/// The wait on `id`: 2 until its wake came, then the status the wake
/// delivered, and the wait ends. While a cancellation runs, a wait that has
/// not come ends cancelled, 1, and the host drops its operation; an aware wait
/// ends completed, 0.
fn delivery(id: Int64) -> Int32 {
    let i = waitAt(id)
    if i == waits.length {
        return 2
    }
    let mut st = waits[i].status
    if st == 2 && cancelling > 0 {
        if id > 0 {
            hostCancel(id)
        }
        st = 1
        if waits[i].aware {
            st = 0
        }
    }
    if st != 2 {
        waits.swapRemove(i)
    }
    return st
}

/// The payload the wake on `id` delivered, 0 until it came: a host wait that
/// answers a value reads it here before `delivery` ends the wait.
fn payloadOf(id: Int64) -> Int64 {
    let i = waitAt(id)
    if i == waits.length {
        return 0
    }
    return waits[i].payload
}

/// `stop` cancels a task by resuming it between `cancelBegin` and
/// `cancelEnd`: every wait the step reaches is cancelled, so each frame of the
/// task takes its cancellation edge.
fn cancelBegin() {
    cancelling = cancelling + 1
}

fn cancelEnd() {
    cancelling = cancelling - 1
}

/// `__vyrn_wake`: the host's operation `id` ended with `status`, 0 completed
/// or 1 cancelled, and `payload`. Returns how many tasks still wait.
fn wake(id: Int64, status: Int32, payload: Int64) -> Int32 {
    deliver(id, status, payload)
    drain()
    return pending()
}

/// How many tasks run or wait.
fn pending() -> Int32 {
    let mut n: Int32 = 0
    for r in runs {
        if r.state == 2 {
            n = n + 1
        }
    }
    return n
}

/// Whether the running task has no owner: its root then frees its block.
fn taskUnowned() -> Bool {
    let i = taskAt(running)
    return i < runs.length && !runs[i].owned
}

/// `main`'s exit code, 0 to 255, once it ended while a task ran.
let mut exitCode: Int64 = 0

let mut exiting: Bool = false

/// `main` ended with exit code `code`, 0 to 255. Answers whether a task still
/// runs: the exit then waits until `exitDue` answers the code.
fn mainEnd(code: Int64) -> Bool {
    if pending() == 0 {
        return false
    }
    exitCode = code
    exiting = true
    return true
}

/// `main`'s exit code once it ended and no task runs, else -1. The emitter's
/// `__vyrn_wake` asks after each wake.
fn exitDue() -> Int64 {
    if !exiting || pending() > 0 {
        return -1
    }
    return exitCode
}

/// Operation `id` ended with `status` and `payload`: the task that waits on
/// it joins the ready queue, once. A delivery that names no pending wait
/// changes nothing.
fn deliver(id: Int64, status: Int32, payload: Int64) {
    let i = waitAt(id)
    if i < waits.length && waits[i].status == 2 {
        waits[i].status = status
        waits[i].payload = payload
        let t = waits[i].task
        let mut j = readyAt
        while j < ready.length && ready[j] != t {
            j = j + 1
        }
        if j == ready.length {
            ready.push(t)
        }
    }
}

/// Runs the ready tasks in wake order until none is ready.
fn drain() {
    while readyAt < ready.length {
        let t = ready[readyAt]
        readyAt = readyAt + 1
        let k = taskAt(t)
        if k < runs.length {
            running = t
            let st = hostResume(runs[k].root, runs[k].frame)
            if UInt32(st) < 2 {
                taskEnd(t, st)
            }
            running = 0
        }
    }
    ready = []
    readyAt = 0
}

/// `__vyrn_trapped`: the running task trapped, so the host gave up its step and
/// it never ends. Forgets it and every wait it held, whose operations the host
/// drops, ends any cancellation the trap cut short, and returns the host's id
/// for the task: 0 for `main`'s, and when no task ran.
fn taskTrapped() -> Int64 {
    cancelling = 0
    let id = running
    running = 0
    let i = taskAt(id)
    if i == runs.length {
        return 0
    }
    let host = runs[i].host
    let owned = runs[i].owned
    let watching = runs[i].watch
    runs.swapRemove(i)
    let mut j: Int64 = 0
    while j < waits.length {
        if waits[j].task == id {
            if waits[j].id > 0 {
                hostCancel(waits[j].id)
            }
            waits.swapRemove(j)
        } else {
            j = j + 1
        }
    }
    // A trap ends an owned task alone, and its owner wakes to find it ended.
    if owned {
        deliver(watching, 0, 0)
        drain()
    }
    return host
}

// A `region` that holds an `await` has an arena of its own, so tasks that
// wait inside regions never bump or free one arena out of
// order. The emitter keeps the arena outside such a region in a local of the
// frame and calls these by name: `regionSwap(0)` where the region opens,
// `regionSwap` at each suspension and each resume inside it, `regionClose` at
// its closing brace, a `break`, a `continue` and a cancellation, and
// `regionCarry` at a `return`.

/// Makes `other` the arena and returns the arena it replaced.
fn regionSwap(other: Int64) -> Int64 {
    return arenaSwap(other, false)
}

/// Frees the region's arena and makes `outer` the arena again: `regionExit(0)`
/// frees every chunk but the oldest, which the swap hands back to `free`.
fn regionClose(outer: Int64) {
    regionExit(0)
    free(Int32(arenaSwap(outer, false)))
}

/// Hands the region's chunks to `outer`, whose region frees them: a `return`
/// carries a value out that may live in them.
fn regionCarry(outer: Int64) {
    let mine = arenaSwap(outer, false)
    if mine != 0 {
        arenaSwap(mine, true)
    }
}
