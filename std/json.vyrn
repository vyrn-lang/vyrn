/// std/json (RFC-0059) — the shared JSON value tree and its canonical writer,
/// written in plain Vyrn on `bytes`/`stringFromBytes`. Being ordinary
/// comptime-pure Vyrn, it is importable anywhere — the generators (`std/tw`,
/// `std/i18n`, `std/openapi`) are its first consumers, replacing three JSON
/// hand-rollers that were each lenient in a different way.
///
///   import { Json, JsonField, emit, emitPretty, jsonEq } from "std/json"
///   import { parseJson } from "std/jsonread"          // the reader
///
/// RFC-0078 M2a moved the reader to `std/jsonread`, which imports this module —
/// one direction only. This file therefore imports NOTHING, so a caller that only
/// serializes links only the writer. That matters because `toJson` became
/// exactly such a caller in RFC-0078 M2b: it links the tree and `emit` without
/// dragging in a parser, and the direct wasm backend compiles this half today
/// (the reader still wants `?` and `if let`, RFC-0077's own rows).
///
/// A `String` is UTF-8 bytes; all offsets are BYTE offsets (like `std/strings`).
/// `JNum` holds raw validated number text, so `emit` is byte-stable through a
/// parse and object field order is whatever the tree stores — deterministic
/// generators depend on both.

// ===========================================================================
// The value tree
// ===========================================================================

/// One `key: value` member of a JSON object.
export type JsonField = { key: String, value: Json }

/// A JSON value. `JNum` carries the RAW, validated number text (never a float):
/// generators compare and re-emit numbers, nobody needs float semantics at
/// comptime, and raw text makes emit → parse → emit byte-stable.
export type Json =
    | JNull
    | JBool(Bool)
    | JNum(String)
    | JStr(String)
    | JArr(Array<Json>)
    | JObj(Array<JsonField>)

/// The structural copy is refused for this type and says why: `Json` reaches
/// itself through `JArr` and `JObj`, and the builtin walk has no bottom to stop
/// at. Recursion in the value needs recursion in the code, and this is that code.
/// Every reader that looks a field out of an object needs it, because a field
/// belongs to the object that holds it and a return is owned (RFC-0092).
///
/// Declaring it as `impl Copy` is what RFC-0091 M1 added, and it is what makes
/// `j.copy()`, `fs.copy()` and `Array<Json>.copy()` mean this walk rather than
/// the refusal.
/// The two list walks stay hand-written: `xs.copy()` on an `Array<Json>` is the
/// structural walk again, one level out, and it is refused for the same reason.
/// A declared `Copy` is consulted for the value it is asked about and not for a
/// part of one.
impl Copy for Json {
    fn copy(self) -> Json {
        return match self {
            JNull => JNull,
            JBool(b) => JBool(b),
            JNum(s) => JNum(s.copy()),
            JStr(s) => JStr(s.copy()),
            JArr(xs) => JArr(copyJsonArray(xs)),
            JObj(fs) => JObj(copyJsonFields(fs)),
        }
    }
}

/// Hands one payload back to its own release row, so an arm can be an
/// EXPRESSION. `drop v` is a statement and a `match` arm is an expression, so
/// the release below cannot write `drop` in an arm. The row read is the row the
/// INSTANCE has (RFC-0090 M1) — one helper releases a `String`, an
/// `Array<Json>` and an `Array<JsonField>`, and the last two are where the
/// recursion lives. The twin of `std/vyx`'s `vyxGive`.
fn jsonGive<T>(v: consume T) -> Int64 {
    drop v
    return 0
}

/// A `Json` owns its subtree, and says so — RFC-0096 M2.
///
/// `Json` reaches itself through `JArr` and `JObj`, so the structural release
/// walk has no bottom and left every `Json` binding in the corpus unreclaimed.
/// A declaration IS a bottom: the walk emits a CALL here rather than expanding,
/// so every type ABOVE this one — `Array<Json>`, `JsonField`, `GqlVal`,
/// `RpcClientTypes` — gets its structural row back too.
///
/// It composes with `impl Copy for Json` above: a copy shares nothing, so
/// releasing both the original and the copy frees two distinct trees.
impl Owned for Json {
    fn release(consume self) {
        match consume self {
            JNull => 0,
            JBool(b) => 0,
            JNum(s) => jsonGive(s),
            JStr(s) => jsonGive(s),
            JArr(xs) => jsonGive(xs),
            JObj(fs) => jsonGive(fs),
        }
    }
}

/// A `Json` that shares nothing with `j` — the name this walk had before it was
/// a `Copy` impl. `j.copy()` says the same thing and is the one to write.
export fn copyJson(j: Json) -> Json {
    return j.copy()
}

/// `copy` over a list of values. Exported because `xs.copy()` cannot be written
/// for this element type — see the impl above.
export fn copyJsonArray(xs: Array<Json>) -> Array<Json> {
    let mut out: Array<Json> = []
    for x in xs {
        out.push(x.copy())
    }
    return out
}

/// `copy` over a list of object fields, for `xs.copy()`'s reason.
export fn copyJsonFields(fs: Array<JsonField>) -> Array<JsonField> {
    let mut out: Array<JsonField> = []
    for f in fs {
        out.push(JsonField { key: f.key.copy(), value: f.value.copy() })
    }
    return out
}

// ===========================================================================
// Writer — canonical, correct escaping (control chars as `\u00XX`), field order
// as stored. `emit` is compact; `emitPretty` indents.
// ===========================================================================

/// The lowercase 2-digit hex of a byte value 0..255.
fn hex2(b: Int64) -> String {
    // The digit table is read out of the literal rather than materialised with
    // `bytes()`, which built a fresh 16-element array on every call.
    let db = "0123456789abcdef"
    let mut out: Array<UInt8> = []
    out.push(db[(b / 16) % 16])
    out.push(db[b % 16])
    return match stringFromBytes(out) {
        Ok(v) => v,
        Err(e) => "",
    }
}

/// `s` as a JSON string literal (surrounding quotes included), escaping `"`, `\`,
/// the C0 control characters (`\b \t \n \f \r` short forms, `\u00XX` otherwise).
/// Multi-byte UTF-8 passes through verbatim (valid JSON permits raw UTF-8).
fn emitString(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    out.push('"')
    for b in ba {
        if b == '"' {
            out.push('\\')
            out.push('"')
        } else if b == '\\' {
            out.push('\\')
            out.push('\\')
        } else if b == '\x08' {
            out.push('\\')
            out.push('b')
        } else if b == '\t' {
            out.push('\\')
            out.push('t')
        } else if b == '\n' {
            out.push('\\')
            out.push('n')
        } else if b == '\x0c' {
            out.push('\\')
            out.push('f')
        } else if b == '\r' {
            out.push('\\')
            out.push('r')
        } else if b < 32 {
            out.push('\\')
            out.push('u')
            out.push('0')
            out.push('0')
            let h = hex2(Int64(b))
            let hb = bytes(h)
            out.push(hb[0])
            out.push(hb[1])
        } else {
            out.push(b)
        }
    }
    out.push('"')
    return match stringFromBytes(out) {
        Ok(v) => v,
        Err(e) => "",
    }
}

/// Whether `raw` is the text of a JSON number:
/// `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?` — the grammar
/// `std/jsonread`'s `parseNumber` accepts, so what this writer emits is what
/// that reader takes back.
fn numberOk(raw: String) -> Bool {
    let ba = bytes(raw)
    let mut i = 0
    if i < ba.length && ba[i] == '-' {
        i = i + 1
    }
    if i >= ba.length {
        return false
    }
    if ba[i] == '0' {
        i = i + 1
    } else if ba[i] >= '1' && ba[i] <= '9' {
        while i < ba.length && ba[i] >= '0' && ba[i] <= '9' {
            i = i + 1
        }
    } else {
        return false
    }
    if i < ba.length && ba[i] == '.' {
        i = i + 1
        let start = i
        while i < ba.length && ba[i] >= '0' && ba[i] <= '9' {
            i = i + 1
        }
        if i == start {
            return false
        }
    }
    if i < ba.length && (ba[i] == 'e' || ba[i] == 'E') {
        i = i + 1
        if i < ba.length && (ba[i] == '+' || ba[i] == '-') {
            i = i + 1
        }
        let start = i
        while i < ba.length && ba[i] >= '0' && ba[i] <= '9' {
            i = i + 1
        }
        if i == start {
            return false
        }
    }
    return i == ba.length
}

/// A `JNum`'s raw text, refusing what is not a JSON number.
///
/// `JNum` carries RAW text on purpose (emit → parse → emit is byte-stable), so
/// the constructor is a public `String` one and nothing stops `JNum("0x1f")`.
/// The check therefore lives HERE, where the value is written — beside the
/// escaping, the way `std/html` checks a name where it escapes a value — so one
/// funnel covers `emit`, `emitPretty` and every caller of either.
fn emitNumber(raw: String) -> String {
    if !numberOk(raw) {
        panic("json: `" + raw + "` is not a usable number — a `JNum` holds the RAW text of a JSON number (`-?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?`); text that is not one belongs in a `JStr`, which is escaped")
    }
    return raw.copy()
}

/// Emit a compact array body (`[...]`).
fn emitArr(items: Array<Json>) -> String {
    let mut out = "["
    let mut i = 0
    for it in items {
        if i > 0 {
            out = out + ","
        }
        out = out + emit(it)
        i = i + 1
    }
    return out + "]"
}

/// Emit a compact object body (`{...}`).
fn emitObj(fields: Array<JsonField>) -> String {
    let mut out = "{"
    let mut i = 0
    for f in fields {
        if i > 0 {
            out = out + ","
        }
        out = out + emitString(f.key) + ":" + emit(f.value)
        i = i + 1
    }
    return out + "}"
}

/// Emit `j` as compact JSON (no insignificant whitespace), field order as stored.
///
/// **The writers recurse per level, and they have no error channel to refuse a
/// tree with.** `emit`, `emitPretty`, `copyJson` and `jsonEq` all walk `Json`
/// structurally at about two frames a level, so a value nested past roughly 450
/// reaches the engine's 1000-frame call cap and traps. Where the depth comes from
/// UNTRUSTED bytes that is a defect, and it is fixed at the reader:
/// `std/jsonread`'s `maxDepth` refuses a document past 128 levels with an `Err`,
/// so nothing parsed can reach the ceiling here, and the round trip
/// `parse → emit` is covered end to end. What is left is a tree a program BUILT
/// that deep on purpose, which is the program's own bound to keep — a `String`
/// return has nowhere to say otherwise, and adding a `Result` to the serializer
/// every caller uses would pay for a case no input can cause.
export fn emit(j: Json) -> String {
    return match j {
        JNull => "null",
        JBool(b) => if b { "true" } else { "false" },
        JNum(raw) => emitNumber(raw),
        JStr(s) => emitString(s),
        JArr(items) => emitArr(items),
        JObj(fields) => emitObj(fields),
    }
}

/// `n` copies of a single space.
fn spaces(n: Int64) -> String {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + " "
        i = i + 1
    }
    return out
}

/// Pretty-print a non-empty array at `depth`.
fn prettyArr(items: Array<Json>, indent: Int64, depth: Int64) -> String {
    let pad = spaces((depth + 1) * indent)
    let close = spaces(depth * indent)
    let mut out = "[\n"
    let mut i = 0
    for it in items {
        if i > 0 {
            out = out + ",\n"
        }
        out = out + pad + emitPrettyAt(it, indent, depth + 1)
        i = i + 1
    }
    return out + "\n" + close + "]"
}

/// Pretty-print a non-empty object at `depth`.
fn prettyObj(fields: Array<JsonField>, indent: Int64, depth: Int64) -> String {
    let pad = spaces((depth + 1) * indent)
    let close = spaces(depth * indent)
    let mut out = "{\n"
    let mut i = 0
    for f in fields {
        if i > 0 {
            out = out + ",\n"
        }
        out = out + pad + emitString(f.key) + ": " + emitPrettyAt(f.value, indent, depth + 1)
        i = i + 1
    }
    return out + "\n" + close + "}"
}

/// The pretty printer, threading the current indentation `depth` (in `indent`-wide
/// steps). Compact for empty arrays/objects (`[]`/`{}`); a colon then a space
/// separates a key from its value.
fn emitPrettyAt(j: Json, indent: Int64, depth: Int64) -> String {
    return match j {
        JNull => "null",
        JBool(b) => if b { "true" } else { "false" },
        JNum(raw) => emitNumber(raw),
        JStr(s) => emitString(s),
        JArr(items) => if items.length == 0 { "[]" } else { prettyArr(items, indent, depth) },
        JObj(fields) => if fields.length == 0 { "{}" } else { prettyObj(fields, indent, depth) },
    }
}

/// Emit `j` as indented JSON, `indent` spaces per nesting level, field order as
/// stored. Empty arrays/objects stay compact (`[]`/`{}`).
export fn emitPretty(j: Json, indent: Int64) -> String {
    return emitPrettyAt(j, indent, 0)
}

// ===========================================================================
// Structural equality — the round-trip law's witness.
// ===========================================================================

/// Deep structural equality of two `Json` trees, defined as CANONICAL-EMIT
/// equality: `emit` is injective over `Json` (distinct kinds carry distinct
/// delimiters, object field order is preserved, numbers keep their raw text), so
/// two trees serialize to the same bytes iff they are structurally identical.
/// This is exact structural equality and needs no wildcard match — the language
/// has none, and `==` is scalar-only, so a hand-written recursive comparator
/// would need every variant pair spelled out; the canonical form is the tool
/// consumers (and the round-trip test) use to compare trees.
export fn jsonEq(a: Json, b: Json) -> Bool {
    return emit(a) == emit(b)
}

// ===========================================================================
// Tests — the writer only; the reader's own tests live in `std/jsonread`.
// ===========================================================================

test "emits compact JSON with correct escaping" {
    assertEq(emit(JNull), "null")
    assertEq(emit(JArr([JNum("1"), JStr("a\nb")])), "[1,\"a\\nb\"]")
    // a control char below the short-form set emits as \u00XX
    let ctrl = match stringFromBytes(['x', '\x01', 'y']) {
        Ok(v) => v,
        Err(e) => "",
    }
    assertEq(emit(JStr(ctrl)), "\"x\\u0001y\"")
    assertEq(emit(JObj([JsonField { key: "k", value: JBool(true) }])), "{\"k\":true}")
}

test "emitPretty indents nested structures" {
    let j = JObj([JsonField { key: "a", value: JArr([JNum("1"), JNum("2")]) }])
    assertEq(emitPretty(j, 2), "{\n  \"a\": [\n    1,\n    2\n  ]\n}")
    // empty collections stay compact
    assertEq(emitPretty(JArr([]), 2), "[]")
    assertEq(emitPretty(JObj([]), 2), "{}")
}

test "hex2 writes two lowercase nibbles" {
    // A JSON control-character escape goes through this. The table it reads is
    // an implementation detail; these four outputs are not.
    assertEq(hex2(0), "00")
    assertEq(hex2(9), "09")
    assertEq(hex2(31), "1f")
    assertEq(hex2(255), "ff")
}
