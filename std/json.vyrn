/// std/json: the JSON value tree and its canonical writer.
///
///   import { Json, JsonField, emit, emitPretty, jsonEq } from "std/json"
///   import { parseJson } from "std/jsonread"
///
/// This module imports nothing; the reader, `std/jsonread`, imports it. So a
/// caller that only serializes, such as `toJson`, links no parser. `JNum` holds
/// raw number text and objects keep their stored field order, so `emit` is
/// byte-stable through a parse and generators can depend on the order.

export type JsonField = { key: String, value: Json }

/// A JSON value. `JNum` holds the raw, validated number text, never a float,
/// so emit -> parse -> emit is byte-stable.
export type Json =
    | JNull
    | JBool(Bool)
    | JNum(String)
    | JStr(String)
    | JArr(Array<Json>)
    | JObj(Array<JsonField>)

/// A hand-written copy: `Json` reaches itself through `JArr` and `JObj`, so the
/// structural copy has no bottom and is refused. The declaration covers a
/// `Json` value, not an array of them, so the list walks stay hand-written.
impl Copy for Json {
    fn copy(self) -> Json {
        return match self {
            JNull => JNull,
            JBool(b) => JBool(b),
            JNum(s) => JNum(s.copy()),
            JStr(s) => JStr(s.copy()),
            JArr(xs) => JArr(copyJsonArray(xs)),
            JObj(fs) => JObj(copyJsonFields(fs)),
        }
    }
}

/// `Json` reaches itself, so the structural release has no bottom. This
/// declaration is that bottom: the walk calls it, and every type above `Json`
/// (`Array<Json>`, `JsonField`) keeps its structural release. A copy shares
/// nothing, so releasing an original and its copy frees two trees.
impl Owned for Json {
    fn release(consume self) {
        match consume self {
            JNull => {}
            JBool(b) => {}
            JNum(s) => {
                drop s
            }
            JStr(s) => {
                drop s
            }
            JArr(xs) => {
                drop xs
            }
            JObj(fs) => {
                drop fs
            }
        }
    }
}

/// A `Json` that shares nothing with `j`; same as `j.copy()`.
export fn copyJson(j: Json) -> Json {
    return j.copy()
}

/// The reading projections: `j[i]` is an element of a `JArr` and
/// `j.field(key)` a member of a `JObj`, read in place with no copy. Both trap on
/// a kind mismatch or a miss, as `a[i]` traps out of range. For a result that
/// outlives the document, use `elemAt` and `fieldAt` in `std/jsondec`.
impl Index for Json {
    fn at(read self, i: Int64) -> read Json {
        let JArr(items) = self
        return items[i]
    }

    fn field(read self, key: String) -> read Json {
        let JObj(fields) = self
        let mut hit = 0 - 1
        let mut k = 0
        while k < fields.length {
            if fields[k].key == key {
                hit = k
                break
            }
            k = k + 1
        }
        if hit < 0 {
            panic("json: no field `\{key}`")
        }
        return fields[hit].value
    }

    /// The member's place on a hit, `None` on a miss; a miss is an absent key
    /// or a non-object. Nothing is copied.
    fn tryField(read self, key: String) -> read Option<Json> {
        let mut hit = 0 - 1
        if let JObj(scan) = self {
            let mut k = 0
            while k < scan.length {
                if scan[k].key == key {
                    hit = k
                    break
                }
                k = k + 1
            }
        }
        if hit < 0 {
            return None
        }
        let JObj(fields) = self
        return Some(fields[hit].value)
    }
}

/// `copy` over a list of values; `xs.copy()` is refused for this element type.
export fn copyJsonArray(xs: Array<Json>) -> Array<Json> {
    let mut out: Array<Json> = []
    for x in xs {
        out.push(x.copy())
    }
    return out
}

/// `copy` over a list of object fields, for the same reason.
export fn copyJsonFields(fs: Array<JsonField>) -> Array<JsonField> {
    let mut out: Array<JsonField> = []
    for f in fs {
        out.push(JsonField { key: f.key.copy(), value: f.value.copy() })
    }
    return out
}

/// A copy of the tree with every object's fields in byte order, recursively.
/// Use it for one emission (a diff, content-addressed output); the stored
/// order, which mirrors a `Map`'s insertion order, never moves.
export fn sortKeys(j: Json) -> Json {
    return match j {
        JNull => JNull,
        JBool(b) => JBool(b),
        JNum(s) => JNum(s.copy()),
        JStr(s) => JStr(s.copy()),
        JArr(xs) => JArr(sortKeysArray(xs)),
        JObj(fs) => JObj(sortKeysFields(fs)),
    }
}

fn sortKeysArray(xs: Array<Json>) -> Array<Json> {
    let mut out: Array<Json> = []
    for x in xs {
        out.push(sortKeys(x))
    }
    return out
}

/// The fields in key order by repeated minimum. Strict `<` takes the first of
/// equal keys, so the order is stable. Each field is copied once and none is
/// swapped, because `JsonField.copy()` is refused.
fn sortKeysFields(fs: Array<JsonField>) -> Array<JsonField> {
    let mut used: Array<Bool> = []
    let mut i = 0
    while i < fs.length {
        used.push(false)
        i = i + 1
    }
    let mut out: Array<JsonField> = []
    let mut made = 0
    while made < fs.length {
        let mut best = 0 - 1
        let mut k = 0
        while k < fs.length {
            if used[k] == false && (best < 0 || fs[k].key < fs[best].key) {
                best = k
            }
            k = k + 1
        }
        used[best] = true
        out.push(JsonField { key: fs[best].key.copy(), value: sortKeys(fs[best].value) })
        made = made + 1
    }
    return out
}

/// The lowercase 2-digit hex of a byte value 0..255.
fn hex2(b: Int64) -> String {
    // Index the literal: `bytes()` would build a 16-element array per call.
    let db = "0123456789abcdef"
    let mut out: Array<UInt8> = []
    out.push(db[(b / 16) % 16])
    out.push(db[b % 16])
    return match stringFromBytes(out) {
        Ok(v) => v,
        Err(e) => "",
    }
}

/// `s` as a quoted JSON string literal. Escapes `"`, `\` and the C0 controls
/// (short forms where JSON has one, `\u00XX` otherwise); passes other UTF-8
/// through raw.
fn emitString(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    out.push('"')
    for b in ba {
        if b == '"' {
            out.push('\\')
            out.push('"')
        } else if b == '\\' {
            out.push('\\')
            out.push('\\')
        } else if b == '\x08' {
            out.push('\\')
            out.push('b')
        } else if b == '\t' {
            out.push('\\')
            out.push('t')
        } else if b == '\n' {
            out.push('\\')
            out.push('n')
        } else if b == '\x0c' {
            out.push('\\')
            out.push('f')
        } else if b == '\r' {
            out.push('\\')
            out.push('r')
        } else if b < 32 {
            out.push('\\')
            out.push('u')
            out.push('0')
            out.push('0')
            let h = hex2(Int64(b))
            let hb = bytes(h)
            out.push(hb[0])
            out.push(hb[1])
        } else {
            out.push(b)
        }
    }
    out.push('"')
    return match stringFromBytes(out) {
        Ok(v) => v,
        Err(e) => "",
    }
}

/// Whether `raw` is a JSON number:
/// `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?`, the grammar `std/jsonread`
/// accepts.
fn numberOk(raw: String) -> Bool {
    let ba = bytes(raw)
    let mut i = 0
    if i < ba.length && ba[i] == '-' {
        i = i + 1
    }
    if i >= ba.length {
        return false
    }
    if ba[i] == '0' {
        i = i + 1
    } else if ba[i] >= '1' && ba[i] <= '9' {
        while i < ba.length && ba[i] >= '0' && ba[i] <= '9' {
            i = i + 1
        }
    } else {
        return false
    }
    if i < ba.length && ba[i] == '.' {
        i = i + 1
        let start = i
        while i < ba.length && ba[i] >= '0' && ba[i] <= '9' {
            i = i + 1
        }
        if i == start {
            return false
        }
    }
    if i < ba.length && (ba[i] == 'e' || ba[i] == 'E') {
        i = i + 1
        if i < ba.length && (ba[i] == '+' || ba[i] == '-') {
            i = i + 1
        }
        let start = i
        while i < ba.length && ba[i] >= '0' && ba[i] <= '9' {
            i = i + 1
        }
        if i == start {
            return false
        }
    }
    return i == ba.length
}

/// A `JNum`'s raw text; panics if it is not a JSON number. `JNum` is a public
/// constructor over any `String`, so the check sits where every writer emits.
fn emitNumber(raw: String) -> String {
    if !numberOk(raw) {
        panic("json: `" + raw + "` is not a usable number — a `JNum` holds the RAW text of a JSON number (`-?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?`); text that is not one belongs in a `JStr`, which is escaped")
    }
    return raw.copy()
}

fn emitArr(items: Array<Json>) -> String {
    let mut out = "["
    let mut i = 0
    for it in items {
        if i > 0 {
            out = out + ","
        }
        out = out + emit(it)
        i = i + 1
    }
    return out + "]"
}

fn emitObj(fields: Array<JsonField>) -> String {
    let mut out = "{"
    let mut i = 0
    for f in fields {
        if i > 0 {
            out = out + ","
        }
        out = out + emitString(f.key) + ":" + emit(f.value)
        i = i + 1
    }
    return out + "}"
}

/// Emit `j` as compact JSON, field order as stored.
///
/// The writers, `copyJson` and `jsonEq` recurse at about two frames a level,
/// so a tree nested past about 450 levels traps at the engine's call cap.
/// `parseJson` refuses input past 128 levels, so only a tree a program builds
/// that deep can reach the cap; bounding it is the program's job.
export fn emit(j: Json) -> String {
    return match j {
        JNull => "null",
        JBool(b) => if b { "true" } else { "false" },
        JNum(raw) => emitNumber(raw),
        JStr(s) => emitString(s),
        JArr(items) => emitArr(items),
        JObj(fields) => emitObj(fields),
    }
}

/// `n` spaces, built as bytes: a string append per character would make
/// pretty printing at least cubic in nesting depth.
fn spaces(n: Int64) -> String {
    let mut b: Array<UInt8> = []
    b.reserve(n)
    let mut i = 0
    while i < n {
        b.push(' ')
        i = i + 1
    }
    return stringFromBytes(b) ?? panic("spaces: ASCII spaces are UTF-8")
}

/// The pretty printer's one accumulator. Returning strings per level would
/// copy every child's output into its parent, and a `modify` parameter copies
/// at every call. `emitPretty` resets it, copies the result out and empties it.
let mut prettyOut = ""

fn prettyIntoAt(j: Json, indent: Int64, depth: Int64) {
    match j {
        JNull => {
            prettyOut = prettyOut + "null"
        }
        JBool(b) => {
            prettyOut = prettyOut + (if b { "true" } else { "false" })
        }
        JNum(raw) => {
            prettyOut = prettyOut + emitNumber(raw)
        }
        JStr(s) => {
            prettyOut = prettyOut + emitString(s)
        }
        JArr(items) => {
            if items.length == 0 {
                prettyOut = prettyOut + "[]"
            } else {
                let pad = spaces((depth + 1) * indent)
                prettyOut = prettyOut + "[\n"
                let mut i = 0
                for it in items {
                    if i > 0 {
                        prettyOut = prettyOut + ",\n"
                    }
                    prettyOut = prettyOut + pad
                    prettyIntoAt(it, indent, depth + 1)
                    i = i + 1
                }
                prettyOut = prettyOut + "\n" + spaces(depth * indent) + "]"
            }
        }
        JObj(fields) => {
            if fields.length == 0 {
                prettyOut = prettyOut + "{}"
            } else {
                let pad = spaces((depth + 1) * indent)
                prettyOut = prettyOut + "{\n"
                let mut i = 0
                for f in fields {
                    if i > 0 {
                        prettyOut = prettyOut + ",\n"
                    }
                    prettyOut = prettyOut + pad + emitString(f.key) + ": "
                    prettyIntoAt(f.value, indent, depth + 1)
                    i = i + 1
                }
                prettyOut = prettyOut + "\n" + spaces(depth * indent) + "}"
            }
        }
    }
}

/// Emit `j` as indented JSON, `indent` spaces per level, field order as
/// stored. Empty arrays and objects stay compact (`[]`, `{}`).
export fn emitPretty(j: Json, indent: Int64) -> String {
    prettyOut = ""
    prettyIntoAt(j, indent, 0)
    let out = prettyOut.copy()
    prettyOut = ""
    return out
}

/// Deep structural equality, as equality of canonical emits: `emit` is
/// injective over `Json`, because kinds have distinct delimiters, field order
/// is kept and numbers keep their raw text.
export fn jsonEq(a: Json, b: Json) -> Bool {
    return emit(a) == emit(b)
}

/// Writes the encoders `toJson` calls: for each root, the function that renders
/// its value, and for each node, the function that builds its `Json` tree.
/// Generated source cannot spell this module's reserved names, so it writes
/// them as `VyrnRt_` placeholders the compiler folds back.
export gen fn jsonEncoders(t: TypeArg) -> String {
    let mut out = ""
    for r in t.roots {
        let n = t.nodes[r]
        // Bound, not returned inline: an argument temporary's tree would leak.
        out = out + "fn " + n.name + "(v: " + n.spelling + ") -> String {\n"
        out = out + "    let t: VyrnRt_Json = e" + n.name + "(v)\n    let s = VyrnRt_emit(t)\n    return s\n}\n"
    }
    for n in t.nodes {
        out = out + "fn e" + n.name + "(v: " + n.spelling + ") -> VyrnRt_Json {\n"
        out = out + jsonEncoderBody(t, n) + "}\n"
    }
    return out
}

gen fn jsonEncoderBody(t: TypeArg, n: TypeNode) -> String {
    let fs = "    let mut fs: Array<VyrnRt_JsonField> = []\n"
    if n.kind == "record" {
        let mut out = fs
        for m in n.members {
            let f = t.nodes[m.args[0]]
            // A `None` field is omitted; `push` returns the array.
            if f.kind == "option" {
                out = out + "    fs = match v." + m.name + " { Some(x) => fs.push(VyrnRt_JsonField { key: \"" + m.name + "\", value: e" + t.nodes[f.args[0]].name + "(x) }), None => fs }\n"
            } else {
                out = out + "    fs.push(VyrnRt_JsonField { key: \"" + m.name + "\", value: e" + f.name + "(v." + m.name + ") })\n"
            }
        }
        return out + "    return VyrnRt_JObj(fs)\n"
    }
    if n.kind == "option" {
        return "    return match v { Some(x) => e" + t.nodes[n.args[0]].name + "(x), None => VyrnRt_JNull }\n"
    }
    if n.kind == "array" {
        return "    let mut out: Array<VyrnRt_Json> = []\n    for it in v { out.push(e" + t.nodes[n.args[0]].name + "(it)) }\n    return VyrnRt_JArr(out)\n"
    }
    if n.kind == "map" {
        // An `Int64` key is the decimal text `toString` writes.
        let key = if t.nodes[n.args[0]].kind == "String" { "k" } else { "k.toString()" }
        return fs + "    for k in v.keys() {\n        fs = match v[k] { Some(x) => fs.push(VyrnRt_JsonField { key: " + key + ", value: e" + t.nodes[n.args[1]].name + "(x) }), None => fs }\n    }\n    return VyrnRt_JObj(fs)\n"
    }
    if n.kind == "enum" {
        let mut arms = ""
        for m in n.members {
            arms = arms + "        " + jsonVariant(t, m) + ",\n"
        }
        return "    return match v {\n" + arms + "    }\n"
    }
    if n.kind == "Bool" {
        return "    return VyrnRt_JBool(v)\n"
    }
    // Copied: `v` is a `read` parameter and the tree outlives the call.
    if n.kind == "String" {
        return "    return VyrnRt_JStr(v.copy())\n"
    }
    return "    return VyrnRt_JNum(v.toString())\n"
}

/// One match arm in wire form: a nullary variant is a bare string, one payload
/// `{"Tag":<v>}`, several `{"Tag":[..]}`.
gen fn jsonVariant(t: TypeArg, m: TypeMember) -> String {
    if m.args.length == 0 {
        return m.name + " => VyrnRt_JStr(\"" + m.name + "\")"
    }
    let mut binds = ""
    let mut items = ""
    let mut i = 0
    for a in m.args {
        let sep = if i == 0 { "" } else { ", " }
        binds = binds + sep + "p" + i.toString()
        items = items + sep + "e" + t.nodes[a].name + "(p" + i.toString() + ")"
        i = i + 1
    }
    let value = if m.args.length == 1 { items } else { "VyrnRt_JArr([" + items + "])" }
    return m.name + "(" + binds + ") => VyrnRt_JObj([VyrnRt_JsonField { key: \"" + m.name + "\", value: " + value + " }])"
}

test "emits compact JSON with correct escaping" {
    assertEq(emit(JNull), "null")
    assertEq(emit(JArr([JNum("1"), JStr("a\nb")])), "[1,\"a\\nb\"]")
    // A control byte without a short form emits as \u00XX.
    let ctrl = match stringFromBytes(['x', '\x01', 'y']) {
        Ok(v) => v,
        Err(e) => "",
    }
    assertEq(emit(JStr(ctrl)), "\"x\\u0001y\"")
    assertEq(emit(JObj([JsonField { key: "k", value: JBool(true) }])), "{\"k\":true}")
}

test "emitPretty indents nested structures" {
    let j = JObj([JsonField { key: "a", value: JArr([JNum("1"), JNum("2")]) }])
    assertEq(emitPretty(j, 2), "{\n  \"a\": [\n    1,\n    2\n  ]\n}")
    assertEq(emitPretty(JArr([]), 2), "[]")
    assertEq(emitPretty(JObj([]), 2), "{}")
}

test "sortKeys orders every object recursively and moves nothing stored" {
    let j = JObj([
        JsonField { key: "b", value: JNum("1") },
        JsonField {
            key: "a",
            value: JObj([
                JsonField { key: "z", value: JNull },
                JsonField { key: "y", value: JNull },
            ]),
        },
    ])
    assertEq(emit(sortKeys(j)), "{\"a\":{\"y\":null,\"z\":null},\"b\":1}")
    // The source tree keeps its stored order.
    assertEq(emit(j), "{\"b\":1,\"a\":{\"z\":null,\"y\":null}}")
}

test "hex2 writes two lowercase nibbles" {
    assertEq(hex2(0), "00")
    assertEq(hex2(9), "09")
    assertEq(hex2(31), "1f")
    assertEq(hex2(255), "ff")
}
