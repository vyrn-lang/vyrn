/// The `Code` helpers a generator writes in Vyrn: list forms over code quotes.
///
/// A quote holds holes only, and logic lives in ordinary functions that return
/// `Code`. `join` is the one list form: a hole takes no `Array<Code>`.
///
/// ```vyrn
/// import { join } from "std/code"
///
/// export gen fn sum(names: Array<String>) -> Code {
///     let mut terms: Array<Code> = []
///     for n in names {
///         terms.push(vyrn"\{name(n)}()")
///     }
///     return vyrn"export fn total() -> Int64 { return \{join(terms, vyrn" + ")} }"
/// }
/// ```

/// Joins `xs` with `sep` between each pair; no element gives empty `Code`.
export gen fn join(xs: Array<Code>, sep: Code) -> Code {
    let mut out = vyrn""
    let mut i = 0
    while i < xs.length {
        if i > 0 {
            out = out + sep
        }
        out = out + xs[i]
        i = i + 1
    }
    return out
}

/// One arm of an `if` chain ([`ifChain`]): `if cond { body }`.
export gen fn arm(cond: Code, body: Code) -> Code {
    return vyrn"""
        if \{cond} {
            \{body}
        }
        """
}

/// The `arms` in order, each after the first behind `else`: `if c0 { b0 }
/// else if c1 { b1 }`. Each arm is one [`arm`]; no arms is no chain.
export gen fn ifChain(arms: Array<Code>) -> Code {
    let mut out = vyrn""
    let mut sep = vyrn""
    for a in arms {
        out = out + sep + a
        sep = vyrn" else "
    }
    return out
}

/// [`ifChain`] closed by `else { last }`; no arms is `last` alone.
export gen fn ifChainOr(arms: Array<Code>, last: Code) -> Code {
    if arms.length == 0 {
        return last
    }
    return ifChain(arms) + vyrn" else " + vyrn"{ \{last} }"
}
