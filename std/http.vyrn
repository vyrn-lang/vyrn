/// std/http — the REST projection (RFC-0074 M1), a library over the same
/// procedures the derived RPC surface reflects on. The compiler knows nothing
/// about routes: everything below is either an ordinary record moved around at
/// runtime or generated Vyrn source over `moduleInterface` reflection, exactly
/// as `std/rpc`, `std/openapi` and `std/graphql` are.
///
/// A projection is opt-in and hand-written, because `GET /pastes/{id}` is API
/// *design* — no reflection can derive it, and deriving it would need the magic
/// naming conventions RFC-0072 exists to remove. You write one when you publish
/// a public API, and not before:
///
/// ```vyrn
/// // server/api/pastes.http.vyrn — base path `/pastes`, from the stem.
/// import { http, Route, GET, POST } from "std/http"
/// import { recent, byId, create } from http("./pastes")
///
/// export fn routes() -> Array<Route> {
///     return [GET(recent("/")), GET(byId("/{id}")), POST(create("/"))]
/// }
/// ```
///
/// **The chain is value-level, not type-level.** `Route` is `Route` after every
/// call — `GET(..)` takes a `Route` and hands back a `Route`, and so does every
/// method of `Policy` below. Nothing accumulates in the type, so the
/// fortieth route costs the checker one more nominal value rather than a wider
/// instantiation. That is the property this design exists to keep.
///
/// The shape is `GET(byId("/{id}"))` and not the RFC's `get("/{id}", byId)`, for
/// one reason: the pattern has to sit in the *procedure's own* parameter slot for
/// its placeholders to be checked at compile time. `byId`'s generated parameter
/// type is a `String where value =~ …` admitting exactly the placeholders `IdReq`
/// has fields for, so `byId("/{ID}")` is a checker error at the call site and
/// needs neither RFC-0073's symbol map nor a compiler rule. A uniform
/// `GET(pattern, proc)` cannot do that: it would have to be generic over the
/// signature, and a generic cannot name a type to `fromJson` — the first argument
/// there must be a declared type name, which is precisely what a type parameter
/// is not.

import { Json, JsonField, copyJsonFields, emit } from "std/json"
import { parseJson } from "std/jsonread"
import { fromBytesOr, indexOf, joinWith, padStart, replace, split, substring, toHex, trim } from "std/strings"
// The ETag hash and the `Last-Modified` calendar, both already in std and both
// pure: FNV-1a-64 is what `examples/bin` content-addresses pastes with, and
// `std/time`'s breakdown is the parity citizen its own docs promise (only `now()`
// is a host effect, and nothing here calls it).
import { fnv1aStr, sha1 } from "std/hash"
// The WebSocket handshake's one transform (RFC-0074 M3b): `base64(SHA-1(key +
// GUID))`, both halves already in std and both pure. `sha1` is there as a nonce
// transform rather than as a security primitive, which is the first thing its
// doc comment says.
import { base64EncodeBytes } from "std/codecs"
import { civil, fromMillis, hour, minute, second } from "std/time"

// The procedure rule, imported rather than restated: a projection publishes the
// very procedures the derived RPC surface reflects on, in the same codec, so
// "what is a procedure" is one rule (RFC-0072 M2) with one message. A second
// copy would be a second thing to drift.
import { validateContract } from "std/rpc"

// The symbol map (RFC-0073 M1). A projection re-exports each procedure under the
// DECLARATION's own name, so nothing in the emitted source says that the `create`
// a projection file imports is the `create` in `pastes.vyrn` — the map is the
// only record, and M4's rename is what needs it: renaming the declaration has to
// move the projection's import and its `POST(create("/"))` with it. No derived
// facts, because a projection's paths are written in the projection file rather
// than derived here.
import { Symbol, symbol, symbolMapFn } from "std/symbolmap"

// ---- the values ------------------------------------------------------------

/// What a mounted route runs: the request, plus the placeholder bindings the
/// pattern captured. `None` declines — a whole mounted subsystem (the derived RPC
/// surface, a page router) answers for some paths under its prefix and passes on
/// the rest, and `mount` continues to the next group when it does.
export type Handler = fn(Request, Map<String, String>) -> Option<Response>

/// A whole mounted subsystem: it takes the request and nothing else, because a
/// prefix binds no placeholders. `rpcHandle` and a page router already have this
/// shape (the RFC-0016 `handle` convention).
export type Surface = fn(Request) -> Option<Response>

/// `notFoundWhen`'s question, asked of the `Err` payload a procedure returned:
/// "is THIS the absence this resource is named after?" A `String` and not the
/// procedure's own error type, because `Route` erases the signature — and that
/// erasure is the property the whole design exists to keep.
export type IsMissing = fn(String) -> Bool

/// One route: an HTTP method, a full path pattern (base + sub-path), what runs,
/// and the `derived` policy line the diagnostics quote. `prefix` marks a whole
/// subsystem mounted under `pattern` rather than a single path, and selects
/// which of the two callables `mount` invokes.
///
/// `method` is `""` until a method constructor sets it — a route that reaches
/// `mount` without one is a startup error, not a silent GET.
///
/// Two fn fields rather than one plus an adapting closure. M1 chose this because
/// `|req, ps| run(req)` — a lambda CALLING a captured `fn`-typed parameter — did
/// not lower in either compiled backend; that hole is closed and the shape stays
/// anyway, now as a choice rather than a workaround. An adapter would allocate a
/// capture block per mounted subsystem and turn a field read into a dispatch on
/// every request; two fields cost a word and no closure at all, and each route
/// leaves the one it does not use at a named never-answers stub.
///
/// The M2 policy fields below are flat on `Route` rather than nested in a
/// `Policy` record, for one reason: nesting would put a `fn` value one level
/// deeper inside a record that is copied on every combinator, and M1 already paid
/// for finding out which `fn`-in-a-record shapes lower on all three engines. Flat
/// costs one `httpCopy` listing thirteen fields; nested would have cost the same
/// listing plus a shape nobody has proven.
export type Route = {
    method: String,
    pattern: String,
    prefix: Bool,
    run: Handler,
    whole: Surface,
    derived: String,
    // `Cache-Control: max-age=N`; `-1` writes no header (`cacheFor`).
    maxAge: Int64,
    // Whether to compute an `ETag` and answer conditionals with it (`etag`).
    validator: Bool,
    // The response field carrying epoch millis for `Last-Modified`; `""` none.
    modified: String,
    // The `Vary` header this route forces; `""` keeps what the handler said.
    varyOn: String,
    // A success status that replaces the handler's; `0` keeps it (`status`).
    ok: Int64,
    // A `Location` template like `/pastes/{id}`; `""` none (`createdAt`).
    location: String,
    // Which `Err` payloads mean 404 (`notFoundWhen`).
    missing: IsMissing,
}

/// The `run` of a prefix route, and the `whole` of a path route: never called,
/// because `prefix` decides which field `mount` reaches for.
fn httpNoRun(req: Request, ps: Map<String, String>) -> Option<Response> {
    return None
}

fn httpNoWhole(req: Request) -> Option<Response> {
    return None
}

/// The default `notFoundWhen`: nothing is an absence until the route says so. A
/// named function rather than a `|why| false` lambda, so a fresh `Route` holds a
/// real `fn` value before any combinator has run.
fn httpNeverMissing(why: String) -> Bool {
    return false
}

/// Build a route with no method yet. What a generated per-procedure constructor
/// calls; `pattern` is already base-qualified.
export fn httpRoute(pattern: String, run: Handler, derived: String) -> Route {
    return Route {
        method: "",
        pattern: httpTidy(pattern),
        prefix: false,
        run: run.copy(),
        whole: httpNoWhole,
        derived: derived.copy(),
        maxAge: -1,
        validator: false,
        modified: "",
        varyOn: "",
        ok: 0,
        location: "",
        missing: httpNeverMissing,
    }
}

/// Every field of `r`, so a combinator can set the one it owns and leave the rest
/// alone. Vyrn has no record-update syntax, so this is written once here instead
/// of thirteen times in each of the seven combinators.
fn httpCopy(r: Route) -> Route {
    return Route {
        method: r.method.copy(),
        pattern: r.pattern.copy(),
        prefix: r.prefix,
        run: r.run.copy(),
        whole: r.whole.copy(),
        derived: r.derived.copy(),
        maxAge: r.maxAge,
        validator: r.validator,
        modified: r.modified.copy(),
        varyOn: r.varyOn.copy(),
        ok: r.ok,
        location: r.location.copy(),
        missing: r.missing.copy(),
    }
}

/// `/pastes/` => `/pastes`, `//` => `/`. The base and the sub-path are joined by
/// concatenation, so `GET(recent("/"))` would otherwise mount `/pastes/` and miss
/// the URL everyone actually types.
fn httpTidy(pattern: String) -> String {
    if pattern == "" {
        return "/"
    }
    if pattern.endsWith("/") && pattern != "/" {
        return substring(pattern, 0, pattern.byteLength - 1)
    }
    return pattern.copy()
}

/// `GET` this route. The four below are the same call with another verb; the
/// vocabulary is HTTP's, so `PUT` and `PATCH` are separate words rather than one
/// `method("PUT")` taking a string nobody can complete or spell-check.
///
/// UPPERCASE, against the house style. `get` was RESERVED when this was
/// written — the `cell`/`Ref` builtins dispatched before user functions — and
/// RFC-0090 M4 deleted those builtins, so the name is free now (`std/slots`
/// took it). The spelling stays: `GET` is what the method IS, and the five
/// verbs are one vocabulary spelled one way. `get` alone in lowercase would
/// read as this module's reader rather than as a route's method.
export fn GET(r: Route) -> Route {
    return httpWithMethod(r, "GET")
}

export fn POST(r: Route) -> Route {
    return httpWithMethod(r, "POST")
}

export fn PUT(r: Route) -> Route {
    return httpWithMethod(r, "PUT")
}

export fn PATCH(r: Route) -> Route {
    return httpWithMethod(r, "PATCH")
}

export fn DELETE(r: Route) -> Route {
    return httpWithMethod(r, "DELETE")
}

fn httpWithMethod(r: Route, method: String) -> Route {
    let line = method + " " + r.pattern + " " + r.derived
    let mut out = httpCopy(r)
    out.method = method.copy()
    out.derived = line
    return out
}

/// A whole subsystem mounted under `prefix`: the derived RPC surface, a page
/// router. It answers with `Some` or declines with `None` — the same
/// `handle`-convention shape those already have (RFC-0016) — so mounting one
/// costs no adapter at the composition root.
export fn surface(prefix: String, run: consume Surface) -> Route {
    return Route {
        method: "*",
        pattern: httpTidy(prefix),
        prefix: true,
        run: httpNoRun,
        whole: run,
        derived: "* " + prefix + " (surface)",
        maxAge: -1,
        validator: false,
        modified: "",
        varyOn: "",
        ok: 0,
        location: "",
        missing: httpNeverMissing,
    }
}

// ---- cache and validators (M2) ---------------------------------------------

/// The route policy: seven methods, each `Route -> Route`, so the chain stays
/// value-level — the fortieth route with the fortieth policy is still one
/// nominal value to the checker, and `Route` gains no type parameter.
///
/// They shipped as PREFIX functions (`etag(cacheFor(GET(byId("/{id}")), 3600))`)
/// because a method call on a user value needs a protocol impl and `impl P for
/// Route` was refused outright: a record carried no runtime name for the
/// interpreter to dispatch on. RFC-0084 M1 removed the refusal and M2 lifted the
/// native backend's variable-receiver rule, which is what a chain actually needs
/// — every receiver after the first is a call. So this is RFC-0074's own designed
/// spelling, three milestones late:
///
/// ```vyrn
/// GET(byId("/{id}")).cacheFor(3600).etag().notFoundWhen(|why| why == "no such user")
/// ```
///
/// There are no free-function versions left. Two spellings of one combinator
/// would be two things to keep in step, and the checker would not have them
/// anyway: a protocol method and a top-level function cannot share a name.
export protocol Policy {
    /// `Cache-Control: max-age=N` on a successful answer.
    ///
    /// Deliberately NOT `public` and not `private`. `public` would tell a shared
    /// cache to store a response it is otherwise forbidden to store — the one for
    /// a request that carried `Authorization` (RFC 9111 §3.5) — which is the
    /// cache-poisoning shape, one user's copy served to the next. `private` would
    /// make `cacheFor` useless for the public API this projection exists to
    /// publish. Bare `max-age` gets both: a CDN may cache the anonymous GET, and
    /// the spec's own default already refuses the credentialed one.
    fn cacheFor(self, seconds: Int64) -> Route

    /// A strong `ETag`, and `If-None-Match` answered with 304.
    ///
    /// The validator is `FNV-1a-64(contentType + "\n" + body)` in hex. It hashes
    /// the REPRESENTATION — the bytes plus the media type that says how to read
    /// them — because two `Vary`-selected variants of one URL are different
    /// representations and must not share a validator. It hashes CONTENT and
    /// nothing else: no clock, no counter, no process identity, so two processes
    /// serving the same bytes emit the same tag and a client's `If-None-Match`
    /// still matches after a restart or across a load-balanced pair. A
    /// per-process seed here would make the whole feature silently inert.
    ///
    /// 64 bits: a collision serves a 304 for content the client does not have. At
    /// that width it takes ~5 billion distinct representations of one URL for a
    /// 50% chance, and the same hash already assigns this repo's paste ids.
    fn etag(self) -> Route

    /// `Last-Modified` from an epoch-millis field.
    ///
    /// The field is named rather than selected by a closure for the reason
    /// `IsMissing` records: `Route` has erased the procedure's output type by the
    /// time a combinator sees it. A name that no longer exists writes no header
    /// rather than trapping — a validator is an optimization, and losing one must
    /// not lose the response. `If-Modified-Since` is answered with 304.
    fn lastModified(self, field: String) -> Route

    /// The `Vary` header for this route.
    ///
    /// Writes the `Response.vary` field RFC-0072 M4 already ships — one
    /// negotiation channel with one reader, not a second one hidden in the header
    /// map.
    fn vary(self, headers: String) -> Route

    /// The status a SUCCESSFUL answer carries.
    ///
    /// 202 for an accepted job, 201 without a Location. An error keeps its own: a
    /// 422 from `fromJson` is the codec's answer and not this route's to relabel.
    fn status(self, code: Int64) -> Route

    /// `201 Created` with a `Location` built from the response.
    ///
    /// `"/pastes/{id}"` takes `{id}` from the created object's `id` field. A
    /// template and not the RFC's `|p| "/pastes/\{p.id}"`, and this is the honest
    /// version of that line: the closure it shows takes the procedure's OUTPUT
    /// type, and a `Route` that could carry one would be `Route<T>` — the
    /// type-level chain this RFC exists to refuse. The template is checked at
    /// runtime against the fields actually present; an unknown `{name}` is left
    /// verbatim in the URL, where it is loud.
    fn createdAt(self, template: String) -> Route

    /// Which `Err` payloads are an absence.
    ///
    /// `.notFoundWhen(|why| why == "no such paste")` turns that one error into a
    /// 404 and leaves every other `Err` a 200 carrying the error the procedure
    /// returned. The lambda captures nothing at all, which is the cheapest thing
    /// it can be — no capture block, no dispatch.
    fn notFoundWhen(self, isMissing: IsMissing) -> Route
}

impl Policy for Route {
    fn cacheFor(self, seconds: Int64) -> Route {
        let mut out = httpCopy(self)
        out.maxAge = seconds
        out.derived = out.derived + " max-age=\{seconds}"
        return out
    }

    fn etag(self) -> Route {
        let mut out = httpCopy(self)
        out.validator = true
        out.derived = out.derived + " etag"
        return out
    }

    fn lastModified(self, field: String) -> Route {
        let mut out = httpCopy(self)
        out.modified = field.copy()
        out.derived = out.derived + " last-modified=" + field
        return out
    }

    fn vary(self, headers: String) -> Route {
        let mut out = httpCopy(self)
        out.varyOn = headers.copy()
        out.derived = out.derived + " vary=" + headers
        return out
    }

    fn status(self, code: Int64) -> Route {
        let mut out = httpCopy(self)
        out.ok = code
        out.derived = out.derived + " status=\{code}"
        return out
    }

    fn createdAt(self, template: String) -> Route {
        let mut out = httpCopy(self)
        out.location = template.copy()
        out.derived = out.derived + " created-at=" + template
        return out
    }

    fn notFoundWhen(self, isMissing: IsMissing) -> Route {
        let mut out = httpCopy(self)
        out.missing = isMissing.copy()
        out.derived = out.derived + " not-found-when"
        return out
    }
}

// ---- streaming (M3a) --------------------------------------------------------

/// What a mounted stream route runs: the request, the placeholder bindings, and
/// the CURSOR — the seed the producer resumes from, which is a reconnecting
/// client's `Last-Event-ID` when the route is `resumable` and `0` otherwise.
///
/// It hands back a `Stream<String>` of already-encoded frames (build them with
/// `event` below). The element is a frame rather than a record for a reason that
/// is about `std/stream` rather than about taste: `map` and `filter` are eager
/// walks over a buffer, so mapping a record stream into a frame stream would
/// materialise the feed — which is `#6156`, the incident RFC-0075 quotes,
/// arriving through the library written to prevent it. The producer encodes as
/// it goes, and stays lazy.
export type Feed = fn(Request, Map<String, String>, Int64) -> Stream<String>

/// A mounted event stream — and NOT a `Route`, which is the whole point.
///
/// `Route` carries `Policy`, and every one of its seven — `cacheFor`, `etag`,
/// `lastModified`, `vary`, `status`, `createdAt`, `notFoundWhen` — is about a
/// response that exists all at once. A validator for bytes that have not been
/// produced yet is not a thing, and a 304 for a feed is not either. This RFC's
/// rule is that an option meaningless to a transport is ABSENT from it rather
/// than ignored, so a stream is a different record with a different protocol, and
/// `mount` takes both. That separation is only spellable since RFC-0084 M1 made a
/// record a legal protocol target; before it, both would have had to be one
/// record with the options quietly doing nothing.
export type Live = {
    pattern: String,
    feed: Feed,
    // `retry: N` (milliseconds), written once before the first frame; `0` writes
    // no hint and leaves the client's own default (`retryAfter`).
    retry: Int64,
    // Whether `Last-Event-ID` seeds the producer (`resumable`).
    resume: Bool,
    derived: String,
}

/// `sse(pattern, feed)` — mount `feed` as an event stream at `pattern`.
///
/// The pattern is written here rather than in the procedure's own parameter slot,
/// which is where M1 put it and why: that trick exists to check `{id}` against a
/// procedure's INPUT RECORD, and a feed takes the request rather than a decoded
/// record — there are no fields to check the placeholders against. So `sse` is
/// the RFC's own `sse("/", tail)` spelling, and it is not a weaker version of
/// `GET(byId("/{id}"))`; it is the same rule with nothing to check.
export fn sse(pattern: String, feed: consume Feed) -> Live {
    return Live {
        pattern: httpTidy(pattern),
        feed: feed,
        retry: 0,
        resume: false,
        derived: "SSE " + httpTidy(pattern),
    }
}

/// A stream's policy, and it has nothing in common with `Policy`'s.
///
/// `keepAlive` is NOT here, and its absence is the same rule as `Policy`'s
/// absence: a pull producer that has nothing to say ends rather than idling, so
/// there is no idle connection for a keep-alive comment to hold open. The RFC
/// lists it beside the other two; there is nothing under it to build.
export protocol Wire {
    /// The reconnect hint: `retry: N` before the first frame.
    ///
    /// A pull producer answers `Some` or `None`; it has no way to say "nothing
    /// yet". So a feed that catches up ENDS, the connection closes, and the
    /// client comes back `ms` later — with its `Last-Event-ID` if the route is
    /// `resumable`. That makes `retryAfter` the poll interval rather than a
    /// failure hint, and it is the honest shape for a language with no
    /// concurrency: the alternative is a producer blocking the single-threaded
    /// server while it waits for something to happen.
    fn retryAfter(self, ms: Int64) -> Live

    /// `Last-Event-ID` becomes the producer's seed.
    ///
    /// RFC-0075 M2b made a stream's cursor its resume token, so replay is not a
    /// feature: the header's value is handed to the feed as its seed and the
    /// ordinary code path produces exactly what the client has not seen. Write
    /// that cursor as each frame's `id`, which is what `event` takes it for.
    /// Without `resumable` the seed is always `0` and a reconnecting client gets
    /// the feed from the top.
    fn resumable(self) -> Live
}

impl Wire for Live {
    fn retryAfter(self, ms: Int64) -> Live {
        return Live {
            pattern: self.pattern.copy(),
            feed: self.feed.copy(),
            retry: ms,
            resume: self.resume,
            derived: self.derived + " retry=\{ms}",
        }
    }

    fn resumable(self) -> Live {
        return Live {
            pattern: self.pattern.copy(),
            feed: self.feed.copy(),
            retry: self.retry,
            resume: true,
            derived: self.derived + " resumable",
        }
    }
}

/// One SSE frame: `id:`, `event:`, the `data:` lines, and the blank line that
/// ends it. An empty `id` or `name` writes no field rather than an empty one.
///
/// `data` is split on newlines because the wire format has no other way to carry
/// one — a raw `\n` inside a `data:` line would end the field, and a JSON payload
/// with a newline in it would silently become two events. Every `\n` in the
/// payload therefore becomes a second `data:` line, which the client rejoins.
export fn event(id: String, name: String, data: String) -> String {
    let mut out = ""
    if id != "" {
        out = out + "id: " + id + "\n"
    }
    if name != "" {
        out = out + "event: " + name + "\n"
    }
    return out + "data: " + joinWith(split(data, "\n"), "\ndata: ") + "\n\n"
}

// ---- websockets (M3b) -------------------------------------------------------

/// A mounted WebSocket, and — like `Live` — not a `Route`.
///
/// **Server-push only.** RFC 6455 is bidirectional; this is not. A `Socket`
/// consumes a `Stream<T>` and all four of the RFC's options are server-side, so a
/// client→server message has no shape here: it would want a handler per inbound
/// message, which is a different design and not one RFC-0074 spells. The host
/// still PARSES inbound frames — enough to honour a client-initiated close and
/// §5.1's rule that a client's frames are masked — because ignoring the bytes a
/// peer sends is not the same as not supporting inbound messages.
///
/// `heartbeat` is absent, and it is this milestone's refusal — the same one
/// `keepAlive` got from `Wire`, checked rather than assumed. A ping is
/// HOST-generated where a keep-alive comment would have been producer-generated,
/// which looked like the difference that would save it, and it is not: between
/// frames the host is not idle, it is blocked inside the producer waiting for the
/// next payload, so there is no moment for a timer to fire in. What a heartbeat
/// is FOR is detecting a peer that has gone away without saying so, and the host
/// already learns that by writing to it and failing — which is the signal this
/// adapter shares with `sse`, and it costs no ping.
export type Socket = {
    pattern: String,
    feed: Feed,
    // The code in the close frame the host sends when the feed ends
    // (`closeCode`); 1000 is RFC 6455 §7.4.1's normal closure.
    closing: Int64,
    // Echoed as `Sec-WebSocket-Protocol`, and only when the client offered it
    // (`subprotocol`); `""` negotiates none.
    subproto: String,
    // The largest payload the host puts in one frame, fragmenting anything longer
    // across continuation frames (`maxFrame`); `0` never fragments.
    fragment: Int64,
    derived: String,
}

/// `ws(pattern, feed)` — mount `feed` as a WebSocket at `pattern`.
///
/// The feed's element is the message PAYLOAD, not a frame, and that asymmetry
/// with `sse` is the rule rather than an inconsistency: **Vyrn owns what the user
/// chooses and the host owns what the protocol fixes.** SSE's `data:`, `id:` and
/// `retry:` are a design surface — which event name, which id — so `event(..)` is
/// Vyrn and the host writes what it is handed. A frame's opcode, length and mask
/// are not a surface; there is no choice in any of them. So the host frames.
export fn ws(pattern: String, feed: consume Feed) -> Socket {
    return Socket {
        pattern: httpTidy(pattern),
        feed: feed,
        closing: 1000,
        subproto: "",
        fragment: 0,
        derived: "WS " + httpTidy(pattern),
    }
}

/// A socket's policy. Three options, all server-side, all with something under
/// them — `heartbeat` is the fourth and is refused; see [`Socket`].
export protocol Frames {
    fn closeCode(self, code: Int64) -> Socket
    fn subprotocol(self, name: String) -> Socket
    fn maxFrame(self, size: Int64) -> Socket
}

impl Frames for Socket {
    fn closeCode(self, code: Int64) -> Socket {
        return Socket {
            pattern: self.pattern.copy(),
            feed: self.feed.copy(),
            closing: code,
            subproto: self.subproto.copy(),
            fragment: self.fragment,
            derived: self.derived + " close=\{code}",
        }
    }

    fn subprotocol(self, name: String) -> Socket {
        return Socket {
            pattern: self.pattern.copy(),
            feed: self.feed.copy(),
            closing: self.closing,
            subproto: name.copy(),
            fragment: self.fragment,
            derived: self.derived + " subprotocol=" + name,
        }
    }

    fn maxFrame(self, size: Int64) -> Socket {
        return Socket {
            pattern: self.pattern.copy(),
            feed: self.feed.copy(),
            closing: self.closing,
            subproto: self.subproto.copy(),
            fragment: size,
            derived: self.derived + " max-frame=\{size}",
        }
    }
}

/// RFC 6455 §4.2.2's magic string. Published, constant, and the whole reason the
/// handshake needs a SHA-1: the server proves it understood the upgrade by
/// echoing `base64(SHA-1(key + this))`. Nothing here is secret.
fn httpWsGuid() -> String {
    return "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
}

/// Open the socket: the handshake response, and the producer handed to the host.
///
/// A malformed upgrade never reaches `serveStream`, so it answers as an ordinary
/// buffered response — 426 with the version we speak when the client asked for a
/// version we do not (§4.4), 400 otherwise.
///
/// The `body` of a 101 is NOT a prologue. `sse` uses that slot for the one thing
/// it writes between the header block and the first frame, and a WebSocket has no
/// such thing — after the handshake, everything is a frame. So it carries what the
/// host needs before it can write one: the close code and the fragment limit, the
/// two numbers the framing rule above says the host owns but does not get to
/// choose. The host writes none of it.
fn httpOpenSocket(w: Socket, req: Request, ps: Map<String, String>) -> Response {
    if httpHeader(req, "sec-websocket-version") != "13" {
        return Response {
            status: 426,
            contentType: "text/plain",
            body: "this endpoint speaks WebSocket version 13",
            vary: "",
            headers: ["Sec-WebSocket-Version": "13"],
        }
    }
    let key = httpHeader(req, "sec-websocket-key")
    if key == "" || httpHasToken(httpHeader(req, "upgrade"), "websocket") == false || httpHasToken(httpHeader(req, "connection"), "upgrade") == false {
        return Response {
            status: 400,
            contentType: "text/plain",
            body: "not a WebSocket upgrade",
            vary: "",
            headers: [:],
        }
    }
    let accept = base64EncodeBytes(sha1(bytes(key + httpWsGuid())))
    let mut headers: Map<String, String> = [
        "Upgrade": "websocket",
        "Connection": "Upgrade",
        "Sec-WebSocket-Accept": accept,
    ]
    // §4.2.2: the server may only select a subprotocol the client offered.
    if w.subproto != "" && httpHasToken(httpHeader(req, "sec-websocket-protocol"), w.subproto) {
        headers["Sec-WebSocket-Protocol"] = w.subproto.copy()
    }
    serveStream(httpFeed(w.feed, req, ps, 0))
    return Response {
        status: 101,
        contentType: "",
        body: "\{w.closing} \{w.fragment}",
        vary: "",
        headers: headers,
    }
}

/// Whether a comma-separated header value lists `token`, case-insensitively.
/// `Connection: keep-alive, Upgrade` is one field with two tokens, and a browser
/// sends exactly that.
fn httpHasToken(value: String, token: String) -> Bool {
    for part in split(value, ",") {
        if lowerOf(trim(part)) == lowerOf(token) {
            return true
        }
    }
    return false
}

/// ASCII lowercase. `Connection`'s tokens are case-insensitive (RFC 9110 §7.6.1)
/// and a header VALUE is not folded at the edge the way a header name is.
fn lowerOf(s: String) -> String {
    let mut out: Array<UInt8> = []
    for b in bytes(s) {
        if b >= 'A' && b <= 'Z' {
            out.push(b + 32)
        } else {
            out.push(b)
        }
    }
    return fromBytesOr(out, s)
}

/// The route a socket shadows, for the mount check.
fn httpSocketRoute(w: Socket) -> Route {
    return httpRoute(w.pattern, httpNoRun, w.derived)
}

fn httpSocketMatch(w: Socket, req: Request) -> Option<Map<String, String>> {
    if req.method != "GET" {
        return None
    }
    return httpMatch(httpWithMethod(httpSocketRoute(w), "GET"), req)
}

/// The route a stream shadows, for the mount check: a stream answers a GET at
/// exactly one path, so `httpSubsumes` can be asked about it the same way.
fn httpLiveRoute(l: Live) -> Route {
    return httpRoute(l.pattern, httpNoRun, l.derived)
}

/// Open the stream: hand the producer to the HOST and answer with the header
/// block it will write in front of the frames.
///
/// `serveStream` is the one builtin this milestone added, and it is the only way
/// a stream leaves the call that made it — RFC-0075's linearity forbids storing
/// one anywhere else, which is precisely what makes "the host owes it a `close`"
/// a fact rather than a convention. The host then pulls, writes, and closes the
/// first time a write fails; that failing write IS the disconnect signal, because
/// it is the socket rather than the framework and is therefore the same on every
/// deployment.
///
/// The `body` here is the stream's PROLOGUE, not a response. It is the one thing
/// written between the header block and the first frame.
fn httpOpen(l: Live, req: Request, ps: Map<String, String>) -> Response {
    let seed = if l.resume { httpLastEventId(req) } else { 0 }
    serveStream(httpFeed(l.feed, req, ps, seed))
    let prologue = if l.retry > 0 { "retry: \{l.retry}\n\n" } else { "" }
    return Response {
        status: 200,
        contentType: "text/event-stream",
        body: prologue,
        vary: "",
        headers: [:],
    }
}

/// Call the stored feed. RFC-0037 calls a `fn` value by NAME, so the field binds
/// to a parameter first — the same reason `httpInvoke` exists. Returning the
/// stream forwards the obligation to `serveStream`'s caller, which hands it on.
fn httpFeed(f: Feed, req: Request, ps: Map<String, String>, seed: Int64) -> Stream<String> {
    return f(req, ps, seed)
}

/// The cursor a reconnecting client is asking to resume from. Absent, empty or
/// non-integer reads as `0` — a client that lost its place gets the feed from the
/// top, which is worse than resuming and better than nothing.
fn httpLastEventId(req: Request) -> Int64 {
    return match parse(httpHeader(req, "last-event-id")) {
        Some(n) => n,
        None => 0,
    }
}

// ---- mounting --------------------------------------------------------------

/// Resolve `req` against the mounted groups, in order, first match wins.
///
/// Overlaps BETWEEN groups are a startup error, not a silent shadow: a route in a
/// later group that an earlier group already answers for is unreachable, and an
/// unreachable route is the kind of thing nobody notices until production. Order
/// *within* a group is the author's own, and left alone.
///
/// The check runs on every call rather than once, because there is no init hook
/// to hang it on and a router is a handful of routes: the scan is O(routes²) over
/// a number that is 5 in `examples/bin` and would have to reach the thousands
/// before it showed up next to a JSON decode. `vyrn serve` runs `main` at
/// startup, so an app that touches `handle` there sees the trap at startup, which
/// is where it belongs.
///
/// The fourth parameter is `ws`'s, and it is a fourth parameter for the same
/// reason `live` was a third: Vyrn has no sum over two record types, and a
/// `Socket` is deliberately not a `Live` — `retryAfter`/`resumable` mean nothing
/// to a WebSocket and `closeCode`/`subprotocol`/`maxFrame` mean nothing to an
/// event stream. An app with neither writes `[], []` and pays a word.
export fn mount(req: Request, groups: Array<Array<Route>>, live: Array<Live>, sockets: Array<Socket>) -> Option<Response> {
    httpCheckMount(groups, live, sockets)
    for w in sockets {
        if let Some(ps) = httpSocketMatch(w, req) {
            return Some(httpOpenSocket(w, req, ps))
        }
    }
    // Stream routes resolve BEFORE the buffered groups, and the reason is the
    // same one that makes them a separate list: a stream's path is exact, while
    // the patterns it would otherwise be filed behind (`/pastes/{id}`) are the
    // kind that swallow one. Nothing can shadow a stream; a stream shadowing a
    // buffered route is what `httpCheckMount` traps on.
    for l in live {
        if let Some(ps) = httpLiveMatch(l, req) {
            return Some(httpOpen(l, req, ps))
        }
    }
    for g in groups {
        for r in g {
            if let Some(ps) = httpMatch(r, req) {
                let answer = if r.prefix { httpInvokeWhole(r.whole, req) } else { httpInvoke(r.run, req, ps) }
                if let Some(resp) = answer {
                    return Some(httpApply(r, req, resp))
                }
            }
        }
    }
    return None
}

/// Call a stored handler. RFC-0037 calls a `fn` value by NAME, so the field has
/// to be bound to a parameter before it can be called.
fn httpInvoke(h: Handler, req: Request, ps: Map<String, String>) -> Option<Response> {
    return h(req, ps)
}

fn httpInvokeWhole(h: Surface, req: Request) -> Option<Response> {
    return h(req)
}

// ---- applying the policy ---------------------------------------------------
//
// Policy is applied HERE, in `mount`, and not inside the handler, because this is
// the one place that holds all three of the route (its policy), the request (its
// conditionals) and the response (its bytes) at once. That also means no
// combinator has to capture anything: the only stored `fn` in a policy is
// `notFoundWhen`'s capture-free predicate.

/// The route's policy over the answer its handler gave.
fn httpApply(r: Route, req: Request, resp: consume Response) -> Response {
    // A mounted subsystem writes its own headers and owns its own caching; a
    // prefix route has no policy to apply anyway (no combinator returns one).
    if r.prefix {
        return resp
    }
    // The answer is EDITED rather than rebuilt. A rebuilt `Response` reads
    // `answered.body` into a new record, which is a projection of a place the
    // frame owns and a copy of the whole body (RFC-0092). The bytes are already
    // in the right place; only the fields the policy decides need writing.
    let mut answered = httpMapMissing(r, resp)
    // Cache directives and validators describe a representation. A 4xx/5xx is not
    // one, so an error answer leaves with exactly what the codec gave it.
    if answered.status >= 300 {
        return answered
    }
    let tag = if r.validator { httpEtag(answered.contentType, answered.body) } else { "" }
    let stamp = if r.modified == "" { "" } else { httpStamp(answered.body, r.modified) }
    let loc = if r.location == "" { "" } else { httpFill(r.location, answered.body) }
    let hs = httpHeaders(answered.headers, r, tag, stamp, loc)
    if r.varyOn != "" {
        answered.vary = r.varyOn.copy()
    }
    // The client already holds this representation. RFC 9110 §15.4.5: a 304 sends
    // the metadata that would have gone with the 200 and NO content — so the
    // validators and `Cache-Control` stay, the body goes, and the media type goes
    // with it (there is nothing left to describe).
    if httpFresh(req, tag, stamp) {
        answered.status = 304
        answered.contentType = ""
        answered.body = ""
        answered.headers = hs
        return answered
    }
    answered.status = httpStatus(r, answered.status, loc)
    answered.headers = hs
    return answered
}

/// The status a successful answer carries. An explicit `status` wins over
/// `createdAt`'s implied 201, because it is the author speaking later and more
/// specifically; with neither, the adapter's own 200/204 stands.
fn httpStatus(r: Route, given: Int64, loc: String) -> Int64 {
    if r.ok != 0 {
        return r.ok
    }
    if loc != "" {
        return 201
    }
    return given
}

/// The response headers: whatever the handler already set, then the policy's.
fn httpHeaders(base: Map<String, String>, r: Route, tag: String, stamp: String, loc: String) -> Map<String, String> {
    let mut hs: Map<String, String> = [:]
    for k in base.keys() {
        hs[k] = httpAt(base, k)
    }
    if r.maxAge >= 0 {
        hs["Cache-Control"] = "max-age=\{r.maxAge}"
    }
    if tag != "" {
        hs["ETag"] = tag.copy()
    }
    if stamp != "" {
        hs["Last-Modified"] = stamp.copy()
    }
    if loc != "" {
        hs["Location"] = loc.copy()
    }
    return hs
}

/// The strong validator for a representation: the content type and the body,
/// hashed together. See `etag` for why it is content and nothing else.
fn httpEtag(contentType: String, body: String) -> String {
    return "\"" + toHex(fnv1aStr(contentType + "\n" + body)) + "\""
}

/// Whether the request already holds what this route would answer with.
///
/// RFC 9110 §13.1.3: when `If-None-Match` is present, `If-Modified-Since` is
/// IGNORED — not tried as a second chance. Getting that backwards would 304 a
/// client whose validator we just said does not match.
fn httpFresh(req: Request, tag: String, stamp: String) -> Bool {
    let inm = httpHeader(req, "if-none-match")
    if inm != "" {
        return tag != "" && httpAnyMatch(inm, tag)
    }
    if stamp == "" {
        return false
    }
    // Exact equality, not "not newer than": a date comparison needs an HTTP-date
    // PARSER, and this answers 304 only for a client stamped exactly as we would
    // stamp it. Conservative in the safe direction — a missed 304 costs bytes, a
    // wrong one costs correctness.
    return httpHeader(req, "if-modified-since") == stamp
}

/// One request header, `""` when absent. Names arrive lowercased (RFC-0072 M4
/// lowercases at the edge, and a hand-written `Request` literal writes lowercase).
fn httpHeader(req: Request, name: String) -> String {
    return match req.headers[name] {
        Some(v) => v,
        None => "",
    }
}

/// Whether an `If-None-Match` field value names `tag`. `*` matches anything the
/// server has; otherwise it is a comma-separated list compared with the WEAK
/// comparison function (RFC 9110 §8.8.3.2), so a client that echoes our strong
/// tag back as `W/"…"` still matches.
fn httpAnyMatch(field: String, tag: String) -> Bool {
    if trim(field) == "*" {
        return true
    }
    for one in split(field, ",") {
        if httpUnweak(trim(one)) == httpUnweak(tag) {
            return true
        }
    }
    return false
}

fn httpUnweak(t: String) -> String {
    return if t.startsWith("W/") { substring(t, 2, t.byteLength) } else { t.copy() }
}

/// `notFoundWhen`'s answer: a procedure that returned `Err(why)` for a reason this
/// route calls absence is a 404, not a 200 carrying an error object.
fn httpMapMissing(r: Route, resp: consume Response) -> Response {
    if resp.status != 200 {
        return resp
    }
    return match httpErrOf(resp.body) {
        Some(why) => httpMaybe404(r, resp, why),
        None => resp,
    }
}

fn httpMaybe404(r: Route, resp: consume Response, why: String) -> Response {
    if httpAsk(r.missing, why) == false {
        return resp
    }
    // The body stays as the codec wrote it: the client gets the same
    // `{"Err":"…"}` the RPC surface would have given, at the status REST expects.
    // Edited, not rebuilt — see `httpApply`.
    let mut out = resp
    out.status = 404
    return out
}

/// Call the stored predicate. RFC-0037 calls a `fn` value by NAME, so the field
/// binds to a parameter first — the same reason `httpInvoke` exists.
fn httpAsk(isMissing: IsMissing, why: String) -> Bool {
    return isMissing(why)
}

/// The `Err` payload of a body that encodes a `Result`, `None` otherwise.
///
/// This reads the RFC-0024 wire form the SAME `toJson` wrote — `{"Err": "…"}` —
/// rather than a second convention: the one-codec property is what makes the REST
/// and RPC surfaces byte-identical, and a policy layer that invented its own error
/// shape would be the first crack in it. A record whose single field is literally
/// named `Err` and holds a string is indistinguishable here, and would be read as
/// an error; no such record exists in the dogfoods and the ambiguity is the wire
/// form's, not this function's.
fn httpErrOf(body: String) -> Option<String> {
    return match httpSingle(body, "Err") {
        Some(v) => httpStrOf(v),
        None => None,
    }
}

fn httpStrOf(v: Json) -> Option<String> {
    return match v {
        JStr(s) => Some(s),
        JNum(n) => None,
        JBool(b) => None,
        JNull => None,
        JArr(xs) => None,
        JObj(fs) => None,
    }
}

/// The value of a single-field object with key `key`, `None` otherwise.
fn httpSingle(body: String, key: String) -> Option<Json> {
    return match parseJson(body) {
        Ok(j) => httpSingleOf(j, key),
        Err(e) => None,
    }
}

fn httpSingleOf(j: Json, key: String) -> Option<Json> {
    let fs = httpFieldsOf(j)
    if fs.length != 1 {
        return None
    }
    return if fs[0].key == key { Some(fs[0].value) } else { None }
}

/// The object a `Location` template and `Last-Modified` read their fields from:
/// the body, or the payload inside it when the procedure returned `Ok(value)`.
/// `Result` is how a fallible procedure reports, so unwrapping it here is the
/// difference between `createdAt` working on the dogfood and not.
fn httpPayload(body: String) -> Array<JsonField> {
    return match httpSingle(body, "Ok") {
        Some(inner) => httpFieldsOf(inner),
        None => httpBodyFields(body),
    }
}

/// The raw text of a top-level payload field, `""` when absent or not scalar.
fn httpScalar(body: String, key: String) -> String {
    for f in httpPayload(body) {
        if f.key == key {
            return httpText(f.value)
        }
    }
    return ""
}

fn httpText(v: Json) -> String {
    return match v {
        JStr(s) => s.copy(),
        JNum(n) => n.copy(),
        JBool(b) => b.toString(),
        JNull => "",
        JArr(xs) => "",
        JObj(fs) => "",
    }
}

/// `"/pastes/{id}"` with each `{name}` replaced by that payload field. An unknown
/// name is left verbatim: a wrong `Location` should be visible in the URL, not
/// silently shortened to one that resolves to something else.
fn httpFill(template: String, body: String) -> String {
    let mut out = template.copy()
    for f in httpPayload(body) {
        out = replace(out, "{" + f.key + "}", httpText(f.value))
    }
    return out
}

/// The `Last-Modified` value from the named epoch-millis field, `""` when the
/// field is absent, non-numeric or negative. Never traps: `Instant` refuses a
/// negative and a validator is not worth a 500.
fn httpStamp(body: String, field: String) -> String {
    return match parse(httpScalar(body, field)) {
        Some(ms) => httpDate(ms),
        None => "",
    }
}

/// `Thu, 01 Jan 1970 00:00:00 GMT` — the IMF-fixdate of RFC 9110 §5.6.7, the one
/// format a server is required to send. Built from `std/time`'s pure UTC
/// breakdown; the weekday is arithmetic (1970-01-01 was a Thursday), which is why
/// there is no calendar table here beyond the two name lists the format spells
/// out in English.
fn httpDate(ms: Int64) -> String {
    if ms < 0 {
        return ""
    }
    let at = fromMillis(ms)
    let c = civil(at)
    let days = ms / 86400000
    let dow = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    let mon = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let clock = httpPad2(hour(at)) + ":" + httpPad2(minute(at)) + ":" + httpPad2(second(at))
    return dow[(days + 4) % 7] + ", " + httpPad2(c.day) + " " + mon[c.month - 1] + " \{c.year} " + clock + " GMT"
}

fn httpPad2(n: Int64) -> String {
    return padStart(n.toString(), 2, "0")
}

/// The placeholder bindings if `r` matches `req`, `None` otherwise.
fn httpMatch(r: Route, req: Request) -> Option<Map<String, String>> {
    if r.method != "*" && r.method != req.method {
        return None
    }
    let path = httpPathOnly(req.path)
    if r.prefix {
        let under = r.pattern == "/" || path == r.pattern || path.startsWith(r.pattern + "/")
        return if under { Some([:]) } else { None }
    }
    let pat = split(r.pattern, "/")
    let got = split(path, "/")
    if pat.length != got.length {
        return None
    }
    let mut ps: Map<String, String> = [:]
    let mut i = 0
    while i < pat.length {
        if httpIsPlaceholder(pat[i]) {
            ps[httpPlaceholderName(pat[i])] = got[i].copy()
        } else {
            if pat[i] != got[i] {
                return None
            }
        }
        i = i + 1
    }
    return Some(ps)
}

/// The request path without its query string. `path` carries the query as sent
/// (RFC-0072 M4), and a route pattern never mentions one.
fn httpPathOnly(path: String) -> String {
    return match indexOf(path, "?") {
        Some(i) => substring(path, 0, i),
        None => path.copy(),
    }
}

fn httpIsPlaceholder(seg: String) -> Bool {
    return seg.startsWith("{") && seg.endsWith("}")
}

fn httpPlaceholderName(seg: String) -> String {
    return substring(seg, 1, seg.byteLength - 1)
}

/// Whether `req` is this stream's — a GET at exactly its pattern, placeholders
/// bound the ordinary way. `Route`'s matcher does the work; only the method rule
/// differs, because a stream has one.
fn httpLiveMatch(l: Live, req: Request) -> Option<Map<String, String>> {
    if req.method != "GET" {
        return None
    }
    return httpMatch(httpWithMethod(httpLiveRoute(l), "GET"), req)
}

/// Trap on any route a later group could never reach, and on any route that never
/// got a method.
fn httpCheckMount(groups: Array<Array<Route>>, live: Array<Live>, sockets: Array<Socket>) {
    // A stream resolves first, so it is the one thing that can shadow rather than
    // be shadowed. Reported at startup for the same reason the group check is: an
    // unreachable route is what nobody notices until production.
    for w in sockets {
        let a = httpWithMethod(httpSocketRoute(w), "GET")
        for l in live {
            if httpSubsumes(a, httpWithMethod(httpLiveRoute(l), "GET")) {
                panic("mount: the stream route " + l.pattern + " (" + l.derived + ") is unreachable — the socket " + w.pattern + " already answers it")
            }
        }
        for g in groups {
            for b in g {
                if httpSubsumes(a, b) {
                    panic("mount: " + b.method + " " + b.pattern + " (" + b.derived + ") is unreachable — the socket " + w.pattern + " already answers it")
                }
            }
        }
    }
    for l in live {
        let a = httpWithMethod(httpLiveRoute(l), "GET")
        for g in groups {
            for b in g {
                if httpSubsumes(a, b) {
                    panic("mount: " + b.method + " " + b.pattern + " (" + b.derived + ") is unreachable — the stream route " + l.pattern + " already answers it")
                }
            }
        }
    }
    let mut gi = 0
    for g in groups {
        for r in g {
            if r.method == "" {
                panic("mount: route `" + r.pattern + "` (" + r.derived + ") has no method — wrap it in GET(..)/POST(..)/PUT(..)/PATCH(..)/DELETE(..)")
            }
        }
        let mut gj = 0
        for earlier in groups {
            if gj < gi {
                for a in earlier {
                    for b in g {
                        if httpSubsumes(a, b) {
                            panic("mount: " + b.method + " " + b.pattern + " (group " + gi.toString() + ", " + b.derived + ") is unreachable — " + a.method + " " + a.pattern + " (group " + gj.toString() + ") already answers it")
                        }
                    }
                }
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
}

/// Whether every path `b` matches, `a` matches too — so mounting `a` first leaves
/// `b` dead. Conservative on purpose: it reports the containments it can prove
/// (an earlier prefix that covers a later pattern, an earlier pattern whose
/// placeholders swallow a later one) and stays quiet otherwise, because a false
/// startup trap is worse than a missed shadow.
fn httpSubsumes(a: Route, b: Route) -> Bool {
    if a.method != "*" && a.method != b.method {
        return false
    }
    if a.prefix {
        return a.pattern == "/" || b.pattern == a.pattern || b.pattern.startsWith(a.pattern + "/")
    }
    if b.prefix {
        return false
    }
    let sa = split(a.pattern, "/")
    let sb = split(b.pattern, "/")
    if sa.length != sb.length {
        return false
    }
    let mut i = 0
    while i < sa.length {
        if httpIsPlaceholder(sa[i]) == false && sa[i] != sb[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// ---- the decode input ------------------------------------------------------

/// The JSON a generated adapter hands `fromJson`: the placeholder bindings as
/// object fields, with the request body's own fields after them.
///
/// A captured segment is text, but the field it binds may not be: `/users/{id}`
/// over an `Int64` id must produce `{"id":7}`, not `{"id":"7"}`, or every numeric
/// REST route in existence decodes as a 422. The generator resolves each
/// placeholder's field to its base type and passes the numeric ones in
/// `numeric`; a value that does not parse as an integer stays a string, so the
/// decoder reports a typed issue naming the field rather than this function
/// inventing a number. A `Float64` path field is text here too — `parse` is
/// integer-only, and no dogfood has one.
export fn httpInput(ps: Map<String, String>, body: String, numeric: Array<String>) -> String {
    if ps.length == 0 {
        return body.copy()
    }
    let mut fs: Array<JsonField> = []
    for k in ps.keys() {
        let v = httpValue(httpAt(ps, k), httpListHas(numeric, k))
        fs.push(JsonField { key: k, value: v })
    }
    if body != "" {
        for f in httpBodyFields(body) {
            fs.push(f)
        }
    }
    return emit(JObj(fs))
}

/// A captured segment as the JSON value its field expects.
fn httpValue(raw: String, isNumber: Bool) -> Json {
    if isNumber {
        return match parse(raw) {
            Some(n) => JNum(n.toString()),
            None => JStr(raw),
        }
    }
    return JStr(raw)
}

fn httpListHas(items: Array<String>, needle: String) -> Bool {
    for it in items {
        if it == needle {
            return true
        }
    }
    return false
}

fn httpAt(ps: Map<String, String>, k: String) -> String {
    return match ps[k] {
        Some(v) => v,
        None => "",
    }
}

/// The body's top-level object fields, or none when it is not an object — an
/// unparseable body with a placeholder present is left to `fromJson`, which
/// reports the missing fields it needs by name.
fn httpBodyFields(body: String) -> Array<JsonField> {
    return match parseJson(body) {
        Ok(j) => httpFieldsOf(j),
        Err(e) => [],
    }
}

fn httpFieldsOf(j: Json) -> Array<JsonField> {
    return match j {
        JObj(fs) => copyJsonFields(fs),
        JNull => [],
        JBool(b) => [],
        JNum(n) => [],
        JStr(s) => [],
        JArr(xs) => [],
    }
}

// ---- the generator ---------------------------------------------------------
// (Comptime-pure string building, as every generator in std/ is.)

/// Uppercase the first byte (ASCII): `byId` => `ById`, for the internal names.
fn httpCapFirst(s: String) -> String {
    let raw = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in raw {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// The base path a projection derives from its stem: `"./server/api/pastes"` =>
/// `"/pastes"`. Renaming the resource moves its URLs, which is the whole reason
/// the placement rule exists.
fn httpBasePath(module: String) -> String {
    let segs = split(module, "/")
    return "/" + segs[segs.length - 1]
}

/// One field of a procedure's input type: the name a placeholder may spell, and
/// whether the value it binds is a number on the wire.
type HttpField = { name: String, numeric: Bool }

/// The fields of the record type `name` declares, in declaration order.
///
/// Read off `TypeInfo.source` — canonical Vyrn source — with the compiler's own
/// lexer (RFC-0054), not a hand-rolled scanner: the repo already paid for that
/// lesson in the `std/vyx` scanner bugs. At brace depth 1, an identifier followed
/// by `:` is a field; anything nested (an inline record, a `Map<String, Int64>`
/// value type) is at another depth or is not followed by `:`.
gen fn httpFields(name: String, iface: ModuleInterface) -> Array<HttpField> {
    let mut out: Array<HttpField> = []
    for t in iface.types {
        if t.name == name {
            let toks = lex(t.source)
            let mut depth = 0
            let mut i = 0
            while i < toks.length {
                let tk = toks[i]
                if tk.kind == "punct" && tk.text == "{" {
                    depth = depth + 1
                }
                if tk.kind == "punct" && tk.text == "}" {
                    depth = depth - 1
                }
                if depth == 1 && tk.kind == "ident" && i + 2 < toks.length {
                    let nx = toks[i + 1]
                    if nx.kind == "punct" && nx.text == ":" {
                        out.push(HttpField { name: tk.text, numeric: httpIsNumeric(toks[i + 2], iface) })
                    }
                }
                i = i + 1
            }
        }
    }
    return out
}

/// Whether a field whose type begins with token `ty` carries a JSON number.
///
/// One alias hop (`Age` => `Int64`), which is how every validated scalar in the
/// dogfoods is written; a longer chain reads as text and decodes as a 422 rather
/// than as a wrong number.
gen fn httpIsNumeric(ty: Token, iface: ModuleInterface) -> Bool {
    if ty.kind != "ident" {
        return false
    }
    if httpIsNumericBase(ty.text) {
        return true
    }
    for t in iface.types {
        if t.name == ty.text {
            return httpIsNumericBase(t.schema.base)
        }
    }
    return false
}

fn httpIsNumericBase(spelling: String) -> Bool {
    return spelling.startsWith("Int") || spelling.startsWith("UInt") || spelling.startsWith("Float")
}

/// Just the names, for the pattern type's placeholder alternatives.
fn httpNamesOf(fields: Array<HttpField>) -> Array<String> {
    let mut out: Array<String> = []
    for f in fields {
        out.push(f.name.copy())
    }
    return out
}

/// The numeric names as a Vyrn array literal, for the emitted `httpInput` call.
fn httpNumericLit(fields: Array<HttpField>) -> String {
    let mut names: Array<String> = []
    for f in fields {
        if f.numeric {
            names.push("\"" + f.name + "\"")
        }
    }
    return "[" + joinWith(names, ", ") + "]"
}

/// The `where` predicate of a procedure's path-pattern type: any run of ordinary
/// bytes, or one of the placeholders its input type has a field for.
///
/// Emitted INTO a Vyrn string literal that the compiler re-lexes, so a single
/// output backslash is written as two — the `std/ui:uiRegexEscapeLit` rule.
fn httpPathRegex(fields: Array<String>) -> String {
    let mut alts = "[^{}]"
    for f in fields {
        alts = alts + "|\\\\{" + f + "\\\\}"
    }
    return "(" + alts + ")*"
}

/// One procedure's projection: the pattern type that checks its placeholders, the
/// adapter that decodes / calls / encodes, and the constructor the projection
/// file names.
gen fn httpProcedure(f: FnInfo, iface: ModuleInterface, base: String) -> String {
    let cap = httpCapFirst(f.name)
    let run = "httpRun" + cap
    let pathType = "Path" + cap
    let mut fields: Array<HttpField> = []
    if f.params.length == 1 {
        fields = httpFields(f.params[0].spelling, iface)
    }
    let names = httpNamesOf(fields)
    let mut out = "/// Path patterns `" + f.name + "` accepts"
    if fields.length > 0 {
        out = out + ": " + joinWith(httpBraced(names), ", ") + " (the fields of `" + f.params[0].spelling + "`)"
    } else {
        out = out + " — no placeholders (it takes no input)"
    }
    out = out + ".\n"
    out = out + "export type " + pathType + " = String where value =~ \"" + httpPathRegex(names) + "\"\n"
    out = out + "fn " + run + "(req: Request, ps: Map<String, String>) -> Option<Response> {\n"
    let call = f.name + "__real"
    if f.params.length == 1 {
        let reqType = f.params[0].spelling
        out = out + "    return match fromJson(" + reqType + ", httpInput(ps, req.body, " + httpNumericLit(fields) + ")) {\n"
        if f.ret == "" {
            out = out + "        Valid(input) => " + run + "Unit(input),\n"
            out = out + "        Invalid(issues) => Some(Response { status: 422, contentType: \"application/json\", body: toJson(HttpIssues { issues: issues }), vary: \"\", headers: [:] }),\n"
            out = out + "    }\n}\n"
            out = out + "fn " + run + "Unit(input: " + reqType + ") -> Option<Response> {\n"
            out = out + "    " + call + "(input)\n"
            out = out + "    return Some(Response { status: 204, contentType: \"application/json\", body: \"\", vary: \"\", headers: [:] })\n}\n"
        } else {
            out = out + "        Valid(input) => Some(Response { status: 200, contentType: \"application/json\", body: toJson(" + call + "(input)), vary: \"\", headers: [:] }),\n"
            out = out + "        Invalid(issues) => Some(Response { status: 422, contentType: \"application/json\", body: toJson(HttpIssues { issues: issues }), vary: \"\", headers: [:] }),\n"
            out = out + "    }\n}\n"
        }
    } else {
        if f.ret == "" {
            out = out + "    " + call + "()\n"
            out = out + "    return Some(Response { status: 204, contentType: \"application/json\", body: \"\", vary: \"\", headers: [:] })\n}\n"
        } else {
            out = out + "    return Some(Response { status: 200, contentType: \"application/json\", body: toJson(" + call + "()), vary: \"\", headers: [:] })\n}\n"
        }
    }
    out = out + "/// `" + f.name + "` at `" + base + "` + `path`.\n"
    out = out + "export fn " + f.name + "(path: " + pathType + ") -> Route {\n"
    out = out + "    return httpRoute(\"" + base + "\" + path, " + run + ", \"" + f.name + "\")\n}\n"
    return out
}

/// `["id", "lang"]` => `["{id}", "{lang}"]`, for the doc line.
fn httpBraced(fields: Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    for f in fields {
        out.push("{" + f + "}")
    }
    return out
}

/// The import block: the procedures under `__real` aliases (their projection
/// constructors take their names), and every reachable type from the module that
/// DECLARES it, so a type crossing an import keeps one identity (RFC-0031).
fn httpImports(iface: ModuleInterface, module: String) -> String {
    let mut specs: Array<String> = [module.copy()]
    for t in iface.types {
        if httpContains(specs, t.module) == false {
            specs.push(t.module.copy())
        }
    }
    let mut out = ""
    for spec in specs {
        let mut names: Array<String> = []
        if spec == module {
            for f in iface.functions {
                names.push(f.name + " as " + f.name + "__real")
            }
        }
        for t in iface.types {
            if t.module == spec {
                names.push(t.name.copy())
            }
        }
        if names.length > 0 {
            out = out + "import { " + joinWith(names, ", ") + " } from \"" + spec + "\"\n"
        }
    }
    return out
}

fn httpContains(items: Array<String>, needle: String) -> Bool {
    for it in items {
        if it == needle {
            return true
        }
    }
    return false
}

/// `http(module)` — the REST projection of one procedure module: a
/// placeholder-checked constructor per procedure, mounted under the base path its
/// stem derives.
///
/// Inspect the generated module with:  vyrn emit-gen <file>
export gen fn http(module: String) -> String {
    let iface = moduleInterface(module)
    let err = validateContract(iface)
    if err != "" {
        return err
    }
    let base = httpBasePath(module)
    let mut out = "/// Generated by std/http `http` (RFC-0074) — do not edit.\n"
    out = out + "import { Route, httpRoute, httpInput } from \"std/http\"\n"
    out = out + httpImports(iface, module)
    out = out + "type HttpIssues = { issues: Array<Issue> }\n"
    let mut syms: Array<Symbol> = []
    for f in iface.functions {
        out = out + httpProcedure(f, iface, base)
        syms.push(symbol(f.name, f.origin, []))
        syms.push(symbol("Path" + httpCapFirst(f.name), f.origin, []))
    }
    out = out + symbolMapFn("http(" + module + ")", syms)
    return out
}
