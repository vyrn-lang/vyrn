/// Typed translations as a generator library.
///
///   import { i18n } from "std/i18n"
///   import { t, setLocale, locale, Locale, TransKey, tCartItems } from i18n("./locales")
///
/// `i18n(dir)` reads every `<locale>.json` under `dir` at compile time, checks
/// that the locales agree, compiles each ICU message to a Vyrn function body
/// and returns the module as `Code` (`vyrn emit-gen <file>` shows it). The
/// module holds `Locale` (one variant per file), `setLocale`/`locale`,
/// `TransKey` (the finite type of every dotted key), one function per key with
/// arguments taken from the message and the base-locale message as its doc,
/// `t(key)`, and `transKey(s)`, which checks a runtime `String` against the
/// key set.
///
/// `catalogue(dir)` reads the same files and writes only one exported function per
/// key and locale, `tCartItems__En`. It holds no `Locale` and no module state, so a
/// generator can call it at generation, naming its locale, and two catalogues link in
/// one program, where two `En` variants would clash.
///
/// The ICU subset: plain text; `{name}` (String); `{n, plural, ...}` (Int64,
/// `#` is the number, `other` required); `{k, select, ...}` (a finite string
/// type of the branch names). `''` is a literal apostrophe, `'{'` and `'}'`
/// literal braces. An argument name may not start with `__`. Numbers,
/// booleans and null in a locale file, and a plural or select nested in a
/// branch, fail generation.

import { Json, JsonField } from "std/json"
import { parseJson } from "std/jsonread"
import { joinWith, split, substring, fromBytesOr, trim } from "std/strings"
import { includes } from "std/arrays"
import { contains, endsWith, startsWith } from "std/strpred"
import { report, reportHere, Severity } from "std/diag"
import { arm, ifChainOr, join } from "std/code"
import { parseInt64 } from "std/num"

// The ICU scanners work on byte arrays and thread byte indices, so these byte
// helpers stay local.

/// The bytes `ba[s..e)` as a String; "" if not valid UTF-8, which a slice of
/// validated input never is.
gen fn sliceStr(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut out: Array<UInt8> = []
    let mut i = s
    while i < e {
        out.push(ba[i])
        i = i + 1
    }
    return fromBytesOr(out, "")
}

gen fn isWs(b: UInt8) -> Bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

/// The first non-whitespace index at or after `i`.
gen fn skipWs(ba: Array<UInt8>, i: Int64, e: Int64) -> Int64 {
    let mut j = i
    while j < e {
        if isWs(ba[j]) {
            j = j + 1
        } else {
            return j
        }
    }
    return j
}

gen fn upperFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// The PascalCase type-name base of a dotted key: `cart.items` -> `CartItems`.
gen fn keyTypeBase(key: String) -> String {
    let segs = split(key, ".")
    let mut out = ""
    for seg in segs {
        out = out + upperFirst(seg)
    }
    return out
}

/// The per-key function name: `cart.items` -> `tCartItems`.
gen fn keyFnName(key: String) -> String {
    return "t" + keyTypeBase(key)
}

/// The per-key name without the `t` prefix, for namespace imports:
/// `cart.items` -> `cartItems`, so `t.cartItems()` reads naturally. Emitted
/// beside the prefixed name.
gen fn keyPlainName(key: String) -> String {
    return lowerFirst(keyTypeBase(key))
}

/// Lowercase the first ASCII byte of `s` (`AppTitle` -> `appTitle`).
gen fn lowerFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'A' && b <= 'Z' {
            out.push(b + 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// `key` with every regex metacharacter escaped, for a `value =~ "..."`
/// alternative: `home.title` -> `home\.title`.
gen fn regexEscapeKey(key: String) -> String {
    let ba = bytes(key)
    let mut out: Array<UInt8> = []
    for b in ba {
        if b == '.' || b == '\\' || b == '(' || b == ')' || b == '[' || b == ']'
        || b == '{' || b == '}' || b == '|' || b == '*' || b == '+' || b == '?'
        || b == '^' || b == '$' {
            out.push('\\')
            out.push(b)
        } else {
            out.push(b)
        }
    }
    return fromBytesOr(out, key)
}

// The locale reader: `std/jsonread` parses each `<locale>.json`, and this
// adapter flattens it to `home.title` -> value entries. Leaves must be strings;
// anything else fails with a reason.

type LocaleEntry = { key: String, value: String }

/// A flattened locale in source order, or `ok = false` with a reason. `slots`
/// maps each key to its first index in `entries`; a linear scan per lookup was
/// quadratic in the key count.
type LocaleData = {
    ok: Bool,
    error: String,
    entries: Array<LocaleEntry>,
    slots: Map<String, Int64>,
}

fn dataError(msg: String) -> LocaleData {
    return LocaleData { ok: false, error: msg.copy(), entries: [], slots: [:] }
}

/// The leaf-kind error for a value that is neither a string nor a nested object.
fn i18nUnsupported() -> String {
    return "unsupported value (only strings and nested objects are allowed)"
}

/// Appends one entry; returns `""`, the flatten walk's no-error value.
fn addEntry(entries: modify Array<LocaleEntry>, key: String, value: String) -> String {
    entries.push(LocaleEntry { key: key.copy(), value: value.copy() })
    return ""
}

/// Flatten an object's fields at `prefix`, dot-joining keys. Returns "" or
/// the first leaf error.
fn flattenObj(prefix: String, fields: Array<JsonField>, entries: modify Array<LocaleEntry>) -> String {
    for f in fields {
        let key = if prefix == "" { f.key.copy() } else { prefix + "." + f.key }
        let e = flattenValue(key, f.value, entries)
        if e != "" {
            return e
        }
    }
    return ""
}

/// Flatten one JSON value at `prefix` into `entries`; returns "" or an error.
/// Only strings and nested objects are allowed.
fn flattenValue(prefix: String, j: Json, entries: modify Array<LocaleEntry>) -> String {
    return match j {
        JObj(fields) => flattenObj(prefix, fields, entries),
        JStr(s) => addEntry(entries, prefix, s),
        JNull => i18nUnsupported(),
        JBool(b) => i18nUnsupported(),
        JNum(n) => i18nUnsupported(),
        JArr(a) => i18nUnsupported(),
    }
}

/// The top-level document must be a JSON object.
fn localeFromObj(fields: Array<JsonField>) -> LocaleData {
    let mut entries: Array<LocaleEntry> = []
    let e = flattenObj("", fields, entries)
    if e != "" {
        return dataError(e)
    }
    // First occurrence wins; the collision check reports duplicates.
    let mut slots: Map<String, Int64> = [:]
    let mut i = 0
    while i < entries.length {
        if let Some(_) = slots[entries[i].key] {} else {
            slots[entries[i].key.copy()] = i
        }
        i = i + 1
    }
    return LocaleData { ok: true, error: "", entries: entries, slots: slots }
}

fn localeFromJson(j: Json) -> LocaleData {
    return match j {
        JObj(fields) => localeFromObj(fields),
        JNull => dataError("expected a JSON object at the top level"),
        JBool(b) => dataError("expected a JSON object at the top level"),
        JNum(n) => dataError("expected a JSON object at the top level"),
        JStr(s) => dataError("expected a JSON object at the top level"),
        JArr(a) => dataError("expected a JSON object at the top level"),
    }
}

/// Parse one locale document into flattened entries.
fn parseLocaleJson(src: String) -> LocaleData {
    return match parseJson(src) {
        Ok(j) => localeFromJson(j),
        Err(e) => dataError(e),
    }
}

/// The flattened keys of a locale in source order.
gen fn localeKeys(d: LocaleData) -> Array<String> {
    let mut out: Array<String> = []
    for e in d.entries {
        out.push(e.key.copy())
    }
    return out
}

/// The index of `key` in locale `d`, or -1.
gen fn entryIndex(d: LocaleData, key: String) -> Int64 {
    if let Some(i) = d.slots[key] {
        return i
    }
    return 0 - 1
}

gen fn hasKey(d: LocaleData, key: String) -> Bool {
    if let Some(_) = d.slots[key] {
        return true
    }
    return false
}

// The ICU message reader: brace and quote scanning shared by the argument
// scanner and the body compiler.

/// The resolution of an apostrophe under ICU quoting: whether a literal `'` byte
/// is produced, the resulting quote mode, and how many bytes were consumed.
type IcuQuote = { emit: Bool, quoted: Bool, advance: Int64 }

/// Resolve an apostrophe at `ba[j]` under ICU quoting, for every quote-aware
/// scanner here:
///   - `''` is always one literal apostrophe;
///   - a lone `'` opens a quote only when not quoting and the next byte is
///     `{`, `}` or `#`;
///   - a `'` while quoting closes the quote;
///   - any other lone `'` (as in `It's`) is a literal apostrophe.
gen fn icuApostrophe(ba: Array<UInt8>, j: Int64, e: Int64, quoted: Bool) -> IcuQuote {
    if j + 1 < e && ba[j + 1] == '\x27' {
        return IcuQuote { emit: true, quoted: quoted, advance: 2 }
    }
    if quoted {
        return IcuQuote { emit: false, quoted: false, advance: 1 }
    }
    if j + 1 < e && (ba[j + 1] == '{' || ba[j + 1] == '}' || ba[j + 1] == '#') {
        return IcuQuote { emit: false, quoted: true, advance: 1 }
    }
    return IcuQuote { emit: true, quoted: false, advance: 1 }
}

/// A literal run: decoded text and the next index. `hash` is true when the
/// run stopped at an unquoted `#`.
type LitRead = { text: String, next: Int64, hash: Bool }

/// Read a literal run over `ba[i..e)`, resolving quoting, up to an unquoted
/// `{`, `}`, or (when `stopHash`) `#`.
gen fn readLiteral(ba: Array<UInt8>, i: Int64, e: Int64, stopHash: Bool) -> LitRead {
    let mut out: Array<UInt8> = []
    let mut j = i
    let mut quoted = false
    while j < e {
        let b = ba[j]
        if b == '\x27' {
            let q = icuApostrophe(ba, j, e, quoted)
            if q.emit {
                out.push('\x27')
            }
            quoted = q.quoted
            j = j + q.advance
        } else if quoted {
            out.push(b)
            j = j + 1
        } else {
            if b == '{' || b == '}' {
                return LitRead { text: fromBytesOr(out, ""), next: j, hash: false }
            }
            if stopHash && b == '#' {
                return LitRead { text: fromBytesOr(out, ""), next: j, hash: true }
            }
            out.push(b)
            j = j + 1
        }
    }
    return LitRead { text: fromBytesOr(out, ""), next: j, hash: false }
}

/// The index just past the `}` matching the `{` at `open`, quote-aware.
gen fn matchBrace(ba: Array<UInt8>, open: Int64, e: Int64) -> Int64 {
    let mut depth = 0
    let mut i = open
    let mut quoted = false
    while i < e {
        let b = ba[i]
        if b == '\x27' {
            let q = icuApostrophe(ba, i, e, quoted)
            quoted = q.quoted
            i = i + q.advance
        } else if quoted {
            i = i + 1
        } else if b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '}' {
            depth = depth - 1
            i = i + 1
            if depth == 0 {
                return i
            }
        } else {
            i = i + 1
        }
    }
    return i
}

/// Split `ba[s..e)` on commas at brace depth 0, quote-aware; parts are
/// trimmed.
gen fn splitTopCommas(ba: Array<UInt8>, s: Int64, e: Int64) -> Array<String> {
    let mut parts: Array<String> = []
    let mut depth = 0
    let mut quoted = false
    let mut segStart = s
    let mut i = s
    while i < e {
        let b = ba[i]
        if b == '\x27' {
            let q = icuApostrophe(ba, i, e, quoted)
            quoted = q.quoted
            i = i + q.advance
        } else if quoted {
            i = i + 1
        } else if b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '}' {
            depth = depth - 1
            i = i + 1
        } else if b == ',' && depth == 0 {
            parts.push(trim(sliceStr(ba, segStart, i)))
            i = i + 1
            segStart = i
        } else {
            i = i + 1
        }
    }
    parts.push(trim(sliceStr(ba, segStart, e)))
    return parts
}

/// One selector/text pair of a plural or select body (`one {...}`).
type Branch = { selector: String, text: String }

type Branches = { branches: Array<Branch> }

gen fn parseBranches(blob: String) -> Branches {
    let ba = bytes(blob)
    let e = ba.length
    let mut items: Array<Branch> = []
    let mut i = skipWs(ba, 0, e)
    while i < e {
        let mut selEnd = i
        while selEnd < e && isWs(ba[selEnd]) == false && ba[selEnd] != '{' {
            selEnd = selEnd + 1
        }
        let sel = sliceStr(ba, i, selEnd)
        let braceAt = skipWs(ba, selEnd, e)
        if braceAt >= e || ba[braceAt] != '{' {
            return Branches { branches: items }
        }
        let close = matchBrace(ba, braceAt, e)
        let inner = sliceStr(ba, braceAt + 1, close - 1)
        items.push(Branch { selector: sel, text: inner })
        i = skipWs(ba, close, e)
    }
    return Branches { branches: items }
}

/// The text of the branch named `sel`, falling back to `other`.
gen fn branchText(br: Branches, sel: String) -> String {
    for b in br.branches {
        if b.selector == sel {
            return b.text.copy()
        }
    }
    for b in br.branches {
        if b.selector == "other" {
            return b.text.copy()
        }
    }
    return ""
}

gen fn hasBranch(br: Branches, sel: String) -> Bool {
    for b in br.branches {
        if b.selector == sel {
            return true
        }
    }
    return false
}

// Argument scanning: the name, kind and branches of every placeholder, for
// drift checks, signatures and select types.

/// The arguments of one message. `kind` is "string", "plural" or "select";
/// `branches` is the comma-joined selector set of a select (else ""). `ok =
/// false` flags unsupported syntax.
type ArgScan = {
    ok: Bool,
    error: String,
    names: Array<String>,
    kinds: Array<String>,
    branches: Array<String>,
}

gen fn argError(msg: String) -> ArgScan {
    return ArgScan { ok: false, error: msg.copy(), names: [], kinds: [], branches: [] }
}

/// Whether an argument name starts with `__`, the prefix of the generated
/// accumulator `__acc`; `scanArgs` refuses such a message.
fn argReserved(name: String) -> Bool {
    return startsWith(name, "__")
}

/// Sorted, comma-joined selector names, so the signature ignores order.
gen fn joinSortedSelectors(br: Branches) -> String {
    let mut names: Array<String> = []
    for b in br.branches {
        names.push(b.selector.copy())
    }
    let mut i = 1
    while i < names.length {
        let mut j = i
        while j > 0 && names[j - 1] > names[j] {
            let tmp = names[j - 1].copy()
            names[j - 1] = names[j].copy()
            names[j] = tmp
            j = j - 1
        }
        i = i + 1
    }
    return joinWith(names, ",")
}

/// Scan a message's arguments, recursing one level into branch texts for
/// simple `{name}` arguments; a nested plural or select is unsupported.
gen fn scanArgs(msg: String) -> ArgScan {
    let ba = bytes(msg)
    let e = ba.length
    let mut names: Array<String> = []
    let mut kinds: Array<String> = []
    let mut branches: Array<String> = []
    let mut i = 0
    while i < e {
        let lit = readLiteral(ba, i, e, false)
        i = lit.next
        if i >= e {
            i = e
        } else if ba[i] == '}' {
            i = i + 1
        } else if ba[i] == '{' {
            let close = matchBrace(ba, i, e)
            let parts = splitTopCommas(ba, i + 1, close - 1)
            if parts.length == 1 {
                if argReserved(parts[0]) {
                    return argError("argument name `\{parts[0]}` uses the reserved `__` prefix — rename the argument")
                }
                names.push(parts[0].copy())
                kinds.push("string")
                branches.push("")
            } else {
                let kw = parts[1]
                if kw == "plural" || kw == "select" {
                    let blobStart = i + 1
                    let blob = branchBlob(ba, blobStart, close - 1)
                    let br = parseBranches(blob)
                    if argReserved(parts[0]) {
                        return argError("argument name `\{parts[0]}` uses the reserved `__` prefix — rename the argument")
                    }
                    names.push(parts[0].copy())
                    if kw == "plural" {
                        for b in br.branches {
                            let exact = match parseInt64(substring(b.selector, 1, b.selector.byteLength)) {
                                Some(v) => true,
                                None => false,
                            }
                            if startsWith(b.selector, "=") && exact == false {
                                return argError("plural selector `\{b.selector}` is not `=` and an integer — write an exact count such as `=0`")
                            }
                        }
                        kinds.push("plural")
                        branches.push("")
                    } else {
                        // Refuse a selector containing ',': the branch set is
                        // comma-joined and split back, so the type would admit
                        // each part while the code compares the whole token.
                        for b in br.branches {
                            if contains(b.selector, ",") {
                                return argError("select selector `\{b.selector}` contains `,`, but branch names are serialized comma-joined — rename the branch")
                            }
                        }
                        kinds.push("select")
                        branches.push(joinSortedSelectors(br))
                    }
                    for b in br.branches {
                        let sub = scanArgs(b.text)
                        if sub.ok == false {
                            return sub
                        }
                        let mut si = 0
                        while si < sub.names.length {
                            if sub.kinds[si] != "string" {
                                return argError("nested plural/select is not supported (v1)")
                            }
                            names.push(sub.names[si].copy())
                            kinds.push(sub.kinds[si].copy())
                            branches.push(sub.branches[si].copy())
                            si = si + 1
                        }
                    }
                } else {
                    return argError("unknown argument type (expected `plural` or `select`)")
                }
            }
            i = close
        } else {
            i = i + 1
        }
    }
    return dedupeArgs(names, kinds, branches)
}

/// The remainder of `ba[s..e)` after the leading `name, kw,`.
gen fn branchBlob(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut depth = 0
    let mut quoted = false
    let mut commas = 0
    let mut i = s
    while i < e {
        let b = ba[i]
        if b == '\x27' {
            let q = icuApostrophe(ba, i, e, quoted)
            quoted = q.quoted
            i = i + q.advance
        } else if quoted {
            i = i + 1
        } else if b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '}' {
            depth = depth - 1
            i = i + 1
        } else if b == ',' && depth == 0 {
            commas = commas + 1
            i = i + 1
            if commas == 2 {
                return sliceStr(ba, i, e)
            }
        } else {
            i = i + 1
        }
    }
    return ""
}

/// Drop duplicate argument names (one can appear in several branches),
/// keeping the first kind and branches.
gen fn dedupeArgs(names: Array<String>, kinds: Array<String>, branches: Array<String>) -> ArgScan {
    let mut on: Array<String> = []
    let mut ok2: Array<String> = []
    let mut ob: Array<String> = []
    let mut i = 0
    while i < names.length {
        let mut seen = false
        let mut j = 0
        while j < on.length {
            if on[j] == names[i] {
                seen = true
            }
            j = j + 1
        }
        if seen == false {
            on.push(names[i].copy())
            ok2.push(kinds[i].copy())
            ob.push(branches[i].copy())
        }
        i = i + 1
    }
    return ArgScan { ok: true, error: "", names: on, kinds: ok2, branches: ob }
}

/// An order-independent signature of an argument set, for drift equality.
gen fn argSignature(sc: ArgScan) -> String {
    let mut items: Array<String> = []
    let mut i = 0
    while i < sc.names.length {
        items.push(sc.names[i] + ":" + sc.kinds[i] + ":" + sc.branches[i])
        i = i + 1
    }
    let mut a = 1
    while a < items.length {
        let mut b = a
        while b > 0 && items[b - 1] > items[b] {
            let tmp = items[b - 1].copy()
            items[b - 1] = items[b].copy()
            items[b] = tmp
            b = b - 1
        }
        a = a + 1
    }
    return joinWith(items, ";")
}

// CLDR cardinal plural rules for the covered locales, compiled into the
// emitted `if` chain. Any other locale is a generation error.

/// The ordered non-`other` categories of a locale (empty: only `other`).
gen fn pluralCategories(tag: String) -> Array<String> {
    if tag == "en" || tag == "de" || tag == "es" || tag == "it" || tag == "fr" || tag == "pt" {
        return ["one"]
    }
    if tag == "uk" || tag == "ru" || tag == "pl" {
        return ["one", "few", "many"]
    }
    if tag == "ja" || tag == "zh" || tag == "ko" {
        return []
    }
    return ["__unsupported__"]
}

gen fn pluralSupported(tag: String) -> Bool {
    let cats = pluralCategories(tag)
    if cats.length == 1 {
        if cats[0] == "__unsupported__" {
            return false
        }
    }
    return true
}

/// `|v|` as an inline expression. CLDR plural operands are absolute and Vyrn's
/// `%` truncates toward zero (`-5 % 10 == -5`); an expression, not a local, so
/// two plurals in one message cannot collide.
gen fn pluralAbs(v: Name) -> Code {
    return vyrn"(if \{v} < 0 { 0 - \{v} } else { \{v} })"
}

/// The Vyrn condition selecting category `cat` for `tag` over `pluralAbs(v)`.
/// Without the absolute value -3 misses `few` and -5 misses `many` in the
/// Slavic locales. `#` still prints the raw count.
gen fn pluralCondition(tag: String, cat: String, v: Name) -> Code {
    let a = pluralAbs(v)
    if tag == "en" || tag == "de" || tag == "es" || tag == "it" {
        return vyrn"\{a} == 1"
    }
    if tag == "fr" || tag == "pt" {
        return vyrn"\{a} == 0 || \{a} == 1"
    }
    if tag == "uk" || tag == "ru" {
        if cat == "one" {
            return vyrn"\{a} % 10 == 1 && \{a} % 100 != 11"
        }
        if cat == "few" {
            return vyrn"\{a} % 10 >= 2 && \{a} % 10 <= 4 && (\{a} % 100 < 12 || \{a} % 100 > 14)"
        }
        return vyrn"\{a} % 10 == 0 || (\{a} % 10 >= 5 && \{a} % 10 <= 9) || (\{a} % 100 >= 11 && \{a} % 100 <= 14)"
    }
    // pl
    if cat == "one" {
        return vyrn"\{a} == 1"
    }
    if cat == "few" {
        return vyrn"\{a} % 10 >= 2 && \{a} % 10 <= 4 && (\{a} % 100 < 12 || \{a} % 100 > 14)"
    }
    return vyrn"\{a} != 1 && ((\{a} % 10 >= 0 && \{a} % 10 <= 1) || (\{a} % 10 >= 5 && \{a} % 10 <= 9) || (\{a} % 100 >= 12 && \{a} % 100 <= 14))"
}

// The body compiler: one message, for one locale, as Vyrn statements that
// append to `__acc`. `scanArgs` has already accepted the message.

/// The statements building `__acc` for `msg`. `pluralVar` names the number
/// argument inside a plural branch, so `#` resolves; it is "" elsewhere.
gen fn compileBody(msg: String, tag: String, pluralVar: String) -> Code {
    let ba = bytes(msg)
    let e = ba.length
    let mut stmts: Array<Code> = []
    let mut i = 0
    while i < e {
        let lit = readLiteral(ba, i, e, pluralVar != "")
        if lit.text.byteLength > 0 {
            stmts.push(vyrn"__acc = __acc + \{lit.text}")
        }
        i = lit.next
        if i >= e {
            i = e
        } else {
            let b = ba[i]
            if b == '#' && pluralVar != "" {
                stmts.push(vyrn"__acc = __acc + \{name(pluralVar)}.toString()")
                i = i + 1
            } else if b == '}' {
                i = i + 1
            } else if b == '{' {
                let close = matchBrace(ba, i, e)
                let parts = splitTopCommas(ba, i + 1, close - 1)
                if parts.length == 1 {
                    stmts.push(vyrn"__acc = __acc + \{name(parts[0])}")
                } else {
                    let br = parseBranches(branchBlob(ba, i + 1, close - 1))
                    if parts[1] == "plural" {
                        stmts.push(compilePlural(br, tag, parts[0]))
                    } else {
                        stmts.push(compileSelect(br, tag, parts[0]))
                    }
                }
                i = close
            } else {
                i = i + 1
            }
        }
    }
    return join(stmts, vyrn"\n")
}

/// A plural placeholder as an `if` chain over the locale's categories, each
/// branch compiled with `#` bound to `argName`.
gen fn compilePlural(br: Branches, tag: String, argName: String) -> Code {
    let n = name(argName)
    // Exact `=N` selectors come first and compare the count as written, not
    // |count|: ICU's explicit value is a separate selector form without plural
    // operands. `=1` on |count| would say "one file" for -1.
    let mut arms: Array<Code> = []
    for b in br.branches {
        if startsWith(b.selector, "=") {
            // scanArgs refuses a selector that is not `=` and an integer.
            if let Some(v) = parseInt64(substring(b.selector, 1, b.selector.byteLength)) {
                arms.push(arm(vyrn"\{n} == \{v}", compileBody(b.text, tag, argName)))
            }
        }
    }
    for cat in pluralCategories(tag) {
        arms.push(arm(pluralCondition(tag, cat, n), compileBody(branchText(br, cat), tag, argName)))
    }
    return ifChainOr(arms, compileBody(branchText(br, "other"), tag, argName))
}

/// A select placeholder as an equality chain over the branch names.
gen fn compileSelect(br: Branches, tag: String, argName: String) -> Code {
    let n = name(argName)
    let mut arms: Array<Code> = []
    for b in br.branches {
        if b.selector != "other" {
            arms.push(arm(vyrn"\{n} == \{b.selector}", compileBody(b.text, tag, "")))
        }
    }
    return ifChainOr(arms, compileBody(branchText(br, "other"), tag, ""))
}

// Drift errors: one `std/diag` report per issue, anchored in the locale file.

/// A report anchored at line 1, column 1 of a locale file: a flattened entry
/// keeps no offset into its JSON.
gen fn localeErr(dir: String, tag: String, message: String) -> Code {
    return report(Error, dir + "/" + tag + ".json", 1, 1, message)
}

/// Whether a message has an unmatched `{` or a stray `}`, quote-aware. An
/// unbalanced brace would otherwise invent a parameter or drop text.
gen fn icuBadBrace(msg: String) -> Bool {
    let ba = bytes(msg)
    let e = ba.length
    let mut depth = 0
    let mut quoted = false
    let mut i = 0
    while i < e {
        let b = ba[i]
        if b == '\x27' {
            let q = icuApostrophe(ba, i, e, quoted)
            quoted = q.quoted
            i = i + q.advance
        } else if quoted {
            i = i + 1
        } else if b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '}' {
            if depth == 0 {
                return true
            }
            depth = depth - 1
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return depth != 0
}

/// Key-collision messages for the base locale, each naming the colliding keys
/// instead of a "function defined twice":
///   - a dotted key (`"a.b"`) and a nested object (`"a": {"b": ...}`) flatten
///     to the same `a.b`;
///   - two keys share a PascalCase name (`home.title` and `homeTitle` both make
///     `tHomeTitle`);
///   - one key's unprefixed alias is another's function name (`tCart.items`
///     aliases to `tCartItems`, the function of `cart.items`);
///   - a key's names land on the module's own exports (`Locale` emits the
///     alias `locale`).
gen fn keyCollisionErrors(base: LocaleData) -> Array<String> {
    let keys = localeKeys(base)
    let reserved: Array<String> = ["locale", "setLocale", "t", "transKey"]
    // Derive each key's names once and ask three maps whether any pair
    // collides; re-deriving per pair exhausted the generator's step budget at
    // 400 keys. Only on a hit does the pair loop run, to word the messages.
    let mut anyPair = false
    let mut seenKeys: Map<String, Bool> = [:]
    let mut fnNames: Map<String, Bool> = [:]
    let mut plainNames: Map<String, Bool> = [:]
    for k in keys {
        if let Some(_) = seenKeys[k] {
            anyPair = true
        }
        seenKeys[k.copy()] = true
        let f = keyFnName(k)
        let p = keyPlainName(k)
        if let Some(_) = fnNames[f] {
            anyPair = true
        }
        if let Some(_) = plainNames[f] {
            anyPair = true
        }
        if let Some(_) = fnNames[p] {
            anyPair = true
        }
        fnNames[f] = true
        plainNames[p] = true
    }
    let mut out: Array<String> = []
    if anyPair {
        let mut i = 0
        while i < keys.length {
            let mut j = i + 1
            while j < keys.length {
                if keys[i] == keys[j] {
                    out.push("key `\{keys[i]}` is defined twice — a dotted key and a nested object flatten to one key, so keep only one of them")
                } else if keyFnName(keys[i]) == keyFnName(keys[j]) {
                    out.push("keys `\{keys[i]}` and `\{keys[j]}` both name the function `\{keyFnName(keys[i])}` — a key and a Vyrn identifier are different alphabets, and these two keys convert to one name; rename one key")
                } else if keyPlainName(keys[i]) == keyFnName(keys[j]) || keyFnName(keys[i]) == keyPlainName(keys[j]) {
                    let shared = if keyPlainName(keys[i]) == keyFnName(keys[j]) {
                        keyFnName(keys[j])
                    } else {
                        keyFnName(keys[i])
                    }
                    out.push("keys `\{keys[i]}` and `\{keys[j]}` collide through different doors — one key's un-prefixed alias is the other's function `\{shared}`; rename one key")
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    // A key whose derived names land on the module's own exports.
    for k in keys {
        for r in reserved {
            if keyPlainName(k) == r || keyFnName(k) == r {
                out.push("key `\{k}` derives the name `\{r}`, which is the module's own export — rename the key")
            }
        }
    }
    return out
}

/// Read every `<locale>.json` under `dir`, check the locales, and return the
/// translation module.
export gen fn i18n(dir: String) -> Code {
    return checkedLocales(dir, false)
}

/// Read every `<locale>.json` under `dir`, check the locales, and return one exported
/// function per key and locale, each of which reads no module state.
export gen fn catalogue(dir: String) -> Code {
    return checkedLocales(dir, true)
}

/// The module of the locales under `dir`, or why they do not agree: the functions
/// alone for a `catalogue`.
gen fn checkedLocales(dir: String, functionsOnly: Bool) -> Code {
    let files = match listDir(dir) {
        Ok(ns) => ns,
        Err(err) => [],
    }
    let mut tags: Array<String> = []
    let mut datas: Array<LocaleData> = []
    for name in files {
        if name.endsWith(".json") {
            let tag = substring(name, 0, name.byteLength - 5)
            let src = match readFile(dir + "/" + name) {
                Ok(v) => v,
                Err(err) => "",
            }
            let data = parseLocaleJson(src)
            if data.ok == false {
                return localeErr(
                    dir,
                    tag,
                    "locale `\{tag}` is not a usable locale file — \{data.error}",
                )
            }
            tags.push(tag)
            datas.push(data)
        }
    }
    if tags.length == 0 {
        return reportHere(
            Error,
            "no locale files under `\{dir}` — i18n reads one `<locale>.json` per locale, so add at least one",
        )
    }

    // Two keys that produce one function name fail with a report naming both.
    let mut errs: Array<Code> = []
    for m in keyCollisionErrors(datas[0]) {
        errs.push(localeErr(dir, tags[0], m))
    }
    if errs.length > 0 {
        return join(errs, vyrn"")
    }

    // An unbalanced brace in any locale fails, naming the key.
    let mut bi = 0
    while bi < tags.length {
        let bd = datas[bi]
        let mut bk = 0
        while bk < bd.entries.length {
            if icuBadBrace(bd.entries[bk].value) {
                errs.push(localeErr(
                    dir,
                    tags[bi],
                    "key `\{bd.entries[bk].key}` has an unbalanced brace — every `{` needs a matching `}`, and a literal brace is written `'{'`",
                ))
            }
            bk = bk + 1
        }
        bi = bi + 1
    }
    if errs.length > 0 {
        return join(errs, vyrn"")
    }

    // Every locale must have the base key set and the same argument signature
    // per key. The base is the first locale alphabetically; it supplies docs,
    // signatures and types.
    let base = datas[0]
    let baseTag = tags[0]
    let mut li = 0
    while li < tags.length {
        let d = datas[li]
        let tag = tags[li]
        let mut ki = 0
        while ki < base.entries.length {
            if hasKey(d, base.entries[ki].key) == false {
                errs.push(localeErr(
                    dir,
                    tag,
                    "locale `\{tag}` is missing key `\{base.entries[ki].key}`, which `\{baseTag}` defines — every locale carries the same key set, so add it or drop it from `\{baseTag}`",
                ))
            }
            ki = ki + 1
        }
        ki = 0
        while ki < d.entries.length {
            if hasKey(base, d.entries[ki].key) == false {
                errs.push(localeErr(
                    dir,
                    tag,
                    "locale `\{tag}` defines key `\{d.entries[ki].key}`, which `\{baseTag}` does not — every locale carries the same key set, so add it to `\{baseTag}` or drop it here",
                ))
            }
            ki = ki + 1
        }
        li = li + 1
    }
    let mut ki = 0
    while ki < base.entries.length {
        let key = base.entries[ki].key
        let baseScan = scanArgs(base.entries[ki].value)
        if baseScan.ok == false {
            // A base the scanner refuses is reported as that refusal, not as a
            // mismatch against every locale.
            return localeErr(
                dir,
                baseTag,
                "key `\{key}` uses ICU this generator does not support — \{baseScan.error}",
            )
        }
        let baseSig = argSignature(baseScan)
        let mut lj = 1
        while lj < tags.length {
            let d = datas[lj]
            let vi = entryIndex(d, key)
            if vi >= 0 {
                let sc = scanArgs(d.entries[vi].value)
                if sc.ok == false {
                    return localeErr(
                        dir,
                        tags[lj],
                        "key `\{key}` uses ICU this generator does not support — \{sc.error}",
                    )
                }
                if argSignature(sc) != baseSig {
                    errs.push(localeErr(
                        dir,
                        tags[lj],
                        "key `\{key}` takes `\{argSignature(sc)}` here and `\{baseSig}` in `\{baseTag}` — one key has one signature across every locale",
                    ))
                }
            }
            lj = lj + 1
        }
        ki = ki + 1
    }
    if errs.length > 0 {
        return join(errs, vyrn"")
    }

    ki = 0
    while ki < base.entries.length {
        let sc = scanArgs(base.entries[ki].value)
        if sc.ok == false {
            return localeErr(
                dir,
                baseTag,
                "key `\{base.entries[ki].key}` uses ICU this generator does not support — \{sc.error}",
            )
        }
        // A plural argument needs a covered plural rule in every locale.
        let mut ai = 0
        while ai < sc.kinds.length {
            if sc.kinds[ai] == "plural" {
                let mut lj = 0
                while lj < tags.length {
                    if pluralSupported(tags[lj]) == false {
                        return localeErr(
                            dir,
                            tags[lj],
                            "key `\{base.entries[ki].key}` uses `plural`, and locale `\{tags[lj]}` has no plural rule in this generator's table — write the key without `plural`, or drop the locale",
                        )
                    }
                    lj = lj + 1
                }
            }
            ai = ai + 1
        }
        ki = ki + 1
    }

    return if functionsOnly { buildCatalogue(tags, datas) } else { buildModule(tags, datas) }
}

/// What a `catalogue` writes.
gen fn buildCatalogue(tags: Array<String>, datas: Array<LocaleData>) -> Code {
    let mut decls: Array<Code> = [buildSelectTypes(datas[0])]
    for e in datas[0].entries {
        let mut li = 0
        while li < tags.length {
            decls.push(vyrn"export " + buildLocaleFn(e.key, tags[li], datas[li], scanArgs(e.value)))
            li = li + 1
        }
    }
    return join(decls, vyrn"\n") + vyrn"\n"
}

/// The whole generated module.
gen fn buildModule(tags: Array<String>, datas: Array<LocaleData>) -> Code {
    let base = datas[0]
    let mut locales: Array<Code> = []
    for tag in tags {
        locales.push(vyrn"\{name(upperFirst(tag))}")
    }
    let variants = join(locales, vyrn", ")
    let first = name(upperFirst(tags[0]))
    let mut keys: Array<String> = []
    for e in base.entries {
        keys.push(regexEscapeKey(e.key))
    }
    let keySet = "(" + joinWith(keys, "|") + ")"
    let mut decls: Array<Code> = []
    decls.push(vyrn"""
        export type Locale = enum { \{variants} }
        let mut currentLocale: Locale = \{first}
        export fn setLocale(l: Locale) { currentLocale = l }
        export fn locale() -> Locale { return currentLocale }
        export type TransKey = String where value =~ \{keySet}
        """)
    decls.push(buildSelectTypes(base))
    for e in base.entries {
        decls.push(buildKeyFns(e.key, e.value, tags, datas))
    }
    decls.push(buildT(tags, datas))
    decls.push(buildTransKey(base))
    return join(decls, vyrn"\n") + vyrn"\n"
}

/// One finite string type per `select` argument of a key in `base`.
gen fn buildSelectTypes(base: LocaleData) -> Code {
    let mut decls: Array<Code> = []
    for e in base.entries {
        let sc = scanArgs(e.value)
        let mut ai = 0
        while ai < sc.names.length {
            if sc.kinds[ai] == "select" {
                let mut sels: Array<String> = []
                for sel in splitCsv(sc.branches[ai]) {
                    sels.push(regexEscapeKey(sel))
                }
                let selSet = "(" + joinWith(sels, "|") + ")"
                decls.push(vyrn"export type \{selectType(e.key, sc.names[ai])} = String where value =~ \{selSet}")
            }
            ai = ai + 1
        }
    }
    return join(decls, vyrn"\n")
}

/// Emits `transKey(s)`: `Some(s)` when `s` is a key, else `None`, as an if
/// chain over the finite key set.
gen fn buildTransKey(base: LocaleData) -> Code {
    let mut tests: Array<Code> = []
    for e in base.entries {
        tests.push(vyrn"""
            if s == \{e.key} {
                return Some(\{e.key})
            }
            """)
    }
    let body = join(tests, vyrn"\n")
    return vyrn"""
        export fn transKey(s: String) -> Option<TransKey> {
            \{body}
            return None
        }
        """
}

/// Split a comma-joined string (no quoting) into parts.
gen fn splitCsv(s: String) -> Array<String> {
    let ba = bytes(s)
    let mut parts: Array<String> = []
    let mut start = 0
    let mut i = 0
    while i < ba.length {
        if ba[i] == ',' {
            parts.push(sliceStr(ba, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if ba.length > 0 {
        parts.push(sliceStr(ba, start, ba.length))
    }
    return parts
}

/// The type of select argument `arg` of `key`: `TStatusState`.
gen fn selectType(key: String, arg: String) -> Name {
    return name("T" + keyTypeBase(key) + upperFirst(arg))
}

/// The parameters `count: Int64, name: String` of a key's arguments.
gen fn paramList(key: String, sc: ArgScan) -> Code {
    let mut params: Array<Code> = []
    let mut i = 0
    while i < sc.names.length {
        params.push(vyrn"\{name(sc.names[i])}: \{argType(key, sc.names[i], sc.kinds[i])}")
        i = i + 1
    }
    return join(params, vyrn", ")
}

/// The arguments `count, name` that forward a key's parameters.
gen fn argList(sc: ArgScan) -> Code {
    let mut args: Array<Code> = []
    for n in sc.names {
        args.push(vyrn"\{name(n)}")
    }
    return join(args, vyrn", ")
}

gen fn argType(key: String, arg: String, kind: String) -> Code {
    if kind == "plural" {
        return vyrn"Int64"
    }
    if kind == "select" {
        return vyrn"\{selectType(key, arg)}"
    }
    return vyrn"String"
}

/// The functions of one key: a private helper per locale and the exported
/// dispatcher over `currentLocale`, documented with the base message.
gen fn buildKeyFns(key: String, baseVal: String, tags: Array<String>, datas: Array<LocaleData>) -> Code {
    let sc = scanArgs(baseVal)
    let f = name(keyFnName(key))
    let plain = name(keyPlainName(key))
    let params = paramList(key, sc)
    let args = argList(sc)
    let doc = docComment(baseVal)
    let mut helpers: Array<Code> = []
    let mut arms: Array<Code> = []
    let mut li = 0
    while li < tags.length {
        let helper = name(keyFnName(key) + "__" + upperFirst(tags[li]))
        helpers.push(buildLocaleFn(key, tags[li], datas[li], sc))
        arms.push(vyrn"\{name(upperFirst(tags[li]))} => \{helper}(\{args})")
        li = li + 1
    }
    let fns = join(helpers, vyrn"\n")
    let dispatch = join(arms, vyrn", ")
    // The unprefixed alias delegates to the dispatcher, so both share one body.
    return vyrn"""
        \{fns}
        /// \{doc}
        export fn \{f}(\{params}) -> String {
            return match currentLocale { \{dispatch} }
        }
        /// \{doc}
        export fn \{plain}(\{params}) -> String {
            return \{f}(\{args})
        }
        """
}

/// The function of `key` in the locale `tag`, whose data is `d`.
gen fn buildLocaleFn(key: String, tag: String, d: LocaleData, sc: ArgScan) -> Code {
    let helper = name(keyFnName(key) + "__" + upperFirst(tag))
    let params = paramList(key, sc)
    let body = compileBody(d.entries[entryIndex(d, key)].value, tag, "")
    return vyrn"""
        fn \{helper}(\{params}) -> String {
            let mut __acc = ""
            \{body}
            return __acc
        }
        """
}

/// A one-line doc rendering of a message (newlines collapsed to spaces).
gen fn docComment(msg: String) -> String {
    let ba = bytes(msg)
    let mut out: Array<UInt8> = []
    for b in ba {
        if b == '\n' || b == '\r' {
            out.push(' ')
        } else {
            out.push(b)
        }
    }
    return fromBytesOr(out, msg)
}

/// Emits `t(key)`: the current locale's text of an argument-less key, and the
/// raw pattern of a key that takes arguments.
gen fn buildT(tags: Array<String>, datas: Array<LocaleData>) -> Code {
    let base = datas[0]
    let mut tests: Array<Code> = []
    for e in base.entries {
        if scanArgs(e.value).names.length == 0 {
            let mut arms: Array<Code> = []
            let mut li = 0
            while li < tags.length {
                let d = datas[li]
                let msg = bytes(d.entries[entryIndex(d, e.key)].value)
                let lit = readLiteral(msg, 0, msg.length, false)
                arms.push(vyrn"\{name(upperFirst(tags[li]))} => \{lit.text}")
                li = li + 1
            }
            let texts = join(arms, vyrn", ")
            tests.push(vyrn"""
                if key == \{e.key} {
                    return match currentLocale { \{texts} }
                }
                """)
        } else {
            tests.push(vyrn"""
                if key == \{e.key} {
                    return \{e.value}
                }
                """)
        }
    }
    let body = join(tests, vyrn"\n")
    return vyrn"""
        export fn t(key: TransKey) -> String {
            \{body}
            return key.copy()
        }
        """
}

// The tests feed the pure helpers source strings; no file I/O.

/// The statements `compileBody` writes for `msg`, which a test can read.
gen fn bodyText(msg: String, tag: String) -> String {
    return render(compileBody(msg, tag, ""))
}

/// The condition `pluralCondition` writes over `count`, which a test can read.
gen fn conditionText(tag: String, cat: String) -> String {
    return render(pluralCondition(tag, cat, name("count")))
}

test "parseLocaleJson flattens nested keys with dots" {
    let src = "{ \"home\": { \"title\": \"Hi\" }, \"greeting\": \"Yo\" }"
    let d = parseLocaleJson(src)
    assert(d.ok)
    assertEq(d.entries.length, 2)
    assertEq(d.entries[0].key, "home.title")
    assertEq(d.entries[0].value, "Hi")
    assertEq(d.entries[1].key, "greeting")
}

test "parseLocaleJson rejects a non-string value" {
    let d = parseLocaleJson("{ \"n\": 5 }")
    assertEq(d.ok, false)
}

test "parseLocaleJson decodes escapes" {
    let d = parseLocaleJson("{ \"k\": \"a\\nb\" }")
    assert(d.ok)
    assertEq(d.entries[0].value.byteLength, 3)
}

test "scanArgs finds a plain string arg" {
    let sc = scanArgs("Hello, {name}!")
    assert(sc.ok)
    assertEq(sc.names.length, 1)
    assertEq(sc.names[0], "name")
    assertEq(sc.kinds[0], "string")
}

test "scanArgs finds a plural arg" {
    let sc = scanArgs("{count, plural, one {# item} other {# items}}")
    assert(sc.ok)
    assertEq(sc.names.length, 1)
    assertEq(sc.kinds[0], "plural")
}

test "scanArgs finds a select arg with branch names" {
    let sc = scanArgs("{state, select, active {A} paused {P} other {O}}")
    assert(sc.ok)
    assertEq(sc.kinds[0], "select")
    assertEq(sc.branches[0], "active,other,paused")
}

test "argSignature is order-independent for drift" {
    let a = argSignature(scanArgs("{name}: {count, plural, one {#} other {#}}"))
    let b = argSignature(scanArgs("{count, plural, one {#} other {#}} for {name}"))
    assertEq(a, b)
}

test "plural categories cover the Slavic locales" {
    assertEq(pluralCategories("uk").length, 3)
    assertEq(pluralCategories("en").length, 1)
    assertEq(pluralCategories("ja").length, 0)
    assertEq(pluralSupported("xx"), false)
}

test "compileBody turns a plural into an if-chain" {
    let code = bodyText("{count, plural, one {# item} other {# items}}", "en")
    // Categories use |count|; `#` still prints the raw count.
    assert(code.contains("(if count < 0 { 0 - count } else { count }) == 1"))
    assert(code.contains("count.toString()"))
}

test "plural conditions take the absolute value, so negatives pick the CLDR branch" {
    // `%` truncates toward zero, so without |n| -3 and -5 would fall to
    // `other` in uk.
    let few = conditionText("uk", "few")
    assert(few.contains("(if count < 0 { 0 - count } else { count }) % 10 >= 2"))
    assert(few.contains("(if count < 0 { 0 - count } else { count }) % 100 < 12"))
    let many = conditionText("uk", "many")
    assert(many.contains("(if count < 0 { 0 - count } else { count }) % 10 >= 5"))
    assert(many.contains("(if count < 0 { 0 - count } else { count }) % 100 >= 11"))
}

test "an exact `=N` selector matches the count itself, not its absolute value" {
    // An explicit value compares the count as written: `=1` must not fire on
    // -1.
    let code = bodyText("{n, plural, =1 {one file} other {# files}}", "en")
    // `en` also emits its `one` category, so check that the explicit clause is
    // the plain comparison.
    assert(code.contains("if n == 1"))
    assert(code.contains("(if n < 0 { 0 - n } else { n }) == 1"))
}

test "a select selector containing a comma is refused at scan time" {
    // A comma in a selector would break the comma-joined branch set, so it is
    // refused.
    let sc = scanArgs("{state, select, on,off {X} other {Y}}")
    assert(sc.ok == false)
    assert(sc.error.contains("serialized comma-joined"))
}

test "keyFnName pascalizes dotted keys" {
    assertEq(keyFnName("cart.items"), "tCartItems")
    assertEq(keyFnName("home.title"), "tHomeTitle")
}

test "regexEscapeKey escapes a dot" {
    assertEq(regexEscapeKey("a.b"), "a\\.b")
}

test "an exact selector that is not an integer is refused at scan time" {
    let sc = scanArgs("{n, plural, =one {x} other {y}}")
    assert(sc.ok == false)
    assert(sc.error.contains("plural selector `=one` is not `=` and an integer"))
}

test "readLiteral keeps a lone apostrophe and does not swallow the placeholder" {
    // "It's " must survive with its apostrophe, and stop AT the `{`.
    let lit = readLiteral(bytes("It's {name}!"), 0, bytes("It's {name}!").length, false)
    assertEq(lit.text, "It's ")
    // The scanner stopped at the `{`, so the placeholder is still to come.
    assertEq(bytes("It's {name}!")[lit.next], 123)
}

test "readLiteral: paired '' is one apostrophe, '{' is a literal brace" {
    let a = readLiteral(bytes("b''c"), 0, bytes("b''c").length, false)
    assertEq(a.text, "b'c")
    let d = readLiteral(bytes("x '{' y"), 0, bytes("x '{' y").length, false)
    assertEq(d.text, "x { y")
}

test "scanArgs sees the arg through an apostrophe-bearing literal" {
    let sc = scanArgs("It's {name}!")
    assert(sc.ok)
    assertEq(sc.names.length, 1)
    assertEq(sc.names[0], "name")
}

test "icuBadBrace flags an unmatched or stray brace, quote-aware" {
    assert(icuBadBrace("50% off { sale"))
    assert(icuBadBrace("a } b"))
    assertEq(icuBadBrace("Hello, {name}!"), false)
    // A quoted brace is a literal, not a delimiter.
    assertEq(icuBadBrace("x '{' y"), false)
}

test "keyCollisionErrors names every collision class" {
    // Dotted vs nested flatten to the same `a.b`.
    let dup = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "a.b", value: "x" }, LocaleEntry { key: "a.b", value: "y" }] }
    assert(joinWith(keyCollisionErrors(dup), "\n").contains("key `a.b` is defined twice"))
    // home.title and homeTitle both make tHomeTitle.
    let clash = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "home.title", value: "A" }, LocaleEntry { key: "homeTitle", value: "B" }] }
    assert(
        joinWith(keyCollisionErrors(clash), "\n")
        .contains("keys `home.title` and `homeTitle` both name the function `tHomeTitle`"),
    )
    // The first key's unprefixed alias (`tCartItems`) is the second's
    // function.
    let cross = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "tCart.items", value: "A" }, LocaleEntry { key: "cart.items", value: "B" }] }
    assert(joinWith(keyCollisionErrors(cross), "\n").contains("collide through different doors"))
    // A key `Locale` derives the alias `locale`, the module's own export.
    let reserved = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "Locale", value: "A" }] }
    assert(
        joinWith(keyCollisionErrors(reserved), "\n")
        .contains("derives the name `locale`, which is the module's own export"),
    )
    // A clean key set collides with nothing.
    let ok = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "home.title", value: "A" }, LocaleEntry { key: "cart.items", value: "B" }] }
    assertEq(keyCollisionErrors(ok).length, 0)
}
