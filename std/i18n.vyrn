/// Typed translations as a generator library.
///
///   import { i18n } from "std/i18n"
///   import { t, setLocale, locale, Locale, TransKey, tCartItems } from i18n("./locales")
///
/// `i18n(dir)` reads every `<locale>.json` under `dir` at compile time, checks
/// that the locales agree, compiles each message to a Vyrn function body
/// and returns the module as `Code` (`vyrn emit-gen <file>` shows it). The
/// module holds `Locale` (one variant per file), `setLocale`/`locale`,
/// `TransKey` (the finite type of every dotted key), one function per key with
/// arguments taken from the message and the base-locale message as its doc,
/// `t(key)`, and `transKey(s)`, which checks a runtime `String` against the
/// key set.
///
/// `catalogue(dir)` reads the same files and writes only one exported function per
/// key and locale, `tCartItems__En`. It holds no `Locale` and no module state, so a
/// generator can call it at generation, naming its locale, and two catalogues link in
/// one program, where two `En` variants would clash.
///
/// A message is Unicode MessageFormat 2, read by `std/i18n.syntax`: text, where
/// a backslash escapes `\`, `{`, `|` and `}`; a placeholder `{$name}` (String);
/// `.input` and `.local` declarations; and one `.match` selector with a `*`
/// variant. `:number` makes an Int64, selected by an integer key, then by the
/// locale's plural category; `:string` selects a finite string type of its keys;
/// `:list` joins an `Array<String>` as the locale does. Markup, options,
/// attributes and other functions fail generation, as do numbers, booleans and
/// null in a locale file. An argument name may not start with `__`.

import { Json, JsonField } from "std/json"
import { parseJson } from "std/jsonread"
import { joinWith, split, substring, fromBytesOr } from "std/strings"
import { includes } from "std/arrays"
import { contains, endsWith, startsWith } from "std/strpred"
import { report, reportHere, Severity } from "std/diag"
import { arm, ifChainOr, join } from "std/code"
import { parseInt64 } from "std/num"
import { syntax } from "std/syntax"
// Each by a namespace: a written module's names, such as `Row`, are program-wide.
import * as mf from syntax("./i18n.syntax")

gen fn upperFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// The PascalCase type-name base of a dotted key: `cart.items` -> `CartItems`.
gen fn keyTypeBase(key: String) -> String {
    let segs = split(key, ".")
    let mut out = ""
    for seg in segs {
        out = out + upperFirst(seg)
    }
    return out
}

/// The per-key function name: `cart.items` -> `tCartItems`.
gen fn keyFnName(key: String) -> String {
    return "t" + keyTypeBase(key)
}

/// The per-key name without the `t` prefix, for namespace imports:
/// `cart.items` -> `cartItems`, so `t.cartItems()` reads naturally. Emitted
/// beside the prefixed name.
gen fn keyPlainName(key: String) -> String {
    return lowerFirst(keyTypeBase(key))
}

/// Lowercase the first ASCII byte of `s` (`AppTitle` -> `appTitle`).
gen fn lowerFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'A' && b <= 'Z' {
            out.push(b + 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// `key` with every regex metacharacter escaped, for a `value =~ "..."`
/// alternative: `home.title` -> `home\.title`.
gen fn regexEscapeKey(key: String) -> String {
    let ba = bytes(key)
    let mut out: Array<UInt8> = []
    for b in ba {
        if b == '.' || b == '\\' || b == '(' || b == ')' || b == '[' || b == ']'
        || b == '{' || b == '}' || b == '|' || b == '*' || b == '+' || b == '?'
        || b == '^' || b == '$' {
            out.push('\\')
            out.push(b)
        } else {
            out.push(b)
        }
    }
    return fromBytesOr(out, key)
}

// The locale reader: `std/jsonread` parses each `<locale>.json`, and this
// adapter flattens it to `home.title` -> value entries. Leaves must be strings;
// anything else fails with a reason.

type LocaleEntry = { key: String, value: String }

/// A flattened locale in source order, or `ok = false` with a reason. `slots`
/// maps each key to its first index in `entries`; a linear scan per lookup was
/// quadratic in the key count.
type LocaleData = {
    ok: Bool,
    error: String,
    entries: Array<LocaleEntry>,
    slots: Map<String, Int64>,
}

fn dataError(msg: String) -> LocaleData {
    return LocaleData { ok: false, error: msg.copy(), entries: [], slots: [:] }
}

/// The leaf-kind error for a value that is neither a string nor a nested object.
fn i18nUnsupported() -> String {
    return "unsupported value (only strings and nested objects are allowed)"
}

/// Appends one entry; returns `""`, the flatten walk's no-error value.
fn addEntry(entries: modify Array<LocaleEntry>, key: String, value: String) -> String {
    entries.push(LocaleEntry { key: key.copy(), value: value.copy() })
    return ""
}

/// Flatten an object's fields at `prefix`, dot-joining keys. Returns "" or
/// the first leaf error.
fn flattenObj(prefix: String, fields: Array<JsonField>, entries: modify Array<LocaleEntry>) -> String {
    for f in fields {
        let key = if prefix == "" { f.key.copy() } else { prefix + "." + f.key }
        let e = flattenValue(key, f.value, entries)
        if e != "" {
            return e
        }
    }
    return ""
}

/// Flatten one JSON value at `prefix` into `entries`; returns "" or an error.
/// Only strings and nested objects are allowed.
fn flattenValue(prefix: String, j: Json, entries: modify Array<LocaleEntry>) -> String {
    return match j {
        JObj(fields) => flattenObj(prefix, fields, entries),
        JStr(s) => addEntry(entries, prefix, s),
        JNull => i18nUnsupported(),
        JBool(b) => i18nUnsupported(),
        JNum(n) => i18nUnsupported(),
        JArr(a) => i18nUnsupported(),
    }
}

/// The top-level document must be a JSON object.
fn localeFromObj(fields: Array<JsonField>) -> LocaleData {
    let mut entries: Array<LocaleEntry> = []
    let e = flattenObj("", fields, entries)
    if e != "" {
        return dataError(e)
    }
    // First occurrence wins; the collision check reports duplicates.
    let mut slots: Map<String, Int64> = [:]
    let mut i = 0
    while i < entries.length {
        if let Some(_) = slots[entries[i].key] {} else {
            slots[entries[i].key.copy()] = i
        }
        i = i + 1
    }
    return LocaleData { ok: true, error: "", entries: entries, slots: slots }
}

fn localeFromJson(j: Json) -> LocaleData {
    return match j {
        JObj(fields) => localeFromObj(fields),
        JNull => dataError("expected a JSON object at the top level"),
        JBool(b) => dataError("expected a JSON object at the top level"),
        JNum(n) => dataError("expected a JSON object at the top level"),
        JStr(s) => dataError("expected a JSON object at the top level"),
        JArr(a) => dataError("expected a JSON object at the top level"),
    }
}

/// Parse one locale document into flattened entries.
fn parseLocaleJson(src: String) -> LocaleData {
    return match parseJson(src) {
        Ok(j) => localeFromJson(j),
        Err(e) => dataError(e),
    }
}

/// The flattened keys of a locale in source order.
gen fn localeKeys(d: LocaleData) -> Array<String> {
    let mut out: Array<String> = []
    for e in d.entries {
        out.push(e.key.copy())
    }
    return out
}

/// The index of `key` in locale `d`, or -1.
gen fn entryIndex(d: LocaleData, key: String) -> Int64 {
    if let Some(i) = d.slots[key] {
        return i
    }
    return 0 - 1
}

gen fn hasKey(d: LocaleData, key: String) -> Bool {
    if let Some(_) = d.slots[key] {
        return true
    }
    return false
}

// The message reader: `std/i18n.syntax` parses a message, and this walk checks what
// the grammar cannot and compiles it.

/// One argument of a message: its name, what it holds (`string`, `number`, `select`
/// or `list`), and the keys a `select` picks among, in source order.
type Arg = { name: String, kind: String, keys: Array<String> }

/// A name a declaration binds: the argument it reads and the function on it, or "".
type Decl = { name: String, arg: String, func: String }

/// The sentence of `row`, the one place a refusal of a message is said.
gen fn mfSay(row: mf.Row) -> String {
    return match row {
        ArgName(name) => "`$\{name}` is no parameter name: an argument is letters, digits and `_`, and does not start with `__`",
        Attribute => "an attribute (`@name`) is not supported",
        BadNumberKey(key) => "`\{key}` is no key of a `:number` selector: a key is an integer, `zero`, `one`, `two`, `few`, `many`, `other` or `*`",
        DuplicateDeclaration(name) => "`$\{name}` is declared twice, or declared after a declaration reads it",
        DuplicateVariant => "two variants have the same keys",
        Escape => "a backslash escapes only `\\`, `{`, `|` or `}`",
        ExpressionForm => "a placeholder holds a variable, `{$name}` or `{$name :function}`",
        ExpressionUnclosed => "a placeholder is not closed: `{` needs a matching `}`",
        FunctionAlone => "a function needs a variable before it: `{$name :function}`",
        FunctionOption => "a function option is not supported",
        KeyCount => "a variant needs one key per selector",
        KindClash(name) => "`$\{name}` is read by two different functions",
        LiteralAlone => "a literal placeholder is not supported; a literal brace is written `\\{`",
        ManySelectors => "`.match` takes one selector",
        MarkupPlaceholder => "markup (`{#name}`, `{/name}`) is not supported",
        MessageBody => "a complex message ends in a quoted pattern `{{...}}` or a `.match`",
        MessageBrace => "a `}` closes nothing; a literal brace is written `\\}`",
        MessageExpected(token) => "the message is expected to hold \{token} here",
        MessageTrailing => "text follows the end of a complex message",
        MissingAnnotation(name) => "the selector `$\{name}` needs a declaration with a function, as `.input {$\{name} :number}`",
        MissingFallback => "`.match` needs a variant whose keys are all `*`",
        QuotedLiteral => "a quoted literal is not closed: `|` needs a matching `|`",
        QuotedOpen => "a quoted pattern `{{...}}` is expected here",
        QuotedUnclosed => "a quoted pattern is not closed: `{{` needs a matching `}}`",
        Selector => "`.match` needs a selector, as `.match $count`",
        SelectorFunction(name) => "`:\{name}` does not select; a selector uses `:number` or `:string`",
        UnknownFunction(name) => "`:\{name}` is not a function std/i18n knows: it knows `:number`, `:string` and `:list`",
    }
}

/// `line L, column C: ` of the byte `at` of `msg`.
gen fn mfAt(msg: String, at: Int64) -> String {
    let mut line = 1
    let mut col = 1
    let mut i = 0
    while i < at && i < msg.byteLength {
        if msg[i] == '\n' {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return "line \{line}, column \{col}: "
}

/// The text of a text part or a quoted literal: each backslash gives the byte after it.
gen fn mfUnescape(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < ba.length {
        if ba[i] == '\\' && i + 1 < ba.length {
            i = i + 1
        }
        out.push(ba[i])
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// The value of a variant key: `*`, a quoted literal's text, or the name as written.
gen fn mfKey(k: mf.I18nKey) -> String {
    return match k {
        I18nKeyI18nStar(s) => "*",
        I18nKeyI18nLiteral(l) => mfUnescape(substring(l.text, 1, l.text.byteLength - 1)),
        I18nKeyI18nUnquoted(u) => u.text.copy(),
    }
}

/// The kind of argument a function makes, or "" when std/i18n knows no such function.
gen fn mfKind(func: String) -> String {
    if func == "number" || func == "string" || func == "list" {
        return func.copy()
    }
    return ""
}

/// The index of the declaration binding `name`, or -1.
gen fn declIndex(decls: Array<Decl>, name: String) -> Int64 {
    let mut i = 0
    while i < decls.length {
        if decls[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

/// The index of argument `name`, or -1.
gen fn argIndex(args: Array<Arg>, name: String) -> Int64 {
    let mut i = 0
    while i < args.length {
        if args[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

/// The argument and the function a variable reads, through the declarations.
gen fn mfResolve(decls: Array<Decl>, name: String, func: String) -> Decl {
    let d = declIndex(decls, name)
    if d < 0 {
        return Decl { name: name.copy(), arg: name.copy(), func: func.copy() }
    }
    let f = if func == "" { decls[d].func.copy() } else { func.copy() }
    return Decl { name: name.copy(), arg: decls[d].arg.copy(), func: f }
}

/// Whether `name` is an argument std/i18n can make a parameter of.
gen fn argNameOk(name: String) -> Bool {
    let ba = bytes(name)
    if ba.length == 0 || (ba[0] >= '0' && ba[0] <= '9') || startsWith(name, "__") {
        return false
    }
    for b in ba {
        if !(b == '_' || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9')) {
            return false
        }
    }
    return true
}

/// Records that `use` reads its argument under its function, or why it cannot. An
/// argument's kind is "" until a function claims it; a `select` is a `string`.
gen fn mfUse(args: modify Array<Arg>, use: Decl) -> Option<mf.Row> {
    let kind = mfKind(use.func)
    if use.func != "" && kind == "" {
        return Some(UnknownFunction(use.func.copy()))
    }
    if !argNameOk(use.arg) {
        return Some(ArgName(use.arg.copy()))
    }
    let i = argIndex(args, use.arg)
    if i < 0 {
        args.push(Arg { name: use.arg.copy(), kind: kind, keys: [] })
        return None
    }
    let held = args[i].kind.copy()
    if kind == "" || kind == held || (kind == "string" && held == "select") {
        return None
    }
    if held != "" {
        return Some(KindClash(use.arg.copy()))
    }
    args[i].kind = kind
    return None
}

/// A refusal of a message and the byte it points at.
type Miss = { row: mf.Row, at: Int64 }

/// The function an expression names, or "".
gen fn mfFunc(e: mf.I18nExpression) -> String {
    return match e.func {
        Some(f) => f.name.text.copy(),
        None => "",
    }
}

/// Records the arguments the placeholders of `p` read.
gen fn mfPatternUses(p: mf.I18nPattern, decls: Array<Decl>, args: modify Array<Arg>) -> Option<Miss> {
    for part in p.parts {
        match part {
            I18nPartI18nExpression(e) => {
                if let Some(row) = mfUse(args, mfResolve(decls, e.var.name.text, mfFunc(e))) {
                    return Some(Miss { row: row, at: e.start })
                }
            }
            I18nPartI18nText(t) => {}
        }
    }
    return None
}

/// Records what one declaration binds, or why it cannot. An `.input` reads the name
/// it binds; a `.local` binds a new name.
gen fn mfDeclare(
    name: String,
    e: mf.I18nExpression,
    at: Int64,
    input: Bool,
    decls: modify Array<Decl>,
    read: modify Array<String>,
    args: modify Array<Arg>,
) -> Option<Miss> {
    let src = e.var.name.text
    if declIndex(decls, name) >= 0 || includes(read, name) || (name == src && !input) {
        return Some(Miss { row: DuplicateDeclaration(name.copy()), at: at })
    }
    let use = mfResolve(decls, src, mfFunc(e))
    if let Some(row) = mfUse(args, use) {
        return Some(Miss { row: row, at: e.start })
    }
    read.push(src.copy())
    decls.push(Decl { name: name.copy(), arg: use.arg.copy(), func: use.func.copy() })
    return None
}

/// Whether `k` can be a key of a `:number` selector.
gen fn mfNumberKey(k: String) -> Bool {
    if k == "*" || k == "zero" || k == "one" || k == "two" || k == "few" || k == "many" || k == "other" {
        return true
    }
    return match parseInt64(k) {
        Some(n) => true,
        None => false,
    }
}

/// Checks the selector and the variants of `m`, and records what they read.
gen fn mfMatcher(m: mf.I18nMatcher, decls: Array<Decl>, args: modify Array<Arg>) -> Option<Miss> {
    if m.sels.length != 1 {
        return Some(Miss { row: ManySelectors, at: m.start })
    }
    let s = m.sels[0].name.text
    let d = declIndex(decls, s)
    if d < 0 {
        return Some(Miss { row: MissingAnnotation(s.copy()), at: m.sels[0].start })
    }
    if decls[d].func == "" {
        return Some(Miss { row: MissingAnnotation(s.copy()), at: m.sels[0].start })
    }
    let func = decls[d].func.copy()
    if func == "list" {
        return Some(Miss { row: SelectorFunction(func), at: m.sels[0].start })
    }
    let mut keys: Array<String> = []
    for v in m.variants {
        if v.keys.length != 1 {
            return Some(Miss { row: KeyCount, at: v.start })
        }
        let k = mfKey(v.keys[0])
        if func == "number" && !mfNumberKey(k) {
            return Some(Miss { row: BadNumberKey(k), at: v.start })
        }
        if includes(keys, k) {
            return Some(Miss { row: DuplicateVariant, at: v.start })
        }
        if let Some(miss) = mfPatternUses(v.pattern.pattern, decls, args) {
            return Some(miss)
        }
        keys.push(k)
    }
    if !includes(keys, "*") {
        return Some(Miss { row: MissingFallback, at: m.start })
    }
    if func == "string" {
        let mut picked: Array<String> = []
        for k in keys {
            if k != "*" {
                picked.push(k.copy())
            }
        }
        let i = argIndex(args, decls[d].arg)
        args[i].kind = "select"
        args[i].keys = picked
    }
    return None
}

/// What a message reads: its arguments, or the first refusal. `decls` receives the
/// names its declarations bind.
gen fn mfArgs(tree: mf.I18nMessage, decls: modify Array<Decl>) -> Result<Array<Arg>, Miss> {
    let mut args: Array<Arg> = []
    let mut read: Array<String> = []
    if let Some(p) = tree.simple {
        if let Some(miss) = mfPatternUses(p, decls, args) {
            return Err(miss)
        }
    }
    if let Some(c) = tree.complex {
        for d in c.decls {
            let miss = match d {
                I18nDeclarationI18nInput(i) => mfDeclare(i.expr.var.name.text, i.expr, i.start, true, decls, read, args),
                I18nDeclarationI18nLocal(l) => mfDeclare(l.var.name.text, l.expr, l.start, false, decls, read, args),
            }
            if let Some(m) = miss {
                return Err(m)
            }
        }
        if let Some(q) = c.body {
            if let Some(miss) = mfPatternUses(q.pattern, decls, args) {
                return Err(miss)
            }
        }
        if let Some(m) = c.matcher {
            if let Some(miss) = mfMatcher(m, decls, args) {
                return Err(miss)
            }
        }
    }
    let mut i = 0
    while i < args.length {
        if args[i].kind == "" {
            args[i].kind = "string"
        }
        i = i + 1
    }
    return Ok(args)
}

/// A message read and checked: its arguments, the names its declarations bind, its
/// tree, its text when it reads no argument, and whether it selects on a `:number`.
type Message = { args: Array<Arg>, decls: Array<Decl>, tree: mf.I18nMessage, text: String, plural: Bool }

/// Reads the message `msg`, or says where and why std/i18n cannot.
gen fn readMessage(msg: String) -> Result<Message, String> {
    return match mf.parseI18nMessage(msg) {
        Ok(tree) => checkMessage(msg, tree),
        Err(errors) => Err("line \{errors[0].line}, column \{errors[0].col}: " + mfSay(errors[0].row)),
    }
}

gen fn checkMessage(msg: String, tree: consume mf.I18nMessage) -> Result<Message, String> {
    let mut decls: Array<Decl> = []
    return match mfArgs(tree, decls) {
        Ok(args) => Ok(checked(tree, decls, args)),
        Err(miss) => Err(mfAt(msg, miss.at) + mfSay(miss.row)),
    }
}

gen fn checked(tree: consume mf.I18nMessage, decls: consume Array<Decl>, args: consume Array<Arg>) -> Message {
    let mut text = ""
    let mut plural = false
    if let Some(p) = tree.simple {
        text = mfText(p)
    }
    if let Some(c) = tree.complex {
        if let Some(q) = c.body {
            text = mfText(q.pattern)
        }
        if let Some(m) = c.matcher {
            plural = decls[declIndex(decls, m.sels[0].name.text)].func == "number"
        }
    }
    return Message { args: args, decls: decls, tree: tree, text: text, plural: plural }
}

/// The statements appending message `m` to `__acc` in locale `tag`.
gen fn mfBody(m: Message, tag: String) -> Code {
    let mut n = 0
    if let Some(p) = m.tree.simple {
        return mfPattern(p, m.decls, m.args, tag, n)
    }
    if let Some(c) = m.tree.complex {
        if let Some(q) = c.body {
            return mfPattern(q.pattern, m.decls, m.args, tag, n)
        }
        if let Some(x) = c.matcher {
            return mfMatch(x, m.decls, m.args, tag, n)
        }
    }
    return vyrn""
}

/// The text of a pattern with no placeholder.
gen fn mfText(p: mf.I18nPattern) -> String {
    let mut out = ""
    for part in p.parts {
        match part {
            I18nPartI18nText(t) => {
                out = out + mfUnescape(t.text)
            }
            I18nPartI18nExpression(e) => {}
        }
    }
    return out
}

/// The statements appending `p` to `__acc`. `n` numbers the loops a `:list` writes.
gen fn mfPattern(p: mf.I18nPattern, decls: Array<Decl>, args: Array<Arg>, tag: String, n: modify Int64) -> Code {
    let mut stmts: Array<Code> = []
    for part in p.parts {
        match part {
            I18nPartI18nText(t) => {
                stmts.push(vyrn"__acc = __acc + \{mfUnescape(t.text)}")
            }
            I18nPartI18nExpression(e) => {
                let a = args[argIndex(args, mfResolve(decls, e.var.name.text, "").arg)]
                let v = name(a.name)
                if a.kind == "number" {
                    stmts.push(vyrn"__acc = __acc + \{v}.toString()")
                } else if a.kind == "list" {
                    n = n + 1
                    stmts.push(mfList(v, tag, n))
                } else {
                    stmts.push(vyrn"__acc = __acc + \{v}")
                }
            }
        }
    }
    return join(stmts, vyrn"\n")
}

/// The CLDR conjunction of a list in locale `tag`: between two items, between the
/// earlier items of a longer list, and before its last item. Empty when the table has
/// no such locale.
gen fn listSeparators(tag: String) -> Array<String> {
    if tag == "en" {
        return [" and ", ", ", ", and "]
    }
    if tag == "uk" {
        return [" \u{456} ", ", ", " \u{456} "]
    }
    return []
}

/// The statements appending the items of list `v` to `__acc`, joined as locale `tag`
/// joins a list.
gen fn mfList(v: Name, tag: String, n: Int64) -> Code {
    let seps = listSeparators(tag)
    let i = name("__i\{n}")
    return vyrn"""
        let mut \{i} = 0
        while \{i} < \{v}.length {
            if \{i} > 0 {
                if \{i} < \{v}.length - 1 {
                    __acc = __acc + \{seps[1]}
                } else if \{v}.length == 2 {
                    __acc = __acc + \{seps[0]}
                } else {
                    __acc = __acc + \{seps[2]}
                }
            }
            __acc = __acc + \{v}[\{i}]
            \{i} = \{i} + 1
        }
        """
}

/// The index of `k` in `keys`, or -1.
gen fn keyIndex(keys: Array<String>, k: String) -> Int64 {
    let mut i = 0
    while i < keys.length {
        if keys[i] == k {
            return i
        }
        i = i + 1
    }
    return -1
}

/// A `.match` as an `if` chain. A `:number` selector tries its integer keys first,
/// comparing the count as written, then the locale's plural categories over its
/// absolute value, then `*`: a category with no variant falls to `*`, not `other`.
/// A `:string` selector compares its keys.
gen fn mfMatch(m: mf.I18nMatcher, decls: Array<Decl>, args: Array<Arg>, tag: String, n: modify Int64) -> Code {
    let d = decls[declIndex(decls, m.sels[0].name.text)]
    let v = name(d.arg)
    let mut keys: Array<String> = []
    let mut bodies: Array<Code> = []
    for variant in m.variants {
        keys.push(mfKey(variant.keys[0]))
        bodies.push(mfPattern(variant.pattern.pattern, decls, args, tag, n))
    }
    let star = keyIndex(keys, "*")
    let other = keyIndex(keys, "other")
    let mut arms: Array<Code> = []
    let mut i = 0
    if d.func == "string" {
        while i < keys.length {
            if keys[i] != "*" {
                arms.push(arm(vyrn"\{v} == \{keys[i]}", bodies[i]))
            }
            i = i + 1
        }
        return ifChainOr(arms, bodies[star])
    }
    while i < keys.length {
        if let Some(exact) = parseInt64(keys[i]) {
            arms.push(arm(vyrn"\{v} == \{exact}", bodies[i]))
        }
        i = i + 1
    }
    for cat in pluralCategories(tag) {
        let k = keyIndex(keys, cat)
        if k >= 0 {
            arms.push(arm(pluralCondition(tag, cat, v), bodies[k]))
        } else if other >= 0 {
            arms.push(arm(pluralCondition(tag, cat, v), bodies[star]))
        }
    }
    return ifChainOr(arms, if other >= 0 { bodies[other] } else { bodies[star] })
}

/// `items` in ascending order.
gen fn sorted(items: Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    for s in items {
        out.push(s.copy())
    }
    let mut a = 1
    while a < out.length {
        let mut b = a
        while b > 0 && out[b - 1] > out[b] {
            let tmp = out[b - 1].copy()
            out[b - 1] = out[b].copy()
            out[b] = tmp
            b = b - 1
        }
        a = a + 1
    }
    return out
}

/// An order-independent signature of an argument set, for drift equality.
gen fn argSignature(args: Array<Arg>) -> String {
    let mut items: Array<String> = []
    for a in args {
        items.push(a.name + ":" + a.kind + ":" + joinWith(sorted(a.keys), ","))
    }
    return joinWith(sorted(items), ";")
}

// CLDR cardinal plural rules for the covered locales, compiled into the
// emitted `if` chain. Any other locale is a generation error.

/// The ordered non-`other` categories of a locale (empty: only `other`).
gen fn pluralCategories(tag: String) -> Array<String> {
    if tag == "en" || tag == "de" || tag == "es" || tag == "it" || tag == "fr" || tag == "pt" {
        return ["one"]
    }
    if tag == "uk" || tag == "ru" || tag == "pl" {
        return ["one", "few", "many"]
    }
    if tag == "ja" || tag == "zh" || tag == "ko" {
        return []
    }
    return ["__unsupported__"]
}

gen fn pluralSupported(tag: String) -> Bool {
    let cats = pluralCategories(tag)
    if cats.length == 1 {
        if cats[0] == "__unsupported__" {
            return false
        }
    }
    return true
}

/// `|v|` as an inline expression. CLDR plural operands are absolute and Vyrn's
/// `%` truncates toward zero (`-5 % 10 == -5`); an expression, not a local, so
/// two plurals in one message cannot collide.
gen fn pluralAbs(v: Name) -> Code {
    return vyrn"(if \{v} < 0 { 0 - \{v} } else { \{v} })"
}

/// The Vyrn condition selecting category `cat` for `tag` over `pluralAbs(v)`.
/// Without the absolute value -3 misses `few` and -5 misses `many` in the
/// Slavic locales. `#` still prints the raw count.
gen fn pluralCondition(tag: String, cat: String, v: Name) -> Code {
    let a = pluralAbs(v)
    if tag == "en" || tag == "de" || tag == "es" || tag == "it" {
        return vyrn"\{a} == 1"
    }
    if tag == "fr" || tag == "pt" {
        return vyrn"\{a} == 0 || \{a} == 1"
    }
    if tag == "uk" || tag == "ru" {
        if cat == "one" {
            return vyrn"\{a} % 10 == 1 && \{a} % 100 != 11"
        }
        if cat == "few" {
            return vyrn"\{a} % 10 >= 2 && \{a} % 10 <= 4 && (\{a} % 100 < 12 || \{a} % 100 > 14)"
        }
        return vyrn"\{a} % 10 == 0 || (\{a} % 10 >= 5 && \{a} % 10 <= 9) || (\{a} % 100 >= 11 && \{a} % 100 <= 14)"
    }
    // pl
    if cat == "one" {
        return vyrn"\{a} == 1"
    }
    if cat == "few" {
        return vyrn"\{a} % 10 >= 2 && \{a} % 10 <= 4 && (\{a} % 100 < 12 || \{a} % 100 > 14)"
    }
    return vyrn"\{a} != 1 && ((\{a} % 10 >= 0 && \{a} % 10 <= 1) || (\{a} % 10 >= 5 && \{a} % 10 <= 9) || (\{a} % 100 >= 12 && \{a} % 100 <= 14))"
}

// Drift errors: one `std/diag` report per issue, anchored in the locale file.

/// A report anchored at line 1, column 1 of a locale file: a flattened entry
/// keeps no offset into its JSON.
gen fn localeErr(dir: String, tag: String, message: String) -> Code {
    return report(Error, dir + "/" + tag + ".json", 1, 1, message)
}

/// Key-collision messages for the base locale, each naming the colliding keys
/// instead of a "function defined twice":
///   - a dotted key (`"a.b"`) and a nested object (`"a": {"b": ...}`) flatten
///     to the same `a.b`;
///   - two keys share a PascalCase name (`home.title` and `homeTitle` both make
///     `tHomeTitle`);
///   - one key's unprefixed alias is another's function name (`tCart.items`
///     aliases to `tCartItems`, the function of `cart.items`);
///   - a key's names land on the module's own exports (`Locale` emits the
///     alias `locale`).
gen fn keyCollisionErrors(base: LocaleData) -> Array<String> {
    let keys = localeKeys(base)
    let reserved: Array<String> = ["locale", "setLocale", "t", "transKey"]
    // Derive each key's names once and ask three maps whether any pair
    // collides; re-deriving per pair exhausted the generator's step budget at
    // 400 keys. Only on a hit does the pair loop run, to word the messages.
    let mut anyPair = false
    let mut seenKeys: Map<String, Bool> = [:]
    let mut fnNames: Map<String, Bool> = [:]
    let mut plainNames: Map<String, Bool> = [:]
    for k in keys {
        if let Some(_) = seenKeys[k] {
            anyPair = true
        }
        seenKeys[k.copy()] = true
        let f = keyFnName(k)
        let p = keyPlainName(k)
        if let Some(_) = fnNames[f] {
            anyPair = true
        }
        if let Some(_) = plainNames[f] {
            anyPair = true
        }
        if let Some(_) = fnNames[p] {
            anyPair = true
        }
        fnNames[f] = true
        plainNames[p] = true
    }
    let mut out: Array<String> = []
    if anyPair {
        let mut i = 0
        while i < keys.length {
            let mut j = i + 1
            while j < keys.length {
                if keys[i] == keys[j] {
                    out.push("key `\{keys[i]}` is defined twice — a dotted key and a nested object flatten to one key, so keep only one of them")
                } else if keyFnName(keys[i]) == keyFnName(keys[j]) {
                    out.push("keys `\{keys[i]}` and `\{keys[j]}` both name the function `\{keyFnName(keys[i])}` — a key and a Vyrn identifier are different alphabets, and these two keys convert to one name; rename one key")
                } else if keyPlainName(keys[i]) == keyFnName(keys[j]) || keyFnName(keys[i]) == keyPlainName(keys[j]) {
                    let shared = if keyPlainName(keys[i]) == keyFnName(keys[j]) {
                        keyFnName(keys[j])
                    } else {
                        keyFnName(keys[i])
                    }
                    out.push("keys `\{keys[i]}` and `\{keys[j]}` collide through different doors — one key's un-prefixed alias is the other's function `\{shared}`; rename one key")
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    // A key whose derived names land on the module's own exports.
    for k in keys {
        for r in reserved {
            if keyPlainName(k) == r || keyFnName(k) == r {
                out.push("key `\{k}` derives the name `\{r}`, which is the module's own export — rename the key")
            }
        }
    }
    return out
}

/// Read every `<locale>.json` under `dir`, check the locales, and return the
/// translation module.
export gen fn i18n(dir: String) -> Code {
    return checkedLocales(dir, false)
}

/// Read every `<locale>.json` under `dir`, check the locales, and return one exported
/// function per key and locale, each of which reads no module state.
export gen fn catalogue(dir: String) -> Code {
    return checkedLocales(dir, true)
}

/// The module of the locales under `dir`, or why they do not agree: the functions
/// alone for a `catalogue`.
gen fn checkedLocales(dir: String, functionsOnly: Bool) -> Code {
    let files = match listDir(dir) {
        Ok(ns) => ns,
        Err(err) => [],
    }
    let mut tags: Array<String> = []
    let mut datas: Array<LocaleData> = []
    for name in files {
        if name.endsWith(".json") {
            let tag = substring(name, 0, name.byteLength - 5)
            let src = match readFile(dir + "/" + name) {
                Ok(v) => v,
                Err(err) => "",
            }
            let data = parseLocaleJson(src)
            if data.ok == false {
                return localeErr(
                    dir,
                    tag,
                    "locale `\{tag}` is not a usable locale file — \{data.error}",
                )
            }
            tags.push(tag)
            datas.push(data)
        }
    }
    if tags.length == 0 {
        return reportHere(
            Error,
            "no locale files under `\{dir}` — i18n reads one `<locale>.json` per locale, so add at least one",
        )
    }

    // Two keys that produce one function name fail with a report naming both.
    let mut errs: Array<Code> = []
    for m in keyCollisionErrors(datas[0]) {
        errs.push(localeErr(dir, tags[0], m))
    }
    if errs.length > 0 {
        return join(errs, vyrn"")
    }

    // Each message of each locale is read once. A list or a `:number` selector needs
    // the locale in its table.
    let mut msgs: Array<Array<Message>> = []
    let mut li = 0
    while li < tags.length {
        let tag = tags[li]
        let mut read: Array<Message> = []
        for e in datas[li].entries {
            match readMessage(e.value) {
                Ok(m) => {
                    if m.plural && pluralSupported(tag) == false {
                        errs.push(localeErr(
                            dir,
                            tag,
                            "key `\{e.key}` selects on a `:number`, and locale `\{tag}` has no plural rule in this generator's table: select without `:number`, or drop the locale",
                        ))
                    }
                    if listed(m.args) && listSeparators(tag).length == 0 {
                        errs.push(localeErr(
                            dir,
                            tag,
                            "key `\{e.key}` formats a `:list`, and locale `\{tag}` has no list pattern in this generator's table: write the items out, or drop the locale",
                        ))
                    }
                    read.push(m)
                }
                Err(why) => {
                    errs.push(localeErr(dir, tag, "key `\{e.key}` is not a message std/i18n reads: \{why}"))
                }
            }
        }
        msgs.push(read)
        li = li + 1
    }
    if errs.length > 0 {
        return join(errs, vyrn"")
    }

    // Every locale must have the base key set and the same argument signature
    // per key. The base is the first locale alphabetically; it supplies docs,
    // signatures and types.
    let base = datas[0]
    let baseTag = tags[0]
    li = 0
    while li < tags.length {
        let d = datas[li]
        let tag = tags[li]
        let mut ki = 0
        while ki < base.entries.length {
            if hasKey(d, base.entries[ki].key) == false {
                errs.push(localeErr(
                    dir,
                    tag,
                    "locale `\{tag}` is missing key `\{base.entries[ki].key}`, which `\{baseTag}` defines — every locale carries the same key set, so add it or drop it from `\{baseTag}`",
                ))
            }
            ki = ki + 1
        }
        ki = 0
        while ki < d.entries.length {
            if hasKey(base, d.entries[ki].key) == false {
                errs.push(localeErr(
                    dir,
                    tag,
                    "locale `\{tag}` defines key `\{d.entries[ki].key}`, which `\{baseTag}` does not — every locale carries the same key set, so add it to `\{baseTag}` or drop it here",
                ))
            }
            ki = ki + 1
        }
        li = li + 1
    }
    let mut ki = 0
    while ki < base.entries.length {
        let key = base.entries[ki].key
        let baseSig = argSignature(msgs[0][ki].args)
        let mut lj = 1
        while lj < tags.length {
            let vi = entryIndex(datas[lj], key)
            if vi >= 0 {
                let sig = argSignature(msgs[lj][vi].args)
                if sig != baseSig {
                    errs.push(localeErr(
                        dir,
                        tags[lj],
                        "key `\{key}` takes `\{sig}` here and `\{baseSig}` in `\{baseTag}` — one key has one signature across every locale",
                    ))
                }
            }
            lj = lj + 1
        }
        ki = ki + 1
    }
    if errs.length > 0 {
        return join(errs, vyrn"")
    }
    return if functionsOnly { buildCatalogue(tags, datas, msgs) } else { buildModule(tags, datas, msgs) }
}

/// Whether a message formats a `:list`.
gen fn listed(args: Array<Arg>) -> Bool {
    for a in args {
        if a.kind == "list" {
            return true
        }
    }
    return false
}

/// What a `catalogue` writes.
gen fn buildCatalogue(tags: Array<String>, datas: Array<LocaleData>, msgs: Array<Array<Message>>) -> Code {
    let mut decls: Array<Code> = [buildSelectTypes(datas[0], msgs[0])]
    let mut ki = 0
    while ki < datas[0].entries.length {
        let key = datas[0].entries[ki].key
        let mut li = 0
        while li < tags.length {
            let m = msgs[li][entryIndex(datas[li], key)]
            decls.push(vyrn"export " + buildLocaleFn(key, tags[li], m, msgs[0][ki].args))
            li = li + 1
        }
        ki = ki + 1
    }
    return join(decls, vyrn"\n") + vyrn"\n"
}

/// The whole generated module.
gen fn buildModule(tags: Array<String>, datas: Array<LocaleData>, msgs: Array<Array<Message>>) -> Code {
    let base = datas[0]
    let mut locales: Array<Code> = []
    for tag in tags {
        locales.push(vyrn"\{name(upperFirst(tag))}")
    }
    let variants = join(locales, vyrn", ")
    let first = name(upperFirst(tags[0]))
    let mut keys: Array<String> = []
    for e in base.entries {
        keys.push(regexEscapeKey(e.key))
    }
    let keySet = "(" + joinWith(keys, "|") + ")"
    let mut decls: Array<Code> = []
    decls.push(vyrn"""
        export type Locale = enum { \{variants} }
        let mut currentLocale: Locale = \{first}
        export fn setLocale(l: Locale) { currentLocale = l }
        export fn locale() -> Locale { return currentLocale }
        export type TransKey = String where value =~ \{keySet}
        """)
    decls.push(buildSelectTypes(base, msgs[0]))
    let mut ki = 0
    while ki < base.entries.length {
        decls.push(buildKeyFns(ki, tags, datas, msgs))
        ki = ki + 1
    }
    decls.push(buildT(tags, datas, msgs))
    decls.push(buildTransKey(base))
    return join(decls, vyrn"\n") + vyrn"\n"
}

/// One finite string type per `select` argument of a key in `base`: its keys but `*`.
gen fn buildSelectTypes(base: LocaleData, read: Array<Message>) -> Code {
    let mut decls: Array<Code> = []
    let mut ki = 0
    while ki < base.entries.length {
        for a in read[ki].args {
            if a.kind == "select" {
                let mut sels: Array<String> = []
                for k in sorted(a.keys) {
                    sels.push(regexEscapeKey(k))
                }
                let selSet = "(" + joinWith(sels, "|") + ")"
                decls.push(vyrn"export type \{selectType(base.entries[ki].key, a.name)} = String where value =~ \{selSet}")
            }
        }
        ki = ki + 1
    }
    return join(decls, vyrn"\n")
}

/// Emits `transKey(s)`: `Some(s)` when `s` is a key, else `None`, as an if
/// chain over the finite key set.
gen fn buildTransKey(base: LocaleData) -> Code {
    let mut tests: Array<Code> = []
    for e in base.entries {
        tests.push(vyrn"""
            if s == \{e.key} {
                return Some(\{e.key})
            }
            """)
    }
    let body = join(tests, vyrn"\n")
    return vyrn"""
        export fn transKey(s: String) -> Option<TransKey> {
            \{body}
            return None
        }
        """
}

/// The type of select argument `arg` of `key`: `TStatusState`.
gen fn selectType(key: String, arg: String) -> Name {
    return name("T" + keyTypeBase(key) + upperFirst(arg))
}

/// The parameters `count: Int64, name: String` of a key's arguments.
gen fn paramList(key: String, args: Array<Arg>) -> Code {
    let mut params: Array<Code> = []
    for a in args {
        params.push(vyrn"\{name(a.name)}: \{argType(key, a)}")
    }
    return join(params, vyrn", ")
}

/// The arguments `count, name` that forward a key's parameters.
gen fn argList(args: Array<Arg>) -> Code {
    let mut out: Array<Code> = []
    for a in args {
        out.push(vyrn"\{name(a.name)}")
    }
    return join(out, vyrn", ")
}

gen fn argType(key: String, a: Arg) -> Code {
    if a.kind == "number" {
        return vyrn"Int64"
    }
    if a.kind == "select" {
        return vyrn"\{selectType(key, a.name)}"
    }
    if a.kind == "list" {
        return vyrn"Array<String>"
    }
    return vyrn"String"
}

/// The functions of the key at `ki` of the base locale: a private helper per locale
/// and the exported dispatcher over `currentLocale`, documented with the base message.
gen fn buildKeyFns(ki: Int64, tags: Array<String>, datas: Array<LocaleData>, msgs: Array<Array<Message>>) -> Code {
    let key = datas[0].entries[ki].key
    let args = msgs[0][ki].args
    let f = name(keyFnName(key))
    let plain = name(keyPlainName(key))
    let params = paramList(key, args)
    let forward = argList(args)
    let doc = docComment(datas[0].entries[ki].value)
    let mut helpers: Array<Code> = []
    let mut arms: Array<Code> = []
    let mut li = 0
    while li < tags.length {
        let helper = name(keyFnName(key) + "__" + upperFirst(tags[li]))
        helpers.push(buildLocaleFn(key, tags[li], msgs[li][entryIndex(datas[li], key)], args))
        arms.push(vyrn"\{name(upperFirst(tags[li]))} => \{helper}(\{forward})")
        li = li + 1
    }
    let fns = join(helpers, vyrn"\n")
    let dispatch = join(arms, vyrn", ")
    // The unprefixed alias delegates to the dispatcher, so both share one body.
    return vyrn"""
        \{fns}
        /// \{doc}
        export fn \{f}(\{params}) -> String {
            return match currentLocale { \{dispatch} }
        }
        /// \{doc}
        export fn \{plain}(\{params}) -> String {
            return \{f}(\{forward})
        }
        """
}

/// The function of `key` in the locale `tag`: the message `m`, under the base
/// locale's arguments `args`.
gen fn buildLocaleFn(key: String, tag: String, m: Message, args: Array<Arg>) -> Code {
    let helper = name(keyFnName(key) + "__" + upperFirst(tag))
    let params = paramList(key, args)
    return vyrn"""
        fn \{helper}(\{params}) -> String {
            let mut __acc = ""
            \{mfBody(m, tag)}
            return __acc
        }
        """
}

/// A one-line doc rendering of a message (newlines collapsed to spaces).
gen fn docComment(msg: String) -> String {
    let ba = bytes(msg)
    let mut out: Array<UInt8> = []
    for b in ba {
        if b == '\n' || b == '\r' {
            out.push(' ')
        } else {
            out.push(b)
        }
    }
    return fromBytesOr(out, msg)
}

/// Emits `t(key)`: the current locale's text of an argument-less key, and the
/// raw pattern of a key that takes arguments.
gen fn buildT(tags: Array<String>, datas: Array<LocaleData>, msgs: Array<Array<Message>>) -> Code {
    let base = datas[0]
    let mut tests: Array<Code> = []
    let mut ki = 0
    while ki < base.entries.length {
        let e = base.entries[ki]
        if msgs[0][ki].args.length == 0 {
            let mut arms: Array<Code> = []
            let mut li = 0
            while li < tags.length {
                let text = msgs[li][entryIndex(datas[li], e.key)].text
                arms.push(vyrn"\{name(upperFirst(tags[li]))} => \{text}")
                li = li + 1
            }
            let texts = join(arms, vyrn", ")
            tests.push(vyrn"""
                if key == \{e.key} {
                    return match currentLocale { \{texts} }
                }
                """)
        } else {
            tests.push(vyrn"""
                if key == \{e.key} {
                    return \{e.value}
                }
                """)
        }
        ki = ki + 1
    }
    let body = join(tests, vyrn"\n")
    return vyrn"""
        export fn t(key: TransKey) -> String {
            \{body}
            return key.copy()
        }
        """
}

// The tests feed the pure helpers source strings; no file I/O.

/// The statements `readMessage` writes for `msg`, or its refusal, which a test can read.
gen fn bodyText(msg: String, tag: String) -> String {
    return match readMessage(msg) {
        Ok(m) => render(mfBody(m, tag)),
        Err(why) => why,
    }
}

/// The arguments of `msg` as `name:kind:keys`, or its refusal.
gen fn argsText(msg: String) -> String {
    return match readMessage(msg) {
        Ok(m) => argSignature(m.args),
        Err(why) => why,
    }
}

test "readMessage finds a plain string arg" {
    assertEq(argsText("Hello, {$name}!"), "name:string:")
}

test "readMessage finds a number selector" {
    assertEq(argsText(".input {$count :number}\n.match $count\none {{{$count} item}}\n* {{{$count} items}}"), "count:number:")
}

test "readMessage finds a string selector with its keys" {
    assertEq(argsText(".input {$state :string}\n.match $state\nactive {{A}}\npaused {{P}}\n* {{O}}"), "state:select:active,paused")
}

test "argSignature is order-independent for drift" {
    let a = argsText(".input {$count :number}\n.match $count\none {{{$name}: {$count}}}\n* {{{$name}: {$count}}}")
    let b = argsText(".input {$name :string}\n.input {$count :number}\n.match $count\n* {{{$count} for {$name}}}")
    assertEq(a, b)
}

test "a number selector compiles to an if-chain over the absolute value" {
    let code = bodyText(".input {$count :number}\n.match $count\none {{{$count} item}}\n* {{{$count} items}}", "en")
    assert(code.contains("(if count < 0 { 0 - count } else { count }) == 1"))
    assert(code.contains("count.toString()"))
}

test "an integer key matches the count itself, not its absolute value" {
    let code = bodyText(".input {$n :number}\n.match $n\n1 {{one file}}\n* {{{$n} files}}", "en")
    assert(code.contains("if n == 1"))
}

test "a category with no variant falls to the catch-all, not to other" {
    let code = bodyText(".input {$n :number}\n.match $n\none {{one}}\nother {{other}}\n* {{star}}", "uk")
    assert(code.contains("star"))
}

test "a quoted key may hold any text" {
    assertEq(argsText(".input {$state :string}\n.match $state\n|on, off| {{X}}\n* {{Y}}"), "state:select:on, off")
}

test "a number key that is neither an integer nor a category is refused" {
    assert(argsText(".input {$n :number}\n.match $n\n1.5 {{x}}\n* {{y}}").contains("is no key of a `:number` selector"))
}

test "an apostrophe is text, and a backslash escapes a brace" {
    assertEq(argsText("It's {$name}!"), "name:string:")
    assertEq(mfUnescape("x \\{ y \\} \\\\"), "x { y } \\")
}

test "readMessage refuses an unmatched or stray brace" {
    assert(argsText("50% off { sale").contains("line 1, column 11: a literal placeholder"))
    assert(argsText("a } b").contains("closes nothing"))
    assertEq(argsText("x \\{ y"), "")
}

test "readMessage refuses what MessageFormat 2 has and std/i18n does not" {
    assert(argsText("{#b}bold{/b}").contains("markup"))
    assert(argsText("{$n :number minimumFractionDigits=2}").contains("option"))
    assert(argsText("{$n :datetime}").contains("not a function std/i18n knows"))
    assert(argsText(".match $n\n* {{x}}").contains("needs a declaration with a function"))
    assert(argsText(".input {$a :number}\n.input {$b :number}\n.match $a $b\n* * {{x}}").contains("one selector"))
    assert(argsText(".input {$n :number}\n.match $n\none {{x}}").contains("all `*`"))
    assert(argsText(".input {$n :number}\n.input {$n :number}\n{{x}}").contains("declared twice"))
    assert(argsText("{$a-b}").contains("no parameter name"))
}

test "a local reads its argument under its function" {
    assertEq(argsText(".local $c = {$count :number}\n.match $c\none {{one}}\n* {{{$c}}}"), "count:number:")
}

test "a list joins its items as the locale does" {
    assertEq(argsText("{$xs :list}"), "xs:list:")
    assert(bodyText("{$xs :list}", "en").contains(", and "))
}

/// The condition `pluralCondition` writes over `count`, which a test can read.
gen fn conditionText(tag: String, cat: String) -> String {
    return render(pluralCondition(tag, cat, name("count")))
}

test "parseLocaleJson flattens nested keys with dots" {
    let src = "{ \"home\": { \"title\": \"Hi\" }, \"greeting\": \"Yo\" }"
    let d = parseLocaleJson(src)
    assert(d.ok)
    assertEq(d.entries.length, 2)
    assertEq(d.entries[0].key, "home.title")
    assertEq(d.entries[0].value, "Hi")
    assertEq(d.entries[1].key, "greeting")
}

test "parseLocaleJson rejects a non-string value" {
    let d = parseLocaleJson("{ \"n\": 5 }")
    assertEq(d.ok, false)
}

test "parseLocaleJson decodes escapes" {
    let d = parseLocaleJson("{ \"k\": \"a\\nb\" }")
    assert(d.ok)
    assertEq(d.entries[0].value.byteLength, 3)
}

test "plural categories cover the Slavic locales" {
    assertEq(pluralCategories("uk").length, 3)
    assertEq(pluralCategories("en").length, 1)
    assertEq(pluralCategories("ja").length, 0)
    assertEq(pluralSupported("xx"), false)
}

test "plural conditions take the absolute value, so negatives pick the CLDR branch" {
    // `%` truncates toward zero, so without |n| -3 and -5 would fall to
    // `other` in uk.
    let few = conditionText("uk", "few")
    assert(few.contains("(if count < 0 { 0 - count } else { count }) % 10 >= 2"))
    assert(few.contains("(if count < 0 { 0 - count } else { count }) % 100 < 12"))
    let many = conditionText("uk", "many")
    assert(many.contains("(if count < 0 { 0 - count } else { count }) % 10 >= 5"))
    assert(many.contains("(if count < 0 { 0 - count } else { count }) % 100 >= 11"))
}

test "keyFnName pascalizes dotted keys" {
    assertEq(keyFnName("cart.items"), "tCartItems")
    assertEq(keyFnName("home.title"), "tHomeTitle")
}

test "regexEscapeKey escapes a dot" {
    assertEq(regexEscapeKey("a.b"), "a\\.b")
}

test "keyCollisionErrors names every collision class" {
    // Dotted vs nested flatten to the same `a.b`.
    let dup = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "a.b", value: "x" }, LocaleEntry { key: "a.b", value: "y" }] }
    assert(joinWith(keyCollisionErrors(dup), "\n").contains("key `a.b` is defined twice"))
    // home.title and homeTitle both make tHomeTitle.
    let clash = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "home.title", value: "A" }, LocaleEntry { key: "homeTitle", value: "B" }] }
    assert(
        joinWith(keyCollisionErrors(clash), "\n")
        .contains("keys `home.title` and `homeTitle` both name the function `tHomeTitle`"),
    )
    // The first key's unprefixed alias (`tCartItems`) is the second's
    // function.
    let cross = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "tCart.items", value: "A" }, LocaleEntry { key: "cart.items", value: "B" }] }
    assert(joinWith(keyCollisionErrors(cross), "\n").contains("collide through different doors"))
    // A key `Locale` derives the alias `locale`, the module's own export.
    let reserved = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "Locale", value: "A" }] }
    assert(
        joinWith(keyCollisionErrors(reserved), "\n")
        .contains("derives the name `locale`, which is the module's own export"),
    )
    // A clean key set collides with nothing.
    let ok = LocaleData { ok: true, error: "", slots: [:], entries: [LocaleEntry { key: "home.title", value: "A" }, LocaleEntry { key: "cart.items", value: "B" }] }
    assertEq(keyCollisionErrors(ok).length, 0)
}
