/// std/codecs -- hex, base64 and percent encoding over UTF-8 bytes. These are the
/// `hexEncode`, `hexDecode`, `base64Encode`, `base64Decode`, `urlEncode` and
/// `urlDecode` builtins on every engine; `tests/codecs.rs` pins their output.
///
/// A decoder whose bytes contain `0x00` returns `None`: a Vyrn `String` cannot
/// hold a NUL, and `stringFromBytes` enforces it.

fn hexDigit(n: UInt8) -> UInt8 {
    if n < 10 {
        return '0' + n
    }
    return 'a' + n - 10
}

/// Uppercase, as percent-encoding uses (RFC 3986 section 2.1).
fn hexDigitUpper(n: UInt8) -> UInt8 {
    if n < 10 {
        return '0' + n
    }
    return 'A' + n - 10
}

/// The value of a hex digit, or `-1` when the byte is not one.
fn hexVal(c: UInt8) -> Int64 {
    if c >= '0' && c <= '9' {
        return Int64(c) - 48
    }
    if c >= 'a' && c <= 'f' {
        return Int64(c) - 87
    }
    if c >= 'A' && c <= 'F' {
        return Int64(c) - 55
    }
    return -1
}

/// Decoded bytes as a `String`; `None` when they are not UTF-8 or hold a NUL.
fn decoded(b: Array<UInt8>) -> Option<String> {
    return match stringFromBytes(b) {
        Ok(s) => Some(s),
        Err(e) => None,
    }
}

/// ASCII bytes as a `String`. Every encoder's output is ASCII, so the `Err` arm
/// is unreachable; it is inlined rather than imported so this module imports nothing.
fn ascii(b: Array<UInt8>) -> String {
    return match stringFromBytes(b) {
        Ok(s) => s,
        Err(e) => "",
    }
}

/// A string's UTF-8 bytes as lowercase hex, two digits per byte.
export fn hexEncode(s: String) -> String {
    let b = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        out.push(hexDigit(b[i] >> 4))
        out.push(hexDigit(b[i] & 15))
        i = i + 1
    }
    return ascii(out)
}

/// Hex text back to a `String`; `None` on an odd length, a non-hex digit, or
/// bytes that are not valid UTF-8. Reads either case.
export fn hexDecode(s: String) -> Option<String> {
    let b = bytes(s)
    if b.length % 2 != 0 {
        return None
    }
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        let hi = hexVal(b[i])
        let lo = hexVal(b[i + 1])
        if hi < 0 || lo < 0 {
            return None
        }
        out.push(UInt8(hi * 16 + lo))
        i = i + 2
    }
    return decoded(out)
}

/// The standard base64 alphabet (RFC 4648 section 4).
fn b64Alphabet() -> Array<UInt8> {
    return bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
}

/// The value of a base64 digit, or `-1`. Arithmetic, since a reverse table would be built on every call.
fn b64Val(c: UInt8) -> Int64 {
    if c >= 'A' && c <= 'Z' {
        return Int64(c) - 65
    }
    if c >= 'a' && c <= 'z' {
        return Int64(c) - 71
    }
    if c >= '0' && c <= '9' {
        return Int64(c) + 4
    }
    if c == '+' {
        return 62
    }
    if c == '/' {
        return 63
    }
    return -1
}

export fn base64Encode(s: String) -> String {
    return base64EncodeBytes(bytes(s))
}

/// Base64 of bytes that are not text, such as a digest: they can hold a NUL and need not be UTF-8.
export fn base64EncodeBytes(b: Array<UInt8>) -> String {
    let tbl = b64Alphabet()
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i + 3 <= b.length {
        let n = (Int64(b[i]) << 16) | (Int64(b[i + 1]) << 8) | Int64(b[i + 2])
        out.push(tbl[(n >> 18) & 63])
        out.push(tbl[(n >> 12) & 63])
        out.push(tbl[(n >> 6) & 63])
        out.push(tbl[n & 63])
        i = i + 3
    }
    // The tail: one byte carries 8 bits into two digits, two bytes carry 16 into
    // three, and `=` says how many of the four are real.
    let rem = b.length - i
    if rem == 1 {
        let n = Int64(b[i]) << 16
        out.push(tbl[(n >> 18) & 63])
        out.push(tbl[(n >> 12) & 63])
        out.push('=')
        out.push('=')
    } else if rem == 2 {
        let n = (Int64(b[i]) << 16) | (Int64(b[i + 1]) << 8)
        out.push(tbl[(n >> 18) & 63])
        out.push(tbl[(n >> 12) & 63])
        out.push(tbl[(n >> 6) & 63])
        out.push('=')
    }
    return ascii(out)
}

/// Base64 text back to a `String`; `None` unless the length is a multiple of four,
/// every digit is in the alphabet, padding is `=` or `==` in the final group only,
/// and the bytes are valid UTF-8.
export fn base64Decode(s: String) -> Option<String> {
    let b = bytes(s)
    if b.length % 4 != 0 {
        return None
    }
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        let p2 = b[i + 2] == '='
        let p3 = b[i + 3] == '='
        // Padding only ends the last group, and it pads a suffix: `=X` is not a
        // legal group even when it is the last one.
        if (p2 || p3) && i + 4 != b.length {
            return None
        }
        if p2 && !p3 {
            return None
        }
        let c0 = b64Val(b[i])
        let c1 = b64Val(b[i + 1])
        let c2 = if p2 { 0 } else { b64Val(b[i + 2]) }
        let c3 = if p3 { 0 } else { b64Val(b[i + 3]) }
        if c0 < 0 || c1 < 0 || c2 < 0 || c3 < 0 {
            return None
        }
        let n = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3
        out.push(UInt8((n >> 16) & 255))
        if !p2 {
            out.push(UInt8((n >> 8) & 255))
        }
        if !p3 {
            out.push(UInt8(n & 255))
        }
        i = i + 4
    }
    return decoded(out)
}

/// The unreserved set (RFC 3986 section 2.3). `+` is not a space in either direction.
fn urlUnreserved(c: UInt8) -> Bool {
    if c >= 'a' && c <= 'z' {
        return true
    }
    if c >= 'A' && c <= 'Z' {
        return true
    }
    if c >= '0' && c <= '9' {
        return true
    }
    return c == '-' || c == '_' || c == '.' || c == '~'
}

/// A string's UTF-8 bytes percent-encoded, uppercase hex.
export fn urlEncode(s: String) -> String {
    let b = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        if urlUnreserved(b[i]) {
            out.push(b[i])
        } else {
            out.push('%')
            out.push(hexDigitUpper(b[i] >> 4))
            out.push(hexDigitUpper(b[i] & 15))
        }
        i = i + 1
    }
    return ascii(out)
}

/// Percent-encoded text back to a `String`; `None` on a truncated or non-hex
/// escape, or bytes that are not valid UTF-8. A raw space or `+` decodes to itself.
export fn urlDecode(s: String) -> Option<String> {
    let b = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        if b[i] == '%' {
            if i + 2 >= b.length {
                return None
            }
            let hi = hexVal(b[i + 1])
            let lo = hexVal(b[i + 2])
            if hi < 0 || lo < 0 {
                return None
            }
            out.push(UInt8(hi * 16 + lo))
            i = i + 3
        } else {
            out.push(b[i])
            i = i + 1
        }
    }
    return decoded(out)
}

test "hex is two lowercase digits a byte, and reads either case back" {
    assertEq(hexEncode(""), "")
    assertEq(hexEncode("Hi"), "4869")
    // A multi-byte character is encoded as its UTF-8 bytes, not its code point.
    assertEq(hexEncode("é"), "c3a9")
    assertEq(match hexDecode("4869") { Some(s) => s, None => "None" }, "Hi")
    assertEq(match hexDecode("C3A9") { Some(s) => s, None => "None" }, "é")
    assertEq(match hexDecode("") { Some(s) => s, None => "None" }, "")
    // Odd length, a non-hex digit, and bytes that are not text.
    assertEq(match hexDecode("486") { Some(s) => s, None => "None" }, "None")
    assertEq(match hexDecode("zz") { Some(s) => s, None => "None" }, "None")
    assertEq(match hexDecode("80") { Some(s) => s, None => "None" }, "None")
}

test "base64 pads at all three residues, and refuses misplaced padding" {
    assertEq(base64Encode(""), "")
    assertEq(base64Encode("A"), "QQ==")
    assertEq(base64Encode("AB"), "QUI=")
    assertEq(base64Encode("ABC"), "QUJD")
    assertEq(base64Encode("Hello, Vyrn!"), "SGVsbG8sIFZ5cm4h")
    // The two alphabet entries above 61, which a naive table gets wrong.
    assertEq(base64Encode("~~~"), "fn5+")
    assertEq(base64Encode("ÿÿ"), "w7/Dvw==")
    assertEq(match base64Decode("SGVsbG8=") { Some(s) => s, None => "None" }, "Hello")
    assertEq(match base64Decode("") { Some(s) => s, None => "None" }, "")
    // Length not a multiple of four, a digit outside the alphabet, `=X`, padding
    // before the last group, and a group whose bytes are not UTF-8.
    assertEq(match base64Decode("QQ=") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64Decode("QQ*=") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64Decode("Q=QQ") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64Decode("QQ==QQ==") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64Decode("////") { Some(s) => s, None => "None" }, "None")
}

test "percent-encoding keeps the unreserved set and nothing else" {
    assertEq(urlEncode("aZ09-_.~"), "aZ09-_.~")
    assertEq(urlEncode("name=a b&x"), "name%3Da%20b%26x")
    // `+` is a reserved character here, not a space.
    assertEq(urlEncode("a+b"), "a%2Bb")
    assertEq(urlEncode("é"), "%C3%A9")
    assertEq(match urlDecode("%C3%A9") { Some(s) => s, None => "None" }, "é")
    assertEq(match urlDecode("%c3%a9") { Some(s) => s, None => "None" }, "é")
    assertEq(match urlDecode("a+b") { Some(s) => s, None => "None" }, "a+b")
    assertEq(match urlDecode("%") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecode("%4") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecode("%zz") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecode("%80") { Some(s) => s, None => "None" }, "None")
}

test "a decoded NUL is refused, because a Vyrn String cannot hold one" {
    assertEq(match hexDecode("00") { Some(s) => s, None => "None" }, "None")
    assertEq(match hexDecode("004100") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64Decode("AA==") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecode("%00") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecode("a%00b") { Some(s) => s, None => "None" }, "None")
}
