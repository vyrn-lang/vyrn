/// std/codecs — hex, base64 and percent encoding, written in Vyrn (RFC-0078 M4b).
///
/// The six codec builtins — `hexEncode`, `hexDecode`, `base64Encode`,
/// `base64Decode`, `urlEncode`, `urlDecode` — are the clearest case RFC-0078
/// makes. They are pure byte transforms: no syscall, no allocator trick, no type
/// knowledge, and (unlike every other builtin) **no C shim implementation at
/// all** — the native path is hand-written LLVM IR printed by the textual
/// emitter, and the interpreter holds the same algorithm again in Rust. Two
/// definitions of a table lookup and a shift, plus a third owed to the direct
/// wasm backend.
///
/// This module is what one definition looks like: `bytes(s)` gives the input as
/// `Array<UInt8>`, `stringFromBytes(..)` turns the output back into a `String`,
/// and everything between is a `while` loop and the bitwise operators from
/// RFC-0045. No primitive was missing — which is the finding, since M4a needed
/// two (`floatBits`/`floatFromBits`) and M3 is still waiting on a ruling.
///
/// **These six ARE the builtins now** (RFC-0078 M4c). M4b(1) proved the Vyrn
/// versions equal to them over 6,354 comparisons with the builtin as the oracle;
/// M4c routed `hexEncode`, `hexDecode`, `base64Encode`, `base64Decode`, `urlEncode`
/// and `urlDecode` into this module on every engine and deleted the duplicates —
/// 521 lines of hand-written LLVM IR and 162 lines of Rust. The `V` suffix is
/// therefore a second spelling of the same function rather than a rival to it;
/// `tests/codecs.rs` carries the old oracle forward as a pinned digest, since a
/// comparison would now be `x == x`.
///
/// **One behavioural change, and it is a bug fix.** A decoder whose bytes contain
/// `0x00` — `hexDecode("00")`, `base64Decode("AA==")`, `urlDecode("%00")` — returns
/// `None`, because RFC-0014's rule is that a Vyrn `String` cannot hold a NUL and
/// `stringFromBytes` enforces it. The deleted builtin answered `Some`, and did not
/// agree with itself: the interpreter kept a Rust `String` with an embedded NUL
/// while the native path returned a NUL-terminated `char*` silently truncated at
/// that byte. No example decodes a NUL, so parity had never looked. Measured across
/// the swap, that is **16 of 6,354 rows** and every one of the 16 is a NUL row —
/// `tests/codecs.rs` records both digests and pins the rows individually.

/// The lowercase hex digit for a nibble (`0`..`9`, then `a`..`f`).
fn hexDigit(n: UInt8) -> UInt8 {
    if n < 10 {
        return '0' + n
    }
    return 'a' + n - 10
}

/// The same, uppercase — which is what percent-encoding uses (RFC 3986 §2.1
/// prefers uppercase, and the builtin emits it).
fn hexDigitUpper(n: UInt8) -> UInt8 {
    if n < 10 {
        return '0' + n
    }
    return 'A' + n - 10
}

/// The value of a hex digit, or `-1` when the byte is not one. An `Int64` rather
/// than an `Option<UInt8>` so the caller's "either of these two failed" test is
/// one comparison, exactly as the emitted IR's `__vyrn_hexval` does it.
fn hexVal(c: UInt8) -> Int64 {
    if c >= '0' && c <= '9' {
        return Int64(c) - 48
    }
    if c >= 'a' && c <= 'f' {
        return Int64(c) - 87
    }
    if c >= 'A' && c <= 'F' {
        return Int64(c) - 55
    }
    return -1
}

/// Decoded bytes as a `String`, or `None` when they are not one. The single point
/// where every decoder's "the bytes came out, but are they text?" is answered —
/// and the single place this module can differ from the builtin, since
/// `stringFromBytes` rejects a NUL and `String::from_utf8` does not.
fn decoded(b: Array<UInt8>) -> Option<String> {
    return match stringFromBytes(b) {
        Ok(s) => Some(s),
        Err(e) => None,
    }
}

/// ASCII bytes as a `String`. Every encoder's output is ASCII by construction, so
/// the `Err` arm is unreachable and the fallback exists only to make the function
/// total (the `std/strings:fromBytesOr` pattern, inlined rather than imported so
/// this module keeps `std/json`'s property of importing nothing).
fn ascii(b: Array<UInt8>) -> String {
    return match stringFromBytes(b) {
        Ok(s) => s,
        Err(e) => "",
    }
}

/// A string's UTF-8 bytes as lowercase hex, two digits per byte.
export fn hexEncodeV(s: String) -> String {
    let b = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        out.push(hexDigit(b[i] >> 4))
        out.push(hexDigit(b[i] & 15))
        i = i + 1
    }
    return ascii(out)
}

/// Hex text back to a `String` — `None` on an odd length, a non-hex digit, or
/// bytes that are not valid UTF-8. Case-insensitive, as the encoder's inverse
/// has to be to read anyone else's output.
export fn hexDecodeV(s: String) -> Option<String> {
    let b = bytes(s)
    if b.length % 2 != 0 {
        return None
    }
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        let hi = hexVal(b[i])
        let lo = hexVal(b[i + 1])
        if hi < 0 || lo < 0 {
            return None
        }
        out.push(UInt8(hi * 16 + lo))
        i = i + 2
    }
    return decoded(out)
}

/// The standard base64 alphabet (RFC 4648 §4): `A`..`Z`, `a`..`z`, `0`..`9`, then
/// `+` and `/`. Built from a string literal so the table is the alphabet rather
/// than 64 arithmetic branches.
fn b64Alphabet() -> Array<UInt8> {
    return bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
}

/// The value of a base64 digit, or `-1`. The inverse of [`b64Alphabet`] as
/// arithmetic, since a 256-entry reverse table would be built on every call.
fn b64Val(c: UInt8) -> Int64 {
    if c >= 'A' && c <= 'Z' {
        return Int64(c) - 65
    }
    if c >= 'a' && c <= 'z' {
        return Int64(c) - 71
    }
    if c >= '0' && c <= '9' {
        return Int64(c) + 4
    }
    if c == '+' {
        return 62
    }
    if c == '/' {
        return 63
    }
    return -1
}

/// A string's UTF-8 bytes as base64: three bytes to four digits, with `=`
/// padding for a final group of one or two.
export fn base64EncodeV(s: String) -> String {
    return base64EncodeBytes(bytes(s))
}

/// The same, over bytes that are not text. A digest is the case this exists for
/// (RFC-0074 M3b's handshake base64s twenty SHA-1 bytes): it can hold a NUL and
/// need not be UTF-8, so it cannot make the trip through a `String` first.
export fn base64EncodeBytes(b: Array<UInt8>) -> String {
    let tbl = b64Alphabet()
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i + 3 <= b.length {
        let n = (Int64(b[i]) << 16) | (Int64(b[i + 1]) << 8) | Int64(b[i + 2])
        out.push(tbl[(n >> 18) & 63])
        out.push(tbl[(n >> 12) & 63])
        out.push(tbl[(n >> 6) & 63])
        out.push(tbl[n & 63])
        i = i + 3
    }
    // The tail: one byte carries 8 bits into two digits, two bytes carry 16 into
    // three, and `=` says how many of the four are real.
    let rem = b.length - i
    if rem == 1 {
        let n = Int64(b[i]) << 16
        out.push(tbl[(n >> 18) & 63])
        out.push(tbl[(n >> 12) & 63])
        out.push('=')
        out.push('=')
    } else if rem == 2 {
        let n = (Int64(b[i]) << 16) | (Int64(b[i + 1]) << 8)
        out.push(tbl[(n >> 18) & 63])
        out.push(tbl[(n >> 12) & 63])
        out.push(tbl[(n >> 6) & 63])
        out.push('=')
    }
    return ascii(out)
}

/// Base64 text back to a `String` — `None` unless the length is a multiple of
/// four, every digit is in the alphabet, the padding is confined to the final
/// group and is `=` or `==` (never `=X`), and the bytes are valid UTF-8.
export fn base64DecodeV(s: String) -> Option<String> {
    let b = bytes(s)
    if b.length % 4 != 0 {
        return None
    }
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        let p2 = b[i + 2] == '='
        let p3 = b[i + 3] == '='
        // Padding only ends the last group, and it pads a suffix: `=X` is not a
        // legal group even when it is the last one.
        if (p2 || p3) && i + 4 != b.length {
            return None
        }
        if p2 && !p3 {
            return None
        }
        let c0 = b64Val(b[i])
        let c1 = b64Val(b[i + 1])
        let c2 = if p2 { 0 } else { b64Val(b[i + 2]) }
        let c3 = if p3 { 0 } else { b64Val(b[i + 3]) }
        if c0 < 0 || c1 < 0 || c2 < 0 || c3 < 0 {
            return None
        }
        let n = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3
        out.push(UInt8((n >> 16) & 255))
        if !p2 {
            out.push(UInt8((n >> 8) & 255))
        }
        if !p3 {
            out.push(UInt8(n & 255))
        }
        i = i + 4
    }
    return decoded(out)
}

/// The unreserved set (RFC 3986 §2.3): `A`-`Z`, `a`-`z`, `0`-`9`, `-`, `_`, `.`,
/// `~`. Everything else is percent-encoded — including `+`, which this codec does
/// NOT treat as a space in either direction.
fn urlUnreserved(c: UInt8) -> Bool {
    if c >= 'a' && c <= 'z' {
        return true
    }
    if c >= 'A' && c <= 'Z' {
        return true
    }
    if c >= '0' && c <= '9' {
        return true
    }
    return c == '-' || c == '_' || c == '.' || c == '~'
}

/// A string's UTF-8 bytes percent-encoded, uppercase hex.
export fn urlEncodeV(s: String) -> String {
    let b = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        if urlUnreserved(b[i]) {
            out.push(b[i])
        } else {
            out.push('%')
            out.push(hexDigitUpper(b[i] >> 4))
            out.push(hexDigitUpper(b[i] & 15))
        }
        i = i + 1
    }
    return ascii(out)
}

/// Percent-encoded text back to a `String` — `None` on a truncated or non-hex
/// escape, or bytes that are not valid UTF-8. Any byte that is not `%` passes
/// through, so a raw space or `+` decodes to itself.
export fn urlDecodeV(s: String) -> Option<String> {
    let b = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    while i < b.length {
        if b[i] == '%' {
            if i + 2 >= b.length {
                return None
            }
            let hi = hexVal(b[i + 1])
            let lo = hexVal(b[i + 2])
            if hi < 0 || lo < 0 {
                return None
            }
            out.push(UInt8(hi * 16 + lo))
            i = i + 3
        } else {
            out.push(b[i])
            i = i + 1
        }
    }
    return decoded(out)
}

test "hex is two lowercase digits a byte, and reads either case back" {
    assertEq(hexEncodeV(""), "")
    assertEq(hexEncodeV("Hi"), "4869")
    // A multi-byte character is encoded as its UTF-8 bytes, not its code point.
    assertEq(hexEncodeV("é"), "c3a9")
    assertEq(match hexDecodeV("4869") { Some(s) => s, None => "None" }, "Hi")
    assertEq(match hexDecodeV("C3A9") { Some(s) => s, None => "None" }, "é")
    assertEq(match hexDecodeV("") { Some(s) => s, None => "None" }, "")
    // Odd length, a non-hex digit, and bytes that are not text.
    assertEq(match hexDecodeV("486") { Some(s) => s, None => "None" }, "None")
    assertEq(match hexDecodeV("zz") { Some(s) => s, None => "None" }, "None")
    assertEq(match hexDecodeV("80") { Some(s) => s, None => "None" }, "None")
}

test "base64 pads at all three residues, and refuses misplaced padding" {
    assertEq(base64EncodeV(""), "")
    assertEq(base64EncodeV("A"), "QQ==")
    assertEq(base64EncodeV("AB"), "QUI=")
    assertEq(base64EncodeV("ABC"), "QUJD")
    assertEq(base64EncodeV("Hello, Vyrn!"), "SGVsbG8sIFZ5cm4h")
    // The two alphabet entries above 61, which a naive table gets wrong.
    assertEq(base64EncodeV("~~~"), "fn5+")
    assertEq(base64EncodeV("ÿÿ"), "w7/Dvw==")
    assertEq(match base64DecodeV("SGVsbG8=") { Some(s) => s, None => "None" }, "Hello")
    assertEq(match base64DecodeV("") { Some(s) => s, None => "None" }, "")
    // Length not a multiple of four, a digit outside the alphabet, `=X`, padding
    // before the last group, and a group whose bytes are not UTF-8.
    assertEq(match base64DecodeV("QQ=") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64DecodeV("QQ*=") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64DecodeV("Q=QQ") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64DecodeV("QQ==QQ==") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64DecodeV("////") { Some(s) => s, None => "None" }, "None")
}

test "percent-encoding keeps the unreserved set and nothing else" {
    assertEq(urlEncodeV("aZ09-_.~"), "aZ09-_.~")
    assertEq(urlEncodeV("name=a b&x"), "name%3Da%20b%26x")
    // `+` is a reserved character here, not a space.
    assertEq(urlEncodeV("a+b"), "a%2Bb")
    assertEq(urlEncodeV("é"), "%C3%A9")
    assertEq(match urlDecodeV("%C3%A9") { Some(s) => s, None => "None" }, "é")
    assertEq(match urlDecodeV("%c3%a9") { Some(s) => s, None => "None" }, "é")
    assertEq(match urlDecodeV("a+b") { Some(s) => s, None => "None" }, "a+b")
    assertEq(match urlDecodeV("%") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecodeV("%4") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecodeV("%zz") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecodeV("%80") { Some(s) => s, None => "None" }, "None")
}

/// The NUL rows, pinned as a divergence from the builtin rather than hidden.
///
/// RFC-0014 forbids a NUL inside a `String`, so `stringFromBytes` refuses and
/// every decoder here answers `None`. The builtin answers `Some`, and answers it
/// differently on each engine — a Rust `String` holding the NUL in the
/// interpreter, a `char*` truncated at it natively. When the swap lands, `None`
/// is the answer that is the same on all three.
test "a decoded NUL is refused, because a Vyrn String cannot hold one" {
    assertEq(match hexDecodeV("00") { Some(s) => s, None => "None" }, "None")
    assertEq(match hexDecodeV("004100") { Some(s) => s, None => "None" }, "None")
    assertEq(match base64DecodeV("AA==") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecodeV("%00") { Some(s) => s, None => "None" }, "None")
    assertEq(match urlDecodeV("a%00b") { Some(s) => s, None => "None" }, "None")
}
