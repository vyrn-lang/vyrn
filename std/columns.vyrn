/// std/columns: a record type laid out as one array per field.
///
///   import { columns } from "std/columns"
///   import { BodyColumns, bodyColumns, pushBody, bodyAt } from columns("./bodies")
///
/// `columns` is a `gen fn` that reflects a module and writes, for each record
/// type `T` it exports:
///
/// - `type TColumns`: one `Array<F>` per field `f: F` of `T`, under the same
///   name, with a `where` rule that every column has the first one's length.
///   `c.f[i]` reads a field and `c.f[i] = v` writes one in place.
/// - `tColumns(capacity)`: empty columns with room for `capacity` rows.
/// - `pushT(c, v)`: appends the row `v` to `c` in place. The pushes are one
///   group of stores, so the rule is checked once, after the last column
///   grows, and the check is proved.
/// - `tAt(c, i)`: row `i` read back as a `T`.
///
/// `c.f.length` counts the rows. Because of the rule, a loop bounded by one
/// column's length indexes every column with no bounds check. A walk over one
/// field of many rows reads only that field's bytes, and a layout of one array
/// of records reads the whole row.

import { importBlock } from "std/imports"
import { joinWith, substring, toLower } from "std/strings"

/// Emits a module exporting the column layout of every record type `module`
/// exports.
export gen fn columns(module: String) -> String {
    let iface = moduleInterface(module)
    let mut out = "/// Generated by std/columns `columns`; do not edit.\n" + importBlock(iface, "", [])
    let mut records = 0
    for t in iface.types {
        if t.module == module && t.shape[0].kind == "record" {
            out = out + columnsOf(t)
            records = records + 1
        }
    }
    if records == 0 {
        panic("std/columns: `" + module + "` exports no record type, so there is nothing to lay out. Export a record type.")
    }
    return out
}

gen fn columnsOf(t: TypeInfo) -> String {
    let name = t.name
    let cols = name + "Columns"
    let lower = toLower(substring(name, 0, 1)) + substring(name, 1, name.byteLength)
    let first = t.shape[0].members[0].name
    let mut decl: Array<String> = []
    let mut rule: Array<String> = []
    let mut names: Array<String> = []
    let mut empty = ""
    let mut push = ""
    let mut row: Array<String> = []
    for m in t.shape[0].members {
        let f = m.name
        let ty = "Array<" + t.shape[m.args[0]].spelling + ">"
        decl.push(f + ": " + ty)
        if f != first {
            rule.push(first + ".length == " + f + ".length")
        }
        names.push(f + ": " + f)
        empty = empty + "    let mut " + f + ": " + ty + " = []\n    " + f + ".reserve(capacity)\n"
        push = push + "    c." + f + ".push(v." + f + ".copy())\n"
        row.push(f + ": c." + f + "[i].copy()")
    }
    let mut out = "export type " + cols + " = { " + joinWith(decl, ", ") + " }"
    if rule.length > 0 {
        out = out + " where " + joinWith(rule, " && ")
    }
    let build = "    return " + cols + " { " + joinWith(names, ", ") + " }\n}\n"
    out = out + "\nexport fn " + lower + "Columns(capacity: Int64) -> " + cols + " {\n" + empty + build
    out = out + "export fn push" + name + "(c: modify " + cols + ", v: " + name + ") {\n" + push + "}\n"
    out = out + "export fn " + lower + "At(c: " + cols + ", i: Int64) -> " + name + " {\n"
    return out + "    return " + name + " { " + joinWith(row, ", ") + " }\n}\n"
}
