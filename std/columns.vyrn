/// A record type laid out as one array per field.
///
///   import { columns } from "std/columns"
///   import { BodyColumns, bodyColumns, pushBody, bodyAt } from columns("./bodies")
///
/// `columns` is a `gen fn` that reflects a module and writes, for each record
/// type `T` it exports:
///
/// - `type TColumns`: one `Array<F>` per field `f: F` of `T`, under the same
///   name, with a `where` rule that every column has the first one's length.
///   `c.f[i]` reads a field and `c.f[i] = v` writes one in place.
/// - `tColumns(capacity)`: empty columns with room for `capacity` rows.
/// - `pushT(c, v)`: appends the row `v` to `c` in place. The pushes are one
///   group of stores, so the rule is checked once, after the last column
///   grows, and the check is proved.
/// - `tAt(c, i)`: row `i` read back as a `T`.
///
/// `c.f.length` counts the rows. Because of the rule, a loop bounded by one
/// column's length indexes every column with no bounds check. A walk over one
/// field of many rows reads only that field's bytes, and a layout of one array
/// of records reads the whole row.

import { join } from "std/code"
import { importBlock } from "std/imports"
import { substring, toLower } from "std/strings"

/// Emits a module exporting the column layout of every record type `module`
/// exports.
export gen fn columns(module: String) -> Code {
    let m = moduleCode(module)
    let mut out = importBlock(m.iface, "", []) + vyrn"
"
    let mut records = 0
    for t in m.types {
        if t.info.module == module && t.info.shape[0].kind == "record" {
            out = out + columnsOf(t)
            records = records + 1
        }
    }
    if records == 0 {
        panic("std/columns: `" + module + "` exports no record type, so there is nothing to lay out. Export a record type.")
    }
    return out
}

gen fn columnsOf(t: TypeCode) -> Code {
    let row = name(t.info.name)
    let cols = name(t.info.name + "Columns")
    let lower = toLower(substring(t.info.name, 0, 1)) + substring(t.info.name, 1, t.info.name.byteLength)
    let make = name(lower + "Columns")
    let push = name("push" + t.info.name)
    let at = name(lower + "At")
    let first = name(t.info.shape[0].members[0].name)
    let mut decl: Array<Code> = []
    let mut rule: Array<Code> = []
    let mut names: Array<Code> = []
    let mut empty: Array<Code> = []
    let mut pushes: Array<Code> = []
    let mut reads: Array<Code> = []
    for f in t.info.shape[0].members {
        let col = name(f.name)
        let ty = vyrn"Array<\{t.nodes[f.args[0]].code}>"
        decl.push(vyrn"\{col}: \{ty}")
        if f.name != t.info.shape[0].members[0].name {
            rule.push(vyrn"\{first}.length == \{col}.length")
        }
        names.push(vyrn"\{col}: \{col}")
        empty.push(vyrn"""
            let mut \{col}: \{ty} = []
            \{col}.reserve(capacity)
            """)
        pushes.push(vyrn"c.\{col}.push(v.\{col}.copy())")
        reads.push(vyrn"\{col}: c.\{col}[i].copy()")
    }
    let fields = join(decl, vyrn", ")
    let layout = columnsType(cols, fields, rule)
    let fill = join(empty, vyrn"
")
    let built = join(names, vyrn", ")
    let stores = join(pushes, vyrn"
")
    let read = join(reads, vyrn", ")
    return vyrn"""
        \{layout}
        export fn \{make}(capacity: Int64) -> \{cols} {
            \{fill}
            return \{cols} { \{built} }
        }
        export fn \{push}(c: modify \{cols}, v: \{row}) {
            \{stores}
        }
        export fn \{at}(c: \{cols}, i: Int64) -> \{row} {
            return \{row} { \{read} }
        }

        """
}

/// The columns' record type, with the rule that every column has the first
/// one's length when there is more than one.
gen fn columnsType(cols: Name, fields: Code, rule: Array<Code>) -> Code {
    if rule.length == 0 {
        return vyrn"export type \{cols} = { \{fields} }"
    }
    let same = join(rule, vyrn" && ")
    return vyrn"export type \{cols} = { \{fields} } where \{same}"
}
