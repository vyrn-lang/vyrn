/// std/symbolmap (RFC-0073 M1) — the shared shape of a generated module's symbol
/// map: for each exported symbol, the source declaration it stands for, plus any
/// derived facts.
///
///   import { symbol, strField, mapJson, symbolMapFn } from "std/symbolmap"
///
/// A BUILDER, not an emitter. A `gen fn` returns one thing — the module source —
/// so the map is not a second artifact beside it; it is an ordinary
/// `symbolMap() -> String` export baked INTO the module (`symbolMapFn` renders
/// the whole declaration). The generator cache already keys a module by content
/// hash, so a map that lives inside the module cannot go stale relative to the
/// code beside it, and there is no second cache entry to keep in step.
///
/// The JSON is the format third-party tools read, so it lives in one place:
///
///   { "module": "client(./server/api)",
///     "symbols": [ { "name": "pastes.list",
///                    "origin": { "file": "server/api/pastes.vyrn", "line": 8,
///                                "col": 11, "name": "list" },
///                    "derived": { "kind": "rpc", "path": "/_/pastes/list" } } ] }
///
/// `derived` is open — it is whatever `Json` the generator puts there, so an
/// HTTP projection can write cache policy into it without this module learning
/// what cache policy is. An empty `derived` is omitted rather than written `{}`.

import { Json, JsonField, emit } from "std/json"

/// One mapped symbol: the name the generated module exports, the declaration it
/// stands for, and the derived facts about it.
///
/// `origin` is the compiler's own `Origin` — the one `moduleInterface` hands a
/// generator on every `FnInfo`/`TypeInfo` — so a map records what reflection
/// said rather than what a generator reconstructed.
export type Symbol = { name: String, origin: Origin, derived: Array<JsonField> }

/// A mapped symbol. `derived` is `[]` for a symbol with nothing derived about it.
export fn symbol(name: String, origin: Origin, derived: consume Array<JsonField>) -> Symbol {
    return Symbol { name: name.copy(), origin: origin.copy(), derived: derived }
}

/// `"key": "value"` — the shape almost every derived fact has.
export fn strField(key: String, value: String) -> JsonField {
    return JsonField { key: key.copy(), value: JStr(value) }
}

/// An origin as JSON. A `line`/`col` of 0 means the declaration could not be
/// placed (a synthesized surface); it is written rather than omitted, because a
/// consumer that has to distinguish "unplaced" from "absent" would otherwise
/// have to guess.
fn originJson(o: Origin) -> Json {
    let fs: Array<JsonField> = [
        JsonField { key: "file", value: JStr(o.file) },
        JsonField { key: "line", value: JNum(o.line.toString()) },
        JsonField { key: "col", value: JNum(o.col.toString()) },
        JsonField { key: "name", value: JStr(o.name) },
    ]
    return JObj(fs)
}

/// The map document for `module` — the generator call that produced it — as
/// compact JSON, symbols in emission order.
export fn mapJson(module: String, symbols: Array<Symbol>) -> String {
    let mut syms: Array<Json> = []
    for s in symbols {
        let mut fs: Array<JsonField> = [
            JsonField { key: "name", value: JStr(s.name) },
            JsonField { key: "origin", value: originJson(s.origin) },
        ]
        if s.derived.length > 0 {
            fs.push(JsonField { key: "derived", value: JObj(s.derived) })
        }
        syms.push(JObj(fs))
    }
    let doc: Array<JsonField> = [
        JsonField { key: "module", value: JStr(module) },
        JsonField { key: "symbols", value: JArr(syms) },
    ]
    return emit(JObj(doc))
}

/// The generator call as an identifier tail: every letter and digit of it,
/// camel-cased at each boundary. `http(./pastes)` becomes `HttpPastes`.
///
/// A top-level name in Vyrn is program-wide, so a fixed `symbolMap` would let
/// two generated modules in one program collide — which is exactly what a server
/// root does the moment it links both `rpc("./server/api")` and a REST
/// projection's `http("./pastes")`. The generator call is the one thing that
/// distinguishes them and it is already in hand.
fn mapSlug(module: String) -> String {
    let mut bytes: Array<UInt8> = []
    let mut upper = true
    let mut i = 0
    while i < module.byteLength {
        let b = module[i]
        let lower = b >= 'a' && b <= 'z'
        if lower || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') {
            bytes.push(if upper && lower { b - 32 } else { b })
            upper = false
        } else {
            upper = true
        }
        i = i + 1
    }
    // Every kept byte is ASCII alphanumeric, so the decode cannot fail; the
    // empty fallback is unreachable and is written rather than trapped, because
    // a generator that trapped here would report a lexer fact as a user error.
    return match stringFromBytes(bytes) {
        Ok(s) => s,
        Err(why) => "",
    }
}

/// The map declaration to append to a generated module — the whole of what a
/// generator emits for its map.
///
/// The JSON is baked as a string LITERAL through an RFC-0054 code quote:
/// `\{json}` sits in expression position, so the compiler's own escaping turns
/// the document into data. Hand-escaping it would be a second escaper free to
/// disagree with the lexer, over a string that already carries one layer of JSON
/// escaping. `gen fn` because a code quote is a generation-context construct;
/// every caller is a generator already.
///
/// The declaration's name carries [`mapSlug`], so the reader finds it by the
/// `symbolMap` PREFIX rather than by an exact name.
export gen fn symbolMapFn(module: String, symbols: Array<Symbol>) -> String {
    let json = mapJson(module, symbols)
    let mut out = "/// The RFC-0073 symbol map for this generated module: every exported\n"
    out = out + "/// symbol, the declaration it stands for, and its derived facts.\n"
    out = out + "export fn symbolMap" + mapSlug(module) + "() -> String {\n"
    out = out + "    return " + render(vyrn"\{json}") + "\n}\n"
    return out
}
