/// std/symbolmap: the symbol map of a generated module. For each
/// exported symbol, the source declaration it stands for and any derived facts.
///
///   import { symbol, strField, mapJson, symbolMapFn } from "std/symbolmap"
///
/// The map is a `symbolMap<Slug>() -> String` export baked into the module, so
/// the generator cache, keyed by content, cannot let it go stale. Third-party
/// tools read this JSON:
///
///   { "module": "client(./server/api)",
///     "symbols": [ { "name": "pastes.list",
///                    "origin": { "file": "server/api/pastes.vyrn", "line": 8,
///                                "col": 11, "name": "list" },
///                    "derived": { "kind": "rpc", "path": "/_/pastes/list" } } ] }
///
/// `derived` is whatever `Json` the generator puts there; an empty one is
/// omitted.

import { Json, JsonField, copyJsonFields, emit } from "std/json"
import { fnv1aStr } from "std/hash"

/// One mapped symbol. `origin` is the `Origin` reflection handed the generator,
/// not one the generator reconstructed.
export type Symbol = { name: String, origin: Origin, derived: Array<JsonField> }

/// `derived` is `[]` for a symbol with nothing derived about it.
export fn symbol(name: String, origin: Origin, derived: consume Array<JsonField>) -> Symbol {
    return Symbol { name: name.copy(), origin: origin.copy(), derived: derived }
}

export fn strField(key: String, value: String) -> JsonField {
    return JsonField { key: key.copy(), value: JStr(value.copy()) }
}

/// An origin as JSON. A `line`/`col` of 0 means a synthesized declaration with
/// no place; it is written, not omitted, so "unplaced" differs from "absent".
fn originJson(o: Origin) -> Json {
    let fs: Array<JsonField> = [
        JsonField { key: "file", value: JStr(o.file.copy()) },
        JsonField { key: "line", value: JNum(o.line.toString()) },
        JsonField { key: "col", value: JNum(o.col.toString()) },
        JsonField { key: "name", value: JStr(o.name.copy()) },
    ]
    return JObj(fs)
}

/// The map document for the generator call `module`, as compact JSON, symbols
/// in emission order.
export fn mapJson(module: String, symbols: Array<Symbol>) -> String {
    let mut syms: Array<Json> = []
    for s in symbols {
        let mut fs: Array<JsonField> = [
            JsonField { key: "name", value: JStr(s.name.copy()) },
            JsonField { key: "origin", value: originJson(s.origin) },
        ]
        if s.derived.length > 0 {
            fs.push(JsonField { key: "derived", value: JObj(copyJsonFields(s.derived)) })
        }
        syms.push(JObj(fs))
    }
    let doc: Array<JsonField> = [
        JsonField { key: "module", value: JStr(module.copy()) },
        JsonField { key: "symbols", value: JArr(syms) },
    ]
    return emit(JObj(doc))
}

/// The generator call as an identifier tail: every ASCII letter and digit,
/// camel-cased at each boundary, so `http(./pastes)` becomes `HttpPastes`.
///
/// A top-level name is program-wide, so two generated maps in one program need
/// different names. A path with a byte above 0x7F also gets an FNV-1a-64 suffix
/// of the whole path, because dropping those bytes could merge two slugs.
fn mapSlug(module: String) -> String {
    let mut bytes: Array<UInt8> = []
    let mut upper = true
    let mut lossy = false
    let mut i = 0
    while i < module.byteLength {
        let b = module[i]
        if b >= 128 {
            lossy = true
        }
        let lower = b >= 'a' && b <= 'z'
        if lower || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') {
            bytes.push(if upper && lower { b - 32 } else { b })
            upper = false
        } else {
            upper = true
        }
        i = i + 1
    }
    // Every kept byte is ASCII alphanumeric, so the decode cannot fail. The
    // fallback is not a trap because a generator trap reports as a user error.
    let base = match stringFromBytes(bytes) {
        Ok(s) => s,
        Err(why) => "",
    }
    if lossy {
        return base + "X" + fnv1aStr(module).toString()
    }
    return base
}

/// The map declaration to append to a generated module.
///
/// The JSON goes through a code quote: `\{json}` sits in expression position,
/// so the compiler's own escaping makes it a string literal, with no second
/// escaper to disagree with the lexer. The reader finds the declaration by the
/// `symbolMap` prefix, since `mapSlug` names it.
export gen fn symbolMapFn(module: String, symbols: Array<Symbol>) -> String {
    let json = mapJson(module, symbols)
    let mut out = "/// The symbol map for this generated module: every exported\n"
    out = out + "/// symbol, the declaration it stands for, and its derived facts.\n"
    out = out + "export fn symbolMap" + mapSlug(module) + "() -> String {\n"
    out = out + "    return " + render(vyrn"\{json}") + "\n}\n"
    return out
}

test "a slug distinguishes paths that differ only outside ASCII" {
    // The two paths share every ASCII byte.
    let a = mapSlug("http(./påster)")
    let b = mapSlug("http(./pa̋ster)")
    assert(a != b)
}

test "an ASCII path keeps the slug it always had" {
    assertEq(mapSlug("http(./pastes)"), "HttpPastes")
    assertEq(mapSlug("rpc(./server/api)"), "RpcServerApi")
}
