/// The contract as an OpenAPI 3.1 document, built from
/// generator imports. `openapi(contract)` reflects the contract with
/// `moduleInterface` and returns a module exporting `openapiJson() -> String`.
///
///   import { openapi } from "std/openapi"
///   import { openapiJson } from openapi("./contract")
///
/// The document holds one `POST /rpc/<proc>` path per procedure in declaration
/// order, with a `200` response and the `422` Issues shape `std/rpc` returns, and
/// one `components/schemas` entry per type in the reachable closure,
/// sorted by name. Each schema body is a runtime `jsonSchema()` call, because
/// `moduleInterface` carries only a scalar's shallow bounds; each is a compile-time
/// constant, so the document is byte-stable. `std/json` writes it pretty-printed.
/// No callbacks, webhooks or auth schemes.

import { includes } from "std/arrays"
import { importBlock, procImports } from "std/imports"
import { fromBytesOr } from "std/strings"
import { endsWith } from "std/strpred"

/// The module base name of a specifier, for `info.title` (`"./contract"` =>
/// `contract`, `"std/shelf.vyrn"` => `shelf`).
fn oaBaseName(spec: String) -> String {
    let ba = bytes(spec)
    let mut start = 0
    let mut i = 0
    while i < ba.length {
        if ba[i] == '/' {
            start = i + 1
        }
        i = i + 1
    }
    let mut seg: Array<UInt8> = []
    let mut j = start
    while j < ba.length {
        seg.push(ba[j])
        j = j + 1
    }
    let name = fromBytesOr(seg, spec)
    if name.endsWith(".vyrn") {
        let nb = bytes(name)
        let mut trimmed: Array<UInt8> = []
        let mut k = 0
        while k < nb.length - 5 {
            trimmed.push(nb[k])
            k = k + 1
        }
        return fromBytesOr(trimmed, name)
    }
    return name
}

/// A sorted copy of `names`, so the schema keys do not depend on the closure's order. Insertion sort; the closure is small.
fn oaSorted(names: Array<String>) -> Array<String> {
    let mut out: Array<String> = []
    for n in names {
        let mut placed = false
        let mut res: Array<String> = []
        for m in out {
            if placed == false && n < m {
                res.push(n.copy())
                placed = true
            }
            res.push(m.copy())
        }
        if placed == false {
            res.push(n.copy())
        }
        out = res
    }
    return out
}

fn oaIsNamedType(spelling: String, iface: ModuleInterface) -> Bool {
    for t in iface.types {
        if t.name == spelling {
            return true
        }
    }
    return false
}

/// The JSON Schema of the `{ issues: [{ key, path, message }] }` body `std/rpc` returns on a 422.
fn oaIssuesSchema() -> String {
    return "{\"type\":\"object\",\"properties\":{\"issues\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"required\":[\"key\",\"path\",\"message\"]}}},\"required\":[\"issues\"]}"
}

/// A `$ref` to the named return type's component, `{"type":"null"}` for a `Unit`
/// return, or `{}` for a bare type.
fn oaResponseSchema(f: FnInfo, iface: ModuleInterface) -> String {
    if f.ret == "" {
        return "{\"type\":\"null\"}"
    }
    if oaIsNamedType(f.ret, iface) {
        return "{\"$ref\":\"#/components/schemas/" + f.ret + "\"}"
    }
    return "{}"
}

/// A `$ref` when the spelling names a contract type, else `{}`: `components/schemas`
/// holds only the closure's types, so a `$ref` to `Int64` would dangle.
fn oaRequestSchema(spelling: String, typeNames: Array<String>) -> String {
    if includes(typeNames, spelling) {
        return "{\"$ref\":\"#/components/schemas/" + spelling + "\"}"
    }
    return "{}"
}

/// One procedure's `paths` value as compact JSON, parsed into the document at runtime.
fn oaPathValue(f: FnInfo, iface: ModuleInterface) -> String {
    let mut body = "{\"post\":{\"operationId\":\"" + f.name + "\","
    if f.params.length == 1 {
        body = body + "\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":"
        + oaRequestSchema(f.params[0].spelling, oaTypeNames(iface)) + "}}},"
    }
    body = body + "\"responses\":{"
    body = body + "\"200\":{\"description\":\"success\",\"content\":{\"application/json\":{\"schema\":" + oaResponseSchema(f, iface) + "}}},"
    body = body + "\"422\":{\"description\":\"request validation failed\",\"content\":{\"application/json\":{\"schema\":" + oaIssuesSchema() + "}}}"
    body = body + "}}}"
    return body
}

fn oaTypeNames(iface: ModuleInterface) -> Array<String> {
    let mut out: Array<String> = []
    for t in iface.types {
        out.push(t.name.copy())
    }
    return out
}

export gen fn openapi(contract: String) -> Code {
    let iface = moduleInterface(contract)
    let mut body = vyrn"""
        let mut paths: Array<JsonField> = []

        """
    for f in iface.functions {
        body = body + vyrn"""
            paths.push(JsonField { key: \{"/rpc/" + f.name}, value: oaNode(\{oaPathValue(f, iface)}) })

            """
    }
    body = body + vyrn"""
        let mut schemas: Array<JsonField> = []

        """
    for n in oaSorted(oaTypeNames(iface)) {
        body = body + vyrn"""
            schemas.push(JsonField { key: \{n}, value: oaSchema(\{n}, jsonSchema<\{name(n)}>()) })

            """
    }
    body = body + vyrn"""
        let doc = JObj([
            JsonField { key: "openapi", value: JStr("3.1.0") },
            JsonField { key: "info", value: JObj([JsonField { key: "title", value: JStr(\{oaBaseName(contract)}) }, JsonField { key: "version", value: JStr("0.0.0") }]) },
            JsonField { key: "paths", value: JObj(paths) },
            JsonField { key: "components", value: JObj([JsonField { key: "schemas", value: JObj(schemas) }]) },
        ])
        oaDocCache = emitPretty(doc, 2)
        return oaDocCache.copy()
        """
    // The generated `oaWithId` puts `$id` first so a component's `#/$defs/..`
    // references resolve (JSON Schema 2020-12). It takes the node and rebuilds
    // every arm: a return is owned, so returning a `read` parameter would hand
    // back a borrow. The document is built once per process: it is constant,
    // and callers ask for it per HTTP request.
    return importBlock(iface, "", []) + vyrn"""

        import { Json, JsonField, copyJsonArray, emitPretty } from "std/json"
        import { parseJson } from "std/jsonread"

        fn oaNode(s: String) -> Json {
            return match parseJson(s) {
                Ok(j) => j,
                Err(e) => JObj([]),
            }
        }
        fn oaObjWithId(id: String, fs: consume Array<JsonField>) -> Json {
            let mut ordered: Array<JsonField> = []
            ordered.push(JsonField { key: "$id", value: JStr(id.copy()) })
            for f in consume fs {
                ordered.push(f)
            }
            return JObj(ordered)
        }
        fn oaWithId(id: String, j: consume Json) -> Json {
            return match j {
                JObj(fs) => oaObjWithId(id, fs),
                JNull => JNull,
                JBool(b) => JBool(b),
                JNum(n) => JNum(n.copy()),
                JStr(s) => JStr(s.copy()),
                JArr(a) => JArr(copyJsonArray(a)),
            }
        }
        fn oaSchema(id: String, schema: String) -> Json {
            return oaWithId(id, oaNode(schema))
        }
        let mut oaDocCache: String = ""
        /// The OpenAPI 3.1 document for this contract (deterministic, byte-stable).
        export fn openapiJson() -> String {
            if oaDocCache.byteLength > 0 {
                return oaDocCache.copy()
            }
            \{body}
        }

        """
}

test "oaBaseName strips the path and the .vyrn suffix" {
    assertEq(oaBaseName("./contract"), "contract")
    assertEq(oaBaseName("std/shelf.vyrn"), "shelf")
}

test "oaSorted orders names" {
    let s = oaSorted(["Book", "AddBookReq", "TagCounts"])
    assertEq(s[0], "AddBookReq")
    assertEq(s[1], "Book")
    assertEq(s[2], "TagCounts")
}

test "a request schema refs contract types and falls back inline for bare ones" {
    assertEq(oaRequestSchema("Book", ["Book"]), "{\"$ref\":\"#/components/schemas/Book\"}")
    assertEq(oaRequestSchema("Int64", ["Book"]), "{}")
    assertEq(oaRequestSchema("Book", []), "{}")
}
