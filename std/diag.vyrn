/// A generator reports a diagnostic, anchored in a file it read.
///
/// A report is `Code`: a generator returns it with the module it writes, and
/// the loader shows it like any other diagnostic. Only a report is read as one,
/// so text a generator copies cannot forge a diagnostic.
///
/// ```vyrn
/// import { report, Severity } from "std/diag"
///
/// export gen fn table(path: String) -> Code {
///     let warn = report(Warning, path, 9, 3, "column `email` has no length limit")
///     return warn + vyrn"export fn columnCount() -> Int64 { return 3 }"
/// }
/// ```
///
/// A `Warning` changes no exit code and no output byte, unless the build passes
/// `--deny-warnings`. An `Error` fails the load at the anchor. The anchor is a
/// 1-based line and column, resolved against the module that imported the
/// generator. A generator that returns a `String` writes `render(report(..))`,
/// a `//@diag` line, until the last `String` generator is gone.

import { replace } from "std/strings"

/// `Warning`: this compiled, but. `Error`: this does not compile.
export type Severity = enum { Warning, Error }

/// A report anchored in an input file, at a 1-based `line` and `col`.
export gen fn report(
    severity: Severity,
    file: String,
    line: Int64,
    col: Int64,
    message: String,
) -> Code {
    let at = "\{file}:\{atLeastOne(line).toString()}:\{atLeastOne(col).toString()}"
    return diag(word(severity), at, oneLine(message))
}

/// A report with no position, shown at the generated line it sits on: for a
/// fault in the generator's inputs as a whole, such as a missing file.
export gen fn reportHere(severity: Severity, message: String) -> Code {
    return diag(word(severity), "-", oneLine(message))
}

fn word(severity: Severity) -> String {
    return match severity {
        Warning => "warning",
        Error => "error",
    }
}

/// A newline in a message would end the directive and hand the rest to the
/// parser as source, so it becomes a space.
fn oneLine(message: String) -> String {
    return replace(replace(message, "\n", " "), "\r", " ")
}

/// A position below 1 would make the anchor unparseable and lose it, so it is
/// clamped to 1.
fn atLeastOne(n: Int64) -> Int64 {
    if n < 1 {
        return 1
    }
    return n
}

/// The line `render` writes for a report, which a test can compare.
gen fn written(severity: Severity, file: String, line: Int64, col: Int64, message: String) -> String {
    return render(report(severity, file, line, col, message))
}

test "a report is one directive line" {
    assertEq(
        written(Warning, "./users.tbl", 9, 3, "column `email` has no length limit"),
        "//@diag warning ./users.tbl:9:3 column `email` has no length limit\n",
    )
}

test "an error says error" {
    assertEq(
        written(Error, "./users.tbl", 14, 1, "column `id` is declared twice"),
        "//@diag error ./users.tbl:14:1 column `id` is declared twice\n",
    )
}

test "a message never breaks out of its line" {
    assertEq(writtenHere(Warning, "two\nlines"), "//@diag warning - two lines\n")
}

/// The line `render` writes for a report with no position.
gen fn writtenHere(severity: Severity, message: String) -> String {
    return render(reportHere(severity, message))
}

test "a zero position is clamped, not lost" {
    assertEq(written(Warning, "./a.tbl", 0, 0, "x"), "//@diag warning ./a.tbl:1:1 x\n")
}
