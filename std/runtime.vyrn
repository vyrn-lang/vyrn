/// std/runtime — the runtime in Vyrn (RFC-0125 §2.4, PLAN-0125-runtime).
///
/// The compiler links this module into every program it loads; nothing
/// imports it. It is the one module in the audience of `std/mem`, and the
/// loader declares that audience itself (PLAN-0125-runtime §3.2). A user
/// import of `std/runtime` or of `std/mem` is refused.
///
/// The families move in here one at a time, in PLAN-0125-runtime §6's order.
/// Each function keeps the byte-level semantics of the copy it replaces, and
/// the wasm emitter calls it where it used to call its own hand-emitted copy.
/// The names are the language's; the plan's names (`strlen`, `int_str`, ..)
/// are the runtime symbols they stand in for.
///
/// **Addresses.** A `String` reaches these functions as the address of its
/// bytes, an `Int32`, because the emitter's value for a `String` IS that
/// address and every consumer here scans for the NUL. Nothing outside this
/// module holds an address, which is the whole of PLAN-0125-runtime §3.3.
///
/// **Step 1, the pure strings** (PLAN-0125-runtime §6): `strLen`, `strCmp`,
/// `starts`, `intStr`, `parseI64`, `strI64`, `utf8Valid`, `lineAt`, `colAt`
/// and `regexRun`. Their C twins stay in the shim until step 3 moves the
/// native route.
///
/// **Step 2, the allocator:** `malloc` and `free`, the segregated free list
/// of PLAN-0125-runtime §4.2, over `load32`, `store32`, `memorySize`, `grow`
/// and `heapBase`. The wasm emitter's hand-emitted copy is deleted; the C
/// shim's stays until step 3 moves the native route.
///
/// **Step 4, the allocating strings:** `strNew`, `strConcat`, `strAppend`
/// and `strFromBytes`, over `malloc`, `free`, `copy` and the header loads.
/// The wasm emitter's four hand-emitted bodies are deleted; the C shim's
/// `vstr_*` and the native IR's `STRING_RUNTIME` stay until step 3 moves the
/// native route.
///
/// **Step 5, the maps:** `mapFind`, `mapPut`, `mapReindex`, `mapReserve`,
/// `mapRemoveAt` and `mapKeysCopy`, one body over the three key layouts of
/// RFC-0028 and RFC-0117, over `malloc`, `free`, `copy`, `fill` and the loads.
/// The wasm emitter's fourteen hand-emitted map functions and its inline
/// copies of reserve, remove and keys are deleted; the C shim's stay until
/// step 3 moves the native route.
///
/// **Step 6, the arrays:** `arrPush`, `arrReserve`, `arrAppend`, `arrCopyFrom`
/// and `arrClear`, the first runtime functions the array family has had in
/// any engine (PLAN-0125-runtime §1.1), over `malloc`, `free`, `copy` and the
/// header loads, told the element stride by the emitter. The wasm emitter's
/// five inline copies are deleted; `a[i]` stays at its site.
///
/// **Step 7, the I/O family:** `writeAll`, `printStr`, `getByte`, `readLineV`,
/// `openAt`, `readAll`, `readFileV`, `readFileBytesV`, `writeFileV`,
/// `writeFileBytesV`, `renameFileV`, `fsyncFileV`, `argsV`, `envGet`, `err3`,
/// `readdirBlob`, `listDirV`, the generator-host twins of the three readers,
/// and the clock and seed readers `nowMillis`, `monoNanos` and `randomSeedV`,
/// over the host imports `std/mem` declares. The wasm emitter's twenty-one
/// hand-emitted bodies are deleted; the C shim's stay until step 3 moves the
/// native route. A builtin's twin carries a `V` (`readFileV` for `readFile`),
/// as `std/text`'s `charCountV` does, because the builtin's name is reserved.
///
/// **Step 8, the regions:** `regionEnter` and `regionExit`, the bump arena of
/// PLAN-0125-runtime §4.3, which `strNew` allocates from while the emitter
/// says so. The wasm emitter's `region_keep`/`region_free`/`region_pop` and
/// their 64 frames of side vector are deleted; the native IR's
/// `REGION_RUNTIME` stays until step 3 moves the native route.
///
/// **Step 9, the traps and the printer:** `trapV`, `trapAt`, `printI64` and
/// `boolStr`, over `std/mem`'s `trap` primitive and the `writeAll` step 7 put
/// here. They are the last functions the wasm emitter hand-emitted; what
/// stays there is instruction sequences, not functions (PLAN-0125-runtime §6,
/// step 9's results).
///
/// **Call depth.** The emitter does not count these frames against the
/// language's call-depth budget: the hand-emitted copies had no prologue, and
/// a program that traps at the limit must trap where it did.
///
/// **Traps.** A `panic` in this module prints the trap table's line and no
/// site: the loader does not stamp this module's `panic` sites, because a
/// runtime trap is one of `trap.rs`'s fixed wordings and every engine prints
/// it the same way.

import {
    load8, load32, load64, store8, store32, store64, copy, fill, memorySize, grow, heapBase, trap,
    fdWrite, fdRead, fdClose, pathOpen, pathRename, fdSync, fdPrestatGet, argsSizesGet, argsGet,
    environSizesGet, environGet, clockTimeGet, randomGet, fdReaddir, genRead, genFetch,
} from "std/mem"

/// `strlen`: the bytes before the NUL at `p`.
export fn strLen(p: Int32) -> Int32 {
    let mut q = p
    while load8(q) != 0 {
        q = q + 1
    }
    return q - p
}

/// `strcmp`: byte order, unsigned, which is what a `String` comparison is
/// (RFC-0022) since a `String` is UTF-8 bytes. Negative, zero or positive.
export fn strCmp(a: Int32, b: Int32) -> Int32 {
    let mut p = a
    let mut q = b
    while true {
        let ca = load8(p)
        let cb = load8(q)
        if ca != cb {
            return Int32(ca) - Int32(cb)
        }
        if ca == 0 {
            return 0
        }
        p = p + 1
        q = q + 1
    }
    return 0
}

/// `starts`: whether NUL-terminated `a` begins with NUL-terminated `b`.
export fn starts(a: Int32, b: Int32) -> Bool {
    let mut p = a
    let mut q = b
    while true {
        let c = load8(q)
        if c == 0 {
            return true
        }
        if load8(p) != c {
            return false
        }
        p = p + 1
        q = q + 1
    }
    return true
}

/// `int_str`: the decimal digits of `v`, read as two's complement when
/// `signed` and as a `UInt64` otherwise. The result is a fresh `String` the
/// caller owns, which is what `@str` promises (`own.rs`, `DropKind::FreeStr`).
///
/// The magnitude is taken in `UInt64`, where `0 - u` of `Int64.min` is
/// exactly 2^63: the same unsigned digit loop the hand-emitted copy ran.
export fn intStr(v: Int64, signed: Bool) -> String {
    let mut u: UInt64 = UInt64(v)
    let neg = signed && v < 0
    if neg {
        u = 0 - u
    }
    let mut w: Array<UInt8> = []
    while true {
        w.push(UInt8(u % 10) + 48)
        u = u / 10
        if u == 0 {
            break
        }
    }
    if neg {
        w.push('-')
    }
    let n = w.length
    let mut i = 0
    while i < n / 2 {
        let t = w[i]
        w[i] = w[n - 1 - i]
        w[n - 1 - i] = t
        i = i + 1
    }
    return match stringFromBytes(w) {
        Ok(s) => s,
        Err(e) => panic("intStr: the bytes it builds are ASCII digits and a sign"),
    }
}

/// `parse_i64`: RFC-0014's `parse`. An optional `-`, then digits, ALL of them
/// consumed; anything else is `None`. There is no overflow case on purpose:
/// `acc * 10 + d` wraps, so `"9223372036854775808"` is `Int64.min` on every
/// engine (`examples/numbytes.vyrn` pins the table).
///
/// Not `strI64` below, which reads `+` and stops at the first byte that is
/// not a digit — that is `strtoll`'s contract for an injected value.
export fn parseI64(s: Int32) -> Option<Int64> {
    let mut p = s
    let mut neg = false
    if load8(p) == '-' {
        neg = true
        p = p + 1
    }
    if load8(p) == 0 {
        return None
    }
    let mut acc: Int64 = 0
    while true {
        let c = load8(p)
        if c == 0 {
            break
        }
        if c < '0' || c > '9' {
            return None
        }
        acc = acc * 10 + Int64(c) - 48
        p = p + 1
    }
    if neg {
        acc = 0 - acc
    }
    return Some(acc)
}

/// `str_i64`: `strtoll(p, 0, 10)` for everything an injected value can be —
/// an optional sign, then decimal digits, stopping at the first byte that is
/// not one. No whitespace skip and no clamp: the only callers are
/// `VYRN_FIXED_TIME` and `VYRN_FIXED_SEED`, which the harness writes as bare
/// decimals.
export fn strI64(p: Int32) -> Int64 {
    let mut q = p
    let mut neg = false
    let c0 = load8(q)
    if c0 == '-' {
        neg = true
        q = q + 1
    } else if c0 == '+' {
        q = q + 1
    }
    let mut v: Int64 = 0
    while true {
        let c = load8(q)
        if c < '0' || c > '9' {
            break
        }
        v = v * 10 + Int64(c) - 48
        q = q + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

/// `utf8valid`: whether the `len` bytes at `s` are valid UTF-8, by Björn
/// Höhrmann's DFA over `table` — the one table both compiled backends emit
/// (`utf8d_table`): 256 byte classes, then 9 states × 12 classes of
/// transitions. State 0 accepts, 12 rejects, and every rejecting transition
/// stays at 12, so the loop never needs an early exit. Rust's `from_utf8`
/// accepts exactly the same strings.
///
/// The ASCII prefix goes eight bytes at a time (RFC-0125 §1.5b): a word with
/// no high bit is eight steps the DFA would take from state 0 to state 0.
export fn utf8Valid(s: Int32, len: Int32, table: Int32) -> Bool {
    let hi: UInt64 = 9259542123273814144 // 0x8080808080808080
    let mut i: Int32 = 0
    while len - i >= 8 {
        if (load64(s + i) & hi) != 0 {
            break
        }
        i = i + 8
    }
    let mut st: Int32 = 0
    while i < len {
        let cls = Int32(load8(table + Int32(load8(s + i))))
        st = Int32(load8(table + 256 + st + cls))
        i = i + 1
    }
    return st == 0
}

/// `line_at`: the 1-based line of byte offset `off` in the `len` bytes at
/// `d`. `off` is clamped to `len` and not below zero: a negative `off` never
/// enters the loop, which is line 1, the interpreter's `.max(0)`.
export fn lineAt(d: Int32, len: Int64, off: Int64) -> Int64 {
    let mut o = off
    if o > len {
        o = len
    }
    let mut out: Int64 = 1
    let mut i: Int64 = 0
    while i < o {
        if load8(d + Int32(i)) == '\n' {
            out = out + 1
        }
        i = i + 1
    }
    return out
}

/// `col_at`: the 1-based column of byte offset `off`, and a column counts
/// BYTES (RFC-0078 M4b(2)): the `x` in `éx` is column 3. `off` is the cursor,
/// walked down to the byte after the previous LF.
export fn colAt(d: Int32, len: Int64, off: Int64) -> Int64 {
    let mut o = off
    if o > len {
        o = len
    }
    let mut out: Int64 = 1
    while o > 0 {
        if load8(d + Int32(o) - 1) == '\n' {
            break
        }
        out = out + 1
        o = o - 1
    }
    return out
}

/// `regex_run`: whether the NUL-terminated bytes at `s` match the DFA
/// `=~` compiled (RFC-0046). Every state has all 256 transitions and a dead
/// state absorbs a non-match, so the walk has no conditional but the end of
/// the string: a full match is "the state the last byte left us in accepts".
/// `table` is `states × 256` four-byte entries, `accept` one byte per state.
///
/// The byte is read unsigned: a signed read would turn a UTF-8 continuation
/// byte into a negative index and answer wrongly rather than trap.
export fn regexRun(s: Int32, table: Int32, start: Int32, accept: Int32) -> Bool {
    let mut p = s
    let mut st = start
    while true {
        let ch = Int32(load8(p))
        if ch == 0 {
            break
        }
        st = Int32(load32(table + (st << 10) + (ch << 2)))
        p = p + 1
    }
    return load8(accept + st) != 0
}

// ---------------------------------------------------------------------------
// Step 2, the allocator (PLAN-0125-runtime §4.2)
// ---------------------------------------------------------------------------
//
// A segregated free list, four classes per power of two. A request rounds up
// to eight and floors at eight; with `t = size - 1`, `shift = floorLog2(t) - 2`
// and `sub` the two bits under `t`'s leading one, the class is
// `shift * 4 + sub` and its size `(sub + 5) << shift`. Classes 3 to 115 are in
// use: 8 bytes to 2 GiB, every size a multiple of eight, and the round-up is
// at most 25 percent. Every block carries an eight-byte header whose first
// word is the class (§4.2 decision 3: `free` needs the class and nothing needs
// the size). The second header word is never written and reads as zero.
//
// The heap's first 480 bytes are the allocator's own: one head per class,
// 116 words, then the bump offset at 464, then the arena's three words at
// 468, 472 and 476 (step 8 below). The I/O family's cells follow at 480
// (step 7, the table above its section), then step 9's digit cell at 8736,
// and the first block starts sixteen-aligned at 8768. All of it starts at
// zero, which is what an empty list, an empty heap, an empty buffer and a
// closed arena are, so nothing initializes it: the emitter's `HEAP` global
// and its reserved tables are gone with the hand-emitted runtime. A freed
// block's list link lives in its payload; the eight-byte floor is what makes
// room for it.
//
// `malloc` pops the class's head if there is one, else bumps and grows memory
// by exactly the pages the new top needs. `free` refuses, silently, a pointer
// below `heapBase()` (`drop` on a `String` bound to a literal hands over a
// data-segment address, and null is the `SmallArray` that never spilled) and
// a header outside the class range (memory this allocator did not write).
// Both leak rather than corrupt, which is what the copy it replaces did.
//
// THE OWNERSHIP TEST, stated once: the header's class word says which
// allocator owns a block. A block this list handed out carries a class of 3 to
// 115; a block the arena of step 8 handed out carries 0. So `free` of an arena
// block takes the class-out-of-range refusal already written below and does
// nothing, and the region's closing brace is the only thing that reclaims it
// (PLAN-0125-runtime §4.3).
//
// The request is an `Int64` because every interesting caller computes
// `count * stride` out of a Vyrn length, which IS an `Int64`, and `push`
// doubling a 2 GiB buffer once wrapped that product at an `i32` call site
// (`tests/parity.rs`, `a_malloc_whose_bump_pointer_would_wrap_traps_instead_of_lying`).
// The width check comes before the rounding for the same reason: `n + 7` is
// the cast.

/// `malloc`: `n` bytes, eight-aligned, from the class's free list or the bump
/// region. Traps with the `out of memory` line every engine prints when the
/// request cannot fit a wasm32 memory or `grow` refuses.
export fn malloc(n: Int64) -> Int32 {
    if UInt64(n) > 2147483648 {
        panic("out of memory")
    }
    let mut t = Int32((n + 7) & -8)
    if t < 8 {
        t = 8
    }
    t = t - 1
    // `shift = floorLog2(t) - 2`; `t >= 7`, so `u >= 1` and the loop runs
    // `shift` times, which is 0 or 1 for a block under 32 bytes.
    let mut shift: Int32 = 0
    let mut u = t >> 2
    while u > 1 {
        u = u >> 1
        shift = shift + 1
    }
    let sub = (t >> shift) & 3
    let cls = (shift << 2) + sub
    let size = (sub + 5) << shift
    let base = heapBase()
    let h = base + (cls << 2)
    let head = Int32(load32(h))
    if head != 0 {
        store32(h, load32(head))
        return head
    }
    let p = base + 8768 + Int32(load32(base + 464))
    // In 64 bits so the sum cannot wrap: a top past 4 GiB is a request no
    // wasm32 memory can serve, reported in `grow`'s words.
    let end = Int64(UInt32(p)) + Int64(size) + 8
    if end > 4294967295 {
        panic("out of memory")
    }
    let need = Int32((end + 65535) >> 16) - memorySize()
    if need > 0 {
        if grow(need) == -1 {
            panic("out of memory")
        }
    }
    store32(base + 464, UInt32(end - Int64(base) - 8768))
    store32(p, UInt32(cls))
    return p + 8
}

/// `free`: push `p`'s block on its class's list. See the refusals above.
export fn free(p: Int32) {
    let base = heapBase()
    if UInt32(p) < UInt32(base) {
        return
    }
    let cls = Int32(load32(p - 8))
    if cls < 3 || cls > 115 {
        return
    }
    let h = base + (cls << 2)
    store32(p, load32(h))
    store32(h, UInt32(p))
}

// ---------------------------------------------------------------------------
// Step 8, the region arena (PLAN-0125-runtime §4.3; RFC-0004 §4)
// ---------------------------------------------------------------------------
//
// `region { .. }` was a side vector of block pointers freed one at a time. It
// is a bump arena now: an allocation inside a region is a pointer add, and the
// closing brace gives every one of them back at once.
//
// The arena's three words sit in the allocator's own head bytes, after the
// bump offset at 464 and before the I/O family's cells at 480:
//
//   468  the chunk being bumped, 0 when the arena has none
//   472  the next free byte in that chunk
//   476  the routing flag: nonzero while the emitter has routed a `String`
//        in here. `strNew` reads it; `malloc` does not, so a program with no
//        region pays nothing at all
//
// A chunk is one ordinary `malloc` block: `next` (the older chunk) at 0, the
// end address at 4, and the region's blocks from 8. Blocks are bumped inside
// it; a chunk that cannot fit the request is followed by a new one, at least
// 4 KiB or as large as the request needs.
//
// ROUTING IS LEXICAL, and this flag is how the emitter says so. The emitter
// raises it around exactly the allocating calls it already marked as the
// arena's (`Fn_::arena_route` in `direct.rs`, whose site table is the rule),
// and lowers it again; `strNew`, the funnel every `String` block comes
// through, is what reads it. Everything else allocated while a region is open
// — an `Array` buffer, a `Map`, a callee's own `String` — is the free list's,
// is freed by the ownership walk, and outlives the region if its binding does.
// Reading the routing off an open region instead would put those blocks in the
// arena, and `examples/regionescape.vyrn`'s callee route and a global
// `Array` grown inside a region would both dangle at the brace: the checker
// permits them because `contains_heap` says an `Array` buffer is never the
// arena's (`checker.rs`).
//
// `regionEnter` answers the bump top; `regionExit` puts it back and frees the
// chunks the region added. Two rules keep the pointers honest:
//
//   1. A block the arena hands out carries a class word of 0, so `free` of one
//      is the silent refusal above. That is the whole of the ownership test.
//   2. A `return` out of a region carries a block out with it, so the emitter
//      does NOT call `regionExit` on that edge — the bump stays where it is and
//      the region's blocks live on, which is what the side vector's own pop
//      path chose (`__vyrn_region_pop`) for the same reason.
//
// The oldest chunk is never freed while it is a standard 4 KiB one. A
// `region` inside a loop then asks the allocator nothing after its first turn,
// which is the flat line the extra gate of PLAN-0125-runtime §6 step 8
// measures. The cost is one retained 4 KiB chunk; an oversized chunk goes back
// with the rest.

/// The bump inside the open region's chunks. `strNew` routes here while the
/// flag at 476 is up; the chunk it needs when it is full is an ordinary
/// `malloc` block, which the flag does not touch.
fn arenaAlloc(n: Int64, base: Int32) -> Int32 {
    if UInt64(n) > 2147483648 {
        panic("out of memory")
    }
    let size = Int32((n + 7) & -8) + 8
    let mut c = Int32(load32(base + 468))
    let mut cur = Int32(load32(base + 472))
    // In 64 bits, because a chunk near the top of a wasm32 memory would wrap
    // the sum — the reason `malloc`'s own bump is judged in 64 bits.
    let full = c == 0 || Int64(UInt32(cur)) + Int64(size) > Int64(load32(c + 4))
    if full {
        let mut body = size
        if body < 4096 {
            body = 4096
        }
        let nc = malloc(Int64(body) + 8)
        store32(nc, UInt32(c))
        store32(nc + 4, UInt32(nc + 8 + body))
        store32(base + 468, UInt32(nc))
        c = nc
        cur = nc + 8
    }
    // Class 0: the ownership test above, written at the one place that mints
    // an arena block.
    store32(cur, 0)
    store32(base + 472, UInt32(cur + size))
    return cur + 8
}

/// `region_enter`'s arena half: the bump top, which `regionExit` puts back.
/// The nesting depth and its `region nesting exceeds 64` trap stay with the
/// emitter, because a program that traps at the limit must trap where it did.
export fn regionEnter() -> Int32 {
    return Int32(load32(heapBase() + 472))
}

/// `region_exit`: give back everything bumped since `mark`. The chunks the
/// region added are freed, down to the one `mark` points into or to the
/// oldest, whichever comes first.
export fn regionExit(mark: Int32) {
    let base = heapBase()
    let mut c = Int32(load32(base + 468))
    while c != 0 {
        let holds = UInt32(mark) >= UInt32(c + 8) && UInt32(mark) <= UInt32(load32(c + 4))
        if holds {
            break
        }
        let next = Int32(load32(c))
        // The oldest chunk stays, so a `region` in a loop asks the allocator
        // nothing after its first turn — but only at the standard size, or a
        // program whose first arena request was 100 MB would hold 100 MB for
        // the rest of its life.
        if next == 0 && Int32(load32(c + 4)) - c - 8 == 4096 {
            break
        }
        free(c)
        c = next
    }
    store32(base + 468, UInt32(c))
    // `mark` is below the chunk that is left when the region opened on an
    // empty arena: the whole of the retained chunk is free again.
    let mut cur = mark
    if c != 0 && UInt32(cur) < UInt32(c + 8) {
        cur = c + 8
    }
    store32(base + 472, UInt32(cur))
}

// ---------------------------------------------------------------------------
// Step 4, the allocating strings (PLAN-0125-runtime §6)
// ---------------------------------------------------------------------------
//
// A `String` is the address of its bytes, and the eight bytes in front of them
// are its `{ len, cap }` header (RFC-0089 M1a): `len` at -8, `cap` at -4, both
// 32-bit, and a NUL at `len`. A `cap` of all ones marks a data-segment literal,
// which `free` refuses by address anyway. Every String an engine allocates
// comes through `strNew`, which is what makes the header a fact rather than a
// hope. Lengths are `Int32` because they are offsets into a wasm32 memory.

/// `str_new`: one block holding the header, `cap` bytes of room and the NUL;
/// the address of the bytes. `malloc` judges the size, so the one 64-bit
/// length in the module (a host-named file size) is judged here too.
export fn strNew(len: Int32, cap: Int32) -> Int32 {
    // Step 8: every `String` block an engine allocates comes through here, so
    // this is the one place the region arena has to be routed to, and `malloc`
    // pays nothing for it. See the arena's comment above.
    let heap = heapBase()
    let mut base: Int32 = 0
    if load32(heap + 476) != 0 {
        base = arenaAlloc(Int64(cap) + 9, heap)
    } else {
        base = malloc(Int64(cap) + 9)
    }
    store32(base, UInt32(len))
    store32(base + 4, UInt32(cap))
    let p = base + 8
    store8(p + len, 0)
    return p
}

/// `concat`: `a + b` as a fresh String sized exactly. Both lengths are header
/// loads; the second copy carries `b`'s NUL.
export fn strConcat(a: Int32, b: Int32) -> Int32 {
    let la = Int32(load32(a - 8))
    let lb = Int32(load32(b - 8))
    let r = strNew(la + lb, la + lb)
    copy(r, a, la)
    copy(r + la, b, lb + 1)
    return r
}

/// `str_append`: append `v` to the accumulator `p` in place and return the
/// (possibly new) pointer, since a wasm local has no address to write through
/// (RFC-0081). `own` addresses one word in the caller's frame: did this path
/// allocate the buffer `p` holds? Not ours: copy into a buffer that is, 32
/// bytes at least, the textual backend's floor. Ours: grow by doubling when
/// `len + vlen` passes `cap`, so N appends copy O(N) bytes in total. The grow
/// is `strNew`, `copy` and `free`, not a realloc: this allocator has no
/// in-place extend, and a doubling always leaves its size class (four classes
/// per power of two), so PLAN-0125-runtime §8's class-aware realloc would
/// never hit on this path. Only the grow branch frees; the other branch copied
/// a pointer that was never ours.
///
/// THE FLAG IS ADVISORY; THE HEADER DECIDES. A caller sets `own` from the
/// accumulator's DECLARATION — a `let` whose initializer the plan says it owns
/// starts at 1 — and a call that transfers a `String` may still hand back a
/// data-segment literal (`fn empty() -> String { return "" }`). So an all-ones
/// capacity, RFC-0089 M1a's word for static, takes the copy branch whatever the
/// flag says. Without it the append grew a literal in place: it wrote over the
/// next literal's header in the string pool, and the length that header then
/// carried sent the next concatenation reading megabytes out of the data
/// segment.
export fn strAppend(own: Int32, p: Int32, v: Int32) -> Int32 {
    let vlen = Int32(load32(v - 8))
    let len = Int32(load32(p - 8))
    let mut q = p
    let mut cap: Int32 = 0
    if Int32(load32(own)) == 0 || Int32(load32(p - 4)) == -1 {
        cap = len + vlen
        if UInt32(cap) < 32 {
            cap = 32
        }
        q = strNew(len, cap)
        copy(q, p, len)
        store32(own, 1)
    } else {
        cap = Int32(load32(p - 4))
    }
    let need = len + vlen
    if UInt32(need) > UInt32(cap) {
        let mut nc = cap << 1
        if UInt32(nc) < UInt32(need) {
            nc = need
        }
        let nb = strNew(len, nc)
        copy(nb, q, len)
        free(q - 8)
        q = nb
    }
    // The operand's bytes AND its NUL over the old terminator, then the new
    // length in the header.
    copy(q + len, v, vlen + 1)
    store32(q - 8, UInt32(need))
    return q
}

/// `str_from_bytes`: the BUILD half of RFC-0014's `stringFromBytes`. The `len`
/// bytes at `data` copied into a fresh String, or one of two canonical messages
/// parity compares. The messages are `bnul` and `butf8`, interned by the emitter
/// from `io_message`, so the wording stays one table; an `Err` is that address,
/// not a heap copy, and nothing ever frees it. The payloads are addresses as
/// `Int64`, which is the `Result<String, String>` shape the caller reads (tag,
/// one word, zero).
///
/// **It decides nothing.** RFC-0125 §3 M6 (the third judgment's fifth slice)
/// made the CHECK one Vyrn function every engine calls — `std/text`'s
/// `stringFault`, which reads the bytes and answers 0, 1 for an embedded NUL or
/// 2 for bytes that are not UTF-8. The emitter runs it before this call and
/// hands the answer in as `fault`, so the NUL scan and the DFA walk that stood
/// here are gone and no buffer is built to be freed on a failure. `utf8Valid`
/// stays for the FILE readers below, whose bytes are a slurped buffer and never
/// an `Array<UInt8>`.
export fn strFromBytes(data: Int32, len: Int32, fault: Int32, bnul: Int32, butf8: Int32) -> Result<Int64, Int64> {
    if fault == 1 {
        return Err(Int64(UInt32(bnul)))
    }
    if fault == 2 {
        return Err(Int64(UInt32(butf8)))
    }
    let buf = strNew(len, len)
    copy(buf, data, len)
    return Ok(Int64(UInt32(buf)))
}

// ---------------------------------------------------------------------------
// Step 5, the maps (PLAN-0125-runtime §6; RFC-0028, RFC-0116, RFC-0117)
// ---------------------------------------------------------------------------
//
// A `Map` header is `{ keys, vals, len, cap, idx }`: two buffer addresses at
// 0 and 4, two `Int64` counts at 8 and 16, the index at 24. `keys` and `vals`
// are columns in insertion order, which is the order RFC-0028 locks; `idx` is
// `cap * 2` buckets of `Int64`, each an entry's position PLUS ONE so that zero
// is the empty bucket, and `len <= cap` keeps it at most half full, so a probe
// always reaches an empty bucket and the walk needs no bound of its own. The
// index never reorders the columns; a grow or a remove rebuilds it.
//
// One body serves every key layout. `kind` names the layout and `klen` is the
// byte count the layout needs; the key travels as an `Int64`, the value itself
// for an `Int64` key and an address for the rest, so one signature carries all
// of them and the emitter spills nothing:
//
//   0  String       a 4-byte pointer column; FNV-1a to the NUL; `strCmp`
//   1  Int64        an 8-byte value column; SplitMix64's finalizer; the bits
//   2  pack         `klen` canonical bytes inline (RFC-0117 M2); FNV-1a over
//                   them; a byte compare, which IS field-wise equality because
//                   the emitter zeroed the padding before packing
//   3  byte window  `tallyBytes`'s probe (RFC-0116) against a String column:
//                   FNV-1a over the `klen` bytes at the key, which is the hash
//                   of the equal String since a stored key has no interior NUL;
//                   equal when the stored key's `klen` bytes match and its byte
//                   `klen` is the NUL. Never stored, so never put or copied.
//
// The three hashes are the C shim's (`map_hash`, `map_hash_i64`,
// `map_hash_pack`) and are not observable: the columns decide every order the
// program can see. `std/hash`'s `fnv1a` is the same arithmetic over an
// `Array<UInt8>` value; this module reads bytes at an address and has no
// array to hand it, so the two stay two (PLAN-0125-runtime §8 question 5).
//
// The layout choice is one compare per hash and one per key compare, on a
// value the emitter passes as a constant. Three entry points per function,
// one per layout, would carry the probe loop three times in every map program
// to save a predicted branch; k-nucleotide is flat across the move (§6, the
// results block), so the branch stays.

/// The bucket hash of a byte key: FNV-1a over the `n` bytes at `p`, or to
/// the NUL when `n` is negative (a String key, hashed in the one pass
/// `strCmp` decides equality by).
fn mapHash(p: Int32, n: Int32) -> UInt64 {
    let mut h: UInt64 = 14695981039346656037 // 0xCBF29CE484222325
    let mut i: Int32 = 0
    while true {
        let c = load8(p + i)
        if i == n || (n < 0 && c == 0) {
            break
        }
        h = (h ^ UInt64(c)) * 1099511628211
        i = i + 1
    }
    return h
}

/// The bytes one entry of the key column takes.
fn mapKeyStride(kind: Int32, klen: Int32) -> Int32 {
    if kind == 1 {
        return 8
    }
    if kind == 2 {
        return klen
    }
    return 4
}

/// Whether the `n` bytes at `a` equal the `n` bytes at `b`.
fn mapBytesEq(a: Int32, b: Int32, n: Int32) -> Bool {
    let mut i: Int32 = 0
    while i < n {
        if load8(a + i) != load8(b + i) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether entry `i`'s key equals `key` under a byte layout (0, 2 or 3).
fn mapKeyEq(kind: Int32, klen: Int32, keys: Int32, i: Int32, key: Int64) -> Bool {
    if kind == 2 {
        return mapBytesEq(keys + i * klen, Int32(key), klen)
    }
    let stored = Int32(load32(keys + i * 4))
    if kind == 0 {
        return strCmp(stored, Int32(key)) == 0
    }
    return mapBytesEq(stored, Int32(key), klen) && load8(stored + klen) == 0
}

/// `map_slot`: the bucket `key` belongs in — the one that holds it, or the
/// first empty one after where it hashes. One probe serves both readers: a
/// lookup asks whether the bucket is occupied, an insert writes into it.
/// `nb` is a power of two, so the wrap is a mask.
///
/// Two lanes, and the two callers choose between them by `kind` themselves
/// rather than through a third function: a call is about four nanoseconds
/// under wasmtime and k-nucleotide makes fourteen million probes, so one
/// level more than the hand-emitted copy's two (find, then slot) was the
/// whole of a 20 percent regression, and the lane in one larger body was
/// the same 20 percent (PLAN-0125-runtime §7.3 predicted flat; §6 step 5's
/// results block has the numbers). The `Int64` lane hashes with SplitMix64's
/// finalizer and compares the bits in place; the byte lane hashes with FNV-1a
/// and compares through `mapKeyEq`, as the copy it replaces called `strCmp`.
fn mapSlotI64(keys: Int32, idx: Int32, nb: Int32, key: Int64) -> Int32 {
    let mask = nb - 1
    let m1: UInt64 = 13787848793156543929 // 0xBF58476D1CE4E5B9
    let m2: UInt64 = 10723151780598845931 // 0x94D049BB133111EB
    let mut h: UInt64 = UInt64(key)
    h = (h ^ (h >> 30)) * m1
    h = (h ^ (h >> 27)) * m2
    let mut s = Int32(h ^ (h >> 31)) & mask
    while true {
        let ent = Int32(load64(idx + s * 8))
        if ent == 0 || Int64(load64(keys + (ent - 1) * 8)) == key {
            return s
        }
        s = (s + 1) & mask
    }
    return s
}

fn mapSlotBytes(kind: Int32, klen: Int32, keys: Int32, idx: Int32, nb: Int32, key: Int64) -> Int32 {
    let mask = nb - 1
    let mut n = klen
    if kind == 0 {
        n = -1
    }
    let mut s = Int32(mapHash(Int32(key), n)) & mask
    while true {
        let ent = Int32(load64(idx + s * 8))
        if ent == 0 {
            return s
        }
        if mapKeyEq(kind, klen, keys, ent - 1, key) {
            return s
        }
        s = (s + 1) & mask
    }
    return s
}

/// `map_find`: the entry's position, or -1. An empty map has no index yet and
/// a map with a `cap` has one: `mapReserve` keeps that pair, so a null `idx`
/// under a non-zero `cap` is a defect here, not a case.
export fn mapFind(kind: Int32, klen: Int32, keys: Int32, len: Int32, key: Int64, idx: Int32, cap: Int32) -> Int32 {
    if len <= 0 || cap <= 0 {
        return -1
    }
    let mut s: Int32 = 0
    if kind == 1 {
        s = mapSlotI64(keys, idx, cap * 2, key)
    } else {
        s = mapSlotBytes(kind, klen, keys, idx, cap * 2, key)
    }
    // The bucket holds position plus one, so an empty one answers -1.
    return Int32(load64(idx + s * 8)) - 1
}

/// `map_put`: record the entry at position `i`, whose key is already in the
/// column. The probe is `mapSlot`'s; this is the write.
export fn mapPut(kind: Int32, klen: Int32, keys: Int32, idx: Int32, nb: Int32, i: Int32) {
    // Entry `i`'s key as it travels: the value for an `Int64` key, the
    // pointer for a String, the address of the pack.
    let mut key: Int64 = 0
    if kind == 1 {
        key = Int64(load64(keys + i * 8))
    } else if kind == 2 {
        key = Int64(UInt32(keys + i * klen))
    } else {
        key = Int64(load32(keys + i * 4))
    }
    let mut s: Int32 = 0
    if kind == 1 {
        s = mapSlotI64(keys, idx, nb, key)
    } else {
        s = mapSlotBytes(kind, klen, keys, idx, nb, key)
    }
    store64(idx + s * 8, UInt64(Int64(i) + 1))
}

/// `map_reindex`: rebuild the whole index from the columns. Called where
/// positions move — a grow (the bucket count changed) and a remove (the
/// survivors shifted down) — both already O(len) for their own reasons.
export fn mapReindex(kind: Int32, klen: Int32, keys: Int32, len: Int32, idx: Int32, nb: Int32) {
    if nb <= 0 {
        return
    }
    fill(idx, 0, nb * 8)
    let mut i: Int32 = 0
    while i < len {
        mapPut(kind, klen, keys, idx, nb, i)
        i = i + 1
    }
}

/// `map_reserve`: room for one more entry in the map at `hdr`, whose values
/// are `esz` bytes each: 0 to 4, else double, growing BOTH columns. Allocate,
/// copy, free the old — the shape `push` grows in. The index last, because
/// its bucket count follows the capacity just stored, and rebuilt rather than
/// copied: the buckets are keyed by `hash & (nb - 1)` and `nb` just doubled.
/// The emitter asks `len + 1 > cap` before calling, so an insert that fits
/// pays no call; the check here is the function's own contract.
export fn mapReserve(kind: Int32, klen: Int32, hdr: Int32, esz: Int32) {
    let len = Int32(load64(hdr + 8))
    let cap = Int32(load64(hdr + 16))
    if len + 1 <= cap {
        return
    }
    let mut nc: Int32 = 4
    if cap != 0 {
        nc = cap * 2
    }
    let ks = mapKeyStride(kind, klen)
    // `nc * stride` in 64 bits: an entry costs at least twelve bytes, so the
    // count fits 32 bits and the product may not; `malloc` judges it.
    let nk = malloc(Int64(nc) * Int64(ks))
    let ok = Int32(load32(hdr))
    copy(nk, ok, len * ks)
    free(ok)
    store32(hdr, UInt32(nk))
    let nv = malloc(Int64(nc) * Int64(esz))
    let ov = Int32(load32(hdr + 4))
    copy(nv, ov, len * esz)
    free(ov)
    store32(hdr + 4, UInt32(nv))
    store64(hdr + 16, UInt64(Int64(nc)))
    let ni = malloc(Int64(nc) * 16)
    free(Int32(load32(hdr + 24)))
    store32(hdr + 24, UInt32(ni))
    mapReindex(kind, klen, nk, len, ni, nc * 2)
}

/// `map_remove_at`: close the hole at position `i` by shifting the survivors
/// down one slot in both columns, so first-insertion order survives a
/// removal, then rebuild the index, since every survivor after the hole moved.
/// The entry's key and value are the emitter's to release before this runs:
/// this function shifts bytes and is handed no types.
export fn mapRemoveAt(kind: Int32, klen: Int32, hdr: Int32, esz: Int32, i: Int32) {
    let len = Int32(load64(hdr + 8))
    let rest = len - i - 1
    let ks = mapKeyStride(kind, klen)
    let kb = Int32(load32(hdr)) + i * ks
    copy(kb, kb + ks, rest * ks)
    let vb = Int32(load32(hdr + 4)) + i * esz
    copy(vb, vb + esz, rest * esz)
    store64(hdr + 8, UInt64(Int64(len - 1)))
    mapReindex(kind, klen, Int32(load32(hdr)), len - 1, Int32(load32(hdr + 24)), Int32(load64(hdr + 16)) * 2)
}

/// `map_keys_copy`: the key column copied into a buffer of its own, so the map
/// may be mutated afterwards without disturbing the snapshot. An empty map
/// still gets a buffer, so an `Array`'s pointer is never null. String keys are
/// then dup'd per element by the emitter (RFC-0092 M2), which knows the type.
export fn mapKeysCopy(kind: Int32, klen: Int32, hdr: Int32) -> Int32 {
    let len = Int32(load64(hdr + 8))
    let ks = mapKeyStride(kind, klen)
    let buf = malloc(Int64(UInt32((len + 1) * ks)))
    copy(buf, Int32(load32(hdr)), len * ks)
    return buf
}

// ---------------------------------------------------------------------------
// Step 6, the arrays (PLAN-0125-runtime §6)
// ---------------------------------------------------------------------------
//
// An `Array<T>` is a 24-byte triple, `{ data, len, cap }`: the buffer's
// address at 0, the two counts at 8 and 16 as `Int64`. The element type never
// reaches this module. The emitter passes the element STRIDE, its size rounded
// to its alignment, the way the maps are passed a layout, and an element is
// `stride` bytes at `data + i * stride`; the checker holds `append` and
// `copyFrom` to heapless element types (RFC-0115), so bytes are the elements
// and one `copy` moves any number of them. Alignment is not passed: `malloc`
// returns eight-aligned blocks and no element aligns coarser.
//
// Every function here reads the triple at `src` and writes the rebuilt triple
// at `dst`, never through `src`: `xs.push(v)` is `xs = @push(xs, v)` and the
// write-back is the assignment, so a `push` yields a NEW value (the emitter's
// rule since RFC-0011). `dst` and `src` may be one address; each function
// reads all of `src` before it stores.
//
// The growth is `malloc`, `copy`, `free`, the shape the hand-emitted copies
// grew in and what `realloc` does for the native route (M6). `push` doubles,
// from four; `append` grows to the larger of the doubled capacity and the
// need; `reserve` and `copyFrom` grow to exactly the need, since a caller
// that reserves has said how many it wants. Products are taken in 64 bits and
// `malloc` judges them: doubling a 2 GiB buffer traps with `out of memory`
// rather than wrapping (`tests/parity.rs`). The bounds check of `a[i]` is not
// here: the results block of step 6 records why it stays at the site.

/// `push`, all but the element: room for one more, the triple at `dst` with
/// `len + 1`, and the buffer that the growth left behind, or 0 when nothing
/// grew. The emitter stores the element at `data + len * stride` and releases
/// that buffer AFTER the store, because the value expression may read the
/// array through the caller's header, which still names the old buffer
/// (`std/hash` reads `w[t - 3]` inside `w.push(..)`; freed first, SHA-1 came
/// out wrong from the seventeenth word).
export fn arrPush(dst: Int32, src: Int32, stride: Int32) -> Int32 {
    let mut data = Int32(load32(src))
    let len = Int64(load64(src + 8))
    let mut cap = Int64(load64(src + 16))
    let mut stale: Int32 = 0
    if len == cap {
        if cap == 0 {
            cap = 4
        } else {
            cap = cap * 2
        }
        let grown = malloc(cap * Int64(stride))
        copy(grown, data, Int32(len) * stride)
        stale = data
        data = grown
    }
    store32(dst, UInt32(data))
    store64(dst + 8, UInt64(len + 1))
    store64(dst + 16, UInt64(cap))
    return stale
}

/// `reserve` (RFC-0115): room for `n` more elements, grown once to exactly
/// `len + n` when the capacity is short.
export fn arrReserve(dst: Int32, src: Int32, stride: Int32, n: Int64) {
    let mut data = Int32(load32(src))
    let len = Int64(load64(src + 8))
    let mut cap = Int64(load64(src + 16))
    let need = len + n
    if need > cap {
        let grown = malloc(need * Int64(stride))
        copy(grown, data, Int32(len) * stride)
        free(data)
        data = grown
        cap = need
    }
    store32(dst, UInt32(data))
    store64(dst + 8, UInt64(len))
    store64(dst + 16, UInt64(cap))
}

/// `append` (RFC-0115): the elements of the array at `xs` copied on after the
/// receiver's, in order; one growth to the larger of `cap * 2` and the need.
/// A self-append's source moved with the growth's copy, so it is retargeted
/// at the grown buffer before the old one is freed.
export fn arrAppend(dst: Int32, src: Int32, stride: Int32, xs: Int32) {
    let mut data = Int32(load32(src))
    let len = Int64(load64(src + 8))
    let mut cap = Int64(load64(src + 16))
    let mut xdata = Int32(load32(xs))
    let xlen = Int64(load64(xs + 8))
    let need = len + xlen
    if need > cap {
        let mut nc = cap * 2
        if nc < need {
            nc = need
        }
        let grown = malloc(nc * Int64(stride))
        copy(grown, data, Int32(len) * stride)
        if xdata == data {
            xdata = grown
        }
        free(data)
        data = grown
        cap = nc
    }
    copy(data + Int32(len) * stride, xdata, Int32(xlen) * stride)
    store32(dst, UInt32(data))
    store64(dst + 8, UInt64(need))
    store64(dst + 16, UInt64(cap))
}

/// `copyFrom` (RFC-0115): the receiver's buffer refilled with the elements of
/// the array at `xs`. Grows only when the source is longer, and then without
/// copying the old contents, which are dead; a self-copy moves nothing.
export fn arrCopyFrom(dst: Int32, src: Int32, stride: Int32, xs: Int32) {
    let mut data = Int32(load32(src))
    let mut cap = Int64(load64(src + 16))
    let xdata = Int32(load32(xs))
    let xlen = Int64(load64(xs + 8))
    if xlen > cap {
        let grown = malloc(xlen * Int64(stride))
        free(data)
        data = grown
        cap = xlen
    }
    if xdata != data {
        copy(data, xdata, Int32(xlen) * stride)
    }
    store32(dst, UInt32(data))
    store64(dst + 8, UInt64(xlen))
    store64(dst + 16, UInt64(cap))
}

/// `clear` (RFC-0115 addendum): the triple with its length zeroed. The buffer
/// and the capacity travel unchanged, which is what keeps the next fill from
/// allocating.
export fn arrClear(dst: Int32, src: Int32) {
    copy(dst, src, 24)
    store64(dst + 8, 0)
}

// ---------------------------------------------------------------------------
// Step 7, the I/O family (PLAN-0125-runtime §6; RFC-0014, RFC-0043, RFC-0044)
// ---------------------------------------------------------------------------
//
// Every function here is the wasm body it replaces, over the host imports
// `std/mem` declares (PLAN-0125-runtime §2.2): the same buffer sizes, the same
// growth, the same errno tests, the same canonical `@.io.*` wording. The
// wording is never spelled here: the emitter interns each message's two halves
// from `trap.rs`'s one table (`io_message_parts`) and passes them as
// arguments, as it passes `strFromBytes` its two, so a reader of the message
// finds one source. A `String` argument is its bytes' address, as everywhere in
// this module; a `dest` is the caller's destination slot for an aggregate the
// emitter reads back.
//
// **The cells.** The family needs memory that outlives a call — the two
// standard-stream buffers, the fixed clock's counter — and scratch a host
// import writes through (an iovec, an `nwritten`, a prestat). A wasm local has
// no address and this module has no module state (an initializer that ran
// after a top-level `let` printed would reset the buffer under it), so the
// cells live where the allocator's heads do: in the heap's own first bytes,
// zeroed by the engine, after the allocator's 480. Offsets from `heapBase()`:
//
//   480    stdout buffer, 4,096 bytes    `writeAll` gathers fd 1 here
//   4576   stdout position
//   4580   stdin buffer, 4,096 bytes     `getByte` scatters fd 0 from here
//   8676   stdin length                  what the last `fd_read` returned
//   8680   stdin position                the next byte
//   8684   the length a slurp hands back (`readAll`, `slurpGen`, `readdirBlob`)
//   8688   the status a `genRead` answered
//   8692   one byte: the newline `printStr` writes
//   8696   32 bytes of scratch for the host imports' out-parameters
//   8728   the fixed clock's monotonic counter, an `Int64`
//   8736   32 bytes of digits, written backwards (step 9's `digitsAt`)
//   8768   the allocator's first block (`malloc` above)
//
// One host call is in flight at a time, so the scratch is never shared. The
// stdin buffer is 4,096 bytes because `readLine` is the only reader of fd 0
// (`readFileBytes` takes a path), and one syscall per byte is what reverse
// complement paid 40.7 million times before it; the stdout buffer is the same
// size for fasta's five million printed lines.
//
// **Rights and flags** are the `wasi_snapshot_preview1` witx's, spelled at
// their one use each: `right::fd_read` 2, `right::fd_sync` 16,
// `right::fd_write` 64, `right::fd_readdir` 16384; `oflags::creat | trunc` 9,
// `oflags::directory` 2; `lookupflags::symlink_follow` 1 (what `fopen` does);
// `filetype::directory` 3; `errno::xdev` 75, the last of preview1's
// alphabetical list and NOT POSIX's 18. A `dirent` is a 24-byte header
// (`d_next: u64, d_ino: u64, d_namlen: u32, d_type: u8`, three bytes of
// padding), then the name.

/// The retry loop under `writeAll`: `n` bytes at `p` to `fd`, however many
/// `fd_write`s it takes. Zero when every byte went; the errno of a failed
/// write, or 1 for a write that moved nothing while bytes were still owed,
/// either of which would spin forever.
fn drain(fd: Int32, p: Int32, n: Int32) -> Int32 {
    let iov = heapBase() + 8696
    let mut q = p
    let mut left = n
    while left != 0 {
        store32(iov, UInt32(q))
        store32(iov + 4, UInt32(left))
        let e = fdWrite(fd, iov, 1, iov + 8)
        if e != 0 {
            return e
        }
        let w = Int32(load32(iov + 8))
        if w == 0 {
            return 1
        }
        q = q + w
        left = left - w
    }
    return 0
}

/// `write_all`: the ONE place bytes leave a program. Zero when every byte
/// arrived, non-zero when `drain` gave up; a caller that only prints drops it,
/// `writeFileV` reads it. Standard output is gathered: a write to fd 1 that
/// fits the buffer is copied in and nothing leaves. Anything else — another
/// descriptor, a write too long to buffer, a buffer with no room — flushes
/// what is waiting FIRST, so order holds against standard error and against
/// a file. Both trap paths write to fd 2 before they exit, which flushes on
/// the way out; the ordinary exit flushes in `_start` with a zero-length
/// write to fd 2.
export fn writeAll(fd: Int32, p: Int32, n: Int32) -> Int32 {
    let base = heapBase()
    let buffered = fd == 1 && UInt32(n) < 4096
    let mut st: Int32 = 0
    let pos = Int32(load32(base + 4576))
    if pos != 0 && (!buffered || UInt32(pos + n) > 4096) {
        store32(base + 4576, 0)
        st = drain(1, base + 480, pos)
    }
    if buffered {
        let at = Int32(load32(base + 4576))
        copy(base + 480 + at, p, n)
        store32(base + 4576, UInt32(at + n))
    } else {
        let s2 = drain(fd, p, n)
        if s2 != 0 {
            st = s2
        }
    }
    return st
}

/// `print_str`: the bytes, then the newline.
export fn printStr(s: Int32) {
    let base = heapBase()
    writeAll(1, s, Int32(load32(s - 8)))
    store8(base + 8692, '\n')
    writeAll(1, base + 8692, 1)
}

/// `env_get`: the value of the environment entry `key` names (`key` carries
/// its own `=`, so the lookup is one prefix test), or 0. WASI hands the whole
/// environment over in one go, so this is `environ_get` plus a scan. The blob
/// is never freed: the answer points into it, and the two callers run once
/// per process.
export fn envGet(key: Int32) -> Int32 {
    let sc = heapBase() + 8696
    store32(sc, 0)
    store32(sc + 4, 0)
    if environSizesGet(sc, sc + 4) != 0 {
        return 0
    }
    let cnt = Int32(load32(sc))
    let ptrs = malloc(Int64((cnt << 2) + 8))
    let blob = malloc(Int64(Int32(load32(sc + 4)) + 1))
    environGet(ptrs, blob)
    let mut i: Int32 = 0
    while UInt32(i) < UInt32(cnt) {
        let e = Int32(load32(ptrs + (i << 2)))
        if starts(e, key) {
            free(ptrs)
            return e + strLen(key)
        }
        i = i + 1
    }
    free(ptrs)
    return 0
}

/// RFC-0043's injected value: the entry `key` names when it is set AND not
/// empty, else 0. The C shim's own guard, `if (e && e[0])`: an empty value
/// falls through to the real host.
fn injected(key: Int32) -> Int32 {
    let e = envGet(key)
    if e != 0 && load8(e) != 0 {
        return e
    }
    return 0
}

/// `now_millis`: epoch milliseconds, or `VYRN_FIXED_TIME` when the harness
/// set it. `clock_time_get` answers nanoseconds and the division is the shim's
/// `tv_sec * 1000 + tv_nsec / 1e6`, the same floor. A failing clock reads 0,
/// which is what `timespec_get` returning 0 gives.
export fn nowMillis(fixedTime: Int32) -> Int64 {
    let e = injected(fixedTime)
    if e != 0 {
        return strI64(e)
    }
    let out = heapBase() + 8696
    if clockTimeGet(0, 1000000, out) != 0 {
        return 0
    }
    return Int64(load64(out) / 1000000)
}

/// `mono_nanos`: monotonic nanoseconds. Under a fixed clock the interpreter's
/// own base and step, `1e9 + n * 1e6` for the n-th call, so successive calls
/// are byte-identical across engines; otherwise `clock_time_get(MONOTONIC)`.
export fn monoNanos(fixedTime: Int32) -> Int64 {
    let base = heapBase()
    if injected(fixedTime) != 0 {
        let n = Int64(load64(base + 8728))
        store64(base + 8728, UInt64(n + 1))
        return n * 1000000 + 1000000000
    }
    let out = base + 8696
    clockTimeGet(1, 1000, out)
    return Int64(load64(out))
}

/// `random_seed`: eight CSPRNG bytes as an `Int64`, or `VYRN_FIXED_SEED`.
/// Zeroed first: the shim leaves `v = 0` when `getentropy` fails, so the zero
/// IS the error path and there is no errno to read.
export fn randomSeedV(fixedSeed: Int32) -> Int64 {
    let e = injected(fixedSeed)
    if e != 0 {
        return strI64(e)
    }
    let out = heapBase() + 8696
    store64(out, 0)
    randomGet(out, 8)
    return Int64(load64(out))
}

/// `args`: `argv[1..]` as the `Array<String>` triple `{ ptr, len, cap }`
/// written through `dest`. WASI writes the pointers as one contiguous array,
/// which is the buffer an `Array<String>` wants, and one blob they point into;
/// each element is copied into a String with a header of its own (RFC-0089
/// M1a), ascending from `argv[1]` into slot 0 so the program name is never
/// copied and every read of slot `i` precedes the write of slot `i - 1`. The
/// blob was the host's staging buffer and is freed; the copies outlive the
/// program, which is what `args()` always did (RFC-0011's element rule). Two
/// words of slack on the pointer block, so an argv of one name still asks for
/// a block rather than for nothing.
export fn argsV(dest: Int32) {
    let sc = heapBase() + 8696
    store32(sc, 0)
    store32(sc + 4, 0)
    argsSizesGet(sc, sc + 4)
    let cnt = Int32(load32(sc))
    let ptrs = malloc(Int64((cnt << 2) + 8))
    let blob = malloc(Int64(Int32(load32(sc + 4)) + 1))
    argsGet(ptrs, blob)
    let mut i: Int32 = 1
    while UInt32(i) < UInt32(cnt) {
        let e = Int32(load32(ptrs + (i << 2)))
        let n = strLen(e)
        let c = strNew(n, n)
        copy(c, e, n)
        store32(ptrs + ((i - 1) << 2), UInt32(c))
        i = i + 1
    }
    free(blob)
    let mut n: Int32 = 0
    if UInt32(cnt) > 1 {
        n = cnt - 1
    }
    store32(dest, UInt32(ptrs))
    store64(dest + 8, UInt64(Int64(n)))
    store64(dest + 16, UInt64(Int64(n)))
}

/// `getbyte`: one byte of standard input, or -1 at EOF and on any error,
/// which is what `getchar` returning `EOF` covers too. Buffered the way
/// `getchar` is: `fd_read` refills 4,096 bytes when the buffer is spent, and
/// every other call is two loads and a store. `pos >= len` covers the initial
/// zero-zero state, so the first call is a fill.
export fn getByte() -> Int32 {
    let base = heapBase()
    let mut pos = Int32(load32(base + 8680))
    if UInt32(pos) >= UInt32(load32(base + 8676)) {
        let iov = base + 8696
        store32(iov, UInt32(base + 4580))
        store32(iov + 4, 4096)
        store32(iov + 8, 0)
        // An error and a zero-length read are the same answer to the caller,
        // and neither may leave the buffer looking full.
        if fdRead(0, iov, 1, iov + 8) != 0 {
            return -1
        }
        let got = Int32(load32(iov + 8))
        if got == 0 {
            return -1
        }
        store32(base + 8676, UInt32(got))
        pos = 0
    }
    store32(base + 8680, UInt32(pos + 1))
    return Int32(load8(base + 4580 + pos))
}

/// `read_line`: RFC-0014's `readLine()`. `None` at EOF, for a line carrying
/// a NUL byte (a NUL-terminated `String` could not hold it) and for one that
/// is not UTF-8 by the DFA at `table` — where the interpreter's
/// `String::from_utf8` fails, decided here rather than by the caller. The
/// buffer starts at 64 bytes and doubles at `len + 2`, so the terminator
/// never needs a reallocation of its own; a trailing `\\r` goes with the `\\n`,
/// so a Windows pipe and a POSIX one read identically. The payload is the
/// String's address, which is the `Option<String>` shape the caller reads.
export fn readLineV(table: Int32) -> Option<Int64> {
    let mut c = getByte()
    if c < 0 {
        return None
    }
    let mut cap: Int32 = 64
    let mut buf = strNew(0, cap)
    let mut len: Int32 = 0
    let mut nul = false
    while c >= 0 && c != '\n' {
        if c == 0 {
            nul = true
        }
        if UInt32(len + 2) >= UInt32(cap) {
            cap = cap << 1
            let nb = strNew(0, cap)
            copy(nb, buf, len)
            free(buf - 8)
            buf = nb
        }
        store8(buf + len, UInt8(c))
        len = len + 1
        c = getByte()
    }
    if len != 0 && load8(buf + len - 1) == '\r' {
        len = len - 1
    }
    store8(buf + len, 0)
    store32(buf - 8, UInt32(len))
    if nul || !utf8Valid(buf, len, table) {
        free(buf - 8)
        return None
    }
    return Some(Int64(UInt32(buf)))
}

/// `open_at`: a descriptor for `path`, or -1. WASI has no `open` relative to a
/// working directory: every path resolves under a preopened directory, and
/// the host decides which exist. So the preopens are walked from fd 3 (the
/// first WASI hands out) until `fd_prestat_get` says there are no more, and
/// the first that resolves the path wins — `--dir .` gives exactly one, and
/// no preopens at all (a browser) give -1 for every path, RFC-0014's
/// canonical `Err`.
///
/// ponytail: no prefix matching against the preopens' own names, so an
/// absolute guest path only opens under a preopen mounted at `/`; nothing in
/// the corpus has one.
export fn openAt(path: Int32, oflags: Int32, rights: Int64) -> Int32 {
    let plen = strLen(path)
    let sc = heapBase() + 8696
    let mut fd: Int32 = 3
    while fdPrestatGet(fd, sc) == 0 {
        if pathOpen(fd, 1, path, plen, oflags, rights, 0, 0, sc + 8) == 0 {
            return Int32(load32(sc + 8))
        }
        fd = fd + 1
    }
    return -1
}

/// `read_all`: the whole descriptor into one NUL-terminated buffer, its length
/// in the cell at 8684; 0 on a read error, the buffer freed. A read loop
/// rather than a stat-and-slurp, for the reason the C shim gives: it is the
/// same code for a regular file and for a pipe. 1,024 bytes then doubling.
/// `hdr` is how many bytes to leave in FRONT of the returned pointer: 8 for a
/// `String` answer, whose header goes there, and 0 for an `Array<UInt8>`,
/// whose buffer is freed at its own base (RFC-0089 M1a). One reader, two
/// shapes.
fn readAll(fd: Int32, hdr: Int32) -> Int32 {
    let base = heapBase()
    let iov = base + 8696
    let mut cap: Int32 = 1024
    let mut buf = malloc(Int64(UInt32(cap + hdr))) + hdr
    let mut len: Int32 = 0
    while true {
        if UInt32(len + 1) >= UInt32(cap) {
            cap = cap << 1
            let nb = malloc(Int64(UInt32(cap + hdr))) + hdr
            copy(nb, buf, len)
            free(buf - hdr)
            buf = nb
        }
        store32(iov, UInt32(buf + len))
        store32(iov + 4, UInt32(cap - len - 1))
        store32(iov + 8, 0)
        if fdRead(fd, iov, 1, iov + 8) != 0 {
            free(buf - hdr)
            return 0
        }
        let got = Int32(load32(iov + 8))
        if got == 0 {
            break
        }
        len = len + got
    }
    store8(buf + len, 0)
    store32(base + 8684, UInt32(len))
    return buf
}

/// `err3`: one canonical I/O message with the path in the middle, from the
/// two interned halves `io_message_parts` gave the emitter. A fresh String
/// the `Err` owns; the middle step is freed here.
fn err3(pre: Int32, mid: Int32, post: Int32) -> Int32 {
    let t = strConcat(pre, mid)
    let r = strConcat(t, post)
    free(t - 8)
    return r
}

/// The open-and-slurp both file readers start with, under WASI: the buffer
/// with `hdr` bytes in front, its length in the cell at 8684, or 0 when the
/// open or the read failed — one message for both, the caller's.
fn slurpFile(path: Int32, hdr: Int32) -> Int32 {
    let fd = openAt(path, 0, 2)
    if fd < 0 {
        return 0
    }
    let buf = readAll(fd, hdr)
    fdClose(fd)
    return buf
}

/// The same slurp under a generation (RFC-0076): the whole resource in one
/// mediated import, into a buffer this module allocates, because the host
/// must not allocate in guest memory. `genRead` answers `(status << 32) |
/// len` and stashes the bytes; `genFetch` copies them in. The status goes to
/// the cell at 8688 (0 ok, 1 io, 3 an embedded NUL, which the host checks
/// for a String read) and the length to 8684. A String answer gets its header
/// and terminator from `strNew`; a byte read and a directory listing get a
/// NUL only, because the listing is scanned for the zero.
fn slurpGen(path: Int32, mode: Int32, asString: Bool) -> Int32 {
    let base = heapBase()
    let packed = UInt64(genRead(path, mode))
    let st = Int32(packed >> 32)
    store32(base + 8688, UInt32(st))
    if st != 0 {
        return 0
    }
    let len = Int32(packed)
    store32(base + 8684, UInt32(len))
    if asString {
        let s = strNew(len, len)
        genFetch(s)
        return s
    }
    // The NUL is added in 64 bits, so a host answering 4 GiB minus one gets
    // an out of memory rather than a one-byte buffer.
    let buf = malloc(Int64(UInt32(len)) + 1)
    genFetch(buf)
    store8(buf + len, 0)
    return buf
}

/// The read message a generation's failure picks: the NUL wording for status
/// 3, the caller's for the rest. Both halves change together, so a rejected
/// path never reads `cannot read \\`x\\` contains a NUL byte`.
fn genErr(path: Int32, ioPre: Int32, ioPost: Int32, nulPre: Int32, nulPost: Int32) -> Int64 {
    if Int32(load32(heapBase() + 8688)) == 3 {
        return Int64(UInt32(err3(nulPre, path, nulPost)))
    }
    return Int64(UInt32(err3(ioPre, path, ioPost)))
}

/// The half of `readFile` after the slurp: the NUL scan BEFORE the UTF-8
/// check and with its own wording, because a `String` is NUL-terminated — a
/// file with one in it is not representable rather than badly encoded. The
/// buffer has no owner on either failure and is freed. The `Ok` payload is
/// the String's address, the `Result<String, String>` shape the caller reads.
fn readFileFrom(path: Int32, buf: Int32, len: Int32, table: Int32, nulPre: Int32, nulPost: Int32, utf8Pre: Int32, utf8Post: Int32) -> Result<Int64, Int64> {
    let mut i: Int32 = 0
    while UInt32(i) < UInt32(len) {
        if load8(buf + i) == 0 {
            free(buf - 8)
            return Err(Int64(UInt32(err3(nulPre, path, nulPost))))
        }
        i = i + 1
    }
    if !utf8Valid(buf, len, table) {
        free(buf - 8)
        return Err(Int64(UInt32(err3(utf8Pre, path, utf8Post))))
    }
    return Ok(Int64(UInt32(buf)))
}

/// `read_file`: RFC-0014's `readFile` as a `Result<String, String>`. The
/// `String` answer needs its header filled: `readAll` left the room and only
/// this side knows the length; `cap == len`, since the buffer is never grown
/// again (RFC-0089 M1a).
export fn readFileV(path: Int32, table: Int32, readPre: Int32, readPost: Int32, nulPre: Int32, nulPost: Int32, utf8Pre: Int32, utf8Post: Int32) -> Result<Int64, Int64> {
    let buf = slurpFile(path, 8)
    if buf == 0 {
        return Err(Int64(UInt32(err3(readPre, path, readPost))))
    }
    let len = Int32(load32(heapBase() + 8684))
    store32(buf - 8, UInt32(len))
    store32(buf - 4, UInt32(len))
    return readFileFrom(path, buf, len, table, nulPre, nulPost, utf8Pre, utf8Post)
}

/// `readFileV` under a generation: the slurp is the host's, the rest the same.
/// `mode` is the host's read mode for a String.
export fn readFileGen(path: Int32, mode: Int32, table: Int32, readPre: Int32, readPost: Int32, nulPre: Int32, nulPost: Int32, utf8Pre: Int32, utf8Post: Int32) -> Result<Int64, Int64> {
    let buf = slurpGen(path, mode, true)
    if buf == 0 {
        return Err(genErr(path, readPre, readPost, nulPre, nulPost))
    }
    let len = Int32(load32(heapBase() + 8684))
    return readFileFrom(path, buf, len, table, nulPre, nulPost, utf8Pre, utf8Post)
}

/// An `Array<UInt8>` of `len` bytes at `buf`, as the `Ok` of a
/// `Result<Array<UInt8>, String>`: the triple is three words where a sum's
/// payload is one, so it is BOXED, and the box IS the triple.
fn bytesBox(buf: Int32, len: Int32) -> Result<Int64, Int64> {
    let boxed = malloc(24)
    store32(boxed, UInt32(buf))
    store64(boxed + 8, UInt64(UInt32(len)))
    store64(boxed + 16, UInt64(UInt32(len)))
    return Ok(Int64(UInt32(boxed)))
}

/// `read_file_bytes`: the same open-and-slurp with no NUL or UTF-8 rule at
/// all, which is the whole point of a byte read.
export fn readFileBytesV(path: Int32, readPre: Int32, readPost: Int32) -> Result<Int64, Int64> {
    let buf = slurpFile(path, 0)
    if buf == 0 {
        return Err(Int64(UInt32(err3(readPre, path, readPost))))
    }
    return bytesBox(buf, Int32(load32(heapBase() + 8684)))
}

/// `readFileBytesV` under a generation. The host never answers status 3 for
/// a byte read; the NUL halves are passed so the message pick is the one
/// function either way.
export fn readFileBytesGen(path: Int32, mode: Int32, readPre: Int32, readPost: Int32, nulPre: Int32, nulPost: Int32) -> Result<Int64, Int64> {
    let buf = slurpGen(path, mode, false)
    if buf == 0 {
        return Err(genErr(path, readPre, readPost, nulPre, nulPost))
    }
    return bytesBox(buf, Int32(load32(heapBase() + 8684)))
}

/// `write_file_bytes`: RFC-0111, THE ONLY FILE WRITER. Create-or-truncate and
/// write every byte, as a `Result<Bool, String>` whose `Ok` is `true` — a
/// `Bool` payload is the word zero-extended, so the `Ok` carries 1. Three ways
/// to fail, one message: the open, the write and the close. The descriptor is
/// closed on every path, as `fclose` is reached on every path natively, and
/// the close's errno joins the write's: a buffered write that only fails at
/// the close failed.
export fn writeFileBytesV(path: Int32, p: Int32, n: Int32, writePre: Int32, writePost: Int32) -> Result<Int64, Int64> {
    let fd = openAt(path, 9, 64)
    if fd < 0 {
        return Err(Int64(UInt32(err3(writePre, path, writePost))))
    }
    let wst = writeAll(fd, p, n)
    if (fdClose(fd) | wst) != 0 {
        return Err(Int64(UInt32(err3(writePre, path, writePost))))
    }
    return Ok(1)
}

/// `write_file`: the String face of the writer above. A Vyrn String never
/// holds a NUL (the readers above are why), so `strLen` is its whole length;
/// that one call is the entire difference between the two builtins.
export fn writeFileV(path: Int32, s: Int32, writePre: Int32, writePost: Int32) -> Result<Int64, Int64> {
    return writeFileBytesV(path, s, strLen(s), writePre, writePost)
}

/// `rename_file`: RFC-0044's atomic overwrite, as a `Result<Bool, String>`.
/// `path_rename` needs a directory descriptor for each side, so this is
/// `openAt`'s preopen walk without the open, both paths through the same
/// descriptor — which is why the cross-device arm is nearly unreachable here:
/// a preopen is one mount. Two failure classes, because RFC-0044 has two:
/// `errno::xdev` is `@.io.xdeverr` and everything else `@.io.writeerr`, both
/// about the TARGET path. A failure is remembered rather than returned: a
/// later preopen may still resolve the pair, and only if none does is WHY the
/// last one failed the answer. No preopen at all is an io failure, which is
/// also what a browser gets.
export fn renameFileV(from: Int32, to: Int32, writePre: Int32, writePost: Int32, xdevPre: Int32, xdevPost: Int32) -> Result<Int64, Int64> {
    let flen = strLen(from)
    let tlen = strLen(to)
    let sc = heapBase() + 8696
    let mut fd: Int32 = 3
    let mut xdev = false
    while fdPrestatGet(fd, sc) == 0 {
        let e = pathRename(fd, from, flen, fd, to, tlen)
        if e == 0 {
            return Ok(1)
        }
        if e == 75 {
            xdev = true
        }
        fd = fd + 1
    }
    if xdev {
        return Err(Int64(UInt32(err3(xdevPre, to, xdevPost))))
    }
    return Err(Int64(UInt32(err3(writePre, to, writePost))))
}

/// `fsync_file`: RFC-0044's durability step, as a `Result<Bool, String>`.
/// Open, sync, close — the shim's three steps. The open asks for WRITE and
/// SYNC (a descriptor opened without the sync right may refuse with
/// `ENOTCAPABLE`) and passes no oflags, so a missing file is NOT created and
/// an existing one is NOT truncated: the `"rb+"` the shim opens with. Both
/// failures are `@.io.writeerr` about the path: fsync is a step of writing
/// and has no wording of its own.
export fn fsyncFileV(path: Int32, writePre: Int32, writePost: Int32) -> Result<Int64, Int64> {
    let fd = openAt(path, 0, 80)
    if fd < 0 {
        return Err(Int64(UInt32(err3(writePre, path, writePost))))
    }
    let st = fdSync(fd)
    if (fdClose(fd) | st) != 0 {
        return Err(Int64(UInt32(err3(writePre, path, writePost))))
    }
    return Ok(1)
}

/// `readdir_blob`: the directory's entry names joined with `\\n`,
/// NUL-terminated, in a fresh block with its length in the cell at 8684; or 0
/// when the directory cannot be opened or read (RFC-0125 §3 M5). This is
/// `listDir`'s listing on an ordinary build, in the encoding the generator
/// host already answers in, so `splitNames` splits one shape whichever host
/// filled it. `.` and `..` are dropped, since `read_dir` never reports them;
/// with `kinds` a directory's name gets its `/` (RFC-0119). The order is the
/// host's, and `listDirV` sorts.
///
/// `fd_readdir` fills a buffer with as many entries as fit; the last may be
/// cut, and a cut entry is re-read by asking again from its predecessor's
/// `d_next` cookie. A fill shorter than the buffer is the end.
///
/// ponytail: a 4 KiB read buffer, so a name longer than that re-reads
/// forever; no filesystem allows one, NAME_MAX being 255.
fn readdirBlob(path: Int32, kinds: Bool) -> Int32 {
    let base = heapBase()
    let fd = openAt(path, 2, 16384)
    if fd < 0 {
        return 0
    }
    let mut cap: Int32 = 1024
    let mut buf = malloc(Int64(cap))
    let rb = malloc(4096)
    let mut len: Int32 = 0
    let mut cookie: Int64 = 0
    let usedAt = base + 8696
    while true {
        if fdReaddir(fd, rb, 4096, cookie, usedAt) != 0 {
            free(buf)
            buf = 0
            break
        }
        let used = Int32(load32(usedAt))
        let mut off: Int32 = 0
        while UInt32(off + 24) <= UInt32(used) {
            let ent = rb + off
            let namlen = Int32(load32(ent + 16))
            if UInt32(namlen + off + 24) > UInt32(used) {
                break
            }
            cookie = Int64(load64(ent))
            let dtype = load8(ent + 20)
            let name = ent + 24
            // `.` and `..`: a name of one or two bytes that are all `.`.
            let dot = UInt32(namlen) <= 2 && load8(name) == '.' && load8(name + namlen - 1) == '.'
            if !dot {
                // Room for the name, a `/`, the `\n` and the NUL.
                let need = namlen + 3 + len
                if UInt32(need) > UInt32(cap) {
                    cap = cap << 1
                    if UInt32(cap) <= UInt32(need) {
                        cap = need
                    }
                    let nb = malloc(Int64(UInt32(cap)))
                    copy(nb, buf, len)
                    free(buf)
                    buf = nb
                }
                copy(buf + len, name, namlen)
                len = len + namlen
                if kinds && dtype == 3 {
                    store8(buf + len, '/')
                    len = len + 1
                }
                store8(buf + len, '\n')
                len = len + 1
            }
            off = off + 24 + namlen
        }
        if UInt32(used) < 4096 {
            break
        }
    }
    fdClose(fd)
    free(rb)
    if buf == 0 {
        return 0
    }
    // The last `\n` is a separator with nothing after it.
    if len != 0 {
        len = len - 1
    }
    store8(buf + len, 0)
    store32(base + 8684, UInt32(len))
    return buf
}

/// The `n` bytes at `p` as a String of their own.
fn strCopy(p: Int32, n: Int32) -> Int32 {
    let s = strNew(n, n)
    copy(s, p, n)
    return s
}

/// A `\\n`-joined listing of `len` bytes at `buf` split into an
/// `Array<String>` and boxed as the `Ok` of a `Result<Array<String>, String>`.
/// The split is safe for the reason the join is: an entry name cannot contain
/// a newline. A non-empty listing has one more name than separators; an EMPTY
/// one is zero names rather than one empty name, the difference between `[]`
/// and `[""]`. A zero-length array still gets a buffer, so the triple's
/// pointer is never null. Each name is COPIED out of the blob, because a
/// String's header has to sit in front of it and inside one shared buffer
/// there is no room (RFC-0089 M1a); the blob is freed once every name has a
/// copy. With `sort`, an insertion sort by `strCmp`, the byte order a String
/// sorts in (RFC-0022): the interpreter sorts its listing, the generator host
/// sorts before it joins, and `readdirBlob` hands over the host's order.
///
/// ponytail: quadratic, over a directory listing.
fn splitNames(buf: Int32, len: Int32, sort: Bool) -> Result<Int64, Int64> {
    let mut n: Int32 = 0
    let mut i: Int32 = 0
    while UInt32(i) < UInt32(len) {
        if load8(buf + i) == '\n' {
            n = n + 1
        }
        i = i + 1
    }
    if len != 0 {
        n = n + 1
    }
    let mut room = n
    if room == 0 {
        room = 1
    }
    let names = malloc(Int64(room) * 4)
    let mut start = buf
    let mut k: Int32 = 0
    i = 0
    while UInt32(i) < UInt32(len) {
        if load8(buf + i) == '\n' {
            store32(names + (k << 2), UInt32(strCopy(start, buf + i - start)))
            k = k + 1
            start = buf + i + 1
        }
        i = i + 1
    }
    if len != 0 {
        store32(names + (k << 2), UInt32(strCopy(start, buf + len - start)))
    }
    if sort {
        i = 1
        while UInt32(i) < UInt32(n) {
            let own = Int32(load32(names + (i << 2)))
            k = i
            while k != 0 {
                let prev = Int32(load32(names + ((k - 1) << 2)))
                if strCmp(prev, own) <= 0 {
                    break
                }
                store32(names + (k << 2), UInt32(prev))
                k = k - 1
            }
            store32(names + (k << 2), UInt32(own))
            i = i + 1
        }
    }
    free(buf)
    let boxed = malloc(24)
    store32(boxed, UInt32(names))
    store64(boxed + 8, UInt64(UInt32(n)))
    store64(boxed + 16, UInt64(UInt32(n)))
    return Ok(Int64(UInt32(boxed)))
}

/// `list_dir`: `listDir` and `listDirKinds` as a `Result<Array<String>,
/// String>`, over `fd_readdir` on an ordinary build, sorted.
export fn listDirV(path: Int32, kinds: Bool, listPre: Int32, listPost: Int32) -> Result<Int64, Int64> {
    let buf = readdirBlob(path, kinds)
    if buf == 0 {
        return Err(Int64(UInt32(err3(listPre, path, listPost))))
    }
    return splitNames(buf, Int32(load32(heapBase() + 8684)), true)
}

/// `listDirV` under a generation: the listing comes from the loader's
/// resolver through `genRead`, sorted and recorded there — the interpreter's
/// own encoding, so a directory whose contents change invalidates the same
/// cache entry under either engine. `mode` says whether names carry kinds;
/// the host appends the `/` before joining, so the splitter never learns
/// kinds exist.
export fn listDirGen(path: Int32, mode: Int32, listPre: Int32, listPost: Int32) -> Result<Int64, Int64> {
    let buf = slurpGen(path, mode, false)
    if buf == 0 {
        return Err(Int64(UInt32(err3(listPre, path, listPost))))
    }
    return splitNames(buf, Int32(load32(heapBase() + 8684)), false)
}

// ---------------------------------------------------------------------------
// Step 9, the traps and the printer (PLAN-0125-runtime §6; RFC-0125 §2.4)
// ---------------------------------------------------------------------------
//
// The last four functions the wasm emitter wrote by hand. Each keeps the bytes
// of the copy it replaces: parity compares stderr, so every `error:` line in
// the corpus is a test of these two traps.
//
// A trap writes through `writeAll`, never straight to descriptor 2, so the
// stdout buffer behind it is flushed FIRST and a program's last output stands
// in the order it was printed. `std/mem`'s `trap` primitive
// (PLAN-0125-runtime §2.3) is that write and `proc_exit(1)`; it does not
// return, so it is the last statement of both traps.

/// The decimal digits of `v` written BACKWARDS from `buf + end`, and the
/// address of the first one.
///
/// One loop for both printers, and no allocation on either path: the frame
/// buffer the hand-emitted copies each carried is the 32-byte cell at
/// `heapBase() + 8736`, and a trap must not need the heap to say why it
/// trapped. `intStr` is the other digit loop in this module and stays where it
/// is: it answers a `String` the caller owns, which is what `@str` promises.
///
/// The magnitude is taken in `UInt64`, where `0 - u` of `Int64.min` is exactly
/// 2^63, so the smallest integer prints its digits rather than nothing. An
/// unsigned type prints its magnitude, which is why the caller says whether to
/// look for a sign.
fn digitsAt(buf: Int32, end: Int32, v: Int64, signed: Bool) -> Int32 {
    let mut u: UInt64 = UInt64(v)
    let neg = signed && v < 0
    if neg {
        u = 0 - u
    }
    let mut p = end
    while true {
        store8(buf + p, UInt8(u % 10) + 48)
        u = u / 10
        p = p - 1
        if u == 0 {
            break
        }
    }
    if neg {
        store8(buf + p, '-')
        p = p - 1
    }
    return buf + p + 1
}

/// `print(n: Int64)`: the decimal digits and a newline, to descriptor 1.
///
/// The newline sits at the end of the cell, so one `writeAll` carries the
/// digits and it together — the copy's own shape, and the reason the pointer
/// handed over is computed rather than fixed.
export fn printI64(v: Int64, signed: Bool) {
    let buf = heapBase() + 8736
    store8(buf + 31, '\n')
    let at = digitsAt(buf, 30, v, signed)
    writeAll(1, at, buf + 32 - at)
}

/// `bool_str`: the interned literal itself, not a copy of it. `print` wants
/// exactly that and frees nothing; `@str` copies at its own call site, because
/// a rendered value owns its storage and a data-segment pointer cannot. The
/// emitter passes both literals, as it passes every other wording here.
export fn boolStr(v: Bool, t: Int32, f: Int32) -> Int32 {
    if v {
        return t
    }
    return f
}

/// `trap(msg)`: the message on descriptor 2 and exit 1, which is what the
/// interpreter and the native build both do. Not a wasm `unreachable`: that
/// would print the engine's wording, and parity compares stderr.
export fn trapV(msg: Int32) {
    trap(msg, strLen(msg))
}

/// `trapAt(rule, v, table)`: the trap table's row `rule`, with `v` in the
/// middle of the rows that have a middle — RFC-0125 §2.3.
///
/// `table` is eight rows of two addresses, laid out by the emitter from
/// `vyrn_frontend::trap::Rule`: the wording before the value, and the wording
/// after it, or zero for a row with no value in it. So a site says WHICH rule
/// broke and this says what that reads like, which is what "`trap` maps to a
/// call with a table index" means. It replaces `trapIdx` and the eight
/// separately interned wordings the emitter used to push one of.
export fn trapAt(rule: Int32, v: Int64, table: Int32) {
    let row = table + (rule << 3)
    let pre = Int32(load32(row))
    let post = Int32(load32(row + 4))
    if post == 0 {
        trap(pre, strLen(pre))
    }
    writeAll(2, pre, strLen(pre))
    let buf = heapBase() + 8736
    let at = digitsAt(buf, 31, v, true)
    writeAll(2, at, buf + 32 - at)
    trap(post, strLen(post))
}
