/// The `.vyx` single-file component compiler, in comptime-pure Vyrn.
///
/// `components(dir)` reads every `<Name>.vyx` in `dir` at compile time and
/// synthesizes one module that exports one pure view function per component,
/// built from `std/html` calls. `std/ui`'s `pages` compiles `.vyx` pages,
/// layouts and error pages through `vyxPage`, `vyxLayout` and `vyxError`.
/// [`vyxParseTemplate`] gives a generator or a tool the parsed `<template>`.
///
///   import { components } from "std/vyx"
///   import { itemRow, cart } from components("./components")
///
/// A `.vyx` file has two sections:
///   <script>   -- optional: a `props { name: Type, ... }` block (the view fn's
///                parameters), `import` lines (copied as written, so a
///                relative path resolves beside the `.vyx`; a name a sibling
///                already imports from the same path is dropped), and plain
///                `fn`/`let`/`type` helpers (module-private).
///   <template> -- exactly one root element, compiled to the view fn body.
///
/// Template grammar (Vue-flavored):
///   {{ expr }}                  -> text((expr).toString())     (escaped)
///   v-html="expr"               -> Raw(expr) as the element's content; `expr` is a
///                                 `Markup`, which `Raw` never escapes
///   <slot/>                     -> splices the trailing children param
///   v-if="c" / v-else-if="c" / v-else   -> nested Empty-elided conditionals; a
///                                 v-else-if/v-else must be the next element
///                                 sibling (whitespace and comments between are
///                                 fine)
///   v-for="x in expr"  (+ required :key="expr")   -> keyed loop
///   :name="expr"  (incl. :class, :value)          -> dynamic attribute
///   name="..."                  -> static attribute (`class` is checked when
///                                 themed)
///   <Capitalized :p="e" q="s"/> / <Capitalized>...</Capitalized>  -> component call
///   @click="handler" / @click="handler(scalar)" (also @input/@change/@submit/...)
///                               -> On(event, "handler", (scalar).toString())
///
/// Whitespace: an all-whitespace run that spans a newline is dropped; a
/// same-line whitespace run is one space; other runs collapse to single spaces.
/// `<!-- ... -->` comments are inert, and a lone `{` in text is literal. The grammar
/// is `std/vyx.syntax`, and each of its rows has its sentence in `std/vyx.errors`.
///
/// Every generation failure is a `std/diag` report at the `.vyx` line it came
/// from. `vyrn emit-gen <file>` shows the synthesized module.
///
/// Generation-time components. A capitalized tag resolves first
/// against sibling `.vyx` files, then against names the `<script>` sections
/// import. An imported name is a provider: `std/vyx` emits a nested generator
/// import that runs the imported `gen fn` with the tag's attributes as constant
/// arguments, and splices its output where the tag stood.
///
///   <script>
///   import { Icon } from "./icon-provider"
///   </script>
///   <template>
///   <p><Icon name="brand:github" label="GitHub"/></p>
///   </template>
///
/// A provider is an ordinary module that exports a `gen fn` of this shape:
///
///   export gen fn <TagName>(attrs: String, file: String, line: Int64, col: Int64) -> Code
///
///   attrs  the tag's static attributes as a JSON object of strings, in source
///          order, written by `std/json` so `std/jsonread` reads it back exactly;
///          `{}` when there are none.
///   file   the `.vyx` file the tag was written in.
///   line   the tag's 1-based line in that file.
///   col    always 1: a template node carries no column.
///
/// The generated module must export
///
///   export fn provide() -> Html
///
/// which `std/vyx` calls at the tag site through a namespace alias it mints.
/// The name is not `render`: a user function named after a surface builtin
/// shadows it program-wide, so it would break `render` here.
///
/// A provider tag takes static attributes only and no children; `:attr`,
/// `@event` and children are diagnostics. Compute a value in a sibling `.vyx`
/// component instead. The provider runs in its own sandbox and cache entry, and
/// anchors its own reports at the `file`/`line` it is given. `std/vyx` cannot
/// check the provider's shape, because a template-named provider is outside its
/// read roots; a wrong shape fails the emitted import with the loader's
/// diagnostic.

// `vyxSlice` stays private: it slices a byte array, so `substring` does not fit.
import { joinWith, lines, trim, fromBytesOr } from "std/strings"
import { includes } from "std/arrays"
// `components` checks its emitted surface against the `Component` contract.
// `Html` is imported only for that contract; the generated module's
// `std/html` import is separate, emitted text.
import { checkContract } from "std/contract"
import { Html } from "std/html"
// A provider tag's static attributes travel as one JSON string argument;
// `std/json`'s writer makes that lossless.
import { Json, JsonField, emit } from "std/json"
import { contains, endsWith, startsWith } from "std/strpred"
import { report, reportHere, Severity } from "std/diag"
import { join, arm, ifChain, ifChainOr } from "std/code"
import { catalogue } from "std/i18n"
import { syntax } from "std/syntax"
// Each by a namespace: a written module's names, such as `Row`, are program-wide.
import * as vx from syntax("./vyx.syntax")
import * as say from catalogue("./vyx.errors")

/// What a components module exports: one view per component, each returning
/// `Html`. View names are the application's, so the contract is open. Every
/// `<script>` name is module-private, so there is no hand-written export to
/// check.
export contract Component {
    fn *(..) -> Html
}

/// The bytes `ba[s..e)` as a String, or "" when they are not UTF-8.
export to "./vyx.editor" fn vyxSlice(ba: Array<UInt8>, s: Int64, e: Int64) -> String {
    let mut out: Array<UInt8> = []
    let mut i = s
    while i < e {
        out.push(ba[i])
        i = i + 1
    }
    return fromBytesOr(out, "")
}

/// True for an ASCII space, tab, CR, or LF.
fn vyxIsWs(b: UInt8) -> Bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

/// True for an ASCII letter, digit, or `_` (identifier bytes).
export to "./vyx.editor" fn vyxIsIdent(b: UInt8) -> Bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}

/// Lowercases the first ASCII byte of `s` (`ItemRow` -> `itemRow`).
export to "./vyx.editor" fn vyxLowerFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'A' && b <= 'Z' {
            out.push(b + 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// `arr` with `s` appended; the input is unchanged. Unused.
fn vyxAppend(arr: Array<String>, s: String) -> Array<String> {
    let mut out = arr.copy()
    out.push(s.copy())
    return out
}

/// The 1-based line number of byte offset `off` within `ba` (newlines before it).
export to "./vyx.editor" fn vyxLineAt(ba: Array<UInt8>, off: Int64) -> Int64 {
    return lineAt(ba, off)
}

/// The 1-based column of byte offset `off` within `ba`, in characters since the
/// last LF: the column `codeAt` and the lexer count.
export to "./vyx.editor" fn vyxColAt(ba: Array<UInt8>, off: Int64) -> Int64 {
    let mut col = 1
    let mut i = off
    while i > 0 && ba[i - 1] != '\n' {
        if vyxCharStart(ba[i - 1]) {
            col = col + 1
        }
        i = i - 1
    }
    return col
}

/// True for the first byte of a UTF-8 character.
export to "./vyx.editor" fn vyxCharStart(b: UInt8) -> Bool {
    return b < '\x80' || b >= '\xc0'
}

/// The offset of the first non-whitespace byte in `ba[from..)`, so an
/// interpolation maps to the start column of its expression.
fn vyxSkipWs(ba: Array<UInt8>, from: Int64, e: Int64) -> Int64 {
    let mut i = from
    while i < e && vyxIsWs(ba[i]) {
        i = i + 1
    }
    return i
}

/// `text`, found at byte offset `off` of `s`, a value that starts at `line`:`col`;
/// columns count characters.
fn vyxSpanIn(s: String, line: Int64, col: Int64, off: Int64, text: String) -> VyxSpan {
    let sb = bytes(s)
    let mut l = line
    let mut c = col
    let mut i = 0
    while i < off {
        if sb[i] == '\n' {
            l = l + 1
            c = 1
        } else if vyxCharStart(sb[i]) {
            c = c + 1
        }
        i = i + 1
    }
    return VyxSpan { text: text.copy(), line: l, col: c }
}

/// The trimmed bytes `ba[s..e)` and the position of their first byte.
fn vyxSpanAt(ba: Array<UInt8>, s: Int64, e: Int64) -> VyxSpan {
    let a = vyxSkipWs(ba, s, e)
    let mut b = e
    while b > a && vyxIsWs(ba[b - 1]) {
        b = b - 1
    }
    return VyxSpan { text: vyxSlice(ba, a, b), line: vyxLineAt(ba, a), col: vyxColAt(ba, a) }
}

/// The index of the first occurrence of `needle` in `ba` at or after `from`, or
/// -1 when absent.
fn vyxFind(ba: Array<UInt8>, needle: Array<UInt8>, from: Int64) -> Int64 {
    if needle.length == 0 {
        return from
    }
    let mut i = from
    while i + needle.length <= ba.length {
        let mut j = 0
        let mut ok = true
        while j < needle.length && ok {
            if ba[i + j] != needle[j] {
                ok = false
            }
            j = j + 1
        }
        if ok {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// The index of the LAST occurrence of `needle` in `ba` at or after `from`, or -1.
export to "./vyx.editor" fn vyxFindLast(ba: Array<UInt8>, needle: Array<UInt8>, from: Int64) -> Int64 {
    let mut found = 0 - 1
    let mut at = vyxFind(ba, needle, from)
    while at >= 0 {
        found = at
        at = vyxFind(ba, needle, at + 1)
    }
    return found
}

/// Collapses each run of ASCII whitespace in `s` to one space. An
/// all-whitespace run becomes one space, which the caller drops.
fn vyxCollapseWs(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut inWs = false
    for b in ba {
        if vyxIsWs(b) {
            if inWs == false {
                out.push(' ')
                inWs = true
            }
        } else {
            out.push(b)
            inWs = false
        }
    }
    return fromBytesOr(out, s)
}

/// Whether `a` is `@name`.
export to "./vyx-hints" fn vyxEvt(a: vx.VyxAttr) -> Bool {
    return match a.evt {
        Some(mark) => true,
        None => false,
    }
}

/// Whether `a` is `:name`, whose value is a Vyrn expression.
export to "./vyx-hints" fn vyxDyn(a: vx.VyxAttr) -> Bool {
    return match a.dyn {
        Some(mark) => true,
        None => false,
    }
}

/// The quoted text of `a`, trimmed, or `""` for a bare attribute.
export to "./vyx-hints" fn vyxAttrText(a: vx.VyxAttr) -> String {
    return match a.value {
        Some(v) => trim(vyxSlice(bytes(v.text), 1, bytes(v.text).length - 1)),
        None => "",
    }
}

/// The value of `a` in the `.vyx` bytes `ba`: the quoted text, trimmed, and its
/// position, or `""` at the name for a bare attribute (`disabled`).
export to "./vyx-hints" fn vyxAttrValue(ba: Array<UInt8>, a: vx.VyxAttr) -> VyxSpan {
    return match a.value {
        Some(v) => vyxSpanAt(ba, v.start + 1, v.end - 1),
        None => VyxSpan { text: "", line: vyxLineAt(ba, a.name.start), col: vyxColAt(ba, a.name.start) },
    }
}

/// Text of a `.vyx` file and the 1-based line and column it starts at there.
export type VyxSpan = { text: String, line: Int64, col: Int64 }

/// The control flow of a template, which the grouping pass makes of the written tree
/// and the emitter walks: the tree holds a `v-if` chain as siblings, and a directive as
/// an attribute. Lines and columns are 1-based in the `.vyx` file.
///
/// - `VNText(text)`: literal text, each whitespace run collapsed to one space.
/// - `VNInterp(expr)`: `{{ expr }}`, the expression trimmed.
/// - `VNRaw(expr)`: the value of `v-html`.
/// - `VNChildren`: `<slot/>`.
/// - `VNElem(tag, isComp, attrs, kids, line)`: an element, or a component when `tag`
///   starts with an uppercase letter (`isComp`). `line` is the `<`'s.
/// - `VNIf(conds, bodies, elseBody, hasElse)`: a `v-if` chain, one body per condition.
/// - `VNFor(var, iter, key, body, line, col)`: `v-for` with its `:key`, where `iter` is
///   the iterable with its position, and `line` and `col` are the header's.
type VyxFlow = enum {
    VNText(String),
    VNInterp(VyxSpan),
    VNRaw(VyxSpan),
    VNChildren,
    VNElem(String, Bool, Array<vx.VyxAttr>, Array<VyxFlow>, Int64),
    VNIf(Array<VyxSpan>, Array<VyxBody>, VyxBody, Bool),
    VNFor(String, VyxSpan, VyxSpan, Array<VyxFlow>, Int64, Int64) }

/// One branch of a `VNIf`: a node list, so bodies nest in a payload without
/// `Array<Array<VyxFlow>>`.
type VyxBody = { nodes: Array<VyxFlow> }

/// A node owns its subtree. `VyxFlow` reaches itself through `VNElem`'s children, so
/// the structural release walk needs this declared bottom; every type that reaches
/// `VyxFlow` relies on it too.
///
/// A release recurses once per nesting level. With the default 1 MiB stack on
/// Windows it overflows between 10,000 and 11,000 levels, far above real
/// template depth.
impl Owned for VyxFlow {
    fn release(consume self) {
        // Each payload is dropped in its arm; the recursion lives in the
        // `Array<VyxFlow>` releases.
        match consume self {
            VNText(s) => {
                drop s
            }
            VNInterp(x) => {
                let text = consume x.text
                drop text
            }
            VNRaw(x) => {
                let text = consume x.text
                drop text
            }
            VNChildren => {}
            VNElem(tag, isComp, attrs, kids, l) => {
                drop tag
                drop attrs
                drop kids
            }
            VNIf(conds, bodies, els, has) => {
                drop conds
                drop bodies
                // `drop` names bindings, not a record without `impl Owned`, so
                // take the one heap field and drop it.
                let elsNodes = consume els.nodes
                drop elsNodes
            }
            VNFor(v, it, key, body, l, c) => {
                drop v
                let itText = consume it.text
                drop itText
                let keyText = consume key.text
                drop keyText
                drop body
            }
        }
    }
}

/// The index just past the `"` closing the string literal whose `"` is at `q`.
fn vyxScanQuote(ba: Array<UInt8>, q: Int64, e: Int64) -> Int64 {
    let mut i = q + 1
    while i < e && ba[i] != '"' {
        if ba[i] == '\\' {
            i = i + 1
        }
        i = i + 1
    }
    return i + 1
}

/// One `.vyx` finding: an error at `line` of `file`, column 1 because the
/// scanner tracks lines only, or at the generator call when `file` is `None`.
type VyxErr = { file: Option<String>, line: Int64, message: String }

/// A finding at `line` of `file`.
fn vyxErr(file: String, line: Int64, message: String) -> VyxErr {
    return VyxErr { file: Some(file.copy()), line: line, message: message.copy() }
}

/// A finding at the generator call.
fn vyxErrHere(message: String) -> VyxErr {
    return VyxErr { file: None, line: 0, message: message.copy() }
}

/// `a`, then `b`.
fn vyxCat(a: Array<VyxErr>, b: Array<VyxErr>) -> Array<VyxErr> {
    let mut out = a.copy()
    for e in b {
        out.push(e.copy())
    }
    return out
}

/// Every finding as a diagnostic, in order.
gen fn vyxReports(errs: Array<VyxErr>) -> Code {
    let mut out = vyrn""
    for e in errs {
        out = out + match e.file {
            Some(f) => report(Error, f, e.line, 1, e.message),
            None => reportHere(Error, e.message),
        }
    }
    return out
}

/// Whether some finding's message holds `text`, for a test.
fn vyxErrsSay(errs: Array<VyxErr>, text: String) -> Bool {
    for e in errs {
        if e.message.contains(text) {
            return true
        }
    }
    return false
}

/// The sentence of `row`, the one place a template's refusal is said. The catalogue's
/// check is this match: a row with no arm, a key with no row's arm, or an argument of
/// the wrong count does not compile.
fn vyxSay(row: vx.Row) -> String {
    return match row {
        AttrName => say.tAttrName__En(),
        AttrUnquoted => say.tAttrUnquoted__En(),
        ElemUnclosed(tag) => say.tElemUnclosed__En(tag),
        ElseIfOrphan => say.tElseIfOrphan__En(),
        ElseOrphan => say.tElseOrphan__En(),
        Expected(token) => say.tExpected__En(token),
        InterpEmpty => say.tInterpEmpty__En(),
        InterpUnclosed => say.tInterpUnclosed__En(),
        ManyRoots => say.tManyRoots__En(),
        NoElement => say.tNoElement__En(),
        NoTag => say.tNoTag__En(),
        NoTemplate => say.tNoTemplate__En(),
        ScriptUnclosed => say.tScriptUnclosed__En(),
        StrayClose(tag) => say.tStrayClose__En(tag),
        TagMismatch(tag, close) => say.tTagMismatch__En(tag, close),
        TagUnclosed => say.tTagUnclosed__En(),
        TemplateUnclosed => say.tTemplateUnclosed__En(),
        VforEmpty => say.tVforEmpty__En(),
        VforNoIn => say.tVforNoIn__En(),
        VforNoKey => say.tVforNoKey__En(),
        VforRunsIn => say.tVforRunsIn__En(),
    }
}

/// A finding of `row` at `line` of `file`.
fn vyxRow(file: String, line: Int64, row: vx.Row) -> VyxErr {
    return vyxErr(file, line, vyxSay(row))
}

/// The sections of the `.vyx` text `source`. The rule refuses nothing, so the empty
/// outline is the arm no text reaches.
export to "./vyx.editor" fn vyxOutlineOf(source: String) -> vx.VyxOutline {
    return match vx.parseVyxOutline(source) {
        Ok(outline) => outline,
        Err(errors) => vx.VyxOutline { script: None, template: None, start: 0, end: 0 },
    }
}

/// The offset where the script body of `o` starts, 0 with no script.
fn vyxScriptFrom(o: vx.VyxOutline) -> Int64 {
    if let Some(s) = o.script {
        return s.body.start
    }
    return 0
}

/// The offset where the script body of `o` ends, 0 with no script.
fn vyxScriptTo(o: vx.VyxOutline) -> Int64 {
    if let Some(s) = o.script {
        return s.body.end
    }
    return 0
}

/// Whether the script of `o` opens and never closes.
fn vyxScriptUnclosed(o: vx.VyxOutline) -> Bool {
    if let Some(s) = o.script {
        return match s.close {
            Some(c) => false,
            None => true,
        }
    }
    return false
}

/// Whether the template of `o` opens and never closes.
fn vyxTemplateUnclosed(o: vx.VyxOutline) -> Bool {
    if let Some(t) = o.template {
        return match t.close {
            Some(c) => false,
            None => true,
        }
    }
    return false
}

/// The text of the template of `o`, `""` with none.
fn vyxTemplateText(o: vx.VyxOutline) -> String {
    if let Some(t) = o.template {
        return t.body.text.copy()
    }
    return ""
}

/// Whether `o` has a template, closed or not.
fn vyxHasTemplatePart(o: vx.VyxOutline) -> Bool {
    return match o.template {
        Some(t) => true,
        None => false,
    }
}

/// The first element of `nodes` to close wrongly, innermost first, as it closes: with
/// no close tag, or under another name.
fn vyxCloseFault(nodes: Array<vx.VyxNode>, src: VyxSource) -> Option<VyxErr> {
    for n in nodes {
        if let VyxNodeVyxElem(e) = n {
            if let Some(kids) = e.body {
                let inner = vyxCloseFault(kids.nodes, src)
                if let Some(fault) = inner {
                    return Some(fault)
                }
                let line = vyxLineAt(src.bytes, e.start)
                match kids.close {
                    Some(c) => {
                        if c.name.text != e.tag.text {
                            return Some(vyxRow(src.path, line, TagMismatch(e.tag.text.copy(), c.name.text.copy())))
                        }
                    }
                    None => {
                        return Some(vyxRow(src.path, line, ElemUnclosed(e.tag.text.copy())))
                    }
                }
            }
        }
    }
    return None
}

/// A directive lookup result: the directive's value plus its 1-based position.
type VyxDir = { found: Bool, value: String, dyn: Bool, line: Int64, col: Int64 }

/// Looks up directive or attribute `name` (exact, non-event) on `attrs`.
fn vyxDir(ba: Array<UInt8>, attrs: Array<vx.VyxAttr>, name: String) -> VyxDir {
    for a in attrs {
        if vyxEvt(a) == false && a.name.text == name {
            let v = vyxAttrValue(ba, a)
            return VyxDir { found: true, value: consume v.text, dyn: vyxDyn(a), line: v.line, col: v.col }
        }
    }
    return VyxDir { found: false, value: "", dyn: false, line: 0, col: 0 }
}

/// `attrs` without the structural directives (and `key` when `dropKey`).
fn vyxStripDirectives(attrs: Array<vx.VyxAttr>, dropKey: Bool) -> Array<vx.VyxAttr> {
    let mut out: Array<vx.VyxAttr> = []
    for a in attrs {
        let n = a.name.text
        let structural = n == "v-if" || n == "v-else-if" || n == "v-else" || n == "v-for" || n == "v-html"
        let isKey = dropKey && vyxEvt(a) == false && n == "key"
        if structural == false && isKey == false {
            out.push(a.copy())
        }
    }
    return out
}

/// A parsed `v-for` header `x in expr`; `iterAt` is the byte offset of `iter`
/// in the header.
type VyxForHdr = { var: String, iter: String, iterAt: Int64, errs: Array<VyxErr> }

gen fn vyxParseForHead(header: String, srcFile: String, line: Int64) -> VyxForHdr {
    let ba = bytes(header)
    let mut i = 0
    while i < ba.length && vyxIsWs(ba[i]) {
        i = i + 1
    }
    let vStart = i
    while i < ba.length && vyxIsIdent(ba[i]) {
        i = i + 1
    }
    let varName = vyxSlice(ba, vStart, i)
    while i < ba.length && vyxIsWs(ba[i]) {
        i = i + 1
    }
    if i + 1 >= ba.length || ba[i] != 'i' || ba[i + 1] != 'n' {
        return VyxForHdr { var: "", iter: "", iterAt: 0, errs: [vyxRow(srcFile, line, VforNoIn)] }
    }
    if i + 2 < ba.length && vyxIsWs(ba[i + 2]) == false {
        return VyxForHdr { var: "", iter: "", iterAt: 0, errs: [vyxRow(srcFile, line, VforRunsIn)] }
    }
    let iterAt = vyxSkipWs(ba, i + 2, ba.length)
    let iter = trim(vyxSlice(ba, i + 2, ba.length))
    if varName.byteLength == 0 || iter.byteLength == 0 {
        return VyxForHdr { var: varName, iter: iter, iterAt: iterAt, errs: [vyxRow(srcFile, line, VforEmpty)] }
    }
    return VyxForHdr { var: varName, iter: iter, iterAt: iterAt, errs: [] }
}

type VyxGroup = { nodes: Array<VyxFlow>, errs: Array<VyxErr> }

type VyxOne = { node: VyxFlow, errs: Array<VyxErr> }

/// Text and the bytes its positions read.
type VyxSource = { path: String, bytes: Array<UInt8> }

/// The text a run `raw` renders: each whitespace run collapsed to one space, one space
/// for a same-line whitespace run, and `""`, no node, for one that holds a line break.
fn vyxTextOf(raw: String) -> String {
    if trim(raw).byteLength == 0 {
        return if contains(raw, "\n") { "" } else { " " }
    }
    return vyxCollapseWs(raw)
}

/// Compiles one element: groups its children, applies `v-html`, and wraps a `v-for`
/// element into `VNFor`. A `<slot/>` is `VNChildren`.
gen fn vyxProcessElem(e: vx.VyxElem, src: VyxSource) -> VyxOne {
    let tag = e.tag.text
    if tag == "slot" {
        return VyxOne { node: VNChildren, errs: [] }
    }
    let isComp = bytes(tag)[0] >= 'A' && bytes(tag)[0] <= 'Z'
    let line = vyxLineAt(src.bytes, e.start)
    let vhtml = vyxDir(src.bytes, e.attrs, "v-html")
    let mut childNodes: Array<VyxFlow> = []
    let mut errs: Array<VyxErr> = []
    if vhtml.found {
        childNodes = [VNRaw(VyxSpan { text: consume vhtml.value, line: vhtml.line, col: vhtml.col })]
    } else if let Some(kids) = e.body {
        let g = vyxGroupNodes(kids.nodes, src)
        childNodes = consume g.nodes
        errs = consume g.errs
    }
    let vfor = vyxDir(src.bytes, e.attrs, "v-for")
    if vfor.found {
        let key = vyxDir(src.bytes, e.attrs, "key")
        if key.found == false {
            errs.push(vyxRow(src.path, line, VforNoKey))
        }
        let h = vyxParseForHead(vfor.value, src.path, vfor.line)
        errs = vyxCat(errs, h.errs)
        let elem = VNElem(tag.copy(), isComp, vyxStripDirectives(e.attrs, true), childNodes, line)
        let iter = vyxSpanIn(vfor.value, vfor.line, vfor.col, h.iterAt, h.iter)
        let keySpan = VyxSpan { text: consume key.value, line: key.line, col: key.col }
        return VyxOne { node: VNFor(h.var.copy(), iter, keySpan, [elem], vfor.line, vfor.col), errs: errs }
    }
    return VyxOne { node: VNElem(tag.copy(), isComp, vyxStripDirectives(e.attrs, false), childNodes, line), errs: errs }
}

/// Whether `n` ends an open `v-if` chain: whitespace and a chained directive do not.
fn vyxEndsChain(n: vx.VyxNode, ba: Array<UInt8>) -> Bool {
    return match n {
        VyxNodeVyxText(t) => trim(t.value.text).byteLength > 0,
        VyxNodeVyxInterp(x) => true,
        VyxNodeVyxElem(e) => e.tag.text == "slot" || vyxDir(ba, e.attrs, "v-if").found || (vyxDir(ba, e.attrs, "v-else-if").found == false && vyxDir(ba, e.attrs, "v-else").found == false),
    }
}

/// Groups a sibling list into the control flow: a `v-if` chain becomes one `VNIf`, a
/// `v-for` element a `VNFor`, a `v-html` element's content one `VNRaw`. The chain is a
/// running accumulator: a head opens it, `v-else-if` appends, `v-else` closes it, and
/// any other node or the end flushes it.
gen fn vyxGroupNodes(nodes: Array<vx.VyxNode>, src: VyxSource) -> VyxGroup {
    let mut out: Array<VyxFlow> = []
    let mut errs: Array<VyxErr> = []
    let mut conds: Array<VyxSpan> = []
    let mut bodies: Array<VyxBody> = []
    for n in nodes {
        if conds.length > 0 && vyxEndsChain(n, src.bytes) {
            out.push(VNIf(conds, bodies, VyxBody { nodes: [] }, false))
            conds = []
            bodies = []
        }
        match n {
            VyxNodeVyxText(t) => {
                // Whitespace between branches belongs to no branch.
                let text = vyxTextOf(t.value.text)
                if text.byteLength > 0 && (conds.length == 0 || trim(text).byteLength > 0) {
                    out.push(VNText(text))
                }
            }
            VyxNodeVyxInterp(x) => {
                let at = x.expr.start
                out.push(VNInterp(VyxSpan { text: x.expr.text.copy(), line: vyxLineAt(src.bytes, at), col: vyxColAt(src.bytes, at) }))
            }
            VyxNodeVyxElem(e) => {
                let line = vyxLineAt(src.bytes, e.start)
                let head = vyxDir(src.bytes, e.attrs, "v-if")
                let chained = vyxDir(src.bytes, e.attrs, "v-else-if")
                let last = vyxDir(src.bytes, e.attrs, "v-else")
                if e.tag.text != "slot" && head.found {
                    conds.push(VyxSpan { text: consume head.value, line: head.line, col: head.col })
                    let p = vyxProcessElem(e, src)
                    errs = vyxCat(errs, p.errs)
                    bodies.push(VyxBody { nodes: [consume p.node] })
                } else if e.tag.text != "slot" && chained.found {
                    if conds.length == 0 {
                        errs.push(vyxRow(src.path, line, ElseIfOrphan))
                    } else {
                        conds.push(VyxSpan { text: consume chained.value, line: chained.line, col: chained.col })
                        let p = vyxProcessElem(e, src)
                        errs = vyxCat(errs, p.errs)
                        bodies.push(VyxBody { nodes: [consume p.node] })
                    }
                } else if e.tag.text != "slot" && last.found {
                    if conds.length == 0 {
                        errs.push(vyxRow(src.path, line, ElseOrphan))
                    } else {
                        let p = vyxProcessElem(e, src)
                        errs = vyxCat(errs, p.errs)
                        out.push(VNIf(conds, bodies, VyxBody { nodes: [consume p.node] }, true))
                        conds = []
                        bodies = []
                    }
                } else {
                    let p = vyxProcessElem(e, src)
                    errs = vyxCat(errs, p.errs)
                    out.push(consume p.node)
                }
            }
        }
    }
    if conds.length > 0 {
        out.push(VNIf(conds, bodies, VyxBody { nodes: [] }, false))
    }
    return VyxGroup { nodes: out, errs: errs }
}

/// One `props` or `params` entry, `name: Type`.
export to "./vyx.editor" type VyxProp = { name: VyxSpan, ty: VyxSpan }

/// The parsed `<script>` section: its `props` (or a page's `params`) entries,
/// its import lines, and every other non-blank line, a helper line, from its
/// first byte. `errs` holds a block fault.
export to "./vyx.editor" type VyxScript = {
    props: Array<VyxProp>,
    imports: Array<VyxSpan>,
    helperLines: Array<VyxSpan>,
    errs: Array<VyxErr>,
}

/// Split a record body on commas at generic (`<>`) depth 0.
fn vyxSplitFields(body: String) -> Array<String> {
    let ba = bytes(body)
    let mut parts: Array<String> = []
    let mut depth = 0
    let mut start = 0
    let mut i = 0
    while i < ba.length {
        let b = ba[i]
        if b == '<' {
            depth = depth + 1
        } else if b == '>' {
            depth = depth - 1
        } else if b == ',' && depth == 0 {
            parts.push(vyxSlice(ba, start, i))
            start = i + 1
        }
        i = i + 1
    }
    parts.push(vyxSlice(ba, start, ba.length))
    return parts
}

/// A located `props` block. `found`: a `props` keyword leads a statement line.
/// `malformed`: it is not followed by `{`. `braceAt` is valid only when found
/// and not malformed.
type VyxProps = { found: Bool, malformed: Bool, kwAt: Int64, braceAt: Int64 }

/// The byte offset at which 1-based `targetLine` begins in `ba` (0 for line 1,
/// the length past the end). Turns a `lex()` token's line into an offset with
/// no column arithmetic, so CRLF and multi-byte content do not matter.
fn vyxLineStartOffset(ba: Array<UInt8>, targetLine: Int64) -> Int64 {
    if targetLine <= 1 {
        return 0
    }
    let mut line = 1
    let mut i = 0
    while i < ba.length {
        if ba[i] == '\n' {
            line = line + 1
            if line == targetLine {
                return i + 1
            }
        }
        i = i + 1
    }
    return ba.length
}

/// Locates a statement-leading `<kwStr> { ... }` block in `ba` with the real
/// lexer: the keyword is an `ident` token first on its line, followed by `{`
/// after whitespace. `lex` emits no token for a comment and one for a whole
/// string, so a `props` in a comment, a string, or `let props = ...` never
/// matches. Offsets are relative to `ba`.
gen fn vyxFindKwBlock(ba: Array<UInt8>, kwStr: String) -> VyxProps {
    let toks = lex(vyxSlice(ba, 0, ba.length))
    let kwLen = bytes(kwStr).length
    let mut i = 0
    while i < toks.length {
        let t = toks[i]
        let leading = i == 0 || toks[i - 1].line < t.line
        if leading && t.kind == "ident" && t.text == kwStr {
            let lineStart = vyxLineStartOffset(ba, t.line)
            let kwAt = vyxFirstNonWs(ba, lineStart, ba.length)
            let afterAt = kwAt + kwLen
            let boundary = afterAt >= ba.length || vyxIsWs(ba[afterAt]) || ba[afterAt] == '{'
            if boundary {
                let mut m = afterAt
                while m < ba.length && vyxIsWs(ba[m]) {
                    m = m + 1
                }
                if m < ba.length && ba[m] == '{' {
                    return VyxProps { found: true, malformed: false, kwAt: kwAt, braceAt: m }
                }
                return VyxProps { found: true, malformed: true, kwAt: kwAt, braceAt: 0 - 1 }
            }
        }
        i = i + 1
    }
    return VyxProps { found: false, malformed: false, kwAt: 0 - 1, braceAt: 0 - 1 }
}

/// The index just past the `}` matching the `{` at `open` (brace-depth match,
/// string-aware).
fn vyxMatchCurly(ba: Array<UInt8>, open: Int64) -> Int64 {
    let mut depth = 0
    let mut i = open
    while i < ba.length {
        let b = ba[i]
        if b == '"' {
            i = vyxScanQuote(ba, i, ba.length)
        } else if b == '{' {
            depth = depth + 1
            i = i + 1
        } else if b == '}' {
            depth = depth - 1
            i = i + 1
            if depth == 0 {
                return i
            }
        } else {
            i = i + 1
        }
    }
    return ba.length
}

/// The 1-based file line of the first `import` in `[sStart, sEnd)` that follows
/// the `kwStr` block, breaking the imports-first rule; 0
/// when there is none.
gen fn vyxImportsFirstViolation(ba: Array<UInt8>, sStart: Int64, sEnd: Int64, kwStr: String) -> Int64 {
    // `vyxFindKwBlock` offsets are relative to the section slice.
    let sub = bytes(vyxSlice(ba, sStart, sEnd))
    let blk = vyxFindKwBlock(sub, kwStr)
    if blk.found == false {
        return 0
    }
    let kwAt = sStart + blk.kwAt
    // Any `import` line whose first byte lies after the block keyword is misordered.
    let mut lineStart = sStart
    let mut i = sStart
    while i <= sEnd {
        if i == sEnd || ba[i] == '\n' {
            if lineStart > kwAt {
                let t = trim(vyxSlice(ba, lineStart, i))
                if t.startsWith("import ") {
                    return vyxLineAt(ba, lineStart)
                }
            }
            lineStart = i + 1
        }
        i = i + 1
    }
    return 0
}

/// The offset of the first non-whitespace byte in `[s, e)`, or `e` when all is
/// whitespace.
fn vyxFirstNonWs(ba: Array<UInt8>, s: Int64, e: Int64) -> Int64 {
    let mut i = s
    while i < e && vyxIsWs(ba[i]) {
        i = i + 1
    }
    return i
}

/// Parses a standalone component `<script>` string, positions relative to its
/// start. For the unit tests.
gen fn vyxParseScript(script: String, srcFile: String) -> VyxScript {
    let ba = bytes(script)
    return vyxParseScriptAt(ba, 0, ba.length, "props", "", srcFile)
}

/// The entries of the block body `ba[s..e)`, split at commas outside `<>`.
gen fn vyxParseProps(ba: Array<UInt8>, s: Int64, e: Int64, kw: String, srcFile: String) -> VyxScript {
    let mut props: Array<VyxProp> = []
    let mut depth = 0
    let mut start = s
    let mut i = s
    while i <= e {
        if i == e || (ba[i] == ',' && depth == 0) {
            let fs = vyxSkipWs(ba, start, i)
            if fs < i {
                let mut colon = fs
                while colon < i && ba[colon] != ':' {
                    colon = colon + 1
                }
                if colon == i {
                    return vyxScriptErr(vyxErr(srcFile, 0, "a `\{kw}` entry reads `name: Type`, and this one has no `:`"))
                }
                props.push(VyxProp { name: vyxSpanAt(ba, fs, colon), ty: vyxSpanAt(ba, colon + 1, i) })
            }
            start = i + 1
        } else if ba[i] == '<' {
            depth = depth + 1
        } else if ba[i] == '>' {
            depth = depth - 1
        }
        i = i + 1
    }
    return VyxScript { props: props, imports: [], helperLines: [], errs: [] }
}

/// Parses the `<script>` section `ba[sStart, sEnd)` at whole-file positions:
/// the single `kw { ... }` block (`props`, or a page's `params`), the import
/// lines, and every other line as a helper line. The lines of a `skip { ... }`
/// block (a layout's `head`) are left out; `skip` is "" for none.
export to "./vyx.editor" gen fn vyxParseScriptAt(ba: Array<UInt8>, sStart: Int64, sEnd: Int64, kw: String, skip: String, srcFile: String) -> VyxScript {
    // A relative offset `r` into `sub` is whole-file offset `sStart + r`.
    let sub = bytes(vyxSlice(ba, sStart, sEnd))
    let block = vyxFindKwBlock(sub, kw)
    let mut props: Array<VyxProp> = []
    let mut bodyEnd = 0 - 1
    let mut bodyStart = 0 - 1
    if block.found {
        if block.malformed {
            return vyxScriptErr(vyxErr(srcFile, 0, "the `\{kw}` block is not closed — write `\{kw} { name: Type, … }`"))
        }
        bodyStart = block.braceAt
        bodyEnd = vyxMatchCurly(sub, bodyStart)
        let more = vyxFindKwBlockFrom(sub, kw, bodyEnd)
        if more.found {
            return vyxScriptErr(vyxErr(srcFile, 0, "this component declares `\{kw}` more than once — one component has one `\{kw}` block"))
        }
        let parsed = vyxParseProps(ba, sStart + bodyStart + 1, sStart + bodyEnd - 1, kw, srcFile)
        if parsed.errs.length > 0 {
            return parsed
        }
        props = consume parsed.props
    }
    let skipped = if skip == "" { VyxProps { found: false, malformed: false, kwAt: 0 - 1, braceAt: 0 - 1 } } else { vyxFindKwBlock(sub, skip) }
    let skipEnd = if skipped.found && skipped.malformed == false { vyxMatchCurly(sub, skipped.braceAt) } else { 0 - 1 }
    let mut imports: Array<VyxSpan> = []
    let mut helperLines: Array<VyxSpan> = []
    let mut lineStart = 0
    let mut i = 0
    while i <= sub.length {
        if i == sub.length || sub[i] == '\n' {
            let lineEnd = if i > lineStart && sub[i - 1] == '\r' { i - 1 } else { i }
            // A line that overlaps a block is skipped.
            let inBlock = bodyStart >= 0 && lineStart < bodyEnd && lineEnd > block.kwAt
            let inSkip = skipEnd >= 0 && lineStart < skipEnd && lineEnd > skipped.kwAt
            if inBlock == false && inSkip == false {
                let line = vyxSpanAt(ba, sStart + lineStart, sStart + lineEnd)
                if line.text.startsWith("import ") {
                    imports.push(line)
                } else if line.text.byteLength > 0 {
                    helperLines.push(VyxSpan { text: vyxSlice(sub, lineStart, lineEnd), line: vyxLineAt(ba, sStart + lineStart), col: vyxColAt(ba, sStart + lineStart) })
                }
            }
            lineStart = i + 1
        }
        i = i + 1
    }
    return VyxScript { props: props, imports: imports, helperLines: helperLines, errs: [] }
}

/// A `kwStr` block search starting at `from` (for the second-block check).
gen fn vyxFindKwBlockFrom(ba: Array<UInt8>, kwStr: String, from: Int64) -> VyxProps {
    let mut sub: Array<UInt8> = []
    let mut i = from
    while i < ba.length {
        sub.push(ba[i])
        i = i + 1
    }
    let r = vyxFindKwBlock(sub, kwStr)
    if r.found {
        let braceAt = if r.braceAt < 0 { 0 - 1 } else { r.braceAt + from }
        return VyxProps { found: true, malformed: r.malformed, kwAt: r.kwAt + from, braceAt: braceAt }
    }
    return r
}

fn vyxScriptErr(e: VyxErr) -> VyxScript {
    return VyxScript { props: [], imports: [], helperLines: [], errs: [e.copy()] }
}

/// A script's helper lines as text, one per line.
fn vyxHelperText(sc: VyxScript) -> String {
    let mut out = ""
    for l in sc.helperLines {
        out = out + l.text + "\n"
    }
    return out
}

/// One parsed `.vyx` component. `src` holds the file its positions are in, spelled
/// as the generator read it.
type VyxComp = {
    name: String,
    fnName: String,
    src: VyxSource,
    script: VyxScript,
    root: VyxFlow,
    takesChildren: Bool,
    errs: Array<VyxErr>,
}

/// Whether any node in `nodes` (transitively) is `<slot/>`.
fn vyxUsesChildren(nodes: Array<VyxFlow>) -> Bool {
    for n in nodes {
        if vyxNodeUsesChildren(n) {
            return true
        }
    }
    return false
}

fn vyxNodeUsesChildren(n: VyxFlow) -> Bool {
    return match n {
        VNChildren => true,
        VNElem(t, c, a, kids, l) => vyxUsesChildren(kids),
        VNIf(conds, bodies, els, has) => vyxIfUsesChildren(bodies, els, has),
        VNFor(v, it, k, body, l, c) => vyxUsesChildren(body),
        VNText(s) => false,
        VNInterp(x) => false,
        VNRaw(x) => false,
    }
}

fn vyxIfUsesChildren(bodies: Array<VyxBody>, els: VyxBody, has: Bool) -> Bool {
    for b in bodies {
        if vyxUsesChildren(b.nodes) {
            return true
        }
    }
    if has {
        return vyxUsesChildren(els.nodes)
    }
    return false
}

/// The parsed `<template>` of a `.vyx` source: its top-level nodes in the tree
/// `std/vyx.syntax` writes, and in `err` the sentence of the row that stopped the
/// parse, or `""`.
export type VyxTemplate = { nodes: Array<vx.VyxNode>, err: String }

/// Parses the `<template>` section of the `.vyx` text `source` into its tree, for a
/// generator or a checker such as `std/vyx-hints`. It reads no props or imports,
/// resolves no component and groups no directive: `v-if`, `v-for` and `v-html` stay
/// attributes, a comment is no node, and `<slot/>` is an element. `err` is set when
/// `source` has no `<template>`, or it does not parse. Call it during generation only.
///
/// A generator that writes the outline of a template, saved as `outline.vyrn`:
///
/// ```vyrn
/// import { syntax } from "std/syntax"
/// import * as vx from syntax("std/vyx.syntax")
/// import { vyxParseTemplate } from "std/vyx"
///
/// /// ` :name` for each bound attribute in `attrs`.
/// gen fn bound(attrs: Array<vx.VyxAttr>) -> String {
///     let mut out = ""
///     for a in attrs {
///         if let Some(mark) = a.dyn {
///             out = out + " :" + a.name.text
///         }
///     }
///     return out
/// }
///
/// /// One line per element, depth first: its tag, its offset and bound attributes.
/// gen fn walk(nodes: Array<vx.VyxNode>) -> String {
///     let mut out = ""
///     for n in nodes {
///         if let VyxNodeVyxElem(e) = n {
///             out = out + e.tag.text + ":" + e.start.toString() + bound(e.attrs) + "\n"
///             if let Some(kids) = e.body {
///                 out = out + walk(kids.nodes)
///             }
///         }
///     }
///     return out
/// }
///
/// /// Writes `outlineOf() -> String`: the outline of `source`, or why it does
/// /// not parse.
/// export gen fn outline(source: String) -> Code {
///     let t = vyxParseTemplate(source)
///     let text = if t.err != "" { t.err.copy() } else { walk(t.nodes) }
///     return vyrn"export fn outlineOf() -> String { return \{text} }"
/// }
/// ```
///
/// A program that prints `ul:11` and `li:18 :class`:
///
/// ```vyrn
/// import { outline } from "./outline"
/// import { outlineOf } from outline("<template>\n<ul>\n  <li :class=\"c\">{{ x }}</li>\n</ul>\n</template>")
///
/// fn main() -> Int64 {
///     print(outlineOf())
///     return 0
/// }
/// ```
export gen fn vyxParseTemplate(source: String) -> VyxTemplate {
    let outline = vyxOutlineOf(source)
    let fault = vyxSectionFault(outline, source, "")
    if fault.length > 0 {
        return VyxTemplate { nodes: [], err: fault[0].message.copy() }
    }
    return match vx.parseVyxFile(source) {
        Ok(file) => vyxTemplateOf(consume file, source),
        Err(errors) => VyxTemplate { nodes: [], err: vyxSay(errors[0].row) },
    }
}

/// The nodes of the template of `file`, read from `source`, or the first fault a
/// compile would raise in them.
gen fn vyxTemplateOf(file: consume vx.VyxFile, source: String) -> VyxTemplate {
    let grouped = vyxGroupFile(file, VyxSource { path: "", bytes: bytes(source) })
    if grouped.errs.length > 0 {
        return VyxTemplate { nodes: [], err: grouped.errs[0].message.copy() }
    }
    if let Some(section) = consume file.template {
        return VyxTemplate { nodes: consume section.body.nodes, err: "" }
    }
    return VyxTemplate { nodes: [], err: vyxSay(NoTemplate) }
}

/// What is wrong with the sections of `o`, in the order a compile judges them.
fn vyxSectionFault(o: vx.VyxOutline, source: String, srcPath: String) -> Array<VyxErr> {
    let ba = bytes(source)
    if let Some(s) = o.script {
        if vyxScriptUnclosed(o) {
            return [vyxRow(srcPath, vyxLineAt(ba, s.start), ScriptUnclosed)]
        }
    }
    return match o.template {
        None => [vyxRow(srcPath, 0, NoTemplate)],
        Some(t) => if vyxTemplateUnclosed(o) { [vyxRow(srcPath, vyxLineAt(ba, t.start), TemplateUnclosed)] } else { [] },
    }
}

/// Compiles one `.vyx` source into a `VyxComp`; component calls are resolved
/// later, once every sibling name is known. `compName` is the file stem and
/// `dir` the directory the generator read it from.
gen fn vyxCompileComponent(compName: String, source: String, dir: String) -> VyxComp {
    return vyxCompileAt(source, compName, dir + "/" + compName + ".vyx", "props", "")
}

/// Compiles the `.vyx` text `source`, read from `srcPath`, into a `VyxComp` named
/// `compName`. `kw` names the parameter block (`props`, or a page's `params`)
/// and `skip` a block the script leaves out (a layout's `head`), "" for none.
gen fn vyxCompileAt(source: String, compName: String, srcPath: String, kw: String, skip: String) -> VyxComp {
    let ba = bytes(source)
    let fnName = vyxLowerFirst(compName)
    if vyxIsIdentifier(fnName) == false {
        // `My-Widget.vyx` or `404.vyx` would emit an invalid fn name, a lexer
        // error far from the cause.
        return vyxCompErr(compName, fnName, srcPath, [vyxErr(srcPath, 0, "`\{compName}.vyx` does not spell a legal view-function name — a component file's stem is one identifier (letters, digits or `_`, not digit-first), so rename the file")])
    }

    let outline = vyxOutlineOf(source)
    let fault = vyxSectionFault(outline, source, srcPath)
    if fault.length > 0 {
        return vyxCompErr(compName, fnName, srcPath, fault)
    }

    let mut script = VyxScript { props: [], imports: [], helperLines: [], errs: [] }
    if let Some(part) = outline.script {
        let bad = vyxImportsFirstViolation(ba, part.body.start, part.body.end, kw)
        if bad > 0 {
            return vyxCompErr(compName, fnName, srcPath, [vyxErr(srcPath, bad, "an `import` sits after the `\{kw}` block — every import goes at the top of `<script>`")])
        }
        script = vyxParseScriptAt(ba, part.body.start, part.body.end, kw, skip, srcPath)
        if script.errs.length > 0 {
            return vyxCompErr(compName, fnName, srcPath, script.errs)
        }
    }

    let src = VyxSource { path: srcPath.copy(), bytes: ba.copy() }
    let grouped = match vx.parseVyxFile(source) {
        Ok(file) => vyxGroupFile(file, src),
        Err(errors) => VyxGroup { nodes: [], errs: [vyxRow(srcPath, errors[0].line, errors[0].row)] },
    }
    if grouped.errs.length > 0 {
        return vyxCompErr(compName, fnName, srcPath, grouped.errs)
    }
    // Exactly one root element; only whitespace-only text is exempt.
    let roots = vyxElementRoots(consume grouped.nodes)
    if roots.length == 0 {
        return vyxCompErr(compName, fnName, srcPath, [vyxRow(srcPath, 0, NoElement)])
    }
    if roots.length > 1 {
        return vyxCompErr(compName, fnName, srcPath, [vyxRow(srcPath, vyxRootLine(roots), ManyRoots)])
    }
    // A lone non-whitespace text run is no element either.
    let rootIsText = match roots[0] {
        VNElem(_, _, _, _, _) => false,
        VNText(_) => true,
        VNInterp(_) => false,
        VNRaw(_) => false,
        VNChildren => false,
        VNIf(_, _, _, _) => false,
        VNFor(_, _, _, _, _, _) => false,
    }
    if rootIsText {
        return vyxCompErr(compName, fnName, srcPath, [vyxRow(srcPath, 0, NoElement)])
    }
    // The root moves into the component (`VyxFlow` has no `copy`), so the flag
    // that reads it is computed first.
    let mut root = VNChildren
    for r in consume roots {
        root = r
    }
    // The node itself, not `[root]`: an array literal would take the root.
    let takesChildren = vyxNodeUsesChildren(root)
    return VyxComp { name: compName.copy(), fnName: fnName, src: src, script: script, root: root, takesChildren: takesChildren, errs: [] }
}

/// The control flow of `file`, once each element closed under its own name. A close
/// tag that closes nothing is a stray: the tree stops at it, and the text after it
/// belongs to no element.
gen fn vyxGroupFile(file: vx.VyxFile, src: VyxSource) -> VyxGroup {
    if let Some(section) = file.template {
        if let Some(fault) = vyxCloseFault(section.body.nodes, src) {
            return VyxGroup { nodes: [], errs: [fault] }
        }
        if let Some(stray) = section.body.stray {
            let line = vyxLineAt(src.bytes, stray.start)
            return VyxGroup { nodes: [], errs: [vyxRow(src.path, line, StrayClose(stray.name.text.copy()))] }
        }
        return vyxGroupNodes(section.body.nodes, src)
    }
    return VyxGroup { nodes: [], errs: [vyxRow(src.path, 0, NoTemplate)] }
}

/// The top-level nodes except whitespace-only text. Every one counts toward
/// the one-root rule, so a stray word is a diagnostic, not dropped content.
fn vyxElementRoots(nodes: consume Array<VyxFlow>) -> Array<VyxFlow> {
    let mut out: Array<VyxFlow> = []
    for n in consume nodes {
        let keep = match n {
            VNText(s) => trim(s).byteLength > 0,
            VNElem(tag, isComp, attrs, kids, l) => true,
            VNInterp(x) => true,
            VNRaw(x) => true,
            VNChildren => true,
            VNIf(cc, bb, ee, hh) => true,
            VNFor(v, it, kk, bd, l, c) => true,
        }
        if keep {
            out.push(n)
        }
    }
    return out
}

/// The line of the second root, for the multiple-roots diagnostic.
fn vyxRootLine(roots: Array<VyxFlow>) -> Int64 {
    return match roots[1] {
        VNElem(t, c, a, k, l) => l,
        VNInterp(x) => x.line,
        VNRaw(x) => x.line,
        VNFor(v, it, kk, bd, l, c) => l,
        VNChildren => 0,
        VNText(s) => 0,
        VNIf(cc, bb, ee, hh) => 0,
    }
}

fn vyxCompErr(name: String, fnName: String, srcPath: String, errs: Array<VyxErr>) -> VyxComp {
    return VyxComp { name: name.copy(), fnName: fnName.copy(), src: VyxSource { path: srcPath.copy(), bytes: [] }, script: VyxScript { props: [], imports: [], helperLines: [], errs: [] }, root: VNText(""), takesChildren: false, errs: errs.copy() }
}

/// `s`, copied from `src` where it stands.
gen fn vyxCopy(src: String, s: VyxSpan) -> Code {
    return codeAt(src, s.line, s.col, s.text)
}

/// The bytes `[a, b)` of span `s`, copied from `src`.
gen fn vyxCopyPart(src: String, s: VyxSpan, a: Int64, b: Int64) -> Code {
    return vyxCopy(src, vyxSpanIn(s.text, s.line, s.col, a, vyxSlice(bytes(s.text), a, b)))
}

// Code generation: a post-order walk emitting `std/html` calls. Every element
// fills a `mut Array<Html>` accumulator named by its tree path, so `v-if`,
// `v-for` and `<slot/>` lower to plain pushes. Each statement that carries
// template text shows its errors at that text's `.vyx` position. A finding goes
// to `errs`; a provider tag's import, found inside a view, goes to `imports`.

/// The components a capitalized tag can resolve to: sibling `names` first, then
/// the provider names in `imported`. When `themed`, every `class`
/// goes through `vyxTheme.cls(...)` instead of `Cls(...)`.
type VyxRegistry = { names: Array<String>, imported: Array<String>, comps: Array<VyxComp>, themed: Bool }

fn vyxLookup(reg: VyxRegistry, name: String) -> Int64 {
    let mut i = 0
    while i < reg.names.length {
        if reg.names[i] == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

gen fn vyxEmitChildren(nodes: Array<VyxFlow>, acc: String, path: String, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let mut stmts: Array<Code> = []
    let mut j = 0
    for n in nodes {
        stmts.push(vyxEmitPush(n, acc, path + "_" + j.toString(), reg, src, errs, imports))
        j = j + 1
    }
    return join(stmts, vyrn"\n")
}

gen fn vyxEmitPush(n: VyxFlow, acc: String, path: String, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let a = name(acc)
    return match n {
        VNText(s) => vyrn"\{a}.push(text(\{s}))",
        VNInterp(x) => at(vyrn"\{a}.push(text((\{vyxCopy(src.path, x)}).toString()))", src.path, x.line, x.col),
        VNRaw(x) => at(vyrn"\{a}.push(Raw((\{vyxCopy(src.path, x)}).copy()))", src.path, x.line, x.col),
        VNChildren => vyxSlotPush(acc),
        VNElem(tag, isComp, attrs, kids, l) => vyxEmitElem(tag, isComp, attrs, kids, l, acc, path, reg, src, errs, imports),
        VNIf(conds, bodies, els, has) => vyxEmitIf(conds, bodies, els, has, acc, path, reg, src, errs, imports),
        VNFor(v, it, k, body, l, c) => vyxEmitFor(v, it, k, body, l, c, acc, path, reg, src, errs, imports),
    }
}

/// `<slot/>`: the children move into `acc`.
gen fn vyxSlotPush(acc: String) -> Code {
    return vyrn"""
        for vyxCh in consume children {
            \{name(acc)}.push(vyxCh)
        }
        """
}

gen fn vyxEmitElem(tag: String, isComp: Bool, attrs: Array<vx.VyxAttr>, kids: Array<VyxFlow>, line: Int64, acc: String, path: String, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    if isComp {
        return vyxEmitComp(tag, attrs, kids, line, acc, path, reg, src, errs, imports)
    }
    let kacc = name("k" + path)
    let body = vyxEmitChildren(kids, "k" + path, path, reg, src, errs, imports)
    // Expression-bearing attributes are hoisted onto their own `let`
    // bindings (`pre`), so a type error shows at the `.vyx` column.
    let mut pre: Array<Code> = []
    let list = vyxEmitAttrs(attrs, reg, src, "k" + path, pre, errs)
    let hoisted = join(pre, vyrn"\n")
    return vyrn"""
        let mut \{kacc}: Array<Html> = []
        \{body}
        \{hoisted}
        \{name(acc)}.push(el(\{tag}, [\{list}], \{kacc}))
        """
}

/// Emits a component call, resolving props by name against the component's
/// declaration and passing `<slot/>` content when it accepts children. Each
/// argument shows its errors at its attribute.
gen fn vyxEmitComp(tag: String, attrs: Array<vx.VyxAttr>, kids: Array<VyxFlow>, line: Int64, acc: String, path: String, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let idx = vyxLookup(reg, tag)
    if idx < 0 {
        // No sibling `.vyx` answers the tag; an imported name is a provider.
        if includes(reg.imported, tag) {
            return vyxEmitProvider(tag, attrs, kids, line, acc, path, src, errs, imports)
        }
        errs.push(vyxErr(src.path, line, "`<\{tag}>` names no component — a component is a `.vyx` file in the same directory, or a generation-time provider a `<script>` imports"))
        return vyrn"\{name(acc)}.push(empty())"
    }
    let comp = reg.comps[idx]
    let mut args: Array<Code> = []
    for p in comp.script.props {
        let pn = p.name.text.copy()
        let av = vyxDir(src.bytes, attrs, pn)
        if av.found == false {
            errs.push(vyxErr(src.path, line, "`<\{tag}>` is given no `\{pn}`, which its `props` block declares — every prop is required"))
            args.push(vyrn"empty()")
        } else if av.dyn {
            args.push(at(codeAt(src.path, av.line, av.col, av.value), src.path, av.line, av.col))
        } else {
            args.push(at(vyrn"\{av.value}", src.path, av.line, av.col))
        }
    }
    for a in attrs {
        let line = vyxAttrValue(src.bytes, a).line
        let n = a.name.text
        if vyxEvt(a) {
            errs.push(vyxErr(src.path, line, "`<\{tag}>` is given the event `@\{n}` — a component takes props, and an event binds on a plain element"))
        } else if vyxHasProp(comp.script.props, n) == false {
            errs.push(vyxErr(src.path, line, "`<\{tag}>` has no prop `\{n}` — its `props` block decides what it takes"))
        }
    }
    let hasKids = trim(vyxChildText(kids)).byteLength > 0 || kids.length > 0
    if comp.takesChildren {
        let kacc = name("k" + path)
        let body = vyxEmitChildren(kids, "k" + path, path, reg, src, errs, imports)
        args.push(vyrn"\{kacc}")
        let call = vyxCompCall(acc, comp.fnName, args)
        return vyrn"""
            let mut \{kacc}: Array<Html> = []
            \{body}
            \{call}
            """
    }
    if hasKids {
        errs.push(vyxErr(src.path, line, "`<\{tag}>` is given children, and its `<template>` has no `<slot/>` to put them in"))
    }
    return vyxCompCall(acc, comp.fnName, args)
}

/// `<acc>.push(<view>(<args>))`, each argument on its own line, so an error
/// a column cannot place still finds its attribute by the line.
gen fn vyxCompCall(acc: String, view: String, args: Array<Code>) -> Code {
    let mut lines: Array<Code> = []
    for a in args {
        lines.push(a + vyrn",")
    }
    let list = join(lines, vyrn"\n")
    return vyrn"""
        \{name(acc)}.push(\{name(view)}(
            \{list}
        ))
        """
}

/// Whether `props` declares `name`.
fn vyxHasProp(props: Array<VyxProp>, name: String) -> Bool {
    for p in props {
        if p.name.text == name {
            return true
        }
    }
    return false
}

/// Emits one provider tag: the nested generator import that runs provider `tag`
/// with the tag's static attributes, and the call that splices its output.
/// `:attr`, `@event` and children are refused at their own line: an expression
/// cannot be a generator argument, and a provider's tree comes from its
/// attributes.
gen fn vyxEmitProvider(tag: String, attrs: Array<vx.VyxAttr>, kids: Array<VyxFlow>, line: Int64, acc: String, path: String, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let before = errs.length
    for a in attrs {
        let at = vyxAttrValue(src.bytes, a).line
        let n = a.name.text
        if vyxEvt(a) {
            errs.push(vyxErr(src.path, at, "`<\{tag}>` is a generation-time provider, and `@\{n}` binds a handler — a provider's attributes become constant arguments to a generator, so a provider tag takes static attributes only"))
        } else if vyxDyn(a) {
            errs.push(vyxErr(src.path, at, "`<\{tag}>` is a generation-time provider, and `:\{n}` binds an expression — a provider's attributes become constant arguments to a generator, so write `\{n}=\"…\"` as a static attribute, or wrap `<\{tag}>` in a sibling `.vyx` component that computes it"))
        }
    }
    if kids.length > 0 {
        errs.push(vyxErr(src.path, line, "`<\{tag}>` is given children, and it is a generation-time provider — a provider's tree comes from its attributes alone, so it takes none"))
    }
    if errs.length > before {
        return vyrn"\{name(acc)}.push(empty())"
    }
    // The provider reports at this `.vyx` file and the tag's line; the column is
    // always 1. Its import shows a loader error at the tag.
    let ns = name(vyxProvNs(src.path, path))
    let json = vyxProvAttrs(src.bytes, attrs)
    imports.push(at(vyrn"import * as \{ns} from \{name(tag)}(\{json}, \{src.path}, \{line}, 1)", src.path, line, 1))
    return vyrn"\{name(acc)}.push(\{ns}.provide())"
}

/// The namespace alias minted for one provider tag. Components share one flat
/// import namespace, so the alias is the component's source path plus the
/// node's tree path: unique across the set and stable between runs.
fn vyxProvNs(src: String, path: String) -> String {
    return "vyxp_" + vyxIdentBytes(src) + "_" + path
}

/// `s` with every byte outside `[A-Za-z0-9_]` replaced by `_`, so a file path can
/// be part of an identifier.
fn vyxIdentBytes(s: String) -> String {
    let mut out: Array<UInt8> = []
    for b in bytes(s) {
        if vyxIsIdent(b) {
            out.push(b)
        } else {
            out.push('_')
        }
    }
    return fromBytesOr(out, "x")
}

/// A provider tag's static attributes as a JSON object in source order, `{}`
/// when there are none. Dynamic and event attributes were refused before this.
fn vyxProvAttrs(ba: Array<UInt8>, attrs: Array<vx.VyxAttr>) -> String {
    let mut fs: Array<JsonField> = []
    for a in attrs {
        if vyxEvt(a) == false && vyxDyn(a) == false {
            fs.push(JsonField { key: a.name.text.copy(), value: JStr(vyxAttrValue(ba, a).text) })
        }
    }
    return emit(JObj(fs))
}

/// The non-whitespace text of the paired children: a coarse signal to reject
/// children on a childless component.
fn vyxChildText(kids: Array<VyxFlow>) -> String {
    let mut out = ""
    for n in kids {
        out = out + match n {
            VNText(s) => s,
            VNInterp(x) => "x",
            VNRaw(x) => "x",
            VNChildren => "c",
            VNElem(t, c, a, k, l) => "e",
            VNIf(cc, bb, ee, hh) => "i",
            VNFor(v, it, kk, bd, l, c) => "f",
        }
    }
    return out
}

/// Emits a `v-if` chain: each branch fills its own accumulator, then splices
/// into `acc`; a missing `v-else` pushes nothing. Each condition shows its
/// errors at its own `.vyx` column.
gen fn vyxEmitIf(conds: Array<VyxSpan>, bodies: Array<VyxBody>, els: VyxBody, has: Bool, acc: String, path: String, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let mut arms: Array<Code> = []
    let mut bi = 0
    while bi < conds.length {
        let bacc = "k" + path + "_b" + bi.toString()
        let inner = vyxEmitChildren(bodies[bi].nodes, bacc, path + "_b" + bi.toString(), reg, src, errs, imports)
        let cond = at(vyxCopy(src.path, conds[bi]), src.path, conds[bi].line, conds[bi].col)
        arms.push(arm(cond, vyxBranch(bacc, inner, acc)))
        bi = bi + 1
    }
    if has {
        let eacc = "k" + path + "_be"
        let inner = vyxEmitChildren(els.nodes, eacc, path + "_be", reg, src, errs, imports)
        return ifChainOr(arms, vyxBranch(eacc, inner, acc))
    }
    return ifChain(arms)
}

/// One branch: fill `bacc` with `inner`, then splice it into `acc`.
gen fn vyxBranch(bacc: String, inner: Code, acc: String) -> Code {
    return vyrn"""
        let mut \{name(bacc)}: Array<Html> = []
        \{inner}
        for vyxN in consume \{name(bacc)} {
            \{name(acc)}.push(vyxN)
        }
        """
}

/// Emits a `v-for` loop: each iteration fills a fresh accumulator, spliced into
/// `acc` with a `Key`. The iterable and the key show their errors at their own
/// `.vyx` positions; the variable is the header's first word.
gen fn vyxEmitFor(v: String, it: VyxSpan, key: VyxSpan, body: Array<VyxFlow>, line: Int64, col: Int64, acc: String, path: String, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let facc = name("k" + path + "_f")
    let inner = vyxEmitChildren(body, "k" + path + "_f", path + "_f", reg, src, errs, imports)
    let each = codeAt(src.path, line, col, v)
    let iter = at(vyxCopy(src.path, it), src.path, it.line, it.col)
    let push = at(vyrn"\{name(acc)}.push(keyed((\{vyxCopy(src.path, key)}).toString(), vyxN))", src.path, key.line, key.col)
    return vyrn"""
        for \{each} in \{iter} {
            let mut \{facc}: Array<Html> = []
            \{inner}
            for vyxN in consume \{facc} {
                \{push}
            }
        }
        """
}

/// Emits the `Attr` constructors for a tag: `class` -> `Cls` (or `vyxTheme.cls`
/// when themed), `@event` -> `On`, others -> `A(name, value)`. Every
/// expression-bearing attribute is hoisted into its own `let` in `pre`, named
/// from `clsBase`; static attributes stay inline in the list it returns.
gen fn vyxEmitAttrs(attrs: Array<vx.VyxAttr>, reg: VyxRegistry, src: VyxSource, clsBase: String, pre: modify Array<Code>, errs: modify Array<VyxErr>) -> Code {
    let mut parts: Array<Code> = []
    let mut ai = 0
    for a in attrs {
        let slot = name(clsBase + "_a" + ai.toString())
        let n = a.name.text
        let v = vyxAttrValue(src.bytes, a)
        let dyn = vyxDyn(a)
        if vyxEvt(a) {
            parts.push(vyxEmitEvent(a, src, slot, pre, errs))
        } else if n == "class" && reg.themed {
            // Themed class: a static literal is checked against `Tw` at
            // compile time, a dynamic one at run time.
            let cv = if dyn { vyxCopy(src.path, v) } else { vyrn"\{v.text}" }
            pre.push(at(vyrn"let \{slot}: Attr = vyxTheme.cls(\{cv})", src.path, v.line, v.col))
            parts.push(vyrn"\{slot}")
        } else if n == "class" && dyn {
            pre.push(at(vyrn"let \{slot}: Attr = Cls((\{vyxCopy(src.path, v)}).copy())", src.path, v.line, v.col))
            parts.push(vyrn"\{slot}")
        } else if n == "class" {
            parts.push(vyrn"Cls(\{v.text})")
        } else if dyn {
            pre.push(at(vyrn"let \{slot}: Attr = A(\{n}, (\{vyxCopy(src.path, v)}).copy())", src.path, v.line, v.col))
            parts.push(vyrn"\{slot}")
        } else {
            parts.push(vyrn"A(\{n}, \{v.text})")
        }
        ai = ai + 1
    }
    return join(parts, vyrn", ")
}

/// Emits `@event="handler(scalar)"` as `On(event, "handler", payload)`: one
/// handler name and at most one scalar argument. With an argument it hoists the
/// binding `slot` into `pre`, showing errors at the argument.
gen fn vyxEmitEvent(a: vx.VyxAttr, src: VyxSource, slot: Name, pre: modify Array<Code>, errs: modify Array<VyxErr>) -> Code {
    let value = vyxAttrValue(src.bytes, a)
    let n = a.name.text
    let spec = value.text.copy()
    let sb = bytes(spec)
    let paren = vyxFind(sb, bytes("("), 0)
    if paren < 0 {
        if vyxIsIdentifier(spec) == false {
            errs.push(vyxErr(src.path, value.line, "`@\{n}` names no handler — write `@\{n}=\"handler\"` or `@\{n}=\"handler(arg)\"`"))
            return vyrn"On(\{n}, \"\", \"\")"
        }
        return vyrn"On(\{n}, \{spec}, \"\")"
    }
    let handler = trim(vyxSlice(sb, 0, paren))
    if vyxIsIdentifier(handler) == false {
        errs.push(vyxErr(src.path, value.line, "`@\{n}` names no handler — the text before `(` must be one identifier"))
        return vyrn"On(\{n}, \"\", \"\")"
    }
    let closeParen = vyxFindLast(sb, bytes(")"), paren)
    if closeParen < 0 {
        // A missing `)` would slice to "" and compile a zero-argument handler.
        errs.push(vyxErr(src.path, value.line, "`@\{n}` has an unterminated `(` — write `@\{n}=\"handler\"` or `@\{n}=\"handler(arg)\"`"))
        return vyrn"On(\{n}, \"\", \"\")"
    }
    let argExpr = trim(vyxSlice(sb, paren + 1, closeParen))
    if argExpr.byteLength == 0 {
        return vyrn"On(\{n}, \{handler}, \"\")"
    }
    if vyxHasTopComma(bytes(argExpr)) {
        errs.push(vyxErr(src.path, value.line, "`@\{n}` passes more than one argument — a handler crosses to the host, and it takes at most one scalar"))
        return vyrn"On(\{n}, \{handler}, \"\")"
    }
    let arg = vyxSpanIn(spec, value.line, value.col, vyxSkipWs(sb, paren + 1, sb.length), argExpr)
    pre.push(at(vyrn"let \{slot}: Attr = On(\{n}, \{handler}, (\{vyxCopy(src.path, arg)}).toString())", src.path, arg.line, arg.col))
    return vyrn"\{slot}"
}

/// Whether `s` is a single Vyrn identifier (letters, digits, `_`; not
/// digit-first).
export to "./vyx.editor" fn vyxIsIdentifier(s: String) -> Bool {
    let ba = bytes(s)
    if ba.length == 0 {
        return false
    }
    if ba[0] >= '0' && ba[0] <= '9' {
        return false
    }
    for b in ba {
        if vyxIsIdent(b) == false {
            return false
        }
    }
    return true
}

/// Whether `ba` has a comma at paren/bracket depth 0 (more than one argument).
/// `<` and `>` are comparisons, not brackets: counting them hid the comma in
/// `pick(a > b, c)` and emitted a call that does not parse.
fn vyxHasTopComma(ba: Array<UInt8>) -> Bool {
    let mut depth = 0
    let mut i = 0
    while i < ba.length {
        let b = ba[i]
        if b == '(' || b == '[' {
            depth = depth + 1
        } else if b == ')' || b == ']' {
            depth = depth - 1
        } else if b == '"' {
            i = vyxScanQuote(ba, i, ba.length) - 1
        } else if b == ',' && depth == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// Imports: every import line is copied from its `.vyx`, so its `import` keyword
// keeps its writer and a relative path resolves beside that file. A name already
// imported from the same specifier is dropped from a later line, an
// `import * as ns` repeats by (ns, spec), and one name imported from two
// specifiers is a diagnostic naming both files.

/// One parsed import line. `names` are the selective import's entries, each
/// at byte offsets `[starts[i], ends[i])` of the line; `alias` is a namespace
/// import's name and `spec` the source after ` from `, the dedup and conflict
/// key. `ok` is false for an unrecognized shape, copied whole.
type VyxImport = { ns: Bool, ok: Bool, names: Array<String>, starts: Array<Int64>, ends: Array<Int64>, alias: String, spec: String }

/// Parses `import { A, B } from <spec>` or `import * as ns from <spec>`.
fn vyxParseImport(line: String) -> VyxImport {
    let ba = bytes(line)
    let fromAt = vyxFind(ba, bytes(" from "), 0)
    if fromAt < 0 {
        return VyxImport { ns: false, ok: false, names: [], starts: [], ends: [], alias: "", spec: "" }
    }
    let spec = trim(vyxSlice(ba, fromAt + 6, ba.length))
    let head = trim(vyxSlice(ba, 0, fromAt))
    if head.startsWith("import * as ") {
        let alias = trim(vyxSlice(bytes(head), 12, bytes(head).length))
        return VyxImport { ns: true, ok: true, names: [], starts: [], ends: [], alias: alias, spec: spec }
    }
    let braceOpen = vyxFind(ba, bytes("{"), 0)
    let braceClose = vyxFindLast(bytes(vyxSlice(ba, 0, fromAt)), bytes("}"), 0)
    if braceOpen < 0 || braceClose <= braceOpen {
        return VyxImport { ns: false, ok: false, names: [], starts: [], ends: [], alias: "", spec: spec }
    }
    let mut names: Array<String> = []
    let mut starts: Array<Int64> = []
    let mut ends: Array<Int64> = []
    let mut depth = 0
    let mut s = braceOpen + 1
    let mut i = s
    while i <= braceClose {
        if i == braceClose || (ba[i] == ',' && depth == 0) {
            let part = vyxSpanAt(ba, s, i)
            if part.text.byteLength > 0 {
                let at = vyxSkipWs(ba, s, i)
                names.push(part.text.copy())
                starts.push(at)
                ends.push(at + part.text.byteLength)
            }
            s = i + 1
        } else if ba[i] == '<' {
            depth = depth + 1
        } else if ba[i] == '>' {
            depth = depth - 1
        }
        i = i + 1
    }
    return VyxImport { ns: false, ok: true, names: names, starts: starts, ends: ends, alias: "", spec: spec }
}

/// The name a line's import binds that `skip` may hold: a namespace alias, or
/// the last word before ` from ` of an unrecognized shape.
fn vyxImportKey(line: String, imp: VyxImport) -> String {
    if imp.ns {
        return imp.alias.copy()
    }
    let fromAt = vyxFind(bytes(line), bytes(" from "), 0)
    return vyxLastIdent(vyxSlice(bytes(line), 0, if fromAt < 0 { 0 } else { fromAt }))
}

/// The diagnostics of a component set's imports: a namespace alias bound to
/// two specifiers, or one name imported from two.
fn vyxImportConflicts(comps: Array<VyxComp>) -> Array<VyxErr> {
    let mut nsAlias: Array<String> = []
    let mut nsSpec: Array<String> = []
    let mut cName: Array<String> = []
    let mut cSpec: Array<String> = []
    let mut cFile: Array<String> = []
    let mut errs: Array<VyxErr> = []
    for c in comps {
        for sp in c.script.imports {
            let imp = vyxParseImport(sp.text)
            if imp.ok && imp.ns {
                let k = vyxIndexOf(nsAlias, imp.alias)
                if k < 0 {
                    nsAlias.push(imp.alias.copy())
                    nsSpec.push(imp.spec.copy())
                } else if nsSpec[k] != imp.spec {
                    errs.push(vyxErrHere(
                        "`\{c.src.path}` imports `\{imp.alias}` from `\{imp.spec}`, and a sibling component already binds that name to `\{nsSpec[k]}` — one namespace alias reaches one module across the whole set, so rename one of them",
                    ))
                }
            } else if imp.ok {
                for nm in imp.names {
                    let k = vyxIndexOf(cName, nm)
                    if k < 0 {
                        cName.push(nm.copy())
                        cSpec.push(imp.spec.copy())
                        cFile.push(c.src.path.copy())
                    } else if cSpec[k] != imp.spec {
                        errs.push(vyxErrHere(
                            "`\{cFile[k]}` and `\{c.src.path}` both import `\{nm}`, from `\{cSpec[k]}` and `\{imp.spec}` — the components share one flat namespace, so one name comes from one module",
                        ))
                    }
                }
            }
        }
    }
    return errs
}

/// The index of the first `s` in `xs`, or -1.
fn vyxIndexOf(xs: Array<String>, s: String) -> Int64 {
    let mut i = 0
    while i < xs.length {
        if xs[i] == s {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// The import block of a component set, each line copied from its `.vyx`:
/// selective imports in first-seen specifier order, each line without the
/// names an earlier line already imported from its specifier or `skip` holds;
/// then each namespace alias's first line, then the other shapes, each once.
/// A line whose names all go is dropped.
gen fn vyxCopyImports(comps: Array<VyxComp>, skip: Array<String>) -> Code {
    let mut specs: Array<String> = []
    for c in comps {
        for sp in c.script.imports {
            let imp = vyxParseImport(sp.text)
            if imp.ok && imp.ns == false && includes(specs, imp.spec) == false {
                specs.push(imp.spec.copy())
            }
        }
    }
    let mut out: Array<Code> = []
    for spec in specs {
        let mut taken = skip.copy()
        for c in comps {
            for sp in c.script.imports {
                let imp = vyxParseImport(sp.text)
                if imp.ok && imp.ns == false && imp.spec == spec {
                    let mut keep: Array<Int64> = []
                    let mut k = 0
                    while k < imp.names.length {
                        if includes(taken, imp.names[k]) == false {
                            taken.push(imp.names[k].copy())
                            keep.push(k)
                        }
                        k = k + 1
                    }
                    if keep.length > 0 {
                        out.push(vyxCopyImport(c.src.path, sp, imp, keep))
                    }
                }
            }
        }
    }
    let mut aliases = skip.copy()
    let mut shapes: Array<String> = []
    for c in comps {
        for sp in c.script.imports {
            let imp = vyxParseImport(sp.text)
            if imp.ok == false || imp.ns {
                let key = vyxImportKey(sp.text, imp)
                if imp.ns && includes(aliases, key) == false {
                    aliases.push(key)
                    out.push(vyxCopyTail(c.src.path, sp, 0))
                } else if imp.ok == false && includes(shapes, sp.text) == false && includes(skip, key) == false {
                    shapes.push(sp.text.copy())
                    out.push(vyxCopyTail(c.src.path, sp, 0))
                }
            }
        }
    }
    return join(out, vyrn"\n")
}

/// The selective import line `sp`, parsed as `imp`, copied with only its
/// names at the indices `keep`: each name with the separator before it in the
/// line, every byte from `src`.
gen fn vyxCopyImport(src: String, sp: VyxSpan, imp: VyxImport, keep: Array<Int64>) -> Code {
    if keep.length == imp.names.length {
        return vyxCopyTail(src, sp, 0)
    }
    let mut out = vyxCopyPart(src, sp, 0, imp.starts[0])
    let mut first = true
    for k in keep {
        if first == false {
            out = out + vyxCopyPart(src, sp, imp.ends[k - 1], imp.starts[k])
        }
        out = out + vyxCopyPart(src, sp, imp.starts[k], imp.ends[k])
        first = false
    }
    return out + vyxCopyTail(src, sp, imp.ends[imp.names.length - 1])
}

/// The import line `sp` from byte `from` on, copied from `src`. A generator
/// call's relative path argument resolves beside the importing file, not
/// beside its writer, so it is written as that path joined to `src`'s
/// directory.
gen fn vyxCopyTail(src: String, sp: VyxSpan, from: Int64) -> Code {
    let ba = bytes(sp.text)
    let fromAt = vyxFind(ba, bytes(" from "), 0)
    let source = if fromAt < 0 { ba.length } else { vyxSkipWs(ba, fromAt + 6, ba.length) }
    let q1 = vyxFind(ba, bytes("\""), source)
    let q2 = if q1 < 0 { 0 - 1 } else { vyxFind(ba, bytes("\""), q1 + 1) }
    let isCall = source < ba.length && ba[source] != '"'
    if isCall == false || q2 < 0 {
        return vyxCopyPart(src, sp, from, ba.length)
    }
    let arg = vyxSlice(ba, q1 + 1, q2)
    if arg.startsWith("./") == false && arg.startsWith("../") == false {
        return vyxCopyPart(src, sp, from, ba.length)
    }
    let joined = vyxDirOf(src) + "/" + arg
    return vyxCopyPart(src, sp, from, q1) + vyrn"\{joined}" + vyxCopyPart(src, sp, q2 + 1, ba.length)
}

/// A component's view: `fn name(<props>, <extra>, children: Array<Html>) ->
/// Html`, its props copied from the `.vyx`, the synthesized parameters `extra`
/// after them, and `children` only when the template uses `<slot/>`.
gen fn vyxEmitComponent(comp: VyxComp, reg: VyxRegistry, extra: Array<Code>, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let mut params: Array<Code> = []
    for p in comp.script.props {
        params.push(vyrn"\{vyxCopy(comp.src.path, p.name)}: \{vyxCopy(comp.src.path, p.ty)}")
    }
    for x in extra {
        params.push(x)
    }
    if comp.takesChildren {
        // The slot splice moves the children into the view's accumulator.
        params.push(vyrn"children: consume Array<Html>")
    }
    let list = join(params, vyrn", ")
    let body = vyxEmitRoot(comp.root, reg, comp.src, errs, imports)
    return vyrn"""
        export fn \{name(comp.fnName)}(\{list}) -> Html {
            \{body}
        }
        """
}

gen fn vyxEmitRoot(root: VyxFlow, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    return match root {
        VNElem(tag, isComp, attrs, kids, l) => vyxEmitRootElem(tag, isComp, attrs, kids, l, reg, src, errs, imports),
        VNText(s) => vyrn"return text(\{s})",
        VNInterp(x) => at(vyrn"return text((\{vyxCopy(src.path, x)}).toString())", src.path, x.line, x.col),
        VNRaw(x) => at(vyrn"return Raw(\{vyxCopy(src.path, x)})", src.path, x.line, x.col),
        VNChildren => vyxRootSlot(),
        VNIf(cc, bb, ee, hh) => vyxEmitRootWrap(root, reg, src, errs, imports),
        VNFor(v, it, k, bd, l, c) => vyxEmitRootWrap(root, reg, src, errs, imports),
    }
}

/// A root `<slot/>`: the children in a `<div>`.
gen fn vyxRootSlot() -> Code {
    return vyrn"""
        let mut kr: Array<Html> = []
        for vyxCh in consume children {
            kr.push(vyxCh)
        }
        return el("div", [], kr)
        """
}

gen fn vyxEmitRootElem(tag: String, isComp: Bool, attrs: Array<vx.VyxAttr>, kids: Array<VyxFlow>, line: Int64, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    if isComp {
        let pushed = vyxEmitComp(tag, attrs, kids, line, "kr", "r", reg, src, errs, imports)
        return vyrn"""
            let mut kr: Array<Html> = []
            \{pushed}
            return kr[0]
            """
    }
    let body = vyxEmitChildren(kids, "kr", "r", reg, src, errs, imports)
    let mut pre: Array<Code> = []
    let list = vyxEmitAttrs(attrs, reg, src, "kr", pre, errs)
    let hoisted = join(pre, vyrn"\n")
    return vyrn"""
        let mut kr: Array<Html> = []
        \{body}
        \{hoisted}
        return el(\{tag}, [\{list}], kr)
        """
}

/// A root that is a bare `v-if` or `v-for`, pushed into a `<div>` wrapper.
gen fn vyxEmitRootWrap(root: VyxFlow, reg: VyxRegistry, src: VyxSource, errs: modify Array<VyxErr>, imports: modify Array<Code>) -> Code {
    let pushed = vyxEmitPush(root, "kr", "r", reg, src, errs, imports)
    return vyrn"""
        let mut kr: Array<Html> = []
        \{pushed}
        return el("div", [], kr)
        """
}

/// Assembles the synthesized module. When `themed`, it imports the theme
/// `theme` (resolved like `dir`) and routes every `class` through
/// `vyxTheme.cls(...)`. `extra` are synthesized view parameters, for the one
/// view of a page, layout or error module; `page` renames a page's accessors
/// and exports its `type Data`; `skip` names imports the module leaves out.
/// A finding goes to `errs`, and the result is then incomplete.
gen fn vyxBuildModule(comps: consume Array<VyxComp>, themed: Bool, theme: String, extra: Array<Code>, page: Bool, skip: Array<String>, errs: modify Array<VyxErr>) -> Code {
    // The registry takes the components: `VyxFlow` has no `copy`.
    let reg = VyxRegistry { names: vyxCompNames(comps), imported: vyxImportedNames(comps), comps: comps, themed: themed }
    for e in vyxImportConflicts(reg.comps) {
        errs.push(e.copy())
    }
    if errs.length > 0 {
        return vyrn""
    }
    let mut top: Array<Code> = [vyrn"import { el, text, keyed, empty, Html, Attr } from \"std/html\""]
    if themed {
        // `theme` is a String hole, so it is a string literal; no injection is
        // possible.
        top.push(vyrn"import { tw } from \"std/tw\"")
        top.push(vyrn"import * as vyxTheme from tw(\{theme})")
    }
    top.push(vyxCopyImports(reg.comps, skip))
    // The views are built before they are joined: a provider tag's import is
    // found while its view is emitted, and must reach the import block.
    let mut views: Array<Code> = []
    let mut provided: Array<Code> = []
    for c in reg.comps {
        views.push(vyxEmitComponent(c, reg, extra, errs, provided))
    }
    top.push(join(provided, vyrn"\n"))
    for c in reg.comps {
        top.push(vyxHelperBlock(c, page))
    }
    top.push(join(views, vyrn"\n"))
    return join(top, vyrn"\n")
}

/// Every name a component's `<script>` imported selectively, across the whole
/// set. Flat, because the module has one import block, so a sibling's
/// import is in scope at every tag. A namespace alias is not a tag name.
fn vyxImportedNames(comps: Array<VyxComp>) -> Array<String> {
    let mut out: Array<String> = []
    for c in comps {
        for sp in c.script.imports {
            let imp = vyxParseImport(sp.text)
            if imp.ok && imp.ns == false {
                for nm in imp.names {
                    if includes(out, nm) == false {
                        out.push(nm.copy())
                    }
                }
            }
        }
    }
    return out
}

/// One component's helper lines, copied from its `.vyx`. In a page, a `head`
/// or `data` accessor is written under its private name ([`vyxAccessorName`])
/// without `export`, and a statement-leading `type Data` is exported, because
/// the router reaches it through the page's namespace.
gen fn vyxHelperBlock(c: VyxComp, page: Bool) -> Code {
    let lines = c.script.helperLines.copy()
    let mut out: Array<Code> = []
    let mut i = 0
    while i < lines.length {
        let t = trim(lines[i].text)
        let accessor = if vyxIsDeclOf(t, "head") { "head" } else if vyxIsDeclOf(t, "data") { "data" } else { "" }
        if page && accessor != "" {
            let last = vyxDeclLast(lines, i)
            out.push(vyxAccessorCopy(c.src.path, lines, i, last, vyxAccessorName(accessor)))
            i = last + 1
        } else if page && t.startsWith("type Data") {
            out.push(vyxExportType(c.src.path, lines[i]))
            i = i + 1
        } else {
            out.push(vyxCopy(c.src.path, lines[i]))
            i = i + 1
        }
    }
    return join(out, vyrn"\n")
}

/// The helper lines as one text, and where each line starts in it.
fn vyxLineStarts(lines: Array<VyxSpan>) -> Array<Int64> {
    let mut starts: Array<Int64> = []
    let mut off = 0
    for l in lines {
        starts.push(off)
        off = off + l.text.byteLength + 1
    }
    return starts
}

/// The bytes `[a, b)` of the helper lines' text ([`vyxLineStarts`]), copied
/// from `src` one line at a time.
gen fn vyxCopyRange(src: String, lines: Array<VyxSpan>, a: Int64, b: Int64) -> Code {
    let starts = vyxLineStarts(lines)
    let mut out = vyrn""
    let mut k = 0
    for l in lines {
        let s = if a > starts[k] { a - starts[k] } else { 0 }
        let e = if b < starts[k] + l.text.byteLength { b - starts[k] } else { l.text.byteLength }
        if starts[k] > a && starts[k] <= b {
            out = out + vyrn"\n"
        }
        if s < e {
            out = out + vyxCopyPart(src, l, s, e)
        }
        k = k + 1
    }
    return out
}

/// The index of the helper line holding the `}` that closes the declaration
/// starting on line `i`; `i` when no `{` follows.
fn vyxDeclLast(lines: Array<VyxSpan>, i: Int64) -> Int64 {
    let jb = bytes(vyxSpansText(lines))
    let starts = vyxLineStarts(lines)
    let brace = vyxFind(jb, bytes("{"), starts[i])
    if brace < 0 {
        return i
    }
    let end = vyxMatchCurly(jb, brace)
    let mut k = i
    while k + 1 < lines.length && starts[k + 1] < end {
        k = k + 1
    }
    return k
}

/// The accessor declared on helper lines `i` to `last` as `fn <newName>`: its
/// parameters, return type, body and any text after its `}` copied from `src`.
/// The parameters and the return type show their errors at the declaration,
/// as the declaration's own line would.
gen fn vyxAccessorCopy(src: String, lines: Array<VyxSpan>, i: Int64, last: Int64, newName: String) -> Code {
    let jb = bytes(vyxSpansText(lines))
    let starts = vyxLineStarts(lines)
    let open = vyxFind(jb, bytes("("), starts[i])
    let close = vyxMatchParen(jb, open)
    let brace = vyxFind(jb, bytes("{"), close)
    if brace < 0 {
        // A declaration with no body is copied as it stands.
        return vyxCopy(src, lines[i])
    }
    let end = vyxMatchCurly(jb, brace)
    let lineEnd = starts[last] + lines[last].text.byteLength
    let decl = lines[i].copy()
    let declCol = decl.col + vyxSkipWs(bytes(decl.text), 0, decl.text.byteLength)
    let params = at(vyxCopyRange(src, lines, open + 1, close - 1), src, decl.line, declCol)
    let body = vyxCopyRange(src, lines, brace + 1, end - 1)
    let rest = vyxCopyRange(src, lines, end, lineEnd)
    let arrow = vyxFind(jb, bytes("->"), close)
    if arrow < 0 || arrow > brace {
        return vyrn"""
            fn \{name(newName)}(\{params}) {
                \{body}
            }
            """ + rest
    }
    let rs = vyxSkipWs(jb, arrow + 2, brace)
    let mut re = brace
    while re > rs && vyxIsWs(jb[re - 1]) {
        re = re - 1
    }
    let ret = at(vyxCopyRange(src, lines, rs, re), src, decl.line, declCol)
    return vyrn"""
        fn \{name(newName)}(\{params}) -> \{ret} {
            \{body}
        }
        """ + rest
}

/// The index just past the `)` matching the `(` at `open`, or `ba.length`.
fn vyxMatchParen(ba: Array<UInt8>, open: Int64) -> Int64 {
    let mut depth = 0
    let mut i = open
    while i < ba.length {
        if ba[i] == '"' {
            i = vyxScanQuote(ba, i, ba.length) - 1
        } else if ba[i] == '(' {
            depth = depth + 1
        } else if ba[i] == ')' {
            depth = depth - 1
            if depth == 0 {
                return i + 1
            }
        }
        i = i + 1
    }
    return ba.length
}

/// The helper line `l`, a `type Data ... = ...` line, exported: its name and
/// the rest of the line after `=` copied from `src`. A line without `=` is
/// copied as it stands.
gen fn vyxExportType(src: String, l: VyxSpan) -> Code {
    let lb = bytes(l.text)
    let kw = vyxFind(lb, bytes("type "), 0)
    let eq = vyxFind(lb, bytes("="), kw)
    if eq < 0 {
        return vyxCopy(src, l)
    }
    let n = vyxSpanAt(lb, kw + 5, eq)
    let at = vyxSkipWs(lb, kw + 5, eq)
    let tyName = vyxCopyPart(src, l, at, at + n.text.byteLength)
    let rhs = vyxCopyPart(src, l, vyxSkipWs(lb, eq + 1, lb.length), lb.length)
    return vyrn"export type \{tyName} = \{rhs}"
}

fn vyxCompNames(comps: Array<VyxComp>) -> Array<String> {
    let mut out: Array<String> = []
    for c in comps {
        out.push(c.name.copy())
    }
    return out
}

/// An empty `Schema`. A contract check reads names and type spellings, and
/// component props carry no refinement; `uncodable`, `retUncodable` and
/// `mutates` stay empty because `Component` is checked for shape only.
fn vyxNoSchema() -> Schema {
    return Schema { name: "", base: "", doc: None, min: None, max: None, multipleOf: None, minLength: None, maxLength: None, pattern: None }
}

/// An unplaced `Origin`. The checked surface is not emitted yet, so it has no
/// declaration site; the copies carry the `.vyx` positions.
fn vyxNoOrigin() -> Origin {
    return Origin { file: "", line: 0, col: 0, name: "" }
}

/// The export surface `vyxBuildModule` is about to emit, as reflection for the
/// contract check: one view per component with its props (plus `children` for
/// a `<slot/>`), returning `Html`. Must match `vyxEmitComponent`.
gen fn vyxEmittedInterface(comps: Array<VyxComp>) -> ModuleInterface {
    let mut fns: Array<FnInfo> = []
    for c in comps {
        let mut ps: Array<ParamInfo> = []
        for p in c.script.props {
            ps.push(ParamInfo { name: p.name.text.copy(), spelling: p.ty.text.copy(), schema: vyxNoSchema(), uncodable: "" })
        }
        if c.takesChildren {
            ps.push(ParamInfo { name: "children", spelling: "consume Array<Html>", schema: vyxNoSchema(), uncodable: "" })
        }
        fns.push(FnInfo { name: c.fnName.copy(), params: ps, ret: "Html", retSchema: vyxNoSchema(), retUncodable: "", mutates: false, origin: vyxNoOrigin() })
    }
    return ModuleInterface { functions: fns, types: [] }
}

/// Assembles the module or reports the accumulated findings: the pure tail
/// of `components` and `componentsThemed`. The `listDir`/`readFile` calls stay
/// in the gen bodies, because a comptime-only builtin has no native or wasm
/// lowering.
gen fn vyxFinish(comps: consume Array<VyxComp>, errs: Array<VyxErr>, dir: String, themed: Bool, theme: String) -> Code {
    // A read failure arrives with nothing in `comps`, so it is checked before
    // the empty-directory guard, which would bury the OS reasons.
    if errs.length > 0 {
        return vyxReports(errs)
    }
    if comps.length == 0 {
        return reportHere(
            Error,
            "no `.vyx` files under `\{dir}` — a component is a `.vyx` file in that directory",
        )
    }
    // An issue against the `Component` contract is a load diagnostic.
    let mut issues: Array<VyxErr> = []
    for iss in checkContract(vyxEmittedInterface(comps), contractOf(Component)) {
        issues.push(vyxErrHere(iss.message))
    }
    if issues.length > 0 {
        return vyxReports(issues)
    }
    let mut found: Array<VyxErr> = []
    let module = vyxBuildModule(comps, themed, theme, [], false, [], found)
    if found.length > 0 {
        return vyxReports(found)
    }
    return module
}

/// The diagnostic for a `.vyx` source that cannot be read, with the OS reason.
fn vyxCannotRead(path: String, why: String) -> String {
    return "std/vyx cannot read `\{path}`: \{why}"
}

/// A directory listing, or the OS reason it failed, out of one match arm.
type VyxDirRead = { entries: Array<String>, err: String }

gen fn vyxReadDir(dir: String) -> VyxDirRead {
    return match listDir(dir) {
        Ok(ns) => VyxDirRead { entries: ns, err: "" },
        Err(err) => VyxDirRead { entries: [], err: err },
    }
}

/// A file's source, or the OS reason it could not be read.
type VyxFileRead = { src: String, err: String }

gen fn vyxReadFileOf(path: String) -> VyxFileRead {
    return match readFile(path) {
        Ok(v) => VyxFileRead { src: v, err: "" },
        Err(e) => VyxFileRead { src: "", err: e },
    }
}

/// Compiles every `<Name>.vyx` under `dir` into one module exporting one view
/// per component. `class` is unchecked; `componentsThemed` checks it.
export gen fn components(dir: String) -> Code {
    return vyxComponentsIn(dir, false, "")
}

/// [`components`] with a theme: the module imports `tw(<theme>)` as
/// `vyxTheme`, a static class literal is checked against `Tw` at compile time
/// at its `.vyx` position, and a dynamic `:class` is coerced at run time.
/// `theme` resolves relative to the importing module, like `dir`.
export gen fn componentsThemed(dir: String, theme: String) -> Code {
    return vyxComponentsIn(dir, true, theme)
}

/// The body of [`components`] and [`componentsThemed`].
gen fn vyxComponentsIn(dir: String, themed: Bool, theme: String) -> Code {
    let listed = vyxReadDir(dir)
    if listed.err != "" {
        return reportHere(Error, vyxCannotRead(dir, listed.err))
    }
    let mut comps: Array<VyxComp> = []
    let mut errs: Array<VyxErr> = []
    for name in listed.entries {
        if name.endsWith(".vyx") {
            let nb = bytes(name)
            let stem = vyxSlice(nb, 0, nb.length - 4)
            let path = dir + "/" + name
            // A read failure is its own diagnostic, not an empty component.
            let read = vyxReadFileOf(path)
            if read.err != "" {
                errs.push(vyxErrHere(vyxCannotRead(path, read.err)))
            } else {
                let comp = vyxCompileComponent(stem, read.src, dir)
                if comp.errs.length > 0 {
                    errs = vyxCat(errs, comp.errs)
                }
                comps.push(comp)
            }
        }
    }
    return vyxFinish(comps, errs, dir, themed, theme)
}

// `.vyx` pages. A page's `<script>` has a `params { ... }`
// block, helpers, imports, and optionally `export fn data()` (the `data` member
// of `std/ui:Page`). The module `vyxPage` writes for a page exports `page`,
// `Params`, `load` and `Data`;
// `load` is a generated wrapper around `data`.

/// What `std/ui` needs to route a `.vyx` page: its `params` fields (parallel
/// arrays), its loader, the loader's return-type spelling,
/// and whether it opts out of the layout with `layout="none"`. `err` is the
/// message of a params or loader fault at the generator call, `""` for none.
type VyxPageShape = { paramNames: Array<String>, paramTypes: Array<String>, hasLoad: Bool, loadHasParams: Bool, loadLazy: Bool, loadRet: String, layoutNone: Bool, err: String }

// `head` and `data` are members of the `std/ui:Page` contract. A `.vyx` page
// is compiled into a module, so the accessors are read from source text, but
// their names are declared: a misspelling is the contract's `unknown export`.

/// Whether the trimmed line `t` declares `fn <name>(`, with or without
/// `export`. The whole name must match: `fn dataFor()` is not `fn data()`.
fn vyxIsDeclOf(t: String, name: String) -> Bool {
    let bare = if t.startsWith("export ") { trim(vyxSlice(bytes(t), 7, bytes(t).length)) } else { t.copy() }
    return bare.startsWith("fn " + name + "(") || bare.startsWith("fn " + name + " (")
}

/// The declaration line of `fn <name>` in `script`, trimmed ("" when absent).
fn vyxDeclLine(script: String, name: String) -> String {
    for line in lines(script) {
        let t = trim(line)
        if vyxIsDeclOf(t, name) {
            return t
        }
    }
    return ""
}

/// Whether the script declares the accessor `fn <name>()`.
fn vyxScriptHasDecl(script: String, name: String) -> Bool {
    return vyxDeclLine(script, name).byteLength > 0
}

/// The declared return-type spelling of `fn <name>`: the text between `->` and
/// `{` ("" when absent or untyped).
fn vyxDeclRet(script: String, name: String) -> String {
    let t = vyxDeclLine(script, name)
    if t.byteLength == 0 {
        return ""
    }
    let tb = bytes(t)
    let arrow = vyxFind(tb, bytes("->"), 0)
    if arrow < 0 {
        return ""
    }
    let brace = vyxFind(tb, bytes("{"), arrow)
    let end = if brace < 0 { tb.length } else { brace }
    return trim(vyxSlice(tb, arrow + 2, end))
}

/// Which alternative signature of the `std/ui:Page` `data` member a return-type
/// spelling names, numbered as `matchedMember` reports, or -1 for none:
///
///   0  `Query<T>`            blocking, no params
///   1  `Lazy<T>`             render-then-fill, no params
///   2  `ParamQuery<P, T>`    blocking, deferred call takes `Params`
///   3  `ParamLazy<P, T>`     render-then-fill, deferred call takes `Params`
fn vyxDataForm(ret: String) -> Int64 {
    if ret.startsWith("Query<") {
        return 0
    }
    if ret.startsWith("Lazy<") {
        return 1
    }
    if ret.startsWith("ParamQuery<") {
        return 2
    }
    if ret.startsWith("ParamLazy<") {
        return 3
    }
    return 0 - 1
}

/// Whether a `data` form renders lazily.
export to "./ui" fn vyxDataFormIsLazy(form: Int64) -> Bool {
    return form == 1 || form == 3
}

/// Whether a `data` form's deferred call takes the page's `Params`.
export to "./ui" fn vyxDataFormHasParams(form: Int64) -> Bool {
    return form == 2 || form == 3
}

/// The `std/ui` runner that turns a `data` form into the loaded value.
export to "./ui" fn vyxDataRunner(form: Int64) -> String {
    if form == 1 {
        return "runLazy"
    }
    if form == 2 {
        return "runParamQuery"
    }
    if form == 3 {
        return "runParamLazy"
    }
    return "runQuery"
}

/// The data type a `data` return-type spelling carries ("" when `ret` is none
/// of the four): the last type argument, since a params type comes first. This
/// is what the synthesized `load()` returns, and how `std/ui` reads a `.vyrn`
/// page's `data`.
export to "./ui" fn vyxQueryDataType(ret: String) -> String {
    if vyxDataForm(ret) < 0 {
        return ""
    }
    let ba = bytes(ret)
    let open = vyxFind(ba, bytes("<"), 0)
    if open < 0 {
        return ""
    }
    // The matching `>` at generic depth 0, and the last depth-1 comma before it:
    // `ParamQuery<Params, Result<Paste, PageError>>` cuts after `Params, `.
    let mut depth = 0
    let mut i = open
    let mut close = ba.length
    let mut lastComma = 0 - 1
    while i < ba.length {
        if ba[i] == '<' {
            depth = depth + 1
        } else if ba[i] == '>' {
            depth = depth - 1
            if depth == 0 {
                close = i
                i = ba.length
            }
        } else if ba[i] == ',' && depth == 1 {
            lastComma = i
        }
        i = i + 1
    }
    let start = if lastComma >= 0 { lastComma + 1 } else { open + 1 }
    return trim(vyxSlice(ba, start, close))
}

/// The data type a loader's return type carries: the inner
/// type of `Validation<T>` or the first argument of `Result<T, PageError>`; ""
/// with no loader. It types the page's `data` prop, so a page loads straight
/// into a wire type with no `type Data` alias.
fn vyxLoaderDataType(loadRet: String) -> String {
    if loadRet.byteLength == 0 {
        return ""
    }
    // A plain query carries its data type directly; only `Validation<...>` and
    // `Result<...>` are unwrapped.
    if loadRet.startsWith("Validation<") == false && loadRet.startsWith("Result<") == false {
        return loadRet.copy()
    }
    let ba = bytes(loadRet)
    let open = vyxFind(ba, bytes("<"), 0)
    if open < 0 {
        return "Data"
    }
    let mut depth = 0
    let mut i = open
    let mut close = ba.length
    while i < ba.length {
        if ba[i] == '<' {
            depth = depth + 1
        } else if ba[i] == '>' {
            depth = depth - 1
            if depth == 0 {
                close = i
                i = ba.length
            }
        }
        i = i + 1
    }
    let inner = vyxSlice(ba, open + 1, close)
    // For `Result<T, E>` keep only the first argument.
    let ib = bytes(inner)
    let mut d2 = 0
    let mut j = 0
    let mut cut = ib.length
    while j < ib.length {
        let b = ib[j]
        if b == '<' {
            d2 = d2 + 1
        } else if b == '>' {
            d2 = d2 - 1
        } else if b == ',' && d2 == 0 {
            cut = j
            j = ib.length
        }
        j = j + 1
    }
    return trim(vyxSlice(ib, 0, cut))
}

/// Whether the page's `<script>` has a statement-leading `layout="none"`.
/// Spaces around `=` are allowed.
fn vyxScriptLayoutNone(script: String) -> Bool {
    for line in lines(script) {
        let t = trim(line)
        if t.startsWith("layout") {
            let rest = trim(vyxSlice(bytes(t), 6, bytes(t).length))
            if rest.startsWith("=") {
                let val = trim(vyxSlice(bytes(rest), 1, bytes(rest).length))
                if val == "\"none\"" || val == "'none'" || val == "none" {
                    return true
                }
            }
        }
    }
    return false
}

/// Whether a script line is the `layout="none"` directive, which is not Vyrn
/// and is dropped from the pass-through.
fn vyxIsLayoutLine(line: String) -> Bool {
    let t = trim(line)
    if t.startsWith("layout") == false {
        return false
    }
    let rest = trim(vyxSlice(bytes(t), 6, bytes(t).length))
    return rest.startsWith("=")
}

/// How a page declares its data: whether it has a `data` accessor, and the
/// facts its declared return type carries.
type VyxDataShape = { hasData: Bool, hasParams: Bool, lazy: Bool, ret: String, err: String }

/// Reads a page `<script>`'s `data` declaration. Every fact comes from the
/// declared return type, never the body, so signature and statements cannot
/// disagree.
gen fn vyxDataShapeOf(script: String) -> VyxDataShape {
    if vyxScriptHasDecl(script, "data") == false {
        return VyxDataShape { hasData: false, hasParams: false, lazy: false, ret: "", err: "" }
    }
    let declared = vyxDeclRet(script, "data")
    let form = vyxDataForm(declared)
    let mut err = ""
    if form < 0 {
        // Any other return type is named here, not emitted as a `load()` that
        // calls a runner that does not exist.
        err = "this page's `data` returns `\{declared}` — a page's `data` returns `Query<T>`, `ParamQuery<T>`, `Lazy<T>` or `ParamLazy<T>`"
    }
    return VyxDataShape {
        hasData: true,
        hasParams: vyxDataFormHasParams(form),
        lazy: vyxDataFormIsLazy(form),
        ret: vyxQueryDataType(declared),
        err: err,
    }
}

/// The parameter type spellings of a `fn` declaration line: the text after each
/// depth-0 `:` inside `( ... )`.
fn vyxDeclParamTypes(t: String) -> Array<String> {
    let tb = bytes(t)
    let open = vyxFind(tb, bytes("("), 0)
    let mut out: Array<String> = []
    if open < 0 {
        return out
    }
    let mut depth = 0
    let mut start = open + 1
    let mut i = open
    while i < tb.length {
        let b = tb[i]
        // The `>` of a `->` arrow is not a generic closer; counting it dropped
        // every parameter after a fn-typed one.
        let closes = if b == ')' || b == ']' {
            true
        } else if b == '>' {
            tb[i - 1] != '-'
        } else {
            false
        }
        if b == '(' || b == '<' || b == '[' {
            depth = depth + 1
        } else if closes {
            depth = depth - 1
            if depth == 0 {
                let part = trim(vyxSlice(tb, start, i))
                if part.byteLength > 0 {
                    out.push(vyxAfterColon(part))
                }
                i = tb.length
            }
        } else if b == ',' && depth == 1 {
            out.push(vyxAfterColon(trim(vyxSlice(tb, start, i))))
            start = i + 1
        }
        i = i + 1
    }
    return out
}

/// The text after a parameter's `:` (`p: Params` => `Params`); the whole string
/// when there is none.
fn vyxAfterColon(part: String) -> String {
    let pb = bytes(part)
    let mut i = 0
    while i < pb.length {
        if pb[i] == ':' {
            return trim(vyxSlice(pb, i + 1, pb.length))
        }
        i = i + 1
    }
    return part.copy()
}

/// The public surface of a `.vyx` page's `<script>`, its statement-leading
/// `export fn` declarations, as reflection for a contract check. The page has
/// no `moduleInterface`, so this reads the source; unexported helpers are
/// outside the contract.
export to "./ui" gen fn vyxPageInterface(source: String) -> ModuleInterface {
    let outline = vyxOutlineOf(source)
    let mut fns: Array<FnInfo> = []
    if vyxScriptUnclosed(outline) {
        return ModuleInterface { functions: fns, types: [] }
    }
    let ba = bytes(source)
    for line in lines(vyxSlice(ba, vyxScriptFrom(outline), vyxScriptTo(outline))) {
        let t = trim(line)
        if t.startsWith("export fn ") {
            let bare = trim(vyxSlice(bytes(t), 7, bytes(t).length))
            let bb = bytes(bare)
            let open = vyxFind(bb, bytes("("), 0)
            if open > 3 {
                let name = trim(vyxSlice(bb, 3, open))
                let mut ps: Array<ParamInfo> = []
                for spelling in vyxDeclParamTypes(bare) {
                    ps.push(ParamInfo { name: "", spelling: spelling, schema: vyxNoSchema(), uncodable: "" })
                }
                fns.push(FnInfo { name: name, params: ps, ret: vyxRetOfDecl(bare), retSchema: vyxNoSchema(), retUncodable: "", mutates: false, origin: vyxNoOrigin() })
            }
        }
    }
    return ModuleInterface { functions: fns, types: [] }
}

/// The declared return-type spelling of a `fn` declaration line ("" for Unit),
/// matching how `FnInfo.ret` spells an absent return.
gen fn vyxRetOfDecl(t: String) -> String {
    let tb = bytes(t)
    let arrow = vyxFind(tb, bytes("->"), 0)
    if arrow < 0 {
        return ""
    }
    let brace = vyxFind(tb, bytes("{"), arrow)
    let end = if brace < 0 { tb.length } else { brace }
    return trim(vyxSlice(tb, arrow + 2, end))
}

/// Reflects a `.vyx` page's `<script>`: its `params` fields and loader. `err` is
/// set on a malformed `params` block.
export to "./ui", "./ui.editor" gen fn vyxPageShape(source: String) -> VyxPageShape {
    let ba = bytes(source)
    let outline = vyxOutlineOf(source)
    if vyxScriptUnclosed(outline) {
        return VyxPageShape { paramNames: [], paramTypes: [], hasLoad: false, loadHasParams: false, loadLazy: false, loadRet: "", layoutNone: false, err: "the `<script>` section is never closed — an unterminated string or `/* … */` comment swallows the closing `</script>`, so the page's params and loader are unknown" }
    }
    let scriptFrom = vyxScriptFrom(outline)
    let scriptTo = vyxScriptTo(outline)
    let bad = vyxImportsFirstViolation(ba, scriptFrom, scriptTo, "params")
    if bad > 0 {
        return VyxPageShape { paramNames: [], paramTypes: [], hasLoad: false, loadHasParams: false, loadLazy: false, loadRet: "", layoutNone: false, err: "an `import` sits after the `params` block — every import goes at the top of `<script>`" }
    }
    let script = vyxSlice(ba, scriptFrom, scriptTo)
    let sb = bytes(script)
    let ds = vyxDataShapeOf(script)
    let layoutNone = vyxScriptLayoutNone(script)
    let pb = vyxFindKwBlock(sb, "params")
    let mut names: Array<String> = []
    let mut types: Array<String> = []
    if pb.found {
        if pb.malformed {
            return VyxPageShape { paramNames: [], paramTypes: [], hasLoad: false, loadHasParams: false, loadLazy: false, loadRet: "", layoutNone: false, err: "the `params` block is not closed — write `params { name: Type, … }`" }
        }
        let end = vyxMatchCurly(sb, pb.braceAt)
        for part in vyxSplitFields(vyxSlice(sb, pb.braceAt + 1, end - 1)) {
            let trimmed = trim(part)
            if trimmed.byteLength > 0 {
                let pbf = bytes(trimmed)
                let mut colon = 0 - 1
                let mut k = 0
                while k < pbf.length && colon < 0 {
                    if pbf[k] == ':' {
                        colon = k
                    }
                    k = k + 1
                }
                if colon < 0 {
                    return VyxPageShape { paramNames: [], paramTypes: [], hasLoad: false, loadHasParams: false, loadLazy: false, loadRet: "", layoutNone: false, err: "a `params` entry reads `name: Type`, and this one has no `:`" }
                }
                names.push(trim(vyxSlice(pbf, 0, colon)))
                types.push(trim(vyxSlice(pbf, colon + 1, pbf.length)))
            }
        }
    }
    return VyxPageShape { paramNames: names, paramTypes: types, hasLoad: ds.hasData, loadHasParams: ds.hasParams, loadLazy: ds.lazy, loadRet: consume ds.ret, layoutNone: layoutNone, err: consume ds.err }
}

/// The private name a page's contract accessor is compiled under. The router's
/// module has its own `head` and `data`, so the author's accessors are renamed
/// and the generated wrappers call them.
fn vyxAccessorName(name: String) -> String {
    return "uiPg" + vyxUpperFirst(name)
}

/// `s` with an upper-case first byte (`data` => `Data`).
fn vyxUpperFirst(s: String) -> String {
    let ba = bytes(s)
    let mut out: Array<UInt8> = []
    let mut i = 0
    for b in ba {
        if i == 0 && b >= 'a' && b <= 'z' {
            out.push(b - 32)
        } else {
            out.push(b)
        }
        i = i + 1
    }
    return fromBytesOr(out, s)
}

/// The `p.<name>` argument list forwarding a `Params` value into the page view.
gen fn vyxPageArgs(names: Array<String>) -> Code {
    let mut parts: Array<Code> = []
    for n in names {
        parts.push(vyrn"p.\{name(n)}")
    }
    return join(parts, vyrn", ")
}

// The `head { ... }` block, for layouts and error pages.
// Script includes use keywords, because a literal `</script>` would close the
// section. One statement-leading entry per line:
//
//   head {
//       title: displayTitle(data)      // the document <title> (dynamic ok)
//       stylesheet "/theme.css"        // <link rel="stylesheet" href=...>
//       module "/app.js"               // <script type="module" src=...></script>
//       script "/legacy.js"            // <script src=...></script>
//   }
// ===========================================================================

/// One head entry: a `kind` (`title`/`stylesheet`/`module`/`script`), its
/// source `expr`, any String expression, and the expression's 1-based
/// position in the `.vyx` file.
type VyxHeadItem = { kind: String, expr: String, line: Int64, col: Int64 }

/// A parsed head block: its entries in order and any diagnostic. The last
/// `title` entry is the document title.
type VyxHead = { found: Bool, items: Array<VyxHeadItem>, errs: Array<VyxErr> }

fn vyxNoHead() -> VyxHead {
    return VyxHead { found: false, items: [], errs: [] }
}

/// The head entry of `kind` whose expression follows `from` on the line that
/// ends at `le`.
fn vyxHeadEntry(ba: Array<UInt8>, kind: String, from: Int64, le: Int64) -> VyxHeadItem {
    let x = vyxSkipWs(ba, from, le)
    return VyxHeadItem { kind: kind.copy(), expr: trim(vyxSlice(ba, x, le)), line: vyxLineAt(ba, x), col: vyxColAt(ba, x) }
}

/// Parses the body of a `head { ... }` block, `ba[start, end)`.
gen fn vyxParseHead(ba: Array<UInt8>, start: Int64, end: Int64, srcFile: String) -> VyxHead {
    let mut items: Array<VyxHeadItem> = []
    let mut ls = start
    while ls < end {
        let nl = vyxFind(ba, bytes("\n"), ls)
        let le = if nl < 0 || nl > end { end } else { nl }
        let at = vyxSkipWs(ba, ls, le)
        let t = trim(vyxSlice(ba, at, le))
        if t.byteLength == 0 || t.startsWith("//") {
            // blank / comment
        } else if t.startsWith("title:") {
            items.push(vyxHeadEntry(ba, "title", at + 6, le))
        } else if t.startsWith("stylesheet ") {
            items.push(vyxHeadEntry(ba, "stylesheet", at + 11, le))
        } else if t.startsWith("module ") {
            items.push(vyxHeadEntry(ba, "module", at + 7, le))
        } else if t.startsWith("script ") {
            items.push(vyxHeadEntry(ba, "script", at + 7, le))
        } else {
            return VyxHead { found: true, items: items, errs: [vyxErr(srcFile, 0, "`\{t}` is not a `head` entry — a head entry is `title:`, `stylesheet`, `module` or `script`")] }
        }
        ls = le + 1
    }
    return VyxHead { found: true, items: items, errs: [] }
}

/// The statement-leading `head { ... }` block of the script `ba[sStart, sEnd)`;
/// `found` is false when there is none.
gen fn vyxHeadOf(ba: Array<UInt8>, sStart: Int64, sEnd: Int64, srcFile: String) -> VyxHead {
    let sb = bytes(vyxSlice(ba, sStart, sEnd))
    let hb = vyxFindKwBlock(sb, "head")
    if hb.found == false || hb.malformed {
        return vyxNoHead()
    }
    let end = vyxMatchCurly(sb, hb.braceAt)
    return vyxParseHead(ba, sStart + hb.braceAt + 1, sStart + end - 1, srcFile)
}

/// The `std/html` element expression for one head entry, its expression
/// copied from `src`.
gen fn vyxHeadItemExpr(it: VyxHeadItem, src: String) -> Code {
    let x = codeAt(src, it.line, it.col, it.expr)
    if it.kind == "stylesheet" {
        return vyrn"el(\"link\", [A(\"rel\", \"stylesheet\"), A(\"href\", (\{x}))], [])"
    }
    if it.kind == "module" {
        return vyrn"el(\"script\", [A(\"type\", \"module\"), A(\"src\", (\{x}))], [])"
    }
    return vyrn"el(\"script\", [A(\"src\", (\{x}))], [])"
}

/// Emits the module's `head(<sig>) -> Array<Html>` and
/// `headTitle(<sig>) -> String`. `sig` is the parameter list (empty for a
/// layout); `prelude` binds the locals the entries read (`let id = p.id`).
/// Always emitted; an empty head gives `[]` and "". Each entry shows its
/// errors at its position in `src`.
gen fn vyxEmitHeadFns(head: VyxHead, sig: Code, prelude: Code, src: String) -> Code {
    let mut pushes: Array<Code> = []
    for it in head.items {
        if it.kind != "title" {
            pushes.push(at(vyrn"uiHd.push(\{vyxHeadItemExpr(it, src)})", src, it.line, it.col))
        }
    }
    let body = join(pushes, vyrn"\n")
    let title = vyxEmitHeadTitleFn(head, sig, prelude, src)
    return vyrn"""
        export fn head(\{sig}) -> Array<Html> {
            \{prelude}
            let mut uiHd: Array<Html> = []
            \{body}
            return uiHd
        }
        \{title}
        """
}

/// The arguments for the page's `head` accessor, from its declared parameter
/// types. Head takes what the view takes: `()`, `(d)`, `(p)` or `(p, d)`, and a
/// parameter of type `Params` is the route parameters.
gen fn vyxHeadCallArgs(ptypes: Array<String>, hasParams: Bool, hasLoad: Bool) -> Code {
    if ptypes.length == 1 && ptypes[0] == "Params" && hasParams {
        return vyrn"p"
    }
    if ptypes.length == 1 && ptypes[0] != "Params" && hasLoad {
        return vyrn"d"
    }
    if ptypes.length == 2 && hasParams && hasLoad {
        return join([vyrn"p", vyrn"d"], vyrn", ")
    }
    return vyrn""
}

/// Whether the page's `head` accessor asks only for what the page can give: no
/// `d` without a loader, no `p` without params, at most two arguments. A
/// failure is a page error, not generated text that fails to typecheck.
fn vyxHeadArgsOk(ptypes: Array<String>, hasParams: Bool, hasLoad: Bool) -> Bool {
    if ptypes.length == 0 {
        return true
    }
    if ptypes.length == 1 {
        if ptypes[0] == "Params" {
            return hasParams
        }
        return hasLoad
    }
    if ptypes.length == 2 {
        return hasParams && hasLoad
    }
    return false
}

/// Emits `head`/`headTitle` wrapping the page's `head(...)` accessor. `sig` is
/// the router's call shape; `args` is what the accessor receives.
gen fn vyxEmitAccessorHeadFns(sig: Code, args: Code) -> Code {
    let title = vyxEmitAccessorHeadTitle(sig, args)
    return vyrn"""
        export fn head(\{sig}) -> Array<Html> {
            return headHtml(\{name(vyxAccessorName("head"))}(\{args}))
        }
        \{title}
        """
}

/// Emits only `headTitle(<sig>)` from the `head(...)` accessor, for the client
/// bundle of a dataless page.
gen fn vyxEmitAccessorHeadTitle(sig: Code, args: Code) -> Code {
    return vyrn"""
        export fn headTitle(\{sig}) -> String {
            return headTitleOf(\{name(vyxAccessorName("head"))}(\{args}))
        }
        """
}

/// Emits only `headTitle(<sig>) -> String`. The client bundle keeps it for a
/// dataless page, so the host resolves the title with no round-trip.
gen fn vyxEmitHeadTitleFn(head: VyxHead, sig: Code, prelude: Code, src: String) -> Code {
    let mut ret = vyrn"return \"\""
    for it in head.items {
        if it.kind == "title" {
            ret = at(vyrn"return (\{codeAt(src, it.line, it.col, it.expr)})", src, it.line, it.col)
        }
    }
    return vyrn"""
        export fn headTitle(\{sig}) -> String {
            \{prelude}
            \{ret}
        }
        """
}

// Client-page compilation: the view only. `load` runs on
// the server, and its imports (file I/O) would initialize module state at wasm
// boot and trap, so the client build strips `load` and prunes dead imports.

/// Whether `name` occurs as a whole identifier token anywhere in `corpus`.
fn vyxWordUsed(corpus: String, name: String) -> Bool {
    let cb = bytes(corpus)
    let nb = bytes(name)
    if nb.length == 0 {
        return false
    }
    let mut i = 0
    while i + nb.length <= cb.length {
        let mut hit = true
        let mut j = 0
        while j < nb.length {
            if cb[i + j] != nb[j] {
                hit = false
                j = nb.length
            } else {
                j = j + 1
            }
        }
        if hit {
            let beforeOk = if i == 0 { true } else { vyxIsIdent(cb[i - 1]) == false }
            let afterIdx = i + nb.length
            let afterOk = if afterIdx >= cb.length { true } else { vyxIsIdent(cb[afterIdx]) == false }
            if beforeOk && afterOk {
                return true
            }
        }
        i = i + 1
    }
    return false
}

/// Whether the trimmed line `t` opens the page's `data()` accessor, which the
/// client bundle strips.
fn vyxIsDataDecl(t: String) -> Bool {
    return vyxIsDeclOf(t, "data")
}

/// The texts of `spans`, one per line.
fn vyxSpansText(spans: Array<VyxSpan>) -> String {
    let mut out = ""
    for sp in spans {
        out = out + sp.text + "\n"
    }
    return out
}

/// `lines` without the declaration that starts on line `i`: from that line to
/// the `}` matching the first `{` after its start. Text after the `}` on its
/// line stays, at its own position. Unchanged when no `{` follows.
fn vyxCutDecl(lines: Array<VyxSpan>, i: Int64) -> Array<VyxSpan> {
    let jb = bytes(vyxSpansText(lines))
    let mut starts: Array<Int64> = []
    let mut off = 0
    for l in lines {
        starts.push(off)
        off = off + l.text.byteLength + 1
    }
    let brace = vyxFind(jb, bytes("{"), starts[i])
    if brace < 0 {
        return lines.copy()
    }
    let end = vyxMatchCurly(jb, brace)
    let mut out: Array<VyxSpan> = []
    let mut k = 0
    for l in lines {
        let lineEnd = starts[k] + l.text.byteLength
        if k < i || starts[k] >= end {
            out.push(l.copy())
        } else if end < lineEnd {
            let rest = vyxSpanIn(l.text, l.line, l.col, end - starts[k], vyxSlice(bytes(l.text), end - starts[k], l.text.byteLength))
            if trim(rest.text).byteLength > 0 {
                out.push(rest)
            }
        }
        k = k + 1
    }
    return out
}

/// `lines` without the first statement-leading `data()` accessor.
gen fn vyxStripLoadLines(lines: Array<VyxSpan>) -> Array<VyxSpan> {
    let mut i = 0
    for l in lines {
        if vyxIsDataDecl(trim(l.text)) {
            return vyxCutDecl(lines, i)
        }
        i = i + 1
    }
    return lines.copy()
}

/// Whether `name(` occurs in `corpus` as a whole token: an inline helper call.
fn vyxCalledInCorpus(corpus: String, name: String) -> Bool {
    let cb = bytes(corpus)
    let nb = bytes(name)
    if nb.length == 0 {
        return false
    }
    let mut i = 0
    while i + nb.length < cb.length {
        let mut hit = true
        let mut j = 0
        while j < nb.length {
            if cb[i + j] != nb[j] {
                hit = false
                j = nb.length
            } else {
                j = j + 1
            }
        }
        if hit {
            let beforeOk = if i == 0 { true } else { vyxIsIdent(cb[i - 1]) == false }
            if beforeOk && cb[i + nb.length] == '(' {
                return true
            }
        }
        i = i + 1
    }
    return false
}

/// Whether an import specifier is relative (`./` or `../`): a page's own app
/// module, not `std/...` or a generator import.
fn vyxImportIsRelative(line: String) -> Bool {
    let idx = vyxFind(bytes(line), bytes("from \""), 0)
    if idx < 0 {
        return false
    }
    let after = vyxSlice(bytes(line), idx + 6, bytes(line).length)
    return after.startsWith("./") || after.startsWith("../")
}

/// Whether `name` occurs in `corpus` as a whole identifier, called or not: a
/// helper passed as a function value (`paramQuery(fetchPaste)`) is still used.
fn vyxMentionsIdent(corpus: String, name: String) -> Bool {
    let cb = bytes(corpus)
    let nb = bytes(name)
    if nb.length == 0 {
        return false
    }
    let mut i = 0
    while i >= 0 {
        let at = vyxFind(cb, nb, i)
        if at < 0 {
            return false
        }
        let beforeOk = at == 0 || vyxIsIdent(cb[at - 1]) == false
        let end = at + nb.length
        let afterOk = end >= cb.length || vyxIsIdent(cb[end]) == false
        if beforeOk && afterOk {
            return true
        }
        i = at + 1
    }
    return false
}

/// `lines` without the private helpers nothing else mentions, to a fixed
/// point: not the other lines, the `imports` or `keep`. A `data` accessor
/// hands its work to a named helper, which would reach the browser still
/// calling the server contract; `vyxClientHelperViolation` would refuse the
/// page. Exported helpers are never removed.
gen fn vyxStripDeadLines(lines: Array<VyxSpan>, imports: Array<VyxSpan>, keep: String) -> Array<VyxSpan> {
    let mut cur = lines.copy()
    let mut rounds = 0
    let mut cutOne = true
    while rounds < 16 && cutOne {
        cutOne = false
        let mut i = 0
        while i < cur.length && cutOne == false {
            let name = vyxDeclNameOf(trim(cur[i].text))
            if name.byteLength > 0 {
                let rest = vyxCutDecl(cur, i)
                if vyxSpansText(rest) != vyxSpansText(cur) && vyxMentionsIdent(vyxSpansText(rest) + vyxSpansText(imports) + " " + keep, name) == false {
                    cur = rest
                    cutOne = true
                }
            }
            i = i + 1
        }
        rounds = rounds + 1
    }
    return cur
}

/// The declared name of a `fn <name>(` line ("" when the line is not one).
fn vyxDeclNameOf(t: String) -> String {
    if t.startsWith("fn ") == false {
        return ""
    }
    let tb = bytes(t)
    let open = vyxFind(tb, bytes("("), 0)
    if open <= 3 {
        return ""
    }
    return trim(vyxSlice(tb, 3, open))
}

/// The name of a helper imported from a relative app module and called in the
/// page's view, which cannot run client-side; "" when the
/// view is pure over its props. Runs after the load strip and import prune.
gen fn vyxClientHelperViolation(script: String, template: String) -> String {
    let rows = lines(script)
    let mut corpus = ""
    for line in rows {
        if trim(line).startsWith("import ") == false {
            corpus = corpus + line + " "
        }
    }
    corpus = corpus + template
    for line in rows {
        let t = trim(line)
        let lb = bytes(t)
        let brace = vyxFind(lb, bytes("{"), 0)
        if t.startsWith("import ") && brace >= 0 && vyxImportIsRelative(t) {
            let close = vyxFind(lb, bytes("}"), brace)
            for nm in vyxSplitFields(vyxSlice(lb, brace + 1, close)) {
                let bound = vyxImportBoundName(trim(nm))
                if bound.byteLength > 0 && vyxCalledInCorpus(corpus, bound) {
                    return bound
                }
            }
        }
    }
    return ""
}

/// The name an import binds (`X as Y` binds `Y`; a bare `X` binds `X`).
fn vyxImportBoundName(spec: String) -> String {
    let asIdx = vyxFind(bytes(spec), bytes(" as "), 0)
    if asIdx < 0 {
        return trim(spec)
    }
    return trim(vyxSlice(bytes(spec), asIdx + 4, bytes(spec).length))
}

/// The last identifier token of `s`: the bound name of `import * as t` is `t`.
fn vyxLastIdent(s: String) -> String {
    let sb = bytes(s)
    let mut end = sb.length
    while end > 0 && vyxIsIdent(sb[end - 1]) == false {
        end = end - 1
    }
    let mut start = end
    while start > 0 && vyxIsIdent(sb[start - 1]) {
        start = start - 1
    }
    return vyxSlice(sb, start, end)
}

/// Whether import binding `name` is dead in the client bundle: used by the
/// original script and unused by what remains. A name the original never
/// referenced is kept, since it may serve a use the scan cannot see.
///
/// `loadBody` is the whole pre-strip body, because a `data` accessor's server
/// call names its import inside a helper, not the accessor.
fn vyxImportNameDead(name: String, corpus: String, loadBody: String) -> Bool {
    return vyxWordUsed(loadBody, name) && vyxWordUsed(corpus, name) == false
}

/// `line` without its `//` comment, so a comment naming a type cannot keep a
/// dead file-I/O import alive in the client bundle.
fn vyxStripLineComment(line: String) -> String {
    let lb = bytes(line)
    let idx = vyxFind(lb, bytes("//"), 0)
    if idx < 0 {
        return line.copy()
    }
    return vyxSlice(lb, 0, idx)
}

/// `script` without import lines, comments stripped: what the page's own code
/// referenced. A name only on import lines was never used (see
/// [`vyxImportNameDead`]).
fn vyxNonImportBody(script: String) -> String {
    let mut out = ""
    for line in lines(script) {
        if trim(line).startsWith("import ") == false {
            out = out + vyxStripLineComment(line) + " "
        }
    }
    return out
}

/// The import names of `imports` that only the stripped loader used, so the
/// client leaves them out: a selective import's entries, and a namespace or
/// other import's bound name. `lines` is what remains with `load` stripped;
/// `extra` is more usage (template and generated types); `loadBody` is the
/// stripped loader's source. A name the original never referenced stays,
/// since it may serve a use the scan cannot see.
gen fn vyxDeadImportNames(imports: Array<VyxSpan>, lines: Array<VyxSpan>, extra: String, loadBody: String) -> Array<String> {
    let body = vyxNonImportBody(vyxSpansText(lines))
    let mut dead: Array<String> = []
    let mut k = 0
    for sp in imports {
        // Another import may use this one's name (`import * as t from i18n("...")`
        // uses `i18n`).
        let mut others = ""
        let mut j = 0
        for o in imports {
            if j != k {
                others = others + vyxStripLineComment(o.text) + " "
            }
            j = j + 1
        }
        let corpus = others + body + " " + extra
        let imp = vyxParseImport(sp.text)
        if imp.ok && imp.ns == false {
            for nm in imp.names {
                if vyxImportNameDead(vyxImportBoundName(nm), corpus, loadBody) {
                    dead.push(nm.copy())
                }
            }
        } else if vyxImportNameDead(vyxImportKey(sp.text, imp), corpus, loadBody) {
            dead.push(vyxImportKey(sp.text, imp))
        }
        k = k + 1
    }
    return dead
}

/// The client page module's host entry:
/// `clientRender(propsJson, paramsJson) -> String` decodes props and params in
/// the page module, where their types are in scope, calls the view, and returns
/// the `std/html` tree as JSON for `vyrn-dom`. A decode miss returns the
/// fallback sentinel. A generic data type `data`, which `generic` says, is
/// aliased first, because `fromJson` takes a named type.
gen fn vyxEmitClientRender(hasLoad: Bool, hasParams: Bool, data: Code, generic: Bool) -> Code {
    if hasLoad == false && hasParams {
        return vyrn"""
            export fn clientRender(propsJson: String, paramsJson: String) -> String {
                return match fromJson<Params>(paramsJson) {
                    Valid(uiPrm) => toJson(page(uiPrm)),
                    Invalid(uiI) => "__vyrn_fallback__",
                }
            }
            """
    }
    if hasLoad == false {
        return vyrn"""
            export fn clientRender(propsJson: String, paramsJson: String) -> String {
                return toJson(page())
            }
            """
    }
    // A loader page decodes the data and, for a dynamic route, the params.
    let alias = if generic { vyrn"type UiClientData = \{data}" } else { vyrn"" }
    let named = if generic { vyrn"UiClientData" } else { data }
    if hasParams {
        return vyrn"""
            \{alias}
            export fn clientRender(propsJson: String, paramsJson: String) -> String {
                return match fromJson<\{named}>(propsJson) {
                    Valid(uiD) => match fromJson<Params>(paramsJson) {
                        Valid(uiPrm) => toJson(page(uiPrm, uiD)),
                        Invalid(uiI) => "__vyrn_fallback__",
                    },
                    Invalid(uiI) => "__vyrn_fallback__",
                }
            }
            """
    }
    return vyrn"""
        \{alias}
        export fn clientRender(propsJson: String, paramsJson: String) -> String {
            return match fromJson<\{named}>(propsJson) {
                Valid(uiD) => toJson(page(uiD)),
                Invalid(uiI) => "__vyrn_fallback__",
            }
        }
        """
}

/// The lazy page's skeleton entry: `pageLoading([p: Params]) -> Html`
/// renders the view's `Loading` arm, with no data.
gen fn vyxEmitPageLoading(paramNames: Array<String>) -> Code {
    if paramNames.length > 0 {
        let args = vyxPageArgs(paramNames)
        return vyrn"""
            export fn pageLoading(p: Params) -> Html {
                return uiPageBody(\{args}, Loading)
            }
            """
    }
    return vyrn"""
        export fn pageLoading() -> Html {
            return uiPageBody(Loading)
        }
        """
}

/// The lazy page's loading host entry: `clientRenderLoading(paramsJson)`
/// renders the skeleton for a soft nav's first paint. The dispatch calls it when
/// the props payload is the `{"__loading__":true}` sentinel.
gen fn vyxEmitClientRenderLoading(hasParams: Bool) -> Code {
    if hasParams {
        return vyrn"""
            export fn clientRenderLoading(paramsJson: String) -> String {
                return match fromJson<Params>(paramsJson) {
                    Valid(uiPrm) => toJson(pageLoading(uiPrm)),
                    Invalid(uiI) => "__vyrn_fallback__",
                }
            }
            """
    }
    return vyrn"""
        export fn clientRenderLoading(paramsJson: String) -> String {
            return toJson(pageLoading())
        }
        """
}

/// The helper line that declares `fn <name>`, or an empty span at line 0 when
/// none does.
fn vyxDeclSpan(lines: Array<VyxSpan>, name: String) -> VyxSpan {
    for l in lines {
        if vyxIsDeclOf(trim(l.text), name) {
            return l.copy()
        }
    }
    return VyxSpan { text: "", line: 0, col: 0 }
}

/// `text` where it first stands after the `->` of the declaration line
/// `decl`, copied from `src`.
gen fn vyxCopyIn(src: String, decl: VyxSpan, text: String) -> Code {
    let db = bytes(decl.text)
    let arrow = vyxFind(db, bytes("->"), 0)
    let at = vyxFind(db, bytes(text), if arrow < 0 { 0 } else { arrow })
    if at < 0 {
        return codeAt(src, decl.line, decl.col, text)
    }
    return vyxCopyPart(src, decl, at, at + text.byteLength)
}

/// The page entry: it forwards the `Params` fields, and the loaded data if
/// any, into the body. It takes the raw `T` as `d: dataTy`; a lazy page passes
/// `Ready(d)` as `dataArg`.
gen fn vyxPageFn(hasLoad: Bool, args: Code, dataTy: Code, dataArg: Code, hasParams: Bool) -> Code {
    if hasLoad && hasParams {
        return vyrn"""
            export fn page(p: Params, d: \{dataTy}) -> Html {
                return uiPageBody(\{args}, \{dataArg})
            }
            """
    }
    if hasLoad {
        // A static loader: no `Params`, the body takes only the data.
        return vyrn"""
            export fn page(d: \{dataTy}) -> Html {
                return uiPageBody(\{dataArg})
            }
            """
    }
    if hasParams {
        return vyrn"""
            export fn page(p: Params) -> Html {
                return uiPageBody(\{args})
            }
            """
    }
    return vyrn"""
        export fn page() -> Html {
            return uiPageBody()
        }
        """
}

/// The `load` the router calls: one `runner` call over the page's deferred
/// call, returning `ret`. A `Param*` query takes the route params, so
/// `load(p)` does too.
gen fn vyxLoadFn(runner: String, ret: Code, hasParams: Bool) -> Code {
    let call = name(runner)
    let data = name(vyxAccessorName("data"))
    if hasParams {
        return vyrn"""
            export fn load(p: Params) -> \{ret} {
                return \{call}(\{data}(), p)
            }
            """
    }
    return vyrn"""
        export fn load() -> \{ret} {
            return \{call}(\{data}())
        }
        """
}

/// Builds the module of the `.vyx` page `source`, read from `srcPath`: the
/// template compiles to a `uiPageBody(<params>[, data: Data])` view, and the
/// module exports `page` and `Params`, and on the server `load`, `head`,
/// `headTitle` and `encodeProps`. The `client` module, for `std/ui`'s
/// `pagesClient`, keeps the view and exports `clientRender` instead.
gen fn vyxBuildPageModule(source: String, srcPath: String, themed: Bool, theme: String, client: Bool) -> Code {
    let ba = bytes(source)
    let outline = vyxOutlineOf(source)
    if vyxScriptUnclosed(outline) {
        return reportHere(Error, "this page's `<script>` section is never closed — an unterminated string or `/* … */` comment swallows the closing `</script>`")
    }
    if vyxTemplateUnclosed(outline) {
        return reportHere(Error, "this page's `<template>` section is never closed — an unterminated comment or unclosed element swallows the closing `</template>`")
    }
    if vyxHasTemplatePart(outline) == false {
        return reportHere(Error, "this page has no `<template>` section — a page's view is the one element inside it")
    }
    let templateBody = vyxTemplateText(outline)
    let script = vyxSlice(ba, vyxScriptFrom(outline), vyxScriptTo(outline))
    let bad = vyxImportsFirstViolation(ba, vyxScriptFrom(outline), vyxScriptTo(outline), "params")
    if bad > 0 {
        return vyxReports([vyxErr(srcPath, bad, "an `import` sits after the `params` block — every import goes at the top of `<script>`")])
    }

    // The `params { ... }` fields, as written.
    let sb = bytes(script)
    let pb = vyxFindKwBlock(sb, "params")
    let mut paramFields = ""
    if pb.found && pb.malformed == false {
        let end = vyxMatchCurly(sb, pb.braceAt)
        paramFields = trim(vyxSlice(sb, pb.braceAt + 1, end - 1))
    }
    // A page has no `head { ... }` block: its head is the `head()` accessor. A
    // leftover block fails to parse in the compiled body.
    let hasHeadFn = vyxScriptHasDecl(script, "head")
    let ds = vyxDataShapeOf(script)
    if ds.err != "" {
        return reportHere(Error, ds.err)
    }
    let hasLoad = ds.hasData
    let dataType = vyxLoaderDataType(ds.ret)
    let lazy = ds.lazy
    let comp0 = vyxCompileAt(source, "UiPageBody", srcPath, "params", "")
    if comp0.errs.length > 0 {
        return vyxReports(comp0.errs)
    }
    let mut comp = comp0
    // The loaded type and the loader's return type, copied from the `data`
    // declaration. `dataType` and `hasLoad` come from the whole script, so the
    // client's `page(d: Data)` signature stays correct.
    let decl = vyxDeclSpan(comp.script.helperLines, "data")
    let data = if hasLoad { vyxCopyIn(srcPath, decl, dataType) } else { vyrn"" }
    let ret = if hasLoad { vyxCopyIn(srcPath, decl, ds.ret) } else { vyrn"" }
    let mut lines = comp.script.helperLines.copy()
    let mut dead: Array<String> = []
    if client {
        // The whole pre-strip body: the loader AND the helpers it reached, since
        // the import a server call names lives in the helper, not the accessor.
        let loadBody = vyxNonImportBody(vyxSpansText(lines))
        lines = vyxStripLoadLines(lines)
        // Cutting the `data` accessor leaves its named helper behind, dead in the
        // browser and calling the server contract.
        let keep = templateBody + " " + dataType + " " + paramFields
        lines = vyxStripDeadLines(lines, comp.script.imports, keep)
        dead = vyxDeadImportNames(comp.script.imports, lines, keep, loadBody)
        // An app-module helper called in the view cannot render client-side;
        // name it here instead of a boot trap. A dead import name is called
        // nowhere, so the check reads the imports unpruned.
        let viol = vyxClientHelperViolation(vyxSpansText(comp.script.imports) + vyxSpansText(lines), templateBody)
        if viol.byteLength > 0 {
            return reportHere(
                Error,
                "this page's view calls `\{viol}`, an app-module helper, and the view runs in the browser — move that call into `data`, which runs on the server",
            )
        }
    }
    let mut kept: Array<VyxSpan> = []
    for l in lines {
        // `layout="none"` is consumed by the router shape; it is not Vyrn.
        if vyxIsLayoutLine(l.text) == false {
            kept.push(l.copy())
        }
    }
    comp.script.helperLines = kept
    let mut paramNames: Array<String> = []
    let mut fields: Array<Code> = []
    for pr in comp.script.props {
        paramNames.push(pr.name.text.copy())
        fields.push(vyrn"\{vyxCopy(srcPath, pr.name)}: \{vyxCopy(srcPath, pr.ty)}")
    }
    let hasParams = paramNames.length > 0
    // The view takes the params, then the loaded data. A lazy page's view
    // receives `PageData<T>` (`Loading | Ready(T)`); the loader returns `T`
    // and `page` wraps `Ready(d)`. The server always has data, so it never
    // renders `Loading`.
    let mut extra: Array<Code> = []
    if hasLoad && lazy {
        extra.push(vyrn"data: PageData<\{data}>")
    } else if hasLoad {
        extra.push(vyrn"data: \{data}")
    }
    let mut errs: Array<VyxErr> = []
    let module = vyxBuildModule([comp], themed, theme, extra, true, dead, errs)
    if errs.length > 0 {
        return vyxReports(errs)
    }

    // The router calls wrappers, not the accessors: `std/ui` turns a `Head` and
    // a query into the shapes the router consumes. The client needs neither.
    let runner = vyxDataRunner(vyxDataForm(vyxDeclRet(script, "data")))
    let mut top: Array<Code> = []
    if ds.hasData && client == false {
        top.push(vyrn"import { \{name(runner)} } from \"std/ui\"")
    }
    if hasHeadFn && client == false {
        top.push(vyrn"import { headHtml, headTitleOf } from \"std/ui\"")
    }
    if hasHeadFn && client {
        top.push(vyrn"import { headTitleOf } from \"std/ui\"")
    }
    // `PageData` is defined once in std/ui, so its constructors register once.
    if lazy {
        top.push(vyrn"import { PageData } from \"std/ui\"")
    }
    top.push(module)
    if hasParams {
        let list = join(fields, vyrn", ")
        top.push(vyrn"export type Params = { \{list} }")
    }
    if ds.hasData && client == false {
        top.push(vyxLoadFn(runner, ret, ds.hasParams))
    }
    let dataTy = if lazy { vyrn"consume \{data}" } else { data }
    let dataArg = if lazy { vyrn"Ready(consume d)" } else { vyrn"d" }
    top.push(vyxPageFn(hasLoad, vyxPageArgs(paramNames), dataTy, dataArg, hasParams))
    // `head()`/`headTitle()` take `page`'s shape, so a dynamic head can read
    // params and data.
    let mut sigParts: Array<Code> = []
    let mut binds: Array<Code> = []
    if hasParams {
        sigParts.push(vyrn"p: Params")
    }
    for n in paramNames {
        binds.push(vyrn"let \{name(n)} = p.\{name(n)}")
    }
    if hasLoad {
        sigParts.push(vyrn"d: \{data}")
        binds.push(vyrn"let data = d")
    }
    let sig = join(sigParts, vyrn", ")
    let prelude = join(binds, vyrn"\n")
    // Which of `head`'s four signatures the page chose, from its parameter
    // types. The wrapper's own signature is fixed by the router.
    let headTypes = vyxDeclParamTypes(vyxDeclLine(script, "head"))
    if hasHeadFn && vyxHeadArgsOk(headTypes, hasParams, hasLoad) == false {
        return reportHere(
            Error,
            "this page's `head` takes `(\{joinWith(headTypes, ", ")})`, which is none of the signatures the router calls it with",
        )
    }
    let headArgs = vyxHeadCallArgs(headTypes, hasParams, hasLoad)
    // The client omits `head`/`headTitle` and exports `clientRender` instead.
    if client {
        top.push(vyxEmitClientRender(hasLoad, hasParams, data, dataType.contains("<")))
        // A lazy page also exports `pageLoading` and `clientRenderLoading`, so a
        // soft nav paints the skeleton, then fills `Ready(props)`.
        if lazy {
            top.push(vyxEmitPageLoading(paramNames))
            top.push(vyxEmitClientRenderLoading(hasParams))
        }
        // A dataless page keeps `headTitle`, so the host resolves the title with
        // no round-trip. A loader page's title depends on its data and travels
        // in the payload.
        if hasLoad == false && hasHeadFn {
            top.push(vyxEmitAccessorHeadTitle(sig, headArgs))
        } else if hasLoad == false {
            top.push(vyxEmitHeadTitleFn(vyxNoHead(), sig, prelude, srcPath))
        }
    } else {
        if hasHeadFn {
            top.push(vyxEmitAccessorHeadFns(sig, headArgs))
        } else {
            top.push(vyxEmitHeadFns(vyxNoHead(), sig, prelude, srcPath))
        }
        // A loader page exports a typed props encoder: `toJson` cannot infer a
        // match-bound value's type, but a parameter carries it.
        if hasLoad {
            let encode = vyrn"""
                export fn encodeProps(d: \{data}) -> String {
                    return toJson(d)
                }
                """
            top.push(encode)
        }
    }
    return join(top, vyrn"\n")
}

/// The page module of the `.vyx` at `vyxPath`, or why it cannot be read.
gen fn vyxPageOf(vyxPath: String, themed: Bool, theme: String, client: Bool) -> Code {
    let read = vyxReadFileOf(vyxPath)
    if read.err != "" {
        return reportHere(Error, vyxCannotRead(vyxPath, read.err))
    }
    return vyxBuildPageModule(read.src, vyxPath, themed, theme, client)
}

/// Synthesizes a `.vyx` page module from `vyxPath`. The
/// argument is the full `.vyx` path, because the generator sandbox admits reads
/// of exactly its path arguments.
export to "./ui" gen fn vyxPage(vyxPath: String) -> Code {
    return vyxPageOf(vyxPath, false, "", false)
}

/// [`vyxPage`] with the page's classes checked against `theme`.
export to "./ui" gen fn vyxPageThemed(vyxPath: String, theme: String) -> Code {
    return vyxPageOf(vyxPath, true, theme, false)
}

/// [`vyxPage`] for the client bundle: no `load`, head or
/// title, for `std/ui`'s `pagesClient`.
export to "./ui" gen fn vyxPageClient(vyxPath: String) -> Code {
    return vyxPageOf(vyxPath, false, "", true)
}

/// [`vyxPageClient`] with classes checked against `theme`.
export to "./ui" gen fn vyxPageClientThemed(vyxPath: String, theme: String) -> Code {
    return vyxPageOf(vyxPath, true, theme, true)
}

/// The directory part of `path`, before the last `/`.
export to "./vyx.editor" fn vyxDirOf(path: String) -> String {
    let ba = bytes(path)
    let slash = vyxFindLast(ba, bytes("/"), 0)
    if slash < 0 {
        return "."
    }
    return vyxSlice(ba, 0, slash)
}

// `.vyx` layouts: a `layout.vyx` is a component with a
// `<slot/>` for the page body and an optional `head { ... }`. It is not a
// route; the router wraps each page body in its layouts, nearest first.

/// Builds the module of the `.vyx` layout `source`, read from `srcPath`:
/// `layout(children: Array<Html>) -> Html` around the compiled template, which
/// must contain `<slot/>`, plus `head()` and `headTitle()`.
gen fn vyxBuildLayoutModule(source: String, srcPath: String, themed: Bool, theme: String) -> Code {
    let ba = bytes(source)
    let outline = vyxOutlineOf(source)
    if vyxScriptUnclosed(outline) {
        return reportHere(Error, "this layout's `<script>` section is never closed — an unterminated string or `/* … */` comment swallows the closing `</script>`")
    }
    if vyxTemplateUnclosed(outline) {
        return reportHere(Error, "this layout's `<template>` section is never closed — an unterminated comment or unclosed element swallows the closing `</template>`")
    }
    if vyxHasTemplatePart(outline) == false {
        return reportHere(Error, "this layout has no `<template>` section — a layout's view is the one element inside it")
    }
    let head = vyxHeadOf(ba, vyxScriptFrom(outline), vyxScriptTo(outline), "vyx_layout")
    if head.errs.length > 0 {
        return vyxReports(head.errs)
    }
    let comp = vyxCompileAt(source, "UiLayoutBody", srcPath, "props", "head")
    if comp.errs.length > 0 {
        return vyxReports(comp.errs)
    }
    if comp.takesChildren == false {
        return reportHere(
            Error,
            "the layout in `\{vyxDirOf(srcPath)}` has no `<slot/>` — a layout wraps its page, so it must say where the page goes",
        )
    }
    let mut errs: Array<VyxErr> = []
    let module = vyxBuildModule([comp], themed, theme, [], false, [], errs)
    if errs.length > 0 {
        return vyxReports(errs)
    }
    let heads = vyxEmitHeadFns(head, vyrn"", vyrn"", srcPath)
    return vyrn"""
        \{module}
        export fn layout(children: consume Array<Html>) -> Html {
            return uiLayoutBody(children)
        }
        \{heads}
        """
}

/// The layout module of the `.vyx` at `vyxPath`, or why it cannot be read.
gen fn vyxLayoutOf(vyxPath: String, themed: Bool, theme: String) -> Code {
    let read = vyxReadFileOf(vyxPath)
    if read.err != "" {
        return reportHere(Error, vyxCannotRead(vyxPath, read.err))
    }
    return vyxBuildLayoutModule(read.src, vyxPath, themed, theme)
}

/// Synthesizes a `.vyx` layout module from `vyxPath`.
export to "./ui" gen fn vyxLayout(vyxPath: String) -> Code {
    return vyxLayoutOf(vyxPath, false, "")
}

/// [`vyxLayout`] with the layout's classes checked against `theme`.
export to "./ui" gen fn vyxLayoutThemed(vyxPath: String, theme: String) -> Code {
    return vyxLayoutOf(vyxPath, true, theme)
}

// `.vyx` error pages: an `error.vyx` is a component the
// router renders in the page's place, inside the layout, when `load` fails. It
// receives an injected `error: PageError` prop. It is not a route.

/// Builds the module of the `.vyx` error page `source`, read from `srcPath`:
/// `errorPage(e: PageError) -> Html` around the compiled template, with the
/// injected `error` prop.
gen fn vyxBuildErrorModule(source: String, srcPath: String, themed: Bool, theme: String) -> Code {
    let ba = bytes(source)
    let outline = vyxOutlineOf(source)
    if vyxScriptUnclosed(outline) {
        return reportHere(Error, "this error page's `<script>` section is never closed — an unterminated string or `/* … */` comment swallows the closing `</script>`")
    }
    if vyxTemplateUnclosed(outline) {
        return reportHere(Error, "this error page's `<template>` section is never closed — an unterminated comment or unclosed element swallows the closing `</template>`")
    }
    if vyxHasTemplatePart(outline) == false {
        return reportHere(Error, "this error page has no `<template>` section — its view is the one element inside it")
    }
    // Error pages render inside the layout, which owns the head.
    let head = vyxHeadOf(ba, vyxScriptFrom(outline), vyxScriptTo(outline), "vyx_error")
    if head.errs.length > 0 {
        return vyxReports(head.errs)
    }
    let comp = vyxCompileAt(source, "UiErrorBody", srcPath, "props", "head")
    if comp.errs.length > 0 {
        return vyxReports(comp.errs)
    }
    // The view's one parameter is the injected `error` prop.
    if comp.script.props.length > 0 {
        return vyxReports([vyxErr(srcPath, 0, "this component declares `props` more than once — one component has one `props` block")])
    }
    let mut errs: Array<VyxErr> = []
    let module = vyxBuildModule([comp], themed, theme, [vyrn"error: PageError"], false, ["PageError"], errs)
    if errs.length > 0 {
        return vyxReports(errs)
    }
    return vyrn"""
        import { PageError } from "std/ui"
        \{module}
        export fn errorPage(e: PageError) -> Html {
            return uiErrorBody(e)
        }
        """
}

/// The error-page module of the `.vyx` at `vyxPath`, or why it cannot be read.
gen fn vyxErrorOf(vyxPath: String, themed: Bool, theme: String) -> Code {
    let read = vyxReadFileOf(vyxPath)
    if read.err != "" {
        return reportHere(Error, vyxCannotRead(vyxPath, read.err))
    }
    return vyxBuildErrorModule(read.src, vyxPath, themed, theme)
}

/// Synthesizes a `.vyx` error-page module from `vyxPath`.
export to "./ui" gen fn vyxError(vyxPath: String) -> Code {
    return vyxErrorOf(vyxPath, false, "")
}

/// [`vyxError`] with classes checked against `theme`.
export to "./ui" gen fn vyxErrorThemed(vyxPath: String, theme: String) -> Code {
    return vyxErrorOf(vyxPath, true, theme)
}

/// The text of the script section of `src`, or `"none"`.
fn vyxScriptBodyOf(src: String) -> String {
    if let Some(s) = vyxOutlineOf(src).script {
        return s.body.text.copy()
    }
    return "none"
}

/// The text of the template section of `src`, or `"none"`.
fn vyxTemplateBodyOf(src: String) -> String {
    if let Some(t) = vyxOutlineOf(src).template {
        return t.body.text.copy()
    }
    return "none"
}

test "section extraction finds script and template bounds" {
    let src = "<script>props { x: Int64 }</script>\n<template><li>hi</li></template>"
    assertEq(vyxScriptBodyOf(src), "props { x: Int64 }")
    assertEq(vyxTemplateBodyOf(src), "<li>hi</li>")
}

test "props parse pulls names and types" {
    let sc = vyxParseScript("props { item: Item, count: Int64 }", "c_vyx")
    assertEq(sc.errs.length, 0)
    assertEq(sc.props.length, 2)
    assertEq(sc.props[0].name.text, "item")
    assertEq(sc.props[0].ty.text, "Item")
    assertEq(sc.props[1].name.text, "count")
    assertEq(sc.props[1].ty.text, "Int64")
}

test "a simple component compiles to a view function" {
    let src = "<script>props { title: String }</script><template><li class=\"row\">{{ title }}</li></template>"
    let comp = vyxCompileComponent("Item", src, "./c")
    assertEq(comp.errs.length, 0)
    assertEq(comp.fnName, "item")
    assertEq(comp.takesChildren, false)
}

test "a missing v-for key is a generation diagnostic" {
    let src = "<template><ul><li v-for=\"x in xs\">{{ x }}</li></ul></template>"
    let comp = vyxCompileComponent("Lst", src, "./c")
    assert(vyxErrsSay(comp.errs, "this `v-for` has no `:key`"))
}

test "a dangling v-else is a named diagnostic" {
    let src = "<template><ul><i v-else>x</i></ul></template>"
    let comp = vyxCompileComponent("Bad", src, "./c")
    assert(vyxErrsSay(comp.errs, "this `v-else` follows no `v-if`"))
}

test "multiple roots are rejected" {
    let src = "<template><li>a</li><li>b</li></template>"
    let comp = vyxCompileComponent("Two", src, "./c")
    assert(vyxErrsSay(comp.errs, "holds more than one root element"))
}

test "stray text beside the root element is a second root, not dropped content" {
    let src = "<template><p>a</p>stray</template>"
    let comp = vyxCompileComponent("Stray", src, "./c")
    assert(vyxErrsSay(comp.errs, "holds more than one root element"))
}

test "a template of only text still reports no element" {
    let src = "<template>just words</template>"
    let comp = vyxCompileComponent("Txt", src, "./c")
    assert(vyxErrsSay(comp.errs, "holds no element"))
}

test "a root-level slot splice consumes children" {
    // A `<slot/>`-only template moves the children, so the loop must consume.
    let src = "<template><slot/></template>"
    let comp = vyxCompileComponent("Shell", src, "./c")
    assertEq(comp.errs.length, 0)
}

test "an unclosed element is rejected" {
    let src = "<template><li>oops</template>"
    let comp = vyxCompileComponent("Bad", src, "./c")
    assert(vyxErrsSay(comp.errs, "`<li>` is never closed"))
}

test "a props block before an import is a named diagnostic (imports first)" {
    let src = "<script>\nprops { x: Int64 }\nimport { t } from \"../s\"\n</script>\n<template><li>{{ x }}</li></template>"
    let comp = vyxCompileComponent("Bad", src, "./c")
    assert(vyxErrsSay(comp.errs, "an `import` sits after the `props` block"))
    assertEq(comp.errs[0].line, 3)
    assert(match comp.errs[0].file { Some(f) => f == "./c/Bad.vyx", None => false })
}

test "imports before a props block compile" {
    let src = "<script>\nimport { t } from \"../s\"\nprops { x: Int64 }\n</script>\n<template><li>{{ x }}</li></template>"
    let comp = vyxCompileComponent("Ok", src, "./c")
    assertEq(comp.errs.length, 0)
}

test "a props keyword in a comment does not trip imports-first" {
    let src = "<script>\nimport { t } from \"../s\"\n// props go here\nprops { x: Int64 }\n</script>\n<template><li>{{ x }}</li></template>"
    let comp = vyxCompileComponent("Ok", src, "./c")
    assertEq(comp.errs.length, 0)
}

test "a .vyx page with params before an import is rejected" {
    let src = "<script>\nparams { id: String }\nimport { Paste } from \"../wire\"\n</script>\n<template><h1>{{ id }}</h1></template>"
    let outline = vyxOutlineOf(src)
    assertEq(vyxImportsFirstViolation(bytes(src), vyxScriptFrom(outline), vyxScriptTo(outline), "params"), 3)
}

test "a .vyx page with imports before params compiles" {
    let src = "<script>\nimport { Paste } from \"../wire\"\nparams { id: String }\n</script>\n<template><h1>{{ id }}</h1></template>"
    let comp = vyxCompileAt(src, "UiPageBody", "./routes/p.vyx", "params", "")
    assertEq(comp.errs.length, 0)
    assertEq(comp.script.props[0].name.text, "id")
}

test "a component uses children when the template has a slot" {
    let src = "<template><section><slot/></section></template>"
    let comp = vyxCompileComponent("Shell", src, "./c")
    assertEq(comp.errs.length, 0)
    assert(comp.takesChildren)
}

test "a single-quoted attr value carries a string literal expression" {
    let src = "<script>props { id: String }</script><template><a :href='\"/raw/\" + id'>raw</a></template>"
    let comp = vyxCompileComponent("Lnk", src, "./c")
    assertEq(comp.errs.length, 0)
    if let VNElem(tag, isComp, attrs, kids, line) = comp.root {
        assertEq(vyxAttrValue(comp.src.bytes, attrs[0]).text, "\"/raw/\" + id")
    } else {
        assert(false)
    }
}

test "a comment mentioning props before the real props block is ignored" {
    let src = "<script>\n// these are the props for the widget\nprops { title: String }\n</script>\n<template><li>{{ title }}</li></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assertEq(comp.errs.length, 0)
    assertEq(comp.script.props.length, 1)
    assertEq(comp.script.props[0].name.text, "title")
}

test "a comment mentioning props in a no-props component is ignored" {
    let src = "<script>\n// no props here, just a helper\nfn greet() -> String { return \"hi\" }\n</script>\n<template><li>{{ greet() }}</li></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assertEq(comp.errs.length, 0)
    assertEq(comp.script.props.length, 0)
}

test "a helper identifier named props is not a props block" {
    let src = "<script>\nfn f() -> Int64 {\nlet props = 5\nreturn props\n}\n</script>\n<template><li>{{ f() }}</li></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assertEq(comp.errs.length, 0)
    assertEq(comp.script.props.length, 0)
    assert(vyxHelperText(comp.script).contains("let props = 5"))
}

test "an HTML comment inside the template is stripped, not a bad tag" {
    let src = "<template><ul><!-- a note --><li>x</li></ul></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assertEq(comp.errs.length, 0)
}

test "a lone brace in text stays literal" {
    let src = "<template><li>a { b } c</li></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assertEq(comp.errs.length, 0)
}

test "a literal close-script tag inside a helper string does not truncate the section" {
    let src = "<script>\nfn f() -> String { return \"</script>\" }\n</script>\n<template><li>{{ f() }}</li></template>"
    // The section must reach past the string literal to the real closing tag.
    assert(vyxScriptBodyOf(src).contains("return"))
}

// The template section is markup. Each case asserts the exact extent; read as
// code, each runs past the real close tag or stops before it.

test "an odd double quote in text content is a character, not a string" {
    let src = "<template><p>a 6\" nail</p></template>\n"
    assertEq(vyxTemplateBodyOf(src), "<p>a 6\" nail</p>")
}

test "a single-quoted attribute value may hold a double quote" {
    let src = "<template><input value='2\"'/></template>\n"
    assertEq(vyxTemplateBodyOf(src), "<input value='2\"'/>")
}

test "a close tag inside an HTML comment closes nothing" {
    let src = "<template><p>a</p><!-- </template> --><p>b</p></template>\n"
    assertEq(vyxTemplateBodyOf(src), "<p>a</p><!-- </template> --><p>b</p>")
}

test "a close tag inside an attribute value closes nothing" {
    let src = "<template><p title=\"</template>\">a</p></template>\n"
    assertEq(vyxTemplateBodyOf(src), "<p title=\"</template>\">a</p>")
}

test "a nested template element is closed by its own tag" {
    let src = "<template><div><template><p>a</p></template></div></template>\n"
    assertEq(vyxTemplateBodyOf(src), "<div><template><p>a</p></template></div>")
}

test "a self-closing template element does not raise the nesting depth" {
    let src = "<template><div><template/></div></template>\n"
    assertEq(vyxTemplateBodyOf(src), "<div><template/></div>")
}

test "an empty template section is found, and is empty" {
    let src = "<template></template>\n"
    assertEq(vyxTemplateBodyOf(src), "")
}

test "a comparison operator in an event argument is not bracket depth" {
    // `pick(a > b, c)` is two arguments.
    assert(vyxHasTopComma(bytes("a > b, c")))
    assert(vyxHasTopComma(bytes("a < b, c")))
    // One argument stays one argument, comparison or not.
    assert(vyxHasTopComma(bytes("a > b")) == false)
    assert(vyxHasTopComma(bytes("f(a, b)")) == false)
}

test "a helper string containing props-brace and template tags is inert" {
    // A keyword inside a helper string conjures no props block and no section.
    let src = "<script>\nfn f() -> String { return \"props { fake: Int64 } <template> script\" }\n</script>\n<template><li>{{ f() }}</li></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assertEq(comp.errs.length, 0)
    assertEq(comp.script.props.length, 0)
    assert(vyxHelperText(comp.script).contains("props { fake: Int64 }"))
}

test "comments may mention props template and script freely (the CreateForm regression)" {
    // A comment naming all three section keywords changes nothing.
    let src = "<script>\n// the props for this template's script are below\nprops { title: String }\n</script>\n<template><li>{{ title }}</li></template>"
    let withComment = vyxCompileComponent("C", src, "./c")
    let bare = vyxCompileComponent("C", "<script>\nprops { title: String }\n</script>\n<template><li>{{ title }}</li></template>", "./c")
    assertEq(withComment.errs.length, 0)
    assertEq(withComment.script.props.length, 1)
    assertEq(withComment.script.props[0].name.text, "title")
}

test "a same-name-different-spec import conflict names both files" {
    let a = vyxCompileComponent("A", "<script>import { t } from \"../one\"</script><template><li>{{ t }}</li></template>", "./w")
    let b = vyxCompileComponent("B", "<script>import { t } from \"../two\"</script><template><li>{{ t }}</li></template>", "./w")
    let errs = vyxImportConflicts([a, b])
    assert(vyxErrsSay(errs, "both import `t`"))
    assert(vyxErrsSay(errs, "./w/A.vyx"))
    assert(vyxErrsSay(errs, "./w/B.vyx"))
}

test "a .vyx page shape reports its params and its data query" {
    let src = "<script>\nparams { id: String }\nexport fn data() -> ParamQuery<Params, Validation<Data>> { return q }\ntype Data = { title: String }\n</script>\n<template><h1>{{ data.title }}</h1></template>"
    let shape = vyxPageShape(src)
    assertEq(shape.err, "")
    assertEq(shape.paramNames.length, 1)
    assertEq(shape.paramNames[0], "id")
    assertEq(shape.paramTypes[0], "String")
    assert(shape.hasLoad)
    assert(shape.loadHasParams)
    assertEq(shape.loadRet, "Validation<Data>")
}

test "an attribute starting a non-identifier byte is a named diagnostic, not a hang" {
    // Each shape once scanned zero bytes per iteration and never finished.
    let triggers = ["<template><div #app>x</div></template>", "<template><button @click.stop=\"go()\">x</button></template>", "<template><a href=\"/x\",rel=\"y\">x</a></template>", "<template><li *ngIf>x</li></template>"]
    for src in triggers {
        let comp = vyxCompileComponent("Bad", src, "./c")
        assert(vyxErrsSay(comp.errs, "an attribute name is expected"))
    }
}

test "a component stem that is not an identifier is named, not emitted" {
    // Stems that do not spell an identifier are named at the component.
    let hyphen = vyxCompileComponent("My-Widget", "<template><p>x</p></template>", "./c")
    assert(vyxErrsSay(hyphen.errs, "does not spell a legal view-function name"))
    let digit = vyxCompileComponent("404", "<template><p>x</p></template>", "./c")
    assert(vyxErrsSay(digit.errs, "does not spell a legal view-function name"))
}

test "the -> of a fn-typed parameter does not end the parameter list" {
    // The `>` of `->` is not a generic closer; `g` must survive.
    let ts = vyxDeclParamTypes("fn head(cb: fn(Data) -> String, g: Int64)")
    assertEq(ts.length, 2)
    assertEq(ts[0], "fn(Data) -> String")
    assertEq(ts[1], "Int64")
}

test "an unterminated block comment in script is diagnosed, not dropped" {
    // An unclosed comment swallows `</script>`; the section must be reported,
    // not dropped.
    let src = "<script>\n/* never closed\nprops { x: Int64 }\n</script>\n<template><li>{{ x }}</li></template>"
    assert(vyxScriptUnclosed(vyxOutlineOf(src)))
    let comp = vyxCompileComponent("C", src, "./c")
    assert(vyxErrsSay(comp.errs, "`<script>` section is never closed"))
}

test "an unterminated template comment is diagnosed, not 'no template'" {
    let src = "<template><p>a</p><!-- never closed</template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assert(vyxErrsSay(comp.errs, "`<template>` section is never closed"))
}

test "an element closed under another name names both, innermost first" {
    let src = "<template><a><b></a></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assert(vyxErrsSay(comp.errs, "`<b>` is closed by `</a>`"))
}

test "a close tag that closes nothing is refused, not the end of the template" {
    let src = "<template><a/>\n</b><c></template>"
    let comp = vyxCompileComponent("C", src, "./c")
    assert(vyxErrsSay(comp.errs, "`</b>` closes no element"))
    assertEq(comp.errs[0].line, 2)
}
